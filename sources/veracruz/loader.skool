@start
@remote=main:$4000
@remote=main:$8000
@remote=main:$FB00

; BASIC Loader
;
; The BASIC program "Vera Cruz" on the part 1 tape. It autostarts at line
; 10.
; .
; #LIST { Line 20 loads the first CODE block at #N($8000,$04,$04): a copy
; of #R$8000@main(DrawPicture) followed by the title card picture. } {
; Line 30 draws the title card (picture #N$01) straight onto the screen;
; see #R$4000@main(Loading). } { Line 40 prints "First Part" over it. } {
; Line 60 loads the main code block at #N($8000,$04,$04). } { Line 80
; loads the code block at #N($FB00,$04,$04) (see
; #R$FB00@main(DisplayFrame)). } { Line 120 loads the game itself, which
; is written in BASIC. } LIST#
@label=BasicLoader
b$5CCB DEFB $00,$0A,$50,$00,$FD,$33,$32,$37 ; {Line 10: CLEAR 32767: BORDER 7: PAPER 7: BRIGHT 1: POKE
 $5CD3 DEFB $36,$37,$0E,$00,$00,$FF,$7F,$00 ; 23624,BIN 01111111: INK 7: CLS
 $5CDB DEFB $3A,$E7,$37,$0E,$00,$00,$07,$00 ;
