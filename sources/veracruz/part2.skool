 $FBBB ADD HL,BC     ;
 $FBBC EX DE,HL      ;
 $FBBD DEC IYl       ;
 $FBBF JR NZ,$FBAB   ;
 $FBC1 EI            ;
 $FBC2 RET           ;

; Display Frame: Calculate Offset
;
; Used by the routine at #R$FB0C.
; .
; Returns #REGhl = #REGl * #N$20 + #REGc.
;
;   C Column
;   L Row
; O:HL Offset
@label=DisplayFrame_CalculateOffset
c$FBC3 LD H,$00      ;
 $FBC5 LD B,H        ;
 $FBC6 ADD HL,HL     ;
 $FBC7 ADD HL,HL     ;
 $FBC8 ADD HL,HL     ;
 $FBC9 ADD HL,HL     ;
 $FBCA ADD HL,HL     ;
 $FBCB ADD HL,BC     ;
 $FBCC RET           ;

; Unused
u$FBCD DEFS $33

; Interrupt Switches
;
; Zero in the snapshot. Line 2040 POKEs two routines here: DI, RET at
; #R$FC00 and EI, RET at #R$FC02. Line 28 calls them either side of
; #R$C350.
@label=DisableInterrupts
b$FC00 DEFS $02
@label=EnableInterrupts
 $FC02 DEFS $02

; Unused
u$FC04 DEFS $9C

; Scroll Window
;
; Scrolls a window of the screen up one pixel line at a time, filling the
; bottom line with the byte at #R$FCA7. Line 19 POKEs the parameters
; before calling it.
@label=ScrollWindow
c$FCA0 JR $FCA8      ; Jump to #R$FCA8.

; Scroll Window Parameters
;
; Parameters for #R$FCA0.
@label=ScrollWindow_Count
g$FCA2 DEFB $08      ; Number of pixel lines to scroll.
@label=ScrollWindow_Left
 $FCA3 DEFB $08      ; Left column.
@label=ScrollWindow_Top
 $FCA4 DEFB $00      ; Top pixel line.
@label=ScrollWindow_Right
 $FCA5 DEFB $1F      ; Right column.
@label=ScrollWindow_Bottom
 $FCA6 DEFB $AF      ; Bottom pixel line.
@label=ScrollWindow_Fill
 $FCA7 DEFB $00      ; Fill byte.

; Scroll Window: Scroll
;
; Used by the routine at #R$FCA0.
; .
; Continues from #R$FCA0.
@label=ScrollWindow_Scroll
c$FCA8 LD A,($FCA4)  ;
 $FCAB LD C,A        ;
 $FCAC LD A,($FCA3)  ;
 $FCAF LD B,A        ;
 $FCB0 CALL $FCDE    ;
 $FCB3 LD A,($FCA6)  ;
 $FCB6 SUB C         ;
 $FCB7 LD IYl,A      ;
 $FCB9 LD A,($FCA5)  ;
 $FCBC SUB B         ;
 $FCBD INC A         ;
 $FCBE LD C,A        ;
 $FCBF LD B,$00      ;
 $FCC1 DI            ;
*$FCC2 LD D,H        ;
 $FCC3 LD E,L        ;
 $FCC4 CALL $FCF4    ;
 $FCC7 LD A,L        ;
 $FCC8 LD IXl,C      ;
 $FCCA LDIR          ;
 $FCCC LD C,IXl      ;
 $FCCE LD L,A        ;
 $FCCF DEC IYl       ;
 $FCD1 JR NZ,$FCC2   ;
 $FCD3 CALL $FD03    ;
 $FCD6 LD HL,$FCA2   ;
 $FCD9 DEC (HL)      ;
 $FCDA JR NZ,$FCA8   ;
 $FCDC EI            ;
 $FCDD RET           ;

; Scroll Window: Screen Address
;
; Used by the routine at #R$FCA8.
; .
; Returns the screen address of pixel line #REGc, column #REGb.
;
;   B Column
;   C Pixel line
; O:HL Screen address
@label=ScrollWindow_ScreenAddress
c$FCDE LD A,C        ;
 $FCDF AND $C0       ;
 $FCE1 RRCA          ;
 $FCE2 RRCA          ;
 $FCE3 RRCA          ;
 $FCE4 ADD A,$40     ;
 $FCE6 LD H,A        ;
 $FCE7 LD A,C        ;
 $FCE8 AND $07       ;
 $FCEA ADD A,H       ;
 $FCEB LD H,A        ;
 $FCEC LD A,C        ;
 $FCED RLCA          ;
 $FCEE RLCA          ;
 $FCEF AND $E0       ;
 $FCF1 OR B          ;
 $FCF2 LD L,A        ;
 $FCF3 RET           ;

; Scroll Window: Next Pixel Line
;
; Used by the routine at #R$FCA8.
; .
; Moves #REGhl down one pixel line on the screen.
;
; HL Screen address
@label=ScrollWindow_NextLine
c$FCF4 INC H         ;
 $FCF5 LD A,H        ;
 $FCF6 AND $07       ;
 $FCF8 RET NZ        ;
 $FCF9 LD A,L        ;
 $FCFA ADD A,$20     ;
 $FCFC LD L,A        ;
 $FCFD RET C         ;
 $FCFE LD A,H        ;
 $FCFF SUB $08       ;
 $FD01 LD H,A        ;
 $FD02 RET           ;

; Scroll Window: Fill Bottom Line
;
; Used by the routine at #R$FCA8.
; .
; Fills the bottom pixel line of the window with the byte at #R$FCA7.
@label=ScrollWindow_FillLine
c$FD03 LD A,($FCA7)  ;
 $FD06 LD (HL),A     ;
 $FD07 LD D,H        ;
 $FD08 LD E,L        ;
 $FD09 INC DE        ;
 $FD0A DEC BC        ;
 $FD0B LDIR          ;
 $FD0D RET           ;

; Print String
;
; Prints the BASIC string "s$" at the current print position in a
; 64-column font. It finds the string with the ROM routine
; #SKOOLKID$28B2(LOOK-VARS), using the name at #R$FD94, and stops with an
; error if it is missing. Codes below #N$20 go straight to RST #N$10;
; codes from #N$90 upwards are skipped.
@label=PrintString
c$FD0E XOR A         ;
 $FD0F LD ($FD97),A  ;
 $FD12 LD A,$02      ;
 $FD14 CALL $1601    ;
 $FD17 LD HL,($5C5D) ;
 $FD1A PUSH HL       ;
 $FD1B LD HL,$FD94   ;
 $FD1E LD ($5C5D),HL ;
 $FD21 CALL $28B2    ;
 $FD24 EX (SP),HL    ;
 $FD25 LD ($5C5D),HL ;
 $FD28 POP HL        ;
 $FD29 JR NC,$FD2D   ;
 $FD2B RST $08       ;
 $FD2C DEFB $01      ; Error code for the RST #N$08 above.
*$FD2D INC HL        ;
 $FD2E LD C,(HL)     ;
 $FD2F INC HL        ;
 $FD30 LD B,(HL)     ;
 $FD31 LD A,B        ;
 $FD32 OR C          ;
 $FD33 JR Z,$FD4A    ;
*$FD35 INC HL        ;
 $FD36 LD A,(HL)     ;
 $FD37 CP $90        ;
 $FD39 JR NC,$FD45   ;
 $FD3B CP $20        ;
 $FD3D JR NC,$FD42   ;
 $FD3F RST $10       ;
 $FD40 JR $FD45      ;
*$FD42 CALL $FD56    ;
*$FD45 DEC BC        ;
 $FD46 LD A,B        ;
 $FD47 OR C          ;
 $FD48 JR NZ,$FD35   ;
*$FD4A LD A,($FD97)  ;
 $FD4D OR A          ;
 $FD4E JR Z,$FD55    ;
 $FD50 LD A,$20      ;
 $FD52 CALL $FD56    ;
*$FD55 RET           ;

; Print String: Print Character
;
; Used by the routine at #R$FD0E.
; .
; Builds two 4-pixel characters side by side in the UDG for "U" (graphic
; code #N$A4) from the font at #R$FD98, and prints that UDG after every
; second character. The flag at #R$FD97 records whether a half is waiting.
;
; A Character code
@label=PrintString_Character
c$FD56 SUB $20       ;
 $FD58 PUSH HL       ;
 $FD59 LD H,$00      ;
 $FD5B LD L,A        ;
 $FD5C ADD HL,HL     ;
 $FD5D ADD HL,HL     ;
 $FD5E LD DE,$FD98   ;
 $FD61 ADD HL,DE     ;
 $FD62 EX DE,HL      ;
 $FD63 PUSH BC       ;
 $FD64 LD HL,($5C7B) ;
 $FD67 LD BC,$00A0   ;
 $FD6A ADD HL,BC     ;
 $FD6B LD B,$02      ;
*$FD6D PUSH DE       ;
 $FD6E LD C,$04      ;
*$FD70 LD A,(DE)     ;
 $FD71 BIT 1,B       ;
 $FD73 JR Z,$FD79    ;
 $FD75 RRCA          ;
 $FD76 RRCA          ;
 $FD77 RRCA          ;
 $FD78 RRCA          ;
*$FD79 RLD           ;
 $FD7B INC HL        ;
 $FD7C INC DE        ;
 $FD7D DEC C         ;
 $FD7E JR NZ,$FD70   ;
 $FD80 POP DE        ;
 $FD81 DJNZ $FD6D    ;
 $FD83 POP BC        ;
 $FD84 LD A,($FD97)  ;
 $FD87 INC A         ;
 $FD88 LD ($FD97),A  ;
 $FD8B BIT 0,A       ;
 $FD8D JR NZ,$FD92   ;
 $FD8F LD A,$A4      ;
 $FD91 RST $10       ;
*$FD92 POP HL        ;
 $FD93 RET           ;

; Print String Data
;
; Data used by #R$FD0E.
@label=PrintString_VariableName
b$FD94 DEFM "S$ "    ; Name of the string variable to print ("S$", then a
                     ; space).
@label=PrintString_HalfFlag
 $FD97 DEFB $00      ; Half-character flag.

; Font
