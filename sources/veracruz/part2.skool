; Draw Picture
;
; Used by the BASIC program. Draws picture number *#R$C352 from the
; picture list that starts at #R$C47C. The picture goes to the screen, or to a
; buffer when BASIC has POKEd the high bytes used by the instructions at
; #R$C3CA (pixels) and #R$C413 (attributes).
; .
; Each picture record is laid out as follows:
; #TABLE(default,centre,centre,centre)
; { =h Offset | =h Bytes | =h Contents }
; { #N$00 | #N$02 | The length of the record, less one }
; { #N$02 | #N$01 | The screen third to start at }
; { #N$03 | #N$01 | The number of thirds to draw }
; { #N$04 | #N$01 | Flags; see #R$C355 }
; { #N$05 | Varies | Pixel data, then attribute data }
; TABLE#
; .
; Both lots of data are run-length encoded. A non-zero byte is written
; as it is. A zero byte is followed by a count and a value, and the value is
; written that many times (a count of zero writes it 256 times).
; .
; When bit 0 of the flags is clear, the pixel data is in column order:
; each column is written from the top of the picture to the bottom, one byte
; for each pixel line, and then the next column to the right follows. When
; bit 0 is set, the pixel data is in row order: each pixel line is written
; from left to right, from the top of the picture to the bottom. The
; attribute data is always in the same order as the attribute file.
; .
; The routine works out its own address as it runs, so the same code
; works in both parts of the game.
@label=DrawPicture
c$C350 JR $C356      ; Jump over the parameters to #R$C356.
; View the equivalent code in;
; #LIST
; { #VERACRUZ$8000(Vera Cruz: Part 1) }
; LIST#

; Draw Picture Parameters
;
; Parameters for #R$C350, read and written through #REGiy. BASIC only
; POKEs the picture number here; *#R$C353 and *#R$C354
; are always #N$FF in the snapshot, so the routine takes the screen third and
; the number of thirds from the picture record.
; .
; The flags at #R$C355:
; #TABLE(default,centre,centre)
; { =h Bit | =h Relating To }
; { #N$00 | Pixel data order (set: rows; clear: columns) }
; { #N$02 | Set while a run of repeated bytes is being written }
; { #N$03 | Set while the attributes are being drawn }
; TABLE#
@label=DrawPicture_Number
g$C352 DEFB $01      ; Picture number (#N$01 for the first picture in the
                     ; list).
@label=DrawPicture_Third
 $C353 DEFB $FF      ; Screen third to start at, from #N$00 (top) to #N$02 (bottom).
                     ; #N$FF means use the value in the picture record.
@label=DrawPicture_Thirds
 $C354 DEFB $FF      ; Number of thirds to draw, from #N$01 to #N$03. #N$FF means use the
                     ; value in the picture record.
@label=DrawPicture_Flags
 $C355 DEFB $0C      ; Flags, copied from the picture record.
; View the equivalent code in;
; #LIST
; { #VERACRUZ$8002(Vera Cruz: Part 1) }
; LIST#

; Draw Picture: Unpack
;
; Used by the routine at #R$C350.
; .
; Continues from #R$C350.
;
; .
;
; Find out where this code is in memory. The call leaves its return
; address (#R$C359) just below the stack pointer. An interrupt at this point
; would overwrite it, so BASIC calls #R$FC00 first and #R$FC02 afterwards.
@label=DrawPicture_Unpack
c$C356 CALL $007C      ; Call the RET instruction at #N($007C,$04,$04), at the end of
                       ; #SKOOLKID$0074,$007C(CH_ADD+1), which returns straight away.
@label=DrawPicture_ReturnAddress
 $C359 DEC SP          ; {Move the stack pointer back down to the return
 $C35A DEC SP          ; address.}
 $C35B EX (SP),HL      ; Swap it into #REGhl, so #REGhl=#R$C359.
 $C35C INC SP          ; {Move the stack pointer back up again.
 $C35D INC SP          ; }
 $C35E AND A           ; Clear the carry flag ready for the subtraction.
 $C35F LD DE,$0007     ; {#REGhl=#R$C352 (#R$C359 less #N($0007,$04,$04)).
 $C362 SBC HL,DE       ; }
 $C364 PUSH HL         ; Stash the address of the parameters on the stack.
 $C365 POP IY          ; Restore the address of the parameters from the stack
                       ; into #REGiy.
 $C367 LD DE,$012A     ; {#REGhl=#R$C47C (#R$C352 plus #N($012A,$04,$04)), the first picture
 $C36A ADD HL,DE       ; record.}
 $C36B LD A,(IY+$00)   ; #REGa=the picture number from *#R$C352.
; Skip over the records before the requested picture.
@label=DrawPicture_FindPicture
*$C36E DEC A           ; Decrease the picture number by one.
 $C36F JR Z,$C377      ; Jump to #R$C377 if #REGhl points to the requested
                       ; picture.
 $C371 LD E,(HL)       ; {#REGde=the length of this record, less one.
 $C372 INC HL          ;
 $C373 LD D,(HL)       ; }
 $C374 ADD HL,DE       ; Add it to #REGhl, so #REGhl points to the next record.
 $C375 JR $C36E        ; Jump to #R$C36E.
@label=DrawPicture_Found
*$C377 LD DE,$4000     ; #REGde=#N($4000,$04,$04). This value is never used, as #REGd and
                       ; #REGe are both set again before they are needed.
 $C37A INC HL          ; {Move #REGhl past the length, to the record's screen
 $C37B INC HL          ; third.}
 $C37C LD A,(IY+$01)   ; #REGa=*#R$C353.
 $C37F INC A           ; Increment #REGa by one, so that #N$FF becomes zero.
 $C380 JR NZ,$C386     ; Jump to #R$C386 if *#R$C353 is not #N$FF.
 $C382 LD A,(HL)       ; {Else write the record's screen third to *#R$C353.
 $C383 LD (IY+$01),A   ; }
*$C386 INC HL          ; Move on to the record's number of thirds.
 $C387 LD A,(IY+$02)   ; #REGa=*#R$C354.
 $C38A INC A           ; Increment #REGa by one, so that #N$FF becomes zero.
 $C38B JR NZ,$C391     ; Jump to #R$C391 if *#R$C354 is not #N$FF.
 $C38D LD A,(HL)       ; {Else write the record's number of thirds to *#R$C354.
 $C38E LD (IY+$02),A   ; }
*$C391 INC HL          ; Move on to the record's flags.
 $C392 LD A,(HL)       ; {Copy the record's flags to *#R$C355.
 $C393 LD (IY+$03),A   ; }
; Make sure the picture fits on the screen.
 $C396 LD A,(IY+$01)   ; #REGa=*#R$C353.
 $C399 CP $03          ; {Jump to #R$C3A1 if the screen third is less than
 $C39B JR C,$C3A1      ; #N$03.}
 $C39D LD (IY+$01),$00 ; Else start at the top third (write #N$00 to *#R$C353).
*$C3A1 LD A,(IY+$02)   ; #REGa=*#R$C354.
 $C3A4 CP $04          ; {Jump to #R$C3AC if the number of thirds is less than
 $C3A6 JR C,$C3AC      ; #N$04.}
 $C3A8 LD (IY+$02),$01 ; Else draw one third (write #N$01 to *#R$C354).
*$C3AC ADD A,(IY+$01)  ; Add the screen third to #REGa. #REGa still holds the number of
                       ; thirds read at #R$C3A1, even when it has just been changed.
 $C3AF CP $04          ; {Jump to #R$C3B7 if the picture ends on the screen (the total is
 $C3B1 JR C,$C3B7      ; less than #N$04).}
 $C3B3 LD (IY+$02),$01 ; Else draw one third (write #N$01 to *#R$C354).
*$C3B7 LD A,(IY+$02)   ; #REGa=*#R$C354.
 $C3BA AND A           ; {Jump to #R$C3C1 if the number of thirds is not zero.
 $C3BB JR NZ,$C3C1     ; }
 $C3BD LD (IY+$02),$01 ; Else draw one third (write #N$01 to *#R$C354).
; Draw the pixels.
@label=DrawPicture_Pixels
*$C3C1 INC HL          ; Move #REGhl on to the start of the picture data.
 $C3C2 LD E,$00        ; #REGe=#N$00 (the left-hand column).
 $C3C4 LD A,(IY+$01)   ; #REGa=*#R$C353.
 $C3C7 ADD A,A         ; {Multiply it by #N$08, as each third of the screen is #N$08 pages
 $C3C8 ADD A,A         ; long.
 $C3C9 ADD A,A         ; }
@label=DrawPicture_PixelsHighByte
 $C3CA ADD A,$40       ; Add the high byte of the start of the screen (#N$40). BASIC POKEs
                       ; this byte to draw into a buffer instead.
 $C3CC LD D,A          ; {Set #REGd and #REGc to the high byte of the top pixel line of the
 $C3CD LD C,A          ; picture, so #REGde holds its screen address.}
 $C3CE LD B,$01        ; #REGb=#N$01 (one pass, for row order).
 $C3D0 BIT 0,(IY+$03)  ; {Jump to #R$C3D8 if bit 0 of *#R$C355 is set (row
 $C3D4 JR NZ,$C3D8     ; order).}
 $C3D6 LD B,$20        ; Else #REGb=#N$20 (one pass for each column).
@label=DrawPicture_PassLoop
*$C3D8 PUSH BC         ; Stash the pass counter on the stack.
 $C3D9 LD B,(IY+$02)   ; #REGb=the number of thirds from *#R$C354.
@label=DrawPicture_ThirdLoop
*$C3DC PUSH BC         ; Stash the thirds counter on the stack.
 $C3DD LD B,$08        ; #REGb=#N$08 (character rows in a third).
@label=DrawPicture_RowLoop
*$C3DF PUSH BC         ; Stash the character row counter on the stack.
 $C3E0 LD B,$08        ; #REGb=#N$08 (pixel lines in a character row).
@label=DrawPicture_LineLoop
*$C3E2 PUSH BC         ; Stash the pixel line counter on the stack.
 $C3E3 LD B,$01        ; #REGb=#N$01 (one byte, for column order).
 $C3E5 BIT 0,(IY+$03)  ; {Jump to #R$C3ED if bit 0 of *#R$C355 is clear (column
 $C3E9 JR Z,$C3ED      ; order).}
 $C3EB LD B,$20        ; Else #REGb=#N$20 (a whole pixel line, for row order).
*$C3ED PUSH DE         ; Stash the screen address of this pixel line on the
                       ; stack.
@label=DrawPicture_ByteLoop
*$C3EE PUSH BC         ; Stash the byte counter on the stack.
 $C3EF JR $C434        ; Jump to #R$C434 to write the next byte; it comes back
                       ; to #R$C3F1.
@label=DrawPicture_NextByte
*$C3F1 POP BC          ; Restore the byte counter from the stack.
 $C3F2 INC DE          ; Move right to the next screen byte.
 $C3F3 DJNZ $C3EE      ; Decrease the byte counter by one and loop back to #R$C3EE until
                       ; it is zero.
 $C3F5 POP DE          ; Restore the screen address of this pixel line from the
                       ; stack.
 $C3F6 POP BC          ; Restore the pixel line counter from the stack.
 $C3F7 INC D           ; Move down to the next pixel line.
 $C3F8 DJNZ $C3E2      ; Decrease the pixel line counter by one and loop back to #R$C3E2
                       ; until all #N$08 pixel lines are done.
 $C3FA LD A,D          ; {Move #REGd back up to the top pixel line of this character row
 $C3FB SUB $08         ; (subtract #N$08).
 $C3FD LD D,A          ; }
 $C3FE LD A,E          ; {Move down to the next character row (add #N$20 to
 $C3FF ADD A,$20       ; #REGe).
 $C401 LD E,A          ; }
 $C402 POP BC          ; Restore the character row counter from the stack.
 $C403 DJNZ $C3DF      ; Decrease the character row counter by one and loop back to
                       ; #R$C3DF until all #N$08 character rows are done.
 $C405 LD A,D          ; {Move down to the next third (add #N$08 to #REGd). #REGe has gone
 $C406 ADD A,$08       ; back round to the same column.
 $C408 LD D,A          ; }
 $C409 POP BC          ; Restore the thirds counter from the stack.
 $C40A DJNZ $C3DC      ; Decrease the thirds counter by one and loop back to #R$C3DC until
                       ; all the thirds are done.
 $C40C LD D,C          ; Move #REGd back up to the top of the picture
                       ; (#REGd=#REGc).
 $C40D INC E           ; Move right to the next column.
 $C40E POP BC          ; Restore the pass counter from the stack.
 $C40F DJNZ $C3D8      ; Decrease the pass counter by one and loop back to #R$C3D8 until
                       ; all the passes are done.
; Draw the attributes.
@label=DrawPicture_Attributes
 $C411 LD E,$00        ; #REGe=#N$00.
@label=DrawPicture_AttributesHighByte
 $C413 LD A,$58        ; #REGa=#N$58, the high byte of the start of the attribute file.
                       ; BASIC POKEs this byte to draw into a buffer instead.
 $C415 ADD A,(IY+$01)  ; Add the screen third.
 $C418 LD D,A          ; #REGd=#REGa, so #REGde holds the address of the first attribute
                       ; of the picture.
 $C419 LD B,(IY+$02)   ; {#REGbc=the number of attributes to draw: 256 for each third
 $C41C LD C,E          ; (#REGb=*#R$C354 and #REGc=#N$00).}
 $C41D SET 3,(IY+$03)  ; Set bit 3 of *#R$C355, so that #R$C434 comes back to
                       ; #R$C424.
@label=DrawPicture_AttributesLoop
*$C421 PUSH BC         ; Stash the attribute counter on the stack.
 $C422 JR $C434        ; Jump to #R$C434 to write the next attribute; it comes back to
                       ; #R$C424.
@label=DrawPicture_NextAttribute
*$C424 POP BC          ; Restore the attribute counter from the stack.
 $C425 DEC BC          ; Decrease the attribute counter by one.
 $C426 INC DE          ; Move on to the next attribute.
 $C427 LD A,B          ; {Jump back to #R$C421 until the attribute counter is
 $C428 OR C            ; zero.
 $C429 JR NZ,$C421     ; }
 $C42B LD (IY+$01),$FF ; {Write #N$FF to *#R$C353 and *#R$C354. BASIC never POKEs these
 $C42F LD (IY+$02),$FF ; bytes, so the next picture again takes its screen third and number of
                       ; thirds from its own record.}
 $C433 RET             ; Return.
; Write the next byte of picture data to *#REGde. While a run of
; repeated bytes is being written, bit 2 of *#R$C355 is set, #REGb' holds the
; count and #REGc' holds the value.
@label=DrawPicture_FetchByte
*$C434 BIT 2,(IY+$03)  ; {Jump to #R$C447 if no run is in progress.
 $C438 JR Z,$C447      ; }
 $C43A EXX             ; Switch to the shadow registers.
 $C43B DEC B           ; Decrease the run count in #REGb' by one.
 $C43C LD A,C          ; #REGa=the run value from #REGc'.
 $C43D EXX             ; Switch back to the normal registers.
 $C43E JR Z,$C443      ; Jump to #R$C443 if the run has finished.
 $C440 LD (DE),A       ; Write the run value to *#REGde.
 $C441 JR $C45B        ; Jump to #R$C45B.
@label=DrawPicture_EndRun
*$C443 RES 2,(IY+$03)  ; Clear bit 2 of *#R$C355, as the run has finished.
@label=DrawPicture_ReadByte
*$C447 LD A,(HL)       ; {#REGa=the next byte of picture data, and move #REGhl
 $C448 INC HL          ; on.}
 $C449 AND A           ; {Jump to #R$C45A if it is not zero, to write it as it
 $C44A JR NZ,$C45A     ; is.}
 $C44C LD A,(HL)       ; {A zero byte starts a run. #REGb'=the count.
 $C44D EXX             ;
 $C44E LD B,A          ;
 $C44F EXX             ; }
 $C450 INC HL          ; Move #REGhl on to the value.
 $C451 LD A,(HL)       ; {#REGc'=the value (#REGa holds it too).
 $C452 EXX             ;
 $C453 LD C,A          ;
 $C454 EXX             ; }
 $C455 INC HL          ; Move #REGhl on to the next byte of picture data.
 $C456 SET 2,(IY+$03)  ; Set bit 2 of *#R$C355, as a run is in progress.
@label=DrawPicture_WriteByte
*$C45A LD (DE),A       ; Write the byte to *#REGde.
@label=DrawPicture_Continue
*$C45B BIT 3,(IY+$03)  ; {Jump back to #R$C424 if the attributes are being
 $C45F JR NZ,$C424     ; drawn.}
 $C461 JR $C3F1        ; Else jump back to #R$C3F1.
; View the equivalent code in;
; #LIST
; { #VERACRUZ$8006(Vera Cruz: Part 1) }
; LIST#

; Unused
;
; These bytes follow the picture routine; nothing reads them.
u$C463 DEFB $08,$10,$11,$12,$12,$14,$00,$03,$00,$01,$02,$01,$00,$03,$00,$0F
 $C473 DEFB $19,$0E,$00,$04,$00,$08,$18,$22,$22

