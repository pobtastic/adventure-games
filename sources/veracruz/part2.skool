; Last Byte Of Code Block
;
; The last byte loaded from tape; it is not part of any picture record.
u$DC11 DEFS $01

; Unused
u$DC12 DEFS $03EE

; Picture Buffer
;
; BASIC draws a picture sheet here; #R$FB00 copies single frames from it
; to the screen.
@label=PictureBuffer
b$E000 DEFS $1800    ; Pixels.
@label=PictureBuffer_Attributes
 $F800 DEFS $0300    ; Attributes.

; Display Frame
;
; Copies one frame of the picture held in the buffer at #R$E000 to the
; screen: first the pixel rows, then the attributes from #R$F800. Called
; by BASIC with the frame number POKEd into #R$FB02.
; .
; The values in the snapshot describe rows of #N$04 frames of #N$07 by
; #N$0A characters after line 2040, copied to column #N$18, row #N$02.
@label=DisplayFrame
c$FB00 JR $FB0C      ; Jump to #R$FB0C.

; Display Frame Parameters
;
; Parameters for #R$FB00.
@label=DisplayFrame_Number
g$FB02 DEFB $01      ; Frame number (counting from #N$01).
@label=DisplayFrame_PerRow
 $FB03 DEFB $03      ; Frames in each row of the picture.
@label=DisplayFrame_Width
 $FB04 DEFB $0A      ; Width of a frame, in characters.
@label=DisplayFrame_Height
 $FB05 DEFB $11      ; Height of a frame, in characters.
@label=DisplayFrame_Column
 $FB06 DEFB $03      ; Screen column to copy the frame to.
@label=DisplayFrame_Row
 $FB07 DEFB $02      ; Screen row to copy the frame to.
@label=DisplayFrame_ScreenOffset
 $FB08 DEFW $0000    ; Screen offset (work space).
@label=DisplayFrame_BufferOffset
 $FB0A DEFW $0000    ; Buffer offset (work space).

; Display Frame: Copy
;
; Used by the routine at #R$FB00.
; .
; Continues from #R$FB00.
@label=DisplayFrame_Copy
c$FB0C LD A,($FB03)  ;
 $FB0F LD B,A        ;
 $FB10 LD C,$01      ;
 $FB12 LD A,($FB02)  ;
 $FB15 DEC A         ;
*$FB16 CP B          ;
 $FB17 JR C,$FB1D    ;
 $FB19 SUB B         ;
 $FB1A INC C         ;
 $FB1B JR $FB16      ;
*$FB1D INC A         ;
 $FB1E LD B,A        ;
 $FB1F LD HL,$FB04   ;
 $FB22 XOR A         ;
 $FB23 DEC B         ;
 $FB24 JR Z,$FB29    ;
*$FB26 ADD A,(HL)    ;
 $FB27 DJNZ $FB26    ;
*$FB29 LD B,C        ;
 $FB2A LD C,A        ;
 $FB2B LD HL,$FB05   ;
 $FB2E XOR A         ;
 $FB2F DEC B         ;
 $FB30 JR Z,$FB35    ;
*$FB32 ADD A,(HL)    ;
 $FB33 DJNZ $FB32    ;
*$FB35 LD L,A        ;
 $FB36 CALL $FBC3    ;
 $FB39 LD ($FB0A),HL ;
 $FB3C SLA H         ;
 $FB3E SLA H         ;
 $FB40 SLA H         ;
 $FB42 LD BC,$E000   ;
 $FB45 ADD HL,BC     ;
 $FB46 EX DE,HL      ;
 $FB47 LD A,($FB07)  ;
 $FB4A LD L,A        ;
 $FB4B LD A,($FB06)  ;
 $FB4E LD C,A        ;
 $FB4F CALL $FBC3    ;
 $FB52 LD ($FB08),HL ;
 $FB55 SLA H         ;
 $FB57 SLA H         ;
 $FB59 SLA H         ;
 $FB5B LD BC,$4000   ;
 $FB5E ADD HL,BC     ;
 $FB5F EX DE,HL      ;
 $FB60 LD A,($FB05)  ;
 $FB63 LD B,A        ;
 $FB64 DI            ;
*$FB65 PUSH BC       ;
 $FB66 LD B,$00      ;
 $FB68 LD IYl,$08    ;
*$FB6B LD A,($FB04)  ;
 $FB6E LD C,A        ;
 $FB6F LD A,L        ;
 $FB70 LD IYh,E      ;
 $FB72 LDIR          ;
 $FB74 LD L,A        ;
 $FB75 LD E,IYh      ;
 $FB77 INC D         ;
 $FB78 INC H         ;
 $FB79 DEC IYl       ;
 $FB7B JR NZ,$FB6B   ;
 $FB7D LD A,E        ;
 $FB7E ADD A,$20     ;
 $FB80 LD E,A        ;
 $FB81 JR C,$FB87    ;
 $FB83 LD A,D        ;
 $FB84 SUB $08       ;
 $FB86 LD D,A        ;
*$FB87 LD A,L        ;
 $FB88 ADD A,$20     ;
 $FB8A LD L,A        ;
 $FB8B JR C,$FB91    ;
 $FB8D LD A,H        ;
 $FB8E SUB $08       ;
 $FB90 LD H,A        ;
*$FB91 POP BC        ;
 $FB92 DJNZ $FB65    ;
 $FB94 LD HL,($FB0A) ;
 $FB97 LD BC,$F800   ;
 $FB9A ADD HL,BC     ;
 $FB9B EX DE,HL      ;
 $FB9C LD HL,($FB08) ;
@nowarn
 $FB9F LD BC,$5800   ;
 $FBA2 ADD HL,BC     ;
 $FBA3 EX DE,HL      ;
 $FBA4 LD A,($FB05)  ;
 $FBA7 LD IYl,A      ;
 $FBA9 LD B,$00      ;
*$FBAB LD A,($FB04)  ;
 $FBAE LD C,A        ;
 $FBAF LD A,L        ;
 $FBB0 LD IYh,E      ;
 $FBB2 LDIR          ;
 $FBB4 LD L,A        ;
