; #PUSHS #POKES$8002,$01
; #UDGTABLE
; { =h The Scene Of The Crime }
; { #SIM(start=$8000,stop=$80E3,sp=$7FF0)#SCR$02(scene-of-the-crime) }
; UDGTABLE#
