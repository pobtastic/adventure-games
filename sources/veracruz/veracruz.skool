; Draw Picture
;
; Used by the BASIC program. Draws picture number *#R$8002 from the
; picture list that starts at #R$812C. The picture goes to the screen, or to a
; buffer when BASIC has POKEd the high bytes used by the instructions at
; #R$807A (pixels) and #R$80C3 (attributes).
; .
; Each picture record is laid out as follows:
; #TABLE(default,centre,centre,centre)
; { =h Offset | =h Bytes | =h Contents }
; { #N$00 | #N$02 | The length of the record, less one }
; { #N$02 | #N$01 | The screen third to start at }
; { #N$03 | #N$01 | The number of thirds to draw }
; { #N$04 | #N$01 | Flags; see #R$8005 }
; { #N$05 | Varies | Pixel data, then attribute data }
; TABLE#
; .
; Both lots of data are run-length encoded. A non-zero byte is written
; as it is. A zero byte is followed by a count and a value, and the value is
; written that many times (a count of zero writes it 256 times).
; .
; When bit 0 of the flags is clear, the pixel data is in column order:
; each column is written from the top of the picture to the bottom, one byte
; for each pixel line, and then the next column to the right follows. When
; bit 0 is set, the pixel data is in row order: each pixel line is written
; from left to right, from the top of the picture to the bottom. The
; attribute data is always in the same order as the attribute file.
; .
; The routine works out its own address as it runs, so the same code
; works in both parts of the game.
@label=DrawPicture
c$8000 JR $8006      ; Jump over the parameters to #R$8006.
; View the equivalent code in;
; #LIST
; { #VERACRUZTWO$C350 }
; LIST#

; Draw Picture Parameters
;
; Parameters for #R$8000, read and written through #REGiy. BASIC only
; POKEs the picture number here; *#R$8003 and *#R$8004
; are always #N$FF in the snapshot, so the routine takes the screen third and
; the number of thirds from the picture record.
; .
; The flags at #R$8005:
; #TABLE(default,centre,centre)
; { =h Bit | =h Relating To }
; { #N$00 | Pixel data order (set: rows; clear: columns) }
; { #N$02 | Set while a run of repeated bytes is being written }
; { #N$03 | Set while the attributes are being drawn }
; TABLE#
@label=DrawPicture_Number
g$8002 DEFB $01      ; Picture number (#N$01 for the first picture in the
                     ; list).
@label=DrawPicture_Third
 $8003 DEFB $FF      ; Screen third to start at, from #N$00 (top) to #N$02 (bottom).
                     ; #N$FF means use the value in the picture record.
@label=DrawPicture_Thirds
 $8004 DEFB $FF      ; Number of thirds to draw, from #N$01 to #N$03. #N$FF means use the
                     ; value in the picture record.
@label=DrawPicture_Flags
 $8005 DEFB $0C      ; Flags, copied from the picture record.
; View the equivalent code in;
; #LIST
; { #VERACRUZTWO$C352 }
; LIST#

; Draw Picture: Unpack
;
; Used by the routine at #R$8000.
; .
; Continues from #R$8000.
;
; .
;
; Find out where this code is in memory. The call leaves its return
; address (#R$8009) just below the stack pointer. An interrupt at this point
; would overwrite it, so BASIC calls #R$FC0E first and #R$FC10 afterwards.
@label=DrawPicture_Unpack
c$8006 CALL $007C      ; Call the RET instruction at #N($007C,$04,$04), at the end of
                       ; #SKOOLKID$0074,$007C(CH_ADD+1), which returns straight away.
@label=DrawPicture_ReturnAddress
 $8009 DEC SP          ; {Move the stack pointer back down to the return
 $800A DEC SP          ; address.}
 $800B EX (SP),HL      ; Swap it into #REGhl, so #REGhl=#R$8009.
 $800C INC SP          ; {Move the stack pointer back up again.
 $800D INC SP          ; }
 $800E AND A           ; Clear the carry flag ready for the subtraction.
 $800F LD DE,$0007     ; {#REGhl=#R$8002 (#R$8009 less #N($0007,$04,$04)).
 $8012 SBC HL,DE       ; }
 $8014 PUSH HL         ; Stash the address of the parameters on the stack.
 $8015 POP IY          ; Restore the address of the parameters from the stack
                       ; into #REGiy.
 $8017 LD DE,$012A     ; {#REGhl=#R$812C (#R$8002 plus #N($012A,$04,$04)), the first picture
 $801A ADD HL,DE       ; record.}
 $801B LD A,(IY+$00)   ; #REGa=the picture number from *#R$8002.
; Skip over the records before the requested picture.
@label=DrawPicture_FindPicture
*$801E DEC A           ; Decrease the picture number by one.
 $801F JR Z,$8027      ; Jump to #R$8027 if #REGhl points to the requested
                       ; picture.
 $8021 LD E,(HL)       ; {#REGde=the length of this record, less one.
 $8022 INC HL          ;
 $8023 LD D,(HL)       ; }
 $8024 ADD HL,DE       ; Add it to #REGhl, so #REGhl points to the next record.
 $8025 JR $801E        ; Jump to #R$801E.
@label=DrawPicture_Found
*$8027 LD DE,$4000     ; #REGde=#N($4000,$04,$04). This value is never used, as #REGd and
                       ; #REGe are both set again before they are needed.
 $802A INC HL          ; {Move #REGhl past the length, to the record's screen
 $802B INC HL          ; third.}
 $802C LD A,(IY+$01)   ; #REGa=*#R$8003.
 $802F INC A           ; Increment #REGa by one, so that #N$FF becomes zero.
 $8030 JR NZ,$8036     ; Jump to #R$8036 if *#R$8003 is not #N$FF.
 $8032 LD A,(HL)       ; {Else write the record's screen third to *#R$8003.
 $8033 LD (IY+$01),A   ; }
*$8036 INC HL          ; Move on to the record's number of thirds.
 $8037 LD A,(IY+$02)   ; #REGa=*#R$8004.
 $803A INC A           ; Increment #REGa by one, so that #N$FF becomes zero.
 $803B JR NZ,$8041     ; Jump to #R$8041 if *#R$8004 is not #N$FF.
 $803D LD A,(HL)       ; {Else write the record's number of thirds to *#R$8004.
 $803E LD (IY+$02),A   ; }
*$8041 INC HL          ; Move on to the record's flags.
 $8042 LD A,(HL)       ; {Copy the record's flags to *#R$8005.
 $8043 LD (IY+$03),A   ; }
; Make sure the picture fits on the screen.
 $8046 LD A,(IY+$01)   ; #REGa=*#R$8003.
 $8049 CP $03          ; {Jump to #R$8051 if the screen third is less than
 $804B JR C,$8051      ; #N$03.}
 $804D LD (IY+$01),$00 ; Else start at the top third (write #N$00 to *#R$8003).
*$8051 LD A,(IY+$02)   ; #REGa=*#R$8004.
 $8054 CP $04          ; {Jump to #R$805C if the number of thirds is less than
 $8056 JR C,$805C      ; #N$04.}
 $8058 LD (IY+$02),$01 ; Else draw one third (write #N$01 to *#R$8004).
*$805C ADD A,(IY+$01)  ; Add the screen third to #REGa. #REGa still holds the number of
                       ; thirds read at #R$8051, even when it has just been changed.
 $805F CP $04          ; {Jump to #R$8067 if the picture ends on the screen (the total is
 $8061 JR C,$8067      ; less than #N$04).}
 $8063 LD (IY+$02),$01 ; Else draw one third (write #N$01 to *#R$8004).
*$8067 LD A,(IY+$02)   ; #REGa=*#R$8004.
 $806A AND A           ; {Jump to #R$8071 if the number of thirds is not zero.
 $806B JR NZ,$8071     ; }
 $806D LD (IY+$02),$01 ; Else draw one third (write #N$01 to *#R$8004).
; Draw the pixels.
@label=DrawPicture_Pixels
*$8071 INC HL          ; Move #REGhl on to the start of the picture data.
 $8072 LD E,$00        ; #REGe=#N$00 (the left-hand column).
 $8074 LD A,(IY+$01)   ; #REGa=*#R$8003.
 $8077 ADD A,A         ; {Multiply it by #N$08, as each third of the screen is #N$08 pages
 $8078 ADD A,A         ; long.
 $8079 ADD A,A         ; }
@label=DrawPicture_PixelsHighByte
 $807A ADD A,$40       ; Add the high byte of the start of the screen (#N$40). BASIC POKEs
                       ; this byte to draw into a buffer instead.
 $807C LD D,A          ; {Set #REGd and #REGc to the high byte of the top pixel line of the
 $807D LD C,A          ; picture, so #REGde holds its screen address.}
 $807E LD B,$01        ; #REGb=#N$01 (one pass, for row order).
 $8080 BIT 0,(IY+$03)  ; {Jump to #R$8088 if bit 0 of *#R$8005 is set (row
 $8084 JR NZ,$8088     ; order).}
 $8086 LD B,$20        ; Else #REGb=#N$20 (one pass for each column).
@label=DrawPicture_PassLoop
*$8088 PUSH BC         ; Stash the pass counter on the stack.
 $8089 LD B,(IY+$02)   ; #REGb=the number of thirds from *#R$8004.
@label=DrawPicture_ThirdLoop
*$808C PUSH BC         ; Stash the thirds counter on the stack.
 $808D LD B,$08        ; #REGb=#N$08 (character rows in a third).
@label=DrawPicture_RowLoop
*$808F PUSH BC         ; Stash the character row counter on the stack.
 $8090 LD B,$08        ; #REGb=#N$08 (pixel lines in a character row).
@label=DrawPicture_LineLoop
*$8092 PUSH BC         ; Stash the pixel line counter on the stack.
 $8093 LD B,$01        ; #REGb=#N$01 (one byte, for column order).
 $8095 BIT 0,(IY+$03)  ; {Jump to #R$809D if bit 0 of *#R$8005 is clear (column
 $8099 JR Z,$809D      ; order).}
 $809B LD B,$20        ; Else #REGb=#N$20 (a whole pixel line, for row order).
*$809D PUSH DE         ; Stash the screen address of this pixel line on the
                       ; stack.
@label=DrawPicture_ByteLoop
*$809E PUSH BC         ; Stash the byte counter on the stack.
 $809F JR $80E4        ; Jump to #R$80E4 to write the next byte; it comes back
                       ; to #R$80A1.
@label=DrawPicture_NextByte
*$80A1 POP BC          ; Restore the byte counter from the stack.
 $80A2 INC DE          ; Move right to the next screen byte.
 $80A3 DJNZ $809E      ; Decrease the byte counter by one and loop back to #R$809E until
                       ; it is zero.
 $80A5 POP DE          ; Restore the screen address of this pixel line from the
                       ; stack.
 $80A6 POP BC          ; Restore the pixel line counter from the stack.
 $80A7 INC D           ; Move down to the next pixel line.
 $80A8 DJNZ $8092      ; Decrease the pixel line counter by one and loop back to #R$8092
                       ; until all #N$08 pixel lines are done.
 $80AA LD A,D          ; {Move #REGd back up to the top pixel line of this character row
 $80AB SUB $08         ; (subtract #N$08).
 $80AD LD D,A          ; }
 $80AE LD A,E          ; {Move down to the next character row (add #N$20 to
 $80AF ADD A,$20       ; #REGe).
 $80B1 LD E,A          ; }
 $80B2 POP BC          ; Restore the character row counter from the stack.
 $80B3 DJNZ $808F      ; Decrease the character row counter by one and loop back to
                       ; #R$808F until all #N$08 character rows are done.
 $80B5 LD A,D          ; {Move down to the next third (add #N$08 to #REGd). #REGe has gone
 $80B6 ADD A,$08       ; back round to the same column.
 $80B8 LD D,A          ; }
 $80B9 POP BC          ; Restore the thirds counter from the stack.
 $80BA DJNZ $808C      ; Decrease the thirds counter by one and loop back to #R$808C until
                       ; all the thirds are done.
 $80BC LD D,C          ; Move #REGd back up to the top of the picture
                       ; (#REGd=#REGc).
 $80BD INC E           ; Move right to the next column.
 $80BE POP BC          ; Restore the pass counter from the stack.
 $80BF DJNZ $8088      ; Decrease the pass counter by one and loop back to #R$8088 until
                       ; all the passes are done.
; Draw the attributes.
@label=DrawPicture_Attributes
 $80C1 LD E,$00        ; #REGe=#N$00.
@label=DrawPicture_AttributesHighByte
 $80C3 LD A,$58        ; #REGa=#N$58, the high byte of the start of the attribute file.
                       ; BASIC POKEs this byte to draw into a buffer instead.
 $80C5 ADD A,(IY+$01)  ; Add the screen third.
 $80C8 LD D,A          ; #REGd=#REGa, so #REGde holds the address of the first attribute
                       ; of the picture.
 $80C9 LD B,(IY+$02)   ; {#REGbc=the number of attributes to draw: 256 for each third
 $80CC LD C,E          ; (#REGb=*#R$8004 and #REGc=#N$00).}
 $80CD SET 3,(IY+$03)  ; Set bit 3 of *#R$8005, so that #R$80E4 comes back to
                       ; #R$80D4.
@label=DrawPicture_AttributesLoop
*$80D1 PUSH BC         ; Stash the attribute counter on the stack.
 $80D2 JR $80E4        ; Jump to #R$80E4 to write the next attribute; it comes back to
                       ; #R$80D4.
@label=DrawPicture_NextAttribute
*$80D4 POP BC          ; Restore the attribute counter from the stack.
 $80D5 DEC BC          ; Decrease the attribute counter by one.
 $80D6 INC DE          ; Move on to the next attribute.
 $80D7 LD A,B          ; {Jump back to #R$80D1 until the attribute counter is
 $80D8 OR C            ; zero.
 $80D9 JR NZ,$80D1     ; }
 $80DB LD (IY+$01),$FF ; {Write #N$FF to *#R$8003 and *#R$8004. BASIC never POKEs these
 $80DF LD (IY+$02),$FF ; bytes, so the next picture again takes its screen third and number of
                       ; thirds from its own record.}
 $80E3 RET             ; Return.
; Write the next byte of picture data to *#REGde. While a run of
; repeated bytes is being written, bit 2 of *#R$8005 is set, #REGb' holds the
; count and #REGc' holds the value.
@label=DrawPicture_FetchByte
*$80E4 BIT 2,(IY+$03)  ; {Jump to #R$80F7 if no run is in progress.
 $80E8 JR Z,$80F7      ; }
 $80EA EXX             ; Switch to the shadow registers.
 $80EB DEC B           ; Decrease the run count in #REGb' by one.
 $80EC LD A,C          ; #REGa=the run value from #REGc'.
 $80ED EXX             ; Switch back to the normal registers.
 $80EE JR Z,$80F3      ; Jump to #R$80F3 if the run has finished.
 $80F0 LD (DE),A       ; Write the run value to *#REGde.
 $80F1 JR $810B        ; Jump to #R$810B.
@label=DrawPicture_EndRun
*$80F3 RES 2,(IY+$03)  ; Clear bit 2 of *#R$8005, as the run has finished.
@label=DrawPicture_ReadByte
*$80F7 LD A,(HL)       ; {#REGa=the next byte of picture data, and move #REGhl
 $80F8 INC HL          ; on.}
 $80F9 AND A           ; {Jump to #R$810A if it is not zero, to write it as it
 $80FA JR NZ,$810A     ; is.}
 $80FC LD A,(HL)       ; {A zero byte starts a run. #REGb'=the count.
 $80FD EXX             ;
 $80FE LD B,A          ;
 $80FF EXX             ; }
 $8100 INC HL          ; Move #REGhl on to the value.
 $8101 LD A,(HL)       ; {#REGc'=the value (#REGa holds it too).
 $8102 EXX             ;
 $8103 LD C,A          ;
 $8104 EXX             ; }
 $8105 INC HL          ; Move #REGhl on to the next byte of picture data.
 $8106 SET 2,(IY+$03)  ; Set bit 2 of *#R$8005, as a run is in progress.
@label=DrawPicture_WriteByte
*$810A LD (DE),A       ; Write the byte to *#REGde.
@label=DrawPicture_Continue
*$810B BIT 3,(IY+$03)  ; {Jump back to #R$80D4 if the attributes are being
 $810F JR NZ,$80D4     ; drawn.}
 $8111 JR $80A1        ; Else jump back to #R$80A1.
; View the equivalent code in;
; #LIST
; { #VERACRUZTWO$C356 }
; LIST#

; Unused
;
; These bytes follow the picture routine; nothing reads them.
u$8113 DEFB $08,$10,$11,$12,$12,$14,$00,$03,$00,$01,$02,$01,$00,$03,$00,$0F
 $8123 DEFB $19,$0E,$00,$04,$00,$08,$18,$22,$22

; Graphics: The Scene Of The Crime
;
; The Forest Residence, where the victim lies on the floor; drawn into
; #R$C000 by line 160. The name comes from the instructions ("1. The Forest
; Residence: The scene of the Crime.").
