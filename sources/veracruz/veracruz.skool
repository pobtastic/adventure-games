; Screen Buffer
;
; Line 160 draws the scene of the crime here; #R$FC00 copies it to the
; screen.
@label=ScreenBuffer
b$C000 DEFS $1800    ; Pixels.
 $D800 DEFS $0300    ; Attributes.

; Unused
u$DB00 DEFS $0500

; Picture Buffer
;
; BASIC draws a picture sheet here; #R$FB00 copies single frames from it
; to the screen.
@label=PictureBuffer
b$E000 DEFS $1800    ; Pixels.
@label=PictureBuffer_Attributes
 $F800 DEFS $0300    ; Attributes.

; Display Frame
;
; Copies one frame of the picture held in the buffer at #R$E000 to the
; screen: first the pixel rows, then the attributes from #R$F800. Called
; by BASIC with the frame number POKEd into #R$FB02.
; .
; The values in the snapshot describe rows of #N$03 frames of #N$0A by
; #N$11 characters, copied to column #N$03, row #N$02.
@label=DisplayFrame
c$FB00 JR $FB0C      ; Jump to #R$FB0C.

; Display Frame Parameters
;
; Parameters for #R$FB00.
@label=DisplayFrame_Number
g$FB02 DEFB $01      ; Frame number (counting from #N$01).
@label=DisplayFrame_PerRow
 $FB03 DEFB $03      ; Frames in each row of the picture.
@label=DisplayFrame_Width
 $FB04 DEFB $0A      ; Width of a frame, in characters.
@label=DisplayFrame_Height
 $FB05 DEFB $11      ; Height of a frame, in characters.
@label=DisplayFrame_Column
 $FB06 DEFB $03      ; Screen column to copy the frame to.
@label=DisplayFrame_Row
 $FB07 DEFB $02      ; Screen row to copy the frame to.
@label=DisplayFrame_ScreenOffset
 $FB08 DEFW $0000    ; Screen offset (work space).
@label=DisplayFrame_BufferOffset
 $FB0A DEFW $0000    ; Buffer offset (work space).

