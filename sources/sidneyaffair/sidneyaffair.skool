 $82E6 DEFB $FF,$00,$04,$7F,$7E,$3E,$3E,$5E,$4C,$4C,$4C,$2C,$00,$05,$28,$24 ; pixel
 $82F6 DEFB $24,$14,$14,$0C,$04,$04,$00,$04,$02,$00,$04,$01,$00,$09,$00,$80 ; data.
