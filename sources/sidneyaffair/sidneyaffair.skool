; Last Bytes Of Code Block
;
; The picture sheets end at #N($ACCC,$04,$04). These last bytes of the
; CODE block at #N($8000,$04,$04) (the zero list terminator and padding) are
; not part of any picture record.
u$ACCD DEFS $1F

; Unused
u$ACEC DEFS $1314

; Screen Buffer
;
; Lines 105 and 174 draw a room scene here; #R$FF57 copies it to the
; screen.
@label=ScreenBuffer
b$C000 DEFS $1800    ; Pixels.
 $D800 DEFS $0300    ; Attributes.

; Unused
u$DB00 DEFS $0500

; Picture Buffer
;
; BASIC draws a picture sheet here; #R$FB09 copies single frames from it
; to the screen.
@label=PictureBuffer
b$E000 DEFS $1800    ; Pixels.
@label=PictureBuffer_Attributes
 $F800 DEFS $0300    ; Attributes.

; Display Frame Parameters
;
; Parameters for #R$FB09. BASIC POKEs them relative to "ins".
@label=DisplayFrame_BufferBase
g$FB00 DEFW $E000    ; Buffer base address (#N($E000,$04,$04) in the snapshot).
@label=DisplayFrame_Number
 $FB02 DEFB $01      ; Frame number (counting from #N$01).
@label=DisplayFrame_PerRow
 $FB03 DEFB $04      ; Frames in each row of the picture.
@label=DisplayFrame_Width
 $FB04 DEFB $08      ; Width of a frame, in characters.
@label=DisplayFrame_Height
 $FB05 DEFB $0A      ; Height of a frame, in characters.
@label=DisplayFrame_Column
 $FB06 DEFB $19      ; Screen column to copy the frame to.
@label=DisplayFrame_Row
 $FB07 DEFB $03      ; Screen row to copy the frame to.
@label=DisplayFrame_LineWidth
 $FB08 DEFB $07      ; Width of a pixel line to copy, in bytes.

; Display Frame
;
; Copies one frame of the picture held in the buffer at #R$E000 to the
; screen: first the pixel rows, then the attributes from #R$F800. Called by
; BASIC as "ins" (#N($FB09,$04,$04)) with the frame number POKEd into
; #R$FB02.
; .
; The routine works out the frame's row and column in the sheet from
; *#R$FB02 and *#R$FB03, converts those to byte offsets with #R$FBB9, and
; copies *#R$FB05 character rows of *#R$FB08 bytes from the buffer to the
; screen at *#R$FB06 / *#R$FB07. It then copies the matching attributes from
; the buffer (offset by #N($1800,$04,$04)) to the attribute file.
; .
; The values in the snapshot describe rows of #N$04 frames of #N$08 by
; #N$0A characters, copied to column #N$19, row #N$03 after line 60.
@label=DisplayFrame
c$FB09 DI            ; Disable interrupts.
 $FB0A LD ($FF76),SP ;
 $FB0E LD SP,$FFBE   ;
 $FB11 LD A,($FB03)  ;
 $FB14 LD B,A        ;
 $FB15 LD C,$01      ;
 $FB17 LD A,($FB02)  ;
 $FB1A DEC A         ;
*$FB1B CP B          ;
 $FB1C JR C,$FB22    ;
 $FB1E SUB B         ;
 $FB1F INC C         ;
 $FB20 JR $FB1B      ;
*$FB22 INC A         ;
 $FB23 LD B,A        ;
 $FB24 LD HL,$FB04   ;
 $FB27 XOR A         ;
 $FB28 DEC B         ;
 $FB29 JR Z,$FB2E    ;
*$FB2B ADD A,(HL)    ;
 $FB2C DJNZ $FB2B    ;
*$FB2E LD B,C        ;
 $FB2F LD C,A        ;
 $FB30 LD HL,$FB05   ;
 $FB33 XOR A         ;
 $FB34 DEC B         ;
 $FB35 JR Z,$FB3A    ;
*$FB37 ADD A,(HL)    ;
 $FB38 DJNZ $FB37    ;
*$FB3A LD L,A        ;
 $FB3B CALL $FBB9    ;
 $FB3E LD ($FBC5),HL ;
 $FB41 SLA H         ;
 $FB43 SLA H         ;
 $FB45 SLA H         ;
 $FB47 LD BC,($FB00) ;
 $FB4B ADD HL,BC     ;
 $FB4C EX DE,HL      ;
 $FB4D LD A,($FB07)  ;
 $FB50 LD L,A        ;
 $FB51 LD A,($FB06)  ;
 $FB54 LD C,A        ;
 $FB55 CALL $FBB9    ;
 $FB58 LD ($FBC3),HL ;
 $FB5B SLA H         ;
 $FB5D SLA H         ;
 $FB5F SLA H         ;
 $FB61 LD BC,$4000   ;
 $FB64 ADD HL,BC     ;
 $FB65 EX DE,HL      ;
 $FB66 LD A,($FB05)  ;
 $FB69 LD B,A        ;
@nowarn
*$FB6A PUSH BC       ;
 $FB6B LD B,$00      ;
@nowarn
*$FB6D LD A,($FB08)  ;
 $FB70 LD C,A        ;
 $FB71 PUSH HL       ;
 $FB72 PUSH DE       ;
 $FB73 LDIR          ;
 $FB75 POP DE        ;
 $FB76 POP HL        ;
 $FB77 CALL $FC5B    ;
 $FB7A EX DE,HL      ;
 $FB7B CALL $FC5B    ;
 $FB7E EX DE,HL      ;
 $FB7F JR NZ,$FB6D   ;
 $FB81 POP BC        ;
 $FB82 DJNZ $FB6A    ;
 $FB84 LD HL,($FBC5) ;
 $FB87 LD BC,($FB00) ;
 $FB8B ADD HL,BC     ;
 $FB8C LD BC,$1800   ;
 $FB8F ADD HL,BC     ;
 $FB90 EX DE,HL      ;
 $FB91 LD HL,($FBC3) ;
 $FB94 LD BC,$5800   ;
 $FB97 ADD HL,BC     ;
 $FB98 EX DE,HL      ;
 $FB99 LD A,($FB05)  ;
 $FB9C LD IYl,A      ;
 $FB9E LD B,$00      ;
@nowarn
*$FBA0 LD A,($FB08)  ;
 $FBA3 LD C,A        ;
 $FBA4 PUSH HL       ;
 $FBA5 PUSH DE       ;
 $FBA6 LDIR          ;
 $FBA8 POP DE        ;
 $FBA9 POP HL        ;
 $FBAA LD C,$20      ;
 $FBAC ADD HL,BC     ;
 $FBAD EX DE,HL      ;
 $FBAE ADD HL,BC     ;
 $FBAF EX DE,HL      ;
 $FBB0 DEC IYl       ;
 $FBB2 JR NZ,$FBA0   ;
 $FBB4 LD SP,($FF76) ;
 $FBB8 RET           ;

; Display Frame: Calculate Offset
;
; Used by the routine at #R$FB09.
; .
; Returns #REGhl = #REGl * #N$20 + #REGc.
;
;   C Column
;   L Row
; O:HL Offset
@label=DisplayFrame_CalculateOffset
c$FBB9 LD H,$00      ;
 $FBBB LD B,H        ;
 $FBBC ADD HL,HL     ;
 $FBBD ADD HL,HL     ;
 $FBBE ADD HL,HL     ;
 $FBBF ADD HL,HL     ;
 $FBC0 ADD HL,HL     ;
 $FBC1 ADD HL,BC     ;
 $FBC2 RET           ;

; Display Frame Work Space
;
; Work space used by #R$FB09 for the screen and buffer character
; offsets of the frame.
@label=DisplayFrame_ScreenOffset
g$FBC3 DEFW $0000    ; Screen character offset.
@label=DisplayFrame_BufferOffset
 $FBC5 DEFW $0000    ; Buffer character offset.

; Sound: Noise
;
; Makes a short noise on the speaker by toggling bit 4 of port
; #N($FE,$02,$02) for #N($0080,$04,$04) pulses. Called by BASIC as "noi"
; (#N($FBC7,$04,$04)).
@label=Sound_Noise
c$FBC7 DI            ; Disable interrupts.
 $FBC8 LD BC,$0080   ;
 $FBCB LD A,($5C48)  ;
 $FBCE RRCA          ;
 $FBCF RRCA          ;
 $FBD0 RRCA          ;
 $FBD1 EX AF,AF'     ;
 $FBD2 LD H,$00      ;
*$FBD4 EX AF,AF'     ;
 $FBD5 OUT ($FE),A   ;
 $FBD7 XOR $10       ;
 $FBD9 EX AF,AF'     ;
 $FBDA LD L,$00      ;
 $FBDC LD D,L        ;
 $FBDD LD E,H        ;
 $FBDE AND A         ;
 $FBDF SBC HL,DE     ;
 $FBE1 SBC HL,DE     ;
 $FBE3 LD DE,$00FE   ;
 $FBE6 ADD HL,DE     ;
 $FBE7 LD A,L        ;
 $FBE8 SUB H         ;
 $FBE9 JR C,$FBEC    ;
 $FBEB DEC A         ;
*$FBEC LD H,A        ;
*$FBED DEC A         ;
 $FBEE JR NZ,$FBED   ;
 $FBF0 DEC BC        ;
 $FBF1 LD A,B        ;
 $FBF2 OR C          ;
 $FBF3 JR NZ,$FBD4   ;
 $FBF5 RET           ;

; Scroll Window Parameters
;
; Parameters for #R$FBFE. BASIC POKEs them relative to "scr".
@label=ScrollWindow_Fill
g$FBF6 DEFB $80,$00,$01 ; Fill bytes for the bottom line of the window (left, middle,
                        ; right).
@label=ScrollWindow_Lines
 $FBF9 DEFB $08         ; Number of pixel lines to scroll.
@label=ScrollWindow_Left
 $FBFA DEFB $08         ; Left column.
@label=ScrollWindow_Top
 $FBFB DEFB $00         ; Top pixel line.
@label=ScrollWindow_Right
 $FBFC DEFB $1F         ; Right column.
@label=ScrollWindow_Bottom
 $FBFD DEFB $AF         ; Bottom pixel line.

; Scroll Window
;
; Scrolls a window of the screen up one pixel line at a time, filling
; the new bottom line from #R$FBF6. Called by BASIC as "scr"
; (#N($FBFE,$04,$04)).
@label=ScrollWindow
c$FBFE DI            ; Disable interrupts.
 $FBFF LD ($FF76),SP ;
 $FC03 LD SP,$FFBE   ;
 $FC06 LD A,($FBF9)  ;
 $FC09 LD ($FC44),A  ;
@nowarn
*$FC0C LD A,($FBFB)  ;
 $FC0F LD C,A        ;
 $FC10 LD A,($FBFA)  ;
 $FC13 LD B,A        ;
 $FC14 CALL $FC45    ;
 $FC17 LD A,($FBFD)  ;
 $FC1A SUB C         ;
 $FC1B LD IYl,A      ;
 $FC1D LD A,($FBFC)  ;
 $FC20 SUB B         ;
 $FC21 INC A         ;
 $FC22 LD C,A        ;
 $FC23 LD B,$00      ;
@nowarn
*$FC25 LD D,H        ;
 $FC26 LD E,L        ;
 $FC27 CALL $FC5B    ;
 $FC2A LD A,L        ;
 $FC2B LD IXl,C      ;
 $FC2D LDIR          ;
 $FC2F LD C,IXl      ;
 $FC31 LD L,A        ;
 $FC32 DEC IYl       ;
 $FC34 JR NZ,$FC25   ;
 $FC36 CALL $FC6C    ;
 $FC39 LD HL,$FC44   ;
 $FC3C DEC (HL)      ;
 $FC3D JR NZ,$FC0C   ;
 $FC3F LD SP,($FF76) ;
 $FC43 RET           ;
 $FC44 EX AF,AF'     ;

; Scroll Window: Screen Address
;
; Used by the routine at #R$FBFE.
; .
; Returns the screen address of pixel line #REGc, column #REGb.
;
;   B Column
;   C Pixel line
; O:HL Screen address
@label=ScrollWindow_ScreenAddress
c$FC45 LD A,C        ;
 $FC46 AND $C0       ;
 $FC48 RRCA          ;
 $FC49 RRCA          ;
 $FC4A RRCA          ;
 $FC4B ADD A,$40     ;
 $FC4D LD H,A        ;
 $FC4E LD A,C        ;
 $FC4F AND $07       ;
 $FC51 ADD A,H       ;
 $FC52 LD H,A        ;
 $FC53 LD A,C        ;
 $FC54 RLCA          ;
 $FC55 RLCA          ;
 $FC56 AND $E0       ;
 $FC58 OR B          ;
 $FC59 LD L,A        ;
 $FC5A RET           ;

; Scroll Window: Next Pixel Line
;
; Used by the routines at #R$FB09 and #R$FBFE.
; .
; Moves #REGhl down one pixel line on the screen. Returns with the zero
; flag set when a new character row has been entered.
;
; HL Screen address
@label=ScrollWindow_NextLine
c$FC5B INC H         ;
 $FC5C LD A,H        ;
 $FC5D AND $07       ;
 $FC5F RET NZ        ;
 $FC60 LD A,L        ;
 $FC61 ADD A,$20     ;
 $FC63 LD L,A        ;
 $FC64 JR C,$FC6A    ;
 $FC66 LD A,H        ;
 $FC67 SUB $08       ;
 $FC69 LD H,A        ;
*$FC6A XOR A         ;
 $FC6B RET           ;

; Scroll Window: Fill Bottom Line
;
; Used by the routine at #R$FBFE.
; .
; Fills the bottom pixel line of the window from #R$FBF6: the left byte,
; a run of the middle byte, then the right byte.
@label=ScrollWindow_FillLine
c$FC6C LD A,($FBF6)  ;
 $FC6F LD (HL),A     ;
 $FC70 INC HL        ;
 $FC71 LD A,($FBF7)  ;
 $FC74 LD (HL),A     ;
 $FC75 LD D,H        ;
 $FC76 LD E,L        ;
 $FC77 INC DE        ;
 $FC78 DEC BC        ;
 $FC79 DEC BC        ;
 $FC7A DEC BC        ;
 $FC7B LDIR          ;
 $FC7D LD A,($FBF8)  ;
 $FC80 LD (HL),A     ;
 $FC81 INC HL        ;
 $FC82 RET           ;

; Print String Variable Name
;
; Name of the string variable printed by #R$FC86 ("S$", then a space).
@label=PrintString_VariableName
b$FC83 DEFM "S$ "

; Print String
;
; Prints the BASIC string "s$" at the current print position in a
; 64-column font. It finds the string with the ROM routine
; #SKOOLKID$28B2(LOOK-VARS), using the name at #R$FC83, and stops with an
; error if it is missing. Codes below #N$20 go straight to RST #N$10; codes
; from #N$90 upwards are skipped. Called by BASIC as "prn"
; (#N($FC86,$04,$04)).
@label=PrintString
c$FC86 DI            ; Disable interrupts.
 $FC87 LD ($FF76),SP ;
 $FC8B LD SP,$FFBE   ;
 $FC8E XOR A         ;
 $FC8F LD ($FD02),A  ;
 $FC92 LD A,$02      ;
 $FC94 CALL $1601    ;
 $FC97 LD HL,$FC83   ;
 $FC9A CALL $FF35    ;
 $FC9D JR Z,$FCB4    ;
*$FC9F LD A,(HL)     ;
 $FCA0 INC HL        ;
 $FCA1 CP $90        ;
 $FCA3 JR NC,$FCAF   ;
 $FCA5 CP $20        ;
 $FCA7 JR NC,$FCAC   ;
 $FCA9 RST $10       ;
 $FCAA JR $FCAF      ;
*$FCAC CALL $FCC4    ;
*$FCAF DEC BC        ;
 $FCB0 LD A,B        ;
 $FCB1 OR C          ;
 $FCB2 JR NZ,$FC9F   ;
*$FCB4 LD A,($FD02)  ;
 $FCB7 OR A          ;
 $FCB8 JR Z,$FCBF    ;
 $FCBA LD A,$20      ;
 $FCBC CALL $FCC4    ;
*$FCBF LD SP,($FF76) ;
 $FCC3 RET           ;

; Print String: Print Character
;
; Used by the routine at #R$FC86.
; .
; Builds two 4-pixel characters side by side in the UDG for "U" (graphic
; code #N$A4) from the font at #R$FD03, and prints that UDG after every second
; character. The flag at #R$FD02 records whether a half is waiting.
;
; A Character code
@label=PrintString_Character
c$FCC4 SUB $20       ;
 $FCC6 PUSH HL       ;
 $FCC7 LD H,$00      ;
 $FCC9 LD L,A        ;
 $FCCA ADD HL,HL     ;
 $FCCB ADD HL,HL     ;
 $FCCC LD DE,$FD03   ;
 $FCCF ADD HL,DE     ;
 $FCD0 EX DE,HL      ;
 $FCD1 PUSH BC       ;
 $FCD2 LD HL,($5C7B) ;
 $FCD5 LD BC,$00A0   ;
 $FCD8 ADD HL,BC     ;
 $FCD9 LD B,$02      ;
*$FCDB PUSH DE       ;
 $FCDC LD C,$04      ;
*$FCDE LD A,(DE)     ;
 $FCDF BIT 1,B       ;
 $FCE1 JR Z,$FCE7    ;
 $FCE3 RRCA          ;
 $FCE4 RRCA          ;
 $FCE5 RRCA          ;
 $FCE6 RRCA          ;
*$FCE7 RLD           ;
 $FCE9 INC HL        ;
 $FCEA INC DE        ;
 $FCEB DEC C         ;
 $FCEC JR NZ,$FCDE   ;
 $FCEE POP DE        ;
 $FCEF DJNZ $FCDB    ;
 $FCF1 POP BC        ;
 $FCF2 LD A,($FD02)  ;
 $FCF5 INC A         ;
 $FCF6 LD ($FD02),A  ;
 $FCF9 BIT 0,A       ;
 $FCFB JR NZ,$FD00   ;
 $FCFD LD A,$A4      ;
 $FCFF RST $10       ;
*$FD00 POP HL        ;
 $FD01 RET           ;

; Print String Half Flag
;
; Half-character flag for #R$FC86.
@label=PrintString_HalfFlag
g$FD02 DEFB $00

; Font
