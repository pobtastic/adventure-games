; Match String Data
;
; Variable names used by #R$FEC9.
@label=MatchString_BName
b$FEC3 DEFM "B$ "    ; Name of the string to search ("B$", then a space).
@label=MatchString_ZName
 $FEC6 DEFM "Z$ "    ; Name of the substring to find ("Z$", then a space).

; Match String
;
; Finds the BASIC string "z$" inside "b$" and returns the match position
; in #REGbc (or zero if there is no match). Called by BASIC on side 2 as
; "ist" (#N($FEC9,$04,$04)).
@label=MatchString
c$FEC9 DI            ; Disable interrupts.
 $FECA LD ($FF76),SP ;
 $FECE LD SP,$FFBE   ;
 $FED1 LD HL,$FEC3   ;
 $FED4 CALL $FF35    ;
 $FED7 JR Z,$FEFC    ;
 $FED9 PUSH HL       ;
 $FEDA PUSH BC       ;
 $FEDB LD HL,$FEC6   ;
 $FEDE CALL $FF35    ;
 $FEE1 LD ($FF52),BC ;
 $FEE5 EX DE,HL      ;
 $FEE6 POP HL        ;
 $FEE7 JR Z,$FF01    ;
 $FEE9 LD BC,($FF52) ;
 $FEED SBC HL,BC     ;
 $FEEF JR C,$FEFB    ;
 $FEF1 INC HL        ;
 $FEF2 LD B,H        ;
 $FEF3 LD C,L        ;
 $FEF4 POP HL        ;
 $FEF5 PUSH HL       ;
*$FEF6 LD A,(DE)     ;
 $FEF7 CPIR          ;
 $FEF9 JR Z,$FF07    ;
*$FEFB POP HL        ;
*$FEFC LD BC,$0000   ;
 $FEFF JR $FF27      ;
*$FF01 POP HL        ;
 $FF02 LD BC,$0001   ;
 $FF05 JR $FF27      ;
*$FF07 PUSH HL       ;
 $FF08 PUSH DE       ;
 $FF09 PUSH BC       ;
 $FF0A PUSH AF       ;
 $FF0B LD BC,($FF52) ;
 $FF0F DEC BC        ;
 $FF10 LD A,B        ;
 $FF11 OR C          ;
 $FF12 JR Z,$FF1D    ;
*$FF14 INC DE        ;
 $FF15 LD A,(DE)     ;
 $FF16 CPI           ;
 $FF18 JR NZ,$FF2C   ;
 $FF1A JP PE,$FF14   ;
*$FF1D POP AF        ;
 $FF1E POP BC        ;
 $FF1F POP HL        ;
 $FF20 POP DE        ;
 $FF21 POP HL        ;
 $FF22 EX DE,HL      ;
 $FF23 SBC HL,DE     ;
 $FF25 LD B,H        ;
 $FF26 LD C,L        ;
*$FF27 LD SP,($FF76) ;
 $FF2B RET           ;
*$FF2C POP AF        ;
 $FF2D POP BC        ;
 $FF2E POP DE        ;
 $FF2F POP HL        ;
 $FF30 JP PE,$FEF6   ;
 $FF33 JR $FEFB      ;

; Match String: Look Up Variable
;
; Used by the routines at #R$FC86 and #R$FEC9.
; .
; Calls #SKOOLKID$28B2(LOOK-VARS) for the name pointed to by #REGhl.
; Returns with the zero flag set if the variable is missing or empty; else
; #REGhl points to the string body and #REGbc holds its length.
;
; HL Pointer to the variable name
@label=MatchString_LookUpVariable
c$FF35 PUSH HL       ;
 $FF36 LD HL,($5C5D) ;
 $FF39 EX (SP),HL    ;
 $FF3A LD ($5C5D),HL ;
 $FF3D CALL $28B2    ;
 $FF40 EX (SP),HL    ;
 $FF41 LD ($5C5D),HL ;
 $FF44 POP HL        ;
 $FF45 JR C,$FF4F    ;
 $FF47 INC HL        ;
 $FF48 LD C,(HL)     ;
 $FF49 INC HL        ;
 $FF4A LD B,(HL)     ;
 $FF4B INC HL        ;
 $FF4C LD A,B        ;
 $FF4D OR C          ;
 $FF4E RET           ;
*$FF4F EI            ;
 $FF50 RST $08       ;
 $FF51 DEFB $01      ; Error code for the RST #N$08 above.
 $FF52 DEFB $00      ;

; Disable Interrupts
;
; Called by BASIC as "iof" (#N($FF53,$04,$04)) either side of
; #R$8000.
@label=DisableInterrupts
c$FF53 DI            ; {Disable interrupts and return.
 $FF54 RET           ; }

; Enable Interrupts
;
; Called by BASIC as "ion" (#N($FF55,$04,$04)).
@label=EnableInterrupts
c$FF55 EI            ; {Enable interrupts and return.
 $FF56 RET           ; }

; Copy Screen Buffer
;
; Copies #N($1B00,$04,$04) bytes from #R$C000 to the screen. Called by
; BASIC as "ref" (#N($FF57,$04,$04)).
@label=CopyScreenBuffer
c$FF57 LD HL,$C000   ; #REGhl=#R$C000.
 $FF5A DI            ; Disable interrupts.
 $FF5B LD DE,$4000   ; #REGde=#N($4000,$04,$04).
 $FF5E LD BC,$1B00   ; #REGbc=#N($1B00,$04,$04).
 $FF61 LDIR          ; Copy the bytes.
 $FF63 RET           ; Return.

; Prepare BASIC Return
;
; Writes the address #R$FF6F into the error stack pointed to by
; #SKOOLKID$5C3D(ERR_SP). Called by BASIC line 4040 as #N($FF64,$04,$04)
; before returning to the editor after a SAVE.
@label=PrepareBasicReturn
c$FF64 DI            ; Disable interrupts.
 $FF65 LD HL,($5C3D) ; {#REGhl=*#SKOOLKID$5C3D(ERR_SP); write #R$FF6F there.
 $FF68 LD DE,$FF6F   ;
 $FF6B LD (HL),E     ;
 $FF6C INC HL        ;
 $FF6D LD (HL),D     ; }
 $FF6E RET           ; Return.

; Return To BASIC
;
; Continues into the ROM at #SKOOLKID$1B7D(STMT-RET).
@label=ReturnToBasic
c$FF6F LD HL,$FF6F   ; #REGhl=#R$FF6F.
 $FF72 PUSH HL       ; Stash #REGhl on the stack.
 $FF73 JP $1B7D      ; Jump to #SKOOLKID$1B7D(STMT-RET).

; Temporary Storage
;
; Work space used by the routines above to hold the stack pointer while
; they switch to a temporary stack.
@label=TemporaryStorage_StackPointer
g$FF76 DEFW $0000    ; Saved stack pointer.
@label=BasicParameter
 $FF78 DEFS $0A

