b $C80E Table: Extra Exits
D $C80E Location id, direction text and a movement triple, repeated until #N$FF. The same shape as an exit inside a location.
D $C80E See #R$9C9F.
N $C80E "#LOCATIONNAME(#PEEK(#PC))".
  $C80E,$01 Location #LOCATION(#PEEK(#PC)).
W $C80F,$02 The direction for #R(#PEEK(#PC + 1) * $100 + #PEEK(#PC))(#LOCATIONNAME(#PEEK(#PC - 1))).
  $C811,$03 #MOVEMENT(#PC)
L $C80E,$06,$05
  $C82C,$01 #TERMINATOR

