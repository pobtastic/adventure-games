> $4000 @expand=#DEF1(#SKOOLKID(addr)(name)#HTML(<a rel="noopener nofollow" href="https://skoolkit.ca/disassemblies/rom/hex/asm/#EVAL({addr},16,4).html">){name}#HTML(</a>))

b $4000 Loading screen
@ $4000 label=Loading
D $4000 #UDGTABLE { #SCR2(loading) | The Hobbit Loading Screen. } UDGTABLE#
  $4000,$1800,$20 Pixels.
  $5800,$0300,$20 Attributes.

b $5B00 Stack Workspace
D $5B00 #R$6C28 sets the stack pointer to #N($5EFF), so the stack grows down through these zeroes. The program does not store game data here.
  $5B00,$0400

b $5F00 Flags: Saved Game Header
D $5F00 Clean copy of the #N$1D bytes at #R$B6EB. #R$6C14 takes the copy and #R$6C52 puts it back when a game starts again. Load and save use the same bytes.
. Read by #R$6C00.
  $5F00,$1D

b $5F1D Initial Object State
D $5F1D Clean copy of the #N$BF bytes from #R$CA84 to #R$CB42. That takes in the object handler table at #R$CA84 and also the Special Object Records at #R$CACB, each with its #N$FF terminator. #R$6C1F takes the copy and #R$6C5D restores it for a new game.
  $5F1D,$BF

u $5FDC Unused
D $5FDC Zero bytes between the initial object state at #R$5F1D and the word index at #R$6000. No instruction reads or writes them.
  $5FDC,$24

w $6000 Word Index
@ $6000 label=WordIndex
D $6000 Read by #R$6E97, #R$6F47 and #R$74C1.
W $6000,$02
  $6002,$02 #WORDPTR
L $6002,$02,$17
  $6030,$02 "X" (does not exist)
  $6032,$02 #WORDPTR
  $6034,$02 "Z" (does not exist)
W $6036,$0A

