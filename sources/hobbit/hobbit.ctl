  $C8EF,$01
W $C8F0,$02
  $C8F2,$01
W $C8F3,$02
  $C8F5,$1E

b $C913 Character Scripts
D $C913 A list of script ids and handler addresses, ending at #N($FF), then the script bytes. An #ACTION byte is a verb from #R$AB53. Read by #R$8451, #R$84CC and #R$A86E.
  $C913,$0140
  $CA53,$29
  $CA7C,$08

b $CA84 Table: Object Handlers
D $CA84 Records of #N$07 bytes: an id, a flag, a handler, another flag and a second handler. #N$FF at #R$CACA ends the list. The #N$BF bytes from here to #R$CB42 take in this table and the Special Object Records at #R$CACB, each with its terminator. #R$6C1F copies them to #R$5F1D and #R$6C5D copies them back for a new game, and #R$8471, #R$8500 and #R$853C load, save and verify them. #R$96CB walks this table.
. Read by #R$6C00, #R$8451, #R$84CC and #R$96B3.
N $CA84 Barrel.
  $CA84,$01
  $CA85,$01
W $CA86,$02
  $CA88,$01
W $CA89,$02
N $CA8B Spider Web.
  $CA8B,$01
  $CA8C,$01
W $CA8D,$02
  $CA8F,$01
W $CA90,$02
N $CA92 Spider Web.
  $CA92,$01
  $CA93,$01
W $CA94,$02
  $CA96,$01
W $CA97,$02
N $CA99 Goblins Door.
  $CA99,$01
  $CA9A,$01
W $CA9B,$02
  $CA9D,$01
W $CA9E,$02
N $CAA0 Deep Bog.
  $CAA0,$01
  $CAA1,$01
W $CAA2,$02
  $CAA4,$01
W $CAA5,$02
N $CAA7 Magic Door.
  $CAA7,$01
  $CAA8,$01
W $CAA9,$02
  $CAAB,$01
W $CAAC,$02
N $CAAE Ring.
  $CAAE,$01
  $CAAF,$01
W $CAB0,$02
  $CAB2,$01
W $CAB3,$02
N $CAB5 S flag. #R$AAF9 copies this countdown into the next byte, and #R$AB0B clears #R$B700 when it runs out.
  $CAB5,$01
  $CAB6,$01
W $CAB7,$02
  $CAB9,$01
W $CABA,$02
N $CABC Forest.
  $CABC,$01
  $CABD,$01
W $CABE,$02
  $CAC0,$01
W $CAC1,$02
N $CAC3 Hole.
  $CAC3,$01
  $CAC4,$01
W $CAC5,$02
  $CAC7,$01
W $CAC8,$02
  $CACA,$01 #TERMINATOR

b $CACB Table: Special Object Records
D $CACB Records of #N$07 bytes, scanned by #R$9A85 until the id is #N$FF. The id is the first byte. Also read by #R$97FF, #R$C7A4 and #R$C7C0.
  $CACB,$77,$07
  $CB42,$01 #TERMINATOR
  $CB43,$BD Unused. Zeroes between the special-object table and the location graphics.

b $CC00 Location Graphics Table
@ $CC00 label=Table_LocationGraphics
D $CC00 The room pictures, drawn by #R$7F78. Also read by #R$6C00 and #R$A971.
  $CC00,$01 Location #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
W $CC01,$02 Location graphics data address.
L $CC00,$03,$16
  $CC42,$01 #TERMINATOR

