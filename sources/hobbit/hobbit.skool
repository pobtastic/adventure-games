; Game Entry Point
;
; Starts a game. The clean object, location and save bytes are copied
; out, then a keypress builds a new game from those copies. Holding N
; while that key is pressed turns the pictures off.
@label=Start
c$6C00 DI            ; Disable interrupts.
; Initial set-up; copies "clean" data to the "CopyOf..." store. This is then
; used to create a new game in #R$6C27.
 $6C01 LD DE,$F400   ; {Copies #N($0615,$04) bytes from #R$C11B to #R$F400.
 $6C04 LD HL,$C11B   ;
 $6C07 LD BC,$0615   ;
 $6C0A LDIR          ; }
 $6C0C LD HL,$BA8A   ; {Copies #N($05D9,$04) bytes from #R$BA8A to #R$FA15.
 $6C0F LD BC,$05D9   ;
 $6C12 LDIR          ; }
 $6C14 LD DE,$5F00   ; {Copies #N$1D bytes from #R$B6EB to #R$5F00.
 $6C17 LD HL,$B6EB   ;
 $6C1A LD BC,$001D   ;
 $6C1D LDIR          ; }
 $6C1F LD HL,$CA84   ; {Copies #N$BF bytes from #R$CA84 to #R$5F1D.
 $6C22 LD BC,$00BF   ;
 $6C25 LDIR          ; }
; This entry point is used by the routines at #R$82F7, #R$8498 and #R$90D2.
@label=Restart
*$6C27 DI            ; Disable interrupts.
 $6C28 LD SP,$5EFF   ; Set the stack pointer to #N$5EFF.
; Reset the border and paper colours for location #LOCATION$05 -
; "#LOCATIONNAME$05".
 $6C2B LD IX,$CC00   ; Point #REGix at the location graphics table.
 $6C2F LD A,$05      ; {Call #R$9DBD with location #LOCATION$05 -
 $6C31 CALL $9DBD    ; "#LOCATIONNAME$05".}
 $6C34 LD L,(IX+$01) ; Read the low byte of the graphics address for
                     ; #LOCATION($05) (#R$E142).
 $6C37 LD H,(IX+$02) ; Read the high byte of the graphics address for
                     ; #LOCATION($05) (#R$E142).
 $6C3A LD (HL),$00   ; {Write #N$00 over the border and colour of Trolls
 $6C3C INC HL        ; Clearing, #R$E142 and the next byte.
 $6C3D LD (HL),$00   ; }
; Copy "clean" data to the game tables ready for a new game.
 $6C3F LD HL,$F400   ; {Copies #N($0615,$04) bytes from #R$F400 to #R$C11B.
 $6C42 LD DE,$C11B   ;
 $6C45 LD BC,$0615   ;
 $6C48 LDIR          ; }
 $6C4A LD DE,$BA8A   ; {Copies #N($05D9,$04) bytes from #R$FA15 to #R$BA8A.
 $6C4D LD BC,$05D9   ;
 $6C50 LDIR          ; }
 $6C52 LD HL,$5F00   ; {Copies #N$1D bytes from #R$5F00 to #R$B6EB.
 $6C55 LD DE,$B6EB   ;
 $6C58 LD BC,$001D   ;
 $6C5B LDIR          ; }
 $6C5D LD DE,$CA84   ; {Copies #N$BF bytes from #R$5F1D back to #R$CA84.
 $6C60 LD BC,$00BF   ;
 $6C63 LDIR          ; }
 $6C65 XOR A         ; {Set the border colour to #INK$00.
 $6C66 OUT ($FE),A   ; }
 $6C68 LD A,$38      ; {Write #COLOUR$38 to #SKOOLKID$5C48(BORDCR).
 $6C6A LD ($5C48),A  ; }
@label=Restart_Keypress
*$6C6D XOR A         ; {Read from the keyboard port.
 $6C6E IN A,($FE)    ; }
 $6C70 AND %00011111 ; Keep bits 0-4, one for each key in the half-row. XOR A
                     ; then IN A,(#N$FE) reads every half-row at once, and a
                     ; pressed key reads as a reset bit.
 $6C72 CP $1F        ; {Loop back to #R$6C6D until any key has been pressed.
 $6C74 JR Z,$6C6D    ; }
 $6C76 LD A,$7F      ; {Read from the keyboard port.
 $6C78 IN A,($FE)    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit } { =h 0 | =h 1 | =h 2 |
                     ; =h 3 | =h 4 } { #N$7F | SPACE | SYMBOL SHIFT | M | N | B
                     ; } TABLE#}
 $6C7A AND %00001000 ; Keep bit 3 ("N").
 $6C7C LD ($B707),A  ; Write it to #R$B707.
 $6C7F LD HL,$50E0   ; {Write #N$50E0 to #R$85B4(the percentage buffer).
 $6C82 LD ($85B4),HL ; }
 $6C85 LD A,$2B      ; {Write #N$2B to #R$85B4(#N$85B6).
 $6C87 LD ($85B6),A  ; }
 $6C8A LD HL,$5020   ; {Write #N$5020 to #R$869C.
 $6C8D LD ($869C),HL ; }
 $6C90 LD A,$01      ; {Write #N$01 to #R$869E.
 $6C92 LD ($869E),A  ; }
 $6C95 LD A,$20      ; {Write #N$20 to #R$85B3.
 $6C97 LD ($85B3),A  ; }
 $6C9A LD A,$2A      ; {Write #N$2A to #R$869B.
 $6C9C LD ($869B),A  ; }
 $6C9F LD B,$C8      ; {Write #N$00 to #N$C8 bytes, starting from #R$B738 with
 $6CA1 LD HL,$B738   ; #R$70E2.
 $6CA4 CALL $70E2    ; }
 $6CA7 LD A,R        ; {Store the refresh register in the random seed.
 $6CA9 LD ($B70E),A  ; }
 $6CAC XOR A         ; {Clear the space count and the character flag and the
 $6CAD LD ($869F),A  ; matcher path flag.
 $6CB0 LD ($86A0),A  ;
 $6CB3 LD ($B71A),A  ; }
 $6CB6 LD ($B700),A  ; {Clear the S-types-an-F gate and the printer-on flag.
 $6CB9 LD ($B6F2),A  ; }
 $6CBC LD A,$01      ; {Write #N$01 to #LIST { #R$B702 } { #R$B6FA } { #R$B704
 $6CBE LD ($B702),A  ; } LIST#
 $6CC1 LD ($B6FA),A  ;
 $6CC4 LD ($B704),A  ; }
 $6CC7 LD HL,$0000   ; {Write #N($0000,$04,$04) to #R$B6F7.
 $6CCA LD ($B6F7),HL ; }

; Squiggle Line
;
; This section draws the "Squiggle" line which separates the windows.
;
; .
;
; #PUSHS
; #UDGTABLE
; { #SIM(start=$6CCD,stop=$6CEC) #SCR$04,$00,$12,$20,$01(squiggle) }
; UDGTABLE#
; #POPS
@label=SquiggleLine
c$6CCD CALL $6FD3    ; Call #R$6FD3 to clear screen.
 $6CD0 LD HL,$5140   ; Point at the squiggle row on screen.
 $6CD3 LD DE,$6DCC   ; Point at the squiggle pattern.
 $6CD6 LD C,$05      ; Five rows of the squiggle are drawn.
@label=SquiggleLine_OuterLoop
*$6CD8 LD B,$10      ; {Set a counter of #N$10.
 $6CDA PUSH HL       ; }
@label=SquiggleLine_InnerLoop
*$6CDB LD A,(DE)     ; Read the next byte of the picture.
 $6CDC LD (HL),A     ; Store it at #N$5140.
 $6CDD INC HL        ; {Increase both pointers by one.
 $6CDE INC DE        ; }
 $6CDF LD A,(DE)     ; {Store the squiggle pattern in the squiggle row.
 $6CE0 LD (HL),A     ; }
 $6CE1 INC HL        ; Step #REGhl on.
 $6CE2 DEC DE        ; Step back one byte through #R$6DCC.
 $6CE3 DJNZ $6CDB    ; Decrease counter by one and loop back to #R$6CDB until
                     ; counter is zero.
 $6CE5 INC DE        ; {Step on through #R$6DCC.
 $6CE6 INC DE        ; }
 $6CE7 POP HL        ; {Move to the next screen row and repeat while squiggle
 $6CE8 INC H         ; rows remain.
 $6CE9 DEC C         ;
 $6CEA JR NZ,$6CD8   ; }
; Continue on to #R$6CEC.

; Turn: Read And Tokenise The Command
;
; Reads the player's command or replays a stored one, tokenises the
; words and hands them to the Inglish matcher.
@label=TurnReadAndTokeniseTheCommand
c$6CEC LD A,$11      ; {Write #N$11 to #R$B716.
 $6CEE LD ($B716),A  ; }
 $6CF1 LD A,($B706)  ; Read the replay path.
 $6CF4 INC A         ; Count on from the replay path.
 $6CF5 JR NZ,$6D13   ; If #REGa is not zero then jump to #R$6D13.
 $6CF7 CALL $97AD    ; Call #R$97AD to reset the turn to the player.
 $6CFA LD HL,$6FF2   ; Point at the input buffer.
@label=TurnReadAndTokeniseTheCommand_Loop
*$6CFD LD A,(HL)     ; Read the next byte of the input buffer.
; Echo this character of the stored line.
 $6CFE CALL $85B8    ; Call #R$85B8 to print one character.
 $6D01 INC HL        ; {Jump back to #R$6CFD if the front of the line is not
 $6D02 CP $0D        ; #N$0D.
 $6D04 JR NZ,$6CFD   ; }
 $6D06 LD HL,$6FF4   ; {Copies #N$05 bytes from #R$6FF4 to #R$6FF9.
 $6D09 LD DE,$6FF9   ;
 $6D0C LD BC,$0005   ;
 $6D0F LDIR          ; }
 $6D11 JR $6D22      ; Jump to #R$6D22 to clear the token buffer.
@label=TurnReadAndTokeniseTheCommand_SetTheLineReadFlag
*$6D13 LD A,$01      ; {Write #N$01 to #R$B705.
 $6D15 LD ($B705),A  ; }
 $6D18 LD A,$09      ; {Write #N$09 to #R$B716.
 $6D1A LD ($B716),A  ; }
 $6D1D CALL $6DD6    ; Call #R$6DD6 to read the input line.
 $6D20 JR Z,$6D8A    ; Jump to #R$6D8A if #R$6DD6 returned with the zero flag
                     ; set.
@label=TurnReadAndTokeniseTheCommand_ClearTheTokenBuffer
*$6D22 LD HL,$709C   ; {Write #N$00 to #N$40 bytes, starting from #R$709C with
 $6D25 LD B,$40      ; #R$70E2.
 $6D27 CALL $70E2    ; }
 $6D2A LD HL,$6FF9   ; Point at the input buffer.
 $6D2D LD IY,$709C   ; Point #REGiy at the token buffer.
@label=TurnReadAndTokeniseTheCommand_TakeTheNextWord
*$6D31 CALL $6E97    ; Call #R$6E97 to take the next word.
 $6D34 CP $D0        ; {Jump to #R$6DA2 if the byte from #R$6E97 is #N$D0.
 $6D36 JR Z,$6DA2    ; }
 $6D38 CP $90        ; {Jump to #R$6D6C if that byte is not #N$90.
 $6D3A JR NZ,$6D6C   ; }
 $6D3C LD A,B        ; {Jump to #R$6D6C if the low nibble of #REGb or any bit
 $6D3D AND $0F       ; of #REGc is set.
 $6D3F OR C          ;
 $6D40 JR NZ,$6D6C   ; }
; Test the conjunction count.
 $6D42 LD A,($B71B)  ; {Jump to #R$6D4E if *#R$B71B is not zero.
 $6D45 AND A         ;
 $6D46 JR NZ,$6D4E   ; }
 $6D48 INC A         ; Count on from the conjunction count.
 $6D49 LD ($B71B),A  ; Update *#R$B71B.
 $6D4C JR $6D6C      ; Jump to #R$6D6C to skip updating the conjunction count.
@label=TurnReadAndTokeniseTheCommand_CountConjunctions
*$6D4E DEC A         ; Step the conjunction count down by one.
 $6D4F LD ($B71B),A  ; Update *#R$B71B.
 $6D52 LD A,(IY-$02) ; Read the previous token byte from #REGiy.
 $6D55 AND $F0       ; {Jump to #R$6D6C if the high nibble of the clause byte
 $6D57 CP $B0        ; at offset -2 is #N$B0.
 $6D59 JR Z,$6D6C    ; }
 $6D5B CP $A0        ; {Jump to #R$6D6C if the high nibble of the clause byte
 $6D5D JR Z,$6D6C    ; at offset -2 is #N$A0.}
 $6D5F LD A,$B0      ; Mark this token as a full stop.
 $6D61 LD (IY+$00),A ; Store the token byte in the buffer at #REGiy.
 $6D64 XOR A         ; Take zero for the next token byte.
 $6D65 LD (IY+$01),A ; Store that zero in the token buffer at #REGiy.
 $6D68 INC IY        ; {Step to the next byte of the token buffer.
 $6D6A INC IY        ; }
@label=TurnReadAndTokeniseTheCommand_StoreTheToken
*$6D6C LD (IY+$00),B ; Store the token byte in the buffer at #REGiy.
 $6D6F LD (IY+$01),C ; Store the token's second byte in the buffer at #REGiy.
 $6D72 INC IY        ; {Jump back to #R$6D31 unless the class in #REGd is
 $6D74 INC IY        ; #N$C0.
 $6D76 LD A,D        ;
 $6D77 CP $C0        ;
 $6D79 JR NZ,$6D31   ; }
; Test the conjunction count.
 $6D7B LD A,($B71B)  ; {Jump to #R$6D8A if *#R$B71B is zero.
 $6D7E AND A         ;
 $6D7F JR Z,$6D8A    ; }
 $6D81 XOR A         ; {Clear *#R$B71B.
 $6D82 LD ($B71B),A  ; }
; Deal with the conjunction before the next line.
 $6D85 CALL $792F    ; Call #R$792F to ask "what ?" and set the action
                     ; countdown.
 $6D88 JR $6D13      ; Jump back to #R$6D13 to update the line-read flag.
@label=TurnReadAndTokeniseTheCommand_PointAtTheTokens
*$6D8A LD HL,$709C   ; {Point *#R$B6DC at #R$709C.
 $6D8D LD ($B6DC),HL ; }
; Match the tokens against the grammar.
@label=TurnReadAndTokeniseTheCommand_PrepareTheClause
*$6D90 CALL $7585    ; Call #R$7585 to prepare the clause.
 $6D93 JP NZ,$6D13   ; Jump back to #R$6D13 if #R$7585 returned with the zero
                     ; flag clear.
; Carry out the matched command.
 $6D96 CALL $7960    ; Call #R$7960 to apply A match.
; Test the line-read flag.
 $6D99 LD A,($B705)  ; {Jump to #R$6D90 if *#R$B705 is not zero.
 $6D9C AND A         ;
 $6D9D JR NZ,$6D90   ; }
 $6D9F JP $6D13      ; Jump back to #R$6D13 to update the line-read flag.
@label=TurnReadAndTokeniseTheCommand_ShowTheUnknownWord
*$6DA2 LD HL,$AD93   ; Point at the message "i do not know the word "
                     ; (#R$AD93).
 $6DA5 LD A,$01      ; {Write #N$01 to #R$B701.
 $6DA7 LD ($B701),A  ; }
 $6DAA CALL $72DD    ; Call #R$72DD to print message.
 $6DAD LD HL,($B6DA) ; Read *#R$B6DA.
@label=TurnReadAndTokeniseTheCommand_TestForEnter
*$6DB0 LD A,(HL)     ; {Jump to #R$6DC1 if the unknown word is #N$0D.
 $6DB1 CP $0D        ;
 $6DB3 JR Z,$6DC1    ; }
 $6DB5 CP $22        ; {Jump to #R$6DC1 if the unknown word is #N$22.
 $6DB7 JR Z,$6DC1    ; }
; Print the character in #REGa.
 $6DB9 CALL $858B    ; Call #R$858B to print one character.
 $6DBC INC HL        ; {Jump back to #R$6DB0 if the unknown word is not #N$20.
 $6DBD CP $20        ;
 $6DBF JR NZ,$6DB0   ; }
; Print a quote.
@label=TurnReadAndTokeniseTheCommand_PrintAQuote
*$6DC1 LD A,$22      ; {Print a quote.
 $6DC3 CALL $858B    ; }
; Print a newline.
 $6DC6 CALL $8583    ; Call #R$8583 to print a newline.
 $6DC9 JP $6D13      ; Jump back to #R$6D13 to update the line-read flag.

; Squiggle Graphics
;
; Read by #R$6CCD.
@label=Graphics_Squiggle
b$6DCC DEFB $C3,$C3,$2C,$34,$10
 $6DD1 DEFB $08,$2C,$34,$C3,$C3

; Read The Input Line
;
; Used by the routine at #R$6CEC.
; .
; Reads one line into the input buffer. Cursor keys become the compass
; letters, and a quote or full stop ends a word.
@label=ReadTheInputLine
c$6DD6 LD HL,$0BB8   ; {Store #N($0BB8,$04) in *#R$B714.
 $6DD9 LD ($B714),HL ; }
; Update the action countdown.
 $6DDC LD A,$01      ; {Write #N$01 to *#R$B701 and *#R$B6FA.
 $6DDE LD ($B701),A  ;
 $6DE1 LD ($B6FA),A  ; }
; Print the ">" prompt.
 $6DE4 LD A,$3E      ; {Print '>'.
 $6DE6 CALL $858B    ; }
; Print a space.
 $6DE9 LD A,$20      ; {Print a space.
 $6DEB CALL $858B    ; }
 $6DEE LD HL,$6FF9   ; Point at the input buffer.
 $6DF1 LD B,$80      ; Start the free-space count at #N$80.
@label=ReadTheInputLine_Loop
*$6DF3 LD C,$00      ; No characters have been rubbed out yet.
; This entry point is used by the routine at #R$6E4F.
; .
; Read the next key.
@label=ReadTheInputLine_WaitForAKey
*$6DF5 CALL $7249    ; Call #R$7249 to wait for a key.
 $6DF8 BIT 7,B       ; {Jump to #R$6E01 if bit 7 of the free-space count in
 $6DFA JR Z,$6E01    ; #REGb is clear.}
 $6DFC CP $40        ; {Jump to #R$6E7A when the character is #N$40.
 $6DFE JP Z,$6E7A    ; }
@label=ReadTheInputLine_TestTheRubOutKey
*$6E01 BIT 0,C       ; {Call #R$6E4F if bit 0 of #REGc (set once a character
 $6E03 CALL Z,$6E4F  ; has been rubbed out) is clear.}
 $6E06 LD C,$01      ; {Set the rubbed-out flag and jump to #R$6E11 unless the
 $6E08 CP $18        ; key is #N$18.
 $6E0A JR NZ,$6E11   ; }
; Rub out the whole line.
 $6E0C CALL $6E8B    ; Call #R$6E8B to rub out characters.
 $6E0F JR $6DF3      ; Jump back to #R$6DF3 to read the next character.
@label=ReadTheInputLine_TestForABackspace
*$6E11 CP $08        ; {Jump to #R$6E22 unless the key is #N$08.
 $6E13 JR NZ,$6E22   ; }
 $6E15 BIT 7,B       ; {Jump back to #R$6DF5 if bit 7 of the free-space count
 $6E17 JR NZ,$6DF5   ; in #REGb is set.}
; Print character #N$08.
 $6E19 LD A,$08      ; {Print a backspace.
 $6E1B CALL $858B    ; }
 $6E1E INC B         ; One more byte of the line is free.
 $6E1F DEC HL        ; Step back one byte through #R$6FF9.
 $6E20 JR $6DF5      ; Jump back to #R$6DF5 to read the next key.
@label=ReadTheInputLine_TestForALetter
*$6E22 CP $40        ; {Jump to #R$6E3A if the key is not below #N$40.
 $6E24 JR NC,$6E3A   ; }
 $6E26 CP $22        ; {Jump to #R$6E3A if the key is a quote.
 $6E28 JR Z,$6E3A    ; }
 $6E2A CP $20        ; {Jump to #R$6E3A if the key is a space.
 $6E2C JR Z,$6E3A    ; }
 $6E2E CP $0D        ; {Jump to #R$6E3A if the key is ENTER.
 $6E30 JR Z,$6E3A    ; }
 $6E32 CP $2E        ; {Jump to #R$6E3A if the key is a full stop.
 $6E34 JR Z,$6E3A    ; }
 $6E36 CP $2C        ; {Jump back to #R$6DF5 if the key is not a comma.
 $6E38 JR NZ,$6DF5   ; }
@label=ReadTheInputLine_RememberTheAcceptedKey
*$6E3A LD ($B704),A  ; Remember this key at #R$B704 so the next letter is
                     ; capitalised.
 $6E3D DEC B         ; {Jump to #R$6E47 if the free-space count in #REGb is
 $6E3E INC B         ; zero.
 $6E3F JR Z,$6E47    ; }
; Print the character in #REGa.
 $6E41 CALL $858B    ; Call #R$858B to print one character.
 $6E44 LD (HL),A     ; {Store it at #R$6FF9 and step on.
 $6E45 INC HL        ; }
 $6E46 DEC B         ; One fewer byte of the line is free.
@label=ReadTheInputLine_FinishWhenTheKeyIsEnter
*$6E47 CP $0D        ; {Jump back to #R$6DF5 if the key is not ENTER.
 $6E49 JP NZ,$6DF5   ; }
 $6E4C OR $01        ; Clear the zero flag so ENTER ends the line.
 $6E4E RET           ; Return.

; Input: Map A Cursor Key
;
; Used by the routine at #R$6DD6.
; .
; Turns a cursor key into the matching direction letter and plants ENTER after
; it.
@label=Input_MapACursorKey
c$6E4F CP $09        ; {Jump to #R$6E72 if the key is right.
 $6E51 JR Z,$6E72    ; }
 $6E53 CP $08        ; {Jump to #R$6E76 if the key is left.
 $6E55 JR Z,$6E76    ; }
 $6E57 CP $0A        ; {Jump to #R$6E6E if the key is down.
 $6E59 JR Z,$6E6E    ; }
 $6E5B CP $5B        ; {Return if the key is not up. The up cursor is #N$5B.
 $6E5D RET NZ        ; }
 $6E5E LD A,$4E      ; Turn the cursor key into the letter N.
@label=Input_MapACursorKey_StoreTheDirectionLetter
*$6E60 LD (HL),A     ; {Store it at #R$6FF9 and step on.
 $6E61 INC HL        ; }
; Print the character in #REGa.
 $6E62 CALL $858B    ; Call #R$858B to print one character.
 $6E65 DEC B         ; One fewer byte of the line is free.
 $6E66 LD A,$0D      ; {Set the line being typed to ENTER.
 $6E68 LD (HL),A     ; }
 $6E69 INC HL        ; Step to the next byte of the input buffer.
 $6E6A DEC B         ; One fewer byte of the line is free.
 $6E6B OR $01        ; Clear the zero flag. The direction letter is followed by
                     ; ENTER.
 $6E6D RET           ; Return.
@label=Input_MapACursorKey_TurnTheDownKeyIntoS
*$6E6E LD A,$53      ; Turn the cursor key into the letter S.
 $6E70 JR $6E60      ; Jump back to #R$6E60 to store the letter S.
@label=Input_MapACursorKey_TurnTheRightKeyIntoE
*$6E72 LD A,$45      ; Turn the cursor key into the letter E.
 $6E74 JR $6E60      ; Jump back to #R$6E60 to store the letter E.
@label=Input_MapACursorKey_TurnTheLeftKeyIntoW
*$6E76 LD A,$57      ; Turn the cursor key into the letter W.
 $6E78 JR $6E60      ; Jump back to #R$6E60 to store the letter W.
; This entry point is used by the routine at #R$6DD6.
; .
; Test the fresh-game flag.
@label=Input_MapACursorKey_ReadAnotherKeyWhenTheFlagIsSet
*$6E7A LD A,($B71A)  ; {Jump to #R$6DF5 if *#R$B71A is not zero.
 $6E7D AND A         ;
 $6E7E JP NZ,$6DF5   ; }
; Print character #N$08.
 $6E81 LD A,$08      ; {Print a backspace.
 $6E83 CALL $858B    ; }
; Print the character in #REGa.
 $6E86 CALL $858B    ; Call #R$858B to print one character.
 $6E89 XOR A         ; Return zero.
 $6E8A RET           ; Return.

; Input: Rub Out Characters
;
; Used by the routines at #R$6DD6 and #R$7249.
; .
; Prints backspaces and steps back through the input buffer until the count
; runs out.
@label=Input_RubOutCharacters
c$6E8B BIT 7,B       ; {Return if bit 7 of the free-space count in #REGb is
 $6E8D RET NZ        ; set.}
; Print character #N$08.
 $6E8E LD A,$08      ; {Print a backspace.
 $6E90 CALL $858B    ; }
 $6E93 INC B         ; One more byte of the line is free.
 $6E94 DEC HL        ; Step back one byte through #R$6FF9.
 $6E95 JR $6E8B      ; Jump back to #R$6E8B to rub out another character.

; Input: Take The Next Word
;
; Used by the routine at #R$6CEC.
; .
; Skips spaces, stores the start of the next word, and classifies it.
@label=Input_TakeTheNextWord
c$6E97 PUSH DE        ; {Jump back to #R$6E98 if the line being typed is a
@label=Input_TakeTheNextWord_SkipSpaces
*$6E98 LD A,(HL)      ; space.
 $6E99 INC HL         ;
 $6E9A CP $20         ;
 $6E9C JR Z,$6E98     ; }
 $6E9E DEC HL         ; Step back one byte through #R$6FF9.
 $6E9F LD ($B6DA),HL  ; Update *#R$B6DA.
 $6EA2 CP $0D         ; {Jump to #R$6EDE if the line being typed is ENTER.
 $6EA4 JR Z,$6EDE     ; }
 $6EA6 CALL $6F30     ; Call #R$6F30 to classify punctuation.
 $6EA9 JR Z,$6EE3     ; Jump to #R$6EE3 if #R$6F30 classified this character as
                      ; punctuation.
 $6EAB CALL $6F47     ; Call #R$6F47 to copy a dictionary word.
 $6EAE JR NZ,$6EBC    ; {Jump to #R$6EBC if #R$6F47 found no dictionary word
 $6EB0 PUSH HL        ; starting with the typed word's first letter.}
@label=Input_TakeTheNextWord_CompareTheDictionaryWord
*$6EB1 CALL $6FBA     ; Call #R$6FBA to compare the dictionary word.
 $6EB4 JR Z,$6EC0     ; Jump to #R$6EC0 if #R$6FBA found the words match.
@label=Input_TakeTheNextWord_CopyADictionaryWord
*$6EB6 CALL $6F72     ; Call #R$6F72 to copy a dictionary word.
 $6EB9 JR Z,$6EB1     ; {Jump back to #R$6EB1 while #R$6F72 finds another
 $6EBB POP HL         ; dictionary word with the same first letter.}
@label=Input_TakeTheNextWord_MarkThisTokenAsAnUnknownWord
*$6EBC LD A,$D0       ; Mark this token as an unknown word.
 $6EBE JR $6EE0       ; Jump to #R$6EE0 to finish this unknown-word token.
@label=Input_TakeTheNextWord_CompareTheWordLengths
*$6EC0 LD A,($708A)   ; Read *#R$708A.
 $6EC3 LD B,A         ; Copy the result into #REGb.
 $6EC4 LD A,($709B)   ; Read *#R$709B.
 $6EC7 CP B           ; {Jump to #R$6EEB if the length of the dictionary word
 $6EC8 JR NC,$6EEB    ; is not below the length of the typed word.}
 $6ECA CP $04         ; {Jump back to #R$6EB6 if the length of the dictionary
 $6ECC JR C,$6EB6     ; word is below #N$04.}
 $6ECE PUSH IX        ; {Call #R$6F76 to unpack the dictionary word when its
 $6ED0 CALL $6F76     ; length matches the typed word.}
 $6ED3 JR NZ,$6EE9    ; Jump to #R$6EE9 if #R$6F76 found a mismatch.
 $6ED5 CALL $6FBA     ; Call #R$6FBA to compare the dictionary word.
 $6ED8 JR NZ,$6EE9    ; Jump to #R$6EE9 if #R$6FBA found the words differ.
 $6EDA POP IX         ; {Jump back to #R$6EB6 to read the input line.
 $6EDC JR $6EB6       ; }
@label=Input_TakeTheNextWord_MarkTheEndOfTheCommand
*$6EDE LD A,$C0       ; Mark this token as the end of a command.
@label=Input_TakeTheNextWord_FinishTheUnknownWord
*$6EE0 LD BC,$0000    ; Start from a clear pointer.
@label=Input_TakeTheNextWord_ReturnTheClass
*$6EE3 POP DE         ; {Keep the low byte of the saved pointer and put the
 $6EE4 LD D,A         ; class in #REGd.}
 $6EE5 ADD A,B        ; Add the length of the typed word to the class in #REGa.
 $6EE6 LD B,A         ; Copy the result into #REGb.
 $6EE7 LD A,D         ; Restore the end-of-command class #N$C0.
 $6EE8 RET            ; Return.
@label=Input_TakeTheNextWord_PopTheSavedPointer
*$6EE9 POP IX         ; {Read *#R$B717.
@label=Input_TakeTheNextWord_LoadTheDictionaryPointer
*$6EEB LD IX,($B717)  ; }
 $6EEF PUSH IX        ; {Save the dictionary pointer and start the length at
 $6EF1 XOR A          ; zero.}
@label=Input_TakeTheNextWord_StepThroughTheDictionaryWord
*$6EF2 INC IX         ; {Step to the next dictionary byte and loop back to
 $6EF4 INC A          ; #R$6EF2 while bit 7 of that byte is clear.
 $6EF5 BIT 7,(IX-$01) ;
 $6EF9 JR Z,$6EF2     ; }
 $6EFB CP $02         ; {Jump back to #R$6EF2 if the dictionary byte count is
 $6EFD JR Z,$6EF2     ; #N$02.}
 $6EFF CP $03         ; {Jump to #R$6F09 unless the byte is #N$03.
 $6F01 JR NZ,$6F09    ; }
 $6F03 BIT 7,(IX-$02) ; {Jump back to #R$6EF2 if bit 7 of the earlier
 $6F07 JR NZ,$6EF2    ; dictionary byte is set.}
@label=Input_TakeTheNextWord_TestForAnOffset
*$6F09 BIT 6,(IX-$01) ; {Jump to #R$6F1A if bit 6 of this dictionary byte is
 $6F0D JR Z,$6F1A     ; clear.}
 $6F0F LD L,(IX+$00)  ; Read the low byte of this dictionary offset.
 $6F12 LD H,(IX+$01)  ; Read the high byte of this dictionary offset.
 $6F15 LD DE,$6000    ; {Add the dictionary base at #R$6000.
 $6F18 ADD HL,DE      ; }
 $6F19 EX (SP),HL     ; Exchange the dictionary address with the pointer saved
                      ; on the stack.
@label=Input_TakeTheNextWord_PackTheClassBits
*$6F1A POP HL         ; {Pack the top two bits of this letter into the class.
 $6F1B LD A,(HL)      ;
 $6F1C RLCA           ;
 $6F1D AND $C0        ;
 $6F1F LD B,A         ; }
 $6F20 INC HL         ; Step to the next byte of the input buffer.
 $6F21 LD A,(HL)      ; {Pack the next two bits of the following letter into
 $6F22 RRCA           ; the class.
 $6F23 AND $30        ; }
 $6F25 ADD A,B        ; Combine the two pairs of class bits.
 $6F26 DEC HL         ; Step back one byte through #R$6FF9.
 $6F27 LD DE,$A000    ; Add the #N$A000 token base onto the token pointer.
 $6F2A ADD HL,DE      ; Add the token base to #R$6FF9.
 $6F2B PUSH HL        ; {Keep the token address in #REGbc and jump to #R$6EE3
 $6F2C POP BC         ; to return the class.
 $6F2D POP HL         ;
 $6F2E JR $6EE3       ; }

; Input: Classify Punctuation
;
; Used by the routine at #R$6E97.
; .
; Turns a full stop, comma or quote into the class being matched the parser
; expects.
@label=Input_ClassifyPunctuation
c$6F30 LD B,$B0      ; {Take class #N($B0), and jump to #R$6F41 if this
 $6F32 CP $2E        ; character is a full stop.
 $6F34 JR Z,$6F41    ; }
 $6F36 LD B,$A0      ; {Take class #N($A0), and jump to #R$6F41 if this
 $6F38 CP $2C        ; character is a comma.
 $6F3A JR Z,$6F41    ; }
 $6F3C CP $22        ; {Return unless this character is a quote.
 $6F3E RET NZ        ; }
 $6F3F LD B,$90      ; A quote uses class #N$90.
@label=Input_ClassifyPunctuation_StepAlongTheInputBuffer
*$6F41 INC HL        ; Step to the next byte of the input buffer.
 $6F42 LD A,B        ; Take the punctuation class into #REGa.
 $6F43 LD BC,$0000   ; Start from a clear pointer.
 $6F46 RET           ; Return.

; Input: Copy A Dictionary Word
;
; Used by the routine at #R$6E97.
; .
; Copies one typed word into the dictionary buffer and looks it up.
@label=Input_CopyADictionaryWord
c$6F47 LD DE,$707A    ; Point #REGde at the typed word.
 $6F4A LD B,$00       ; Start the pass count at zero.
@label=Input_CopyADictionaryWord_CopyTheNextLetter
*$6F4C LD A,(HL)      ; {Jump to #R$6F59 if this character is below #N$40.
 $6F4D CP $40         ;
 $6F4F JR C,$6F59     ; }
 $6F51 AND $1F        ; {Store the low five bits of this character in the typed
 $6F53 LD (DE),A      ; word and step on.
 $6F54 INC DE         ; }
 $6F55 INC HL         ; Step to the next byte of the input buffer.
 $6F56 INC B          ; Count one more letter of the typed word.
 $6F57 JR $6F4C       ; Jump back to #R$6F4C to copy the next letter.
@label=Input_CopyADictionaryWord_CopyTheCount
*$6F59 LD A,B         ; Copy the count in #REGb into #REGa.
 $6F5A LD ($708A),A   ; Update *#R$708A.
 $6F5D PUSH HL        ; {Read *#R$707A.
 $6F5E LD HL,($707A)  ; }
 $6F61 LD H,$00       ; The dictionary offset's high byte is zero before the
                      ; index is doubled.
 $6F63 LD DE,$6000    ; {Add the token index to the pointer.
 $6F66 ADD HL,HL      ; }
 $6F67 ADD HL,DE      ; Add the token index to the typed word.
 $6F68 LD E,(HL)      ; Read the low byte of the typed word.
 $6F69 INC HL         ; Step to the next byte of the typed word.
 $6F6A LD D,(HL)      ; Read the high byte of the typed word.
 $6F6B LD IX,$6000    ; {Point #REGix at the dictionary word and restore the
 $6F6F ADD IX,DE      ; input pointer from the stack.
 $6F71 POP HL         ; }
; This entry point is used by the routine at #R$6E97.
*$6F72 LD ($B717),IX  ; Update *#R$B717.
; This entry point is used by the routine at #R$6E97.
*$6F76 LD A,(IX+$00)  ; Read the first byte of the dictionary word.
 $6F79 AND $1F        ; {Keep the first letter (bits 0-4).
 $6F7B LD B,A         ; }
 $6F7C LD A,($707A)   ; Read the typed word's first letter at #R$707A.
 $6F7F CP B           ; {Return when this dictionary word does not start with
 $6F80 RET NZ         ; the typed word's first letter.}
 $6F81 PUSH HL        ; {Point #REGhl at the buffer that receives the
 $6F82 LD HL,$708B    ; dictionary word.}
 $6F85 LD BC,$0000    ; Start from a clear pointer.
@label=Input_CopyADictionaryWord_TestTheLetter
*$6F88 LD A,(IX+$00)  ; {Jump to #R$6F92 if the low five bits of this
 $6F8B AND $1F        ; dictionary byte are zero.
 $6F8D JR Z,$6F92     ; }
 $6F8F LD (HL),A      ; {Store it in the dictionary word and step on.
 $6F90 INC HL         ; }
 $6F91 INC B          ; Count one more letter of the dictionary word.
@label=Input_CopyADictionaryWord_StepTheDictionary
*$6F92 INC IX         ; {Step to the next dictionary byte and loop back to
 $6F94 INC C          ; #R$6F88 while bit 7 of that byte is clear.
 $6F95 BIT 7,(IX-$01) ;
 $6F99 JR Z,$6F88     ; }
 $6F9B LD A,C         ; {Jump back to #R$6F88 if the letter count in #REGc is
 $6F9C CP $02         ; #N$02.
 $6F9E JR Z,$6F88     ; }
 $6FA0 CP $03         ; {Jump to #R$6FAA if the letter count is not #N$03.
 $6FA2 JR NZ,$6FAA    ; }
 $6FA4 BIT 7,(IX-$02) ; {Jump back to #R$6F88 if bit 7 of the earlier
 $6FA8 JR NZ,$6F88    ; dictionary byte is set.}
@label=Input_CopyADictionaryWord_RestoreThePointer
*$6FAA POP HL         ; {Restore the saved pointer from the stack and keep the
 $6FAB LD A,B         ; letter count.}
 $6FAC LD ($709B),A   ; Update *#R$709B.
 $6FAF BIT 6,(IX-$01) ; {Return if bit 6 of this dictionary byte is clear.
 $6FB3 RET Z          ; }
 $6FB4 INC IX         ; {Step #REGix past the two flag bytes of this dictionary
 $6FB6 INC IX         ; entry.}
 $6FB8 XOR A          ; Return zero.
 $6FB9 RET            ; Return.

; Input: Compare The Dictionary Word
;
; Used by the routine at #R$6E97.
; .
; Compares the typed word with the dictionary word of the same length.
@label=Input_CompareTheDictionaryWord
c$6FBA LD A,($708A)  ; Read *#R$708A.
 $6FBD LD B,A        ; Copy the result into #REGb.
 $6FBE LD A,($709B)  ; Read *#R$709B.
 $6FC1 CP B          ; {Jump to #R$6FC5 if the length of the dictionary word is
 $6FC2 JR NC,$6FC5   ; not below the length of the typed word.}
 $6FC4 LD B,A        ; Copy the result into #REGb.
@label=Input_CompareTheDictionaryWord_PointAtTheTypedWord
*$6FC5 LD HL,$707A   ; Point #REGhl at the typed word.
 $6FC8 LD DE,$708B   ; Point #REGde at the dictionary word.
@label=Input_CompareTheDictionaryWord_CompareTheLetters
*$6FCB LD A,(DE)     ; {Return if the dictionary word is not the typed word.
 $6FCC CP (HL)       ;
 $6FCD RET NZ        ; }
 $6FCE INC DE        ; Step to the next byte of the dictionary word.
 $6FCF INC HL        ; Step to the next byte of the typed word.
 $6FD0 DJNZ $6FCB    ; Loop back to #R$6FCB until the length of the dictionary
                     ; word runs out.
 $6FD2 RET           ; Return.

; Clear Screen
;
; Used by the routine at #R$6CCD.
; .
; Clears the picture and paints the attributes for a fresh screen.
@label=ClearScreen
c$6FD3 PUSH HL       ; {Set the border colour to #INK$07.
 $6FD4 PUSH DE       ;
 $6FD5 PUSH BC       ;
 $6FD6 LD A,$07      ;
 $6FD8 OUT ($FE),A   ; }
 $6FDA LD HL,$4000   ; {Write #N$00 to #N$1800 memory locations (clearing the
 $6FDD LD DE,$4001   ; screen buffer).
 $6FE0 LD BC,$1800   ;
 $6FE3 LD (HL),$00   ;
 $6FE5 LDIR          ; }
 $6FE7 LD BC,$0300   ; {Write #COLOUR$38 to the following #N($0300,$04) memory
 $6FEA LD (HL),$38   ; locations (the attribute buffer).
 $6FEC LDIR          ; }
 $6FEE POP BC        ; {Restore #REGbc, #REGde and #REGhl from the stack.
 $6FEF POP DE        ;
 $6FF0 POP HL        ; }
 $6FF1 RET           ; Return.

; Input Buffer
;
; Read by #R$6CEC, #R$6DD6, #R$6E97, #R$6F47 and #R$6FBA.
@label=InputBuffer
b$6FF2 DEFB $3E,$20                                                         ; Two bytes
                                                                            ; at the
                                                                            ; front of
                                                                            ; the line.
                                                                            ; #R$6CEC
                                                                            ; scans from
                                                                            ; here up to
                                                                            ; the
                                                                            ; carriage
                                                                            ; return.
 $6FF4 DEFB $4C,$4F,$4F,$4B,$0D                                             ; Five bytes
                                                                            ; copied
                                                                            ; onto the
                                                                            ; line at
                                                                            ; #R$6FF9 by
                                                                            ; #R$6D06.
 $6FF9 DEFB $20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20 ; {The line
 $7009 DEFB $20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20 ; being
 $7019 DEFB $20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20 ; typed.
 $7029 DEFB $20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20 ; #R$6DD6
 $7039 DEFB $20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20 ; reads and
 $7049 DEFB $20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20 ; writes it.
 $7059 DEFB $20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20 ;
 $7069 DEFB $20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20 ;
 $7079 DEFB $0D                                                             ; }
 $707A DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $7084 DEFB $00,$00,$00,$00,$00,$00
 $708A DEFB $00
 $708B DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $7095 DEFB $00,$00,$00,$00,$00,$00
 $709B DEFB $01
 $709C DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; {Token
 $70AC DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; buffer.
 $70BC DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; #R$6D22
 $70CC DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; clears
                                                                            ; #N$40
                                                                            ; bytes here
                                                                            ; and
                                                                            ; #R$6D2D
                                                                            ; points
                                                                            ; #REGiy at
                                                                            ; the start.
                                                                            ; }

; Stored Registers For PrintMessage
;
; Six bytes. #R$72DD saves #REGa, #REGde and #REGix here, and #R$735B puts them
; back.
@label=PrintMessage_SavedA
g$70DC DEFB $00      ; #REGa saved by #R$72DD and restored by #R$7363.
@label=PrintMessage_SavedDE
 $70DD DEFW $0000    ; #REGde saved by #R$72DD and restored by #R$735B.
 $70DF DEFB $00      ; Byte tested by #R$745C while a class token is printed.
@label=PrintMessage_SavedIX
 $70E0 DEFW $0000    ; #REGix saved by #R$72DD and restored by #R$735F.

; Blanks "n" memory locations
;
; Used by the routines at #R$6C00, #R$6CEC, #R$7574, #R$7864, #R$79A9 and
; #R$7B9E.
; .
; Fills a run of bytes with one value. The turn loop uses it to clear
; the token buffer and the workspace.
;
; B Counter
; HL Target
@label=Blanker
c$70E2 XOR A         ; Fill with zero.
@label=Blanker_Loop
*$70E3 LD (HL),A     ; {Store it and step on.
 $70E4 INC HL        ; }
 $70E5 DJNZ $70E3    ; Decrease counter by one and loop back to #R$70E3 until
                     ; counter is zero.
 $70E7 RET           ; Return.

; Index Action
;
; Used by the routines at #R$712B and #R$7AF5.
; .
; Turns an action id into the address of its #N$08-byte entry in #R$AB53.
;
; A The ID of the Action; #N$01-#N$3B
@label=IndexAction
c$70E8 LD L,A        ; {Turn the id into an address in the action table, #N$08
 $70E9 LD H,$00      ; bytes per entry.
 $70EB ADD HL,HL     ;
 $70EC ADD HL,HL     ;
 $70ED ADD HL,HL     ;
 $70EE LD DE,$AB4B   ;
 $70F1 ADD HL,DE     ; }
 $70F2 RET           ; Return.

; Clause: Pack The Action Scores
;
; Used by the routines at #R$712B, #R$7AF5 and #R$7C23.
; .
; Packs two scores from the action entry into the clause. The high nibbles of bytes 5
; and 7 are stored at #R$B71E. The high nibbles of bytes 1 and 3 are stored at #R$B71D.
@label=ClausePackTheActionScores
c$70F3 LD A,(IX+$05) ; Read byte 5 of this action entry.
 $70F6 RRCA          ; {Take the high nibble of byte 5.
 $70F7 RRCA          ;
 $70F8 RRCA          ;
 $70F9 RRCA          ;
 $70FA AND $0F       ;
 $70FC LD C,A        ; }
 $70FD LD A,(IX+$07) ; Read byte 7 of this action entry.
 $7100 AND $F0       ; {Add byte 5's high nibble, now the low nibble, onto the
 $7102 ADD A,C       ; high nibble of byte 7.}
 $7103 LD ($B71E),A  ; Update *#R$B71E.
 $7106 LD A,(IX+$01) ; Read byte 1 of this action entry.
 $7109 RRCA          ; {Take the high nibble of byte 1.
 $710A RRCA          ;
 $710B RRCA          ;
 $710C RRCA          ;
 $710D AND $0F       ;
 $710F LD C,A        ; }
 $7110 LD A,(IX+$03) ; Read byte 3 of this action entry.
 $7113 AND $F0       ; {Add the high nibble of byte 1 onto the high nibble of
 $7115 ADD A,C       ; byte 3.}
 $7116 LD ($B71D),A  ; Update *#R$B71D.
 $7119 RET           ; Return.

; Inglish: Arm The Message Gate
;
; Used by the routine at #R$7D74.
; .
; Clears the message-suppressed flag, sets the message gate, and describes the action when the
; command had no conjunction. Returns zero.
@label=Inglish_ArmTheMessageGate
c$711A XOR A         ; {Clear the message-suppressed flag.
 $711B LD ($B6FB),A  ; }
 $711E INC A         ; {Set the message gate, so #R$72DD skips its setup.
 $711F LD ($B6FA),A  ; }
 $7122 LD A,($B71B)  ; {Describe the action when the conjunction count is zero.
 $7125 AND A         ;
 $7126 CALL Z,$712B  ; }
 $7129 XOR A         ; Clear #REGa.
 $712A RET           ; Return.

; Inglish: Describe The Action
;
; Used by the routines at #R$711A, #R$7960, #R$99C6 and #R$9F76.
; .
; Prints the sentence for the current action: who, the verb, and the objects. Bit 4 of the
; packed token classes (#R$B71D) suppresses the whole sentence. What the other bits select is only
; partly confirmed.
;
; .
;
; Decide whether a sentence is due, and which noun it names.
@label=Inglish_DescribeTheAction
c$712B LD A,$01      ; {Mark a class token as due.
 $712D LD ($70DF),A  ; }
 $7130 XOR A         ; {Clear which noun is being named.
 $7131 LD ($B703),A  ; }
 $7134 PUSH IY       ; {The action countdown is #N$01 when the
 $7136 PUSH BC       ; message-suppressed flag is clear, and #N$00 when a
 $7137 LD A,($B6FB)  ; message was held back.
 $713A LD B,A        ;
 $713B AND A         ;
 $713C LD A,$01      ;
 $713E JR Z,$7141    ; }
 $7140 XOR A         ; Clear the countdown when the message-suppressed flag was
                     ; set.
@label=Inglish_DescribeTheAction_Store
*$7141 LD ($B701),A  ; Store the action countdown.
 $7144 PUSH IX       ; {Look up the record for the current action.
 $7146 PUSH HL       ;
 $7147 PUSH DE       ;
 $7148 LD A,($B6E7)  ;
 $714B CALL $70E8    ; }
 $714E PUSH HL       ; {Use that action record from here on.
 $714F POP IX        ; }
 $7151 XOR A         ; {Jump to #R$715C to skip the newline if the
 $7152 CP B          ; message-suppressed flag was zero.
 $7153 JR Z,$715C    ; }
 $7155 LD A,($B6EA)  ; {Print a newline if it is the player's turn.
 $7158 AND A         ;
 $7159 CALL Z,$8583  ; }
@label=Inglish_DescribeTheAction_Pack
*$715C CALL $70F3    ; Call #R$70F3 to pack this action entry's token classes
                     ; into the clause.
 $715F BIT 4,A       ; {Jump to #R$71C9 if bit 4 of the packed token classes
 $7161 LD C,A        ; (#R$B71D) is set. That bit suppresses the sentence.
 $7162 JP NZ,$71C9   ; }
@label=Inglish_DescribeTheAction_Who
 $7165 CALL $73A7    ; Print the current character.
 $7168 LD DE,$00EE   ; {Print the token #TOKEN($00EE) when the
 $716B XOR A         ; message-suppressed flag is zero.
 $716C CP B          ;
 $716D CALL Z,$74C1  ; }
 $7170 PUSH HL       ; {Keep the pointer those prints returned, and step #N$06
 $7171 LD DE,$0006   ; bytes, the length of an object name.
 $7174 ADD HL,DE     ; }
 $7175 CALL $74BA    ; Print the action's name.
 $7178 CALL $95ED    ; Test whether the location is lit.
 $717B POP HL        ; {Jump to #R$718F if the location is lit.
 $717C JR NC,$718F   ; }
 $717E LD A,($B6E7)  ; {Jump to #R$718F if the action is strike (#N$0B) or
 $7181 CP $0B        ; later.
 $7183 JR NC,$718F   ; }
 $7185 LD DE,$0AEA   ; Take the token #TOKEN($0AEA).
 $7188 INC HL        ; {Step two bytes to the next word token.
 $7189 INC HL        ; }
 $718A CALL $74C1    ; Print that token.
 $718D JR $7192      ; Jump to #R$7192, skipping a second copy of the action
                     ; name.
@label=Inglish_DescribeTheAction_Verb
*$718F CALL $74BA    ; Print the action's name.
@label=Inglish_DescribeTheAction_Object
*$7192 BIT 3,C       ; {Jump to #R$71A6 if bit 3 of the scores #R$70F3 left in
 $7194 JR Z,$71A6    ; #REGc is clear.}
 $7196 BIT 5,C       ; {Print the action's name again if bit 5 of the packed
 $7198 CALL NZ,$74BA ; scores is set.}
 $719B LD A,($B71E)  ; {Print the action's name again if bit 7 of the clause
 $719E BIT 7,A       ; byte is set.
 $71A0 CALL NZ,$74BA ; }
 $71A3 CALL $73B4    ; Print the current object.
@label=Inglish_DescribeTheAction_Second
*$71A6 LD A,($B6E9)  ; {Jump to #R$71C1 if there is no second object.
 $71A9 CP $FF        ;
 $71AB JR Z,$71C1    ; }
 $71AD BIT 2,C       ; {Jump to #R$71C1 if bit 2 of the packed token classes
 $71AF JR Z,$71C1    ; (#R$B71D) is clear.}
 $71B1 BIT 5,C       ; {Print the action's name if bit 5 of the packed scores
 $71B3 CALL Z,$74BA  ; is clear.}
 $71B6 LD A,($B71E)  ; {Print the action's name if bit 7 of the clause byte is
 $71B9 BIT 7,A       ; clear.
 $71BB CALL Z,$74BA  ; }
 $71BE CALL $73C7    ; Print the second noun.
@label=Inglish_DescribeTheAction_Stop
*$71C1 LD A,$2E      ; {Print a full stop.
 $71C3 CALL $858B    ; }
 $71C6 CALL $8583    ; Print a newline.
@label=Inglish_DescribeTheAction_Done
*$71C9 XOR A         ; {Clear the class-token flag.
 $71CA LD ($70DF),A  ; }
 $71CD POP DE        ; {Restore #REGde, #REGhl, #REGix, #REGbc and #REGiy from
 $71CE POP HL        ; the stack.
 $71CF POP IX        ;
 $71D1 POP BC        ;
 $71D2 POP IY        ; }
 $71D4 RET           ; Return.

; Table: Address Past The Location
;
; Used by the routines at #R$73C2 and #R$7B63.
; .
; Finds the location record and returns the address of its name. The name token
; starts two bytes in.
@label=Table_AddressPastTheLocation
c$71D5 PUSH IX       ; {Find the location record.
 $71D7 CALL $9BB1    ; }
 $71DA PUSH IX       ; {Take that record's address.
 $71DC POP HL        ; }
 $71DD INC HL        ; {Step to the location's name, two bytes into the record.
 $71DE INC HL        ; }
 $71DF POP IX        ; Restore #REGix from the stack.
 $71E1 RET           ; Return.

; Table: Address The Object Name
;
; Used by the routines at #R$73D6, #R$7B63 and #R$7D74.
; .
; Finds the object record and returns the address of its name, eight bytes in.
@label=Table_AddressTheObjectName
c$71E2 PUSH DE       ; {Find the object's record.
 $71E3 PUSH IX       ;
 $71E5 CALL $9BCA    ; }
 $71E8 PUSH IX       ; {Take that record's address.
 $71EA POP HL        ; }
 $71EB LD DE,$0008   ; {Step #N$08 bytes to the object's name.
 $71EE ADD HL,DE     ; }
 $71EF POP IX        ; {Restore #REGix and #REGde from the stack.
 $71F1 POP DE        ; }
 $71F2 RET           ; Return.

; Inglish: Match Clause Pairs
;
; Used by the routines at #R$7B9E, #R$9DD9 and #R$9EA0.
; .
; Tries several pairs of clause bytes. One pattern returns #N$01 and another returns
; #N$00. Which dictionary words those pairs stand for is unconfirmed.
@label=Inglish_MatchClausePairs
c$71F3 PUSH DE       ; {Compare the first pair.
 $71F4 PUSH HL       ;
 $71F5 PUSH IY       ;
 $71F7 CALL $722E    ; }
 $71FA JR NZ,$7229   ; Jump to #R$7229 if that pair did not match.
 $71FC LD A,$01      ; {Mark the low byte of the class being matched.
 $71FE LD ($B6DF),A  ; }
 $7201 CALL $722E    ; Compare the next pair.
 $7204 JR NZ,$720D   ; Jump to #R$720D if that pair did not match.
 $7206 CALL $722E    ; Compare a third pair.
 $7209 LD A,$00      ; {Jump to #R$7229 with zero when the third pair matches.
 $720B JR Z,$7229    ; }
@label=Inglish_MatchClausePairs_Shift
*$720D POP IY        ; {Move the parser pointer on #N$04 bytes.
 $720F POP HL        ;
 $7210 PUSH HL       ;
 $7211 PUSH IY       ;
 $7213 LD DE,$0004   ;
 $7216 ADD IY,DE     ; }
 $7218 INC HL        ; {Move the text pointer on two bytes.
 $7219 INC HL        ; }
 $721A CALL $722E    ; Compare the shifted pair.
 $721D JR NZ,$7229   ; Jump to #R$7229 if that pair did not match.
 $721F LD DE,$FFFC   ; {Move the parser pointer back #N$04 bytes.
 $7222 ADD IY,DE     ; }
 $7224 CALL $722E    ; Compare the pair at the restored window.
 $7227 LD A,$01      ; Return #N$01 for this pattern.
@label=Inglish_MatchClausePairs_Done
*$7229 POP IY        ; {Restore #REGiy, #REGhl and #REGde from the stack.
 $722B POP HL        ;
 $722C POP DE        ; }
 $722D RET           ; Return.

; Inglish: Compare One Clause Pair
;
; Used by the routine at #R$71F3.
; .
; Compares one pair of clause bytes with the pair the caller addressed. An empty pair
; matches. Otherwise the low nibbles of the second bytes must agree and the first bytes must be
; equal. Both pointers then move on by two.
@label=Inglish_CompareOneClausePair
c$722E PUSH HL       ; {Jump to #R$7241 if this pair is empty.
 $722F LD A,(HL)     ;
 $7230 INC HL        ;
 $7231 OR (HL)       ;
 $7232 JR Z,$7241    ; }
 $7234 LD A,(IY+$01) ; Read the second byte of the pair being tested.
 $7237 XOR (HL)      ; {Jump to #R$7241 if its low nibble differs from the
 $7238 AND $0F       ; clause byte.
 $723A JR NZ,$7241   ; }
 $723C DEC HL        ; Step back to the first byte of the pair.
 $723D LD A,(HL)     ; Read that first byte.
 $723E CP (IY+$00)   ; Compare it with the first byte of the pair being tested.
@label=Inglish_CompareOneClausePair_Advance
*$7241 POP HL        ; {Move on to the next pair in the text.
 $7242 INC HL        ;
 $7243 INC HL        ; }
 $7244 INC IY        ; {Move on to the next pair being tested.
 $7246 INC IY        ; }
 $7248 RET           ; Return.

; Input: Wait For A Key
;
; Used by the routine at #R$6DD6.
; .
; Counts down the input delay while polling the keyboard. A key raises the next delay by
; #N($01F4), up to #N($0BB8), and is returned. If the delay runs out, #R$7291 is printed into the
; buffer, ENTER is returned, and the next delay is cleared.
@label=Input_WaitForAKey
c$7249 PUSH HL       ; {Read the input delay.
 $724A LD HL,($B714) ; }
@label=Input_WaitForAKey_Poll
*$724D CALL $8B93    ; Poll the keyboard.
 $7250 AND A         ; {Jump to #R$7273 if a key is waiting.
 $7251 JR NZ,$7273   ; }
 $7253 DEC HL        ; {Loop back to #R$724D to keep polling until the delay
 $7254 LD A,H        ; runs out.
 $7255 OR L          ;
 $7256 JR NZ,$724D   ; }
 $7258 POP HL        ; {Rub out the characters typed so far.
 $7259 PUSH HL       ;
 $725A CALL $6E8B    ; }
 $725D LD DE,$7291   ; Point at the letters W, A, I, T.
 $7260 LD B,$04      ; Four letters.
@label=Input_WaitForAKey_Wait
*$7262 LD A,(DE)     ; {Store the next letter of #R$7291 in the input buffer.
 $7263 LD (HL),A     ;
 $7264 INC HL        ;
 $7265 INC DE        ; }
 $7266 CALL $858B    ; Print that letter.
 $7269 DJNZ $7262    ; Loop back to #R$7262 until #R$7291 is done.
 $726B EX (SP),HL    ; {Remember the pointer after #R$7291, and prepare ENTER.
 $726C LD B,$7C      ; The next delay is #N$FE0C plus #N($01F4), which is zero.
 $726E LD A,$0D      ;
 $7270 LD HL,$FE0C   ; }
@label=Input_WaitForAKey_AddToTheDelay
*$7273 PUSH AF       ; {Add #N($01F4,$04) to the delay. A key raises the
 $7274 XOR A         ; current delay; the timeout path adds it to zero.
 $7275 LD DE,$01F4   ;
 $7278 ADC HL,DE     ; }
 $727A LD DE,$0BB8   ; The cap is #N($0BB8,$04).
 $727D JR C,$7284    ; Jump to #R$7284 if the sum overflowed, and use the cap.
 $727F CALL $728B    ; Call #R$728B to compare the delay with the cap.
 $7282 JR C,$7285    ; Jump to #R$7285 if the delay is still under the cap.
@label=Input_WaitForAKey_Cap
*$7284 EX DE,HL      ; Use the cap instead.
@label=Input_WaitForAKey_Store
*$7285 LD ($B714),HL ; Store the next input delay.
 $7288 POP AF        ; {Restore #REGaf and #REGhl from the stack.
 $7289 POP HL        ; }
 $728A RET           ; Return.

; Input: Compare Two Totals
;
; Used by the routine at #R$7249.
; .
; Compares two 16-bit totals. Carry is set when the first is below the second. The input
; delay uses it to cap the next wait at #N($0BB8,$04).
@label=Input_CompareTwoTotals
c$728B LD A,H        ; {Return at once when the high bytes differ. Carry is set
 $728C SUB D         ; when the first total is below.
 $728D RET NZ        ; }
 $728E LD A,L        ; {Compare the low bytes.
 $728F SUB E         ; }
 $7290 RET           ; Return.

; Print Table
;
; Read by #R$7249 and #R$72DD.
b$7291 DEFB $57,$41,$49,$54 ; The letters W, A, I, T. #R$7249 types them when
                            ; the input delay runs out.
@label=PrintTable
 $7295 DEFW $7367
 $7297 DEFW $7376
 $7299 DEFW $737E
 $729B DEFW $738D
 $729D DEFW $7394
 $729F DEFW $738B
 $72A1 DEFW $73A3
 $72A3 DEFW $73AF
 $72A5 DEFW $73BD
 $72A7 DEFW $73C2
 $72A9 DEFW $738B
 $72AB DEFW $73E0
 $72AD DEFW $73F9
 $72AF DEFW $72C3
 $72B1 DEFW $7407
 $72B3 DEFW $738B
 $72B5 DEFW $740C
 $72B7 DEFW $7425
 $72B9 DEFW $738B
 $72BB DEFW $742D
 $72BD DEFW $7340
 $72BF DEFW $7344
 $72C1 DEFW $735B

; Message: Print One Character
;
; Used by the routine at #R$72DD.
; .
; Prints one character, after the message gate and the day/night
; filter.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=MessagePrintOneCharacter
c$72C3 CALL $858B    ; Call #R$858B to print one character.
 $72C6 CP $0D        ; {Return unless the character just printed was #N$0D.
 $72C8 RET NZ        ; }
 $72C9 XOR A         ; {Clear the capitalise-the-next-letter flag at #R$B704.
 $72CA LD ($B704),A  ; }
 $72CD RET           ; Return.

; Response: "I Cannot Do That"
;
; Used by the routines at #R$9213, #R$93DA, #R$950F and #R$A302.
; .
; Prints "I cannot do that" and returns to the command loop.
@label=Response_ICannotDoThat
c$72CE LD HL,$AFBF   ; Point at the message "i cannot do that" (#R$AFBF).
 $72D1 JR $72DD      ; Jump to #R$72DD to print "i cannot do that".

; Message: Open The Gate For A Conjunction
;
; Used by the routines at #R$7B9E and #R$7D74.
; .
; Opens the message gate when the command contained a conjunction, so
; the next sentence is printed.
;
; .
;
; Test the conjunction count.
@label=MessageOpenTheGateForAConjunction
c$72D3 LD A,($B71B)  ; {Jump to #R$72DD if *#R$B71B is zero.
 $72D6 AND A         ;
 $72D7 JR Z,$72DD    ; }
 $72D9 XOR A         ; {Clear *#R$B6FA.
 $72DA LD ($B6FA),A  ; }

; Print Message
;
; Used by the routines at #R$6CEC, #R$72CE, #R$72D3, #R$7924, #R$83A0, #R$83F5,
; #R$8498, #R$84CC, #R$855A, #R$8C4B, #R$8C9B, #R$8CA6, #R$8CF1, #R$8D33,
; #R$8D9D, #R$8EEC, #R$8FD6, #R$9034, #R$9076, #R$90D2, #R$90EB, #R$9171,
; #R$9213, #R$92B5, #R$939E, #R$93DA, #R$950F, #R$965B, #R$9686, #R$9728,
; #R$97F4, #R$97FF, #R$9ACD, #R$9D50, #R$9F94, #R$9FAF, #R$A050, #R$A09D,
; #R$A0C8, #R$A138, #R$A16C, #R$A1E3, #R$A248, #R$A2B4, #R$A302, #R$A3BC,
; #R$A448, #R$A55F, #R$A5FB, #R$A7AA, #R$A86E, #R$A971, #R$A9D6, #R$A9E5,
; #R$AA74, #R$AA91, #R$AAC7, #R$AB10, #R$AB1F, #R$AB3A and #R$C7EA.
; .
; Prints a message. Bytes under #N$20 are control codes from the table
; at #R$7295. Dictionary tokens are expanded in line.
;
; HL Text message address
;
; Store #REGa, #REGde and #REGix for later (see #R$735B).
@label=PrintMessage
c$72DD LD ($70DD),DE ; Store #REGde at #R$70DD.
 $72E1 LD ($70E0),IX ; Store #REGix at #R$70E0.
 $72E5 LD ($70DC),A  ; Save #REGa for #R$735B.
 $72E8 LD A,($B6FA)  ; {If #R$B6FA is not zero, jump to #R$72F1
 $72EB AND A         ;
 $72EC JR NZ,$72F1   ; }
 $72EE LD ($B6FB),A  ; Clear the message-suppressed flag, because this message
                     ; is being printed.
; This entry point is used by the routine at #R$73E0.
@label=PrintMessage_Body
*$72F1 PUSH HL       ; {Use the text pointer as the message pointer.
 $72F2 POP IX        ; }
@label=PrintMessage_Loop
*$72F4 LD A,(IX+$00) ; Fetch the next character of the text message.
 $72F7 BIT 7,A       ; {Jump to #R$7318 if bit 7 of the character is clear, so
 $72F9 JR Z,$7318    ; it is plain text rather than a dictionary token.}
 $72FB AND $7F       ; {Jump to #R$7348 if the high nibble of this token byte,
 $72FD LD D,A        ; with bit 7 clear, is #N$30.
 $72FE LD E,(IX+$01) ;
 $7301 INC IX        ;
 $7303 AND $F0       ;
 $7305 CP $30        ;
 $7307 JR Z,$7348    ; }
 $7309 CP $20        ; {Jump to #R$7348 if the high nibble of this token byte
 $730B JR Z,$7348    ; is #N$20.}
 $730D CP $60        ; {Jump to #R$7348 if the high nibble of this token byte
 $730F JR Z,$7348    ; is #N$60.}
; This entry point is used by the routine at #R$7493.
@label=PrintMessage_Token
*$7311 CALL $74C1    ; Call #R$74C1 to print a dictionary token.
@label=PrintMessage_StepToTheNextCharacter
*$7314 INC IX        ; Step to the next character of the message.
 $7316 JR $72F4      ; Jump back to #R$72F4.
@label=PrintMessage_PlainText
*$7318 CP $20        ; {If the character is less than #N$20 jump to #R$7326.
 $731A JR C,$7326    ; }
 $731C CP $60        ; {Jump to #R$7493 if the character is #N$60 or above, as
 $731E JP NC,$7493   ; that is a common word.}
 $7321 CALL $72C3    ; Else, call #R$72C3.
 $7324 JR $7314      ; Jump back to #R$7314 to move onto the next character.
@label=PrintMessage_PrintTable
*$7326 PUSH DE       ; {Save #REGde and keep #REGa in #REGe.
 $7327 LD E,A        ; }
 $7328 LD D,$00      ; The control-code offset's high byte is zero.
 $732A LD HL,$7295   ; {Point #REGhl at entry #REGde of #R$7295.
 $732D ADD HL,DE     ; }
 $732E ADD HL,DE     ; Add the control code again, so this selects the handler
                     ; word in #R$7295.
 $732F LD E,(HL)     ; Read the low byte of the handler.
 $7330 INC HL        ; Step to the high byte of the handler word.
 $7331 LD D,(HL)     ; Read the high byte of the handler.
 $7332 EX DE,HL      ; Point #REGhl at the control-code handler.
 $7333 POP DE        ; {Restore #REGde from the stack, and jump to #R$733F if
 $7334 CP $14        ; the character is not below #N$14.
 $7336 JR NC,$733F   ; }
 $7338 CALL $733F    ; Call #R$733F to run the control-code handler.
 $733B JR Z,$7314    ; Jump back to #R$7314 if the control-code handler
                     ; returned zero.
 $733D JR $7311      ; Jump back to #R$7311 to print a dictionary token.

; Message: Dispatch The Control Code
;
; Used by the routine at #R$72DD.
; .
; Jumps to the control-code handler the message printer looked up.
@label=PrintMessage_Indirect_Jump
c$733F JP (HL)       ; Jump to the address the message left behind.

; Message: Print A Stop
;
; Prints a full stop and a newline, as the token class asks (bit 6 skips the stop, bit 4 prints it).
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=MessagePrintAStop
c$7340 LD D,$60      ; Class #N$60 skips the stop and prints a newline.
 $7342 JR $734B      ; Jump to #R$734B to print a newline without the stop.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
 $7344 LD D,$30      ; Class #N$30 prints a stop and a newline.
 $7346 JR $734B      ; Jump to #R$734B to print the stop and a newline.

; Message: Print The Token And Stop
;
; Used by the routine at #R$72DD.
; .
; Prints the token already addressed, then a full stop, and a newline when the token class
; asks for one.
@label=PrintMessage_TokenByNibble
c$7348 CALL $74C1    ; Call #R$74C1 to print a dictionary token.
; This entry point is used by the routine at #R$7340.
@label=PrintMessage_TokenByNibble_FullStop
*$734B LD A,$2E      ; {Take the full stop, and jump to #R$7358 if bit 6 of the
 $734D BIT 6,D       ; class in #REGd is set.
 $734F JR NZ,$7358   ; }
 $7351 BIT 4,D       ; {Call #R$858B to print it if bit 4 of the class in #REGd
 $7353 CALL NZ,$858B ; is set.}
 $7356 BIT 4,D       ; Test bit 4 of the class in #REGd.
@label=PrintMessage_TokenByNibble_TestCarriageReturn
*$7358 CALL NZ,$8583 ; Call #R$8583 to print a newline if bit 6 or bit 4 of the
                     ; class in #REGd is set.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=PrintMessage_TokenByNibble_Return
 $735B LD DE,($70DD) ; Bring #REGde back from #R$70DD.
 $735F LD IX,($70E0) ; Bring #REGix back from #R$70E0.
 $7363 LD A,($70DC)  ; Bring back the #REGa saved at #R$70DC.
 $7366 RET           ; Return.

; Message: Code #N($00), The Stacked Object
;
; Message code #N$00. Pops the object-record pointer the caller pushed.
; When that pointer is not zero, #R$7434 names the object.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=Message_NameTheStackedObject
c$7367 XOR A         ; {Clear *#R$B703.
 $7368 LD ($B703),A  ; }
 $736B POP DE        ; {Drop the dispatcher return and restore the caller's
 $736C POP HL        ; object pointer from the stack into #REGhl.
 $736D EX (SP),HL    ; }
 $736E PUSH DE       ; {Put the dispatcher return back, and call #R$7434 if the
 $736F LD A,H        ; object pointer is not zero.
 $7370 OR L          ;
 $7371 CALL NZ,$7434 ; }
 $7374 XOR A         ; Finish this control code with zero.
 $7375 RET           ; Return.

; Message: Code #N($01), The Stacked Token
;
; Message code #N$01. Takes the token the caller pushed into #REGde and
; returns with the zero flag clear, so #R$733D prints that token.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=Message_PrintTheStackedToken
c$7376 POP DE        ; {Drop the dispatcher return and restore the caller's
 $7377 POP HL        ; token from the stack into #REGhl.
 $7378 EX (SP),HL    ; }
 $7379 PUSH DE       ; {Put the dispatcher return back and move the token into
 $737A EX DE,HL      ; #REGde.}
 $737B OR $01        ; Clear the zero flag so the token is printed.
 $737D RET           ; Return.

; Message: Code #N($02), Step By A Signed Byte
;
; Message code #N$02. Steps the message pointer by a signed byte.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=Message_StepByASignedByte
c$737E LD E,(IX+$01) ; {Jump to #R$7389 if bit 7 of the message byte at offset
 $7381 LD D,$00      ; 1 is clear.
 $7383 BIT 7,E       ;
 $7385 JR Z,$7389    ; }
 $7387 LD D,$FF      ; The offset is negative, so the high byte is #N$FF.
@label=Message_StepByASignedByte_ApplyTheOffset
*$7389 ADD IX,DE     ; Step the message pointer by the signed byte.
; Codes #N($05), #N($0A), #N$0F and #N$12 come straight here through the
; control-code table at #R$7295 and do nothing.
@label=Message_StepByASignedByte_FinishOrIgnoreTheCode
 $738B XOR A         ; Finish this control code with zero.
 $738C RET           ; Return.

; Message: Code #N($03), The Saved Token
;
; Message code #N$03. Returns the token at #R$B6FC, the weapon name, with the zero flag clear so #R$733D prints it.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=Message_PrintTheSavedToken
c$738D LD DE,($B6FC) ; Read the saved token at #R$B6FC.
 $7391 OR $01        ; Clear the zero flag so the saved token is printed.
 $7393 RET           ; Return.

; Message: Code #N($04), The Stacked Class Token
;
; Message code #N$04. Prints the token the caller pushed as a class token.
; #R$B703 is set to #N$01 and #R$7478 prints it.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=Message_PrintTheStackedClassToken
c$7394 POP DE        ; {Drop the dispatcher return and restore the caller's
 $7395 POP HL        ; token from the stack into #REGhl.
 $7396 EX (SP),HL    ; }
 $7397 PUSH DE       ; {Put the dispatcher return back and move the token into
 $7398 EX DE,HL      ; #REGde.}
 $7399 LD A,$01      ; {Write #N$01 to *#R$B703 so the token is read as a class
 $739B LD ($B703),A  ; token.}
 $739E CALL $7478    ; Call #R$7478 to print the class token for this noun.
 $73A1 XOR A         ; Finish this control code with zero.
 $73A2 RET           ; Return.

; Message: Code #N($06), Print The Current Character
;
; Message code #N$06. Prints the name of the character whose turn it is.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=Message_PrintWhoseTurn
c$73A3 XOR A         ; {Write #N$00 to #R$B703.
 $73A4 LD ($B703),A  ; }
; This entry point is used by the routine at #R$712B.
*$73A7 LD A,($B6EA)  ; Read the character whose turn it is.
 $73AA CALL $7488    ; Call #R$7488 to print the fallback token.
 $73AD XOR A         ; Finish this control code with zero.
 $73AE RET           ; Return.

; Message: Code #N($07), Print The Current Object
;
; Message code #N$07. Prints the name of the current object.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=Message_PrintTheObject
c$73AF LD A,$01      ; {Write #N$01 to *#R$B703.
 $73B1 LD ($B703),A  ; }
; This entry point is used by the routine at #R$712B.
*$73B4 LD A,($B6FE)  ; Read *#R$B6FE.
 $73B7 AND A         ; See whether the noun-print flag is zero.
 $73B8 LD A,($B6E8)  ; Read the current object.
 $73BB JR $73CE      ; Jump to #R$73CE to skip updating which noun is being
                     ; named.

; Message: Code #N($08), Print A Backspace
;
; Message code #N$08. Prints a backspace. The dispatcher leaves #N$08 in #REGa, and nothing else jumps here.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
;
; .
;
; Print a backspace.
@label=Message_PrintABackspace
c$73BD CALL $858B    ; Call #R$858B to print the backspace already in #REGa.
 $73C0 XOR A         ; Finish this control code with zero.
 $73C1 RET           ; Return.

; Message: Code #N($09), Print The Second Noun
;
; Message code #N$09. Prints the second noun of the command.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=Message_PrintTheSecondNoun
c$73C2 LD A,$01      ; {Write #N$01 to *#R$B703.
 $73C4 LD ($B703),A  ; }
; This entry point is used by the routine at #R$712B.
*$73C7 LD A,($B6FF)  ; Read *#R$B6FF.
 $73CA AND A         ; See whether the second-noun flag is zero.
 $73CB LD A,($B6E9)  ; Read the second object.
; This entry point is used by the routine at #R$73AF.
*$73CE JR Z,$73D6    ; Jump to #R$73D6 if the second-noun flag is zero.
 $73D0 PUSH HL       ; {Call #R$71D5 to find the address of the location's
 $73D1 CALL $71D5    ; name.}
 $73D4 JR $73DA      ; Jump to #R$73DA to print the noun.

; Message: Name By The Indirect Pointer
;
; Used by the routines at #R$73C2 and #R$7488.
; .
; Prints the current object's name. It finds the object record and hands the saved name to
; the printer, then returns with the text pointer restored.
; The message code #N$09 handler at #R$73C2 jumps here, and #R$7488 loops back here.
@label=Message_NameByTheIndirectPointer
c$73D6 PUSH HL       ; {Call #R$71E2 to find the address of the object's name.
 $73D7 CALL $71E2    ; }
; This entry point is used by the routine at #R$73C2.
@label=Message_NameByTheIndirectPointer_Print
*$73DA CALL $7434    ; Call #R$7434 to print the noun held for this name.
 $73DD POP HL        ; {Finish this control code with zero.
 $73DE XOR A         ; }
 $73DF RET           ; Return.

; Message: Code #N($0B), Print Text At A Signed Offset
;
; Message code #N$0B. Prints text at a signed offset from the message
; pointer.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=Message_PrintAtASignedOffset
c$73E0 INC IX        ; Step to the next character of the message.
 $73E2 PUSH IX       ; {Copy the text pointer, leaving it on the stack.
 $73E4 POP HL        ;
 $73E5 PUSH HL       ; }
 $73E6 LD E,(IX+$00) ; {Jump to #R$73F1 if bit 7 of the next character of the
 $73E9 LD D,$00      ; message is clear.
 $73EB BIT 7,E       ;
 $73ED JR Z,$73F1    ; }
 $73EF LD D,$FF      ; Sign-extend the stacked offset, so #N$FF subtracts it.
@label=Message_PrintAtASignedOffset_AddTheOffset
*$73F1 ADD HL,DE     ; Add the signed offset to the text pointer.
 $73F2 CALL $72F1    ; Call #R$72F1 to print message.
 $73F5 POP IX        ; {Finish this control code with zero.
 $73F7 XOR A         ; }
 $73F8 RET           ; Return.

; Message: Code #N($0C), Pronoun
;
; Message code #N$0C. Prints the pronoun for the character being talked
; about.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=Message_PrintThePronoun
c$73F9 LD A,($B6EA)  ; Read *#R$B6EA.
; This entry point is used by the routine at #R$7407.
*$73FC LD DE,$0990   ; {Return the token #TOKEN($0990) if it is not the
 $73FF AND A         ; player's turn.
 $7400 RET NZ        ; }
 $7401 LD DE,$0BEA   ; Use the token #TOKEN($0BEA).
 $7404 OR $01        ; Clear the zero flag.
 $7406 RET           ; Return.

; Message: Code #N($0E), Object Pronoun
;
; Message code #N$0E. Prints the pronoun for the current object.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=Message_PrintTheObjectPronoun
c$7407 LD A,($B6E8)  ; Read the current object.
 $740A JR $73FC      ; Jump back to #R$73FC to choose the pronoun token for
                     ; this object.

; Message: Code #N($10), Is Or Are
;
; Message code #N$10. Prints the character's name, then #TOKEN($039B), or #TOKEN($0065) when the character is the player.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=Message_PrintTheCharacterIsOrAre
c$740C LD A,($B6EA)  ; Read *#R$B6EA.
 $740F EX AF,AF'     ; Switch #REGaf with its shadow.
 $7410 XOR A         ; {Clear *#R$B703.
; This entry point is used by the routine at #R$7425.
*$7411 LD ($B703),A  ; }
 $7414 EX AF,AF'     ; Switch #REGaf with its shadow.
 $7415 PUSH AF       ; {Call #R$7488 to print the fallback token, or go back to
 $7416 CALL $7488    ; naming the object.}
 $7419 POP AF        ; {Restore the saved #REGa from the stack, and return the
 $741A AND A         ; token #TOKEN($039B) unless it is zero.
 $741B LD DE,$039B   ;
 $741E RET NZ        ; }
 $741F LD DE,$0065   ; Use the token #TOKEN($0065).
 $7422 OR $01        ; Clear the zero flag so #TOKEN($0065) is printed.
 $7424 RET           ; Return.

; Message: Code #N($11), Object Is Or Are
;
; Message code #N$11. Prints the current object's name, then #TOKEN($039B) or #TOKEN($0065), as code #N$10 does.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=Message_PrintTheObjectIsOrAre
c$7425 LD A,($B6E8)  ; Read the current object.
; This entry point is used by the routine at #R$742D.
*$7428 EX AF,AF'     ; Switch #REGaf with its shadow.
 $7429 LD A,$01      ; Name the object, not the character (#N$01 for #R$B703).
 $742B JR $7411      ; Jump back to #R$7411 to update which noun is being
                     ; named.

; Message: Code #N($13), The Stacked Object Is Or Are
;
; Message code #N$13. Does what code #N$11 at #R$7425 does, but for the object id the caller pushed rather than the current object.
; Reached through the control-code table at #R$7295, dispatched by #R$72DD.
@label=Message_PrintTheStackedObjectIsOrAre
c$742D POP DE        ; {Take the object id the caller pushed into #REGa,
 $742E POP HL        ; keeping the two return addresses, and jump back to
 $742F POP AF        ; #R$7428.
 $7430 PUSH HL       ;
 $7431 PUSH DE       ;
 $7432 JR $7428      ; }

; Message: Apply The Saved Name
;
; Used by the routines at #R$7367 and #R$73D6.
; .
; Prints the name token held for the current noun. The noun printer runs, and the parser
; pointer is restored.
@label=Message_ApplyTheSavedName
c$7434 PUSH IY       ; {Call #R$9ED6 to choose which noun byte to print.
 $7436 PUSH HL       ;
 $7437 POP IY        ;
 $7439 CALL $9ED6    ; }
 $743C POP IY        ; Restore #REGiy from the stack.
 $743E RET           ; Return.

; Message: Choose A Class Token
;
; Used by the routines at #R$7478 and #R$9ED6.
; .
; Turns a class token into a dictionary word and prints it. Bit 7 of the token selects the
; class table; a zero neighbour ends the line.
@label=Message_ChooseAClassToken
c$743F BIT 7,D       ; {Jump to #R$7455 if the token is not a class token.
 $7441 JR Z,$7455    ; }
 $7443 LD A,E        ; {Jump to #R$744F if the low byte is not #TOKEN($07A8).
 $7444 LD HL,$07A8   ;
 $7447 CP L          ;
 $7448 JR NZ,$744F   ; }
 $744A LD A,D        ; {Return if the high nibble matches #TOKEN($07A8).
 $744B AND $0F       ;
 $744D CP H          ;
 $744E RET Z         ; }
@label=Message_ChooseAClassToken_SetTheCapitaliseFlag
*$744F LD A,$01      ; {Set the capitalise-the-next-letter flag.
 $7451 LD ($B704),A  ; }
 $7454 RET           ; Return.
@label=Message_ChooseAClassToken_ChooseTheTokenTable
*$7455 LD HL,$AD2D   ; Point #REGhl at #R$AD2D.
 $7458 LD A,($B701)  ; Read *#R$B701.
 $745B LD E,A        ; {Jump to #R$7465 if *#R$B701 and *#R$70DF are both zero.
 $745C LD A,($70DF)  ;
 $745F OR E          ;
 $7460 JR Z,$7465    ; }
 $7462 LD HL,$AD35   ; Point #REGhl at #R$AD35.
@label=Message_ChooseAClassToken_ShiftTheClassToken
*$7465 LD A,D        ; {Shift the class token two places.
 $7466 RRCA          ;
 $7467 RRCA          ;
 $7468 RRCA          ;
 $7469 AND $1E       ; }
 $746B PUSH DE       ; {Save #REGde and keep #REGa in #REGe.
 $746C LD E,A        ; }
 $746D LD D,$00      ; The class-token offset's high byte is zero.
 $746F ADD HL,DE     ; Add the class index to the token table.
 $7470 LD E,(HL)     ; Read the low byte of #R$AD35.
 $7471 INC HL        ; Step to the high byte of the token entry.
 $7472 LD D,(HL)     ; Read the high byte of #R$AD35.
 $7473 CALL $74C1    ; Call #R$74C1 to print a dictionary token.
 $7476 POP DE        ; Restore #REGde from the stack.
 $7477 RET           ; Return.

; Message: Print The Class Token
;
; Used by the routines at #R$7394 and #R$9ED6.
; .
; Prints the class token for the noun being named. When no noun is selected it returns the
; token at #R$AD35.
@label=Message_PrintTheClassToken
c$7478 PUSH DE       ; {Read which noun is being named.
 $7479 LD A,($B703)  ; }
 $747C AND A         ; {Call #R$743F if #REGa is non-zero.
 $747D CALL NZ,$743F ; }
 $7480 POP DE        ; {Take the high byte of the saved word.
 $7481 LD A,D        ; }
 $7482 AND %00001111 ; Keep the low four bits of the class token.
 $7484 LD D,A        ; Store that class token.
 $7485 JP $74C1      ; Jump to #R$74C1 to print a dictionary token.

; Message: Print The Fallback Token
;
; Used by the routines at #R$73A3 and #R$740C.
; .
; Prints #TOKEN($0AE3) when the class token at #R$AD35 is #N$FF. Any other token goes back to
; naming the object.
@label=Message_PrintTheFallbackToken
c$7488 CP $FF        ; {Jump back to #R$73D6 while the class token is not
 $748A JP NZ,$73D6   ; #N$FF.}
 $748D LD DE,$0AE3   ; Use the token #TOKEN($0AE3).
 $7490 JP $74C1      ; Jump to #R$74C1 to print a dictionary token.

; Get Common Word
;
; Used by the routine at #R$72DD.
; .
; Looks up one of the common words used by the message printer.
;
;   A Letter reference
; O:DE Common word address
@label=GetCommonWord
c$7493 SUB $60       ; Treat a letter at #N$60 or above as a common word.
 $7495 LD E,A        ; {Create offset for the dictionary look-up.
 $7496 LD D,$00      ; }
 $7498 LD HL,$AD3D   ; Point #REGhl at common Words.
 $749B ADD HL,DE     ; {Add to base address at #R$AD3D so that pointer is at
 $749C ADD HL,DE     ; the referenced word.}
 $749D LD E,(HL)     ; Read the low byte of #R$AD3D.
 $749E INC HL        ; Step to the next letter.
 $749F LD A,(HL)     ; Read the next byte of the text.
 $74A0 ADD A,$50     ; Add #N$50 to #REGa and store the result in #REGd.
 $74A2 LD D,A        ; Keep the class token plus #N$50.
 $74A3 JP $7311      ; Jump back to #R$7311 to print a dictionary token.

; Output Buffer
;
; Read by #R$74C1.
@label=OutputBuffer
g$74A6 DEFB $F1,$78,$36,$04,$CD,$30,$79,$36
 $74AE DEFB $36,$23,$73,$23,$70,$18,$1C,$FE
 $74B6 DEFB $0B,$20,$1B,$CB

; Print Action
;
; Used by the routine at #R$712B.
; .
; Prints the name of an action from the action table.
;
;   HL Pointer to an action in the #R$AB53(actions table)
; O:HL Pointer is incremented twice
; O:DE A word token
@label=PrintAction
c$74BA LD E,(HL)     ; {Store the token in #REGde, keeping only bits 0-3 of the
 $74BB INC HL        ; high byte.
 $74BC LD A,(HL)     ;
 $74BD INC HL        ;
 $74BE AND %00001111 ;
 $74C0 LD D,A        ; }
; Continues on to #R$74C1 to print.

; Print Token
;
; Used by the routines at #R$712B, #R$72DD, #R$7348, #R$743F, #R$7478, #R$7488,
; #R$8C4B, #R$9ED6, #R$A0C8, #R$A138 and #R$A448.
; .
; Prints a dictionary token, expanding letters until the dictionary word ends.
;
; DE The token.
@label=PrintToken
c$74C1 LD A,D        ; Take the token's high byte.
 $74C2 AND %00001111 ; Keep its low nibble (bits 8-11 of the token).
 $74C4 OR E          ; Merge in the low byte.
 $74C5 RET Z         ; Return if bits 0-11 of the token are all zero.
 $74C6 PUSH HL       ; {Save the text pointer, #REGbc and the token, and keep
 $74C7 PUSH BC       ; the class in #REGc.
 $74C8 PUSH DE       ;
 $74C9 LD C,D        ; }
 $74CA LD A,D        ; Take the token's high byte again.
 $74CB AND $0F       ; {Keep bits 8-11 of the token in #REGd.
 $74CD LD D,A        ; }
 $74CE LD HL,$6000   ; {Add the token index to the pointer.
 $74D1 ADD HL,DE     ; }
 $74D2 LD DE,$74A6   ; Point #REGde at output buffer.
 $74D5 PUSH HL       ; {Save the dictionary address and start the letter count
 $74D6 LD B,$00      ; at zero.}
@label=PrintToken_Loop
*$74D8 LD A,(HL)     ; Read the next byte of the dictionary word.
 $74D9 AND $1F       ; {Jump to #R$74F9 if the low five bits of this dictionary
 $74DB JR Z,$74F9    ; byte are zero.}
 $74DD INC B         ; Count one more character of the message.
 $74DE ADD A,$60     ; Add #N$60 to #REGa to convert to ASCII.
 $74E0 LD (DE),A     ; Store the result in the #R$74A6(output buffer).
 $74E1 INC DE        ; Increase the #R$74A6(output buffer) pointer by one.
 $74E2 BIT 7,(HL)    ; Check if this is the last character in it.
 $74E4 INC HL        ; Increase the character pointer reference by one.
 $74E5 JR Z,$74D8    ; If this is not the last character in it, loop back to
                     ; #R$74D8 to continue processing.
; Check minimum length.
 $74E7 LD A,B        ; Copy the count in #REGb into #REGa.
 $74E8 CP $02        ; {If the number of characters is only #N$02 then jump
 $74EA JR Z,$74D8    ; back to #R$74D8 to continue processing.}
 $74EC CP $03        ; {If it is not #N($03), then jump to #R$74F9.
 $74EE JR NZ,$74F9   ; }
 $74F0 DEC HL        ; {Otherwise fetch the second character again and test its
 $74F1 DEC HL        ; bit 7.
 $74F2 LD A,(HL)     ;
 $74F3 INC HL        ;
 $74F4 INC HL        ;
 $74F5 BIT 7,A       ; }
 $74F7 JR NZ,$74D8   ; Loop back to #R$74D8 to continue processing if bit 7 of
                     ; the second character is set.
@label=PrintToken_ChooseTheSubject
*$74F9 POP HL        ; {Jump to #R$7530 if the high nibble of the result is
 $74FA LD A,C        ; #N$50.
 $74FB AND $F0       ;
 $74FD CP $50        ;
 $74FF JR Z,$7530    ; }
 $7501 CP $40        ; {Jump to #R$7512 if the high nibble of the result is
 $7503 JR Z,$7512    ; #N$40.}
 $7505 CP $10        ; {Take the current object, and jump to #R$750F if the
 $7507 LD A,($B6E8)  ; high nibble of the result is #N$10.
 $750A JR Z,$750F    ; }
 $750C LD A,($B6EA)  ; Read *#R$B6EA.
@label=PrintToken_TestForThePlayer
*$750F AND A         ; {Jump to #R$7530 if the subject in #REGa is the player
 $7510 JR Z,$7530    ; (id #N$00).}
@label=PrintToken_ExpandTheVerbEnding
*$7512 INC HL        ; {Jump to #R$7530 if the token index is not a class
 $7513 BIT 7,(HL)    ; token.
 $7515 JR Z,$7530    ; }
 $7517 INC HL        ; Step to the next byte of the token index.
 $7518 LD A,(HL)     ; Read the token index.
 $7519 AND $E0       ; {Shift the top three bits down by three places. That
 $751B RRCA          ; index, times four, selects an ending in #R$B71F.
 $751C RRCA          ;
 $751D RRCA          ; }
 $751E LD L,A        ; The shifted index is the low byte of the pointer.
 $751F LD H,$00      ; The pointer's high byte is zero.
 $7521 LD BC,$B71F   ; {Add the verb-ending table at #R$B71F.
 $7524 ADD HL,BC     ; }
 $7525 LD B,$04      ; Copy at most #N$04 bytes of the ending.
@label=PrintToken_CopyTheEnding
*$7527 LD A,(HL)     ; {Jump to #R$7530 if the token index is zero.
 $7528 AND A         ;
 $7529 JR Z,$7530    ; }
 $752B INC HL        ; Step to the next byte of the token index.
 $752C LD (DE),A     ; {Store it at #R$74A6 and step on.
 $752D INC DE        ; }
 $752E DJNZ $7527    ; Loop back to #R$7527 until #N$04 runs out.
@label=PrintToken_MeasureTheOutput
*$7530 LD HL,$74A6   ; Point #REGhl at output buffer.
 $7533 EX DE,HL      ; Swap the print pointer with the start of the output
                     ; buffer.
 $7534 AND A         ; Clear carry before measuring how far the print pointer
                     ; has moved.
 $7535 SBC HL,DE     ; See how far the pointer is past #R$74A6.
 $7537 LD B,L        ; {Keep the length just measured, and read the action
 $7538 LD A,($B701)  ; countdown.}
 $753B AND A         ; See whether the action countdown is zero.
 $753C PUSH AF       ; {Jump to #R$7543 if the action countdown is not zero.
 $753D JR NZ,$7543   ; }
 $753F LD A,($86A0)  ; Read the character flag.
 $7542 AND A         ; See whether the character flag is zero.
@label=PrintToken_PrintASpace
*$7543 LD A,$20      ; {Take #N($20), and call #R$858B to print it if the
 $7545 CALL NZ,$858B ; action countdown or the character flag is not zero.}
 $7548 POP AF        ; {Take the characters left on the line from #R$85B3, and
 $7549 LD A,($85B3)  ; jump to #R$7551 if the action countdown is not zero.
 $754C JR NZ,$7551   ; }
 $754E LD A,($869B)  ; Read the room left on the line at #R$869B.
@label=PrintToken_FitOnTheLine
*$7551 LD HL,$B704   ; {Jump to #R$755C if #REGa is not below the character
 $7554 CP B          ; count. #REGa is *#R$85B3 when the action countdown is
 $7555 JR NC,$755C   ; not zero, and the room left on the line otherwise.}
 $7557 LD A,(HL)     ; Save the capitalise-the-next-letter flag.
; Print a newline.
 $7558 CALL $8583    ; Call #R$8583 to print a newline.
 $755B LD (HL),A     ; Put the capitalise-the-next-letter flag back as it was
                     ; before the newline.
@label=PrintToken_TestTheClassNibble
*$755C POP DE        ; {Take #N$01 and jump to #R$7567 unless the high nibble
 $755D LD A,D        ; of #REGd is #N$70.
 $755E AND $F0       ;
 $7560 CP $70        ;
 $7562 LD A,$01      ;
 $7564 JR NZ,$7567   ; }
 $7566 LD (HL),A     ; Set the capitalise-the-next-letter flag.
@label=PrintToken_Print
*$7567 LD HL,$74A6   ; Point #REGhl at output buffer.
@label=PrintToken_Print_Loop
*$756A LD A,(HL)     ; Fetch the next character from the output buffer.
 $756B CALL $858B    ; Call #R$858B to print one character.
 $756E INC HL        ; Increase the output buffer pointer by one.
 $756F DJNZ $756A    ; Decrease counter by one and loop back to #R$756A until
                     ; counter is zero.
 $7571 POP BC        ; {Restore #REGbc and #REGhl from the stack.
 $7572 POP HL        ; }
 $7573 RET           ; Return.

; Inglish: Prepare The Clause
;
; Prepares a clause in the parser workspace before the grammar is
; tried.
@label=InglishPrepareTheClause
c$7574 DEFB $00,$00,$00,$00,$00,$00         ;
 $757A DEFB $00                             ;
 $757B DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $7583 DEFB $00,$00                         ;
; This entry point is used by the routine at #R$6CEC.
*$7585 LD IY,$B9C8                          ; Point #REGiy at the parser
                                            ; workspace.
 $7589 XOR A                                ; Clear the conjunction count.
; This entry point is used by the routine at #R$82F7.
*$758A LD ($B71B),A                         ; Write #REGa to #R$B71B.
 $758D CALL $785F                           ; Call #R$785F to clear the matcher
                                            ; phase.
 $7590 LD ($B706),A                         ; Write #N$00 to #R$B706.
 $7593 LD E,$FF                             ; The class marker starts at #N$FF.
 $7595 LD A,($B71A)                         ; Read the matcher path flag.
 $7598 AND A                                ; See whether the matcher path flag
                                            ; is zero.
 $7599 LD D,$A0                             ; Class #N$A0 is used when a game
                                            ; is already in progress.
 $759B JP NZ,$7614                          ; If #REGa is not zero jump to
                                            ; #R$7614.
 $759E LD D,$C0                             ; Class #N$C0 is used for a fresh
                                            ; game.
; This entry point is used by the routines at #R$75FA and #R$8251.
*$75A0 XOR A                                ; {Write #N$00 to #R$757A.
 $75A1 LD ($757A),A                         ; }
 $75A4 LD A,E                               ; Take the class marker #N$FF into
                                            ; #REGa.
 $75A5 OR $C7                               ; Merge in #N$C7.
 $75A7 LD E,A                               ; Keep the merged class flags in
                                            ; #REGe.
; Test the matcher phase.
 $75A8 LD A,($B719)                         ; {Jump to #R$75B1 if *#R$B719 is
 $75AB CP $02                               ; not #N$02.
 $75AD JR NZ,$75B1                          ; }
 $75AF RES 1,E                              ; Clear bit 1.
@label=InglishPrepareTheClause_BlankAParserSlot
*$75B1 CALL $7864                           ; Call #R$7864 to blank a parser
                                            ; slot.
; This entry point is used by the routines at #R$76F2, #R$7733, #R$77D1,
; #R$7924, #R$82B3, #R$82F7 and #R$83A0.
*$75B4 LD HL,$757B                          ; {Write #N$00 to #N$0A bytes,
 $75B7 LD B,$0A                             ; starting from #R$757B with
 $75B9 CALL $70E2                           ; #R$70E2.}
 $75BC SET 4,E                              ; Set bit 4.
; This entry point is used by the routine at #R$7790.
*$75BE CALL $7873                           ; Call #R$7873 to read the next
                                            ; grammar byte.
 $75C1 PUSH DE                              ; Save #REGde.
 $75C2 RRCA                                 ; {Turn the grammar byte into a
 $75C3 RRCA                                 ; jump-table offset.
 $75C4 RRCA                                 ; }
 $75C5 LD E,A                               ; Keep the jump-table offset in
                                            ; #REGe.
 $75C6 LD D,$00                             ; The grammar-table offset's high
                                            ; byte is zero.
 $75C8 LD HL,$75D2                          ; {Point #REGhl at entry #REGde of
 $75CB ADD HL,DE                            ; #R$75D2.}
 $75CC LD E,(HL)                            ; Read the low byte of the handler.
 $75CD INC HL                               ; Step to the high byte of the
                                            ; handler.
 $75CE LD D,(HL)                            ; Read the high byte of the
                                            ; handler.
 $75CF EX DE,HL                             ; Point #REGhl at the handler.
 $75D0 POP DE                               ; {Jump to the action handler the
 $75D1 JP (HL)                              ; caller addressed.}
@label=JumpTable
 $75D2 DEFW $76F2                           ;
 $75D4 DEFW $7795                           ;
 $75D6 DEFW $76EC                           ;
 $75D8 DEFW $7733                           ;
 $75DA DEFW $772F                           ;
 $75DC DEFW $77D1                           ;
 $75DE DEFW $77C9                           ;
 $75E0 DEFW $77A2                           ;
 $75E2 DEFW $7790                           ;
 $75E4 DEFW $8251                           ;
 $75E6 DEFW $770B                           ;
 $75E8 DEFW $75FA                           ;
 $75EA DEFW $75F6                           ;

; Inglish: Count A Conjunction
;
; Used by the routine at #R$75FA.
; .
; Counts a conjunction in the clause so a later sentence can be
; printed.
@label=InglishCountAConjunction
c$75EC LD A,($B71B)  ; Read *#R$B71B.
 $75EF DEC A         ; Step the conjunction count down by one.
 $75F0 RET           ; Return.

; Inglish: Test The Conjunction Count
;
; Used by the routines at #R$75FA, #R$7733 and #R$7924.
; .
; Reads the conjunction count at #R$B71B and returns with the zero flag set when the
; clause has no conjunction left.
@label=Inglish_TestTheConjunctionCount
c$75F1 LD A,($B71B)  ; Read *#R$B71B.
 $75F4 AND A         ; See whether the conjunction count is zero.
 $75F5 RET           ; Return.

; Inglish: Clear The Repeat Flag
;
; Clears the flag that would make the matcher repeat a word.
; Reached through the jump table at #R$75D2, dispatched from #R$75D0.
@label=InglishClearTheRepeatFlag
c$75F6 XOR A         ; {Clear *#R$B705.
 $75F7 LD ($B705),A  ; }

; Inglish: Match One Word
;
; Used by the routines at #R$770B and #R$7733.
; .
; Matches one word of the clause against the dictionary.
; Reached through the jump table at #R$75D2, dispatched from #R$75D0.
@label=InglishMatchOneWord
c$75FA BIT 1,E        ; {Jump to #R$7614 if bit 1 of the grammar flag is clear.
 $75FC JR Z,$7614     ; }
; Test the replay path.
 $75FE LD A,($B706)   ; {Jump to #R$7614 if *#R$B706 is not zero.
 $7601 AND A          ;
 $7602 JR NZ,$7614    ; }
; Test the class being matched.
 $7604 LD A,($B6DE)   ; {Jump to #R$760E if *#R$B6DE is not #N$C0.
 $7607 CP $C0         ;
 $7609 JR NZ,$760E    ; }
 $760B CP D           ; {Jump to #R$75EC when this letter matches the
 $760C JR Z,$75EC     ; dictionary.}
@label=InglishMatchOneWord_TestTheConjunction
*$760E CALL $75F1     ; Call #R$75F1 to test the conjunction count.
 $7611 JP Z,$792F     ; Jump to #R$792F if #R$75F1 found no conjunction left.
; This entry point is used by the routine at #R$7574.
@label=InglishMatchOneWord_MarkTheClauseByte
*$7614 LD A,($B719)   ; Read *#R$B719.
 $7617 DEC A          ; {Jump to #R$761E unless the matcher phase is #N$01.
 $7618 JR NZ,$761E    ; }
 $761A SET 7,(IY+$01) ; Mark the clause byte at offset 1 so bit 7 is on.
@label=InglishMatchOneWord_PointAtReplayPath
*$761E LD HL,$B706    ; {Point #REGhl at #R$B706 and jump to #R$7629 unless the
 $7621 DEC A          ; matcher phase was #N$02.
 $7622 LD A,D         ;
 $7623 JR NZ,$7629    ; }
 $7625 CP $A0         ; {Jump to #R$762A if the class in #REGd is #N$A0.
 $7627 JR Z,$762A     ; }
@label=InglishMatchOneWord_CountOneMoreInTheReplayPath
*$7629 INC (HL)       ; Count one more in the replay path.
@label=InglishMatchOneWord_ExchangeTheTwoRecords
*$762A CALL $7893     ; Call #R$7893 to exchange the two records.
 $762D CP $A0         ; {Jump back to #R$75A0 if the class is #N$A0.
 $762F JP Z,$75A0     ; }
; Test the fresh-game flag.
 $7632 LD A,($B71A)   ; {Jump to #R$7682 if *#R$B71A is zero.
 $7635 AND A          ;
 $7636 JR Z,$7682     ; }
 $7638 PUSH DE        ; {Save #REGde and keep #REGa in #REGe.
 $7639 LD E,A         ; }
 $763A LD D,$00       ; The word-class offset's high byte is zero.
 $763C LD HL,$B9C8    ; {Index the parser workspace at #R$B9C8.
 $763F ADD HL,DE      ; }
 $7640 PUSH IY        ; {Point #REGiy at the first parser slot.
 $7642 LD IY,$B9B0    ; }
 $7646 LD A,(IY+$08)  ; Read the name token from #REGiy.
 $7649 OR (IY+$09)    ; {Jump to #R$7668 if the name token at #REGiy is zero.
 $764C LD DE,$B9B8    ;
 $764F JR Z,$7668     ; }
 $7651 LD A,(IY+$08)  ; Read the name token from #REGiy.
 $7654 CP (HL)        ; {Jump to #R$765F if the name token at #REGiy+8 does not
 $7655 JR NZ,$765F    ; match.}
 $7657 LD A,(IY+$09)  ; Read the name token's high byte from #REGiy.
 $765A INC HL         ; {Jump to #R$7668 if the high byte of that word matches
 $765B CP (HL)        ; too.
 $765C DEC HL         ;
 $765D JR Z,$7668     ; }
@label=InglishMatchOneWord_TestTheNameWord
*$765F LD A,(IY+$12)  ; Read byte +#N$12 from #REGiy.
 $7662 OR (IY+$13)    ; Test whether the word at offset #N$12 is zero.
 $7665 LD DE,$B9C2    ; Point #REGde at the third parser slot.
@label=InglishMatchOneWord_TestTheNameToken
*$7668 POP IY         ; {Jump to #R$7681 if the name token just tested is not
 $766A JR NZ,$7681    ; zero.}
 $766C EX DE,HL       ; Swap the word pointer with the parser slot.
 $766D LD B,$03       ; Count #N$03 passes.
@label=InglishMatchOneWord_Loop
*$766F LD A,(HL)      ; {Jump to #R$7677 unless this grammar pair is empty.
 $7670 INC HL         ;
 $7671 OR (HL)        ;
 $7672 DEC HL         ;
 $7673 JR NZ,$7677    ; }
 $7675 LD A,(DE)      ; {Copy the workspace byte into the empty slot pair.
 $7676 LD (HL),A      ; }
@label=InglishMatchOneWord_StepThePairPointers
*$7677 INC HL         ; {Step #REGhl and #REGde on, and jump to #R$767D if the
 $7678 INC DE         ; pair was not empty.
 $7679 JR NZ,$767D    ; }
 $767B LD A,(DE)      ; {Copy the second workspace byte into the slot.
 $767C LD (HL),A      ; }
@label=InglishMatchOneWord_StepToTheNextParserByte
*$767D INC HL         ; Step to the next byte of the parser slot.
 $767E INC DE         ; Step to the next byte of the parser workspace.
 $767F DJNZ $766F     ; Loop back to #R$766F until #N$03 runs out.
@label=InglishMatchOneWord_PopTheMatchPointer
*$7681 POP DE         ; {Point at the location table.
@label=InglishMatchOneWord_PointAtTheLocationTable
*$7682 PUSH IY        ;
 $7684 LD IY,$B9E0    ; }
 $7688 LD A,($B706)   ; Read *#R$B706.
 $768B LD B,A         ; Copy the result into #REGb.
 $768C PUSH BC        ; {Call #R$7892 to drop one from the character count and
 $768D CALL $7892     ; swap the two records.}
@label=InglishMatchOneWord_ExchangeForTheReplay
*$7690 LD A,B         ; {Jump to #R$76A4 if the replay path is zero.
 $7691 AND A          ;
 $7692 JR Z,$76A4     ; }
 $7694 CALL $7892     ; Call #R$7892 to exchange the two records.
 $7697 LD A,(IY+$01)  ; Read the clause byte at offset 1.
 $769A AND $7F        ; {Keep bits 0-6 of this clause byte, and call #R$78B7 if
 $769C OR (IY+$00)    ; it and the byte at #REGiy are both zero.
 $769F CALL Z,$78B7   ; }
 $76A2 JR $7690       ; Jump back to #R$7690 to read the next word.
@label=InglishMatchOneWord_SkipToThePreviousParserSlot
*$76A4 POP BC         ; {Call #R$788C to drop one from the character count and
 $76A5 POP IY         ; skip to the previous parser slot.
 $76A7 PUSH IY        ;
 $76A9 CALL $788C     ; }
@label=InglishMatchOneWord_TestWhetherTheReplayPathIsZero
*$76AC LD A,B         ; {Jump to #R$76DE if the replay path is zero.
 $76AD AND A          ;
 $76AE JP Z,$76DE     ; }
 $76B1 CALL $788C     ; Call #R$788C to step to the previous slot.
 $76B4 LD A,(IY+$12)  ; Read byte +#N$12 from #REGiy.
 $76B7 OR (IY+$13)    ; {Jump back to #R$76AC if the name token at offset #N$12
 $76BA JR NZ,$76AC    ; is not zero.}
 $76BC LD A,(IY+$00)  ; Read the clause byte at offset 0.
 $76BF CP (IX+$00)    ; {Jump back to #R$76AC if the clause byte at offset 0 is
 $76C2 JR NZ,$76AC    ; not byte 0 of this record.}
 $76C4 LD A,(IY+$01)  ; Read the clause byte at offset 1.
 $76C7 CP (IX+$01)    ; {Jump back to #R$76AC if the clause byte at offset 1 is
 $76CA JR NZ,$76AC    ; not byte 1 of this record.}
 $76CC LD A,(IX+$0E)  ; Read clause byte #N$0E of the other record.
 $76CF OR (IX+$0F)    ; {Jump back to #R$76AC if bytes #N$0E and #N$0F of this
 $76D2 JR Z,$76AC     ; record are both zero.}
 $76D4 EXX            ; Switch to the saved registers for this phrase.
 $76D5 LD DE,$000E    ; The copy starts #N$0E bytes into the record.
 $76D8 CALL $78EA     ; Call #R$78EA to copy the grammar bytes into the clause.
 $76DB JP $76AC       ; Jump back to #R$76AC to read the next word.
@label=InglishMatchOneWord_ReadTheLineReadFlag
*$76DE POP IY         ; {Read *#R$B705.
 $76E0 LD A,($B705)   ; }
 $76E3 AND A          ; {Return if the line-read flag is zero.
 $76E4 RET Z          ; }
 $76E5 CALL $75F1     ; Call #R$75F1 to test the conjunction count.
 $76E8 RET Z          ; Return if no conjunction is left.
 $76E9 JP $75A0       ; Jump to #R$75A0 to reset the parser flags and blank the
                      ; parser slot.

; Inglish: Reject A Class
;
; Rejects a word class that does not fit the grammar.
; Reached through the jump table at #R$75D2, dispatched from #R$75D0.
@label=InglishRejectAClass
c$76EC BIT 1,E       ; {Jump to #R$7731 if bit 1 of the grammar flag is set.
 $76EE JR NZ,$7731   ; }
 $76F0 LD D,$00      ; Clear #REGd before the class bits in #REGe are tested.

; Inglish: Accept The Clause
;
; Accepts the clause once the grammar matches.
; Reached through the jump table at #R$75D2, dispatched from #R$75D0.
@label=InglishAcceptTheClause
c$76F2 BIT 2,E       ; {Jump to #R$7929 if bit 2 of the grammar flag is clear.
 $76F4 JP Z,$7929    ; }
; Test the matcher phase.
 $76F7 LD A,($B719)  ; {Jump to #R$7701 if *#R$B719 is not #N$02.
 $76FA CP $02        ;
 $76FC JR NZ,$7701   ; }
 $76FE CALL $7858    ; Call #R$7858 to clear the matcher phase.
@label=InglishAcceptTheClause_StoreThePair
*$7701 RES 2,E       ; Clear the flags so bit 2 is off.
 $7703 LD L,$02      ; Two bytes of the accepted pair are stored.
 $7705 CALL $7918    ; Call #R$7918 to store the pair of clause bytes.
 $7708 JP $75B4      ; Jump back to #R$75B4 to clear the matcher scratch.

; Inglish: Save The Match
;
; Saves the bytes of a match so it can be restored if a later try
; fails.
; Reached through the jump table at #R$75D2, dispatched from #R$75D0.
@label=InglishSaveTheMatch
c$770B RES 3,E       ; {Clear the flags so bit 3 is off.
 $770D PUSH DE       ; }
@label=InglishSaveTheMatch_Loop
*$770E CALL $7873    ; Call #R$7873 to read the next grammar byte.
 $7711 CP $A0        ; {Jump back to #R$770E if the grammar byte is #N$A0.
 $7713 JR Z,$770E    ; }
 $7715 DEC HL        ; Step back one byte through the text.
 $7716 DEC HL        ; Step back one byte through the text.
 $7717 LD ($7574),HL ; Remember the text pointer at #R$7574.
 $771A LD ($B6DC),HL ; Update *#R$B6DC.
 $771D POP DE        ; {Take the low byte of the saved word.
 $771E LD A,E        ; }
 $771F LD ($7576),A  ; Store the result at #N$7576.
 $7722 LD ($7577),IY ; Store #REGiy at #N$7577.
 $7726 LD A,($B706)  ; Read *#R$B706.
 $7729 LD ($7579),A  ; Store the result at #N$7579.
 $772C JP $75FA      ; Jump to #R$75FA to match one word.

; Inglish: Clear The Match Bit
;
; Clears the bit that says a class matched.
; Reached through the jump table at #R$75D2, dispatched from #R$75D0.
@label=InglishClearTheMatchBit
c$772F RES 0,E       ; Clear the flags so bit 0 is off.
; This entry point is used by the routines at #R$76EC and #R$7795.
*$7731 LD D,$30      ; Class #N$30 selects the match-bit test.

; Inglish: Restore The Match
;
; Restores a saved match and tries the clause again.
; Reached through the jump table at #R$75D2, dispatched from #R$75D0.
@label=InglishRestoreTheMatch
c$7733 BIT 3,E       ; {Jump to #R$7755 if bit 3 of the grammar flag is set.
 $7735 JR NZ,$7755   ; }
 $7737 CALL $75F1    ; Call #R$75F1 to test the conjunction count.
 $773A JR NZ,$7755   ; Jump to #R$7755 if a conjunction is still left.
 $773C LD HL,($7574) ; Read the pointer stored at #R$7574.
 $773F LD ($B6DC),HL ; Update *#R$B6DC.
 $7742 LD D,$B0      ; The restored class is #N$B0.
 $7744 LD A,($7576)  ; Read the saved grammar flag.
 $7747 LD E,A        ; Keep the saved grammar flag.
 $7748 LD A,($7579)  ; Read the saved replay path.
 $774B LD ($B706),A  ; Update *#R$B706.
 $774E LD IY,($7577) ; Read the saved matcher pointer.
 $7752 JP $75FA      ; Jump to #R$75FA to match one word.
@label=InglishRestoreTheMatch_TestTheGrammarFlag
*$7755 CALL $785F    ; Call #R$785F to clear the matcher phase.
 $7758 BIT 1,E       ; {Jump to #R$7929 if bit 1 of the saved grammar flag is
 $775A JP Z,$7929    ; clear.}
 $775D BIT 0,E       ; {Jump to #R$7767 if the match bit of the saved grammar
 $775F JR Z,$7767    ; flag is clear.}
@label=InglishRestoreTheMatch_StoreThePairOfClauseBytes
*$7761 CALL $7914    ; Call #R$7914 to store the pair of clause bytes.
 $7764 JP $75B4      ; Jump back to #R$75B4 to clear the matcher scratch.
@label=InglishRestoreTheMatch_SaveTheTokenPointer
*$7767 PUSH DE       ; {Save #REGde, #REGbc and the token pointer at #R$B6DC on
 $7768 PUSH BC       ; the stack.
 $7769 LD HL,($B6DC) ;
 $776C PUSH HL       ; }
@label=InglishRestoreTheMatch_Loop
*$776D CALL $7873    ; Call #R$7873 to read the next grammar byte.
 $7770 CP $00        ; {Jump back to #R$776D if the grammar byte is zero.
 $7772 JR Z,$776D    ; }
 $7774 SET 0,E       ; {Set bit 0 of #REGe, and jump to #R$7782 if the grammar
 $7776 CP $20        ; byte is #N$20.
 $7778 JR Z,$7782    ; }
 $777A POP HL        ; {Update *#R$B6DC.
 $777B LD ($B6DC),HL ; }
 $777E POP BC        ; {Jump back to #R$7761 to store the next pair of clause
 $777F POP DE        ; bytes.
 $7780 JR $7761      ; }
@label=InglishRestoreTheMatch_StoreTheNextPair
*$7782 CALL $7914    ; Call #R$7914 to store the pair of clause bytes.
 $7785 POP HL        ; {Drop one saved value, restore #REGbc and #REGhl, and
 $7786 POP BC        ; force #REGl to #N$02.
 $7787 POP HL        ;
 $7788 LD L,$02      ; }
 $778A CALL $7918    ; Call #R$7918 to store the pair of clause bytes.
 $778D JP $75B4      ; Jump back to #R$75B4 to clear the matcher scratch.

; Inglish: Try The Next Class
;
; Tries the next word class when this one did not match.
; Reached through the jump table at #R$75D2, dispatched from #R$75D0.
@label=InglishTryTheNextClass
c$7790 RES 4,E       ; Clear the flags so bit 4 is off.
 $7792 JP $75BE      ; Jump back to #R$75BE to follow the handler addressed
                     ; here.

; Inglish: Check The Word Class
;
; Checks that the typed word's class is one the grammar allows here.
; Reached through the jump table at #R$75D2, dispatched from #R$75D0.
@label=InglishCheckTheWordClass
c$7795 BIT 1,E       ; {Jump to #R$77A0 if bit 1 of the grammar flag is clear.
 $7797 JR Z,$77A0    ; }
; Test the class being matched.
 $7799 LD A,($B6DE)  ; {Jump to #R$7731 if *#R$B6DE is #N$A0.
 $779C CP $A0        ;
 $779E JR Z,$7731    ; }
@label=InglishCheckTheWordClass_SetTheClassToCheck
*$77A0 LD D,$70      ; The class being checked is #N$70.

; Inglish: Walk The Grammar
;
; Walks one step of the grammar, including groups in brackets.
; Reached through the jump table at #R$75D2, dispatched from #R$75D0.
@label=InglishWalkTheGrammar
c$77A2 CALL $781C    ; Call #R$781C to count another grammar try.
@label=InglishWalkTheGrammar_Loop
*$77A5 CALL $7873    ; Call #R$7873 to read the next grammar byte.
 $77A8 CP $70        ; {Jump back to #R$77A2 if the grammar byte is #N$70.
 $77AA JR Z,$77A2    ; }
 $77AC CP $80        ; {Jump to #R$77B9 unless the grammar byte is #N$80.
 $77AE JR NZ,$77B9   ; }
 $77B0 BIT 4,E       ; {Call #R$7924 if bit 4 of the grammar flag is clear.
 $77B2 CALL Z,$7924  ; }
 $77B5 RES 4,E       ; Clear the flags so bit 4 is off.
 $77B7 JR $77A5      ; Jump back to #R$77A5 to run the grammar.

; Inglish: Keep The Unknown Word
;
; Used by the routines at #R$77A2 and #R$77C9.
; .
; Keeps the unknown word at #R$B6DA as the token pointer while the matcher counts at #N$60
; and #N$50 are still live.
@label=Inglish_KeepTheUnknownWord
c$77B9 CP $60        ; {Jump to #R$77C9 if the grammar byte is #N$60.
 $77BB JR Z,$77C9    ; }
 $77BD CP $50        ; {Jump to #R$77D1 if the grammar byte is #N$50.
 $77BF JR Z,$77D1    ; }
 $77C1 LD HL,($B6DA) ; Read *#R$B6DA.
 $77C4 LD ($B6DC),HL ; Update *#R$B6DC.
 $77C7 JR $77D7      ; Jump to #R$77D7 to keep a count of #N$50.

; Inglish: Step Over A Group
;
; Used by the routine at #R$77B9.
; .
; Skips a grammar group that does not apply to this clause.
; Reached through the jump table at #R$75D2, dispatched from #R$75D0.
@label=InglishStepOverAGroup
c$77C9 CALL $7809    ; Call #R$7809 to patch the matcher word.
 $77CC CALL $7873    ; Call #R$7873 to read the next grammar byte.
 $77CF JR $77B9      ; Jump back to #R$77B9 to read the next word.

; Inglish: Run The Grammar
;
; Used by the routine at #R$77B9.
; .
; Runs the grammar over the tokens and, when they match, performs the
; action.
; Reached through the jump table at #R$75D2, dispatched from #R$75D0.
@label=InglishRunTheGrammar
c$77D1 LD HL,$757F     ; Point #REGhl at the matcher patch at #N$757F.
 $77D4 LD (HL),C       ; Store the saved byte in the matcher patch.
 $77D5 INC HL          ; Step to the next byte of the matcher patch.
 $77D6 LD (HL),B       ; Store the saved byte in the matcher patch.
; This entry point is used by the routine at #R$77B9.
*$77D7 LD D,$50        ; The class being run is #N$50.
; Test the matcher phase.
 $77D9 LD A,($B719)    ; {Jump to #R$7802 if *#R$B719 is not #N$02.
 $77DC CP $02          ;
 $77DE JR NZ,$7802     ; }
 $77E0 LD HL,($757B)   ; {Jump to #R$77FF if the word at #R$757B is not zero.
 $77E3 LD A,H          ;
 $77E4 OR L            ;
 $77E5 JR NZ,$77FF     ; }
 $77E7 BIT 6,(IY+$19)  ; {Jump to #R$77F5 if bit 6 of the clause byte at offset
 $77EB JR NZ,$77F5     ; #N$19 is set.}
 $77ED LD BC,$FFE8     ; {Step back one parser record.
 $77F0 ADD IY,BC       ; }
 $77F2 CALL $7864      ; Call #R$7864 to blank a parser slot.
@label=InglishRunTheGrammar_CopyFourGrammarBytes
*$77F5 CALL $7850      ; Call #R$7850 to copy four grammar bytes.
 $77F8 LD (IY+$01),$40 ; Set the clause byte at offset 1 to #N$40.
 $77FC JP $75B4        ; Jump back to #R$75B4 to clear the matcher scratch.
@label=InglishRunTheGrammar_ClearTheMatcherPhase
*$77FF CALL $7858      ; Call #R$7858 to clear the matcher phase.
@label=InglishRunTheGrammar_FollowTheGrammarFlag
*$7802 CALL $782B      ; Call #R$782B to follow the grammar flag.
 $7805 JP Z,$75B4      ; Jump back to #R$75B4. #R$782B always returns zero, so
                       ; this jump is always taken.
 $7808 RET             ; Return.

; Inglish: Patch The Matcher Word
;
; Used by the routine at #R$77C9.
; .
; Patches the matcher word at #N$7581 with the saved bytes. When those bytes do not match,
; the player is asked "what?".
@label=Inglish_PatchTheMatcherWord
c$7809 LD HL,$7581   ; Point #REGhl at the patched matcher word at #N$7581.
; This entry point is used by the routine at #R$781C.
@label=Inglish_PatchTheMatcherWord_Loop
*$780C LD A,(HL)     ; {Jump to #R$7818 if this grammar pair is empty.
 $780D INC HL        ;
 $780E OR (HL)       ;
 $780F JR Z,$7818    ; }
 $7811 INC HL        ; {Jump to #R$7924 unless the next grammar pair is empty.
 $7812 LD A,(HL)     ;
 $7813 INC HL        ;
 $7814 OR (HL)       ;
 $7815 JP NZ,$7924   ; }
@label=Inglish_PatchTheMatcherWord_StoreTheSavedBytes
*$7818 LD (HL),B     ; Store the saved byte in the patched matcher word.
 $7819 DEC HL        ; Step back one byte through the patched matcher word.
 $781A LD (HL),C     ; Store the saved byte in the patched matcher word.
 $781B RET           ; Return.

; Inglish: Count Another Grammar Try
;
; Used by the routine at #R$77A2.
; .
; Counts another grammar try at #R$757A, up to three, then returns to reading the next
; word.
@label=Inglish_CountAnotherGrammarTry
c$781C LD HL,$757A   ; Point #REGhl at #R$757A.
 $781F INC (HL)      ; Count one more in the grammar-try count.
 $7820 LD A,(HL)     ; {Jump to #R$7924 if the grammar-try count is not below
 $7821 CP $03        ; #N$03.
 $7823 JP NC,$7924   ; }
 $7826 LD HL,$757B   ; Point #REGhl at #R$757B.
 $7829 JR $780C      ; Jump back to #R$780C to read the next word.

; Inglish: Follow The Grammar Flag
;
; Used by the routine at #R$77D1.
; .
; Follows the grammar flag in #REGe. Bit 6 copies four grammar bytes, bit 7 copies ten,
; and neither asks "what?" and reports no match.
@label=Inglish_FollowTheGrammarFlag
c$782B BIT 6,E       ; {Jump to #R$7850 if bit 6 of the grammar flag is set.
 $782D JR NZ,$7850   ; }
 $782F BIT 7,E       ; {Jump to #R$7838 if bit 7 of the grammar flag is set.
 $7831 JR NZ,$7838   ; }
 $7833 CALL $7924    ; Call #R$7924 to ask "what ?" when a conjunction is still
                     ; open.
 $7836 XOR A         ; Return zero.
 $7837 RET           ; Return.

; Inglish: Copy Ten Grammar Bytes
;
; Used by the routines at #R$782B and #R$82F7.
; .
; Clears bit 7 of the grammar flag and copies ten bytes from #N$0E into the clause, then
; reports no match.
@label=Inglish_CopyTenGrammarBytes
c$7838 RES 7,E       ; Clear the flags so bit 7 is off.
 $783A PUSH DE       ; {The ten grammar bytes start #N$0E bytes into the
 $783B LD DE,$000E   ; record.}
; This entry point is used by the routine at #R$7850.
@label=Inglish_CopyTenGrammarBytes_PointAtTheClause
*$783E PUSH BC       ; {Save #REGbc and point #REGhl at the clause plus the
 $783F PUSH IY       ; offset in #REGde.
 $7841 POP HL        ;
 $7842 ADD HL,DE     ; }
 $7843 EX DE,HL      ; Point #REGde at those bytes.
 $7844 LD HL,$757B   ; {Copy the prepared bytes.
 $7847 LD BC,$000A   ;
 $784A LDIR          ; }
 $784C POP BC        ; {Restore the saved registers from the stack and clear
 $784D POP DE        ; #REGa.
 $784E XOR A         ; }
 $784F RET           ; Return.

; Inglish: Copy Four Grammar Bytes
;
; Used by the routines at #R$77D1, #R$782B and #R$82F7.
; .
; Clears bit 6 of the grammar flag and copies four bytes into the record, then joins the
; ten-byte copy.
@label=Inglish_CopyFourGrammarBytes
c$7850 RES 6,E       ; Clear the flags so bit 6 is off.
 $7852 PUSH DE       ; {The copy starts #N$04 bytes into the record.
 $7853 LD DE,$0004   ; }
 $7856 JR $783E      ; Jump back to #R$783E to copy the ten grammar bytes.

; Inglish: Clear The Matcher Phase
;
; Used by the routines at #R$76F2 and #R$77D1.
; .
; Skips a location marked in the clause and clears the matcher phase at
; #R$B719.
@label=Inglish_ClearTheMatcherPhase
c$7858 CALL $78A5    ; Call #R$78A5 to step past a clause whose location is
                     ; marked.
 $785B PUSH IX       ; {Use the saved address as the parser pointer.
 $785D POP IY        ; }
; This entry point is used by the routines at #R$7574 and #R$7733.
*$785F XOR A         ; {Clear *#R$B719.
 $7860 LD ($B719),A  ; }
 $7863 RET           ; Return.

; Inglish: Blank A Parser Slot
;
; Used by the routines at #R$7574 and #R$77D1.
; .
; Blanks one #N$18-byte parser slot and stores the clause bytes at offsets -24
; and -23.
@label=Inglish_BlankAParserSlot
c$7864 PUSH IY       ; {Count #N$18 passes.
 $7866 POP HL        ;
 $7867 LD B,$18      ; }
; Fill the buffer at #REGhl.
 $7869 CALL $70E2    ; Call #R$70E2 to fill a run of bytes.
 $786C LD (IY-$18),B ; Clear byte 0 of the previous clause record.
 $786F LD (IY-$17),B ; Clear byte 1 of the previous clause record.
 $7872 RET           ; Return.

; Inglish: Read The Next Grammar Byte
;
; Used by the routines at #R$7574, #R$770B, #R$7733, #R$77A2 and #R$77C9.
; .
; Reads the next grammar byte from the token pointer, splits it into nibbles, and stores
; the token pointer, the unknown word and the class.
@label=Inglish_ReadTheNextGrammarByte
c$7873 LD HL,($B6DC) ; Read *#R$B6DC.
 $7876 LD ($B6DA),HL ; Update *#R$B6DA.
 $7879 LD A,D        ; Take the class into #REGa.
 $787A LD ($B6DE),A  ; Update *#R$B6DE.
 $787D LD A,(HL)     ; Read the token.
 $787E AND $0F       ; {Keep the low nibble of the token.
 $7880 LD B,A        ; }
 $7881 LD A,(HL)     ; Read the token.
 $7882 AND $F0       ; {Keep the high nibble of the token.
 $7884 LD D,A        ; }
 $7885 INC HL        ; Step to the next byte of the token pointer.
 $7886 LD C,(HL)     ; Read a byte from the pointer into #REGc.
 $7887 INC HL        ; Step to the next byte of the token pointer.
 $7888 LD ($B6DC),HL ; Update *#R$B6DC.
 $788B RET           ; Return.

; Inglish: Step To The Previous Slot
;
; Used by the routine at #R$75FA.
; .
; Drops the character count and skips to the previous parser slot.
@label=Inglish_StepToThePreviousSlot
c$788C DEC B         ; Drop one from the character count.
 $788D CALL $78A5    ; Call #R$78A5 to step past a clause whose location is
                     ; marked.
 $7890 JR $7896      ; Jump to #R$7896 to exchange the clause records.

; Inglish: Exchange The Two Records
;
; Used by the routine at #R$75FA.
; .
; Drops the character count and exchanges the two clause records.
@label=Inglish_ExchangeTheTwoRecords
c$7892 DEC B         ; Drop one from the character count.
; This entry point is used by the routine at #R$75FA.
*$7893 CALL $789F    ; Call #R$789F to address the previous slot.
; This entry point is used by the routine at #R$788C.
@label=Inglish_ExchangeTheTwoRecords_SwapRecordPointers
*$7896 PUSH IX       ; {Swap #REGix and #REGiy.
 $7898 PUSH IY       ;
 $789A POP IX        ;
 $789C POP IY        ; }
 $789E RET           ; Return.

; Inglish: Address The Previous Slot
;
; Used by the routine at #R$7892.
; .
; Addresses the previous #N$18-byte parser slot.
@label=Inglish_AddressThePreviousSlot
c$789F PUSH DE       ; {Step back one #N$18-byte parser record.
 $78A0 LD DE,$FFE8   ; }
 $78A3 JR $78A9      ; Jump to #R$78A9 to walk the previous parser slot.

; Inglish: Skip A Marked Location
;
; Used by the routines at #R$7858 and #R$788C.
; .
; Steps through clause records of #N$18 bytes, skipping any whose location has bit 6 set,
; and returns the caller's pointer.
@label=Inglish_SkipAMarkedLocation
c$78A5 PUSH DE        ; {Each clause record is #N$18 bytes.
 $78A6 LD DE,$0018    ; }
; This entry point is used by the routine at #R$789F.
@label=Inglish_SkipAMarkedLocation_CopyTheParserPointer
*$78A9 PUSH IY        ; {Copy the parser pointer into #REGix.
 $78AB POP IX         ; }
@label=Inglish_SkipAMarkedLocation_SkipAMarkedSlot
*$78AD ADD IX,DE      ; {Jump back to #R$78AD if bit 6 of the clause byte at
 $78AF BIT 6,(IX+$01) ; offset 1 is set.
 $78B3 JR NZ,$78AD    ; }
 $78B5 POP DE         ; Restore #REGde from the stack.
 $78B6 RET            ; Return.

; Inglish: Copy Two Bytes From The Other Clause
;
; Used by the routine at #R$75FA.
; .
; Copies byte 0 and byte 1 from the other clause record into this clause. When bit 7 of the
; grammar flag is set, the name bytes are copied too.
@label=Inglish_CopyTwoBytesFromTheOtherClause
c$78B7 EXX           ; Switch to the saved registers for this phrase.
 $78B8 LD A,(IX+$01) ; Read byte 1 of the other clause record.
 $78BB AND $7F       ; {OR it, with bit 7 clear, into the clause byte at offset
 $78BD OR (IY+$01)   ; 1.}
 $78C0 LD (IY+$01),A ; Update the clause byte at offset 1.
 $78C3 LD A,(IX+$00) ; Read byte 0 of the other clause record.
 $78C6 LD (IY+$00),A ; Update the clause byte at offset 0.
 $78C9 EXX           ; Switch to the saved registers for this phrase.
 $78CA LD A,(IY+$1C) ; Read byte +#N$1C from #REGiy.
 $78CD OR (IY+$1D)   ; {Return if bytes #N$1C and #N$1D are both zero.
 $78D0 RET Z         ; }
 $78D1 BIT 7,E       ; {Return if bit 7 of the grammar flag is clear.
 $78D3 RET Z         ; }
 $78D4 EXX           ; Switch to the saved registers for this phrase.
 $78D5 PUSH IY       ; {Step the pointer on by #N$12 bytes.
 $78D7 POP HL        ;
 $78D8 LD DE,$0012   ;
 $78DB ADD HL,DE     ; }
 $78DC PUSH HL       ; {Step the copy source back #N$0A bytes.
 $78DD LD DE,$FFF6   ; }
 $78E0 ADD HL,DE     ; Add #N$FFF6 to the token pointer.
 $78E1 POP DE        ; {Copy the prepared bytes.
 $78E2 LD BC,$0006   ;
 $78E5 LDIR          ; }
 $78E7 LD DE,$0004   ; The copy starts #N$04 bytes into the clause.
; This entry point is used by the routine at #R$75FA.
*$78EA CALL $78FF    ; Call #R$78FF to copy the ten grammar bytes.
 $78ED LD A,(IY+$02) ; Read the clause byte at offset 2.
 $78F0 OR (IY+$03)   ; {Call #R$7903 to copy two clause bytes when the next
 $78F3 LD DE,$0002   ; clause byte is zero.
 $78F6 CALL Z,$7903  ; }
 $78F9 EXX           ; Switch to the saved registers for this phrase.
 $78FA RET           ; Return.
 $78FB LD C,$06      ; Copy #N$06 bytes of the clause.
 $78FD JR $7905      ; Jump to #R$7905 to copy them.

; Inglish: Copy With A Count Of Ten
;
; Used by the routine at #R$78B7.
; .
; Sets the copy length to ten and joins the two-byte copy.
@label=Inglish_CopyWithACountOfTen
c$78FF LD C,$0A      ; Copy #N$0A bytes of the clause.
 $7901 JR $7905      ; Jump to #R$7905 to copy them.

; Inglish: Copy With A Count Of Two
;
; Used by the routine at #R$78B7.
; .
; Copies two bytes, then the prepared bytes, from the token pointer into the
; clause.
@label=Inglish_CopyWithACountOfTwo
c$7903 LD C,$02      ; Copy the two clause bytes.
; This entry point is used by the routines at #R$78B7 and #R$78FF.
@label=Inglish_CopyWithACountOfTwo_PointAtTheClause
*$7905 PUSH IY       ; {Point #REGhl at #REGiy plus the offset in #REGde.
 $7907 POP HL        ;
 $7908 ADD HL,DE     ; }
 $7909 PUSH HL       ; {Save that address and point #REGhl at #REGix plus the
 $790A PUSH IX       ; offset in #REGde.
 $790C POP HL        ;
 $790D ADD HL,DE     ; }
 $790E POP DE        ; {Copy the prepared bytes.
 $790F LD B,$00      ;
 $7911 LDIR          ; }
 $7913 RET           ; Return.

; Inglish: Store The Byte Pair
;
; Used by the routine at #R$7733.
; .
; Stores a pair of saved bytes at the token pointer and clears bit 1 of the
; flags.
@label=Inglish_StoreTheBytePair
c$7914 RES 1,E       ; Clear the flags so bit 1 is off.
 $7916 LD L,$00      ; The stored pair starts at zero.
; This entry point is used by the routines at #R$76F2 and #R$7733.
*$7918 PUSH DE       ; {Save the text pointer and take the parser pointer in
 $7919 PUSH IY       ; #REGde.
 $791B POP DE        ;
 $791C LD H,$00      ; }
 $791E ADD HL,DE     ; Add the parser pointer onto the offset in #REGl.
 $791F LD (HL),C     ; Store the saved byte in the token pointer.
 $7920 INC HL        ; Step to the next byte of the token pointer.
 $7921 LD (HL),B     ; Store the saved byte in the token pointer.
 $7922 POP DE        ; Restore #REGde from the stack.
 $7923 RET           ; Return.

; Inglish: Ask What
;
; Used by the routines at #R$77A2, #R$7809, #R$781C and #R$782B.
; .
; Prints "what ?" and sets the action countdown when the clause still has a conjunction.
; It returns at once when that count is already zero.
@label=Inglish_AskWhat
c$7924 CALL $75F1    ; Call #R$75F1 to test the conjunction count.
 $7927 RET NZ        ; {Return if a conjunction is still left, and otherwise
 $7928 POP HL        ; drop the return address.}
; This entry point is used by the routines at #R$76F2, #R$7733 and #R$82B3.
*$7929 CALL $75F1    ; Call #R$75F1 to test the conjunction count.
 $792C JP NZ,$75B4   ; Jump to #R$75B4 if a conjunction is still left.
; This entry point is used by the routines at #R$6CEC and #R$75FA.
*$792F LD HL,$AD9F   ; Point at the message "what ?[0x14]" (#R$AD9F).
 $7932 LD A,$01      ; {Write #N$01 (the countdown running) to *#R$B701.
 $7934 LD ($B701),A  ; }
 $7937 CALL $72DD    ; Call #R$72DD to print message.
 $793A OR $01        ; Clear the zero flag.
 $793C RET           ; Return.

; Grammar Workspace
;
; Slots the grammar fills while a clause is matched. #R$79A9 clears the first #N$11 bytes. Nothing executes these bytes. Read by #R$79A9, #R$79B6, #R$7A14, #R$7AA1, #R$7ABA, #R$7AD8, #R$7AF5, #R$7B9E, #R$7C23, #R$7CCB, #R$7CFC, #R$7D17, #R$7D54, #R$7D74 and #R$7E7C.
; Read by #R$7C23, #R$7CFC and #R$7D74.
b$793D DEFB $00                     ; First byte of the match buffer. #R$79A9
                                    ; blanks this and the next #N$10 bytes.
 $793E DEFB $00                     ; Second byte of the match buffer.
 $793F DEFB $00                     ; Third byte of the match buffer. The
                                    ; matcher tests it for zero.
 $7940 DEFB $00                     ; Grammar marker. Compared with #N$01 while
                                    ; a clause is scored.
 $7941 DEFB $00                     ; Second grammar marker, tested beside
                                    ; #R$7940.
 $7942 DEFB $00,$00,$00,$00,$00,$00 ; First copy window. The front word is read
                                    ; with #R$7D86, and #R$7B19 points #REGde
                                    ; here.
 $7948 DEFB $00,$00,$00,$00,$00,$00 ; Second copy window. #R$7B26 points #REGde
                                    ; here and #R$7DB7 reads the first byte.
 $794E DEFB $00,$00                 ; Object pointer saved from #REGix.
 $7950 DEFB $00,$00                 ; Other object pointer saved from #REGix.
 $7952 DEFB $00                     ; Phrase byte copied into #R$B71C.
 $7953 DEFB $00                     ; Flag derived from the phrase byte.
 $7954 DEFB $00                     ; Grammar count. #R$7D83 reads it.
 $7955 DEFB $00                     ; Second grammar count. #R$7DB4 reads it.
 $7956 DEFB $00                     ; Copy of the grammar marker.
 $7957 DEFB $00                     ; Copy of the second grammar marker.
 $7958 DEFB $00,$00                 ; Text pointer saved from #REGhl.
 $795A DEFB $00,$00                 ; Text pointer swapped with #R$795C.
 $795C DEFB $00,$00                 ; The other pointer swapped with #R$795A.
 $795E DEFB $00,$00                 ; Action entry saved from #REGix at the end
                                    ; of a match.

; Inglish: Apply A Match
;
; Used by the routine at #R$6CEC.
; .
; Starts matching the current clause. Clears the phrase scratch byte and uses
; the parser workspace at #R$B9C8. A different replay path skips ahead to
; #R$7994.
@label=InglishApplyAMatch
c$7960 XOR A          ; {Clear *#R$B71C.
 $7961 LD ($B71C),A   ; }
 $7964 LD IY,$B9C8    ; {Jump to #R$7994 if the matcher path flag is not zero.
 $7968 LD HL,$B71A    ;
 $796B CP (HL)        ;
 $796C LD (HL),A      ;
 $796D JP NZ,$7994    ; }
@label=InglishApplyAMatch_ScoreTheCurrentAction
*$7970 CALL $79B6     ; Call #R$79B6 to score the current action.
 $7973 JR NZ,$797A    ; Jump to #R$797A if #R$79B6 returned with the zero flag
                      ; clear (an action was scored).
 $7975 XOR A          ; {Clear *#R$B705.
 $7976 LD ($B705),A   ; }
 $7979 RET            ; Return.
@label=InglishApplyAMatch_RunTheAction
*$797A CALL $7AED     ; Call #R$7AED to run the action and see whether its
                      ; message was held back.
 $797D JP Z,$7DF5     ; Jump to #R$7DF5 if #R$7AED did not hold the message
                      ; back.
 $7980 LD A,$01       ; {Write #N$01 (the gate shut) to *#R$B6FA.
 $7982 LD ($B6FA),A   ; }
 $7985 CALL $712B     ; Call #R$712B to describe the action.
 $7988 CALL $950F     ; Call #R$950F to run the handler when one is present.
; This entry point is used by the routine at #R$7B9E.
@label=InglishApplyAMatch_GiveEveryOtherCharacterATurn
*$798B CALL $96B3     ; Call #R$96B3 to give every other character a turn.
; This entry point is used by the routine at #R$7D74.
; .
; Test the phrase scratch byte.
@label=InglishApplyAMatch_TestThePhraseScratchByte
*$798E LD A,($B71C)   ; {Jump to #R$7970 if *#R$B71C is not zero.
 $7991 AND A          ;
 $7992 JR NZ,$7970    ; }
; This entry point is used by the routine at #R$7D74.
@label=InglishApplyAMatch_UpdateTheReplayPath
*$7994 LD A,($B706)   ; Read *#R$B706.
 $7997 DEC A          ; Step the replay path down by one.
 $7998 LD ($B706),A   ; Update *#R$B706.
 $799B RET Z          ; Return if the replay path reached zero.
 $799C LD BC,$FFE8    ; Step back one clause record. Each record is #N$18
                      ; bytes.
@label=InglishApplyAMatch_SkipMarkedClause
*$799F ADD IY,BC      ; {Jump back to #R$799F if bit 6 of the clause byte at
 $79A1 BIT 6,(IY+$01) ; offset 1 is set.
 $79A5 JR NZ,$799F    ; }
 $79A7 JR $7970       ; Jump back to #R$7970 to run the grammar.

; Inglish: Clear The Match Buffer
;
; Used by the routines at #R$79B6 and #R$7AF5.
; .
; Clears the action countdown and blanks #N$11 bytes of the match buffer.
@label=Inglish_ClearTheMatchBuffer
c$79A9 XOR A         ; {Clear *#R$B701.
 $79AA LD ($B701),A  ; }
 $79AD LD HL,$793D   ; Point #REGhl at the match buffer.
 $79B0 LD B,$11      ; Count #N$11 passes.
; Fill the buffer at #REGhl.
 $79B2 CALL $70E2    ; Call #R$70E2 to fill a run of bytes.
 $79B5 RET           ; Return.

; Inglish: Score The Current Action
;
; Used by the routines at #R$7960 and #R$7F1A.
; .
; Scores the current action against the action table, stores the winning action and
; object, and clears the message gate.
;
; .
;
; Update the second object.
@label=Inglish_ScoreTheCurrentAction
c$79B6 LD A,$FF      ; {Write #N$FF to *#R$B6E9 and *#R$B6E8.
 $79B8 LD ($B6E9),A  ;
 $79BB LD ($B6E8),A  ; }
 $79BE CALL $79A9    ; Call #R$79A9 to clear the match buffer.
 $79C1 CALL $7B9E    ; Call #R$7B9E to save the clause window.
 $79C4 RET Z         ; Return if #R$7B9E found no match.
 $79C5 LD A,$01      ; The first action id is #N$01.
 $79C7 PUSH IX       ; {Turn the action-table pointer into an offset from
 $79C9 POP HL        ; #R$AB53.
 $79CA LD DE,$AB53   ;
 $79CD SBC HL,DE     ; }
 $79CF JR Z,$79D9    ; Jump to #R$79D9 if the pointer is the action table.
 $79D1 LD DE,$0008   ; Each action record is #N$08 bytes.
@label=Inglish_ScoreTheCurrentAction_CountOnFromOne
*$79D4 INC A         ; Count on from #N$01.
 $79D5 SBC HL,DE     ; Take #N$08 off the offset.
 $79D7 JR NZ,$79D4   ; Jump back to #R$79D4 until the offset is used up (each
                     ; #N$08 bytes is one more action id).
@label=Inglish_ScoreTheCurrentAction_UpdateCurrentAction
*$79D9 LD ($B6E7),A  ; Update *#R$B6E7.
 $79DC LD ($B6E6),A  ; Update *#R$B6E6.
 $79DF LD ($795E),IX ; Remember this record in the grammar object pointer.
 $79E3 CALL $7B78    ; Call #R$7B78 to split the clause flags.
 $79E6 CALL $7AA1    ; Call #R$7AA1 to note the first noun.
 $79E9 XOR A         ; {Clear *#R$B6FA.
 $79EA LD ($B6FA),A  ; }
 $79ED LD A,($B71D)  ; Read *#R$B71D.
 $79F0 AND $0C       ; {Jump to #R$7A11 when bits 2 and 3 of the phrase scratch
 $79F2 JR Z,$7A11    ; are clear.}
 $79F4 LD A,($7952)  ; Read the saved phrase byte.
 $79F7 LD ($B71C),A  ; Update *#R$B71C.
 $79FA RLCA          ; Expose the high bit of the saved phrase byte.
 $79FB AND $01       ; Keep only bit 0.
 $79FD LD ($7953),A  ; Update the phrase-byte flag.
@label=Inglish_ScoreTheCurrentAction_ResolveTheFirstNoun
*$7A00 CALL $7A14    ; Call #R$7A14 to resolve the first noun.
 $7A03 JP NZ,$7DBC   ; Jump to #R$7DBC if #R$7A14 returned with the zero flag
                     ; clear (a grammar marker was not #N$01).
; Test the phrase scratch byte.
 $7A06 LD A,($B71C)  ; {Jump to #R$7A11 if *#R$B71C is zero.
 $7A09 AND A         ;
 $7A0A JR Z,$7A11    ; }
 $7A0C CALL $7A73    ; Call #R$7A73 to search the previous slot.
 $7A0F JR NZ,$7A00   ; Jump back to #R$7A00 if #R$7A73 found the current object
                     ; in the previous parser record.
@label=Inglish_ScoreTheCurrentAction_ClearTheZeroFlag
*$7A11 OR $01        ; Clear the zero flag.
 $7A13 RET           ; Return.

; Inglish: Resolve The First Noun
;
; Used by the routines at #R$79B6 and #R$7AF5.
; .
; Resolves the first noun of the clause into the current object, or counts another try in
; the third match buffer.
@label=Inglish_ResolveTheFirstNoun
c$7A14 CALL $7CCB    ; Call #R$7CCB to find the first noun.
 $7A17 JR NZ,$7A2E   ; Jump to #R$7A2E if #R$7CCB returned an object.
 $7A19 LD A,($7940)  ; {Return if the grammar marker is not #N$01.
 $7A1C CP $01        ;
 $7A1E RET NZ        ; }
 $7A1F LD A,($7956)  ; Read the copied grammar marker.
 $7A22 LD ($B6E8),A  ; Update *#R$B6E8.
 $7A25 CALL $7ABA    ; Call #R$7ABA to note the second noun.
 $7A28 CALL $7AD8    ; Call #R$7AD8 to test the scratch bits.
 $7A2B JR NZ,$7A55   ; Jump to #R$7A55 if #R$7AD8 returned with the zero flag
                     ; clear.
 $7A2D RET           ; Return.
@label=Inglish_ResolveTheFirstNoun_CountTheThirdMatch
*$7A2E LD HL,$793F   ; Point #REGhl at the third match buffer.
 $7A31 INC (HL)      ; Count one more in the third match buffer.
 $7A32 CALL $7AD8    ; Call #R$7AD8 to test the scratch bits.
 $7A35 JR Z,$7A50    ; Jump to #R$7A50 if #R$7AD8 returned zero.
 $7A37 CALL $7ABA    ; Call #R$7ABA to note the second noun.
 $7A3A CALL $7D17    ; Call #R$7D17 to find the second noun.
@label=Inglish_ResolveTheFirstNoun_TestForASecondNoun
*$7A3D JR Z,$7A14    ; Jump back to #R$7A14 if #R$7D17 found no second noun
                     ; (#N$FF).
 $7A3F LD A,($7953)  ; {Return if the phrase-byte flag reached zero.
 $7A42 DEC A         ;
 $7A43 RET Z         ; }
 $7A44 LD A,($B6E8)  ; Read *#R$B6E8.
 $7A47 LD ($7956),A  ; Update the copied grammar marker.
 $7A4A LD HL,$7940   ; Point #REGhl at the grammar marker.
 $7A4D INC (HL)      ; Count one more in the grammar marker.
 $7A4E JR $7A14      ; Jump back to #R$7A14 to run the grammar.
@label=Inglish_ResolveTheFirstNoun_RunTheAction
*$7A50 CALL $7AED    ; Call #R$7AED to run the action and see whether its
                     ; message was held back.
 $7A53 JR $7A3D      ; Jump back to #R$7A3D to read the next word.
@label=Inglish_ResolveTheFirstNoun_FindTheSecondNoun
*$7A55 CALL $7D17    ; Call #R$7D17 to find the second noun.
 $7A58 JR NZ,$7A67   ; Jump to #R$7A67 if #R$7D17 found a second noun.
 $7A5A LD A,($7941)  ; {Return if the second grammar marker is not #N$01.
 $7A5D CP $01        ;
 $7A5F RET NZ        ; }
 $7A60 LD A,($7957)  ; Read the copied second marker.
 $7A63 LD ($B6E9),A  ; Update *#R$B6E9.
 $7A66 RET           ; Return.
@label=Inglish_ResolveTheFirstNoun_ReadTheSecondObject
*$7A67 LD A,($B6E9)  ; Read *#R$B6E9.
 $7A6A LD ($7957),A  ; Update the copied second marker.
 $7A6D LD HL,$7941   ; Point #REGhl at the second grammar marker.
 $7A70 INC (HL)      ; Count one more in the second grammar marker.
 $7A71 JR $7A55      ; Jump back to #R$7A55 to run the grammar.

; Inglish: Search The Previous Slot
;
; Used by the routine at #R$79B6.
; .
; Searches the previous parser slot for an object in the same place as the player whose id matches the current
; object, and sets that object when bit 6 of the clause byte is set.
@label=Inglish_SearchThePreviousSlot
c$7A73 PUSH IY        ; {Step back one #N$18-byte parser record.
 $7A75 PUSH DE        ;
 $7A76 PUSH HL        ;
@label=Inglish_SearchThePreviousSlot_StepBackOneRecord
*$7A77 LD DE,$FFE8    ; }
 $7A7A ADD IY,DE      ; {Jump to #R$7A9C if bit 6 of the clause byte at offset
 $7A7C BIT 6,(IY+$01) ; 1 is clear.
 $7A80 JR Z,$7A9C     ; }
 $7A82 LD IX,$C060    ; Start the object search one slot before #R$C063.
@label=Inglish_SearchThePreviousSlot_TestTheNextObject
*$7A86 PUSH IY        ; {Use the parser workspace from here on.
 $7A88 POP HL         ; }
 $7A89 LD DE,$0008    ; {Step the pointer on by #N$08 bytes.
 $7A8C ADD HL,DE      ; }
 $7A8D CALL $9DD9     ; Call #R$9DD9 to test whether the object is in the same
                      ; place as the player.
 $7A90 CP $FF         ; {Jump back to #R$7A77 if #R$9DD9 returned #N$FF.
 $7A92 JR Z,$7A77     ; }
 $7A94 LD HL,$B6E8    ; {Jump back to #R$7A86 unless the object #R$9DD9 found
 $7A97 CP (HL)        ; is the current object.
 $7A98 JR NZ,$7A86    ; }
 $7A9A OR $01         ; Clear the zero flag.
@label=Inglish_SearchThePreviousSlot_RestoreAndReturn
*$7A9C POP HL         ; {Restore #REGhl, #REGde and #REGiy from the stack.
 $7A9D POP DE         ;
 $7A9E POP IY         ; }
 $7AA0 RET            ; Return.

; Inglish: Note The First Noun
;
; Used by the routine at #R$79B6.
; .
; Notes the first noun in the saved object pointer when the phrase scratch byte is clear
; and the noun-print flag is set.
@label=Inglish_NoteTheFirstNoun
c$7AA1 LD A,($B71C)  ; Read *#R$B71C.
 $7AA4 AND A         ; {Return if the phrase scratch byte is not zero.
 $7AA5 RET NZ        ; }
; This entry point is used by the routine at #R$7AF5.
*$7AA6 LD A,($B71E)  ; Read *#R$B71E.
 $7AA9 RRCA          ; Expose the low bit of the clause being built.
 $7AAA RRCA          ; Expose the low bit of the clause being built.
 $7AAB CALL $7ACC    ; Call #R$7ACC to choose the object table.
 $7AAE LD A,($B6FE)  ; Read *#R$B6FE.
 $7AB1 AND A         ; {Call #R$9E95 if the noun-print flag is not zero.
 $7AB2 CALL NZ,$9E95 ; }
 $7AB5 LD ($794E),IX ; Remember this record in the saved object pointer.
 $7AB9 RET           ; Return.

; Inglish: Note The Second Noun
;
; Used by the routine at #R$7A14.
; .
; Notes the second noun in the other saved object pointer when the second-noun flag is
; set.
@label=Inglish_NoteTheSecondNoun
c$7ABA LD A,($B71E)  ; Read *#R$B71E.
 $7ABD CALL $7ACC    ; Call #R$7ACC to choose the object table.
 $7AC0 LD A,($B6FF)  ; Read *#R$B6FF.
 $7AC3 AND A         ; {Call #R$9E95 if the second-noun flag is not zero.
 $7AC4 CALL NZ,$9E95 ; }
 $7AC7 LD ($7950),IX ; Remember this record in the other saved object pointer.
 $7ACB RET           ; Return.

; Inglish: Choose The Object Table
;
; Used by the routines at #R$7AA1 and #R$7ABA.
; .
; Points the object search at the slot before the object table when the second-noun flag
; is set. Otherwise it returns at once.
@label=Inglish_ChooseTheObjectTable
c$7ACC LD IX,$C063   ; {Use the record at #N$C063 and return when the low two
 $7AD0 AND $03       ; bits of #REGa are clear.
 $7AD2 RET Z         ; }
 $7AD3 LD IX,$C060   ; Start the object search one slot before #R$C063.
 $7AD7 RET           ; Return.

; Inglish: Test The Scratch Bits
;
; Used by the routines at #R$7A14 and #R$7D74.
; .
; Tests bits 0, 1 and 2 of the phrase scratch byte and the second match buffer, and
; reports no match when bit 1 is set.
@label=Inglish_TestTheScratchBits
c$7AD8 LD A,($B71D)  ; Read *#R$B71D.
 $7ADB BIT 2,A       ; {Return if bit 2 of the phrase scratch byte is clear.
 $7ADD RET Z         ; }
 $7ADE LD HL,$793E   ; {Return if bit 0 of the second match buffer is set.
 $7AE1 BIT 0,(HL)    ;
 $7AE3 RET NZ        ; }
 $7AE4 BIT 1,A       ; {Jump to #R$7AEB if bit 1 of the phrase scratch byte is
 $7AE6 JR NZ,$7AEB   ; set.}
 $7AE8 OR $01        ; Clear the zero flag.
 $7AEA RET           ; Return.
@label=Inglish_TestTheScratchBits_ReturnZero
*$7AEB XOR A         ; Return zero from the scratch-bit test.
 $7AEC RET           ; Return.

; Inglish: Ask Whether To Suppress
;
; Used by the routines at #R$7960, #R$7A14, #R$7D54 and #R$7F1A.
; .
; Runs the action handler if one is present and returns whether the message-suppressed flag is
; zero, which suppresses the sentence.
@label=Inglish_AskWhetherToSuppress
c$7AED CALL $950F    ; Call #R$950F to run the handler when one is present.
 $7AF0 LD A,($B6FB)  ; Read the message-suppressed flag.
 $7AF3 AND A         ; Return with the zero flag set when no message was held
                     ; back.
 $7AF4 RET           ; Return.

; Inglish: Build The Action Sentence
;
; Used by the routine at #R$99C6.
; .
; Builds the action sentence from the saved object pointer, the current action and both
; nouns, copying each name into the clause.
@label=Inglish_BuildTheActionSentence
c$7AF5 PUSH HL       ; {Save #REGhl, #REGiy, #REGix, #REGde and #REGbc, then
 $7AF6 PUSH IY       ; read the object pointer at #R$794E.
 $7AF8 PUSH IX       ;
 $7AFA PUSH DE       ;
 $7AFB PUSH BC       ;
 $7AFC LD HL,($794E) ; }
 $7AFF PUSH HL       ; {Read *#R$B6E7.
 $7B00 LD A,($B6E7)  ; }
 $7B03 CALL $70E8    ; Call #R$70E8 to index action.
 $7B06 PUSH HL       ; {Point #REGix at the action entry #R$70E8 returned.
 $7B07 POP IX        ; }
 $7B09 CALL $79A9    ; Call #R$79A9 to clear the match buffer.
 $7B0C CALL $70F3    ; Call #R$70F3 to pack this action entry's token classes
                     ; into the clause.
 $7B0F CALL $7B78    ; Call #R$7B78 to split the clause flags.
 $7B12 LD A,($B6E8)  ; Read *#R$B6E8.
 $7B15 LD B,A        ; Copy the result into #REGb.
 $7B16 LD A,($B6FE)  ; Read *#R$B6FE.
 $7B19 LD DE,$7942   ; Point #REGde at the first copy window.
 $7B1C CALL $7B63    ; Call #R$7B63 to copy a name into the clause.
 $7B1F LD A,($B6E9)  ; Read *#R$B6E9.
 $7B22 LD B,A        ; Copy the result into #REGb.
 $7B23 LD A,($B6FF)  ; Read *#R$B6FF.
 $7B26 LD DE,$7948   ; Point #REGde at the second copy window.
 $7B29 CALL $7B63    ; Call #R$7B63 to copy a name into the clause.
 $7B2C CALL $7AA6    ; Call #R$7AA6 to note the first noun.
 $7B2F XOR A         ; {Clear *#R$B6FA.
 $7B30 LD ($B6FA),A  ; }
 $7B33 LD A,($B71D)  ; Read *#R$B71D.
 $7B36 AND $0C       ; {Jump to #R$7B43 if either bit 2 or bit 3 of the phrase
 $7B38 JR NZ,$7B43   ; scratch is set.}
 $7B3A CALL $950F    ; Call #R$950F to run the handler when one is present.
 $7B3D LD A,($B6FB)  ; Read the message-suppressed flag.
 $7B40 AND A         ; See whether the message-suppressed flag is zero.
 $7B41 JR $7B52      ; Jump to #R$7B52 to update the message gate.
@label=Inglish_BuildTheActionSentence_SetThePhraseFlag
*$7B43 LD A,$01      ; {Set the phrase flag at #R$7953.
 $7B45 LD ($7953),A  ; }
 $7B48 CALL $7A14    ; Call #R$7A14 to resolve the first noun.
 $7B4B JR Z,$7B50    ; Jump to #R$7B50 if #R$7A14 returned with the zero flag
                     ; set.
 $7B4D XOR A         ; Take the zero path, which still opens the message gate.
 $7B4E JR $7B52      ; Jump to #R$7B52 to update the message gate.
@label=Inglish_BuildTheActionSentence_ClearTheZeroFlag
*$7B50 OR $01        ; Clear the zero flag.
@label=Inglish_BuildTheActionSentence_ShutTheMessageGate
*$7B52 LD A,$01      ; {Write #N$01 (the gate shut) to *#R$B6FA.
 $7B54 LD ($B6FA),A  ; }
 $7B57 POP HL        ; {Remember the pointer in the saved object pointer.
 $7B58 LD ($794E),HL ; }
 $7B5B POP BC        ; {Restore #REGbc, #REGde, #REGix, #REGiy and #REGhl from
 $7B5C POP DE        ; the stack.
 $7B5D POP IX        ;
 $7B5F POP IY        ;
 $7B61 POP HL        ; }
 $7B62 RET           ; Return.

; Inglish: Copy A Name Into The Clause
;
; Used by the routine at #R$7AF5.
; .
; Copies an object's name, or a location's name, into the clause. An id of #N$FF returns
; at once.
@label=Inglish_CopyANameIntoTheClause
c$7B63 INC B         ; {Return if there is no object (#REGb is #N$FF).
 $7B64 RET Z         ; }
 $7B65 DEC B         ; {Jump to #R$7B6F to name an object when the noun-type
 $7B66 AND A         ; flag in #REGa is zero; otherwise name a location.
 $7B67 LD A,B        ;
 $7B68 JR Z,$7B6F    ; }
 $7B6A CALL $71D5    ; Call #R$71D5 to address past the location.
 $7B6D JR $7B72      ; Jump to #R$7B72 to copy the six name bytes.
@label=Inglish_CopyANameIntoTheClause_AddressTheName
*$7B6F CALL $71E2    ; Call #R$71E2 to address the object name.
@label=Inglish_CopyANameIntoTheClause_CopyTheName
*$7B72 LD BC,$0006   ; {Copy the prepared bytes.
 $7B75 LDIR          ; }
 $7B77 RET           ; Return.

; Inglish: Split The Clause Flags
;
; Used by the routines at #R$79B6 and #R$7AF5.
; .
; Splits the clause flags into the noun-print flag, the second-noun flag and the bytes
; kept for the match.
@label=Inglish_SplitTheClauseFlags
c$7B78 LD A,($B71E)  ; Read *#R$B71E.
 $7B7B AND $40       ; Keep only bit 6.
 $7B7D LD ($B711),A  ; Store the result at #R$B711.
 $7B80 LD A,($B71D)  ; Read *#R$B71D.
 $7B83 LD B,A        ; Copy the result into #REGb.
 $7B84 AND $01       ; Keep only bit 0.
 $7B86 LD ($B70F),A  ; Store the result at #R$B70F.
 $7B89 LD A,B        ; Use the phrase scratch byte again.
 $7B8A AND $80       ; Keep only bit 7.
 $7B8C JR Z,$7B90    ; Jump to #R$7B90 if bit 7 of the phrase scratch byte is
                     ; clear.
 $7B8E LD A,$01      ; Set the noun-print flag.
@label=Inglish_SplitTheClauseFlags_StoreTheNounPrintFlag
*$7B90 LD ($B6FE),A  ; Update *#R$B6FE.
 $7B93 LD A,B        ; Use the phrase scratch byte again.
 $7B94 AND $40       ; Keep only bit 6.
 $7B96 JR Z,$7B9A    ; Jump to #R$7B9A if bit 6 of the phrase scratch byte is
                     ; clear.
 $7B98 LD A,$01      ; Set the second-noun flag.
@label=Inglish_SplitTheClauseFlags_StoreTheSecondNounFlag
*$7B9A LD ($B6FF),A  ; Update *#R$B6FF.
 $7B9D RET           ; Return.

; Inglish: Save The Clause Window
;
; Used by the routine at #R$79B6.
; .
; Saves the clause window: the object's id and location, then copies the clause pairs into
; the match buffers.
@label=Inglish_SaveTheClauseWindow
c$7B9E PUSH IY       ; {Read the low byte of the pointer in the clause.
 $7BA0 LD L,(IY+$00) ; }
 $7BA3 LD H,(IY+$01) ; Read the high byte of the pointer in the clause.
 $7BA6 LD A,H        ; Use the clause byte at offset 1 again.
 $7BA7 AND $80       ; Keep only bit 7.
 $7BA9 LD ($7952),A  ; Update the saved phrase byte.
 $7BAC RES 7,H       ; Clear bit 7 of the pointer's high byte.
 $7BAE LD ($7958),HL ; Remember the pointer in the saved text pointer.
 $7BB1 LD HL,$795A   ; Point #REGhl at the swapped text pointer.
 $7BB4 PUSH HL       ; {Count #N$04 passes.
 $7BB5 LD B,$04      ; }
; Fill the buffer at #REGhl.
 $7BB7 CALL $70E2    ; Call #R$70E2 to fill a run of bytes.
 $7BBA POP HL        ; {Count #N$02 passes.
 $7BBB LD B,$02      ; }
 $7BBD LD E,$04      ; Save the clause bytes at offset #N$04.
 $7BBF CALL $7CAC    ; Call #R$7CAC to copy one clause pair.
 $7BC2 LD E,$0E      ; Save the clause bytes at offset #N$0E.
 $7BC4 CALL $7CAC    ; Call #R$7CAC to copy one clause pair.
 $7BC7 LD E,$06      ; Save the clause bytes at offset #N$06.
 $7BC9 CALL $7CAC    ; Call #R$7CAC to copy one clause pair.
 $7BCC LD E,$10      ; Save the clause bytes at offset #N$10.
 $7BCE CALL $7CAC    ; Call #R$7CAC to copy one clause pair.
 $7BD1 XOR A         ; {Clear *#R$B6DF.
 $7BD2 LD ($B6DF),A  ; }
 $7BD5 LD HL,$7958   ; Point #REGhl at the saved text pointer.
 $7BD8 LD DE,$0008   ; Each action record is #N$08 bytes.
 $7BDB LD IX,$AB53   ; Point #REGix at the action table.
@label=Inglish_SaveTheClauseWindow_UseTheActionTable
*$7BDF PUSH IX       ; {Use the action table as the parser pointer.
 $7BE1 POP IY        ; }
 $7BE3 CALL $71F3    ; Call #R$71F3 to match clause pairs.
 $7BE6 JR Z,$7C1B    ; Jump to #R$7C1B if #R$71F3 returned zero.
 $7BE8 ADD IX,DE     ; Add #N($0008,$04,$04) onto the action table.
 $7BEA LD A,(IX+$01) ; Read the high byte of this action's token.
 $7BED OR (IX+$00)   ; {Jump back to #R$7BDF if this action's token is not
 $7BF0 JR NZ,$7BDF   ; zero.}
 $7BF2 POP IY        ; Restore the clause pointer from the stack.
; Test the low half of the class being matched.
 $7BF4 LD A,($B6DF)  ; {Jump to #R$7EA8 if *#R$B6DF is not zero.
 $7BF7 AND A         ;
 $7BF8 JP NZ,$7EA8   ; }
 $7BFB LD HL,($7958) ; Read the pointer stored in the saved text pointer.
 $7BFE PUSH HL       ; {Point #REGhl at "[0x0d] You[0x01].[0x0d] Time passes.".
 $7BFF LD HL,$ADA3   ; }
 $7C02 XOR A         ; {Clear *#R$B701.
 $7C03 LD ($B701),A  ; }
 $7C06 LD ($B71C),A  ; Update *#R$B71C.
 $7C09 LD A,$01      ; {Write #N$01 (the gate shut) to *#R$B6FA.
 $7C0B LD ($B6FA),A  ; }
 $7C0E CALL $72D3    ; Call #R$72D3 to open the message gate for a conjunction.
 $7C11 LD A,($B71B)  ; Read *#R$B71B.
 $7C14 DEC A         ; {Return if the conjunction count reached zero.
 $7C15 RET Z         ; }
 $7C16 POP HL        ; {Jump back to #R$798B to advance the other characters.
 $7C17 POP HL        ;
 $7C18 JP $798B      ; }
@label=Inglish_SaveTheClauseWindow_ScoreTheSwappedClause
*$7C1B POP IY        ; {Restore the clause pointer from the stack and call
 $7C1D CALL $7C23    ; #R$7C23 to score the swapped clause.}
 $7C20 OR $01        ; Clear the zero flag.
 $7C22 RET           ; Return.

; Inglish: Score The Swapped Clause
;
; Used by the routine at #R$7B9E.
; .
; Swaps the two clause pointers when the conjunction count is odd, then scores that clause
; against the action table.
@label=Inglish_ScoreTheSwappedClause
c$7C23 AND A         ; {Jump to #R$7C34 if the match result is zero.
 $7C24 JR Z,$7C34    ; }
 $7C26 LD HL,($795A) ; Read the pointer stored in the swapped text pointer.
 $7C29 LD DE,($795C) ; Read the pointer stored in the other swapped pointer.
 $7C2D LD ($795A),DE ; Remember the pointer in the swapped text pointer.
 $7C31 LD ($795C),HL ; Remember the pointer in the other swapped pointer.
@label=Inglish_ScoreTheSwappedClause_PackTheTokenClasses
*$7C34 CALL $70F3    ; Call #R$70F3 to pack this action entry's token classes
                     ; into the clause.
 $7C37 LD HL,$795A   ; {Jump to #R$7C44 unless the phrase slot is empty.
 $7C3A LD A,(HL)     ;
 $7C3B INC HL        ;
 $7C3C OR (HL)       ;
 $7C3D JR NZ,$7C44   ; }
 $7C3F LD A,($B71E)  ; Read *#R$B71E.
 $7C42 JR $7C63      ; Jump to #R$7C63 because the phrase slot is empty.
@label=Inglish_ScoreTheSwappedClause_CompareClauseByte
*$7C44 DEC HL        ; {Jump to #R$7C53 if the swapped clause byte is not the
 $7C45 LD A,(HL)     ; clause byte at offset #N$0E.
 $7C46 CP (IY+$0E)   ;
 $7C49 JR NZ,$7C53   ; }
 $7C4B INC HL        ; {Jump to #R$7C5E if the swapped clause byte is the
 $7C4C LD A,(HL)     ; clause byte at offset #N$0F.
 $7C4D CP (IY+$0F)   ;
 $7C50 JR Z,$7C5E    ; }
 $7C52 DEC HL        ; Step back one byte through the swapped text pointer.
@label=Inglish_ScoreTheSwappedClause_CompareTheNextByte
*$7C53 LD A,(HL)     ; {Jump to #R$7C5E if the swapped clause byte is not the
 $7C54 CP (IY+$10)   ; clause byte at offset #N$10.
 $7C57 JR NZ,$7C5E   ; }
 $7C59 INC HL        ; Step to the next byte of the swapped text pointer.
 $7C5A LD A,(HL)     ; Read the swapped clause byte.
 $7C5B CP (IY+$11)   ; Compare the swapped clause byte with the clause byte at
                     ; offset #N$11.
@label=Inglish_ScoreTheSwappedClause_ReadTheScoreByte
*$7C5E LD A,($B71D)  ; Read *#R$B71D.
 $7C61 JR NZ,$7C65   ; Jump to #R$7C65 unless the swapped clause matched the
                     ; clause bytes at offsets #N$0E and #N$0F or at offsets
                     ; #N$10 and #N$11.
@label=Inglish_ScoreTheSwappedClause_FlipBitFive
*$7C63 XOR $20       ; Flip the bits selected by #N$20.
@label=Inglish_ScoreTheSwappedClause_TestTheScoreBit
*$7C65 BIT 5,A       ; {Jump to #R$7C6F if bit 5 of the phrase scratch byte is
 $7C67 LD BC,$1208   ; clear.
 $7C6A JR Z,$7C6F    ; }
 $7C6C LD BC,$0812   ; Store the swapped score bytes #N$08 and #N$12.
@label=Inglish_ScoreTheSwappedClause_StoreGrammarCount
*$7C6F LD HL,$7954   ; Point #REGhl at the grammar count.
 $7C72 LD (HL),B     ; Store the saved byte in the grammar count.
 $7C73 INC HL        ; Step to the next byte of the grammar count.
 $7C74 LD (HL),C     ; Store the saved byte in the grammar count.
 $7C75 LD A,B        ; Take the first score byte into #REGa.
 $7C76 LD DE,$7942   ; Point #REGde at the first copy window.
 $7C79 LD HL,$793D   ; Point #REGhl at the match buffer.
 $7C7C CALL $7C91    ; Call #R$7C91 to score the swapped clause.
 $7C7F LD A,C        ; {Copy #N$06 bytes from the first copy window to #R$B6E0.
 $7C80 LD HL,$7942   ;
 $7C83 LD DE,$B6E0   ;
 $7C86 LD BC,$0006   ;
 $7C89 LDIR          ; }
 $7C8B LD DE,$7948   ; Point #REGde at the second copy window.
 $7C8E LD HL,$793E   ; Point #REGhl at the second match buffer.
*$7C91 PUSH BC       ; {Save #REGbc and keep #REGa in #REGc.
 $7C92 LD C,A        ; }
 $7C93 LD B,$00      ; Start the character count at zero.
 $7C95 PUSH HL       ; {Add #N($0006,$04,$04) to the second match buffer.
 $7C96 PUSH IY       ;
 $7C98 POP HL        ;
 $7C99 ADD HL,BC     ; }
 $7C9A LD BC,$0006   ; {Copy the prepared bytes.
 $7C9D LDIR          ; }
 $7C9F XOR A         ; Start the six-byte zero test with A clear.
 $7CA0 LD B,$06      ; Count #N$06 passes.
@label=Inglish_ScoreTheSwappedClause_TestTheMatchBytes
*$7CA2 DEC HL        ; Step back one byte through the second match buffer.
 $7CA3 OR (HL)       ; Fold this byte into the test. All six bytes are zero
                     ; when Z stays set.
 $7CA4 DJNZ $7CA2    ; Loop back to #R$7CA2 until #N$06 runs out.
 $7CA6 POP HL        ; {Return if the six copied bytes are all zero.
 $7CA7 POP BC        ;
 $7CA8 RET Z         ; }
 $7CA9 SET 0,(HL)    ; Mark the second match buffer so bit 0 is on.
 $7CAB RET           ; Return.

; Inglish: Copy One Clause Pair
;
; Used by the routine at #R$7B9E.
; .
; Copies one id-and-location pair from the object into the second match buffer, and stops
; when #N$06 or the clause bits say so.
@label=Inglish_CopyOneClausePair
c$7CAC XOR A         ; {Return when the count in #REGb is zero.
 $7CAD CP B          ;
 $7CAE RET Z         ; }
 $7CAF LD D,$00      ; The clause offset's high byte is zero.
 $7CB1 PUSH IY       ; {Add the second copy window onto the parser workspace.
 $7CB3 ADD IY,DE     ; }
 $7CB5 LD A,(IY+$00) ; Read the clause byte at this offset.
 $7CB8 LD (HL),A     ; {Store it in the second match buffer and step on.
 $7CB9 INC HL        ; }
 $7CBA LD A,(IY+$01) ; Read the next clause byte.
 $7CBD LD (HL),A     ; Store it in the second match buffer.
 $7CBE DEC HL        ; Step back one byte through the second match buffer.
 $7CBF OR (IY+$00)   ; OR it with the clause byte just read.
 $7CC2 POP IY        ; {Return if both clause bytes are zero.
 $7CC4 RET Z         ; }
 $7CC5 DEC B         ; Drop one from the character count.
 $7CC6 INC HL        ; {Step on through the second match buffer.
 $7CC7 INC HL        ; }
 $7CC8 RET           ; Return.

; Inglish: Jump To The Clause Handler
;
; Used by the routines at #R$7CFC and #R$7D54.
; .
; Jumps to the handler the clause selected.
@label=Inglish_JumpToTheClauseHandler
c$7CC9 JP (IY)       ; Jump to the handler this clause selected.

; Inglish: Find The First Noun
;
; Used by the routine at #R$7A14.
; .
; Finds the first noun. When the noun-print flag at #R$B6FE is #N$01 it uses the place-by-exit test at
; #R$9EA0; otherwise it uses the object test at #R$9DD9, which looks in the same place as the player. The record
; found is kept in the saved object pointer at #R$794E.
@label=Inglish_FindTheFirstNoun
c$7CCB PUSH IY       ; {Use the saved object pointer as the record being
 $7CCD LD IX,($794E) ; walked.}
 $7CD1 LD A,($B6FE)  ; Read *#R$B6FE.
 $7CD4 DEC A         ; {Jump to #R$7CF1 if the noun-print flag is #N$01.
 $7CD5 JR Z,$7CF1    ; }
 $7CD7 LD IY,$9DD9   ; Point #REGiy at #R$9DD9 to use as the noun test.
 $7CDB LD A,($B71E)  ; Read *#R$B71E.
 $7CDE RRCA          ; {Keep the low two bits of the clause marker.
 $7CDF RRCA          ;
 $7CE0 AND $03       ; }
 $7CE2 LD ($B710),A  ; Update *#R$B710.
 $7CE5 CALL $7CFC    ; Call #R$7CFC to run the first noun test.
 $7CE8 CP $FF        ; Compare the result of the noun test with #N$FF.
@label=Inglish_FindTheFirstNoun_SaveTheObjectRecord
*$7CEA LD ($794E),IX ; Remember this record in the saved object pointer.
 $7CEE POP IY        ; Restore #REGiy from the stack.
 $7CF0 RET           ; Return.
@label=Inglish_FindTheFirstNoun_PointAtTheNounTest
*$7CF1 LD IY,$9EA0   ; Point #REGiy at #R$9EA0 to use as the noun test.
 $7CF5 CALL $7CFC    ; Call #R$7CFC to run the first noun test.
 $7CF8 CP $FF        ; Compare the clause marker with #N$FF.
 $7CFA JR $7CEA      ; Jump back to #R$7CEA to save this object record.

; Inglish: Run The First Noun Test
;
; Used by the routine at #R$7CCB.
; .
; Runs the first-noun test through the clause handler, stores the object, and runs the
; action handler until the message-suppressed flag is set.
@label=Inglish_RunTheFirstNounTest
c$7CFC LD HL,$7942   ; Point #REGhl at the first copy window.
 $7CFF CALL $7CC9    ; Call #R$7CC9 to jump to the clause handler.
 $7D02 CP $FF        ; {Return when the clause marker is #N$FF.
 $7D04 RET Z         ; }
 $7D05 LD ($B6E8),A  ; Update *#R$B6E8.
 $7D08 LD HL,$793D   ; Point #REGhl at the match buffer.
 $7D0B SET 1,(HL)    ; Mark the match buffer so bit 1 is on.
 $7D0D CALL $94D6    ; Call #R$94D6 to run the action handler.
; Test the message-suppressed flag.
 $7D10 LD A,($B6FB)  ; {Loop back to #R$7CFC to keep running the action while
 $7D13 AND A         ; the message-suppressed flag is clear.
 $7D14 JR Z,$7CFC    ; }
 $7D16 RET           ; Return.

; Inglish: Find The Second Noun
;
; Used by the routine at #R$7A14.
; .
; Finds the second noun the same way, storing it as the second object. When the second-noun flag at
; #R$B6FF is #N$01 it uses the place-by-exit test at #R$9EA0; otherwise it uses the object test at #R$9DD9.
; The record found is kept at #R$7950, and bit 0 of #R$B71D is copied to #R$B70F.
@label=Inglish_FindTheSecondNoun
c$7D17 XOR A         ; {Clear *#R$B70F.
 $7D18 LD ($B70F),A  ; }
 $7D1B PUSH IY       ; {Use the other saved object pointer as the record being
 $7D1D LD IX,($7950) ; walked.}
 $7D21 LD A,($B6FF)  ; Read *#R$B6FF.
 $7D24 DEC A         ; {Jump to #R$7D49 if the second-noun flag is #N$01.
 $7D25 JR Z,$7D49    ; }
 $7D27 LD IY,$9DD9   ; Point #REGiy at #R$9DD9 to use as the noun test.
 $7D2B LD A,($B71E)  ; Read *#R$B71E.
 $7D2E AND $03       ; {Store the low two bits of the clause being built in
 $7D30 LD ($B710),A  ; *#R$B710.}
 $7D33 CALL $7D54    ; Call #R$7D54 to run the second noun test.
 $7D36 CP $FF        ; Compare the result of the noun test with #N$FF.
@label=Inglish_FindTheSecondNoun_SaveTheSecondRecord
*$7D38 LD ($7950),IX ; Remember this record in the other saved object pointer.
 $7D3C POP IY        ; {Restore the parser pointer from the stack and read
 $7D3E PUSH AF       ; *#R$B71D.
 $7D3F LD A,($B71D)  ; }
 $7D42 AND $01       ; Keep only bit 0.
 $7D44 LD ($B70F),A  ; Store the result at #R$B70F.
 $7D47 POP AF        ; Restore #REGaf from the stack.
 $7D48 RET           ; Return.
@label=Inglish_FindTheSecondNoun_PointAtTheOtherNounTest
*$7D49 LD IY,$9EA0   ; Point #REGiy at #R$9EA0 to use as the noun test.
 $7D4D CALL $7D54    ; Call #R$7D54 to run the second noun test.
 $7D50 CP $FF        ; Compare the result of the noun test with #N$FF.
 $7D52 JR $7D38      ; Jump back to #R$7D38 to save the second object record.

; Inglish: Run The Second Noun Test
;
; Used by the routine at #R$7D17.
; .
; Runs the second-noun test, stores the second object, and asks whether the sentence
; should be suppressed.
@label=Inglish_RunTheSecondNounTest
c$7D54 LD HL,$7948   ; Point #REGhl at the second copy window.
 $7D57 CALL $7CC9    ; Call #R$7CC9 to jump to the clause handler.
 $7D5A CP $FF        ; {Return if the noun test returned #N$FF.
 $7D5C RET Z         ; }
 $7D5D LD ($B6E9),A  ; Update *#R$B6E9.
 $7D60 LD HL,$793E   ; Point #REGhl at the second match buffer.
 $7D63 SET 1,(HL)    ; Mark the second match buffer so bit 1 is on.
 $7D65 CALL $7AED    ; Call #R$7AED to run the action and see whether its
                     ; message was held back.
 $7D68 JR Z,$7D54    ; Jump back to #R$7D54 if no message was held back.
 $7D6A RET           ; Return.

; Inglish: Open The Message Gate
;
; Used by the routine at #R$7D74.
; .
; Opens the message gate and starts the action countdown, both set to #N$01.
;
; .
;
; Update the message gate.
@label=Inglish_OpenTheMessageGate
c$7D6B LD A,$01      ; {Write #N$01 to *#R$B6FA and *#R$B701.
 $7D6D LD ($B6FA),A  ;
 $7D70 LD ($B701),A  ; }
 $7D73 RET           ; Return.

; Inglish: Copy The Parser Slot
;
; Copies the parser slot into the clause. If the grammar count still needs a noun, it
; prints "which?" and reports no match.
@label=Inglish_CopyTheParserSlot
c$7D74 LD ($B71A),A  ; Update *#R$B71A.
 $7D77 PUSH IY       ; {Copy the parser slot at #REGiy into #R$B9C8.
 $7D79 POP HL        ;
 $7D7A LD DE,$B9C8   ;
 $7D7D LD BC,$0018   ;
 $7D80 LDIR          ; }
 $7D82 RET           ; Return.
@label=Inglish_CopyTheParserSlot_ReadTheGrammarCount
*$7D83 LD A,($7954)  ; Read the grammar count.
 $7D86 LD HL,($7942) ; Read the pointer stored in the first copy window.
@label=Inglish_CopyTheParserSlot_CopyIntoTheClause
*$7D89 PUSH HL       ; {Call #R$7D74 to copy the parser slot into the clause.
 $7D8A CALL $7D74    ; }
 $7D8D LD HL,$ADCC   ; Point #REGhl at "which[0x01] ?".
; This entry point is used by the routine at #R$7E7C.
@label=Inglish_CopyTheParserSlot_OpenTheMessageGate
*$7D90 CALL $7D6B    ; Call #R$7D6B to open the message gate.
 $7D93 CALL $72D3    ; Call #R$72D3 to open the message gate for a conjunction.
 $7D96 XOR A         ; Return zero from the parser-slot copy.
 $7D97 RET           ; Return.
@label=Inglish_CopyTheParserSlot_TestTheSecondMatch
*$7D98 LD HL,$793E   ; {Jump to #R$7E4D if bit 0 of the second match buffer is
 $7D9B BIT 0,(HL)    ; clear.
 $7D9D JP Z,$7E4D    ; }
 $7DA0 BIT 1,(HL)    ; See whether bit 1 of the second match buffer is set.
 $7DA2 LD HL,$7948   ; {Jump to #R$7DFE if bit 1 of the second match buffer is
 $7DA5 LD DE,$B6E9   ; clear.
 $7DA8 LD BC,$B6FF   ;
 $7DAB JR Z,$7DFE    ; }
; Test this flag.
 $7DAD LD A,($7941)  ; {Jump to #R$7DF5 if *#R$7941 is zero.
 $7DB0 AND A         ;
 $7DB1 JP Z,$7DF5    ; }
 $7DB4 LD A,($7955)  ; Read the second grammar count.
 $7DB7 LD A,($7948)  ; Read the second copy window.
 $7DBA JR $7D89      ; Jump to #R$7D89 to copy the slot and print the question.
; This entry point is used by the routine at #R$79B6.
@label=Inglish_CopyTheParserSlot_ReadTheConjunctionCount
*$7DBC LD A,($B71B)  ; Read *#R$B71B.
 $7DBF DEC A         ; {Return if the conjunction count reached zero.
 $7DC0 RET Z         ; }
; Test the phrase scratch byte.
 $7DC1 LD A,($B71C)  ; {Jump to #R$7DCB if *#R$B71C is zero.
 $7DC4 AND A         ;
 $7DC5 JR Z,$7DCB    ; }
 $7DC7 POP HL        ; {Jump back to #R$7994 to update the replay path.
 $7DC8 JP $7994      ; }
; Test the flag.
@label=Inglish_CopyTheParserSlot_TestTheGrammarMarker
*$7DCB LD A,($7940)  ; {Jump to #R$7D98 if *#R$7940 is #N$01.
 $7DCE CP $01        ;
 $7DD0 JR Z,$7D98    ; }
 $7DD2 LD HL,$793D   ; {Jump to #R$7E30 if bit 0 of the match buffer is clear.
 $7DD5 BIT 0,(HL)    ;
 $7DD7 JP Z,$7E30    ; }
 $7DDA BIT 1,(HL)    ; See whether bit 1 of the match buffer is set.
 $7DDC LD HL,$7942   ; {Jump to #R$7DFE if bit 1 of the match buffer is clear.
 $7DDF LD DE,$B6E8   ;
 $7DE2 LD BC,$B6FE   ;
 $7DE5 JR Z,$7DFE    ; }
; Test this flag.
 $7DE7 LD A,($793F)  ; {Jump to #R$7DF5 if *#R$793F is zero.
 $7DEA AND A         ;
 $7DEB JR Z,$7DF5    ; }
 $7DED DEC A         ; {Jump back to #R$7D83 if the third match buffer has not
 $7DEE JR NZ,$7D83   ; reached zero.}
 $7DF0 CALL $7AD8    ; Call #R$7AD8 to test the scratch bits.
 $7DF3 JR NZ,$7D98   ; Jump back to #R$7D98 unless #R$7AD8 returned with the
                     ; zero flag set.
; This entry point is used by the routine at #R$7960.
@label=Inglish_CopyTheParserSlot_DispatchTheAction
*$7DF5 CALL $7D6B    ; Call #R$7D6B to open the message gate.
 $7DF8 CALL $950F    ; Call #R$950F to run the handler when one is present.
 $7DFB JP $798E      ; Jump back to #R$798E to test the phrase scratch byte.
@label=Inglish_CopyTheParserSlot_PointAtTheExitList
*$7DFE PUSH HL       ; {Call #R$9E95 to point #REGix at the exit list.
 $7DFF CALL $9E95    ; }
 $7E02 LD A,$01      ; {Write #N$01 to the flag at #REGbc: the noun-print flag
 $7E04 LD (BC),A     ; at #R$B6FE, or the second-noun flag at #R$B6FF when
                     ; reached from #R$7DA2.}
 $7E05 CALL $9EA0    ; Call #R$9EA0 to find the exit to the place named.
 $7E08 CP $FF        ; {Jump to #R$7E20 if #R$9EA0 did not return #N$FF.
 $7E0A JR NZ,$7E20   ; }
 $7E0C POP HL        ; {Write #N$02 to *#R$B710.
 $7E0D LD A,$02      ;
 $7E0F LD ($B710),A  ; }
 $7E12 LD IX,$C060   ; Start the object search one slot before #R$C063.
 $7E16 XOR A         ; Put zero in #REGa.
 $7E17 LD (BC),A     ; Store it in the noun-print flag.
 $7E18 PUSH HL       ; {Save #REGhl and call #R$9DD9 to test whether the object
 $7E19 CALL $9DD9    ; at #R$B70C is here.}
 $7E1C CP $FF        ; {Jump to #R$7E25 if #R$9DD9 returned #N$FF.
 $7E1E JR Z,$7E25    ; }
@label=Inglish_CopyTheParserSlot_StoreTheObject
*$7E20 POP HL        ; {Store it in the current object.
 $7E21 LD (DE),A     ; }
 $7E22 JP $711A      ; Jump back to #R$711A to arm the message gate.
@label=Inglish_CopyTheParserSlot_SayItIsNotHere
*$7E25 CALL $7D6B    ; Call #R$7D6B to open the message gate.
 $7E28 LD HL,$ADD3   ; Point #REGhl at "i do not see[0x00] here[0x14]".
 $7E2B CALL $72D3    ; Call #R$72D3 to open the message gate for a conjunction.
 $7E2E XOR A         ; Return zero.
 $7E2F RET           ; Return.
@label=Inglish_CopyTheParserSlot_PlantJumpIfNotZero
*$7E30 CALL $7E7C    ; Call #R$7E7C to plant JR NZ and read the two fields.
 $7E33 LD HL,($7958) ; Read the pointer stored in the saved text pointer.
 $7E36 PUSH HL       ; {Point #REGhl at "[0x0b] D[0x01][0x01][0x14]".
 $7E37 LD HL,$ADE1   ; }
; Test this flag.
 $7E3A LD A,($7940)  ; {Jump to #R$7D90 if *#R$7940 is zero.
 $7E3D AND A         ;
 $7E3E JP Z,$7D90    ; }
 $7E41 LD A,($7954)  ; Read the grammar count.
 $7E44 CALL $7D74    ; Call #R$7D74 to copy the parser slot.
 $7E47 LD HL,$ADC4   ; Point #REGhl at the "what ?" prompt in #R$ADC0.
 $7E4A JP $7D90      ; Jump to #R$7D90 to open the message gate and print the
                     ; prompt.
@label=Inglish_CopyTheParserSlot_PlantJumpIfZero
*$7E4D CALL $7E78    ; Call #R$7E78 to plant JR Z and read the two fields.
 $7E50 LD HL,$0000   ; Start from a clear pointer.
 $7E53 PUSH HL       ; {Read *#R$B6E8.
 $7E54 LD A,($B6E8)  ; }
 $7E57 CALL $71E2    ; Call #R$71E2 to address the object name.
 $7E5A PUSH HL       ; {Call #R$7E7C to plant JR NZ and read the two fields.
 $7E5B CALL $7E7C    ; }
 $7E5E LD HL,($7958) ; Read the pointer stored in the saved text pointer.
 $7E61 PUSH HL       ; {Point #REGhl at "[0x0b]
 $7E62 LD HL,$ADE7   ; Eat[0x01][0x01][0x00][0x01][0x01][0x01][0x14]".}
; Test this flag.
 $7E65 LD A,($7941)  ; {Jump to #R$7D90 if *#R$7941 is zero.
 $7E68 AND A         ;
 $7E69 JP Z,$7D90    ; }
 $7E6C LD A,($7955)  ; Read the second grammar count.
 $7E6F CALL $7D74    ; Call #R$7D74 to copy the parser slot.
 $7E72 LD HL,$ADC0   ; Point #REGhl at the "what ?" prompt in #R$ADC0.
 $7E75 JP $7D90      ; Jump to #R$7D90 to open the message gate and print the
                     ; prompt.

; Inglish: Plant JR Z
;
; Used by the routine at #R$7D74.
; .
; Plants the JR Z opcode at #R$7E92 and #R$7EA1, then reads two words from the
; action entry. Each word is kept when its bit is clear.
@label=Inglish_PlantJumpRelativeIfZero
c$7E78 LD A,$28      ; Take the JR Z opcode.
 $7E7A JR $7E7E      ; Jump to #R$7E7E to plant that opcode.

; Inglish: Plant JR NZ
;
; Used by the routine at #R$7D74.
; .
; Plants the JR NZ opcode at #R$7E92 and #R$7EA1, then reads two words from the
; action entry. Each word is kept when its bit is set.
@label=Inglish_PlantJumpRelativeIfNonZero
c$7E7C LD A,$20       ; Take the JR NZ opcode.
; This entry point is used by the routine at #R$7E78.
@label=Inglish_PlantJumpRelativeIfNonZero_PlantTheOpcode
*$7E7E LD ($7E92),A   ; Plant the opcode at #R$7E92.
 $7E81 LD ($7EA1),A   ; Plant the same opcode at #R$7EA1.
 $7E84 LD IX,($795E)  ; Point #REGix at the action entry saved at #N$795E.
 $7E88 LD L,(IX+$04)  ; Read the low byte of the word at offset 4 of this
                      ; action.
 $7E8B LD H,(IX+$05)  ; Read the high byte of the word at offset 4 of this
                      ; action.
 $7E8E BIT 7,(IX+$07) ; {Test bit 7 of byte 7 of this action; the jump planted
 $7E92 JR NZ,$7E97    ; at #R$7E92 by #R$7E78 as JR Z or #R$7E7C as JR NZ goes
                      ; to #R$7E97.}
 $7E94 LD HL,$0000    ; Start from a clear pointer.
@label=Inglish_PlantJumpRelativeIfNonZero_ReadActionWord
*$7E97 EX (SP),HL     ; Swap #REGhl with the address on the stack.
 $7E98 PUSH HL        ; {Save the word just read, and read the low byte at
 $7E99 LD L,(IX+$02)  ; offset 2 of this action.}
 $7E9C LD H,(IX+$03)  ; Read the high byte at offset 2 of this action.
 $7E9F BIT 5,H        ; {Test bit 5 of that high byte; the jump planted at
 $7EA1 JR NZ,$7EA6    ; #R$7EA1 by #R$7E78 as JR Z or #R$7E7C as JR NZ goes to
                      ; #R$7EA6.}
 $7EA3 LD HL,$0000    ; Start from a clear pointer.
@label=Inglish_PlantJumpRelativeIfNonZero_CallTheHandler
*$7EA6 EX (SP),HL     ; Swap #REGhl with the address on the stack.
 $7EA7 JP (HL)        ; Jump to the action handler the caller addressed.
; This entry point is used by the routine at #R$7B9E.
@label=Inglish_PlantJumpRelativeIfNonZero_ReadThePointers
*$7EA8 LD HL,($795C)  ; Read the pointer stored in the other swapped pointer.
 $7EAB PUSH HL        ; {Read the pointer stored in the swapped text pointer.
 $7EAC LD HL,($795A)  ; }
 $7EAF PUSH HL        ; {Read the pointer stored in the saved text pointer.
 $7EB0 LD HL,($7958)  ; }
 $7EB3 PUSH HL        ; {Point #REGhl at "i do not know the verb".
 $7EB4 LD HL,$ADB0    ; }
 $7EB7 JP $7D90       ; Jump to #R$7D90 to open the message gate and print the
                      ; prompt.

; Inglish: Fill The Claimed Slots
;
; Used by the routine at #R$9034.
; .
; Gives the current object up to #REGa of the claimed character slots at #R$B738: it writes the
; object id into the first #REGa slots marked #N$FF (claimed by #R$834B), capping #REGa at the
; claimed-slot count in #R$B737, then frees the rest of the claimed slots by writing #N$00 to them.
@label=Inglish_FillTheClaimedSlots
c$7EBA PUSH BC         ; {Save #REGbc, #REGix and #REGde, and keep #REGa in
 $7EBB PUSH IX         ; #REGb.
 $7EBD PUSH DE         ;
 $7EBE LD B,A          ; }
 $7EBF LD A,($B737)    ; Read the slot count.
 $7EC2 LD C,A          ; {Jump to #R$7EC7 if the slot count is not below the
 $7EC3 CP B            ; count in #REGb.
 $7EC4 JR NC,$7EC7     ; }
 $7EC6 LD B,A          ; Cap the count at the slot count.
@label=Inglish_FillTheClaimedSlots_UseTheSlotCountAgain
*$7EC7 LD A,C          ; Use the slot count again.
 $7EC8 SUB B           ; Take the count in #REGb off the slot count, leaving
                       ; how many slots remain.
 $7EC9 LD C,A          ; Copy the result into #REGc.
 $7ECA LD IX,$B71F     ; Point #REGix one #N$19-byte slot before the first
                       ; character slot at #R$B738.
 $7ECE LD DE,$0019     ; Each slot is #N$19 bytes.
 $7ED1 XOR A           ; {Jump to #R$7EE6 if there are no slots to fill.
 $7ED2 CP B            ;
 $7ED3 JR Z,$7EE6      ; }
@label=Inglish_FillTheClaimedSlots_FindAClaimedSlot
*$7ED5 ADD IX,DE       ; Step #REGix on to the next #N$19-byte slot.
 $7ED7 LD A,(IX+$00)   ; Read the object id in this slot.
 $7EDA CP $FF          ; {Jump back to #R$7ED5 while this slot is not claimed
 $7EDC JR NZ,$7ED5     ; (not #N$FF).}
 $7EDE LD A,($B6E8)    ; Read *#R$B6E8.
 $7EE1 LD (IX+$00),A   ; Store the current object id in this slot.
 $7EE4 DJNZ $7ED5      ; Loop back to #R$7ED5 until #REGb slots are filled.
@label=Inglish_FillTheClaimedSlots_TestTheSlotCount
*$7EE6 LD B,C          ; {Jump to #R$7EFA if no slots remain.
 $7EE7 XOR A           ;
 $7EE8 CP B            ;
 $7EE9 JR Z,$7EFA      ; }
@label=Inglish_FillTheClaimedSlots_FreeTheRest
*$7EEB ADD IX,DE       ; Step #REGix on to the next #N$19-byte slot.
 $7EED LD A,(IX+$00)   ; Read the object id in this slot.
 $7EF0 CP $FF          ; {Jump back to #R$7EEB while this slot is not claimed
 $7EF2 JR NZ,$7EEB     ; (not #N$FF).}
 $7EF4 LD (IX+$00),$00 ; Mark this slot free with #N$00.
 $7EF8 DJNZ $7EEB      ; Loop back to #R$7EEB until the slot count runs out.
@label=Inglish_FillTheClaimedSlots_RestoreAndReturn
*$7EFA POP DE          ; {Restore #REGde, #REGix and #REGbc from the stack.
 $7EFB POP IX          ;
 $7EFD POP BC          ; }
 $7EFE RET             ; Return.

; Inglish: Find This Character's Slot
;
; Used by the routines at #R$7F10 and #R$7F1A.
; .
; Finds this character's slot among the eight slots at #R$B738. Each slot is #N$19 bytes,
; and the slot id is whose turn it is.
@label=Inglish_FindThisCharacterSlot
c$7EFF LD HL,$B738   ; Point at the first character slot at #R$B738.
 $7F02 LD DE,$0019   ; Each character slot at #R$B738 is #N$19 bytes.
 $7F05 LD A,($B6EA)  ; Read *#R$B6EA.
 $7F08 LD B,$08      ; Count #N$08 passes.
@label=Inglish_FindThisCharacterSlot_TestThisSlot
*$7F0A CP (HL)       ; {Return if the character whose turn it is is this
 $7F0B RET Z         ; character slot.}
 $7F0C ADD HL,DE     ; Step to the next #N$19-byte character slot.
 $7F0D DJNZ $7F0A    ; Loop back to #R$7F0A until #N$08 runs out.
 $7F0F RET           ; Return.

; Inglish: Keep The Character Slot
;
; Used by the routine at #R$97FF.
; .
; Finds this character's slot and returns.
; size.
@label=Inglish_KeepTheCharacterSlot
c$7F10 PUSH HL       ; {Call #R$7EFF to find this character's slot.
 $7F11 PUSH DE       ;
 $7F12 PUSH BC       ;
 $7F13 CALL $7EFF    ; }
 $7F16 POP BC        ; {Restore #REGbc, #REGde and #REGhl from the stack.
 $7F17 POP DE        ;
 $7F18 POP HL        ; }
 $7F19 RET           ; Return.

; Inglish: Save The Clause And Act
;
; Used by the routines at #R$97FF and #R$A86E.
; .
; Saves the clause and scores the action for this character. When it is not the player's
; turn the saved registers are returned.
@label=Inglish_SaveTheClauseAndAct
c$7F1A PUSH IX       ; {Save #REGix, #REGiy, #REGbc, #REGde and #REGhl, and
 $7F1C PUSH IY       ; keep #REGa in #REGc.
 $7F1E PUSH BC       ;
 $7F1F PUSH DE       ;
 $7F20 PUSH HL       ;
 $7F21 LD C,A        ; }
 $7F22 CALL $7EFF    ; Call #R$7EFF to find this character's slot.
 $7F25 LD (HL),$00   ; Clear it.
 $7F27 INC HL        ; {Jump to #R$7F37 if the character whose turn it is is
 $7F28 XOR A         ; not zero.
 $7F29 CP C          ;
 $7F2A JR NZ,$7F37   ; }
 $7F2C OR $01        ; Clear the zero flag.
 $7F2E EX (SP),HL    ; Swap #REGhl with the address on the stack.
@label=Inglish_SaveTheClauseAndAct_RestoreAndReturn
*$7F2F POP HL        ; {Restore #REGhl, #REGde, #REGbc, #REGiy and #REGix from
 $7F30 POP DE        ; the stack.
 $7F31 POP BC        ;
 $7F32 POP IY        ;
 $7F34 POP IX        ; }
 $7F36 RET           ; Return.
@label=Inglish_SaveTheClauseAndAct_PointAtTheSlot
*$7F37 PUSH HL       ; {Point #REGiy at byte #N$01 of this character's slot.
 $7F38 POP IY        ; }
 $7F3A LD A,$01      ; {Write #N$01 to *#R$B71B.
 $7F3C LD ($B71B),A  ; }
 $7F3F LD A,($B71C)  ; Read *#R$B71C.
 $7F42 PUSH AF       ; {Call #R$79B6 to score the current action.
 $7F43 CALL $79B6    ; }
 $7F46 EX AF,AF'     ; Switch #REGaf with its shadow.
 $7F47 XOR A         ; {Clear *#R$B71B.
 $7F48 LD ($B71B),A  ; }
 $7F4B POP AF        ; {Update *#R$B71C.
 $7F4C LD ($B71C),A  ; }
 $7F4F EX AF,AF'     ; Switch #REGaf with its shadow.
 $7F50 JR Z,$7F57    ; Jump to #R$7F57 if #R$79B6 found no match.
 $7F52 CALL $7AED    ; Call #R$7AED to run the action and see whether its
                     ; message was held back.
 $7F55 JR NZ,$7F2F   ; Jump back to #R$7F2F if #R$7AED held the message back.
@label=Inglish_SaveTheClauseAndAct_ClearThisCharacter
*$7F57 LD A,($B6EA)  ; Read *#R$B6EA.
 $7F5A CALL $7F60    ; Call #R$7F60 to walk the character slots.
 $7F5D XOR A         ; Take the zero path back into the clause save.
 $7F5E JR $7F2F      ; Jump back to #R$7F2F to return.

; Inglish: Walk The Character Slots
;
; Used by the routines at #R$7F1A and #R$977C.
; .
; Walks the eight character slots at #R$B738 and frees (#N$00) any slot held by
; the character in #REGa.
@label=Inglish_WalkTheCharacterSlots
c$7F60 PUSH HL       ; {Save #REGhl, #REGde and #REGbc, and point #REGhl at the
 $7F61 PUSH DE       ; first character slot at #R$B738.
 $7F62 PUSH BC       ;
 $7F63 LD HL,$B738   ; }
 $7F66 LD DE,$0019   ; Each character slot at #R$B738 is #N$19 bytes.
 $7F69 LD B,$08      ; Count #N$08 passes.
@label=Inglish_WalkTheCharacterSlots_ClearThisSlot
*$7F6B CP (HL)       ; {Jump to #R$7F70 unless this slot holds the character in
 $7F6C JR NZ,$7F70   ; #REGa.}
 $7F6E LD (HL),$00   ; Clear it.
@label=Inglish_WalkTheCharacterSlots_StepToTheNextSlot
*$7F70 ADD HL,DE     ; Step to the next #N$19-byte character slot.
 $7F71 DJNZ $7F6B    ; Loop back to #R$7F6B until #N$08 runs out.
 $7F73 POP BC        ; {Restore #REGbc, #REGde and #REGhl from the stack.
 $7F74 POP DE        ;
 $7F75 POP HL        ; }
 $7F76 RET           ; Return.

; Location ID.
;
; Contains #N$FF when the location has no graphics data, else the location ID.
; Read by #R$7F78 and #R$965B.
@label=LocationID
g$7F77 DEFB $00

; Drawing Routine
;
; Used by the routine at #R$965B.
; .
; Draws a location picture from its line, fill and attribute commands.
; Nothing is drawn when the picture switch is off, and a dark place is
; forced black. See #HTML(<a rel="noopener" href="https://www.pobtastic.co.uk/post/skoolkit/hobbit/graphics/">)Location Graphics Decoding#HTML(</a>).
@label=Drawing
c$7F78 PUSH AF       ; {Save #REGaf and jump to #R$7F86 if the picture switch
 $7F79 LD A,($B707)  ; at #R$B707 is not zero.
 $7F7C AND A         ;
 $7F7D JR NZ,$7F86   ; }
 $7F7F LD A,$FF      ; {Write #N$FF to #R$7F77.
 $7F81 LD ($7F77),A  ; }
 $7F84 POP AF        ; Restore #REGaf from the stack.
 $7F85 RET           ; Return.
; Drawing Check
@label=Drawing_Check
*$7F86 POP AF        ; {Keep the saved flags, save the registers, and point
 $7F87 PUSH AF       ; #REGix at the location graphics table.
 $7F88 PUSH HL       ;
 $7F89 PUSH BC       ;
 $7F8A PUSH DE       ;
 $7F8B PUSH IX       ;
 $7F8D LD IX,$CC00   ; }
 $7F91 CALL $9DBD    ; Call #R$9DBD to look this id up. The zero flag is set
                     ; when nothing matches.
 $7F94 LD ($7F77),A  ; Store the location ID at #R$7F77.
 $7F97 LD L,(IX+$01) ; Read the low byte of this location's graphics address.
 $7F9A LD H,(IX+$02) ; Read the high byte of this location's graphics address.
 $7F9D CALL NZ,$7FA7 ; If there is graphics data for this location then call
                     ; #R$7FA7.
 $7FA0 POP IX        ; {Restore #REGix, #REGde, #REGbc, #REGhl and #REGaf from
 $7FA2 POP DE        ; the stack.
 $7FA3 POP BC        ;
 $7FA4 POP HL        ;
 $7FA5 POP AF        ; }
 $7FA6 RET           ; Return.

; Drawing: Start A Picture Command
;
; Used by the routine at #R$7F78.
; .
; Reads picture commands. #N$00 ends the picture, #N$08 moves the pen, bit 7 draws a line,
; and the other bytes fill or paint.
;
; .
;
; Drawing routines.
@label=DrawingSetup
c$7FA7 PUSH IY       ; {Save the picture registers and clear the window when
 $7FA9 PUSH HL       ; the place is dark.
 $7FAA PUSH HL       ;
 $7FAB POP IY        ;
 $7FAD PUSH DE       ;
 $7FAE PUSH BC       ;
 $7FAF CALL $820B    ; }
 $7FB2 LD D,$7F      ; Start the high coordinate at #N$7F.
 $7FB4 LD E,$3F      ; Start the low coordinate at #N$3F.
 $7FB6 LD B,$01      ; Start the step count at #N$01.
 $7FB8 LD C,$01      ; Start the direction at #N$01.
 $7FBA LD L,$01      ; Start the length at #N$01.
@label=Drawing_Loop
*$7FBC LD A,(IY+$00) ; Fetch the next drawing instruction.
 $7FBF AND A         ; {If the drawing instruction is zero, jump to #R$8069.
 $7FC0 JP Z,$8069    ; }
 $7FC3 INC IY        ; Increment the graphics data pointer by one.
 $7FC5 CP $08        ; {If the graphics data value which was fetched is not
 $7FC7 JR NZ,$7FD5   ; #N$08 (move to X/Y) jump to #R$7FD5.}
; Moves the "pen" held in #REGde to a screen location.
 $7FC9 LD D,(IY+$00) ; {Populate #REGde with two values from the graphics data
 $7FCC INC IY        ; and increment the pointer by two.
 $7FCE LD E,(IY+$00) ;
 $7FD1 INC IY        ; }
 $7FD3 JR $7FBC      ; Jump back to #R$7FBC for the next drawing instruction.
@label=DrawingSetup_TestForALine
*$7FD5 BIT 7,A       ; {If bit 7 is clear, jump to #R$7FFA. A set bit 7 is a
 $7FD7 JR Z,$7FFA    ; line.}
 $7FD9 LD B,A        ; Keep the line command.
 $7FDA AND %00000111 ; The low three bits are the direction.
 $7FDC LD C,A        ; Store the direction in #REGc.
 $7FDD LD A,B        ; {Bring the line command back.
 $7FDE RRCA          ;
 $7FDF AND $3C       ; }
 $7FE1 LD B,A        ; Store this in #REGb.
 $7FE2 LD A,(IY+$00) ; Read the length byte of the line.
 $7FE5 AND %00111111 ; The low six bits are the length.
 $7FE7 LD L,A        ; Store that length.
 $7FE8 INC L         ; A stored length of zero draws one pixel.
 $7FE9 LD A,(IY+$00) ; Read the length byte again for the step spacing.
 $7FEC INC IY        ; Increment the graphics data pointer by one.
 $7FEE RLCA          ; {Move bits 6-7 down to bits 0-1.
 $7FEF RLCA          ;
 $7FF0 AND $03       ; }
 $7FF2 OR B          ; Combine the step spacing from both command bytes.
 $7FF3 LD B,A        ; Store the step spacing.
 $7FF4 INC B         ; A stored spacing of zero steps every pixel.
 $7FF5 CALL $8151    ; Call #R$8151 to plot the line.
 $7FF8 JR $7FBC      ; Jump back to #R$7FBC for the next drawing instruction.
; A set bit 6 is a fill.
@label=DrawingSetup_TestForAFill
*$7FFA BIT 6,A       ; {Jump to #R$8012 if bit 6 is clear.
 $7FFC JR Z,$8012    ; }
 $7FFE AND %00000111 ; The low three bits are the fill ink.
 $8000 PUSH DE       ; {Read the fill's X coordinate.
 $8001 LD D,(IY+$00) ; }
 $8004 INC IY        ; Advance the graphics pointer.
 $8006 LD E,(IY+$00) ; Read the fill's other coordinate.
 $8009 INC IY        ; Advance the graphics pointer.
; Flood-fill from the point in #REGde.
 $800B CALL $8071    ; Call #R$8071 to flood-fill from that point.
 $800E POP DE        ; {Jump back to #R$7FBC to fetch the next drawing
 $800F JP $7FBC      ; instruction.}
@label=DrawingSetup_RepeatWhileBitFiveIsClear
*$8012 BIT 5,A       ; {Jump back to #R$7FBC if bit 5 of this picture command
 $8014 JP Z,$7FBC    ; is clear.}
 $8017 AND %00000111 ; The low three bits are the ink to paint.
 $8019 RLCA          ; Shift the ink towards the paper bits.
 $801A RLCA          ; Shift the ink towards the paper bits.
 $801B RLCA          ; Shift the ink into the paper bits.
 $801C PUSH HL       ; {Save #REGhl, #REGde and #REGbc, and keep the scaled
 $801D PUSH DE       ; bits in #REGc.
 $801E PUSH BC       ;
 $801F LD C,A        ; }
 $8020 LD H,(IY+$00) ; Read the attribute address high byte into #REGh.
 $8023 INC IY        ; Advance the graphics pointer.
 $8025 LD L,(IY+$00) ; Read the attribute address low byte into #REGl.
 $8028 INC IY        ; Advance the graphics pointer.
@label=DrawingSetup_ReadTheNextAttributeByte
*$802A LD A,(IY+$00) ; Read the next attribute byte.
 $802D INC IY        ; Advance the graphics pointer.
 $802F CP $FF        ; {Jump to #R$8063 at the #N$FF terminator.
 $8031 JR Z,$8063    ; }
 $8033 LD B,A        ; Copy the result into #REGb.
 $8034 AND %00000011 ; The low two bits choose which way this attribute run
                     ; steps.
 $8036 LD E,A        ; Store that step.
 $8037 LD A,B        ; {Shift the length down two bits.
 $8038 RRCA          ;
 $8039 RRCA          ;
 $803A AND $3F       ; }
 $803C INC A         ; A stored length of zero paints one cell.
 $803D LD B,A        ; Copy the result into #REGb.
@label=DrawingSetup_Loop
*$803E LD A,(HL)     ; Read the next byte.
 $803F AND %00000111 ; {Jump to #R$8049 when this cell's ink is not the ink
 $8041 RLCA          ; being replaced.
 $8042 RLCA          ;
 $8043 RLCA          ;
 $8044 CP C          ;
 $8045 JR NZ,$8049   ; }
 $8047 XOR $38       ; Flip the bits selected by #N$38.
@label=DrawingSetup_StoreTheAttribute
*$8049 RRCA          ; {Shift the ink back into bits 0-2, merge it with #REGc
 $804A RRCA          ; and store the attribute; then call #R$80F5 if the
 $804B RRCA          ; direction in #REGe is #N$00.
 $804C OR C          ;
 $804D LD (HL),A     ;
 $804E LD A,E        ;
 $804F AND A         ;
 $8050 CALL Z,$80F5  ; }
 $8053 DEC A         ; {Call #R$8121 if the direction is #N$01.
 $8054 CALL Z,$8121  ; }
 $8057 DEC A         ; {Call #R$8106 if the direction is #N$02.
 $8058 CALL Z,$8106  ; }
 $805B DEC A         ; {Call #R$8117 if the direction is #N$03.
 $805C CALL Z,$8117  ; }
 $805F DJNZ $803E    ; Loop back to #R$803E until the count runs out.
 $8061 JR $802A      ; Jump back to #R$802A for the next attribute byte.
; Restore the registers saved for this shape.
@label=DrawingSetup_FetchTheNextDrawingInstruction
*$8063 POP BC        ; {Restore #REGbc, #REGde and #REGhl from the stack, then
 $8064 POP DE        ; jump to #R$7FBC for the next drawing instruction.
 $8065 POP HL        ;
 $8066 JP $7FBC      ; }
; This entry point is used by the routine at #R$820B.
@label=Drawing_End
*$8069 POP BC        ; {Restore #REGbc, #REGde, #REGhl and #REGiy from the
 $806A POP DE        ; stack.
 $806B POP HL        ;
 $806C POP IY        ; }
 $806E RET           ; Return.
 $806F DEFB $00,$00  ;
*$8071 LD ($824E),A  ; Store the result at #R$824E.
 $8074 PUSH DE       ; {Allow #N$80 steps of this flood fill.
 $8075 PUSH HL       ;
 $8076 LD HL,$0080   ;
 $8079 PUSH HL       ; }
@label=DrawingSetup_MaskOneScreenByte
*$807A CALL $80EE    ; Call #R$80EE to mask one screen byte.
 $807D JR NZ,$8086   ; Jump to #R$8086 if #R$80EE found the masked screen byte
                     ; set.
 $807F CALL $8148    ; Call #R$8148 to retreat the high coordinate.
 $8082 JR NZ,$807A   ; Jump back to #R$807A if #R$8148 did not wrap the high
                     ; coordinate.
 $8084 JR $808C      ; Jump to #R$808C to clear the saved coordinate, because
                     ; the high coordinate wrapped.
@label=DrawingSetup_AddressThePixel
*$8086 CALL $81B5    ; Call #R$81B5 to address the pixel.
 $8089 CALL $8141    ; Call #R$8141 to advance the high coordinate.
@label=DrawingSetup_ClearTheFloodFillCount
*$808C LD HL,$0000   ; {Store #N($0000,$04,$04) in *#R$806F.
 $808F LD ($806F),HL ; }
@label=DrawingSetup_AdvanceTheLowCoordinate
*$8092 CALL $812B    ; Call #R$812B to advance the low coordinate.
 $8095 LD A,$00      ; {Take zero and jump to #R$80AE if #R$812B wrapped the
 $8097 JR Z,$80AE    ; low coordinate.}
 $8099 CALL $80EE    ; Call #R$80EE to mask one screen byte.
 $809C LD A,$00      ; {Take zero and jump to #R$80A9 if #R$80EE found the
 $809E JR NZ,$80A9   ; masked screen byte set.}
; Test this flag.
 $80A0 LD A,($806F)  ; {Jump to #R$80A9 if *#R$806F is not zero.
 $80A3 AND A         ;
 $80A4 JR NZ,$80A9   ; }
 $80A6 PUSH DE       ; {Use #N$01 when the coordinate was zero.
 $80A7 LD A,$01      ; }
@label=DrawingSetup_RetreatTheLowCoordinate
*$80A9 PUSH AF       ; {Call #R$813A to retreat the low coordinate, then
 $80AA CALL $813A    ; restore #REGaf from the stack.
 $80AD POP AF        ; }
@label=DrawingSetup_StoreTheResultAtFloodFillCount
*$80AE LD ($806F),A  ; Store the result at #R$806F.
 $80B1 CALL $813A    ; Call #R$813A to retreat the low coordinate.
 $80B4 LD A,$00      ; {Take zero, and jump to #R$80CD if #R$813A returned with
 $80B6 JR Z,$80CD    ; the zero flag set.}
 $80B8 CALL $80EE    ; Call #R$80EE to mask one screen byte.
 $80BB LD A,$00      ; {Take zero, and jump to #R$80C8 if #R$80EE found the
 $80BD JR NZ,$80C8   ; masked screen byte set.}
; Test this flag.
 $80BF LD A,($8070)  ; {Jump to #R$80C8 if the drawing scratch is not zero.
 $80C2 AND A         ;
 $80C3 JR NZ,$80C8   ; }
 $80C5 PUSH DE       ; {Use #N$01 when the coordinate was zero.
 $80C6 LD A,$01      ; }
@label=DrawingSetup_AdvanceAndRestore
*$80C8 PUSH AF       ; {Call #R$812B to advance the low coordinate, then
 $80C9 CALL $812B    ; restore #REGaf from the stack.
 $80CC POP AF        ; }
@label=DrawingSetup_StoreTheHighCoordinate
*$80CD LD ($8070),A  ; Store the result at #N$8070.
 $80D0 CALL $81B5    ; Call #R$81B5 to address the pixel.
 $80D3 CALL $8141    ; Call #R$8141 to advance the high coordinate.
 $80D6 JR Z,$80E0    ; Jump to #R$80E0 if #R$8141 wrapped the high coordinate.
 $80D8 CALL $80EE    ; Call #R$80EE to mask one screen byte.
 $80DB JR Z,$8092    ; Jump back to #R$8092 if #R$80EE found the masked screen
                     ; byte clear.
 $80DD CALL $81B5    ; Call #R$81B5 to address the pixel.
@label=DrawingSetup_TestTheFloodFillCount
*$80E0 POP DE        ; {Jump back to #R$807A unless the flood-fill count is
 $80E1 LD A,E        ; #N$80.
 $80E2 CP $80        ;
 $80E4 JR NZ,$807A   ; }
 $80E6 LD A,$00      ; {Write #N$00 to *#R$824E.
 $80E8 LD ($824E),A  ; }
 $80EB POP HL        ; {Restore #REGhl and #REGde from the stack.
 $80EC POP DE        ; }
 $80ED RET           ; Return.

; Drawing: Mask One Screen Byte
;
; Used by the routine at #R$7FA7.
; .
; Masks one screen byte. It turns the row into a screen address and keeps the picture
; pointer.
@label=Drawing_MaskOneScreenByte
c$80EE PUSH HL       ; {Call #R$81DE to turn the pen into a screen address.
 $80EF CALL $81DE    ; }
 $80F2 AND (HL)      ; {Apply the mask in #REGa and restore #REGhl from the
 $80F3 POP HL        ; stack.}
 $80F4 RET           ; Return.

; Drawing: Step Up One Row
;
; Used by the routine at #R$7FA7.
; .
; Moves the screen address up one character row.
@label=Drawing_StepUpOneRow
c$80F5 PUSH AF       ; {One screen row is #N$20 bytes.
 $80F6 PUSH DE       ;
 $80F7 LD DE,$0020   ; }
 $80FA AND A         ; Clear carry before stepping the screen address back one
                     ; row.
 $80FB SBC HL,DE     ; See how far the pointer is past #N($0020,$04,$04).
 $80FD LD A,H        ; {Jump to #R$8103 if the screen address is not in row
 $80FE CP $57        ; #N$57.
 $8100 JR NZ,$8103   ; }
 $8102 ADD HL,DE     ; Step down one attribute row.
@label=Drawing_StepUpOneRow_RestoreTheRowStep
*$8103 POP DE        ; {Restore #REGde and #REGaf from the stack.
 $8104 POP AF        ; }
 $8105 RET           ; Return.

; Drawing: Step Down One Row
;
; Used by the routine at #R$7FA7.
; .
; Moves the screen address down one character row, and undoes that step if it would leave
; the screen.
@label=Drawing_StepDownOneRow
c$8106 PUSH AF       ; {Step down one attribute row and jump to #N$8113 if the
 $8107 PUSH DE       ; screen address is not #N$5A.
 $8108 LD DE,$0020   ;
 $810B ADD HL,DE     ;
 $810C LD A,H        ;
 $810D CP $5A        ;
 $810F JR NZ,$8113   ; }
 $8111 AND A         ; Clear the carry flag.
 $8112 SBC HL,DE     ; Undo the step.
 $8114 POP DE        ; {Restore #REGde and #REGaf from the stack.
 $8115 POP AF        ; }
 $8116 RET           ; Return.

; Drawing: Step Left One Pixel
;
; Used by the routine at #R$7FA7.
; .
; Moves the screen address left one pixel, wrapping inside the line.
@label=Drawing_StepLeftOnePixel
c$8117 PUSH AF       ; {Step the screen address back and jump to #R$811F if it
 $8118 DEC HL        ; is not in row #N$57.
 $8119 LD A,H        ;
 $811A CP $57        ;
 $811C JR NZ,$811F   ; }
 $811E INC HL        ; Step #REGhl on.
@label=Drawing_StepLeftOnePixel_RestoreTheLeftStep
*$811F POP AF        ; Restore #REGaf from the stack.
 $8120 RET           ; Return.

; Drawing: Step Right One Pixel
;
; Used by the routine at #R$7FA7.
; .
; Moves the screen address right one pixel, wrapping inside the line.
@label=Drawing_StepRightOnePixel
c$8121 PUSH AF       ; {Step the screen address on and jump to #R$8129 if it
 $8122 INC HL        ; has not reached row #N$5A.
 $8123 LD A,H        ;
 $8124 CP $5A        ;
 $8126 JR NZ,$8129   ; }
 $8128 DEC HL        ; Step the screen address back one byte.
@label=Drawing_StepRightOnePixel_RestoreTheRightStep
*$8129 POP AF        ; Restore #REGaf from the stack.
 $812A RET           ; Return.

; Drawing: Advance The Low Coordinate
;
; Used by the routines at #R$7FA7 and #R$8151.
; .
; Advances the low coordinate. If that sets bit 7, the coordinate is put back
; and the routine returns zero.
@label=Drawing_AdvanceTheLowCoordinate
c$812B INC E         ; {Step the low coordinate on and jump to #R$8135 if bit 7
 $812C BIT 7,E       ; is clear.
 $812E JR Z,$8135    ; }
 $8130 DEC E         ; Put the low coordinate back.
 $8131 LD H,A        ; Keep #REGa in #REGh.
 $8132 XOR A         ; Set the zero flag.
 $8133 LD A,H        ; Bring #REGa back from #REGh.
 $8134 RET           ; Return.
; This entry point is used by the routine at #R$813A.
@label=Drawing_AdvanceTheLowCoordinate_StoreTheCoordinate
*$8135 LD H,A        ; Keep #REGa in #REGh.
 $8136 OR $01        ; Clear the zero flag.
 $8138 LD A,H        ; Bring #REGa back from #REGh.
 $8139 RET           ; Return.

; Drawing: Retreat The Low Coordinate
;
; Used by the routines at #R$7FA7 and #R$8151.
; .
; Retreats the low coordinate. If that sets bit 7, the coordinate is put back
; and one step is counted.
@label=Drawing_RetreatTheLowCoordinate
c$813A DEC E         ; {Step the low coordinate back and jump to #R$8135 if bit
 $813B BIT 7,E       ; 7 is clear.
 $813D JR Z,$8135    ; }
 $813F INC E         ; Put the low coordinate back.
 $8140 RET           ; Return.

; Drawing: Advance The High Coordinate
;
; Used by the routines at #R$7FA7 and #R$8151.
; .
; Advances the high coordinate. When it wraps from #N($FF), it is put back and
; the routine returns zero.
@label=Drawing_AdvanceTheHighCoordinate
c$8141 INC D         ; {Step the high coordinate on and return unless it
 $8142 RET NZ        ; wrapped to zero.}
 $8143 DEC D         ; Put the high coordinate back to #N$FF.
 $8144 LD H,A        ; Keep #REGa in #REGh.
 $8145 XOR A         ; Set the zero flag.
 $8146 LD A,H        ; Bring #REGa back from #REGh.
 $8147 RET           ; Return.

; Drawing: Retreat The High Coordinate
;
; Used by the routines at #R$7FA7 and #R$8151.
; .
; Retreats the high coordinate. When it was already zero, it is put back and
; one step is counted.
@label=Drawing_RetreatTheHighCoordinate
c$8148 DEC D         ; {Step the high coordinate back and return unless it
 $8149 LD H,A        ; wrapped to #N$FF.
 $814A LD A,D        ;
 $814B CP $FF        ;
 $814D LD A,H        ;
 $814E RET NZ        ; }
 $814F INC D         ; Put the high coordinate back to #N$00.
 $8150 RET           ; Return.

; Drawing: Plot The Selected Pixel
;
; Used by the routine at #R$7FA7.
; .
; Plots one line. Bit 0 of the direction chooses which coordinate steps first,
; and #REGl is how many pixels are drawn.
@label=Drawing_PlotTheSelectedPixel
c$8151 BIT 0,C       ; {Jump to #R$8185 when bit 0 of the direction is set.
 $8153 JR NZ,$8185   ;
 $8155 PUSH HL       ;
 $8156 PUSH BC       ; }
@label=Drawing_PlotTheSelectedPixel_AddressThePixel
*$8157 CALL $81B5    ; Call #R$81B5 to address the pixel.
 $815A BIT 2,C       ; {Jump to #R$8165 if bit 2 of the direction is clear.
 $815C JR Z,$8165    ; }
 $815E CALL $8148    ; Call #R$8148 to retreat the high coordinate.
 $8161 JR Z,$8182    ; Jump to #R$8182 if #R$8148 wrapped the high coordinate.
 $8163 JR $816A      ; Jump to #R$816A to count this pixel.
@label=Drawing_PlotTheSelectedPixel_StepHigh
*$8165 CALL $8141    ; Call #R$8141 to advance the high coordinate.
 $8168 JR Z,$8182    ; Jump to #R$8182 if #R$8141 wrapped the high coordinate.
@label=Drawing_PlotTheSelectedPixel_CountTheLength
*$816A DEC B         ; Drop one from the remaining length.
 $816B JR NZ,$817F   ; Jump to #R$817F if it is not zero.
 $816D BIT 1,C       ; {Jump to #R$8178 if bit 1 of the direction is clear.
 $816F JR Z,$8178    ; }
 $8171 CALL $813A    ; Call #R$813A to retreat the low coordinate.
 $8174 JR Z,$8182    ; Jump to #R$8182 if #R$813A wrapped the low coordinate.
 $8176 JR $817D      ; Jump to #R$817D to bring the count back.
@label=Drawing_PlotTheSelectedPixel_StepLow
*$8178 CALL $812B    ; Call #R$812B to advance the low coordinate.
 $817B JR Z,$8182    ; Jump to #R$8182 if #R$812B wrapped the low coordinate.
@label=Drawing_PlotTheSelectedPixel_HoldThePixelCount
*$817D POP BC        ; {Copy the count, leaving it on the stack.
 $817E PUSH BC       ; }
@label=Drawing_PlotTheSelectedPixel_CountDownThePixels
*$817F DEC L         ; {Loop back to #R$8157 until the pixel count reaches
 $8180 JR NZ,$8157   ; zero.}
@label=Drawing_PlotTheSelectedPixel_FinishTheFirstPass
*$8182 POP BC        ; {Restore #REGbc and #REGhl from the stack.
 $8183 POP HL        ; }
 $8184 RET           ; Return.
@label=Drawing_PlotTheSelectedPixel_OtherDirection
*$8185 PUSH HL       ; {The other direction steps the low coordinate first.
 $8186 PUSH BC       ;
@label=Drawing_PlotTheSelectedPixel_StepTheLowCoordinate
*$8187 CALL $81B5    ; }
 $818A BIT 1,C       ; {Jump to #R$8195 if bit 1 of the direction is clear.
 $818C JR Z,$8195    ; }
 $818E CALL $813A    ; Call #R$813A to retreat the low coordinate.
 $8191 JR Z,$81B2    ; Jump to #R$81B2 if #R$813A wrapped the low coordinate.
 $8193 JR $819A      ; Jump to #R$819A to skip that picture step.
@label=Drawing_PlotTheSelectedPixel_StepLowOtherWay
*$8195 CALL $812B    ; Call #R$812B to advance the low coordinate.
 $8198 JR Z,$81B2    ; Jump to #R$81B2 if #R$812B wrapped the low coordinate.
@label=Drawing_PlotTheSelectedPixel_CountDownTheLength
*$819A DEC B         ; {Drop one from the remaining length, and jump to #R$81AF
 $819B JR NZ,$81AF   ; to skip the high-coordinate step unless it is zero.}
 $819D BIT 2,C       ; {Jump to #R$81A8 if bit 2 of the direction is clear.
 $819F JR Z,$81A8    ; }
 $81A1 CALL $8148    ; Call #R$8148 to retreat the high coordinate.
 $81A4 JR Z,$81B2    ; Jump to #R$81B2 if #R$8148 wrapped the high coordinate.
 $81A6 JR $81AD      ; Jump to #R$81AD to bring the count back.
@label=Drawing_PlotTheSelectedPixel_StepHighOtherWay
*$81A8 CALL $8141    ; Call #R$8141 to advance the high coordinate.
 $81AB JR Z,$81B2    ; Jump to #R$81B2 if #R$8141 wrapped the high coordinate.
@label=Drawing_PlotTheSelectedPixel_RefreshThePixelCount
*$81AD POP BC        ; {Copy the count, leaving it on the stack.
 $81AE PUSH BC       ; }
@label=Drawing_PlotTheSelectedPixel_RepeatForEachPixel
*$81AF DEC L         ; {Loop back to #R$8187 until the pixel count reaches
 $81B0 JR NZ,$8187   ; zero.}
@label=Drawing_PlotTheSelectedPixel_FinishTheOtherPass
*$81B2 POP BC        ; {Restore #REGbc and #REGhl from the stack.
 $81B3 POP HL        ; }
 $81B4 RET           ; Return.

; Drawing: Address The Pixel
;
; Used by the routines at #R$7FA7 and #R$8151.
; .
; Turns the pixel coordinate into a screen address and sets the bit in that
; screen byte.
@label=Drawing_AddressThePixel
c$81B5 PUSH HL       ; {Call #R$81DE to turn the pen into a screen address.
 $81B6 CALL $81DE    ; }
 $81B9 PUSH AF       ; {Keep the screen address and split out its row bits.
 $81BA PUSH HL       ;
 $81BB LD A,H        ; }
 $81BC AND %00011000 ; Move the row bits of the screen address into the
                     ; attribute address.
 $81BE RRCA          ; Rotate right.
 $81BF RRCA          ; Rotate right.
 $81C0 RRCA          ; Rotate right.
 $81C1 ADD A,$58     ; Add it on.
 $81C3 LD H,A        ; Point #REGh at that attribute.
 $81C4 LD A,(HL)     ; Read the attribute byte.
 $81C5 AND %00111000 ; {Keep only the paper bits (3-5) of this attribute, and
 $81C7 LD (HL),A     ; jump to #R$81D3 unless they match the colour in #R$824E
 $81C8 LD A,($824E)  ; shifted into bits 3-5.
 $81CB RLCA          ;
 $81CC RLCA          ;
 $81CD RLCA          ;
 $81CE CP (HL)       ;
 $81CF JR NZ,$81D3   ; }
 $81D1 XOR $38       ; Flip the bits selected by #N$38.
@label=Drawing_AddressThePixel_RestoreTheInkBits
*$81D3 RRCA          ; {Shift the replacement ink back into the ink bits.
 $81D4 RRCA          ;
 $81D5 RRCA          ; }
 $81D6 OR (HL)       ; Combine it with the attribute on screen.
 $81D7 LD (HL),A     ; Store the attribute.
 $81D8 POP HL        ; {Plot the pixel into the screen byte.
 $81D9 POP AF        ;
 $81DA OR (HL)       ; }
 $81DB LD (HL),A     ; Store the screen byte.
 $81DC POP HL        ; Restore #REGhl from the stack.
 $81DD RET           ; Return.

; Drawing: Screen Address From The Row
;
; Used by the routines at #R$80EE and #R$81B5.
; .
; Builds a Spectrum screen address from the pen in #REGd and #REGe.
@label=Drawing_ScreenAddressFromTheRow
c$81DE LD A,$7F      ; The top screen row is #N$7F.
 $81E0 SUB E         ; The pixel row is #N$7F minus the low coordinate.
 $81E1 LD L,A        ; Keep #N$7F.
 $81E2 AND %00000111 ; Keep the low three bits of the row and select the screen
                     ; base.
 $81E4 OR $40        ; Merge in #N$40.
 $81E6 LD H,A        ; Store the screen address high byte so far.
 $81E7 LD A,L        ; Take the pixel row back into #REGa.
 $81E8 AND %11000000 ; Take the top two bits of the row.
 $81EA RRCA          ; Move the screen-third bits down one place.
 $81EB RRCA          ; Move the screen-third bits down another place.
 $81EC RRCA          ; Move the screen-third bits down to bits 3-4.
 $81ED OR H          ; Fold them into the screen address.
 $81EE LD H,A        ; Store the screen address high byte.
 $81EF LD A,L        ; Take the pixel row back into #REGa.
 $81F0 AND %00111000 ; Take the middle three bits of the row.
 $81F2 RLCA          ; Move the middle row bits up one place.
 $81F3 RLCA          ; Move them up to bits 5-7.
 $81F4 LD L,A        ; Those bits start the screen address low byte.
 $81F5 LD A,D        ; {Take the high coordinate.
 $81F6 RRCA          ;
 $81F7 RRCA          ;
 $81F8 RRCA          ;
 $81F9 AND $1F       ; }
 $81FB OR L          ; Fold the character column into the screen address.
 $81FC LD L,A        ; Store the screen address low byte.
 $81FD LD A,D        ; Take the high coordinate again.
 $81FE AND %00000111 ; The low three bits choose the pixel inside the byte.
 $8200 PUSH BC       ; {Save #REGbc and keep #REGa in #REGb.
 $8201 LD B,A        ; }
 $8202 INC B         ; Make the rotate count one more than the bit number.
 $8203 LD A,$01      ; Start the pixel mask at #N$01.
@label=Drawing_ScreenAddressFromTheRow_ShiftPixelMask
*$8205 RRC A         ; Rotate the pixel mask one place right.
 $8207 DJNZ $8205    ; Decrease counter by one and loop back to #R$8205 until
                     ; counter is zero.
 $8209 POP BC        ; Restore #REGbc from the stack.
 $820A RET           ; Return.

; Drawing: Read The Next Picture Byte
;
; Used by the routine at #R$7FA7.
; .
; Reads the next picture byte. A dark location forces the border and paper to black, then
; the screen and the attributes are cleared.
@label=DrawingClear
c$820B CALL $95ED       ; Call #R$95ED to test whether the location is lit.
 $820E EX AF,AF'        ; {Save the lighting flags and read the next picture
 $820F LD A,(IY+$00)    ; byte.}
 $8212 INC IY           ; Increment the graphic data pointer to the next byte.
 $8214 EX AF,AF'        ; Switch back to the "normal" #REGaf register to check
                        ; the result of the call to #R$95ED.
 $8215 JR NC,$821A      ; Jump to #R$821A if #R$95ED found the location lit
                        ; (carry clear).
 $8217 EX AF,AF'        ; {Overwrite the graphic data in the shadow #REGaf
 $8218 XOR A            ; register to #N$00 (black).}
 $8219 EX AF,AF'        ; Switch back to the "normal" #REGaf register simply to
                        ; accommodate the jump from #R$8215.
@label=Drawing_Border
*$821A EX AF,AF'        ; Switch to the shadow #REGaf register containing the
                        ; first byte of the graphic data (or #N$00 if it's
                        ; dark).
 $821B OUT ($FE),A      ; Set the border colour from #REGa.
 $821D PUSH HL          ; {Point at the screen buffer at #N$4000.
 $821E PUSH DE          ;
 $821F PUSH BC          ;
 $8220 LD HL,$4000      ; }
 $8223 LD DE,$4001      ; {Fill the screen buffer at #N$4000 with zero.
 $8226 LD BC,$0FFF      ;
 $8229 LD (HL),$00      ;
 $822B LDIR             ; }
 $822D LD HL,$5800      ; {Point #REGhl at the attributes at #N($5800), #REGde
 $8230 LD DE,$5801      ; at the next byte, and set the length to
 $8233 LD BC,$01FF      ; #N($01FF,$04).}
 $8236 LD A,(IY+$00)    ; Read the attribute byte for this picture.
 $8239 INC IY           ; Increment the graphic data pointer to the next byte.
 $823B EX AF,AF'        ; Use the flags saved for this picture.
 $823C JR NC,$8241      ; Jump to #R$8241 if the location is lit (carry clear).
 $823E EX AF,AF'        ; {Overwrite the graphic data in the shadow #REGaf
 $823F XOR A            ; register to #N$00 (black).}
 $8240 EX AF,AF'        ; Switch back to the "normal" #REGaf register simply to
                        ; accommodate the jump from #R$823C.
@label=Drawing_Paper
*$8241 EX AF,AF'        ; Switch to the shadow #REGaf register containing the
                        ; second byte of the graphic data (or #N$00 if it's
                        ; dark).
 $8242 LD (HL),A        ; {Write this to the attribute buffer using the target/
 $8243 LDIR             ; length specified previously.}
 $8245 POP BC           ; {Restore the pen from the stack. A dark place ends
 $8246 POP DE           ; the picture.
 $8247 POP HL           ;
 $8248 EX AF,AF'        ; }
 $8249 RET NC           ; Return if it is LIGHT.
 $824A POP HL           ; {Jump back to #R$8069 to return.
 $824B JP $8069         ; }
 $824E DEFB $38,$00,$00 ;

; Command: Match A Special Key
;
; Matches a special key such as save, load or inventory.
; Reached through the jump table at #R$75D2, dispatched from #R$75D0.
@label=Command_MatchASpecialKey
c$8251 LD HL,$8271   ; Point at the special-key table.
 $8254 PUSH DE       ; {Thirteen entries.
 $8255 LD D,$0D      ; }
@label=Command_MatchASpecialKey_Loop
*$8257 LD A,(HL)     ; {Jump to #R$8260 if this entry's first byte is not the
 $8258 INC HL        ; key.
 $8259 CP C          ;
 $825A JR NZ,$8260   ; }
 $825C LD A,(HL)     ; {Jump to #R$8267 if the second byte matches as well.
 $825D CP B          ;
 $825E JR Z,$8267    ; }
@label=Command_MatchASpecialKey_Next
*$8260 INC HL        ; {Step to the next pair, and loop back to #R$8257 until
 $8261 DEC D         ; all #N$0D entries have been tried.
 $8262 JR NZ,$8257   ; }
 $8264 JP $75A0      ; Jump to #R$75A0 when no special key matched.
@label=Command_MatchASpecialKey_JumpToTheHandler
*$8267 LD DE,$0019   ; {The handler word sits #N$19 bytes after the matched
 $826A ADD HL,DE     ; pair.}
 $826B LD E,(HL)     ; Read the low byte of that handler.
 $826C INC HL        ; Step on to its high byte.
 $826D LD D,(HL)     ; Read the high byte of the handler.
 $826E EX DE,HL      ; Take the handler address.
 $826F POP DE        ; {Jump to the handler this key selected.
 $8270 JP (HL)       ; }

; Table: Special Keys
;
; Thirteen token pairs, then the handler word for each pair. #R$8251 scans the
; pairs and jumps #N$1A bytes on to the handler. The first pair is empty. The
; rest are #TOKEN($004E), #TOKEN($0245), #TOKEN($039E), #TOKEN($04AD),
; #TOKEN($04FB), #TOKEN($0479), #TOKEN($03EE), #TOKEN($0580), #TOKEN($0518),
; #TOKEN($031E), #TOKEN($058A) and #TOKEN($04D8).
b$8271 DEFB $00,$00  ; Empty pair.
 $8273 DEFB $4E,$00  ; #WORDPTR
 $8275 DEFB $45,$02  ; #WORDPTR
 $8277 DEFB $9E,$03  ; #WORDPTR
 $8279 DEFB $AD,$04  ; #WORDPTR
 $827B DEFB $FB,$04  ; #WORDPTR
 $827D DEFB $79,$04  ; #WORDPTR
 $827F DEFB $EE,$03  ; #WORDPTR
 $8281 DEFB $80,$05  ; #WORDPTR
 $8283 DEFB $18,$05  ; #WORDPTR
 $8285 DEFB $1E,$03  ; #WORDPTR
 $8287 DEFB $8A,$05  ; #WORDPTR
 $8289 DEFB $D8,$04  ; #WORDPTR
 $828B DEFW $8315    ; Handler for the pair #N$1A bytes back.
 $828D DEFW $82D2    ; Handler for the pair #N$1A bytes back.
 $828F DEFW $82BA    ; Handler for the pair #N$1A bytes back.
 $8291 DEFW $82E2    ; Handler for the pair #N$1A bytes back.
 $8293 DEFW $75B4    ; Handler for the pair #N$1A bytes back.
 $8295 DEFW $82A5    ; Handler for the pair #N$1A bytes back.
 $8297 DEFW $82AF    ; Handler for the pair #N$1A bytes back.
 $8299 DEFW $8451    ; Handler for the pair #N$1A bytes back.
 $829B DEFW $84CC    ; Handler for the pair #N$1A bytes back.
 $829D DEFW $8391    ; Handler for the pair #N$1A bytes back.
 $829F DEFW $83A0    ; Handler for the pair #N$1A bytes back.
 $82A1 DEFW $83EF    ; Handler for the pair #N$1A bytes back.
 $82A3 DEFW $843A    ; Handler for the pair #N$1A bytes back.

; Command: #TOKEN($04FB)
;
; Turns the printer on when bit 6 of port #N$FB is clear. #R$82AF is #TOKEN($0479), which turns it off.
; Reached through the special-key table at #R$8271, dispatched from #R$8251.
@label=Command_PRINT
c$82A5 IN A,($FB)    ; Read the printer port #N$FB.
 $82A7 BIT 6,A       ; Test bit 6.
 $82A9 JR NZ,$82B3   ; Jump to #R$82B3 if bit 6 is set.
 $82AB LD A,$01      ; Take #N$01.
 $82AD JR $82B0      ; Jump to #R$82B0 to store the flag.
; Reached through the special-key table at #R$8271, dispatched from #R$8251.
@label=Command_PRINT_NOPRINT
 $82AF XOR A         ; Clear the accumulator.
*$82B0 LD ($B6F2),A  ; Write it to the printer-on flag at #R$B6F2.

; Command: Dispatch A Control
;
; Used by the routines at #R$82A5, #R$83A0, #R$83EF, #R$842E, #R$8451 and
; #R$84CC.
; .
; Dispatches a control key to the routine that handles it.
@label=CommandDispatchAControl
c$82B3 LD A,($B6DE)  ; Read *#R$B6DE.
 $82B6 LD D,A        ; Keep the class being matched.
 $82B7 JP $75B4      ; Jump back to #R$75B4 to clear the matcher scratch.
; Test the matcher phase. Reached through the special-key table at #R$8271,
; dispatched from #R$8251.
 $82BA LD A,($B719)  ; {Jump to #R$7929 if *#R$B719 is not #N$01.
 $82BD CP $01        ;
 $82BF JP NZ,$7929   ; }
 $82C2 LD A,$02      ; {Write #N$02 to *#R$B719.
 $82C4 LD ($B719),A  ; }
 $82C7 LD A,(IY+$01) ; Set bit 7 of the next byte of this record.
 $82CA OR $80        ; Merge in #N$80.
 $82CC LD (IY+$01),A ; Store that byte.
 $82CF JP $75B4      ; Jump back to #R$75B4 to clear the matcher scratch.
; Test the matcher phase. Reached through the special-key table at #R$8271,
; dispatched from #R$8251.
 $82D2 LD A,($B719)  ; {Jump to #R$75B4 if *#R$B719 is #N$02.
 $82D5 CP $02        ;
 $82D7 JP Z,$75B4    ; }
 $82DA LD A,$01      ; {Write #N$01 to *#R$B719.
 $82DC LD ($B719),A  ; }
 $82DF JP $75B4      ; Jump back to #R$75B4 to clear the matcher scratch.
; Reached through the special-key table at #R$8271, dispatched from #R$8251.
 $82E2 PUSH DE       ; {Point #REGhl at the six match bytes.
 $82E3 LD HL,$B6E0   ; }
 $82E6 LD DE,$757F   ; Name the matcher patch at #N$757F as the copy
                     ; destination.
 $82E9 LD BC,$0006   ; {Copy the prepared bytes.
 $82EC LDIR          ; }
 $82EE POP DE        ; {Restore the caller's pointer from the stack and test
 $82EF BIT 7,E       ; its top bit.}
 $82F1 CALL $82F7    ; Call #R$82F7 to follow the grammar flag.
 $82F4 JP $75B4      ; Jump back to #R$75B4 to clear the matcher scratch.

; Command: Follow The Grammar Flag
;
; Used by the routine at #R$82B3.
; .
; Follows the grammar flag for a special key. A clear bit 7 copies ten grammar bytes,
; otherwise four, and the replay path is then scored.
@label=Command_FollowTheGrammarFlag
c$82F7 JP Z,$7838      ; Jump back to #R$7838 if bit 7 of the grammar flag is
                       ; clear.
 $82FA JP $7850        ; Jump to #R$7850 to clear bit 6 and copy the grammar
                       ; bytes.
@label=Command_FollowTheGrammarFlag_Loop
*$82FD LD A,D          ; Use the class being matched again.
 $82FE LD ($824F),A    ; Store the result at #N$824F.
 $8301 PUSH DE         ; {Save #REGde, #REGbc and #REGiy, and read *#R$B706.
 $8302 PUSH BC         ;
 $8303 PUSH IY         ;
 $8305 LD A,($B706)    ; }
 $8308 LD ($8250),A    ; Remember the replay flag from #R$B706 at #N$8250.
 $830B LD DE,$FFE8     ; Step back one #N$18-byte parser record.
 $830E ADD IY,DE       ; Add #N$FFE8 onto this record.
 $8310 LD A,$01        ; Pass #N$01 on to the grammar scorer at #R$758A.
 $8312 JP $758A        ; Jump back to #R$758A to update the conjunction count.
; Test the conjunction count. Reached through the special-key table at #R$8271,
; dispatched from #R$8251.
 $8315 LD A,($B71B)    ; {Jump to #R$82FD if *#R$B71B is zero.
 $8318 AND A           ;
 $8319 JR Z,$82FD      ; }
 $831B DEC A           ; Step the conjunction count down by one.
 $831C LD ($B71B),A    ; Update *#R$B71B.
 $831F LD A,($8250)    ; Read the saved class.
 $8322 LD B,A          ; Copy the result into #REGb.
 $8323 LD A,($B706)    ; Read *#R$B706.
 $8326 SUB B           ; {Clear #REGc and jump to #R$8378 if the replay flag
 $8327 AND A           ; equals the saved class.
 $8328 LD C,$00        ;
 $832A JR Z,$8378      ; }
 $832C POP IY          ; {Restore the parser pointer from the stack, keeping a
 $832E PUSH IY         ; copy there.}
 $8330 LD DE,$FFE8     ; Step back one #N$18-byte parser record.
 $8333 ADD IY,DE       ; Add #N$FFE8 onto this record.
 $8335 LD B,A          ; Use the difference as the record count in #REGb.
@label=Command_FollowTheGrammarFlag_PointAtTheSlots
*$8336 LD IX,$B738     ; Point at the first character slot at #R$B738.
 $833A PUSH DE         ; {Each character slot at #R$B738 is #N$19 bytes.
 $833B PUSH BC         ;
 $833C LD DE,$0019     ; }
 $833F LD B,$08        ; Count #N$08 passes.
@label=Command_FollowTheGrammarFlag_SkipAUsedSlot
*$8341 LD A,(IX+$00)   ; {Jump to #R$834B if this character slot is empty.
 $8344 AND A           ;
 $8345 JR Z,$834B      ; }
 $8347 ADD IX,DE       ; Step to the next #N$19-byte character slot.
 $8349 DJNZ $8341      ; Loop back to #R$8341 until #N$08 runs out.
@label=Command_FollowTheGrammarFlag_ClaimTheSlot
*$834B LD (IX+$00),$FF ; Claim this free slot with #N$FF.
 $834F INC IX          ; Step to the next byte of this character slot.
 $8351 POP BC          ; {Jump to #R$8378 if every character slot is in use.
 $8352 POP DE          ;
 $8353 JR NZ,$8378     ; }
 $8355 BIT 6,(IY+$01)  ; {Jump to #R$8361 if bit 6 of byte 1 of this record is
 $8359 JR Z,$8361      ; clear.}
 $835B LD (IX-$01),$00 ; Clear the previous byte of this entry.
 $835F JR $8373        ; Jump to #R$8373 to update the matcher phase.
@label=Command_FollowTheGrammarFlag_CopyTheRecord
*$8361 PUSH BC         ; {Count #N$18 passes.
 $8362 LD B,$18        ; }
@label=Command_FollowTheGrammarFlag_CopyTheNextByte
*$8364 LD A,(IY+$00)   ; {Copy the next byte into this entry.
 $8367 LD (IX+$00),A   ; }
 $836A INC IY          ; Step to the next byte of this record.
 $836C INC IX          ; Step to the next byte of this character slot.
 $836E DJNZ $8364      ; Loop back to #R$8364 until #N$18 runs out.
 $8370 POP BC          ; {Restore the record count, and step #REGiy back #N$18
 $8371 ADD IY,DE       ; bytes to the start of this record.}
@label=Command_FollowTheGrammarFlag_StepBackOneRecord
*$8373 ADD IY,DE       ; Step #REGiy back #N$18 bytes to the previous record.
 $8375 INC C           ; Count one more character slot.
 $8376 DJNZ $8336      ; Decrease the record count in #REGb and loop back to
                       ; #R$8336 until it is zero.
@label=Command_FollowTheGrammarFlag_ClearTheMatcherPhase
*$8378 XOR A           ; {Clear *#R$B719.
 $8379 LD ($B719),A    ; }
 $837C LD A,C          ; Copy the count in #REGc into #REGa.
 $837D LD ($B737),A    ; Store the number of claimed slots at #R$B737.
 $8380 POP IY          ; {Restore the parser pointer from the stack and restore
 $8382 LD A,($8250)    ; the replay flag from #N$8250.}
 $8385 LD ($B706),A    ; Update *#R$B706.
 $8388 POP BC          ; {Restore the saved pair from the stack and read the
 $8389 POP DE          ; class from #N$824F.
 $838A LD A,($824F)    ; }
 $838D LD D,A          ; Keep the saved class.
 $838E JP $75B4        ; Jump back to #R$75B4 to clear the matcher scratch.
; Reached through the special-key table at #R$8271, dispatched from #R$8251.
 $8391 CALL $83F5      ; Call #R$83F5 to print the score.
@label=Command_FollowTheGrammarFlag_WaitForAKey
*$8394 XOR A           ; Select every keyboard row (#REGa=#N$00).
 $8395 IN A,($FE)      ; Read port #N$FE into #REGa.
 $8397 AND %00011111   ; {Jump back to #R$8394 while the low five bits are all
 $8399 CP %00011111    ; set.
 $839B JR Z,$8394      ; }
 $839D JP $6C27        ; Jump back to #R$6C27 to restart the game.

; Display Locate Help Message
;
; Prints the hint for the player's current location.
; Reached through the special-key table at #R$8271, dispatched from #R$8251.
;
; .
;
; Test whose turn it is.
@label=DisplayLocateHelpMessage
c$83A0 LD A,($B6EA)  ; {Jump to #R$75B4 if *#R$B6EA is not zero.
 $83A3 AND A         ;
 $83A4 JP NZ,$75B4   ; }
 $83A7 PUSH HL       ; {Save #REGhl and #REGix, and point #REGhl at #R$B467.
 $83A8 PUSH IX       ; }
; Default message response should there be no match for the current location.
 $83AA LD HL,$B467   ;
; Use the current location ID to look-up if there is a specific help message.
 $83AD LD A,($C12B)  ; {Using the #R$C12B(current location number), see if
 $83B0 LD IX,$83CD   ; there is a help message available for display. This is
 $83B4 CALL $9DBD    ; achieved by passing #R$83CD to the #R$9DBD(Index ID
                     ; Table) routine.}
 $83B7 JR Z,$83BF    ; If there is no message, jump directly to #R$83BF to
                     ; display the default message.
; Point to the specific help for the current location.
 $83B9 LD L,(IX+$01) ; Read the low byte of this location's hint message
                     ; address.
 $83BC LD H,(IX+$02) ; Read the high byte of this location's hint message
                     ; address.
; Print the message.
@label=DisplayLocateHelpMessage_Print
*$83BF LD A,$01      ; {Write #N$01 to #R$B701.
 $83C1 LD ($B701),A  ; }
 $83C4 CALL $72DD    ; Call #R$72DD to print message.
 $83C7 POP IX        ; {Jump back to #R$82B3 to dispatch a control.
 $83C9 POP HL        ;
 $83CA JP $82B3      ; }

; Locate Help Message
;
; Read by #R$83A0.
@label=LocateHelpMessage
b$83CD DEFB $06      ; Location #LOCATION(#PEEK(#PC)) -
                     ; "#LOCATIONNAME(#PEEK(#PC))".
 $83CE DEFW $B47A    ; #TEXTMESSAGE(#PC)
 $83D0 DEFB $09      ; Location #LOCATION(#PEEK(#PC)) -
                     ; "#LOCATIONNAME(#PEEK(#PC))".
 $83D1 DEFW $B48A    ; #TEXTMESSAGE(#PC)
 $83D3 DEFB $0D      ; Location #LOCATION(#PEEK(#PC)) -
                     ; "#LOCATIONNAME(#PEEK(#PC))".
 $83D4 DEFW $B49A    ; #TEXTMESSAGE(#PC)
 $83D6 DEFB $42      ; Location #LOCATION(#PEEK(#PC)) -
                     ; "#LOCATIONNAME(#PEEK(#PC))".
 $83D7 DEFW $B4BE    ; #TEXTMESSAGE(#PC)
 $83D9 DEFB $1F      ; Location #LOCATION(#PEEK(#PC)) -
                     ; "#LOCATIONNAME(#PEEK(#PC))".
 $83DA DEFW $B4CA    ; #TEXTMESSAGE(#PC)
 $83DC DEFB $20      ; Location #LOCATION(#PEEK(#PC)) -
                     ; "#LOCATIONNAME(#PEEK(#PC))".
 $83DD DEFW $B4DA    ; #TEXTMESSAGE(#PC)
 $83DF DEFB $2A      ; Location #LOCATION(#PEEK(#PC)) -
                     ; "#LOCATIONNAME(#PEEK(#PC))".
 $83E0 DEFW $B4FA    ; #TEXTMESSAGE(#PC)
 $83E2 DEFB $2E      ; Location #LOCATION(#PEEK(#PC)) -
                     ; "#LOCATIONNAME(#PEEK(#PC))".
 $83E3 DEFW $B504    ; #TEXTMESSAGE(#PC)
 $83E5 DEFB $29      ; Location #LOCATION(#PEEK(#PC)) -
                     ; "#LOCATIONNAME(#PEEK(#PC))".
 $83E6 DEFW $B518    ; #TEXTMESSAGE(#PC)
 $83E8 DEFB $1A      ; Location #LOCATION(#PEEK(#PC)) -
                     ; "#LOCATIONNAME(#PEEK(#PC))".
 $83E9 DEFW $B52F    ; #TEXTMESSAGE(#PC)
 $83EB DEFB $05      ; Location #LOCATION(#PEEK(#PC)) -
                     ; "#LOCATIONNAME(#PEEK(#PC))".
 $83EC DEFW $B53E    ; #TEXTMESSAGE(#PC)
 $83EE DEFB $FF      ; #TERMINATOR

; Game Over
;
; Ends the game and prints the percentage complete.
; Reached through the special-key table at #R$8271, dispatched from #R$8251.
@label=GameOver
c$83EF CALL $83F5    ; Call #R$83F5 to print the score.
 $83F2 JP $82B3      ; Jump back to #R$82B3 to dispatch a control.

; Game Over: Print The Score
;
; Used by the routines at #R$82F7, #R$83EF and #R$90D2.
; .
; Prints the score as a percentage of the adventure, taken from the percentage complete,
; and finishes the game-over text.
;
; .
;
; Actions "game over".
@label=GameOver_Start
c$83F5 PUSH HL       ; {Write #N$00 to #R$B701.
 $83F6 PUSH DE       ;
 $83F7 XOR A         ;
 $83F8 LD ($B701),A  ; }
 $83FB LD HL,$B454   ; Point at the message "you have mastered [0x16]"
                     ; (#R$B454).
 $83FE CALL $72DD    ; Call #R$72DD to print message.
 $8401 LD HL,($B6F7) ; Read the percentage complete from #R$B6F7.
 $8404 LD DE,$0064   ; Divide by #N($0064,$04,$04) (100).
 $8407 CALL $842E    ; Call #R$842E to make the hundreds digit.
 $840A CALL NZ,$858B ; Call #R$858B if #R$842E made a hundreds digit other than
                     ; zero.
 $840D LD DE,$000A   ; Divide by #N($000A,$04,$04) (10).
 $8410 CALL $842E    ; Call #R$842E to make the tens digit.
 $8413 CALL $858B    ; Call #R$858B to print one character.
 $8416 LD A,$2E      ; Use the character '.'.
 $8418 CALL $858B    ; Call #R$858B to print one character.
 $841B LD A,L        ; Copy the remainder into #REGa as the percentage digit.
 $841C ADD A,$30     ; Add #N$30 to make the ASCII digit.
 $841E CALL $858B    ; Call #R$858B to print one character.
 $8421 XOR A         ; {Clear the capitalise-the-next-letter flag.
 $8422 LD ($B704),A  ; }
 $8425 LD HL,$B462   ; Point at the message "% of this adventure" (#R$B462).
 $8428 CALL $72DD    ; Call #R$72DD to print message.
 $842B POP DE        ; {Restore #REGde and #REGhl from the stack.
 $842C POP HL        ; }
 $842D RET           ; Return.

; Print: Percentage Digit
;
; Used by the routine at #R$83F5.
; .
; Turns one decimal digit of the score into ASCII, counting up from '0'.
;
; .
;
; Converts e.g. "0075" into "7.5" in ASCII for display purposes.
@label=PercentageAscii
c$842E LD A,$2F      ; Start the quotient digit one below '0'.
@label=PercentageAscii_Loop
*$8430 INC A         ; Count the digit up by one.
 $8431 AND A         ; Clear carry for the subtraction.
 $8432 SBC HL,DE     ; Subtract the power of ten in #REGde from #REGhl.
 $8434 JR NC,$8430   ; Jump back to #R$8430 to count another digit unless the
                     ; subtraction went below zero.
 $8436 ADD HL,DE     ; Add the power of ten back to leave the remainder.
 $8437 CP $30        ; Compare against #N$30 (ASCII "0") to set flags for the
                     ; return.
 $8439 RET           ; Return.
; Reached through the special-key table at #R$8271, dispatched from #R$8251.
 $843A LD A,$04      ; {Set the border to #N$04 (green).
 $843C OUT ($FE),A   ; }
 $843E CALL $84B9    ; Call #R$84B9 to debounce keyboard.
@label=Wait_ForKey
*$8441 XOR A         ; {Read from the keyboard port.
 $8442 IN A,($FE)    ; }
 $8444 AND %00011111 ; Keep bits 0-4, one for each key in the half-row. XOR A
                     ; then IN A,(#N$FE) reads every half-row at once, and a
                     ; pressed key reads as a reset bit.
 $8446 CP $1F        ; {Loop back to #R$8441 while a key is being pressed.
 $8448 JR NZ,$8441   ; }
 $844A LD A,$07      ; {Set the border to #N$07 (white).
 $844C OUT ($FE),A   ; }
 $844E JP $82B3      ; Jump back to #R$82B3 to dispatch a control.

; Load Game
;
; Loads a saved game back into the live state.
; Reached through the special-key table at #R$8271, dispatched from #R$8251.
@label=LoadGame
c$8451 PUSH IX       ; {Set the load as a "data block".
 $8453 PUSH DE       ; }
; Load "flags".
 $8454 LD A,$FF      ;
 $8456 SCF           ; Set carry so the ROM loads the saved-game header.
 $8457 LD IX,$B6EB   ; Set the start address to #R$B6EB.
 $845B LD DE,$001D   ; Set the block length to #N$1D bytes.
 $845E CALL $8498    ; Call #R$8498 to read the save block.
; Load "objects".
 $8461 LD A,$FF      ; Set the load as a "data block".
 $8463 SCF           ; Set carry so the ROM loads the object table.
 $8464 LD IX,$C11B   ; Set the start address to #R$C11B.
 $8468 LD DE,$0615   ; Set the block length to #N($0615,$04) bytes.
 $846B CALL $8498    ; Call #R$8498 to read the save block.
; Load...
 $846E LD A,$FF      ; Set the load as a "data block".
 $8470 SCF           ; Set carry so the ROM loads the object handlers.
 $8471 LD IX,$CA84   ; Set the start address to #R$CA84.
 $8475 LD DE,$00BF   ; Set the block length to #N$BF bytes.
 $8478 CALL $8498    ; Call #R$8498 to read the save block.
; Load "locations".
 $847B LD A,$FF      ; Set the load as a "data block".
 $847D SCF           ; Set carry so the ROM loads the location table.
 $847E LD IX,$BA8A   ; Set the start address to #R$BA8A.
 $8482 LD DE,$05D9   ; Set the block length to #N($05D9,$04) bytes.
 $8485 CALL $8498    ; Call #R$8498 to read the save block.
; Success!
 $8488 DI            ; Disable interrupts.
 $8489 LD HL,$B6EB   ; {Call #R$84B3 with #REGhl pointing at #R$B6EB and #REGde
 $848C LD DE,$C9E2   ; pointing at #N$C9E2.
 $848F CALL $84B3    ; }
 $8492 POP DE        ; {Jump back to #R$82B3 to dispatch a control.
 $8493 POP IX        ;
 $8495 JP $82B3      ; }

; Load: Read The Save Block
;
; Used by the routine at #R$8451.
; .
; Reads a save block from tape, prints the prompt at #R$B357, and waits for a key before
; returning to the loader.
;
; .
;
; Load Block
@label=LoadBlock
c$8498 CALL $0556    ; Call #SKOOLKID$0556(LD_BYTES).
 $849B RET C         ; Return if the tape block loaded (carry set).
 $849C LD A,$01      ; {Write #N$01 to #R$B701.
 $849E LD ($B701),A  ; }
 $84A1 LD HL,$B357   ; Point #REGhl at #R$B357.
 $84A4 CALL $72DD    ; Call #R$72DD to print message.
@label=LoadBlock_Loop
*$84A7 XOR A         ; {Read from the keyboard port.
 $84A8 IN A,($FE)    ; }
 $84AA AND %00011111 ; Keep bits 0-4, one for each key in the half-row. XOR A
                     ; then IN A,(#N$FE) reads every half-row at once, and a
                     ; pressed key reads as a reset bit.
 $84AC CP $1F        ; {Loop back to #R$84A7 until any key has been pressed.
 $84AE JR Z,$84A7    ; }
 $84B0 JP $6C27      ; Jump back to #R$6C27 to restart the game.

; Copy Three Bytes
;
; Used by the routines at #R$8451 and #R$84CC.
; .
; Copies three bytes from a source record to a destination.
;
; DE Source
; HL Target
@label=ThreeByteCopy
c$84B3 LD BC,$0003   ; The copy length is #N$03.
 $84B6 LDIR          ; Copy three bytes of data from #REGde to #REGhl.
 $84B8 RET           ; Return.

; Debounce keyboard
;
; Used by the routines at #R$842E and #R$84CC.
; .
; Waits until the current key has been released.
@label=DebounceAnyKey
c$84B9 XOR A         ; {Read from the keyboard port.
 $84BA IN A,($FE)    ; }
 $84BC AND %00011111 ; Keep bits 0-4, one for each key in the half-row. XOR A
                     ; then IN A,(#N$FE) reads every half-row at once, and a
                     ; pressed key reads as a reset bit.
 $84BE CP $1F        ; {Loop back to #R$84B9 if a key is being pressed.
 $84C0 JR NZ,$84B9   ; }
@label=Normal_AnyKey
*$84C2 XOR A         ; {Read from the keyboard port.
 $84C3 IN A,($FE)    ; }
 $84C5 AND %00011111 ; Keep bits 0-4, one for each key in the half-row. XOR A
                     ; then IN A,(#N$FE) reads every half-row at once, and a
                     ; pressed key reads as a reset bit.
 $84C7 CP $1F        ; {Loop back to #R$84C2 until any key has been pressed.
 $84C9 JR Z,$84C2    ; }
 $84CB RET           ; Return.

; Save Game
;
; Saves the live game to tape.
; Reached through the special-key table at #R$8271, dispatched from #R$8251.
@label=SaveGame
c$84CC PUSH IX       ; {Save #REGix and #REGde, then call #R$84B3 with #REGde
 $84CE PUSH DE       ; at #R$B6EB and #REGhl at #N$C9E2.
 $84CF LD DE,$B6EB   ;
 $84D2 LD HL,$C9E2   ;
 $84D5 CALL $84B3    ; }
 $84D8 LD A,$01      ; {Write #N$01 to #R$B701.
 $84DA LD ($B701),A  ; }
 $84DD LD HL,$B342   ; Point at the message "start tape then press any key"
                     ; (#R$B342).
 $84E0 CALL $72DD    ; Call #R$72DD to print message.
 $84E3 CALL $84B9    ; Call #R$84B9 to debounce keyboard.
; Save "flags".
 $84E6 LD A,$FF      ; Set the save as a "data block".
 $84E8 LD IX,$B6EB   ; Set the start address to #R$B6EB.
 $84EC LD DE,$001D   ; Set the block length to #N$1D bytes.
 $84EF CALL $04C2    ; Call #SKOOLKID$04C2(SA_BYTES).
; Save "objects".
 $84F2 LD A,$FF      ; Set the save as a "data block".
 $84F4 LD IX,$C11B   ; Set the start address to #R$C11B.
 $84F8 LD DE,$0615   ; Set the block length to #N($0615,$04) bytes.
 $84FB CALL $04C2    ; Call #SKOOLKID$04C2(SA_BYTES).
; Save...
 $84FE LD A,$FF      ; Set the save as a "data block".
 $8500 LD IX,$CA84   ; Set the start address to #R$CA84.
 $8504 LD DE,$00BF   ; Set the block length to #N$BF bytes.
 $8507 CALL $04C2    ; Call #SKOOLKID$04C2(SA_BYTES).
; Save "locations".
 $850A LD A,$FF      ; Set the save as a "data block".
 $850C LD IX,$BA8A   ; Set the start address to #R$BA8A.
 $8510 LD DE,$05D9   ; Set the block length to #N($05D9,$04) bytes.
 $8513 CALL $04C2    ; Call #SKOOLKID$04C2(SA_BYTES).
; Begin verification.
 $8516 LD HL,$B3A4   ; Point #REGhl at #R$B3A4.
 $8519 CALL $72DD    ; Call #R$72DD to print message.
 $851C CALL $84B9    ; Call #R$84B9 to debounce keyboard.
; Verify "flags".
 $851F LD A,$FF      ; Set the load as a "data block".
 $8521 AND A         ; Clear carry so the ROM verifies the flags.
 $8522 LD IX,$B6EB   ; Set the start address to #R$B6EB.
 $8526 LD DE,$001D   ; Set the block length to #N$1D bytes.
 $8529 CALL $855A    ; Call #R$855A to verify the block.
; Verify "objects".
 $852C LD A,$FF      ; Set the load as a "data block".
 $852E AND A         ; Clear carry so the ROM verifies the object table.
 $852F LD IX,$C11B   ; Set the start address to #R$C11B.
 $8533 LD DE,$0615   ; Set the block length to #N($0615,$04) bytes.
 $8536 CALL $855A    ; Call #R$855A to verify the block.
; Verify the object handlers.
 $8539 LD A,$FF      ; Set the load as a "data block".
 $853B AND A         ; Clear carry so the ROM verifies the object handlers.
 $853C LD IX,$CA84   ; Set the start address to #R$CA84.
 $8540 LD DE,$00BF   ; Set the block length to #N$BF bytes.
 $8543 CALL $855A    ; Call #R$855A to verify the block.
; Verify "locations".
 $8546 LD A,$FF      ; Set the load as a "data block".
 $8548 AND A         ; Clear carry so the ROM verifies the location table.
 $8549 LD IX,$BA8A   ; Set the start address to #R$BA8A.
 $854D LD DE,$05D9   ; Set the block length to #N($05D9,$04) bytes.
 $8550 CALL $855A    ; Call #R$855A to verify the block.
; This entry point is used by the routine at #R$855A.
; .
; Success!
@label=SaveGame_Done
*$8553 DI            ; Disable interrupts.
 $8554 POP DE        ; {Jump back to #R$82B3 to dispatch a control.
 $8555 POP IX        ;
 $8557 JP $82B3      ; }

; Save: Verify A Block
;
; Used by the routine at #R$84CC.
; .
; Verifies a block just saved, using LD_BYTES with carry clear. A tape error prints "tape error - hit any key to continue"
; and waits for a key.
;
; .
;
; Verify block.
@label=VerifyBlock
c$855A CALL $0556    ; Call #SKOOLKID$0556(LD_BYTES).
 $855D RET C         ; Return if the block verified (carry set).
 $855E LD A,$01      ; {Write #N$01 to #R$B701.
 $8560 LD ($B701),A  ; }
 $8563 LD HL,$B381   ; Point at the message "tape error - hit any key to
                     ; continue[0x15]" (#R$B381).
 $8566 CALL $72DD    ; Call #R$72DD to print message.
; This is the same key wait as #R$84C2.
@label=VerifyBlock_WaitForKey
*$8569 XOR A         ; {Read from the keyboard port.
 $856A IN A,($FE)    ; }
 $856C AND %00011111 ; Keep bits 0-4, one for each key in the half-row. XOR A
                     ; then IN A,(#N$FE) reads every half-row at once, and a
                     ; pressed key reads as a reset bit.
 $856E CP $1F        ; {Loop back to #R$8569 until any key has been pressed.
 $8570 JR Z,$8569    ; }
 $8572 POP DE        ; {Jump back to #R$8553 to dispatch a control.
 $8573 JP $8553      ; }

; Print: Gate On The Time Of Day
;
; Used by the routine at #R$858B.
; .
; Gates printing on the time of day, and prints a character once the
; gate allows it.
@label=PrintGateOnTheTimeOfDay
c$8576 PUSH HL       ; {Read the message gate.
 $8577 LD L,A        ;
 $8578 LD A,($B6FA)  ; }
 $857B LD H,A        ; Keep the message gate.
 $857C LD A,($B702)  ; Read the day flag.
 $857F AND H         ; {See whether the day flag meets the message gate, and
 $8580 LD A,L        ; bring the character back.}
 $8581 POP HL        ; Restore #REGhl from the stack.
 $8582 RET           ; Return.

; Print: A Newline
;
; Used by the routines at #R$6CEC, #R$712B, #R$7348, #R$74C1, #R$8C4B, #R$93DA,
; #R$965B, #R$96A8, #R$97F4, #R$9FC7, #R$A050 and #R$A138.
; .
; Prints a carriage return.
@label=Print_LineBreak
c$8583 PUSH AF       ; {Use ENTER as the character.
 $8584 LD A,$0D      ; }
 $8586 CALL $858B    ; Call #R$858B to print one character.
 $8589 POP AF        ; Restore #REGaf from the stack.
 $858A RET           ; Return.

; Print: One Character
;
; Used by the routines at #R$6CEC, #R$6DD6, #R$6E4F, #R$6E8B, #R$712B, #R$7249,
; #R$72C3, #R$7348, #R$73BD, #R$74C1, #R$83F5, #R$8583, #R$8C4B, #R$93DA,
; #R$97F4 and #R$9FC7.
; .
; Prints the character in the accumulator, after the day and night filter.
@label=Print_Character
c$858B CALL $8576       ; Call #R$8576 to gate printing on the time of day.
 $858E RET Z            ; Return if #R$8576 found the day flag does not meet
                        ; the message gate.
 $858F PUSH AF          ; {If #R$B701 is not zero then jump to #R$85B7.
 $8590 LD A,($B701)     ;
 $8593 AND A            ;
 $8594 JR NZ,$85B7      ; }
 $8596 POP AF           ; {Restore the character from the stack and call
 $8597 CALL $86A1       ; #R$86A1 to draw it.}
 $859A PUSH AF          ; {If #R$B700 is not zero then jump to #R$85A3.
 $859B LD A,($B700)     ;
 $859E AND A            ;
 $859F JR NZ,$85A3      ; }
 $85A1 POP AF           ; Restore the character from the stack.
 $85A2 RET              ; Return.
@label=Print_Character_TestForAnS
*$85A3 POP AF           ; {If this is ASCII "S" then jump to #R$85AB.
 $85A4 CP $53           ;
 $85A6 JR Z,$85AB       ; }
 $85A8 CP $73           ; {If this is not ASCII "s" then return.
 $85AA RET NZ           ; }
@label=Print_Character_PrintAnH
*$85AB PUSH AF          ; {Use the character 'H'.
 $85AC LD A,$48         ; }
 $85AE CALL $86A1       ; Call #R$86A1 to draw the character on the screen.
 $85B1 POP AF           ; Restore #REGaf from the stack.
 $85B2 RET              ; Return.
 $85B3 NOP              ; Characters left on the current line (#N$20 at the
                        ; start of a line).
@label=PercentageBuffer
 $85B4 DEFB $00,$00,$00 ; Percentage buffer.
@label=Print_Character_TestForAReturn
*$85B7 POP AF           ; {Save the character and the text pointer, and jump to
; This entry point is used by the routine at #R$6CEC.
*$85B8 PUSH HL          ; #R$85C8 if the character is not a carriage return
 $85B9 PUSH AF          ; (#N$0D).
 $85BA LD HL,($85B4)    ;
 $85BD CP $0D           ;
 $85BF JR NZ,$85C8      ; }
; Print a space.
 $85C1 LD A,$20         ; {Print a space.
 $85C3 CALL $867A       ; }
 $85C6 JR $85DF         ; Jump to #R$85DF to start a new line.
@label=Print_Character_TestForBackspace
*$85C8 CP $08           ; {Jump to #R$85F5 if the character is #N$08.
 $85CA JR Z,$85F5       ; }
 $85CC CP $61           ; {Jump to #R$85D6 if the character is below #N$61.
 $85CE JR C,$85D6       ; }
 $85D0 CP $7B           ; {Jump to #R$85D6 if the character is not below #N$7B.
 $85D2 JR NC,$85D6      ; }
 $85D4 AND $5F          ; Keep bits 0, 1, 2, 3, 4, 6.
; Draw this character with the ROM font.
@label=Print_Character_DrawThisCharacterWithTheROMFont
*$85D6 CALL $867A       ; Call #R$867A to draw this character with the ROM
                        ; font.
 $85D9 LD A,($85B3)     ; {Count down the characters left on the line, and jump
 $85DC DEC A            ; to #R$85E6 unless the line is now full.
 $85DD JR NZ,$85E6      ; }
@label=Print_Character_StartANewLine
*$85DF LD L,$E0         ; Move the print position back to the start of the line
                        ; (#N$E0).
 $85E1 CALL $860D       ; Call #R$860D to scroll the line buffer up.
 $85E4 LD A,$20         ; Reset the count to #N$20 for the new line.
@label=Print_Character_StoreTheCharactersLeft
*$85E6 LD ($85B3),A     ; Store the result at #R$85B3.
 $85E9 LD A,($85B6)     ; Read the spare grammar byte.
 $85EC LD ($85B4),HL    ; Store #REGhl at #R$85B4.
; Draw this character with the ROM font.
 $85EF CALL $867A       ; Call #R$867A to draw this character with the ROM
                        ; font.
 $85F2 POP AF           ; {Restore #REGaf and #REGhl from the stack.
 $85F3 POP HL           ; }
 $85F4 RET              ; Return.
; Print a space.
@label=Print_Character_RubOut
*$85F5 LD A,$20         ; {Print a space over the character being rubbed out.
 $85F7 CALL $867A       ; }
 $85FA DEC L            ; {Step the print position back, add one to the
 $85FB DEC L            ; characters left, and jump back to #R$85E6 unless that
 $85FC LD A,($85B3)     ; goes past the start of the line (#N$21).
 $85FF INC A            ;
 $8600 CP $21           ;
 $8602 JR NZ,$85E6      ; }
 $8604 LD L,$FF         ; The previous pattern byte is at offset #N$FF.
 $8606 CALL $864A       ; Call #R$864A to scroll the attribute line up.
 $8609 LD A,$01         ; Continue with #N$01 now that the character is drawn.
 $860B JR $85E6         ; Jump back to #R$85E6 to draw this character.

; Print: Scroll The Line Buffer
;
; Used by the routine at #R$858B.
; .
; Scrolls the line buffer up by four rows of #N$20 bytes and fills the vacated row with
; spaces.
@label=Print_ScrollTheLineBuffer
c$860D PUSH HL       ; {Save #REGhl, #REGde, #REGbc and #REGaf, and point
 $860E PUSH DE       ; #REGhl at the screen line #N$5080.
 $860F PUSH BC       ;
 $8610 PUSH AF       ;
 $8611 LD HL,$5080   ; }
 $8614 LD DE,$5060   ; Point #REGde at the line buffer.
 $8617 LD A,$04      ; Load #N$04 before the day and night test.
 $8619 LD B,$00      ; Start the token count at zero.
@label=Print_ScrollTheLineBuffer_ScrollOneCharacterRow
*$861B PUSH HL       ; {Save the screen pointers and count #N$08 pixel rows.
 $861C PUSH DE       ;
 $861D LD C,$08      ; }
@label=Print_ScrollTheLineBuffer_Loop
*$861F PUSH HL       ; {Copy the prepared bytes.
 $8620 PUSH DE       ;
 $8621 PUSH BC       ;
 $8622 LD C,$20      ;
 $8624 LDIR          ; }
 $8626 POP BC        ; {Restore the screen pointers from the stack, step to the
 $8627 POP DE        ; next pixel row, and jump back to #R$861F until the count
 $8628 POP HL        ; in #REGc reaches zero.
 $8629 INC H         ;
 $862A INC D         ;
 $862B DEC C         ;
 $862C JR NZ,$861F   ; }
 $862E POP DE        ; {Restore the saved screen pointers from the stack and
 $862F POP HL        ; set #REGbc to #N($20), one screen row.
 $8630 LD C,$20      ; }
 $8632 ADD HL,BC     ; Step one screen row, #N$20 bytes.
 $8633 EX DE,HL      ; Swap the two screen pointers.
 $8634 ADD HL,BC     ; Step the other pointer one screen row, #N$20 bytes.
 $8635 EX DE,HL      ; Swap the two screen pointers.
 $8636 DEC A         ; {Jump back to #R$861B until the row count in #REGa
 $8637 JR NZ,$861B   ; reaches zero.}
 $8639 LD B,$20      ; Count #N$20 passes.
 $863B LD HL,$50E0   ; Point #REGhl at the attribute line.
 $863E LD A,$20      ; Use the character ' '.
; Blank the new line with spaces.
@label=Print_ScrollTheLineBuffer_BlankTheNewLine
*$8640 CALL $867A    ; Call #R$867A to draw this character with the ROM font.
 $8643 DJNZ $8640    ; Loop back to #R$8640 until #N$20 runs out.
 $8645 POP AF        ; {Restore #REGaf, #REGbc, #REGde and #REGhl from the
 $8646 POP BC        ; stack.
 $8647 POP DE        ;
 $8648 POP HL        ; }
 $8649 RET           ; Return.

; Print: Scroll The Attribute Line
;
; Used by the routine at #R$858B.
; .
; Scrolls the attribute line up by five rows and restores the pointers.
@label=Print_ScrollTheAttributeLine
c$864A PUSH HL       ; {Point at #N$50C0.
 $864B PUSH DE       ;
 $864C PUSH BC       ;
 $864D PUSH AF       ;
 $864E LD HL,$50C0   ; }
 $8651 LD DE,$50E0   ; Point #REGde at the attribute line.
 $8654 LD A,$05      ; Load #N$05 before the day and night test.
@label=Print_ScrollTheAttributeLine_ScrollOneRow
*$8656 PUSH HL       ; {Count #N$08 passes.
 $8657 PUSH DE       ;
 $8658 LD B,$08      ; }
@label=Print_ScrollTheAttributeLine_CopyThePreparedBytes
*$865A PUSH HL       ; {Copy the prepared bytes.
 $865B PUSH DE       ;
 $865C PUSH BC       ;
 $865D LD BC,$0020   ;
 $8660 LDIR          ; }
 $8662 POP BC        ; {Restore #REGbc, #REGde and #REGhl from the stack, and
 $8663 POP DE        ; step #REGhl down one pixel row.
 $8664 POP HL        ;
 $8665 INC H         ; }
 $8666 INC D         ; Step #REGde down one pixel row.
 $8667 DJNZ $865A    ; Loop back to #R$865A until all #N$08 pixel rows are
                     ; done.
 $8669 POP DE        ; {Restore the screen pointers and step #REGhl back one
 $866A POP HL        ; row.
 $866B LD BC,$FFE0   ;
 $866E ADD HL,BC     ; }
 $866F EX DE,HL      ; Swap the two screen pointers.
 $8670 ADD HL,BC     ; Step the other pointer up one screen row.
 $8671 EX DE,HL      ; Swap the two screen pointers.
 $8672 DEC A         ; {Jump back to #R$8656 until the row count in #REGa
 $8673 JR NZ,$8656   ; reaches zero.}
 $8675 POP AF        ; {Restore #REGaf, #REGbc, #REGde and #REGhl from the
 $8676 POP BC        ; stack.
 $8677 POP DE        ;
 $8678 POP HL        ; }
 $8679 RET           ; Return.

; Print: ROM Font
;
; Used by the routines at #R$858B and #R$860D.
; .
; Draws one character with the Spectrum ROM font.
;
; A ASCII value of character to print
;
; Prints using the standard ZX Spectrum #SKOOLKID$3D00(CHARSET).
@label=Print_RomFont
c$867A PUSH AF       ; {Save #REGaf, #REGbc, #REGde and #REGhl, subtract
 $867B PUSH BC       ; #N($20), and multiply the offset by eight.
 $867C PUSH DE       ;
 $867D PUSH HL       ;
 $867E SUB $20       ;
 $8680 LD L,A        ;
 $8681 LD H,$00      ;
 $8683 ADD HL,HL     ;
 $8684 ADD HL,HL     ;
 $8685 ADD HL,HL     ; }
 $8686 LD DE,$3D00   ; {Calculate font graphic data address using
 $8689 ADD HL,DE     ; #SKOOLKID$3D00(CHARSET) + offset.}
 $868A EX DE,HL      ; {Store the result in #REGde, restore the screen location
 $868B POP HL        ; to #REGhl.
 $868C PUSH HL       ; }
 $868D LD B,$08      ; Set a counter for #N$08 lines.
@label=Print_RomFont_Loop
*$868F LD A,(DE)     ; {Fetch the font byte and copy it to the screen.
 $8690 LD (HL),A     ; }
 $8691 INC DE        ; Move onto the next font data byte.
 $8692 INC H         ; Move the screen pointer down one row.
 $8693 DJNZ $868F    ; Decrease counter by one and loop back to #R$868F until
                     ; counter is zero.
 $8695 POP HL        ; {Move the screen pointer across one column, ready for
 $8696 POP DE        ; printing the next character.
 $8697 POP BC        ;
 $8698 POP AF        ;
 $8699 INC L         ; }
 $869A RET           ; Return.

; Print: Write A Character To The Screen
;
; Writes one character into the text window, scrolling when the line
; is full.
@label=PrintWriteACharacterToTheScreen
c$869B DEFB $00      ;
 $869C DEFW $0000    ;
 $869E DEFB $00      ;
 $869F DEFB $00      ;
 $86A0 DEFB $00      ;
; This entry point is used by the routine at #R$858B.
*$86A1 PUSH HL       ; {Save #REGhl, #REGbc and #REGaf, and bring #REGhl back
 $86A2 PUSH BC       ; from #R$869C.
 $86A3 PUSH AF       ;
 $86A4 LD HL,($869C) ; }
 $86A7 LD A,($869E)  ; Read the print column.
 $86AA LD C,A        ; Copy the result into #REGc.
; Test this flag.
 $86AB LD A,($86A0)  ; {Jump to #R$86C6 if *#R$86A0 is not zero.
 $86AE AND A         ;
 $86AF JR NZ,$86C6   ; }
; Test this flag.
 $86B1 LD A,($869F)  ; {Jump to #R$86C6 if *#R$869F is zero.
 $86B4 AND A         ;
 $86B5 JR Z,$86C6    ; }
 $86B7 LD B,A        ; Copy the result into #REGb.
@label=PrintWriteACharacterToTheScreen_Loop
*$86B8 LD A,$20      ; Use the character ' '.
; Draw this character with the game font.
 $86BA CALL $87C9    ; Call #R$87C9 to draw this character with the game's
                     ; font.
 $86BD LD A,($869B)  ; Read the room left on the line at #R$869B.
 $86C0 DEC A         ; Drop one from the room left on the line.
 $86C1 LD ($869B),A  ; Update the room left on the line.
 $86C4 DJNZ $86B8    ; Loop back to #R$86B8 until the space count runs out.
@label=PrintWriteACharacterToTheScreen_TestForAReturn
*$86C6 POP AF        ; {Restore the character from the stack, keeping a copy
 $86C7 PUSH AF       ; there.}
 $86C8 CP $0D        ; {Jump to #R$870D unless the character is #N$0D.
 $86CA JR NZ,$870D   ; }
 $86CC LD A,$01      ; {Set the capitalise-the-next-letter flag after a
 $86CE LD ($B704),A  ; carriage return.}
@label=PrintWriteACharacterToTheScreen_ClearTheFlag
*$86D1 XOR A         ; {Clear *#R$86A0.
 $86D2 LD ($86A0),A  ; }
 $86D5 CALL $8B22    ; Call #R$8B22 to copy this text line to the ZX printer.
 $86D8 PUSH BC       ; Save #REGbc.
; Test how many words will be accepted.
 $86D9 LD A,($B716)  ; {Jump to #R$86F3 if *#R$B716 is not zero.
 $86DC AND A         ;
 $86DD JR NZ,$86F3   ; }
 $86DF LD BC,$8000   ; Point #REGbc at #R$8000.
@label=PrintWriteACharacterToTheScreen_PollKeys
*$86E2 XOR A         ; Select every keyboard row.
 $86E3 IN A,($FE)    ; Read port #N$FE into #REGa.
 $86E5 AND $1F       ; {Jump to #R$86F7 unless the low five bits are all set.
 $86E7 CP $1F        ;
 $86E9 JR NZ,$86F7   ; }
 $86EB DEC BC        ; {Loop back to #R$86E2 until the keyboard timeout reaches
 $86EC LD A,B        ; zero.
 $86ED OR C          ;
 $86EE JR NZ,$86E2   ; }
 $86F0 POP BC        ; {Jump to #R$8701 to scroll line.
 $86F1 JR $8701      ; }
@label=PrintWriteACharacterToTheScreen_CountDownTheWords
*$86F3 DEC A         ; Count down how many words will be accepted.
 $86F4 LD ($B716),A  ; Update *#R$B716.
@label=PrintWriteACharacterToTheScreen_DropTheTimeout
*$86F7 POP BC        ; {Drop the timeout and select every keyboard row.
@label=PrintWriteACharacterToTheScreen_WaitForRelease
*$86F8 XOR A         ; }
 $86F9 IN A,($FE)    ; Read port #N$FE into #REGa.
 $86FB AND $1F       ; {Jump back to #R$86F8 unless the low five bits are all
 $86FD CP $1F        ; set.
 $86FF JR NZ,$86F8   ; }
@label=PrintWriteACharacterToTheScreen_PointAtTheTextLine
*$8701 LD HL,$5020   ; Point #REGhl at the text line.
 $8704 LD C,$01      ; One pixel row of the character.
 $8706 CALL $876B    ; Call #R$876B to scroll line.
 $8709 LD A,$2A      ; Reset the room left on the line to #N$2A.
 $870B JR $8753      ; Jump to #R$8753 to store the room left on the line.
@label=PrintWriteACharacterToTheScreen_TestBackspace
*$870D CP $08        ; {Jump to #R$8722 if the character is not #N$08.
 $870F JR NZ,$8722   ; }
 $8711 CALL $8761    ; Call #R$8761 to wrap the print column.
 $8714 LD A,$20      ; Use the character ' '.
; Draw this character with the game font.
 $8716 CALL $87C9    ; Call #R$87C9 to draw this character with the game's
                     ; font.
 $8719 CALL $8761    ; Call #R$8761 to wrap the print column.
 $871C LD A,($869B)  ; Read the room left on the line at #R$869B.
 $871F INC A         ; Count one more character on the line.
 $8720 JR $8753      ; Jump to #R$8753 to store the room left on the line.
@label=PrintWriteACharacterToTheScreen_TestForALetter
*$8722 CP $41        ; {Jump to #R$872C if the character is below #N$41.
 $8724 JR C,$872C    ; }
 $8726 CP $5B        ; {Jump to #R$872C if the character is #N$5B or above.
 $8728 JR NC,$872C   ; }
 $872A OR $20        ; Merge in #N$20.
@label=PrintWriteACharacterToTheScreen_TestCapitalise
*$872C PUSH HL       ; {Point #REGhl at the capitalise-the-next-letter flag.
 $872D LD HL,$B704   ; }
 $8730 INC (HL)      ; {Test the capitalise-the-next-letter flag without
 $8731 DEC (HL)      ; changing it.}
 $8732 JR Z,$8740    ; Jump to #R$8740 if the next letter should not be
                     ; capitalised.
 $8734 CP $61        ; {Jump to #R$8740 if the character is below #N$61.
 $8736 JR C,$8740    ; }
 $8738 CP $7B        ; {Jump to #R$8740 if it is #N$7B or above.
 $873A JR NC,$8740   ; }
 $873C RES 5,A       ; Clear bit 5.
 $873E LD (HL),$00   ; Clear the capitalise-the-next-letter flag once the
                     ; letter is upper case.
@label=PrintWriteACharacterToTheScreen_TestForAFullStop
*$8740 CP $2E        ; {Jump to #R$8745 unless it is #N$2E.
 $8742 JR NZ,$8745   ; }
 $8744 INC (HL)      ; A full stop bumps the capitalise-the-next-letter flag.
@label=PrintWriteACharacterToTheScreen_DrawTheGlyph
*$8745 POP HL        ; Pop the screen address and call #R$87C9 to draw the
                     ; glyph.
; Draw this character with the game font.
 $8746 CALL $87C9    ;
 $8749 LD ($86A0),A  ; {Store the column and jump back to #R$86D1 when the room
 $874C LD A,($869B)  ; left on the line reaches zero.
 $874F DEC A         ;
 $8750 JP Z,$86D1    ; }
@label=PrintWriteACharacterToTheScreen_StoreTheRoomLeft
*$8753 LD ($869B),A  ; Update the room left on the line.
 $8756 LD ($869C),HL ; Store #REGhl at #R$869C.
 $8759 LD A,C        ; {Store the print column.
 $875A LD ($869E),A  ; }
 $875D POP AF        ; {Restore #REGaf, #REGbc and #REGhl from the stack.
 $875E POP BC        ;
 $875F POP HL        ; }
 $8760 RET           ; Return.

; Print: Wrap The Column
;
; Used by the routine at #R$869B.
; .
; Wraps the print column. A column below #N$06 is moved on by #N($08), and the count drops
; by one.
@label=Print_WrapTheColumn
c$8761 LD A,C        ; {Take #N$06 off the column and return if it did not go
 $8762 SUB $06       ; below zero.
 $8764 LD C,A        ;
 $8765 RET NC        ; }
 $8766 ADD A,$08     ; Otherwise add #N$08 to it.
 $8768 LD C,A        ; Copy the result into #REGc.
 $8769 DEC L         ; Drop one from the count.
 $876A RET           ; Return.

; Scroll Line
;
; Used by the routine at #R$869B.
; .
; Scrolls the text window up by one line.
@label=ScrollLine
c$876B PUSH AF       ; {Save #REGaf, #REGbc, #REGhl and #REGde, and point
 $876C PUSH BC       ; #REGhl at screen line #N$4020.
 $876D PUSH HL       ;
 $876E PUSH DE       ; }
; Set up the initial values.
 $876F LD HL,$4020   ;
 $8772 LD DE,$4000   ; Point #REGde at the display file.
 $8775 LD A,$11      ; Load #N$11 for the scroll.
 $8777 LD B,$00      ; Start the pass count at zero.
@label=ScrollLine_Loop
*$8779 PUSH HL       ; {Save the screen pointers and count #N$08 pixel rows.
 $877A PUSH DE       ;
 $877B LD C,$08      ; }
@label=ScrollLine_Line
*$877D PUSH HL       ; {Save the row addresses and the pixel count, and set the
 $877E PUSH DE       ; byte count to #N$20.
 $877F PUSH BC       ;
 $8780 LD C,$20      ; }
 $8782 LDIR          ; Copy the row up one.
 $8784 POP BC        ; {Increment the MSB of #REGhl and #REGde by one to point
 $8785 POP DE        ; to the next line down.
 $8786 POP HL        ;
 $8787 INC H         ;
 $8788 INC D         ; }
 $8789 DEC C         ; Drop one pixel row.
 $878A JR NZ,$877D   ; Jump back to #R$877D unless the whole line is moved
                     ; (i.e. #REGc is now zero).
 $878C POP DE        ; {Restore the saved screen pointers from the stack and
 $878D POP HL        ; set #REGbc to #N($20), one screen row.
 $878E LD C,$20      ; }
 $8790 ADD HL,BC     ; Step one screen row, #N$20 bytes.
 $8791 EX DE,HL      ; Swap the two screen pointers.
 $8792 ADD HL,BC     ; Step the other pointer one screen row, #N$20 bytes.
 $8793 EX DE,HL      ; Swap the two screen pointers.
 $8794 PUSH AF       ; {Save #REGaf and use #REGd as the next byte.
 $8795 LD A,D        ; }
 $8796 AND %00000111 ; Keep the selected bits.
 $8798 JR Z,$879E    ; Skip to #R$879E if zero.
; Handle changing the target between each screen buffer area.
 $879A LD A,D        ; Take the high byte of #REGde.
 $879B ADD A,$07     ; Add #N$07 onto it.
 $879D LD D,A        ; Store the row address past the screen-third gap.
@label=ScrollLine_SkipDE
*$879E LD A,H        ; Take the high byte of the screen address.
 $879F AND %00000111 ; Keep the selected bits.
 $87A1 JR Z,$87A7    ; Skip to #R$87A7 if zero.
; Handle changing the source between each screen buffer area.
 $87A3 LD A,H        ; Take the high byte of the screen address.
 $87A4 ADD A,$07     ; Add #N$07 onto it.
 $87A6 LD H,A        ; Store the other row address past the screen-third gap.
@label=ScrollLine_SkipHL
*$87A7 POP AF        ; {Restore the line counter and drop one line.
 $87A8 DEC A         ; }
 $87A9 JR NZ,$8779   ; Loop back to #R$8779 until the line counter is zero.
; Handle the attributes.
 $87AB LD HL,$5820   ; {Move the attributes up one character block.
 $87AE LD DE,$5800   ;
 $87B1 LD BC,$0220   ;
 $87B4 LDIR          ; }
; This creates the indent.
 $87B6 LD B,$2A      ; Set a counter for #N($2A,$02,$03,$01,$01)($) spaces.
 $87B8 LD HL,$5020   ; Set the target screen location to
                     ; #N($5020,$02,$03,$01,$01)($).
 $87BB LD C,$01      ; One column of the scrolled line.
 $87BD LD A,$20      ; Use the character ' '.
@label=ScrollLine_Spacing
*$87BF CALL $87C9    ; Call #R$87C9 to draw this character with the game's
                     ; font.
 $87C2 DJNZ $87BF    ; Decrease counter by one and loop back to #R$87BF until
                     ; counter is zero.
; Housekeeping and return.
 $87C4 POP DE        ; {Restore #REGde, #REGhl, #REGbc and #REGaf from the
 $87C5 POP HL        ; stack.
 $87C6 POP BC        ;
 $87C7 POP AF        ; }
 $87C8 RET           ; Return.

; Print: Proportional Character
;
; Used by the routines at #R$869B and #R$876B.
; .
; Draws one character with the game's own font.
;
; A ASCII value
; C Bit offset
; HL Target screen location
;
; Prints using the custom #R$8822(font).
@label=Print_ProportionalCharacter
c$87C9 PUSH AF       ; {Save #REGaf, #REGbc, #REGde and #REGhl, and put #REGa
 $87CA PUSH BC       ; in #REGhl.
 $87CB PUSH DE       ;
 $87CC PUSH HL       ; }
; Calculate font graphic address, some examples would be;
; #TABLE(default,centre,centre,centre,centre,centre)
; { =h Letter | =h ASCII | =h * 8 | =h Sum | =h Font Graphic Address }
; { #LET(id=$21) "#CHR({id})" | #N({id},$02,$03,$01,$01)($) | #N(#EVAL({id}*$08),$02,$03,$01,$01)($) | (#N({id},$02,$03,$01,$01)($)*#N$08)+#N$8722 | #R(#EVAL($8722+({id}*$08))) }
; { #LET(id=$41) "#CHR({id})" | #N({id},$02,$03,$01,$01)($) | #N(#EVAL({id}*$08),$02,$03,$01,$01)($) | (#N({id},$02,$03,$01,$01)($)*#N$08)+#N$8722 | #R(#EVAL($8722+({id}*$08))) }
; { #LET(id=$61) "#CHR({id})" | #N({id},$02,$03,$01,$01)($) | #N(#EVAL({id}*$08),$02,$03,$01,$01)($) | (#N({id},$02,$03,$01,$01)($)*#N$08)+#N$8722 | #R(#EVAL($8722+({id}*$08))) }
; TABLE#
 $87CD LD L,A        ;
 $87CE LD H,$00      ;
; Calculate font graphic data address.
 $87D0 ADD HL,HL     ; {Multiply the offset by #N$08 and add the table base.
 $87D1 ADD HL,HL     ;
 $87D2 ADD HL,HL     ;
 $87D3 LD DE,$8722   ;
 $87D6 ADD HL,DE     ; }
 $87D7 EX DE,HL      ; {Store the result in #REGde, restore the screen location
 $87D8 POP HL        ; to #REGhl.
 $87D9 PUSH HL       ; }
 $87DA LD B,$08      ; Set a counter for #N$08 lines.
@label=Print_ProportionalCharacter_Loop
*$87DC LD A,(DE)     ; Read the next byte of the font graphic data.
 $87DD PUSH BC       ; {Jump to #R$87EB if the count in #REGc is zero.
 $87DE DEC C         ;
 $87DF INC C         ;
 $87E0 LD B,$FF      ;
 $87E2 JR Z,$87EB    ; }
@label=Print_ProportionalCharacter_Shift
*$87E4 SRL A         ; Shift the font graphic data right.
 $87E6 SRL B         ; Shift the mask data right.
 $87E8 DEC C         ; Drop one from the count.
 $87E9 JR NZ,$87E4   ; Loop back to #R$87E4 until the count in #REGc runs out.
@label=Print_ProportionalCharacter_SkipShift
*$87EB LD C,A        ; Stash the font graphic data in #REGc.
 $87EC LD A,B        ; Take the mask that was built in #REGb.
 $87ED CPL           ; Invert the mask so the new pixels replace the old ones.
 $87EE AND (HL)      ; Merge the mask with the existing data in the screen
                     ; buffer.
 $87EF OR C          ; OR the font graphic data.
 $87F0 LD (HL),A     ; Copy the processed font graphic data to the screen.
 $87F1 POP BC        ; {Jump to #R$880E if the count in #REGc is zero.
 $87F2 DEC C         ;
 $87F3 INC C         ;
 $87F4 JR Z,$880E    ; }
 $87F6 PUSH BC       ; {Eight pixel bits in a character row. Subtract how many
 $87F7 LD A,$08      ; have already been shifted.}
 $87F9 SUB C         ; Take the shift count off #N$08.
 $87FA LD C,A        ; Copy the result into #REGc.
 $87FB LD A,(DE)     ; Read the font byte.
 $87FC LD B,$FF      ; Start the mask with every bit set.
@label=Print_ProportionalCharacter_ShiftTheMask
*$87FE SLA A         ; {Shift the character byte and the mask, and loop until
 $8800 SLA B         ; #REGc is zero.
 $8802 DEC C         ;
 $8803 JR NZ,$87FE   ; }
 $8805 LD C,A        ; Copy the result into #REGc.
 $8806 LD A,B        ; Take the mask into #REGa.
 $8807 CPL           ; Complement #REGa.
 $8808 INC HL        ; Step to the next screen byte.
 $8809 AND (HL)      ; {Mask the screen byte and merge the character bits.
 $880A OR C          ; }
 $880B LD (HL),A     ; Store the merged byte on screen.
 $880C DEC HL        ; {Step back one byte through the text.
 $880D POP BC        ; }
@label=Print_ProportionalCharacter_StepDownARow
*$880E INC DE        ; Step to the next byte beside it.
 $880F INC H         ; Step the screen address down one pixel row.
 $8810 DJNZ $87DC    ; Decrease counter by one and loop back to #R$87DC until
                     ; counter is zero.
 $8812 POP HL        ; {Jump to #R$881F if the column plus #N$06 is below
 $8813 POP DE        ; #N$08.
 $8814 POP BC        ;
 $8815 LD A,C        ;
 $8816 ADD A,$06     ;
 $8818 CP $08        ;
 $881A JR C,$881F    ; }
 $881C SUB $08       ; Take #N$08 off the column plus #N$06.
 $881E INC L         ; Step to the next character cell on this line.
@label=Print_ProportionalCharacter_StoreTheColumn
*$881F LD C,A        ; Copy the result into #REGc.
 $8820 POP AF        ; Restore #REGaf from the stack.
 $8821 RET           ; Return.

; Main Font
;
; #N$60 characters of #N$08 bytes each, from #N$20 to #N$7F. Read by #R$87C9,
; which adds #N$08 times the character code to #N($8722), so character #N$20 is
; the first.
;
; .
;
