c$8E85 AND A          ; {Jump to #R$8EA7 if #REGa is zero.
 $8E86 JR Z,$8EA7     ; }
; Find the object's record.
 $8E88 CALL $9BCA     ; Call #R$9BCA to locate object.
 $8E8B LD A,(IX+$07)  ; Read the attribute flags from the object record.
 $8E8E AND $28        ; Keep bits 3, 5.
 $8E90 JR Z,$8ECE     ; Jump to #R$8ECE when the object is neither broken nor
                      ; open.
; Test whose turn it is.
 $8E92 LD A,($B6EA)   ; {Jump to #R$8E9E if *#R$B6EA is not zero.
 $8E95 AND A          ;
 $8E96 JR NZ,$8E9E    ; }
 $8E98 BIT 7,(IX+$04) ; {Jump to #R$8ECE if bit 7 of the object's second flag
 $8E9C JR NZ,$8ECE    ; is set.}
@label=Action_CheckTheObjectFlags_ReadTheMoveVolume
*$8E9E LD A,($8D9C)   ; Read the move volume.
 $8EA1 LD B,(IX+$02)  ; Read the volume from the object record.
 $8EA4 SUB B          ; {Jump to #R$8ECA if the move volume is not below the
 $8EA5 JR NC,$8ECA    ; object's volume.}
@label=Action_CheckTheObjectFlags_ReadTheLocation
*$8EA7 LD A,($8D9B)   ; Read the current location.
 $8EAA LD B,A         ; Copy the result into #REGb.
; Find the location's record.
 $8EAB CALL $9BB1     ; Call #R$9BB1 to locate location.
 $8EAE LD ($8D99),IX  ; {Save the location record pointer at #R$8D99, and jump
 $8EB2 LD A,$FF       ; to #R$8EC4 if this location's volume byte is #N$FF.
 $8EB4 CP (IX+$01)    ;
 $8EB7 JR Z,$8EC4     ; }
 $8EB9 LD A,B         ; Use the current location again.
 $8EBA CALL $9C41     ; Call #R$9C41 to find an exit.
 $8EBD LD C,A         ; {Jump to #R$8EC6 if the move volume is not below the
 $8EBE LD A,($8D9C)   ; current location.
 $8EC1 SUB C          ;
 $8EC2 JR NC,$8EC6    ; }
