 $8F5B LD A,(IX+$00)   ; Read this exit's direction.
 $8F5E LD ($B6E7),A    ; Update *#R$B6E7.
 $8F61 LD A,$FF        ; {Write #N$FF to *#R$B6E8.
 $8F63 LD ($B6E8),A    ; }
 $8F66 JP $8DAB        ; Jump back to #R$8DAB to carry on with the move.
; Reached through the action list of #OBJECT($13,$01,$01)($) for action
