 $8C41 DEFB $0D,$4C,$4B,$4A,$48 ; #FOR$00,$04||n|#IF(#PEEK(#PC+n)>$00)(#CHR(#PEEK(#PC+n)),--)|,
                                ; ||
 $8C46 DEFB $02,$00,$2E,$2C,$42 ; #FOR$00,$04||n|#IF(#PEEK(#PC+n)>$00)(#CHR(#PEEK(#PC+n)),--)|,
                                ; ||

; Action: Look
;
; Describes where the current character is. The player gets the place
; name; another character is reported instead.
; Reached through the action table at #R$C730, dispatched by #R$950F.
;
; .
;
; If the message is held back, the place is not described.
@label=Action_Look
c$8C4B CALL $9D44    ; Call #R$9D44. If the message is held back, the place is
                     ; not described.
 $8C4E LD IX,($B70C) ; Use the record of the character whose turn it is.
 $8C52 LD A,(IX+$01) ; Read where this character is.
 $8C55 CP $FF        ; {Jump to #R$8C95 if this character is not inside another
 $8C57 JR Z,$8C95    ; object.}
 $8C59 LD HL,$0080   ; {Store #N($0080,$04,$04) in #N$AFFD.
 $8C5C LD ($AFFD),HL ; }
 $8C5F LD HL,$AFFC   ; Point at the message "You are in[0x16]" (#R$AFFC).
 $8C62 CALL $72DD    ; Call #R$72DD to print message.
 $8C65 PUSH IX       ; {Read where this character is.
 $8C67 LD A,(IX+$01) ; }
; Find the object's record.
 $8C6A CALL $9BCA    ; Call #R$9BCA to locate object.
; Describe the place.
 $8C6D CALL $A09D    ; Call #R$A09D to print the exits for this location.
 $8C70 LD E,(IX+$08) ; Read the name token from the object record.
 $8C73 LD A,(IX+$09) ; Read the name token's high byte from the object record.
 $8C76 AND $0F       ; {Keep the low nibble of byte 9 of this object.
 $8C78 LD D,A        ; }
; Print the token in #REGde.
 $8C79 CALL $74C1    ; Call #R$74C1 to print a dictionary token.
; Print a full stop.
 $8C7C LD A,$2E      ; {Print a full stop after the place name.
 $8C7E CALL $858B    ; }
; Print a newline.
 $8C81 CALL $8583    ; Call #R$8583 to print a newline.
 $8C84 LD HL,$B003   ; Point at the message "You see :[0x14]" (#R$B003).
 $8C87 CALL $72DD    ; Call #R$72DD to print message.
 $8C8A POP IX        ; {Read where this object is from the object record.
 $8C8C LD A,(IX+$01) ; }
 $8C8F LD B,(IX+$10) ; Read the location from the object record.
 $8C92 JP $9FAF      ; Jump to #R$9FAF to list what is in this place.
@label=Action_Look_DescribeTheLocation
*$8C95 LD A,(IX+$10) ; Read the location from the object record.
 $8C98 JP $9630      ; Jump to #R$9630 to describe this location.

; Action: Refuse If Not Carried
;
; Used by the routines at #R$8CA6 and #R$948D.
; .
; Refuses the verb when the object is not carried, and the player sees "You are not
; carrying it".
;
; .
;
; Test whether the object is being carried.
@label=Action_RefuseIfNotCarried
c$8C9B CALL $9C78    ; Call #R$9C78 to test whether the object is carried.
 $8C9E RET C         ; Return if the object is carried (carry set).
 $8C9F POP HL        ; {Point at the message "You are not carrying it[0x15]".
 $8CA0 LD HL,$ADF1   ; }
 $8CA3 JP $72DD      ; Jump back to #R$72DD to print "You are not carrying it".

; Action: Put Down
;
; Puts the current object down in this place. A fluid that is dropped
; evaporates.
; Reached through the action table at #R$C730, dispatched by #R$950F.
;
; .
;
; Refuse the verb when the object is not carried.
@label=Action_Putdown
c$8CA6 CALL $8C9B      ; Call #R$8C9B to refuse the verb when the object is not
                       ; carried.
; If the message is held back, the object is not put down.
 $8CA9 CALL $9D44      ; Call #R$9D44. If the message is held back, the object
                       ; is not put down.
 $8CAC LD IX,($B708)   ; Read *#R$B708.
 $8CB0 LD A,(IX+$01)   ; Read where this object is from the object record.
 $8CB3 CP $12          ; {Jump to #R$8CBB if where this object is is not #N$12.
 $8CB5 JR NZ,$8CBB     ; }
 $8CB7 LD IX,$C366     ; Point #REGix at #OBJECT($12,$01,$01)($).
@label=Action_Putdown_DropTheObject
*$8CBB PUSH IX         ; {Read *#R$B70C.
 $8CBD LD IX,($B70C)   ; }
 $8CC1 LD A,(IX+$01)   ; Read where the character is.
 $8CC4 POP IX          ; {Put the object where the character is, and return
 $8CC6 LD (IX+$01),A   ; unless it is a fluid.
 $8CC9 BIT 1,(IX+$07)  ;
 $8CCD RET Z           ; }
 $8CCE LD (IX+$10),$00 ; Clear the object's location.
 $8CD2 LD HL,$B142     ; Point at the message "[0x00]
                       ; evaporate(s|d|ing|es)[0x15]" (#R$B142).
 $8CD5 LD DE,$0008     ; {Step the pointer on by #N$08 bytes.
 $8CD8 ADD IX,DE       ; }
 $8CDA PUSH IX         ; {Save the name pointer and call #R$72DD to print the
 $8CDC CALL $72DD      ; message.}
 $8CDF RET             ; Return.
; Reached through the action lists of #OBJECT($1F,$01,$01)($),
; #OBJECT($21,$01,$01)($), #OBJECT($25,$01,$01)($) and #OBJECT($29,$01,$01)($)
; for action #N($14), dispatched by #R$9B6C.
 $8CE0 LD A,($B6E8)    ; Read *#R$B6E8.
 $8CE3 LD HL,$B6E9     ; Point #REGhl at the second object.
 $8CE6 CALL $9C7E      ; Call #R$9C7E to test whether the object is inside the
                       ; second object.
 $8CE9 LD HL,$AFB5     ; {Point at "[0x07] is not in[0x09]" (#R$AFB5) and jump
 $8CEC JP NZ,$72DD     ; back to #R$72DD if #R$9C7E found the object is not
                       ; inside the second object.}
 $8CEF JR $8D3C        ; Jump to #R$8D3C to locate object.

; Action: Add The Object's Mass
;
; Used by the routines at #R$8D33 and #R$8FF5.
; .
; Adds the current object's mass to what the character is carrying. Too much and the player
; sees "You are carrying too much".
@label=Action_AddTheObjectMass
c$8CF1 LD IX,($B708)  ; Read *#R$B708.
 $8CF5 LD A,($B6E8)   ; Read *#R$B6E8.
 $8CF8 CALL $9CED     ; Call #R$9CED to total the mass inside the object.
 $8CFB ADD A,(IX+$03) ; Add this object's mass onto the count.
 $8CFE JR NC,$8D02    ; Jump to #R$8D02 if the sum did not overflow.
 $8D00 LD A,$FF       ; Cap the total mass at #N$FF.
@label=Action_AddTheObjectMass_Putdown_CopyTheResult
*$8D02 LD B,A         ; Copy the result into #REGb.
 $8D03 LD IY,($B70C)  ; Read *#R$B70C.
 $8D07 LD A,(IY+$03)  ; Read the mass from #REGiy.
 $8D0A SUB B          ; {Point #REGhl at #R$AE04 and jump to #R$8D20 if the
 $8D0B LD HL,$AE04    ; mass of the object at #R$B70C is below the total in
 $8D0E JR C,$8D20     ; #REGb.}
 $8D10 PUSH AF        ; {Read *#R$B6EA.
 $8D11 LD A,($B6EA)   ; }
 $8D14 CALL $9CED     ; Call #R$9CED to total the mass inside the character.
 $8D17 LD B,A         ; Copy the result into #REGb.
 $8D18 POP AF         ; {Subtract the count in #REGb from the value saved on
 $8D19 SUB B          ; the stack.}
 $8D1A JP P,$8D25     ; Jump to #R$8D25 if the result is not negative.
 $8D1D LD HL,$AE0C    ; Point at the message "You are carrying too much"
                      ; (#R$AE0C).
@label=Action_AddTheObjectMass_Putdown_PrintTheMessage
*$8D20 EX (SP),HL     ; Swap #REGhl with the address on the stack.
 $8D21 POP HL         ; {Jump back to #R$72DD to print message.
 $8D22 JP $72DD       ; }

; Action: Stop If The Object Is Fixed
;
; Used by the routines at #R$8CF1, #R$9213 and #R$93DA.
; .
; Stops the verb when the object is fixed or a fluid, and says that will not
; work.
@label=Action_StopIfTheObjectIsFixed
c$8D25 CALL $9246     ; Call #R$9246 to point at the current object and see
                      ; whether its copy count is #N$01.
 $8D28 JR NZ,$8D2F    ; Jump to #R$8D2F if the copy count is not #N$01.
 $8D2A BIT 1,(IX+$07) ; {Return if the object is not a fluid.
 $8D2E RET Z          ; }
@label=Action_StopIfTheObjectIsFixed_SayThatWillNotWork
*$8D2F POP HL         ; {Jump to #R$9F76 to say that will not work.
 $8D30 JP $9F76       ; }

; Action: Pick Up
;
; Used by the routine at #R$A248.
; .
; Picks the current object up, when it is here and can be carried.
; Reached through the action table at #R$C730, dispatched by #R$950F.
;
; .
;
; Test whether the object is being carried.
@label=Action_Pickup
c$8D33 CALL $9C78    ; Call #R$9C78 to test whether the object is carried.
 $8D36 LD HL,$AE11   ; Point at the message "You are already
                     ; carrying[0x07][0x15]" (#R$AE11).
 $8D39 JP C,$72DD    ; Jump back to #R$72DD if #R$9C78 found the object
                     ; carried, to print "You are already carrying[0x07]".
; This entry point is used by the routine at #R$8CA6.
*$8D3C CALL $8CF1    ; Call #R$8CF1 to add the object's mass.
 $8D3F LD A,($B6EA)  ; Read *#R$B6EA.
; Find the object's record.
@label=Action_Pickup_Loop
*$8D42 CALL $9BCA    ; Call #R$9BCA to locate object.
 $8D45 LD A,($B6E8)  ; Read *#R$B6E8.
 $8D48 CP (IX+$01)   ; {Jump to #R$9F76 if the character is inside the current
 $8D4B JP Z,$9F76    ; object.}
 $8D4E LD A,(IX+$01) ; Read where this object is from the object record.
 $8D51 CP $FF        ; {Jump back to #R$8D42 if where this object is is not
 $8D53 JR NZ,$8D42   ; #N$FF.}
 $8D55 LD IX,($B708) ; Read *#R$B708.
; If the message is held back, the object is not picked up.
 $8D59 CALL $9D44    ; Call #R$9D44. If the message is held back, the object is
                     ; not picked up.
 $8D5C LD A,(IX+$01) ; Read where this object is from the object record.
 $8D5F CP $12        ; Compare where this object is with #N$12.
 $8D61 LD A,($B6EA)  ; Read *#R$B6EA.
 $8D64 JR Z,$8D6A    ; Jump to #R$8D6A if where this object is is #N$12.
 $8D66 LD (IX+$01),A ; Update where this object is.
 $8D69 RET           ; Return.
@label=Action_Pickup_TakeTheRopeInstead
*$8D6A LD ($C367),A  ; The object is tied to the rope, so give the rope (#N$12)
                     ; to the character instead.
 $8D6D RET           ; Return.

; Location Percentage Completion Table
;
; Read by #R$8D9D.
;
; .
;
; #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
@label=PercentageLocationTable
b$8D6E DEFB $04      ; Location ID.
 $8D6F DEFW $0019    ; Percentage to add.
; #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
 $8D71 DEFB $07      ; Location ID.
 $8D72 DEFW $0032    ; Percentage to add.
; #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
 $8D74 DEFB $0B      ; Location ID.
 $8D75 DEFW $0019    ; Percentage to add.
; #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
 $8D77 DEFB $16      ; Location ID.
 $8D78 DEFW $0019    ; Percentage to add.
; #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
 $8D7A DEFB $0D      ; Location ID.
 $8D7B DEFW $004B    ; Percentage to add.
; #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
 $8D7D DEFB $41      ; Location ID.
 $8D7E DEFW $0032    ; Percentage to add.
; #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
 $8D80 DEFB $1B      ; Location ID.
 $8D81 DEFW $0019    ; Percentage to add.
; #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
 $8D83 DEFB $1C      ; Location ID.
 $8D84 DEFW $0019    ; Percentage to add.
; #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
 $8D86 DEFB $1F      ; Location ID.
 $8D87 DEFW $0032    ; Percentage to add.
; #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
 $8D89 DEFB $22      ; Location ID.
 $8D8A DEFW $0064    ; Percentage to add.
; #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
 $8D8C DEFB $26      ; Location ID.
 $8D8D DEFW $0019    ; Percentage to add.
; #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
 $8D8F DEFB $2A      ; Location ID.
 $8D90 DEFW $0019    ; Percentage to add.
; #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
 $8D92 DEFB $2B      ; Location ID.
 $8D93 DEFW $0032    ; Percentage to add.
; #LOCATION(#PEEK(#PC)) - "#LOCATIONNAME(#PEEK(#PC))".
 $8D95 DEFB $29      ; Location ID.
 $8D96 DEFW $00C8    ; Percentage to add.
; End of table.
 $8D98 DEFB $FF      ; #TERMINATOR

; Action Location Buffer
;
; The location the current move is heading for, and the volume of that move.
; Read by #R$8D9D, #R$8E85, #R$9BDC and #R$C7DD.
@label=ActionLocationData
g$8D99 DEFW $0000    ; Pointer to the current location data from #R$BA8A.
@label=ActionLocationID
 $8D9B DEFB $00      ; The current location ID.
@label=ActionMoveVolume
 $8D9C DEFB $00      ; Move volume. #R$8DCC adds the object's volume to the
                     ; character's volume and stores the sum here. #R$8E85
                     ; compares it before a move.

; Action: Move
;
; Used by the routine at #R$8FAD.
; .
; Moves the current character one step in the commanded direction, if
; that exit is open.
; Reached through the action table at #R$C730, dispatched by #R$950F.
@label=Action_Direction
c$8D9D CALL $95ED      ; {Jump to #R$8DAB if #R$95ED reports that it is light.
 $8DA0 JR NC,$8DAB     ; }
 $8DA2 LD A,$09        ; Roll a random number below #N$09.
; Roll a random number.
 $8DA4 CALL $9C9F      ; Call #R$9C9F to roll a number from the limit in #REGa.
 $8DA7 INC A           ; Add one, making the roll #N$01-#N$09.
 $8DA8 LD ($B6E7),A    ; Update *#R$B6E7.
; This entry point is used by the routines at #R$8F3B and #R$A2B4.
@label=Action_Direction_TestIfInside
*$8DAB LD IY,($B70C)   ; Read *#R$B70C.
 $8DAF LD A,(IY+$01)   ; Read where the character is.
 $8DB2 CP $FF          ; {Jump to #R$8DC3 if this character is not inside
 $8DB4 JR Z,$8DC3      ; another object.}
; Find the object's record.
 $8DB6 CALL $9BCA      ; Call #R$9BCA to locate object.
 $8DB9 BIT 6,(IX+$07)  ; {Jump to #R$8DD9 if the object is not an animal.
 $8DBD JR Z,$8DD9      ; }
 $8DBF LD (IY+$01),$FF ; Mark where this object is as unset.
@label=Action_Direction_TotalTheVolume
*$8DC3 LD A,($B6EA)    ; Read *#R$B6EA.
 $8DC6 CALL $9CE8      ; Call #R$9CE8 to total the volume inside the character.
 $8DC9 ADD A,(IY+$02)  ; Add the character's volume onto the total from
                       ; #R$9CE8.
 $8DCC LD ($8D9C),A    ; Store the character's volume plus the object's volume
                       ; as the move volume.
 $8DCF LD A,($B6E7)    ; Read *#R$B6E7.
 $8DD2 CALL $9F08      ; Call #R$9F08 to find an exit in the direction in
                       ; #REGa.
 $8DD5 CP $FF          ; {Jump to #R$8DFA if #R$9F08 found an exit in that
 $8DD7 JR NZ,$8DFA     ; direction.}
@label=Action_Direction_TestForLight
*$8DD9 CALL $95ED      ; {Jump to #R$9F76 if #R$95ED reports that it is light.
 $8DDC JP NC,$9F76     ; }
 $8DDF CALL $9D44      ; Call #R$9D44. If the message is held back, the fall is
                       ; not described.
 $8DE2 LD IX,$C11B     ; Point #REGix at #OBJECT($00,$01,$01)($).
 $8DE6 AND A           ; Clear carry so a zero is shifted into the strength.
 $8DE7 LD HL,$AD7D     ; Point at the message "but fall and hit your
                       ; head[0x15]" (#R$AD7D).
 $8DEA RR (IX+$05)     ; Shift the player's strength right.
 $8DEE JP NZ,$72DD     ; Jump back to #R$72DD unless halving the player's
                       ; strength left it zero.
 $8DF1 LD HL,$AD8A     ; Point at the message "but fall and smash your skull"
                       ; (#R$AD8A).
 $8DF4 CALL $72DD      ; Call #R$72DD to print message.
 $8DF7 JP $90D2        ; Jump to #R$90D2 to end the game.
@label=Action_Direction_ReadThisExitDestination
*$8DFA LD A,(IX+$02)   ; Read this exit's destination.
 $8DFD AND A           ; {Jump back to #R$8DD9 if this exit's destination is
 $8DFE JR Z,$8DD9      ; zero.}
 $8E00 LD ($8D9B),A    ; Store the destination at #R$8D9B.
 $8E03 LD A,(IX+$01)   ; Read the object this exit goes via.
 $8E06 CALL $8E85      ; Call #R$8E85 to check whether this object can be
                       ; entered.
 $8E09 DEC A           ; {Jump back to #R$8DD9 when the check returns #N($01),
 $8E0A JR Z,$8DD9      ; and the character falls.}
 $8E0C DEC A           ; {Jump to #R$8E6D when the check returns #N$02: the way
 $8E0D JR Z,$8E6D      ; is too small.}
 $8E0F DEC A           ; {Jump to #R$8E72 when the check returns #N$03: the way
 $8E10 JR Z,$8E72      ; is too full.}
; This entry point is used by the routine at #R$9BDC.
*$8E12 CALL $9D44      ; Call #R$9D44. If the message is held back, the
                       ; character does not move.
 $8E15 LD (IY+$10),B   ; Update the location.
 $8E18 LD A,($B6EA)    ; Read the character whose turn it is.
 $8E1B CALL $9BDD      ; Call #R$9BDD to move what is inside the character to
                       ; the new location.
 $8E1E LD A,($B6EA)    ; Read the character whose turn it is.
 $8E21 CP $00          ; {Return if the character is not
 $8E23 RET NZ          ; #OBJECT($00,$01,$01)($).}
 $8E24 LD IX,$C78E     ; {Call #R$9DBD using the #R$C78E(events table), looking
 $8E28 LD A,($8D9B)    ; for a match with #R$8D9B.
 $8E2B CALL $9DBD      ; }
 $8E2E JR Z,$8E39      ; Jump to #R$8E39 if no event was found.
 $8E30 LD L,(IX+$01)   ; {Load the event from the #R$C78E(events table).
 $8E33 LD H,(IX+$02)   ; }
 $8E36 CALL $9B6C      ; Call #R$9B6C to execute it.
; This entry point is used by the routine at #R$C7EA.
; .
; The game adds a one-time only value to the completion percentage once certain locations are reached (as long as
; it's not dark).
@label=PercentageLocation
*$8E39 CALL $95ED      ; {Return if #R$95ED reports that it is dark.
 $8E3C RET C           ; }
 $8E3D LD A,($B6EA)    ; Read the character whose turn it is.
 $8E40 AND A           ; See whether the character whose turn it is is zero.
 $8E41 LD A,($8D9B)    ; Read the current location.
 $8E44 JR NZ,$8E6A     ; Jump to #R$8E6A if the character whose turn it is is
                       ; not zero.
 $8E46 LD HL,($8D99)   ; Read the location pointer from #R$8D99.
 $8E49 BIT 6,(HL)      ; {If bit 6 is already (percentage is already added) set
 $8E4B JP NZ,$96A8     ; jump to #R$96A8.}
 $8E4E SET 6,(HL)      ; Mark the current location data so bit 6 is on.
 $8E50 PUSH AF         ; {Call #R$9DBD with #R$8D6E.
 $8E51 LD IX,$8D6E     ;
 $8E55 CALL $9DBD      ; }
 $8E58 JR Z,$8E69      ; Jump to #R$8E69 if there was no match.
 $8E5A PUSH DE         ; {Read the low byte of this location's percentage.
 $8E5B LD E,(IX+$01)   ; }
 $8E5E LD D,(IX+$02)   ; Read the high byte of this location's percentage.
 $8E61 LD HL,($B6F7)   ; {Add the percentage value to #R$B6F7 and write it.
 $8E64 ADD HL,DE       ;
