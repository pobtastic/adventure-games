 $8F53 POP IX          ; {Jump to #R$9F76 if #R$8E85 did not return zero.
 $8F55 JP NZ,$9F76     ; }
; If the message is held back, the character does not leave.
 $8F58 CALL $9D44      ; Call #R$9D44. If the message is held back, the
