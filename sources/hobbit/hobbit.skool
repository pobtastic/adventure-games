; Print: ZX Printer
;
; Used by the routine at #R$869B.
; .
; Copies eight pixel rows of the text line at #N$5020 to the ZX printer
; through port #N$FB when the printer-on flag at #R$B6F2 is set.
@label=ZXPrinter
c$8B22 LD A,($B6F2)  ; Read the printer-on flag at #R$B6F2.
 $8B25 AND A         ; {Return if the printer is off.
 $8B26 RET Z         ; }
 $8B27 PUSH HL       ; {Save the text pointer. The printer row count starts at
 $8B28 PUSH DE       ; #N$01.
 $8B29 PUSH BC       ;
 $8B2A LD D,$01      ; }
 $8B2C LD HL,$5020   ; Point #REGhl at the text line.
 $8B2F XOR A         ; Take zero for the first printer byte.
 $8B30 LD E,A        ; Clear the marker's low byte.
@label=ZXPrinter_WriteAByteToThePrinter
*$8B31 OUT ($FB),A   ; Write a byte to the printer.
@label=ZXPrinter_Loop
*$8B33 IN A,($FB)    ; Read the printer port #N$FB.
 $8B35 ADD A,A       ; Double the printer status.
 $8B36 JP M,$8B74    ; Jump to #R$8B74 if bit 6 of the printer port is set (no
                     ; printer attached).
 $8B39 JR NC,$8B33   ; Jump back to #R$8B33 while bit 7 of the printer port is
                     ; clear.
 $8B3B PUSH HL       ; {Save the line address and the marker, and take the row
 $8B3C PUSH DE       ; count into #REGa.
 $8B3D LD A,D        ; }
 $8B3E CP $02        ; Compare the printer row count with #N$02.
 $8B40 SBC A,A       ; Make #REGa #N$FF when that row count was below #N($02),
                     ; and zero otherwise.
 $8B41 AND E         ; {Build the marker bit from #REGe.
 $8B42 RLCA          ;
 $8B43 AND E         ;
 $8B44 LD D,A        ; }
@label=ZXPrinter_ReadAByteFromThePointer
*$8B45 LD C,(HL)     ; Read a byte from the pointer into #REGc.
 $8B46 PUSH HL       ; {Count #N$08 passes.
 $8B47 LD B,$08      ; }
@label=ZXPrinter_TakeThePrinterByte
*$8B49 LD A,D        ; Take the byte being sent to the printer.
 $8B4A RLC C         ; Rotate the next source bit into carry.
 $8B4C RRA           ; Shift that bit into the byte for the printer.
 $8B4D LD H,A        ; Remember the byte built so far.
@label=ZXPrinter_WaitWhileThePrinterIsBusy
*$8B4E IN A,($FB)    ; Read the printer port #N$FB.
 $8B50 RRA           ; {Jump back to #R$8B4E while the printer is busy.
 $8B51 JR NC,$8B4E   ; }
 $8B53 LD A,H        ; Take the byte built for the printer.
 $8B54 OUT ($FB),A   ; Write a byte to the printer.
 $8B56 DJNZ $8B49    ; Loop back to #R$8B49 until #N$08 runs out.
 $8B58 POP HL        ; {Step along the text line at #N$5020 and continue while
 $8B59 INC HL        ; a character remains.
 $8B5A LD A,L        ;
 $8B5B AND $1F       ;
 $8B5D JR NZ,$8B45   ; }
@label=ZXPrinter_WaitUntilThePrinterIsReady
*$8B5F IN A,($FB)    ; Read the printer port #N$FB.
 $8B61 RRA           ; {Wait until the printer is ready (bit 0 of port #N$FB).
 $8B62 JR NC,$8B5F   ; }
 $8B64 LD A,D        ; Take the byte being sent to the printer.
 $8B65 RRCA          ; Rotate the next bit out towards the printer.
 $8B66 OUT ($FB),A   ; Write a byte to the printer.
 $8B68 POP DE        ; {Restore #REGde and #REGhl from the stack, step to the
 $8B69 POP HL        ; next row, and jump back to #R$8B31 if bit 3 of #REGe is
 $8B6A INC H         ; clear.
 $8B6B INC E         ;
 $8B6C BIT 3,E       ;
 $8B6E JR Z,$8B31    ; }
 $8B70 LD A,$04      ; Send #N$04 to the printer port.
 $8B72 OUT ($FB),A   ; Write a byte to the printer.
; Restore the registers saved for the printer.
@label=ZXPrinter_RestoreAndReturn
*$8B74 POP BC        ; {Restore #REGbc, #REGde and #REGhl from the stack.
 $8B75 POP DE        ;
 $8B76 POP HL        ; }
 $8B77 RET           ; Return.

; Pause
;
; Used by the routine at #R$8B93.
; .
; Waits a short while.
@label=Pause
c$8B78 LD BC,$03E8   ; Count down #N($03E8,$04) before returning.
@label=Pause_Loop
*$8B7B DEC BC        ; Decrease the counter by one.
 $8B7C LD A,B        ; {Loop back to #R$8B7B until the counter is zero.
 $8B7D OR C          ;
 $8B7E JR NZ,$8B7B   ; }
 $8B80 RET           ; Return.

; Keyboard Row Masks
;
; One mask byte per keyboard half-row, the half-row and key bits of the last newly pressed key in the word at
; #R$8B89, and the previous scan at #R$8B8B. #R$8B93 compares each new row with that scan.
@label=KeyboardRowMasks
b$8B81 DEFB $01,$00,$00,$0D,$02,$00,$00,$02
 $8B89 DEFW $0000
 $8B8B DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Get Key
;
; Used by the routine at #R$7249.
; .
; Reads a newly pressed key. Returns #N$00 if there isn't one.
@label=GetKey
c$8B93 PUSH HL       ; {Save #REGhl, #REGix and #REGbc and call #R$8B78 to
 $8B94 PUSH IX       ; pause.
 $8B96 PUSH BC       ;
 $8B97 CALL $8B78    ; }
 $8B9A LD ($8B89),BC ; Write #N($0000,$04,$04) to #R$8B89.
 $8B9E LD HL,$8B8B   ; Point #REGhl at #R$8B8B.
 $8BA1 LD IX,$8B81   ; Point #REGix at #R$8B81.
 $8BA5 LD BC,$FEFE   ; Read the keyboard from port #N$FEFE.
@label=GetKey_Loop
*$8BA8 IN A,(C)      ; Read from the keyboard port.
 $8BAA AND %00011111 ; Keep the selected bits.
 $8BAC OR (IX+$00)   ; OR against what #REGix is pointing to.
 $8BAF PUSH AF       ; {Save the row and complement it.
 $8BB0 CPL           ; }
 $8BB1 AND (HL)      ; {Keep the keys that are pressed now but were up in the
 $8BB2 CPL           ; previous scan at #REGhl. The second CPL leaves the flags
                     ; alone.}
 $8BB3 JR Z,$8BBC    ; Jump to #R$8BBC if no key in this half-row has been
                     ; newly pressed.
 $8BB5 LD ($8B89),BC ; Store #REGbc at #R$8B89.
 $8BB9 LD ($8B89),A  ; Store the result at #R$8B89.
@label=GetKey_StoreTheRow
*$8BBC POP AF        ; {Store the result, then step #REGhl on.
 $8BBD LD (HL),A     ;
 $8BBE INC HL        ; }
 $8BBF INC IX        ; Step #REGix to the next byte of #R$8B81.
 $8BC1 RLC B         ; Rotate the next bit of #REGb into carry.
 $8BC3 JR C,$8BA8    ; Jump back to #R$8BA8 until all eight half-rows have been
                     ; read.
 $8BC5 LD BC,($8B89) ; Bring #REGbc back from #R$8B89.
; No newly pressed key was stored.
 $8BC9 LD A,B        ; {If #REGbc is #N($0000,$04,$04), return #N$00 through
 $8BCA OR C          ; #R$8BF6.
 $8BCB JR Z,$8BF6    ; }
 $8BCD LD A,$FB      ; Start the key index at #N$FB (that is -5).
@label=GetKey_CountTheRows
*$8BCF ADD A,$05     ; Add #N$05 for each keyboard row passed.
 $8BD1 RRC B         ; Shift the next row bit of #REGb into the carry flag.
 $8BD3 JR C,$8BCF    ; If there is any carry, jump to #R$8BCF.
 $8BD5 DEC A         ; Step back one so the next loop starts in the same place.
@label=GetKey_CountTheKeys
*$8BD6 INC A         ; Count one more key along the row.
 $8BD7 RRC C         ; Shift the next key bit of #REGc into the carry flag.
 $8BD9 JR C,$8BD6    ; If there is any carry, jump to #R$8BD6.
 $8BDB LD C,A        ; Copy the key code into #REGc.
 $8BDC LD B,$00      ; Start the character count at zero.
 $8BDE LD HL,$8BFB   ; Point #REGhl at the unshifted keyboard map at #R$8BFB.
 $8BE1 LD A,$FE      ; {Read from the keyboard port.
 $8BE3 IN A,($FE)    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit } { =h 0 | =h 1 | =h 2 |
                     ; =h 3 | =h 4 } { #N$FE | SHIFT | Z | X | C | V } TABLE#}
 $8BE5 AND %00000001 ; Keep only bit 0 (SHIFT).
 $8BE7 JR Z,$8BF1    ; If it is zero, jump to #R$8BF1.
 $8BE9 LD A,$7F      ; {Read from the keyboard port.
 $8BEB IN A,($FE)    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit } { =h 0 | =h 1 | =h 2 |
                     ; =h 3 | =h 4 } { #N$7F | SPACE | SYMBOL SHIFT | M | N | B
                     ; } TABLE#}
 $8BED AND %00000010 ; Keep only bit 1 (SYMBOL SHIFT).
 $8BEF JR NZ,$8BF4   ; If it is not zero, jump to #R$8BF4.
@label=GetKey_UseTheShiftedMap
*$8BF1 LD HL,$8C23   ; Point #REGhl at the shifted keyboard map at #R$8C23.
@label=GetKey_GetByte
*$8BF4 ADD HL,BC     ; Add the key code in #REGbc to the keyboard map pointer.
 $8BF5 LD A,(HL)     ; Read the character for this key from the keyboard map.
@label=GetKey_Return
*$8BF6 POP BC        ; {Restore #REGbc, #REGix and #REGhl from the stack.
 $8BF7 POP IX        ;
 $8BF9 POP HL        ; }
 $8BFA RET           ; Return.

