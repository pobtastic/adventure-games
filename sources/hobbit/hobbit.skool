; .
; Kills the player and ends the game.
; Reached through the action list of #OBJECT($00,$01,$01)($) for action #N($00), dispatched by #R$9B6C.
@label=YouAreDead
c$90D2 SUB A         ; Clear the character whose turn it is.
 $90D3 LD ($B6EA),A  ; Update *#R$B6EA.
 $90D6 LD HL,$AFF1   ; Point at the message "You are dead" (#R$AFF1).
 $90D9 CALL $72DD    ; Call #R$72DD to print message.
 $90DC CALL $83F5    ; Call #R$83F5 to print the score.
; This entry point is used by the routine at #R$A9D6.
; .
; This is the same key wait as #R$84C2, but it ends with a jump to #R$6C27 to
; restart the game.
@label=YouAreDead_WaitForKey
*$90DF XOR A         ; {Read from the keyboard port.
 $90E0 IN A,($FE)    ; }
 $90E2 AND %00011111 ; Keep bits 0-4, one for each key in the half-row. XOR A
                     ; then IN A,(#N$FE) reads every half-row at once, and a
                     ; pressed key reads as a reset bit.
 $90E4 CP $1F        ; {Loop back to #R$90DF until any key has been pressed.
 $90E6 JR Z,$90DF    ; }
 $90E8 JP $6C27      ; Jump back to #R$6C27 to restart the game.

; Action: Inventory
;
; Lists what the player is carrying.
; Reached through the action table at #R$C730, dispatched by #R$950F.
@label=Action_Inventory
c$90EB CALL $9D44    ; Call #R$9D44. If the message is held back, the inventory
                     ; is not listed.
 $90EE LD HL,$ADF6   ; Point at the message "You are carrying[0x15]" (#R$ADF6).
 $90F1 CALL $72DD    ; Call #R$72DD to print message.
 $90F4 LD A,($B6EA)  ; Read *#R$B6EA.
; Count the objects being held.
 $90F7 CALL $9D97    ; Call #R$9D97 to count the visible objects.
 $90FA AND A         ; See whether nothing is held.
 $90FB LD HL,$B33B   ; Point at the message "{6} nothing" (#R$B33B).
 $90FE JP Z,$72DD    ; Jump to #R$72DD to print it if nothing is held.
 $9101 LD A,($B6EA)  ; Read the character whose turn it is.
 $9104 LD IX,($B70C) ; Use the record of the character whose turn it is.
 $9108 LD B,(IX+$10) ; Read this character's location.
 $910B JP $9FAF      ; Jump to #R$9FAF to list what is being carried.

; Action: Open Or Close
;
; Used by the routines at #R$A302, #R$A4C0, #R$A4FE and #R$A5FB.
; .
; Opens or closes the current object.
; Reached through the action lists of #OBJECT($01,$01,$01)($), #OBJECT($05,$01,$01)($), #OBJECT($08,$01,$01)($), #OBJECT($0A,$01,$01)($), #OBJECT($13,$01,$01)($), #OBJECT($1E,$01,$01)($), #OBJECT($20,$01,$01)($), #OBJECT($21,$01,$01)($) and #OBJECT($25,$01,$01)($) for action #N($10), dispatched by #R$9B6C.
@label=ActionOpenOrClose
c$910E CALL $A1F9     ; Call #R$A1F9 to read the object's lock flag.
 $9111 JP NZ,$A16C    ; Jump to #R$A16C to say so if #R$A1F9 found the object
                      ; locked (#N$80) or already open (#N$85).
; If the message is held back, the object is not opened or closed.
 $9114 CALL $9D44     ; Call #R$9D44. If the message is held back, the object
                      ; is not opened or closed.
; This entry point is used by the routines at #R$9034 and #R$A302.
*$9117 SET 5,(IX+$07) ; Mark the object open.
 $911B LD A,(IX+$00)  ; Read the copy count from the object record.
 $911E DEC A          ; {Return unless this object has one copy.
 $911F RET NZ         ; }
 $9120 LD A,($B6E8)   ; Read *#R$B6E8.
; Count the objects being held.
 $9123 CALL $9D97     ; Call #R$9D97 to count the visible objects.
 $9126 AND A          ; {Return if #R$9D97 counted nothing inside the current
 $9127 RET Z          ; object.}
 $9128 LD A,($B6E8)   ; Read *#R$B6E8.
 $912B CALL $A050     ; Call #R$A050 to list what is here.
 $912E RET C          ; Return if #R$A050 set the carry flag.
 $912F LD B,(IX+$10)  ; Read the location from the object record.
 $9132 LD A,($B6E8)   ; Read *#R$B6E8.
 $9135 JP $9FAF       ; Jump to #R$9FAF to list what is here.

; Action: Close
;
; Used by the routine at #R$A5FB.
; .
; Closes the current object (clears bit 5 of its attributes). An object that is not open is named with message #N$05.
; Reached through the action lists of #OBJECT($01,$01,$01)($), #OBJECT($05,$01,$01)($), #OBJECT($06,$01,$01)($), #OBJECT($08,$01,$01)($), #OBJECT($0A,$01,$01)($), #OBJECT($0B,$01,$01)($), #OBJECT($11,$01,$01)($), #OBJECT($13,$01,$01)($), #OBJECT($20,$01,$01)($), #OBJECT($21,$01,$01)($) and #OBJECT($25,$01,$01)($) for action #N($0C), dispatched by #R$9B6C.
@label=Action_Close
c$9138 LD IX,($B708)  ; Read *#R$B708.
 $913C CALL $A5CA     ; Call #R$A5CA to test whether the object is open.
 $913F JP Z,$A16C     ; Jump to #R$A16C if the object is not open.
; If the message is held back, the object stays open.
 $9142 CALL $9D44     ; Call #R$9D44. If the message is held back, the object
                      ; stays open.
; This entry point is used by the routine at #R$9034.
*$9145 RES 5,(IX+$07) ; Close the object.
 $9149 RET            ; Return.

; Action: Test The Shared Flag Bits
;
; Used by the routines at #R$9076 and #R$9171.
; .
; Stops the verb when bits 4-6 of the current object's flag byte overlap the same bits of the
; character's flag byte. On the player's turn bit 4 of the object's flag byte is cleared first.
@label=Action_TestTheSharedFlagBits
c$914A LD IX,($B708)  ; Read *#R$B708.
; Test whose turn it is.
 $914E LD A,($B6EA)   ; {Jump to #R$915E if *#R$B6EA is not zero.
 $9151 AND A          ;
 $9152 JR NZ,$915E    ; }
 $9154 BIT 4,(IX+$04) ; {Jump to #R$915E if bit 4 of the object's second flag
 $9158 JR Z,$915E     ; is clear.}
 $915A RES 4,(IX+$04) ; Clear the object's second flag so bit 4 is off.
@label=Action_TestTheSharedFlagBits_CompareTheFlags
*$915E LD A,(IX+$04)  ; Read the object's flag byte.
 $9161 AND $70        ; {Keep bits 4-6 of the object's flag byte and read the
 $9163 LD IX,($B70C)  ; character at #R$B70C.}
 $9167 AND (IX+$04)   ; {Return when those bits do not overlap the character's
 $916A RET Z          ; flag byte.}
 $916B POP HL         ; {Drop the return address and clear the
 $916C XOR A          ; message-suppressed flag.
 $916D LD ($B6FB),A   ; }
 $9170 RET            ; Return.

; Action: Attack
;
; Attacks the current object, using strength and the combat byte.
; Reached through the action lists of #OBJECT($3D,$01,$01)($), #OBJECT($3F,$01,$01)($), #OBJECT($45,$01,$01)($), #OBJECT($49,$01,$01)($), #OBJECT($4A,$01,$01)($), #OBJECT($4B,$01,$01)($) and #OBJECT($4C,$01,$01)($) for action #N($0F), dispatched by #R$9B6C.
; Reached through the action table at #R$C730, dispatched by #R$950F.
@label=Action_Attack
c$9171 CALL $914A     ; Call #R$914A to test the shared flag bits.
 $9174 LD A,($B6E9)   ; Read *#R$B6E9.
 $9177 LD HL,$026B    ; {Jump to #R$9188 with the token #TOKEN($026B) if no
 $917A CP $FF         ; object was named.
 $917C JR Z,$9188     ; }
 $917E LD IX,($B70A)  ; Read *#R$B70A.
 $9182 LD L,(IX+$08)  ; Read the name token from the object record.
 $9185 LD H,(IX+$09)  ; Read the name token's high byte from the object record.
@label=Action_Attack_StoreTheWeapon
*$9188 LD ($B6FC),HL  ; Store the weapon-name token at #R$B6FC.
 $918B LD IX,($B70C)  ; Read *#R$B70C.
 $918F LD B,(IX+$05)  ; Read the strength from the object record.
 $9192 LD A,($B6E9)   ; Read *#R$B6E9.
 $9195 INC A          ; {Jump to #R$91AF if the second object is #N$FF.
 $9196 JR Z,$91AF     ; }
 $9198 LD IY,($B70A)  ; Read *#R$B70A.
 $919C LD A,(IY+$00)  ; Read the copy count of the object being attacked.
 $919F DEC A          ; {Jump back to #R$72DD unless that object has one copy.
 $91A0 LD HL,$AF5F    ;
 $91A3 JP NZ,$72DD    ; }
 $91A6 LD A,(IY+$05)  ; Read the attacked object's strength.
 $91A9 ADD A,B        ; Add the attacker's strength onto the attacked object's
                      ; strength.
 $91AA JR NC,$91AE    ; Jump to #R$91AE if the sum did not overflow.
 $91AC LD A,$FF       ; Cap the sum at #N$FF.
@label=Action_Attack_KeepTheRollLimit
*$91AE LD B,A         ; Keep the sum in #REGb as the roll limit.
@label=Action_Attack_TakeThatLimitBack
*$91AF LD A,B         ; Take that limit back into #REGa.
 $91B0 CALL $9213     ; Call #R$9213 to roll #N$0A against the attacker's
                      ; limit.
 $91B3 LD B,A         ; Copy the result into #REGb.
; If the message is held back, the attack is not resolved.
 $91B4 CALL $9D44     ; Call #R$9D44. If the message is held back, the attack
                      ; is not resolved.
 $91B7 LD IX,($B708)  ; Read *#R$B708.
 $91BB LD A,(IX+$06)  ; Read the combat byte from the object record.
 $91BE CALL $9213     ; Call #R$9213 to roll #N$0A against the attacker's
                      ; limit.
 $91C1 CP B           ; {Jump back to #R$72DD if this roll is not below the
 $91C2 LD HL,$AF50    ; first.
 $91C5 JP NC,$72DD    ; }
 $91C8 LD C,A         ; Keep this roll in #REGc.
 $91C9 ADD A,$10      ; {Add #N$10 to this roll (capped at #N$FF) and jump to
 $91CB JR NC,$91CF    ; #R$91FE if the first roll is still higher.
 $91CD LD A,$FF       ;
*$91CF CP B           ;
 $91D0 JR C,$91FE     ; }
 $91D2 LD A,B         ; Take the first roll back into #REGa.
 $91D3 SUB C          ; Take this roll off the first.
 $91D4 RLCA           ; Double the difference.
 $91D5 LD E,A         ; Keep the doubled difference in #REGe.
 $91D6 LD D,$00       ; The message-table offset's high byte is zero.
 $91D8 LD IY,$9226    ; {Index the attack-message table at #R$9226.
 $91DC ADD IY,DE      ; }
 $91DE LD L,(IY+$00)  ; Read the low byte of the message address.
 $91E1 LD H,(IY+$01)  ; Read the high byte of the message address.
 $91E4 RRCA           ; Shift the doubled difference back down.
 $91E5 RRCA           ; Shift it down again, undoing the double.
 $91E6 LD B,A         ; Keep that difference in #REGb.
 $91E7 CPL            ; Complement #REGa.
 $91E8 ADD A,(IX+$05) ; Add the current object's strength.
 $91EB JR NC,$91F0    ; Leave the strength unchanged if the damage would take
                      ; it below zero.
 $91ED LD (IX+$05),A  ; Store the reduced strength.
@label=Action_Attack_TakeTheDifferenceBack
*$91F0 LD A,B         ; Take the difference back into #REGa.
 $91F1 RRCA           ; Shift the difference down once more.
 $91F2 CPL            ; Complement #REGa.
 $91F3 ADD A,(IX+$06) ; Add the current object's combat byte.
 $91F6 JR NC,$91FB    ; Leave the combat byte unchanged if the damage would
                      ; take it below zero.
 $91F8 LD (IX+$06),A  ; Store the reduced combat byte.
@label=Action_Attack_PrintTheMessage
*$91FB JP $72DD       ; Jump to #R$72DD to print the message at #REGhl.
@label=Action_Attack_PointAtTheCleaveMessage
*$91FE LD HL,$AE3A    ; Point #REGhl at #R$AE3A.
 $9201 CALL $72DD     ; Call #R$72DD to print message.
 $9204 SET 3,(IX+$07) ; Mark the object broken.
 $9208 LD A,($B6E8)   ; Read *#R$B6E8.
 $920B CALL $977F     ; Call #R$977F. The player dies if no object is left.
 $920E LD A,$06       ; Pass #N$06 to the routine that names this object.
 $9210 JP $A16C       ; Jump to #R$A16C to print the object's name.

; Action: Roll Against Ten
;
; Used by the routine at #R$9171.
; .
; Rolls #N$0A against the caller's limit and returns the hit or the miss for
; the attack.
@label=Action_RollAgainstTen
c$9213 PUSH BC        ; {Save #REGbc and keep the roll limit in #REGb.
 $9214 LD B,A         ; }
 $9215 LD A,$0A       ; Load #N$0A as the range of the roll.
 $9217 CALL $9CA8     ; Call #R$9CA8 to scale the roll.
 $921A LD C,A         ; Copy the result into #REGc.
 $921B ADD A,B        ; Add the limit in #REGb to the scaled roll.
 $921C JR NC,$9224    ; Return (through #R$9224) if the sum did not overflow.
 $921E XOR A          ; {Clear #REGa, and jump to #R$9224 if bit 7 of the
 $921F BIT 7,C        ; scaled roll in #REGc is set.
 $9221 JR NZ,$9224    ; }
 $9223 DEC A          ; Step a zero result down by one.
@label=Action_RollAgainstTen_Attack_RestoreTheRoll
*$9224 POP BC         ; Restore #REGbc from the stack.
 $9225 RET            ; Return.
 $9226 DEFW $AF3C     ;
 $9228 DEFW $AF2B     ;
 $922A DEFW $AF20     ;
 $922C DEFW $AF15     ;
 $922E DEFW $AF09     ;
 $9230 DEFW $AEF4     ;
 $9232 DEFW $AEE2     ;
 $9234 DEFW $AED1     ;
 $9236 DEFW $AEBA     ;
 $9238 DEFW $AEAC     ;
 $923A DEFW $AE98     ;
 $923C DEFW $AE8B     ;
 $923E DEFW $AE7A     ;
 $9240 DEFW $AE70     ;
 $9242 DEFW $AE5A     ;
 $9244 DEFW $AE49     ;
; This entry point is used by the routine at #R$8D25.
*$9246 LD IX,($B708)  ; Read *#R$B708.
 $924A LD A,(IX+$00)  ; Read the copy count from the object record.
 $924D DEC A          ; Take one off the copy count.
 $924E RET            ; Return.
; Reached through the action lists of #OBJECT($13,$01,$01)($),
; #OBJECT($1D,$01,$01)($), #OBJECT($1F,$01,$01)($) and #OBJECT($21,$01,$01)($)
; for action #N($11), and of #OBJECT($25,$01,$01)($) and
; #OBJECT($29,$01,$01)($) for actions #N$0E and #N($11), dispatched by #R$9B6C.
 $924F CALL $8D25     ; Call #R$8D25 to stop the verb when the object is fixed
                      ; or a fluid.
 $9252 LD A,($B6E9)   ; Read *#R$B6E9.
 $9255 CP (IX+$01)    ; {Jump back to #R$72CE if the second object is where
 $9258 JP Z,$72CE     ; this object is.}
 $925B LD IY,($B70A)  ; Read *#R$B70A.
; Test the current action.
 $925F LD A,($B6E7)   ; {Jump to #R$926C if *#R$B6E7 is #N$12 (put on).
 $9262 CP $12         ;
 $9264 JR Z,$926C     ; }
 $9266 BIT 5,(IY+$07) ; {Jump to #R$9297 if the object is not open.
 $926A JR Z,$9297     ; }
@label=Action_RollAgainstTen_Attack_ReadTheVolume
*$926C LD A,(IY+$02)  ; Read the volume from #REGiy.
 $926F SUB (IX+$02)   ; {Jump to #R$927E if the volume just read is below the
 $9272 JR C,$927E     ; volume of the object at #R$B708.}
 $9274 PUSH AF        ; {Read *#R$B6E9.
 $9275 LD A,($B6E9)   ; }
 $9278 CALL $9CE8     ; Call #R$9CE8 to total the volume inside this object.
 $927B LD B,A         ; Copy the result into #REGb.
 $927C POP AF         ; {Subtract that volume from the value saved on the
 $927D SUB B          ; stack.}
@label=Action_RollAgainstTen_Attack_PrintTooFull
*$927E LD HL,$AE1A    ; {Point #REGhl at #R$AE1A and jump back to #R$72DD if
 $9281 JP C,$72DD     ; the result went below zero.}
 $9284 JP Z,$72DD     ; Jump back to #R$72DD if the result is zero.
; If the message is held back, the hit is not applied.
 $9287 CALL $9D44     ; Call #R$9D44. If the message is held back, the hit is
                      ; not applied.
 $928A LD A,(IY+$10)  ; Read the location from #REGiy.
 $928D LD (IX+$10),A  ; Update the object's location.
 $9290 LD A,($B6E9)   ; Read *#R$B6E9.
 $9293 LD (IX+$01),A  ; Update where this object is.
 $9296 RET            ; Return.
@label=Action_RollAgainstTen_Attack_NameTheSecondObject
*$9297 LD A,$05       ; Pass #N$05 to the routine that names the second object.
 $9299 JP $A164       ; Jump to #R$A164 to name the second object.
; If the message is held back, the holder's flag is not cleared.
; .
; Reached through the action lists of #OBJECT($14,$01,$01)($) and
; #OBJECT($15,$01,$01)($) for action #N($21), dispatched by #R$9B6C.
 $929C CALL $9D44     ; Call #R$9D44. If the message is held back, the holder's
                      ; flag is not cleared.
 $929F LD IX,($B708)  ; Read *#R$B708.
 $92A3 LD A,(IX+$01)  ; Read where this object is from the object record.
 $92A6 CP $FF         ; {Jump to #R$92B5 if this object is not inside another
 $92A8 JR Z,$92B5     ; object.}
; Find the object's record.
 $92AA CALL $9BCA     ; Call #R$9BCA to locate object.
 $92AD RES 2,(IX+$07) ; Mark the object not full.
 $92B1 LD A,$01       ; The strength added here is #N$01.
 $92B3 JR $92BA       ; Jump to #R$92BA to add #N$01 to the character's
                      ; strength.

; Action: Add To The Player's Strength
;
; Used by the routines at #R$9213 and #R$A86E.
; .
; Adds #N$0A to the player's strength. At #N$80 the player reads that foul gluttony has
; killed you.
; Reached through the action lists of #OBJECT($00,$01,$01)($), #OBJECT($22,$01,$01)($) and #OBJECT($26,$01,$01)($) for action #N($1B), dispatched by #R$9B6C.
;
; .
;
; If the message is held back, the player's strength is not increased.
@label=Action_AddToThePlayersStrength
c$92B5 CALL $9D44      ; Call #R$9D44. If the message is held back, the
                       ; player's strength is not increased.
 $92B8 LD A,$0A        ; The strength added for a hit is #N$0A.
; This entry point is used by the routine at #R$9213.
@label=Action_AddToThePlayersStrength_AddToTheStrength
*$92BA LD IX,($B70C)   ; Read *#R$B70C.
 $92BE ADD A,(IX+$05)  ; {Jump to #R$92DC if the character's strength plus
 $92C1 CP $80          ; #REGa is not below #N$80.
 $92C3 JR NC,$92DC     ; }
 $92C5 LD (IX+$05),A   ; Update the character's strength.
 $92C8 LD IX,($B708)   ; Read *#R$B708.
 $92CC LD (IX+$01),$FF ; Mark where this object is as unset.
 $92D0 LD B,(IX+$00)   ; Load the copy count into #REGb.
@label=Action_AddToThePlayersStrength_Loop
*$92D3 LD (IX+$10),$00 ; Clear the object's location.
 $92D7 INC IX          ; Step to the next byte of this object.
 $92D9 DJNZ $92D3      ; Loop back to #R$92D3 until every copy's location is
                       ; clear.
 $92DB RET             ; Return.
@label=Action_AddToThePlayersStrength_PrintTheDeath
*$92DC LD HL,$B146     ; Point at the message "[0x0c] foul gluttony has{5}
                       ; killed you[0x15]" (#R$B146).
; Print the message at #REGhl.
 $92DF CALL $72DD      ; Call #R$72DD to print message.
 $92E2 LD A,($B6EA)    ; Read *#R$B6EA.
 $92E5 JP $977F        ; Jump to #R$977F to skip the rest of attack.
 $92E8 LD A,$83        ; Pass code #N$83 on to the naming routine.
 $92EA JP $A164        ; Jump to #R$A164 to save the address and #R$B020.

; Action: Use The Other Object
;
; Used by the routines at #R$9076 and #R$A5FB.
; .
; Uses the second object on the current one. A fluid, a broken object, or a combat byte of
; #N$83 will not work.
; Reached through the action lists of #OBJECT($01,$01,$01)($), #OBJECT($05,$01,$01)($), #OBJECT($07,$01,$01)($), #OBJECT($0A,$01,$01)($), #OBJECT($0C,$01,$01)($), #OBJECT($0E,$01,$01)($), #OBJECT($13,$01,$01)($), #OBJECT($19,$01,$01)($), #OBJECT($1A,$01,$01)($), #OBJECT($1E,$01,$01)($), #OBJECT($21,$01,$01)($), #OBJECT($25,$01,$01)($) and #OBJECT($29,$01,$01)($) for action #N($0B), dispatched by #R$9B6C.
@label=Action_UseTheOtherObject
c$92ED LD IX,($B708)  ; Read *#R$B708.
 $92F1 BIT 1,(IX+$07) ; {Jump to #R$9F76 if the object is a fluid.
 $92F5 JP NZ,$9F76    ; }
 $92F8 BIT 3,(IX+$07) ; {Jump to #R$9399 if the object is broken.
 $92FC JP NZ,$9399    ; }
 $92FF SUB A          ; {Jump to #R$9F76 if the object's combat byte is zero.
 $9300 CP (IX+$06)    ;
 $9303 JP Z,$9F76     ; }
 $9306 LD B,A         ; Copy the result into #REGb.
 $9307 LD A,($B6E9)   ; Read *#R$B6E9.
 $930A INC A          ; {Jump to #R$932C if there is no second object (#N$FF).
 $930B JR Z,$932C     ; }
 $930D LD IY,($B70A)  ; Read *#R$B70A.
 $9311 LD A,(IY+$05)  ; Read the strength from #REGiy.
 $9314 AND A          ; {Jump to #R$9F76 if the object's strength is zero.
 $9315 JP Z,$9F76     ; }
 $9318 PUSH IX        ; {Read *#R$B70A.
 $931A LD IX,($B70A)  ; }
 $931E LD A,$0B       ; Look up action #N$0B.
 $9320 CALL $9B81     ; Call #R$9B81 to find an action record.
 $9323 POP IX         ; {Jump to #R$9F76 if #R$9B81 found no action record
 $9325 INC A          ; (#N$FF).
 $9326 JP Z,$9F76     ; }
 $9329 LD B,(IY+$05)  ; Read the strength from #REGiy.
; If the message is held back, the second object is not used.
@label=Action_UseTheOtherObject_Attack_HoldTheMessage
*$932C CALL $9D44     ; Call #R$9D44. If the message is held back, the second
                      ; object is not used.
 $932F LD A,$15       ; Scale the roll by #N$15.
 $9331 CALL $9CA8     ; Call #R$9CA8 to scale the roll.
 $9334 ADD A,B        ; Add #REGb to the roll.
 $9335 LD IY,($B70C)  ; Read *#R$B70C.
 $9339 ADD A,(IY+$05) ; Add the strength of the object at #R$B70C.
 $933C JR NC,$9340    ; Jump to #R$9340 if the sum did not overflow.
 $933E LD A,$FF       ; Cap the sum at #N$FF.
@label=Action_UseTheOtherObject_Attack_TestTheCombatByte
*$9340 SUB (IX+$06)   ; {Jump to #R$9360 if the total is below the object's
 $9343 JR C,$9360     ; combat byte.}
 $9345 SET 3,(IX+$07) ; Mark the object broken.
 $9349 LD A,($B6E8)   ; Read *#R$B6E8.
 $934C CALL $A18C     ; Call #R$A18C to clear the tie on the object.
 $934F SRA (IX+$05)   ; Halve the strength.
 $9353 LD A,(IX+$04)  ; Read the second flag from the object record.
 $9356 CP $02         ; {Call #R$9D50 if the object's second flag is below
 $9358 CALL C,$9D50   ; #N$02.}
 $935B LD A,$83       ; Name this object under code #N$83.
 $935D CALL $A16C     ; Call #R$A16C to print "is" with this object's name.
@label=Action_UseTheOtherObject_Attack_ReadSecondObject
*$9360 LD A,($B6E9)   ; Read *#R$B6E9.
 $9363 CP $FF         ; {Return if no object was named.
 $9365 RET Z          ; }
 $9366 LD IY,($B70A)  ; Read *#R$B70A.
 $936A BIT 3,(IY+$07) ; {Return if the object is broken.
 $936E RET NZ         ; }
 $936F LD B,(IY+$06)  ; Read the combat byte from #REGiy.
 $9372 LD A,$15       ; Scale the roll by #N$15.
 $9374 CALL $9CA8     ; Call #R$9CA8 to scale the roll.
 $9377 ADD A,B        ; Add the combat byte in #REGb to the roll.
 $9378 JR NC,$937C    ; Jump to #R$937C if the sum did not overflow.
 $937A LD A,$FF       ; Cap the sum at #N$FF.
@label=Action_UseTheOtherObject_Attack_ReturnIfWeaker
*$937C SUB (IX+$06)   ; {Return if the roll is below the object's combat byte.
 $937F RET C          ; }
 $9380 SET 3,(IY+$07) ; Mark the object broken.
 $9384 LD A,($B6E9)   ; Read *#R$B6E9.
 $9387 CALL $A18C     ; Call #R$A18C to clear the tie on the object.
 $938A LD A,(IY+$05)  ; Read the strength from #REGiy.
 $938D SRA A          ; Halve the strength.
 $938F LD (IY+$05),A  ; Update the object's strength.
 $9392 CALL $9D50     ; Call #R$9D50 to find where the object is.
 $9395 PUSH IY        ; {Use the second-object pointer as the object record.
 $9397 POP IX         ; }
@label=Action_UseTheOtherObject_Attack_PrintTheObjectName
*$9399 LD A,$83       ; Pass code #N$83 on to the naming routine.
 $939B JP $A16C       ; Jump to #R$A16C to print the object's name.

; Action: Give
;
; Used by the routine at #R$A9E5.
; .
; Gives the current object to the second character.
; Reached through the action table at #R$C730, dispatched by #R$950F.
@label=Action_Give
c$939E LD IY,($B70A)  ; Read *#R$B70A.
; Test whether the object is being carried.
 $93A2 CALL $9C78     ; Call #R$9C78 to test whether the object is carried.
 $93A5 LD HL,$ADF1    ; Point at the message "You are not carrying it[0x15]"
                      ; (#R$ADF1).
 $93A8 JP NC,$72DD    ; Jump back to #R$72DD if #R$9C78 found the object not
                      ; carried, to print "You are not carrying it".
 $93AB LD A,($B6E9)   ; Read *#R$B6E9.
 $93AE CALL $9CED     ; Call #R$9CED to total the mass inside the object.
 $93B1 LD IX,($B708)  ; Read *#R$B708.
 $93B5 ADD A,(IX+$03) ; Add the object's mass onto the second object.
 $93B8 PUSH AF        ; {Read the mass from #REGiy.
 $93B9 POP BC         ;
 $93BA LD A,(IY+$03)  ; }
 $93BD SUB B          ; {Point #REGhl at #R$AE0C and jump to #R$72DD if the
 $93BE LD HL,$AE0C    ; total in #REGb is more than the mass of the object at
 $93C1 JP C,$72DD     ; #REGiy.}
 $93C4 CALL $9D44     ; Call #R$9D44. If the message is held back, the object
                      ; is not given.
 $93C7 LD A,($B6E9)   ; Read *#R$B6E9.
 $93CA LD (IX+$01),A  ; Update where this object is.
 $93CD LD A,(IY+$10)  ; Read the location from #REGiy.
 $93D0 LD (IX+$10),A  ; Copy the second object's location.
 $93D3 LD B,A         ; Copy the result into #REGb.
 $93D4 LD A,($B6E8)   ; Read *#R$B6E8.
 $93D7 JP $9BDD       ; Jump to #R$9BDD to move what is inside the current
                      ; object to the other character's location.

; Action: Examine
;
; Used by the routine at #R$A7AA.
; .
; Examines the current object and prints what is special about it.
; Reached through the action table at #R$C730, dispatched by #R$950F.
@label=Action_Examine
c$93DA CALL $9D44      ; Call #R$9D44. If the message is held back, the object
                       ; is not examined.
 $93DD LD A,($B6E8)    ; Read the current object.
 $93E0 CALL $9BCA      ; Call #R$9BCA to locate object.
 $93E3 LD L,(IX+$0E)   ; Read byte #N$0E of this object.
 $93E6 LD H,(IX+$0F)   ; Read byte #N$0F of this object.
 $93E9 LD A,H          ; {Jump to #R$72DD when the pointer is not zero.
 $93EA OR L            ;
 $93EB JP NZ,$72DD     ; }
 $93EE LD HL,$B000     ; Point at the message "You see[0x16]" (#R$B000).
 $93F1 CALL $72DD      ; Call #R$72DD to print message.
 $93F4 PUSH IX         ; {Call #R$9EC7 to name the object.
 $93F6 POP IY          ;
 $93F8 CALL $9EC7      ; }
 $93FB LD A,$2E        ; Use the character '.'.
 $93FD CALL $858B      ; Call #R$858B to print one character.
 $9400 CALL $8583      ; Call #R$8583 to print a newline.
 $9403 RET             ; Return.
; Reached through the action list of #OBJECT($13,$01,$01)($) for action
; #N($22), dispatched by #R$9B6C.
 $9404 LD IX,($B708)   ; Read *#R$B708.
 $9408 CALL $A5CA      ; Call #R$A5CA to test whether the object is open.
 $940B JP Z,$A16C      ; Jump to #R$A16C if the object is not open.
 $940E LD A,($B6E8)    ; Read *#R$B6E8.
; Count the objects being held.
 $9411 CALL $9D97      ; Call #R$9D97 to count the visible objects.
 $9414 CP $00          ; {Jump to #R$9423 if #R$9D97 counted nothing inside the
 $9416 JR Z,$9423      ; current object.}
; If the message is held back, the object is not examined.
 $9418 CALL $9D44      ; Call #R$9D44. If the message is held back, the object
                       ; is not examined.
 $941B CALL $9D50      ; Call #R$9D50 to find where the object is.
 $941E RES 2,(IX+$07)  ; Mark the object not full.
 $9422 RET             ; Return.
@label=Action_Examine_PrintTheName
*$9423 LD A,$02        ; Pass code #N$02 on to the naming routine.
 $9425 JP $A16C        ; Jump to #R$A16C to print the object's name.
; Reached through the action lists of #OBJECT($09,$01,$01)($) and
; #OBJECT($2A,$01,$01)($) for actions #N$0E and #N($11), dispatched by #R$9B6C.
 $9428 CALL $8D25      ; Call #R$8D25 to stop the verb when the object is fixed
                       ; or a fluid.
; If the message is held back, the special description is not printed.
 $942B CALL $9D44      ; Call #R$9D44. If the message is held back, the special
                       ; description is not printed.
 $942E LD A,($B6F6)    ; Read *#R$B6F6.
 $9431 LD IX,($B70A)   ; Read *#R$B70A.
 $9435 LD B,(IX+$00)   ; Load the copy count into #REGb.
@label=Action_Examine_Loop
*$9438 CP (IX+$10)     ; {Jump to #R$9444 if the script location is the
 $943B JR Z,$9444      ; object's location.}
 $943D INC IX          ; Step to the next byte of this object.
 $943F DJNZ $9438      ; Loop back to #R$9438 until every copy's location has
                       ; been checked.
 $9441 JP $72CE        ; Jump to #R$72CE to say "i cannot do that".
@label=Action_Examine_ReadTheCopyLocation
*$9444 LD A,(IX+$11)   ; Read byte +#N$11 from the object record.
 $9447 DEC B           ; {Jump to #R$944B if this was not the last copy.
 $9448 JR NZ,$944B     ; }
 $944A XOR A           ; Take zero for this object's location.
@label=Action_Examine_PrintSweptAway
*$944B PUSH AF         ; {Point at the message "and it get(s|d|ing|es) swept
 $944C LD HL,$ADFC     ; away".}
 $944F CALL $72DD      ; Call #R$72DD to print message.
 $9452 POP AF          ; {Read *#R$B708.
 $9453 LD IX,($B708)   ; }
 $9457 LD (IX+$10),A   ; Set this object's location to the next copy's location
                       ; (or zero).
 $945A LD (IX+$01),$FF ; Mark where this object is as unset.
 $945E LD B,A          ; {Read *#R$B6E8.
 $945F LD A,($B6E8)    ; }
 $9462 CALL $9BDD      ; Call #R$9BDD to move what is inside the current object
                       ; to that location.
; Test this flag.
 $9465 LD A,($C12B)    ; {Jump to #R$90D2 if *#R$C12B is zero.
 $9468 AND A           ;
 $9469 JP Z,$90D2      ; }
 $946C RET             ; Return.

; Action: Lock
;
; Used by the routine at #R$A302.
; .
; Locks the current object with the second object as the key. An object that is already
; locked or is open is refused. #R$9488 is set up to SET bit 0.
@label=Action_Lock
c$946D CALL $A1F9     ; Call #R$A1F9 to read the object's lock flag.
 $9470 JP NZ,$A16C    ; Jump to #R$A16C if the object is already locked or is
                      ; open.
 $9473 LD A,$C6       ; Use #N($C6), the SET 0 operation.
; This entry point is used by the routine at #R$948D.
; .
; #R$948D joins here with RES 0 to unlock the object.
@label=Action_Lock_TestTheKey
*$9475 LD ($948B),A   ; Plant the operation at byte #N$948B of #R$9488.
 $9478 LD IY,($B70A)  ; Read *#R$B70A.
 $947C BIT 3,(IY+$07) ; {Take #N($83), and jump to #R$A164 if the key is
 $9480 LD A,$83       ; broken.
 $9482 JP NZ,$A164    ; }
; If the message is held back, the object is not locked or unlocked.
 $9485 CALL $9D44     ; Call #R$9D44. If the message is held back, the object
                      ; is not locked or unlocked.
 $9488 SET 0,(IX+$07) ; Lock the object (SET 0), or unlock it when #R$948D has
                      ; planted RES 0.
 $948C RET            ; Return.

; Action: Unlock
;
; Used by the routine at #R$A302.
; .
; Unlocks the current object. An object that is not locked, or is open, is refused;
; otherwise #R$9488 is set up to RES bit 0 and the key is tested at #R$9475.
@label=Action_Unlock
c$948D LD IX,($B708)   ; Read *#R$B708.
 $9491 BIT 0,(IX+$07)  ; {Take zero, and jump to #R$A16C if the object is not
 $9495 LD A,$00        ; locked.
 $9497 JP Z,$A16C      ; }
 $949A CALL $A204      ; Call #R$A204 to test whether the object is open.
 $949D JP NZ,$A16C     ; Jump to #R$A16C if the object is open.
 $94A0 LD A,$86        ; Use #N($86), the RES 0 operation.
 $94A2 JR $9475        ; Jump back to #R$9475 to plant it and unlock the
                       ; object.
; Refuse the verb when the object is not carried.
; .
; Reached through the action lists of #OBJECT($01,$01,$01)($),
; #OBJECT($05,$01,$01)($), #OBJECT($08,$01,$01)($), #OBJECT($0A,$01,$01)($),
; #OBJECT($0B,$01,$01)($), #OBJECT($0C,$01,$01)($), #OBJECT($0D,$01,$01)($) and
; #OBJECT($11,$01,$01)($) for action #N($2C), dispatched by #R$9B6C.
 $94A4 CALL $8C9B      ; Call #R$8C9B to refuse the verb when the object is not
                       ; carried.
 $94A7 LD A,($B6E9)    ; Read *#R$B6E9.
 $94AA CALL $9F28      ; Call #R$9F28 to find the exit through the object in
                       ; #REGa.
 $94AD CP $FF          ; {Jump to #R$9F76 if no exit runs through this object.
 $94AF JP Z,$9F76      ; }
 $94B2 LD IY,($B70A)   ; Read *#R$B70A.
 $94B6 BIT 5,(IY+$07)  ; {Take #N($05), and jump to #R$A164 if the object is
 $94BA LD A,$05        ; not open.
 $94BC JP Z,$A164      ; }
; If the message is held back, the locked object is not named.
 $94BF CALL $9D44      ; Call #R$9D44. If the message is held back, the locked
                       ; object is not named.
 $94C2 LD B,(IX+$02)   ; Read this exit's destination.
 $94C5 LD IX,($B708)   ; Read *#R$B708.
 $94C9 LD (IX+$01),$FF ; Mark where this object is as unset.
 $94CD LD (IX+$10),B   ; Update the object's location.
 $94D0 LD A,($B6E8)    ; Read *#R$B6E8.
 $94D3 JP $9BDD        ; Jump to #R$9BDD to move what is inside the current
                       ; object to this exit's destination.

; Turn: Run The Action Handler
;
; Used by the routine at #R$7CFC.
; .
; Runs the action handler for the current object and the current action, and stores the
; result in the message-suppressed flag.
@label=Turn_RunTheActionHandler
c$94D6 PUSH IX       ; {Save #REGix and #REGhl and call #R$9B44 to accept the
 $94D8 PUSH HL       ; named object.
 $94D9 CALL $9B44    ; }
 $94DC LD A,$00      ; {Take zero and jump to #R$9508 if #R$9B44 returned with
 $94DE JR Z,$9508    ; the zero flag set.}
 $94E0 LD A,($B6E7)  ; Read *#R$B6E7.
 $94E3 LD IX,$C730   ; Point #REGix at the action: "".
; Find this id in the table at #REGix.
 $94E7 CALL $9DBD    ; Call #R$9DBD to look this id up in the table.
 $94EA CP $FF        ; {Take #N($01), and jump to #R$9508 if #R$9DBD found the
 $94EC LD A,$01      ; action in the table.
 $94EE JR NZ,$9508   ; }
 $94F0 CALL $A1D0    ; Call #R$A1D0 to match the action against the five verb
                     ; bytes.
 $94F3 LD A,$01      ; {Take #N($01), and jump to #R$9508 if #R$A1D0 found the
 $94F5 JR Z,$9508    ; action in the verb list.}
 $94F7 LD A,($B6E8)  ; Read *#R$B6E8.
; Find the object's record.
 $94FA CALL $9BCA    ; Call #R$9BCA to locate object.
 $94FD LD A,($B6E7)  ; Read *#R$B6E7.
 $9500 CALL $9B81    ; Call #R$9B81 to find an action record.
 $9503 LD A,$01      ; {Take #N($01), and jump to #R$9508 if #R$9B81 found the
 $9505 JR C,$9508    ; action record.}
 $9507 SUB A         ; Take zero.
@label=Turn_RunTheActionHandler_Examine_RecordTheResult
*$9508 LD ($B6FB),A  ; Record in the message-suppressed flag whether this
                     ; action ran.
 $950B POP HL        ; {Restore #REGhl and #REGix from the stack.
 $950C POP IX        ; }
 $950E RET           ; Return.

; Turn: Run The Handler If Present
;
; Used by the routines at #R$7960, #R$7AED, #R$7AF5, #R$7D74 and #R$99C6.
; .
; Runs the handler when one is present. In the dark, with nothing named, the player sees
; "i see nothing here".
@label=Turn_RunTheHandlerIfPresent
c$950F PUSH HL       ; {Save #REGhl, #REGix and #REGbc, and call #R$9B44 to
 $9510 PUSH IX       ; accept the named object.
 $9512 PUSH BC       ;
 $9513 CALL $9B44    ; }
 $9516 JP Z,$95DA    ; Jump to #R$95DA when #R$9B44 returns with the zero flag
                     ; set.
; Test whether the location is lit.
 $9519 CALL $95ED    ; Call #R$95ED to test whether the location is lit.
 $951C JR NC,$9539   ; Jump to #R$9539 if the location is lit.
; Test this flag.
 $951E LD A,($B711)  ; {Jump to #R$9531 if *#R$B711 is not zero.
 $9521 AND A         ;
 $9522 JR NZ,$9531   ; }
; Test whether the object is being carried.
 $9524 CALL $9C78    ; Call #R$9C78 to test whether the object is carried.
 $9527 JR NC,$9531   ; Jump to #R$9531 if the object is not being carried.
 $9529 LD A,($B6E9)  ; Read *#R$B6E9.
 $952C CALL $9C7B    ; Call #R$9C7B to test whether the character whose turn it
                     ; is is carrying it.
 $952F JR C,$9539    ; Jump to #R$9539 if the character whose turn it is is
                     ; carrying the object.
@label=Turn_RunTheHandlerIfPresent_Examine_PrintNothing
*$9531 LD HL,$AFC4   ; Point at the message "i see nothing here" (#R$AFC4).
 $9534 CALL $72DD    ; Call #R$72DD to print message.
 $9537 JR $959B      ; Jump to #R$959B to test the message gate.
; Test the noun-print flag.
@label=Turn_RunTheHandlerIfPresent_Examine_TestNounFlag
*$9539 LD A,($B6FE)  ; {Jump to #R$95CC if *#R$B6FE is #N$01.
 $953C CP $01        ;
 $953E JP Z,$95CC    ; }
; Test the current object.
 $9541 LD A,($B6E8)  ; {Jump to #R$95CC if *#R$B6E8 is #N$FF.
 $9544 CP $FF        ;
 $9546 JP Z,$95CC    ; }
; Find the object's record.
 $9549 CALL $9BCA    ; Call #R$9BCA to locate object.
 $954C LD ($B708),IX ; Update *#R$B708.
 $9550 LD A,($B6E8)  ; Read *#R$B6E8.
 $9553 CALL $9728    ; Call #R$9728 to report who is carrying the object.
 $9556 JR NZ,$959B   ; Jump to #R$959B unless #R$9728 returned zero.
; Test the second object.
 $9558 LD A,($B6E9)  ; {Jump to #R$957A if *#R$B6E9 is #N$FF.
 $955B CP $FF        ;
 $955D JR Z,$957A    ; }
; Test the second-noun flag.
 $955F LD A,($B6FF)  ; {Jump to #R$95CC if *#R$B6FF is #N$01.
 $9562 CP $01        ;
 $9564 JR Z,$95CC    ; }
 $9566 LD A,($B6E9)  ; Read *#R$B6E9.
; Find the object's record.
 $9569 CALL $9BCA    ; Call #R$9BCA to locate object.
 $956C LD ($B70A),IX ; Update *#R$B70A.
 $9570 CALL $9728    ; Call #R$9728 to report who is carrying the object.
 $9573 JR NZ,$959B   ; Jump to #R$959B if #R$9728 reported that another
                     ; character is carrying the object.
 $9575 CALL $A1D0    ; Call #R$A1D0 to match the action against the five verb
                     ; bytes.
 $9578 JR Z,$957E    ; Jump to #R$957E if #R$A1D0 found the action in the verb
                     ; list.
@label=Turn_RunTheHandlerIfPresent_Examine_ReadTheObject
*$957A LD IX,($B708) ; Read *#R$B708.
@label=Turn_RunTheHandlerIfPresent_Examine_ReadTheAction
*$957E LD A,($B6E7)  ; Read *#R$B6E7.
 $9581 CALL $9B81    ; Call #R$9B81 to find an action record.
 $9584 JR NC,$95CC   ; Jump to #R$95CC if #R$9B81 did not find the action
                     ; record.
@label=Turn_RunTheHandlerIfPresent_Examine_CallHandler
*$9586 LD L,(IX+$01) ; {Read the handler address from this action-list entry.
 $9589 LD H,(IX+$02) ; }
 $958C CALL $9B6C    ; Call #R$9B6C to call the handler stored for this action.
 $958F INC IX        ; {Jump back to #R$9586 if the next action-list byte is
 $9591 INC IX        ; zero.
 $9593 INC IX        ;
 $9595 SUB A         ;
 $9596 CP (IX+$00)   ;
 $9599 JR Z,$9586    ; }
@label=Check_Lit
*$959B LD A,($B6FA)  ; {If #R$B6FA is not #N$01 then jump to #R$95C7.
 $959E CP $01        ;
 $95A0 JR NZ,$95C7   ; }
; This check is a little unnecessary as the first thing the routine at #R$95ED
; does, is to check exactly this...
 $95A2 LD A,($B6EA)  ; {If #R$B6EA is not #N$00 (i.e.
 $95A5 CP $00        ; "#TEXTTOKEN($C11B+$08,$01)") then skip the "is location
 $95A7 JR NZ,$95AF   ; lit" check, instead jump to #R$95AF.}
; #R$95ED uses the carry flag to indicate if it is light or dark.
 $95A9 CALL $95ED    ; {If the location is dark then call #R$72DD to tell the
 $95AC CALL C,$72DD  ; user #R$AE1F("it is dark").}
@label=Check_Action
*$95AF LD A,($B6E7)  ; Read the current action.
 $95B2 LD B,A        ; Keep the current action in #REGb.
 $95B3 LD A,($B6E8)  ; {Call #R$95DF with #REGix=#R$B708 and #REGa=#R$B6E8.
 $95B6 LD IX,($B708) ;
 $95BA CALL $95DF    ; }
 $95BD LD A,($B6E9)  ; {Call #R$95DF with #REGix=#R$B70A and #REGa=#R$B6E9.
 $95C0 LD IX,($B70A) ;
 $95C4 CALL $95DF    ; }
; Performs housekeeping and returns.
@label=Check_Return
*$95C7 POP BC        ; {Restore #REGbc, #REGix and #REGhl from the stack.
 $95C8 POP IX        ;
 $95CA POP HL        ; }
 $95CB RET           ; Return.
; Checks if the action given is valid.
@label=Check_ValidAction
*$95CC LD A,($B6E7)  ; {Call #R$9DBD with #R$C730, to match the key value of
 $95CF LD IX,$C730   ; #R$B6E7.
 $95D3 CALL $9DBD    ; }
 $95D6 CP $FF        ; {Jump to #R$9586 if #R$9DBD found the action, rather
 $95D8 JR NZ,$9586   ; than the #N$FF terminator.}
@label=Turn_RunTheHandlerIfPresent_Examine_CannotDoThat
*$95DA CALL $72CE    ; {Else, call #R$72CE and jump to #R$95C7.
 $95DD JR $95C7      ; }

; Turn: Wake An Animal
;
; Used by the routines at #R$8FF5 and #R$950F.
; .
; Returns at once when this character is not an animal or is broken. Otherwise the
; special object is used.
@label=Turn_WakeAnAnimal
c$95DF BIT 6,(IX+$07) ; {Return if the object is not an animal.
 $95E3 RET Z          ; }
 $95E4 BIT 3,(IX+$07) ; {Return if the object is broken.
 $95E8 RET NZ         ; }
 $95E9 CALL $9AA0     ; Call #R$9AA0 to look the id up as a special object.
 $95EC RET            ; Return.

; Condition: Is The Location Lit?
;
; Used by the routines at #R$712B, #R$820B, #R$8D9D, #R$950F, #R$9B02 and
; #R$A3E6.
; .
; Reports whether the current location is lit.
;
; .
;
; We're only interested if the currently processed character is the player.
; Return if not.
@label=LocationLit
c$95ED LD A,($B6EA)   ; {Return if #R$B6EA is not zero.
 $95F0 AND A          ;
 $95F1 RET NZ         ; }
; Begin...
 $95F2 PUSH IX        ; {Save #REGix and #REGbc, and point #REGix at the
 $95F4 PUSH BC        ; player.}
; Check if the player object is inside "something".
 $95F5 LD IX,$C11B    ;
 $95F9 CALL $9E7A     ; Call #R$9E7A to test whether the container is lit.
 $95FC INC A          ; {If the player is inside of another object then jump to
 $95FD JR NZ,$9608    ; #R$9608.}
; Check the location data to see if this location is light or dark.
 $95FF CALL $9D37     ; Call #R$9D37 to point #REGix at this location.
 $9602 BIT 7,(IX+$00) ; {If the location is marked as being "LIGHT" then jump
 $9606 JR NZ,$9624    ; to #R$9624 to return.}
; The "#TEXTTOKEN($C305+$08,$01)" is a light source, can it be used?
@label=LocationLit_Sword
*$9608 PUSH IY        ; {Save #REGiy, point it at #OBJECT($0E,$01,$01)($), and
 $960A LD A,$0E       ; call #R$9E34.
 $960C LD IY,$C305    ;
 $9610 CALL $9E34     ; }
 $9613 POP IY         ; {Jump to #R$9620 if #R$9E34 did not find that object
 $9615 JR Z,$9620     ; here.}
 $9617 LD A,($C30C)   ; Read that object's attributes.
 $961A XOR $F7        ; XOR #EVAL($F7,$02,$08).
 $961C AND $1C        ; {Jump to #R$9628 if that object gives light, is not
 $961E JR Z,$9628     ; broken and is full.}
; The below handle the two responses for "light" and "dark" using the carry
; flag to signify darkness when set, and light unset.
@label=LocationLit_IsDark
*$9620 LD HL,$AE1F    ; Point at the message "it is dark" (#R$AE1F).
 $9623 SCF            ; Set carry: this location is dark.
@label=LocationLit_Return
*$9624 POP BC         ; {Restore #REGbc and #REGix from the stack.
 $9625 POP IX         ; }
 $9627 RET            ; Return.
@label=LocationLit_IsLight
*$9628 AND A          ; Clear carry: this location is lit.
 $9629 JR $9624       ; Jump back to #R$9624 to return.

; Turn: You See
;
; Used by the routine at #R$8EEC.
; .
; Prints "you see" and describes the place the player is in.
@label=YouSeeEntry
c$962B LD HL,$B000   ; Point at the message "You see[0x16]" (#R$B000).
 $962E JR $964D      ; Jump to #R$964D to print the location text.

; Turn: Describe This Location
;
; Used by the routines at #R$8C4B, #R$8D9D and #R$A9E5.
; .
; Describes this location: the preposition, "You are in", and the location
; text.
@label=YouSeePreposition
c$9630 PUSH AF       ; {Call #R$9BB1 to find this location's record.
 $9631 CALL $9BB1    ; }
 $9634 LD A,(IX+$00) ; {Fetch the location attribute, keep only bits 1-3 which
 $9637 AND %00001110 ; signify the location preposition ("IN", "ON", "AT",
                     ; etc).}
 $9639 LD E,A        ; {Create an offset for the preposition word look-up.
 $963A LD D,$00      ; }
 $963C LD HL,$BA80   ; {Add the offset to #R$BA80.
 $963F ADD HL,DE     ; }
 $9640 LD E,(HL)     ; {Fetch the referenced text bytes which display the
 $9641 INC HL        ; preposition word.
 $9642 LD D,(HL)     ; }
 $9643 LD HL,$AFFD   ; {Write the text tokens to #R$AFFC(#N$AFFD) which updates
 $9646 LD (HL),D     ; the copy for "You are XXXX[0x16]".
 $9647 INC HL        ;
 $9648 LD (HL),E     ; }
 $9649 POP AF        ; {Point at the message "You are in[0x16]".
 $964A LD HL,$AFFC   ; }
; This entry point is used by the routines at #R$962B and #R$A3E6.
@label=YouSee_Wrapper
*$964D PUSH IX       ; {Save #REGix, #REGiy and #REGbc and call #R$965B to
 $964F PUSH IY       ; print the location text.
 $9651 PUSH BC       ;
 $9652 CALL $965B    ; }
 $9655 POP BC        ; {Restore #REGbc, #REGiy and #REGix from the stack.
 $9656 POP IY        ;
 $9658 POP IX        ; }
 $965A RET           ; Return.

; Turn: Print The Location Text
;
; Used by the routine at #R$9630.
; .
; Prints the location text, draws the picture, waits for a key, and lists the exits and
; what is here.
;
; .
;
; From here starts the "intro" to a location;
; #LIST
; { Print the "You see[0x16]" text }
; { Handle printing the location data message for this location (if one exists) }
; { Handles initiating the location graphics/ drawing (if it exists) }
; { Handles waiting for a keypress (if something was drawn) }
; { Prints available exits }
; LIST#
@label=YouSeeStart
c$965B LD B,A        ; Store #REGa in #REGb temporarily.
 $965C CALL $9BB1    ; Call #R$9BB1 to set #REGix to point to the appropriate
                     ; #R$BA8A(location data) for the current location.
 $965F CALL $72DD    ; Call #R$72DD to print message.
 $9662 LD L,(IX+$08) ; {Load the #R$BA8A(location data) offset for the current
 $9665 LD H,(IX+$09) ; location description.}
 $9668 LD A,H        ; Use byte 9 of this object again.
 $9669 OR L          ; Combine this flag with the low byte.
 $966A CALL $9686    ; Call #R$9686 to print the location description.
 $966D LD A,B        ; {Call #R$7F78 with the location id.
 $966E CALL $7F78    ; }
 $9671 LD A,($7F77)  ; {Test if #R$7F77 contains #N($FF), call #R$969A if it
 $9674 INC A         ; does not (i.e. wait for a keypress only if something has
 $9675 CALL NZ,$969A ; been drawn).}
 $9678 CALL $8583    ; Call #R$8583 to print a newline.
 $967B LD A,B        ; {Call #R$A0C8 with the location id.
 $967C CALL $A0C8    ; }
; This entry point is used by the routine at #R$96A8.
@label=YouSee_Exits
*$967F LD A,B        ; {Call #R$A138 with the location id.
 $9680 CALL $A138    ; }
 $9683 JP $9F94      ; Jump to #R$9F94 to describe what is here.

; Turn: Print Or Describe
;
; Used by the routine at #R$965B.
; .
; Prints the location description when one is present. Otherwise it prints the location
; name.
@label=YouSeePrint
c$9686 JP NZ,$72DD   ; Jump to #R$72DD to print the location description if its
                     ; pointer in #REGhl is not zero (the caller sets the zero
                     ; flag).
; This entry point is used by the routine at #R$96A8.
@label=YouSeePrint_PrintTheLocationName
*$9689 LD DE,$0002   ; The location name starts #N$02 bytes into the record.
 $968C PUSH IY       ; {Point #REGiy at the name, #N$02 bytes into the record.
 $968E PUSH IX       ;
 $9690 POP IY        ;
 $9692 ADD IY,DE     ; }
 $9694 CALL $9ED6    ; Call #R$9ED6 to choose which noun byte to print.
 $9697 POP IY        ; Restore #REGiy from the stack.
 $9699 RET           ; Return.

; Turn: Wait For A Key
;
; Used by the routine at #R$965B.
; .
; Waits until a key is pressed, then sets the border to white.
;
; .
;
; This is the same key wait as #R$84C2, but it sets the border to white before
; returning.
@label=Turn_WaitForAKey
c$969A XOR A         ; {Read from the keyboard port.
 $969B IN A,($FE)    ; }
 $969D AND %00011111 ; Keep bits 0-4, one for each key in the half-row. XOR A
                     ; then IN A,(#N$FE) reads every half-row at once, and a
                     ; pressed key reads as a reset bit.
 $969F CP $1F        ; {Loop back to #R$969A until any key has been pressed.
 $96A1 JR Z,$969A    ; }
 $96A3 LD A,$07      ; {Set the border to white.
 $96A5 OUT ($FE),A   ; }
 $96A7 RET           ; Return.

; Turn: Describe And List
;
; Used by the routine at #R$8D9D.
; .
; Describes the location, prints its name, and lists the exits.
@label=YouSeeController
c$96A8 CALL $9BB1    ; Call #R$9BB1 to locate location.
 $96AB CALL $9689    ; Call #R$9689 to print the location name.
 $96AE CALL $8583    ; Call #R$8583 to print a newline.
 $96B1 JR $967F      ; Jump back to #R$967F to display exits.

; Turn: Advance The Other Characters
;
; Used by the routine at #R$7960.
; .
; Gives every other character a turn, running their scripts.
;
; .
;
; Save the registers used while the other characters take a turn.
@label=TurnAdvanceTheOtherCharacters
c$96B3 PUSH HL       ; {Save #REGhl, #REGix, #REGiy, #REGbc and #REGde, then
 $96B4 PUSH IX       ; call #R$A9D6 to run the location #N$25 event.
 $96B6 PUSH IY       ;
 $96B8 PUSH BC       ;
 $96B9 PUSH DE       ;
 $96BA CALL $A9D6    ; }
 $96BD CALL $980E    ; Call #R$980E to walk the special-object records.
 $96C0 SUB A         ; Clear the flag at #R$B6F0.
 $96C1 LD ($B6F0),A  ; Update *#R$B6F0.
 $96C4 INC A         ; The other characters start with messages held back.
 $96C5 LD ($B6FB),A  ; Store that in the message-suppressed flag.
 $96C8 LD ($B6FA),A  ; Update *#R$B6FA.
 $96CB LD IY,$CA84   ; Point #REGiy at the handler table at #R$CA84.
@label=TurnAdvanceTheOtherCharacters_Loop
*$96CF LD A,(IY+$00) ; Read the id from this handler record.
 $96D2 CP $FF        ; {Jump to #R$971B if this handler id is #N$FF.
 $96D4 JR Z,$971B    ; }
 $96D6 LD A,(IY+$01) ; Read the countdown from this handler record.
 $96D9 CP $00        ; {Jump to #R$9713 if the countdown is zero.
 $96DB JR Z,$9713    ; }
 $96DD DEC A         ; {Step the countdown down and jump to #R$96FE if it has
 $96DE LD (IY+$01),A ; not reached zero.
 $96E1 CP $00        ;
 $96E3 JR NZ,$96FE   ; }
 $96E5 LD A,($B6F0)  ; Read *#R$B6F0.
 $96E8 CP $01        ; {Jump to #R$96FE if the other-characters gate is #N$01.
 $96EA LD (IY+$01),A ;
 $96ED JR Z,$96FE    ; }
 $96EF INC A         ; Count on from the other-characters gate.
 $96F0 LD ($B6F0),A  ; Update *#R$B6F0.
 $96F3 LD L,(IY+$02) ; Read the low byte of the first handler.
 $96F6 LD H,(IY+$03) ; Read the high byte of the first handler.
; Run the handler for this action.
 $96F9 CALL $9B6C    ; Call #R$9B6C to call the handler stored for this action.
 $96FC JR $9713      ; Jump to #R$9713 to update the day flag.
@label=TurnAdvanceTheOtherCharacters_TestTheSecondFlag
*$96FE LD A,(IY+$04) ; Read the second flag from this handler record.
 $9701 CP $00        ; {Jump to #R$9713 if the second flag is zero.
 $9703 JR Z,$9713    ; }
 $9705 CP (IY+$01)   ; {Jump to #R$9713 if the second flag is below the
 $9708 JR C,$9713    ; countdown.}
 $970A LD L,(IY+$05) ; Read the low byte of the second handler.
 $970D LD H,(IY+$06) ; Read the high byte of the second handler.
; Run the handler for this action.
 $9710 CALL $9B6C    ; Call #R$9B6C to call the handler stored for this action.
@label=TurnAdvanceTheOtherCharacters_StepToTheNext
*$9713 LD DE,$0007   ; {Step the pointer on by #N$07 bytes.
 $9716 ADD IY,DE     ; }
 $9718 JP $96CF      ; Jump back to #R$96CF to try the next object.
@label=TurnAdvanceTheOtherCharacters_SetTheDayAndReturn
*$971B LD A,$01      ; {Write #N$01 (day) to *#R$B702.
 $971D LD ($B702),A  ; }
 $9720 POP DE        ; {Restore #REGde, #REGbc, #REGiy, #REGix and #REGhl from
 $9721 POP BC        ; the stack.
 $9722 POP IY        ;
 $9724 POP IX        ;
 $9726 POP HL        ; }
 $9727 RET           ; Return.

; Report Who Is Carrying An Object
;
; Used by the routine at #R$950F.
; .
; On the player's turn, if the object in #REGa is held by a visible animal, it prints
; "<animal> is carrying <object>" and returns with the zero flag clear; otherwise it returns
; with the zero flag set.
@label=Turn_ReportWhoIsCarryingAnObject
c$9728 CP $FF         ; {Return if the object id is #N$FF.
 $972A RET Z          ; }
 $972B PUSH IX        ; {Save #REGix, #REGiy and #REGbc, and keep the object id
 $972D PUSH IY        ; in #REGb.
 $972F PUSH BC        ;
 $9730 LD B,A         ; }
; Test whose turn it is.
 $9731 LD A,($B6EA)   ; {Jump to #R$973B if *#R$B6EA is #N$00 (the player).
 $9734 CP $00         ;
 $9736 JR Z,$973B     ; }
 $9738 XOR A          ; Set the zero flag.
 $9739 JR $9776       ; Jump to #R$9776 to return with the zero flag set.
@label=Turn_ReportWhoIsCarryingAnObject_RestoreTheId
*$973B LD A,B         ; Take the object id back into #REGa.
; Find the object's record.
 $973C CALL $9BCA     ; Call #R$9BCA to locate object.
 $973F LD A,(IX+$01)  ; Read where this object is from the object record.
 $9742 CP $FF         ; {Jump to #R$9776 if this object is not inside another
 $9744 JR Z,$9776     ; object.}
 $9746 LD A,B         ; Take the object id back into #REGa.
 $9747 PUSH IX        ; {Point #REGiy at this object and call #R$9C7B to test
 $9749 POP IY         ; whether the character whose turn it is is carrying it.
 $974B CALL $9C7B     ; }
 $974E JR C,$9776     ; Jump to #R$9776 if the character is carrying it.
; Find the object's record.
 $9750 CALL $9BCA     ; Call #R$9BCA to locate object.
 $9753 BIT 6,(IX+$07) ; {Jump to #R$9776 if the object is not an animal.
 $9757 JR Z,$9776     ; }
 $9759 LD A,($C122)   ; {Jump to #R$9776 if the player is not visible.
 $975C BIT 7,A        ;
 $975E JR Z,$9776     ; }
 $9760 LD L,(IY+$08)  ; Read the name token from #REGiy.
 $9763 LD H,(IY+$09)  ; Read the name token's high byte from #REGiy.
 $9766 PUSH HL        ; {Read the name token from the object record.
 $9767 LD L,(IX+$08)  ; }
 $976A LD H,(IX+$09)  ; Read the name token's high byte from the object record.
 $976D PUSH HL        ; {Point at the message "[0x04] is carrying[0x04][0x15]".
 $976E LD HL,$AFE4    ; }
 $9771 CALL $72DD     ; Call #R$72DD to print message.
 $9774 OR $01         ; Clear the zero flag.
@label=Turn_ReportWhoIsCarryingAnObject_Return
*$9776 POP BC         ; {Restore #REGbc, #REGiy and #REGix from the stack.
 $9777 POP IY         ;
 $9779 POP IX         ; }
 $977B RET            ; Return.

; Turn: The Player Has Died
;
; Used by the routine at #R$A302.
; .
; The player has died. The current object is marked broken, its copies are cleared, the
; tie is cut, and the character slots are walked.
;
; .
;
; Test the current object.
@label=Turn_ThePlayerHasDied
c$977C LD A,($B6E8)    ; {Jump to #R$90D2 if *#R$B6E8 is zero.
; This entry point is used by the routines at #R$9076, #R$9171, #R$92B5,
; #R$A302 and #R$A971.
*$977F AND A           ;
 $9780 JP Z,$90D2      ; }
 $9783 PUSH BC         ; {Save #REGbc, #REGiy and #REGix, and keep the object
 $9784 PUSH IY         ; id in #REGc.
 $9786 PUSH IX         ;
 $9788 LD C,A          ; }
; Find the object's record.
 $9789 CALL $9BCA      ; Call #R$9BCA to locate object.
 $978C SET 3,(IX+$07)  ; Mark the object broken.
 $9790 CALL $9D53      ; Call #R$9D53 to find where the object is.
 $9793 LD A,C          ; Use the current object again.
 $9794 CALL $9A85      ; Call #R$9A85 to find the special-object record.
 $9797 CP $FF          ; {Jump to #R$97A0 if this object has no special-object
 $9799 LD A,C          ; record.
 $979A JR Z,$97A0      ; }
 $979C LD (IY+$00),$00 ; Clear the special-object id.
@label=Turn_ThePlayerHasDied_ClearTheTieOnTheObject
*$97A0 CALL $A18C      ; Call #R$A18C to clear the tie on the object.
 $97A3 LD A,C          ; Use the current object again.
 $97A4 CALL $7F60      ; Call #R$7F60 to walk the character slots.
 $97A7 POP IX          ; {Restore #REGix, #REGiy and #REGbc from the stack.
 $97A9 POP IY          ;
 $97AB POP BC          ; }
 $97AC RET             ; Return.

; Turn: Reset To The Player
;
; Used by the routine at #R$6CEC.
; .
; Resets the turn to the player, clears the talk flag, and points the current character at
; the player's object.
@label=Turn_ResetToThePlayer
c$97AD SUB A         ; Clear the character, the scratch flag and the talk flag.
 $97AE LD ($B6EA),A  ; Update *#R$B6EA.
 $97B1 LD ($B6F1),A  ; Store the result at #R$B6F1.
 $97B4 LD ($B6F9),A  ; Update *#R$B6F9.
 $97B7 LD HL,$C11B   ; {Point *#R$B70C at "#TEXTTOKEN($C11B+$08,$01)".
 $97BA LD ($B70C),HL ; }
 $97BD LD A,$04      ; Roll a random number below #N$04.
; Roll a random number.
 $97BF CALL $9C9F    ; Call #R$9C9F to roll a number from the limit in #REGa.
 $97C2 INC A         ; Add one, making the roll #N$01-#N$04.
 $97C3 LD B,A        ; Copy the result into #REGb.
 $97C4 LD IY,$C808   ; Point #REGiy at #R$C808.
 $97C8 LD DE,$0006   ; Each entry is #N$06 bytes.
@label=Turn_ResetToThePlayer_StepToTheNextExtraExit
*$97CB ADD IY,DE     ; Step #REGiy on to the next #N$06-byte entry.
 $97CD DJNZ $97CB    ; Loop back to #R$97CB until the roll in #REGb runs out.
 $97CF LD ($A7D1),IY ; Plant this extra-exit entry in the LD IY at #R$A7CF.
 $97D3 LD L,(IY+$01) ; Read the low byte of this extra exit's direction token.
 $97D6 LD H,(IY+$02) ; Read the high byte of this extra exit's direction token.
 $97D9 LD B,$03      ; Count #N$03 passes.
@label=Turn_ResetToThePlayer_ClearTheBytes
*$97DB LD (HL),$00   ; Write zero into the byte #REGhl points at.
 $97DD INC HL        ; Step to the next byte.
 $97DE DJNZ $97DB    ; Loop back to #R$97DB until #N$03 runs out.
 $97E0 LD A,$03      ; Roll a random number below #N$03.
; Roll a random number.
 $97E2 CALL $9C9F    ; Call #R$9C9F to roll a number from the limit in #REGa.
 $97E5 LD E,A        ; Keep #N$03.
 $97E6 LD D,$00      ; The character-table offset's high byte is zero.
 $97E8 SLA E         ; Double the roll and keep the overflow.
 $97EA SLA E         ; Double the roll and keep the overflow.
 $97EC LD HL,$C7FC   ; {Index the riddle table at #R$C7FC.
 $97EF ADD HL,DE     ; }
 $97F0 LD ($B6EE),HL ; Update *#R$B6EE.
 $97F3 RET           ; Return.

; Turn: Finish The Sentence
;
; Used by the routines at #R$A5CA and #R$A5FB.
; .
; Finishes the sentence with the message at #REGhl, a full stop, and a newline.
;
; .
;
; Print the message at #REGhl.
@label=Turn_FinishTheSentence
c$97F4 CALL $72DD    ; Call #R$72DD to print message.
; Print a full stop.
 $97F7 LD A,$2E      ; {Print a full stop at the end of the sentence.
 $97F9 CALL $858B    ; }
 $97FC JP $8583      ; Jump to #R$8583 to print a newline.

; Turn: Gate The Message
;
; Used by the routines at #R$A302, #R$A4C0, #R$A5CA, #R$A5FB, #R$A86E and
; #R$AAA2.
; .
; Gates the message. The caller continues only when the message gate and the
; message-suppressed flag are both set.
@label=Turn_GateTheMessage
c$97FF PUSH BC       ; {Read *#R$B6FA.
 $9800 LD BC,($B6FA) ; }
 $9804 LD A,C        ; {Jump to #R$9809 if the message gate and the
 $9805 AND B         ; message-suppressed flag are both set.
 $9806 JR NZ,$9809   ;
 $9808 POP BC        ; }
@label=Turn_GateTheMessage_Return
*$9809 POP BC        ; Restore #REGbc from the stack.
 $980A RET           ; Return.
 $980B NOP           ; Try count for this turn. #R$9815 clears it, #R$99AA adds
                     ; one, and #R$9885 stops at #N$06.
 $980C NOP           ; Workspace byte. #R$9B12 writes whether the location is
                     ; dark.
 $980D NOP           ; Result of #R$9F82, written at #R$99EF and read at
                     ; #R$9A4B.
; This entry point is used by the routine at #R$96B3.
*$980E CALL $9B02    ; Call #R$9B02, the empty action, before the special
                     ; objects are walked.
 $9811 LD IY,$CACB   ; Point #REGiy at the special-object records.
@label=Turn_GateTheMessage_ClearTheTryCount
*$9815 XOR A         ; {Clear the try count.
 $9816 LD ($980B),A  ; }
 $9819 LD A,(IY+$00) ; Read the special-object id.
 $981C CP $FF        ; {Jump to #R$9909 at the end of the special-object
 $981E JP Z,$9909    ; records.}
 $9821 CP $00        ; {Jump to #R$9901 if this special-object id is zero.
 $9823 JP Z,$9901    ; }
 $9826 LD ($B6EA),A  ; Update *#R$B6EA.
 $9829 CALL $9F82    ; Call #R$9F82 to get object first location.
 $982C LD ($B70C),IX ; Update *#R$B70C.
 $9830 LD ($B6F6),A  ; Update *#R$B6F6.
 $9833 SUB A         ; Clear the time-of-day flag at #R$B702.
 $9834 LD ($B702),A  ; Update *#R$B702.
 $9837 LD A,(IY+$00) ; Read the special-object id.
 $983A PUSH IY       ; {Save #REGiy and point it at #OBJECT($00,$01,$01)($).
 $983C LD IY,$C11B   ; }
 $9840 CALL $9E25    ; Call #R$9E25 to swap the objects and test visibility
                     ; again.
 $9843 POP IY        ; {Jump to #R$9868 if #R$9E25 did not find the object
 $9845 JR Z,$9868    ; visible.}
; Test the flag.
 $9847 LD A,($980C)  ; {Jump to #R$9868 if *#R$980C is #N$02.
 $984A CP $02        ;
 $984C JR Z,$9868    ; }
 $984E LD A,$01      ; {Write #N$01 (day) to *#R$B702.
 $9850 LD ($B702),A  ; }
; Test the flag.
 $9853 LD A,($980C)  ; {Jump to #R$9868 if *#R$980C is not #N$01.
 $9856 CP $01        ;
 $9858 JR NZ,$9868   ; }
 $985A INC A         ; Count on from the turn phase.
 $985B LD ($980C),A  ; Store the result at #R$980C.
; Say "you{5} hear a noise".
 $985E LD HL,$B027   ; {Point #REGhl at the message and call #R$72DD.
 $9861 CALL $72DD    ; }
 $9864 SUB A         ; Clear the time-of-day flag at #R$B702.
 $9865 LD ($B702),A  ; Update *#R$B702.
@label=Turn_GateTheMessage_TestIfInside
*$9868 LD A,$FF      ; {Jump to #R$9B16 if this object is inside another
 $986A CP (IX+$01)   ; object.
 $986D JP NZ,$9B16   ; }
; This entry point is used by the routine at #R$9B16.
*$9870 LD IX,($B70C) ; Read *#R$B70C.
 $9874 CALL $7F10    ; Call #R$7F10 to keep the character slot.
 $9877 LD A,$00      ; {Take zero, and jump to #R$987C unless #R$7F10 found
 $9879 JR NZ,$987C   ; this character's slot.}
 $987B INC A         ; Count on from zero.
@label=Turn_GateTheMessage_StoreTheSlotFlag
*$987C LD ($B6F4),A  ; Store the slot flag at #R$B6F4.
; This entry point is used by the routine at #R$9918.
@label=Turn_GateTheMessage_ReadTheScriptPointer
*$987F LD L,(IY+$02) ; Read the low byte of the script pointer.
 $9882 LD H,(IY+$03) ; Read the high byte of the script pointer.
; This entry point is used by the routine at #R$9918.
; .
; Test the flag.
@label=Turn_GateTheMessage_TestTheTryCount
*$9885 LD A,($980B)  ; {Jump to #R$9901 if the try count is #N$06.
 $9888 CP $06        ;
 $988A JR Z,$9901    ; }
 $988C LD A,(HL)     ; Read the next script byte.
 $988D LD DE,$0004   ; The next field is #N$04 bytes on.
 $9890 PUSH HL       ; {Point #REGix at this script byte.
 $9891 POP IX        ; }
 $9893 AND $0F       ; {Jump to #R$98CB if the low nibble of the script byte is
 $9895 CP $05        ; not below #N$05.
 $9897 JR NC,$98CB   ; }
; Test the flag.
 $9899 LD A,($B6F4)  ; {Jump to #R$98BF if *#R$B6F4 is not #N$01.
 $989C CP $01        ;
 $989E JR NZ,$98BF   ; }
 $98A0 BIT 6,(HL)    ; {Jump to #R$98BF if bit 6 of the script byte is set.
 $98A2 JR NZ,$98BF   ; }
 $98A4 SUB A         ; Clear the flag at #R$B6F4.
 $98A5 LD ($B6F4),A  ; Store the result at #R$B6F4.
 $98A8 INC A         ; Set #REGa to #N$01 for #R$7F1A.
 $98A9 CALL $7F1A    ; Call #R$7F1A to save the clause and act.
 $98AC JR Z,$98BF    ; Jump to #R$98BF if #R$7F1A returned with the zero flag
                     ; set.
; Update the message gate.
 $98AE LD A,$01      ; {Hold messages back: set the message gate and the
 $98B0 LD ($B6FA),A  ; message-suppressed flag.
 $98B3 LD ($B6FB),A  ; }
 $98B6 LD HL,$9901   ; Point #REGhl at #R$9901, where the message routine
                     ; should return.
 $98B9 PUSH HL       ; {Jump to #R$99CE to test the noun-print flag.
 $98BA PUSH IX       ;
 $98BC JP $99CE      ; }
@label=Turn_GateTheMessage_TestTheEntryKind
*$98BF LD A,(HL)     ; {Jump to #R$9974 if the low nibble of the script code is
 $98C0 AND $0F       ; #N$04.
 $98C2 CP $04        ;
 $98C4 JP Z,$9974    ; }
 $98C7 JR C,$9928    ; Jump to #R$9928 if the low nibble of the script code is
                     ; below #N$04.
 $98C9 JR $9901      ; Jump to #R$9901 to step on to the next special object.
@label=Turn_GateTheMessage_TakeThePointer
*$98CB CP $0E        ; {Jump to #R$98DD if the low nibble of the script code is
 $98CD JR NZ,$98DD   ; not #N$0E.}
 $98CF LD E,(IX+$01) ; Read the next byte of this script.
 $98D2 LD (IY+$02),E ; Store it as the low byte of the script pointer.
 $98D5 LD E,(IX+$02) ; Read the byte after that.
 $98D8 LD (IY+$03),E ; Store it as the high byte of the script pointer.
 $98DB JR $987F      ; Jump back to #R$987F to read the script pointer.
@label=Turn_GateTheMessage_TakeTheCount
*$98DD CP $0C        ; {Jump to #R$98EC if the low nibble of the script code is
 $98DF JR NZ,$98EC   ; not #N$0C.}
 $98E1 LD B,(IX+$01) ; Read the next script byte into #REGb.
 $98E4 LD A,(IY+$00) ; Read the special-object id.
 $98E7 CALL $9AA0    ; Call #R$9AA0 to look the id up as a special object.
 $98EA JR $987F      ; Jump back to #R$987F to read the script pointer.
@label=Turn_GateTheMessage_PickAtRandom
*$98EC CP $0F        ; {Jump to #R$98F5 if this script code is not #N$0F.
 $98EE JR NZ,$98F5   ; }
 $98F0 CALL $9A59    ; Call #R$9A59 to pick a random script entry.
 $98F3 JR $987F      ; Jump back to #R$987F to read the script pointer.
@label=Turn_GateTheMessage_TestForNoCode
*$98F5 CP $00        ; {Jump to #R$98FC if this script code is not zero.
 $98F7 JR NZ,$98FC   ; }
 $98F9 ADD HL,DE     ; Step the script pointer in #REGhl on by #N$04 bytes.
 $98FA JR $9885      ; Jump back to #R$9885 to try the next script entry.
@label=Turn_GateTheMessage_KeepTheSmaller
*$98FC SUB A         ; Clear #REGe before the locations are compared.
 $98FD LD E,A        ; Clear #REGe.
 $98FE CALL $9A68    ; Call #R$9A68 to keep the smaller of the location and the
                     ; roll.
; This entry point is used by the routines at #R$9918 and #R$9B16.
@label=Turn_GateTheMessage_StepThePointerOnBySevenBytes
*$9901 LD DE,$0007   ; {Step the pointer on by #N$07 bytes.
 $9904 ADD IY,DE     ; }
 $9906 JP $9815      ; Jump back to #R$9815 to try the next special object.
@label=Turn_GateTheMessage_ClearTheCharacterWhoseTurn
*$9909 SUB A         ; Clear the character whose turn it is.
 $990A LD ($B6EA),A  ; Update *#R$B6EA.
 $990D INC A         ; Count on to #N$01 for the day flag.
 $990E LD ($B702),A  ; Update *#R$B702.
 $9911 LD HL,$C11B   ; {Point *#R$B70C at "#TEXTTOKEN($C11B+$08,$01)".
 $9914 LD ($B70C),HL ; }
 $9917 RET           ; Return.

; Turn: Step The Script Pointer
;
; Stores a script pointer on the special-object record. Bit 4 of the script byte skips
; two bytes first.
@label=Turn_StepTheScriptPointer
c$9918 ADD HL,DE       ; {Step #REGhl on, and jump to #R$9921 if bit 4 of this
 $9919 BIT 4,(IX+$00)  ; script byte is clear.
 $991D JR Z,$9921      ; }
 $991F INC HL          ; {Skip two bytes of the pointer.
 $9920 INC HL          ; }
@label=Turn_StepTheScriptPointer_StoreThePointer
*$9921 LD (IY+$02),L   ; Store the low byte of the script pointer on the
                       ; special-object record.
 $9924 LD (IY+$03),H   ; Store the high byte of the script pointer on the
                       ; special-object record.
 $9927 RET             ; Return.
; This entry point is used by the routine at #R$97FF.
@label=Turn_StepTheScriptPointer_RunTheScriptEntry
*$9928 CALL $9918      ; Call #R$9918 to step the script pointer past this
                       ; entry and store it on the special-object record.
 $992B BIT 0,(IX+$00)  ; {Jump to #R$994A if bit 0 of this script byte is set.
 $992F JR NZ,$994A     ; }
 $9931 LD A,(IX+$01)   ; Read the action id from this script.
 $9934 LD ($B6E7),A    ; Update *#R$B6E7.
 $9937 LD A,(IX+$02)   ; Read the object id from this script.
 $993A LD ($B6E8),A    ; Update *#R$B6E8.
 $993D LD A,(IX+$03)   ; Read the second object id from this script.
 $9940 LD ($B6E9),A    ; Update *#R$B6E9.
 $9943 CALL $99C6      ; Call #R$99C6 to build the action sentence from the
                       ; saved match.
 $9946 JR Z,$99AA      ; Jump to #R$99AA if #R$99C6 returned zero.
 $9948 JR $9967        ; Jump to #R$9967 to skip updating the message gate.
@label=Turn_StepTheScriptPointer_ReadTheHandlerAddress
*$994A LD L,(IX+$01)   ; Read the low byte of the handler address.
 $994D LD H,(IX+$02)   ; Read the high byte of the handler address.
 $9950 SUB A           ; Clear A so the message gate and the message-suppressed
                       ; flag are both cleared.
 $9951 LD ($B6FA),A    ; Clear the message gate so the handler may speak.
 $9954 LD ($B6FB),A    ; Clear the message-suppressed flag before the handler
                       ; runs.
; Run the handler for this action.
 $9957 CALL $9B6C      ; Call #R$9B6C to call the handler stored for this
                       ; action.
; Test the message-suppressed flag.
 $995A LD A,($B6FB)    ; {Jump to #R$99AA unless the message-suppressed flag is
 $995D CP $01          ; #N$01.
 $995F JR NZ,$99AA     ; }
 $9961 LD ($B6FA),A    ; Update *#R$B6FA.
; Run the handler for this action.
 $9964 CALL $9B6C      ; Call #R$9B6C to call the handler stored for this
                       ; action.
@label=Turn_StepTheScriptPointer_TestAndClear
*$9967 BIT 5,(IX+$00)  ; {Jump back to #R$9901 if bit 5 of this script byte is
 $996B JP Z,$9901      ; clear.}
 $996E LD (IX+$00),$00 ; Clear this script byte.
 $9972 JR $9901        ; Jump back to #R$9901 to clear *#R$980B.
; This entry point is used by the routine at #R$97FF.
@label=Turn_StepTheScriptPointer_StepTwoBytes
*$9974 LD DE,$0002     ; Step the script pointer by #N$02 bytes.
 $9977 CALL $9918      ; Call #R$9918 to step the script pointer past this
                       ; entry and store it on the special-object record.
 $997A LD A,(IX+$01)   ; Read the next byte of this script.
 $997D CP $FF          ; {Jump to #R$9994 if that script byte is #N$FF.
 $997F JR Z,$9994      ; }
 $9981 LD ($B6E7),A    ; Update *#R$B6E7.
; Update the current object.
 $9984 LD A,$FF        ; {Write #N$FF to *#R$B6E8 and *#R$B6E9.
 $9986 LD ($B6E8),A    ;
 $9989 LD ($B6E9),A    ; }
 $998C CALL $99C6      ; Call #R$99C6 to build the action sentence from the
                       ; saved match.
 $998F JR Z,$99AA      ; Jump to #R$99AA if #R$99C6 returned zero.
 $9991 JP $9901        ; Jump back to #R$9901 to clear *#R$980B.
@label=Turn_StepTheScriptPointer_FollowThePointer
*$9994 BIT 4,(IX+$00)  ; {Jump back to #R$9901 if bit 4 of this script byte is
 $9998 JP Z,$9901      ; clear.}
 $999B LD L,(IX+$02)   ; Read the low byte of the pointer in this script.
 $999E LD H,(IX+$03)   ; Read the high byte of the pointer in this script.
 $99A1 LD (IY+$02),L   ; Store the low byte of that pointer on the
                       ; special-object record.
 $99A4 LD (IY+$03),H   ; Store the high byte of that pointer on the
                       ; special-object record.
 $99A7 JP $9901        ; Jump back to #R$9901 to clear *#R$980B.
@label=Turn_StepTheScriptPointer_CountAnotherTry
*$99AA LD HL,$980B     ; Point #REGhl at #R$980B.
 $99AD INC (HL)        ; Count one more try.
 $99AE BIT 4,(IX+$00)  ; {Jump back to #R$987F if bit 4 of this script byte is
 $99B2 JP Z,$987F      ; clear.}
 $99B5 ADD IX,DE       ; Step the script pointer on by #REGde.
 $99B7 LD H,(IX+$01)   ; Read the high byte of the word at this script byte.
 $99BA LD L,(IX+$00)   ; Read this script byte into #REGl.
 $99BD LD (IY+$02),L   ; Store the low byte of that word on the special-object
                       ; record.
 $99C0 LD (IY+$03),H   ; Store the high byte of that word on the special-object
                       ; record.
 $99C3 JP $9885        ; Branch #R$9885 on this test.

; Turn: Apply The Saved Match
;
; Used by the routines at #R$9918 and #R$9B16.
; .
; Builds the action sentence through #R$7AF5 and returns when that routine sets
; the zero flag.
@label=Turn_ApplyTheSavedMatch
c$99C6 PUSH IX       ; {Save the script pointer and call #R$7AF5 to build the
 $99C8 CALL $7AF5    ; action sentence.}
 $99CB JP Z,$9A56    ; Jump to #R$9A56 if #R$7AF5 returned with the zero flag
                     ; set.
; This entry point is used by the routine at #R$97FF.
; .
; Test the noun-print flag.
@label=Turn_ApplyTheSavedMatch_TestTheNounPrintFlag
*$99CE LD A,($B6FE)  ; {Jump to #R$9A32 if *#R$B6FE is #N$01.
 $99D1 CP $01        ;
 $99D3 JR Z,$9A32    ; }
; Test the current action.
 $99D5 LD A,($B6E7)  ; {Jump to #R$99E5 if *#R$B6E7 is not #N$1E.
 $99D8 CP $1E        ;
 $99DA JR NZ,$99E5   ; }
 $99DC LD A,($B6F6)  ; Read *#R$B6F6.
 $99DF LD HL,$C12B   ; Point #REGhl at *#R$C12B.
 $99E2 CP (HL)       ; {Jump to #R$9A32 if the script location is not the
 $99E3 JR NZ,$9A32   ; current location.}
; Test the current object.
@label=Turn_ApplyTheSavedMatch_TestForNoObject
*$99E5 LD A,($B6E8)  ; {Jump to #R$9A2B if *#R$B6E8 is #N$FF.
 $99E8 CP $FF        ;
 $99EA JR Z,$9A2B    ; }
 $99EC CALL $9F82    ; Call #R$9F82 to get object first location.
 $99EF LD ($980D),A  ; {Jump to #R$9A2B unless #R$9F82 returned #N$FF.
 $99F2 CP $FF        ;
 $99F4 JR NZ,$9A2B   ; }
 $99F6 LD BC,($B6F5) ; Read *#R$B6F5.
 $99FA LD A,C        ; {Jump to #R$9A2B if the script location (*#R$B6F6) is
 $99FB CP B          ; where the player starts (*#R$B6F5).
 $99FC JR Z,$9A2B    ; }
 $99FE LD B,(IX+$00) ; Load the copy count into #REGb.
@label=Turn_ApplyTheSavedMatch_TestWhetherTheObjectIsHere
*$9A01 CP (IX+$10)   ; {Jump to #R$9A0C if the current object is the object's
 $9A04 JR Z,$9A0C    ; location.}
 $9A06 INC IX        ; Step to the next byte of this object.
 $9A08 DJNZ $9A01    ; Loop back to #R$9A01 until every copy's location has
                     ; been checked.
 $9A0A JR $9A2B      ; Jump to #R$9A2B to describe the action.
@label=Turn_ApplyTheSavedMatch_ReadTheCurrentCharacter
*$9A0C LD A,($B6EA)  ; Read *#R$B6EA.
 $9A0F LD B,A        ; Copy the result into #REGb.
 $9A10 LD A,$FF      ; {Write #N$FF to *#R$B6EA.
 $9A12 LD ($B6EA),A  ; }
 $9A15 LD A,$01      ; {Write #N$01 (day) to *#R$B702.
 $9A17 LD ($B702),A  ; }
 $9A1A PUSH IY       ; {Call #R$712B to print the sentence for the current
 $9A1C CALL $712B    ; action.}
 $9A1F POP IY        ; {Clear the time-of-day flag at #R$B702.
 $9A21 SUB A         ; }
 $9A22 LD ($B702),A  ; Update *#R$B702.
 $9A25 LD A,B        ; Use the character whose turn it is again.
 $9A26 LD ($B6EA),A  ; Update *#R$B6EA.
 $9A29 JR $9A32      ; Jump to #R$9A32 to run the handler, as the action has
                     ; already been described.
@label=Turn_ApplyTheSavedMatch_PrintTheSentence
*$9A2B PUSH IY       ; {Call #R$712B to print the sentence for the current
 $9A2D CALL $712B    ; action.
 $9A30 POP IY        ; }
@label=Turn_ApplyTheSavedMatch_RunTheHandler
*$9A32 CALL $950F    ; Call #R$950F to run the handler when one is present.
 $9A35 LD A,($B6EA)  ; Read *#R$B6EA.
 $9A38 LD HL,$B6F6   ; Point #REGhl at the script location.
 $9A3B LD DE,$B017   ; Point #REGde at #R$B017.
 $9A3E CALL $9ACD    ; Call #R$9ACD to print a line about another character
                     ; here.
; Test the noun-print flag.
 $9A41 LD A,($B6FE)  ; {Jump to #R$9A54 if *#R$B6FE is #N$01.
 $9A44 CP $01        ;
 $9A46 JR Z,$9A54    ; }
 $9A48 LD A,($B6E8)  ; Read *#R$B6E8.
 $9A4B LD HL,$980D   ; Point #REGhl at #R$980D.
 $9A4E LD DE,$B01C   ; Point #REGde at #R$B01C.
 $9A51 CALL $9ACD    ; Call #R$9ACD to print a line about another character
                     ; here.
@label=Turn_ApplyTheSavedMatch_ClearTheZeroFlag
*$9A54 OR $01        ; Clear the zero flag.
@label=Turn_ApplyTheSavedMatch_RestoreTheSavedMatch
*$9A56 POP IX        ; Restore #REGix from the stack.
 $9A58 RET           ; Return.

; Turn: Pick A Script Entry
;
; Used by the routine at #R$97FF.
; .
; Takes the smaller of the script limit and the special-object limit, rolls below that,
; and stores the script pointer from the chosen entry.
@label=Turn_PickAScriptEntry
c$9A59 LD A,(IX+$01) ; Read the limit from this script byte.
 $9A5C CP (IY+$01)   ; {Jump to #R$9A64 if that limit is below the
 $9A5F JR C,$9A64    ; special-object limit.}
 $9A61 LD A,(IY+$01) ; Use the special-object limit instead.
; Roll a random number.
@label=Turn_PickAScriptEntry_RollBelowTheLimit
*$9A64 CALL $9C9F    ; Call #R$9C9F to roll a number from the limit in #REGa.
 $9A67 LD E,A        ; Keep the roll in #REGe.
; This entry point is used by the routine at #R$97FF.
*$9A68 LD A,(IY+$01) ; Read the special-object limit.
 $9A6B CP E          ; {Jump to #R$9A6F if the special-object limit is not
 $9A6C JR NC,$9A6F   ; below the roll.}
 $9A6E LD E,A        ; Keep the special-object limit in #REGe.
@label=Turn_PickAScriptEntry_Store
*$9A6F LD L,(IY+$04) ; Read the low byte of the table pointer.
 $9A72 LD H,(IY+$05) ; Read the high byte of the table pointer.
 $9A75 LD D,$00      ; The record offset's high byte is zero.
 $9A77 ADD HL,DE     ; Add the roll in #REGde.
 $9A78 ADD HL,DE     ; Add the roll in #REGde again.
 $9A79 ADD HL,DE     ; Add the roll in #REGde a third time. Each entry is three
                     ; bytes.
 $9A7A INC HL        ; Step to the next byte.
 $9A7B LD E,(HL)     ; Read the low byte of the chosen script pointer.
 $9A7C INC HL        ; Step to the next byte.
 $9A7D LD D,(HL)     ; Read the high byte of the chosen script pointer.
 $9A7E LD (IY+$02),E ; {Store the chosen script pointer in bytes 2 and 3 of the
 $9A81 LD (IY+$03),D ; special-object record.}
 $9A84 RET           ; Return.

; Table: Find A Special Object
;
; Used by the routines at #R$9034, #R$977C and #R$9AA0.
; .
; Finds a special object by its index.
;
; A The index to search for
@label=TableFindASpecialObject
c$9A85 PUSH DE       ; {Keep the id being sought.
 $9A86 PUSH BC       ;
 $9A87 LD B,A        ; }
 $9A88 LD HL,$CACB   ; Point #REGhl at the special-object records.
 $9A8B LD DE,$0007   ; Each special-object entry is #N$07 bytes.
@label=TableFindASpecialObject_Loop
*$9A8E LD A,(HL)     ; {If the current pointer matches our key jump to #R$9A9A.
 $9A8F CP B          ;
 $9A90 JR Z,$9A9A    ; }
 $9A92 CP $FF        ; {Jump to #R$9A9A at the end of the special-object
 $9A94 JR Z,$9A9A    ; records.}
 $9A96 ADD HL,DE     ; Increase the pointer address by #N($0007,$04,$04) (using
                     ; #REGde).
 $9A97 JP $9A8E      ; Jump back to #R$9A8E for the next special-object record.
@label=TableFindASpecialObject_PointAtTheRecord
*$9A9A POP BC        ; {Restore #REGbc and #REGde from the stack, and copy the
 $9A9B POP DE        ; special-object record from #REGhl into #REGiy.
 $9A9C PUSH HL       ;
 $9A9D POP IY        ; }
 $9A9F RET           ; Return.

; Turn: Use A Special Object
;
; Used by the routines at #R$95DF and #R$97FF.
; .
; Uses a special object. It scans the seven-byte records until the id is #N$FF and looks
; that id up in the table.
@label=Turn_UseASpecialObject
c$9AA0 PUSH IY       ; {Call #R$9A85 to find the special-object record.
 $9AA2 PUSH IX       ;
 $9AA4 CALL $9A85    ; }
 $9AA7 CP $FF        ; {Jump to #R$9AC8 if the termination character was
 $9AA9 JR Z,$9AC8    ; reached.}
 $9AAB LD L,(IY+$04) ; Read the low byte of the table pointer on this
                     ; special-object record.
 $9AAE LD H,(IY+$05) ; Read the high byte of that table pointer.
 $9AB1 PUSH HL       ; {Point #REGix at the table named by this special entry.
 $9AB2 POP IX        ; }
 $9AB4 LD A,B        ; Use the result again.
 $9AB5 CALL $9DBD    ; Call #R$9DBD to look this id up in the table.
 $9AB8 CP $FF        ; {Jump to #R$9AC8 if the termination character was
 $9ABA JR Z,$9AC8    ; reached.}
 $9ABC LD L,(IX+$01) ; {Store the address #R$9DBD found into bytes 2 and 3 of
 $9ABF LD H,(IX+$02) ; this special-object record.
 $9AC2 LD (IY+$02),L ;
 $9AC5 LD (IY+$03),H ; }
@label=Turn_UseASpecialObject_RestoreTheSpecialObject
*$9AC8 POP IX        ; {Restore #REGix and #REGiy from the stack.
 $9ACA POP IY        ; }
 $9ACC RET           ; Return.

; Turn: Report A Character
;
; Used by the routine at #R$99C6.
; .
; Prints a line about another character in this place.
@label=TurnReportACharacter
c$9ACD CP $FF        ; {Return if the object id is #N$FF.
 $9ACF RET Z         ; }
 $9AD0 AND A         ; See whether the object id is zero.
 $9AD1 RET Z         ; Return if the result is zero.
 $9AD2 LD B,A        ; {Return if the turn phase is #N$02.
 $9AD3 LD A,($980C)  ;
 $9AD6 CP $02        ;
 $9AD8 RET Z         ; }
 $9AD9 LD A,B        ; Use the result again.
 $9ADA CALL $9F82    ; Call #R$9F82 to get object first location.
 $9ADD LD C,A        ; {Return if the byte at #REGhl equals this object's
 $9ADE CP (HL)       ; location.
 $9ADF RET Z         ; }
 $9AE0 LD A,($B6F5)  ; Read *#R$B6F5.
 $9AE3 CP C          ; {Return unless *#R$B6F5 matches #REGc.
 $9AE4 RET NZ        ; }
 $9AE5 LD A,($9BDC)  ; {Return if the flag at #R$9BDC is zero.
 $9AE8 AND A         ;
 $9AE9 RET Z         ; }
 $9AEA LD A,$01      ; {Write #N$01 (day) to *#R$B702.
 $9AEC LD ($B702),A  ; }
 $9AEF PUSH DE       ; {Point #REGhl at the address in #REGde and take #REGb
 $9AF0 POP HL        ; into #REGa.
 $9AF1 LD A,B        ; }
; Find the object's record.
 $9AF2 CALL $9BCA    ; Call #R$9BCA to locate object.
 $9AF5 PUSH DE       ; {Step the pointer on by #N$08 bytes.
 $9AF6 LD DE,$0008   ;
 $9AF9 ADD IX,DE     ; }
 $9AFB POP DE        ; {Restore #REGde from the stack, save the name pointer,
 $9AFC PUSH IX       ; and call #R$72DD to print the message.}
; Print the message at #REGhl.
 $9AFE CALL $72DD    ;
 $9B01 RET           ; Return.

; Action: None
;
; Used by the routines at #R$97FF and #R$9BDC.
; .
; The empty action. Records where the player is and does nothing else.
; Reached through the action table at #R$C730, dispatched by #R$950F.
@label=Action_None
c$9B02 LD A,$00      ; {Call #R$9F82 for #OBJECT($00,$01,$01)($).
 $9B04 CALL $9F82    ; }
 $9B07 LD ($B6F5),A  ; Write #REGa to #R$B6F5.
 $9B0A CALL $95ED    ; Call #R$95ED to test whether the location is lit.
 $9B0D LD A,$00      ; Start from zero.
 $9B0F JR NC,$9B12   ; If it is light jump to #R$9B12.
 $9B11 INC A         ; Make it #N$01 when the location is dark.
@label=Action_None_StoreTheDarkFlag
*$9B12 LD ($980C),A  ; Write #REGa to #R$980C.
 $9B15 RET           ; Return.

; Action: Climb
;
; Used by the routine at #R$97FF.
; .
; Climbs the current object.
@label=ActionClimb
c$9B16 LD A,$FF       ; {Write #N$FF to *#R$B6E9.
 $9B18 LD ($B6E9),A   ; }
 $9B1B LD A,(IX+$01)  ; Read where this object is from the object record.
 $9B1E LD ($B6E8),A   ; Update *#R$B6E8.
; Find the object's record.
 $9B21 CALL $9BCA     ; Call #R$9BCA to locate object.
 $9B24 BIT 3,(IX+$07) ; {Jump back to #R$9870 if the object is broken.
 $9B28 JP NZ,$9870    ; }
 $9B2B BIT 6,(IX+$07) ; {Jump back to #R$9870 if the object is an animal.
 $9B2F JP NZ,$9870    ; }
 $9B32 BIT 5,(IX+$07) ; {Jump back to #R$9901 if the object is not open.
 $9B36 JP Z,$9901     ; }
 $9B39 LD A,$37       ; {Write #N$37 (climb out) to *#R$B6E7.
 $9B3B LD ($B6E7),A   ; }
 $9B3E CALL $99C6     ; Call #R$99C6 to build the action sentence from the
                      ; saved match.
 $9B41 JP $9901       ; Jump back to #R$9901 to clear *#R$980B.

; Turn: Accept The Named Object
;
; Used by the routines at #R$94D6 and #R$950F.
; .
; Accepts the named object as the current one. A zero object counts as one; otherwise the
; noun flags must agree.
@label=Turn_AcceptTheNamedObject
c$9B44 LD A,($B6E8)  ; Read *#R$B6E8.
 $9B47 INC A         ; {Jump to #R$9B4C if the current object is not #N$FF.
 $9B48 JR NZ,$9B4C   ; }
 $9B4A INC A         ; Make #REGa #N$01 (no object counts as one).
 $9B4B RET           ; Return.
; Test the noun-print flag.
@label=Turn_AcceptTheNamedObject_TestTheNounFlag
*$9B4C LD A,($B6FE)  ; {Jump to #R$9B5F if *#R$B6FE is not zero.
 $9B4F AND A         ;
 $9B50 JR NZ,$9B5F   ; }
 $9B52 LD HL,$B6E8   ; Point #REGhl at the current object.
 $9B55 LD A,($B6EA)  ; Read *#R$B6EA.
 $9B58 CP (HL)       ; {Return if the character whose turn it is is the current
 $9B59 RET Z         ; object.}
 $9B5A LD A,($B6E9)  ; Read *#R$B6E9.
 $9B5D CP (HL)       ; {Return if the second object is the current object.
 $9B5E RET Z         ; }
@label=Turn_AcceptTheNamedObject_TestTheSecondNoun
*$9B5F LD A,($B6FF)  ; Read *#R$B6FF.
 $9B62 AND A         ; {Return if the second-noun flag is not zero.
 $9B63 RET NZ        ; }
 $9B64 LD A,($B6E9)  ; Read *#R$B6E9.
 $9B67 LD HL,$B6EA   ; Point #REGhl at the character whose turn it is.
 $9B6A CP (HL)       ; Compare the second object with the character whose turn
                     ; it is.
 $9B6B RET           ; Return.

; Action: Call The Handler
;
; Used by the routines at #R$8D9D, #R$950F, #R$96B3, #R$9918 and #R$9F4A.
; .
; Calls the handler address stored for an action.
;
; HL Pointer to the action code
;
; Save the registers and call the handler when its address is not zero.
@label=TriggerAction
c$9B6C PUSH IX       ; {Save #REGix, #REGiy, #REGde, #REGbc and the handler
 $9B6E PUSH IY       ; address, and call #R$9B80 when that address is not zero.
 $9B70 PUSH DE       ;
 $9B71 PUSH BC       ;
 $9B72 PUSH HL       ;
 $9B73 LD A,L        ;
 $9B74 OR H          ;
 $9B75 CALL NZ,$9B80 ; }
 $9B78 POP HL        ; {Restore #REGhl, #REGbc, #REGde, #REGiy and #REGix from
 $9B79 POP BC        ; the stack.
 $9B7A POP DE        ;
 $9B7B POP IY        ;
 $9B7D POP IX        ; }
 $9B7F RET           ; Return.

; Table: Jump To The Record
;
; Used by the routine at #R$9B6C.
; .
; Jumps to the action handler the caller addressed.
@label=TriggerAction_Jump
c$9B80 JP (HL)       ; Jump to the action handler the caller addressed.

; Table: Find An Action Record
;
; Used by the routines at #R$92ED, #R$94D6 and #R$950F.
; .
; Finds an action handler. The copy count plus #N$10 is where the action list
; starts.
@label=TableFindAnActionRecord
c$9B81 PUSH DE       ; {Save #REGde, keep the action id in #REGd, and read the
 $9B82 LD D,A        ; copy count.
 $9B83 LD A,(IX+$00) ; }
 $9B86 ADD A,$10     ; Add #N$10 to the copy count. The action list starts that
                     ; far into the object.
 $9B88 LD E,A        ; Keep the copy count plus #N$10.
 $9B89 LD A,D        ; Use the result again.
 $9B8A LD D,$00      ; The action-record offset's high byte is zero.
 $9B8C ADD IX,DE     ; Point #REGix at the action list, that far into the
                     ; object.
; Find this id in the table at #REGix.
 $9B8E CALL $9DBD    ; Call #R$9DBD to look this id up in the table.
 $9B91 POP DE        ; Restore #REGde from the stack.
 $9B92 RET           ; Return.

; Table: Next Record
;
; Used by the routines at #R$9BA9, #R$9C41, #R$9DD9, #R$9EA0, #R$9F08 and
; #R$9F2D.
; .
; Steps to the next record in a table.
;
;   IX Pointer to the record data
; O:A The record ID
; O:IY The record data
@label=Table_StepThroughThreeByteRecords
c$9B93 EXX           ; Switch register sets before the index is stepped.
 $9B94 LD DE,$0003   ; {Move onto the next record
 $9B97 ADD IX,DE     ; #REGix=#REGix+#N($0003,$04,$04).}
 $9B99 LD D,(IX+$02) ; Read byte 2 of this record.
 $9B9C LD E,(IX+$01) ; Read byte 1 of this record.
 $9B9F PUSH DE       ; {Read byte 0 of this record.
 $9BA0 POP IY        ;
 $9BA2 LD A,(IX+$00) ; }
 $9BA5 CP $FF        ; Set flag if this is the termination character (#N$FF).
 $9BA7 EXX           ; Exchange registers.
 $9BA8 RET           ; Return.

; Table: Find The Record
;
; Used by the routines at #R$9C17, #R$9D00, #R$9D50, #R$9D97, #R$9FC7 and
; #R$A18C.
; .
; Finds the record whose id matches #REGa.
;
;   IX Pointer to 3 byte table data
; O:IX Pointer moved to the next record
; O:IY Contents of the record
@label=Table_FindTheRecord
c$9BA9 PUSH BC       ; {Save #REGbc and keep the id being sought in #REGb.
 $9BAA LD B,A        ; }
 $9BAB CALL $9B93    ; Call #R$9B93 to step to the next record.
 $9BAE LD A,B        ; {Return the record id.
 $9BAF POP BC        ;
 $9BB0 RET           ; }

; Locate Location
;
; Used by the routines at #R$71D5, #R$8E85, #R$8EEC, #R$9630, #R$965B, #R$96A8,
; #R$9C41, #R$9D37, #R$9EA0, #R$A0AE, #R$A5FB and #R$A7AA.
; .
; Finds a location record from its id.
;
;   A Location ID
; O:IX Pointer to #R$BA8A(location data)
@label=LocateLocation
c$9BB1 CP $50        ; {If the location ID is less than #N$50 jump to #R$9BB7
 $9BB3 JR C,$9BB7    ; to process it.}
 $9BB5 XOR A         ; Reset #REGa to #N$00.
 $9BB6 RET           ; Return.
; Work out the location now #REGa is validated as a legitimate location ID.
@label=LocateLocation_Action
*$9BB7 PUSH DE       ; {Point at the location table.
 $9BB8 LD DE,$B9E0   ; }
 $9BBB PUSH HL       ; {Store offset in the #REGhl register pair.
 $9BBC LD L,A        ;
 $9BBD LD H,$00      ; }
; Calculate Location address, some examples would be;
; #TABLE(default,centre,centre,centre,centre)
; { =h Location ID | =h Sum | =h Location Table Entry | =h Location Data }
; { #LET(id=$05) #N({id},$02,$03,$01,$01)($) | (#N({id},$02,$03,$01,$01)($)*#N$02) + #N($B9E0,$02,$03,$01,$01)($) | #R(#EVAL($B9E0+{id}*$02)) | #R(#EVAL(#PEEK(#EVAL($B9E0+{id}*$02)) + #EVAL(#PEEK(#EVAL($B9E1+{id}*$02))*$100))) }
; { #LET(id=$20) #N({id},$02,$03,$01,$01)($) | (#N({id},$02,$03,$01,$01)($)*#N$02) + #N($B9E0,$02,$03,$01,$01)($) | #R(#EVAL($B9E0+{id}*$02)) | #R(#EVAL(#PEEK(#EVAL($B9E0+{id}*$02)) + #EVAL(#PEEK(#EVAL($B9E1+{id}*$02))*$100))) }
; { #LET(id=$33) #N({id},$02,$03,$01,$01)($) | (#N({id},$02,$03,$01,$01)($)*#N$02) + #N($B9E0,$02,$03,$01,$01)($) | #R(#EVAL($B9E0+{id}*$02)) | #R(#EVAL(#PEEK(#EVAL($B9E0+{id}*$02)) + #EVAL(#PEEK(#EVAL($B9E1+{id}*$02))*$100))) }
; TABLE#
 $9BBF ADD HL,HL     ; {Multiply the offset by #N$02 and add the table base.
 $9BC0 ADD HL,DE     ; }
 $9BC1 LD E,(HL)     ; Read the low byte of the token.
 $9BC2 INC HL        ; Step to the next letter.
 $9BC3 LD D,(HL)     ; Read the high byte of the token.
 $9BC4 PUSH DE       ; {Copy #REGde into #REGix, restore #REGhl and #REGde.
 $9BC5 POP IX        ;
 $9BC7 POP HL        ;
 $9BC8 POP DE        ; }
 $9BC9 RET           ; Return.

; Locate Object
;
; Used by the routines at #R$71E2, #R$8C4B, #R$8D33, #R$8D9D, #R$8E85, #R$8ED2,
; #R$8EEC, #R$9213, #R$93DA, #R$94D6, #R$950F, #R$9728, #R$977C, #R$9ACD,
; #R$9B16, #R$9C8A, #R$9D50, #R$9E7A, #R$9F82, #R$A050, #R$A0C8, #R$A18C,
; #R$A541, #R$A55F and #R$AAE0.
; .
; Finds an object record from its id.
;
;   A Object ID
; O:IX The object data address from #R$C11B
;
; Locates an object from a given object ID.
@label=LocateObject
c$9BCA LD IX,$C063   ; Use the object table as this object.
 $9BCE CALL $9DBD    ; Call #R$9DBD to locate the object.
 $9BD1 PUSH HL       ; {Read the object's address from the index entry.
 $9BD2 LD L,(IX+$01) ; }
 $9BD5 LD H,(IX+$02) ; Read the high byte of the object's address.
 $9BD8 EX (SP),HL    ; Swap #REGhl with the address on the stack.
 $9BD9 POP IX        ; Restore #REGix from the stack.
 $9BDB RET           ; Return.

; Object: Move Contents
;
; Moves everything inside the object in #REGa (recursively) to the location in
; #REGb; if the player is among them, the player moves too. The byte here is
; set while the player has not been found among those contents.
@label=Object_MoveContents
c$9BDC DEFB $FF      ;
; This entry point is used by the routines at #R$8D9D, #R$939E, #R$93DA,
; #R$948D, #R$A3E6, #R$A5FB, #R$A7AA, #R$A86E and #R$A9E5.
*$9BDD LD HL,$9BDC   ; Point #REGhl at the flag that says the player was not
                     ; found.
 $9BE0 LD (HL),$01   ; Set the flag.
 $9BE2 CALL $9C17    ; Call #R$9C17 to move the contents.
 $9BE5 LD A,(HL)     ; {Return if the player was not among the contents (the
 $9BE6 AND A         ; flag at #R$9BDC is still set).
 $9BE7 RET NZ        ; }
 $9BE8 PUSH HL       ; Save #REGhl.
; Test this flag.
 $9BE9 LD A,($C12B)  ; {Jump to #R$9C13 if *#R$C12B is zero.
 $9BEC AND A         ;
 $9BED JR Z,$9C13    ; }
 $9BEF LD A,($B6EA)  ; Read *#R$B6EA.
 $9BF2 PUSH AF       ; {Read *#R$B70C.
 $9BF3 LD HL,($B70C) ; }
 $9BF6 PUSH HL       ; {Point *#R$B70C at "#TEXTTOKEN($C11B+$08,$01)".
 $9BF7 LD HL,$C11B   ;
 $9BFA LD ($B70C),HL ; }
 $9BFD XOR A         ; {Clear *#R$B6EA.
 $9BFE LD ($B6EA),A  ; }
 $9C01 LD A,B        ; {Store #REGb at #R$8D9B.
 $9C02 LD ($8D9B),A  ; }
 $9C05 CALL $8E12    ; Call #R$8E12 to move the character, unless the message
                     ; is held back.
 $9C08 CALL $9B02    ; Call #R$9B02, the empty action.
 $9C0B POP HL        ; {Update *#R$B70C.
 $9C0C LD ($B70C),HL ; }
 $9C0F POP AF        ; {Update *#R$B6EA.
 $9C10 LD ($B6EA),A  ; }
@label=Object_MoveContents_ClearAndReturn
*$9C13 POP HL        ; {Restore #REGhl from the stack and clear the byte it
 $9C14 XOR A         ; points at.
 $9C15 LD (HL),A     ; }
 $9C16 RET           ; Return.

; Object: Move Nested Contents
;
; Used by the routine at #R$9BDC.
; .
; Moves every object held by the id in #REGa to the location in #REGb, then
; does the same for what those objects hold. Meeting the player (id #N$00)
; clears the flag at #R$9BDC.
@label=Object_MoveContents_Recurse
c$9C17 PUSH IY       ; {Start the object search one slot before #R$C063.
 $9C19 PUSH IX       ;
 $9C1B LD IX,$C060   ; }
@label=Object_MoveContents_Recurse_Loop
*$9C1F CALL $9BA9    ; Call #R$9BA9 to find the record.
 $9C22 JR Z,$9C3C    ; Jump to #R$9C3C if #R$9BA9 reached the end of the index.
 $9C24 CP (IY+$01)   ; {Jump back to #R$9C1F if where this object is is not the
 $9C27 JR NZ,$9C1F   ; id in #REGa.}
 $9C29 LD (IY+$10),B ; Set this object's location to the location in #REGb.
@label=Object_MoveContents_Recurse_Player
 $9C2C PUSH AF       ; {Save the id being sought and read the id from the index
 $9C2D LD A,(IX+$00) ; entry.}
 $9C30 AND A         ; {Jump to #R$9C36 if this object's id is not zero.
 $9C31 JR NZ,$9C36   ; }
 $9C33 LD ($9BDC),A  ; Clear the flag at #R$9BDC: the player was among the
                     ; contents.
@label=Object_MoveContents_Recurse_MoveTheContents
*$9C36 CALL $9C17    ; Call #R$9C17 to move the contents.
 $9C39 POP AF        ; {Jump back to #R$9C1F to find the record.
 $9C3A JR $9C1F      ; }
@label=Object_MoveContents_Recurse_Done
*$9C3C POP IX        ; {Restore #REGix and #REGiy from the stack.
 $9C3E POP IY        ; }
 $9C40 RET           ; Return.

; Table: Find An Exit
;
; Used by the routine at #R$8E85.
; .
; Finds an exit out of the current location.
@label=TableFindAnExit
c$9C41 PUSH IX       ; {Save #REGix, #REGiy and #REGbc, and keep the location
 $9C43 PUSH IY       ; id in #REGb.
 $9C45 PUSH BC       ;
 $9C46 LD B,A        ; }
 $9C47 CALL $9BB1    ; Call #R$9BB1 to locate location.
 $9C4A LD A,(IX+$01) ; Read the location's volume.
 $9C4D LD C,A        ; Copy the result into #REGc.
 $9C4E LD IX,$C060   ; Point #REGix at the slot before the object table.
@label=TableFindAnExit_Loop
*$9C52 CALL $9B93    ; Call #R$9B93 to step to the next index entry.
 $9C55 JR Z,$9C6D    ; Jump to #R$9C6D at the end of the object index.
 $9C57 LD A,(IY+$00) ; {Jump back to #R$9C52 unless this object has one copy.
 $9C5A CP $01        ;
 $9C5C JR NZ,$9C52   ; }
; This object has one copy. Compare its location with the one being sought.
 $9C5E LD A,B        ; {Jump back to #R$9C52 if the object's location is not
 $9C5F CP (IY+$10)   ; the location being sought.
 $9C62 JR NZ,$9C52   ; }
 $9C64 LD A,C        ; {Jump to #R$9C74 if the object's volume is above the
 $9C65 SUB (IY+$02)  ; location's volume.
 $9C68 JR C,$9C74    ; }
 $9C6A LD C,A        ; Copy the result into #REGc.
 $9C6B JR $9C52      ; Jump back to #R$9C52 for the next index entry.
@label=TableFindAnExit_ReturnTheCount
*$9C6D LD A,C        ; {Return what #REGc was holding.
 $9C6E POP BC        ;
 $9C6F POP IY        ;
 $9C71 POP IX        ;
 $9C73 RET           ; }
@label=TableFindAnExit_ReturnAZeroCount
*$9C74 LD C,$00      ; Take a count of zero.
 $9C76 JR $9C6D      ; Jump back to #R$9C6D to return the count in #REGc.

; Condition: Is The Object Carried
;
; Used by the routines at #R$8C9B, #R$8D33, #R$939E, #R$950F and #R$A248.
; .
; Tests whether the object is being carried.
@label=ConditionIsTheObjectCarried
c$9C78 LD A,($B6E8)  ; Read *#R$B6E8.
; This entry point is used by the routines at #R$9076, #R$950F and #R$9728.
*$9C7B LD HL,$B6EA   ; Point #REGhl at the character whose turn it is.
; This entry point is used by the routine at #R$8CA6.
*$9C7E CP $FF        ; Compare the object id with #N$FF.
 $9C80 SCF           ; If the object matches, return with carry set: it is
                     ; carried.
 $9C81 RET Z         ; Return if no object was named.
 $9C82 PUSH IX       ; {Call #R$9C8A to see whether the object's location is
 $9C84 CALL $9C8A    ; this character.}
 $9C87 POP IX        ; Restore #REGix from the stack.
 $9C89 RET           ; Return.

; Condition: Test The Object Is Held
;
; Used by the routine at #R$9C78.
; .
; Returns with carry set when the character whose turn it is holds the object, either directly or inside
; something the character holds. Otherwise returns with carry clear.
;
; .
;
; Find the object's record.
@label=Condition_TestTheObjectIsHeld
c$9C8A CALL $9BCA    ; Call #R$9BCA to locate object.
 $9C8D PUSH AF       ; {Read where this object is from the object record.
 $9C8E LD A,(IX+$01) ; }
 $9C91 CP $FF        ; {Jump to #R$9C9C if this object is not inside another
 $9C93 JR Z,$9C9C    ; object.}
 $9C95 POP IX        ; {Jump back to #R$9C8A if where this object is is not the
 $9C97 CP (HL)       ; character whose turn it is.
 $9C98 JR NZ,$9C8A   ; }
 $9C9A SCF           ; Return with carry set: this character is carrying it.
 $9C9B RET           ; Return.
@label=Condition_TestTheObjectIsHeld_NotInside
*$9C9C POP AF        ; {See whether where this object is is zero.
 $9C9D AND A         ; }
 $9C9E RET           ; Return.

; Random Number
;
; Used by the routines at #R$8D9D, #R$8FAD, #R$9034, #R$9076, #R$97AD, #R$9A59,
; #R$A302, #R$A4D9, #R$A4FE, #R$A5FB and #R$A86E.
; .
; Returns a random number from the seed taken at the start of the
; game.
;
;   A Random seed?
; O:A Random number
@label=GetRandomNumber
c$9C9F CALL $9CA8    ; Call #R$9CA8 to scale the roll.
 $9CA2 BIT 7,A       ; {Return if bit 7 of the scaled roll is clear.
 $9CA4 RET Z         ; }
 $9CA5 NEG           ; Negate the accumulator.
 $9CA7 RET           ; Return.

; Random: Scale The Roll
;
; Used by the routines at #R$9213, #R$92ED and #R$9C9F.
; .
; Scales the random roll by the limit passed in #REGb, advances the random seed at
; #R$B712, and returns the scaled roll in #REGa.
@label=CalculateRandom
c$9CA8 PUSH IX        ; {Keep the limit passed in.
 $9CAA PUSH BC        ;
 $9CAB LD C,A         ; }
 $9CAC SLA A          ; #REGa*=#N$02.
 $9CAE JR NC,$9CB2    ; Jump to #R$9CB2 if there's no carry over.
 $9CB0 LD A,$FF       ; Else, set #REGa=#N$FF.
@label=CalculateRandom_KeepTheDoubledLimit
*$9CB2 LD B,A         ; Keep the doubled limit in #REGb.
@label=CalculateRandom_Loop
*$9CB3 LD IX,$B712    ; {Increase the LSB of the #R$B712 by one.
 $9CB7 INC (IX+$01)   ; }
 $9CBA JR NZ,$9CBF    ; Jump to #R$9CBF if the low byte of the random seed did
                      ; not roll over, skipping the high byte.
 $9CBC INC (IX+$00)   ; Increase the MSB of the #R$B712 by one.
@label=CalculateRandom_UseTheRandomCounterAsTheRecord
*$9CBF LD IX,($B712)  ; Use the random counter as the record being walked.
 $9CC3 LD A,($B70E)   ; Read the random seed.
 $9CC6 ADC A,(IX+$00) ; Add the carry onto the random seed.
 $9CC9 ADD IX,DE      ; Step on through the random counter.
 $9CCB XOR (IX+$01)   ; Fold byte 1 of this record into it.
 $9CCE PUSH HL        ; {Compare #R$B70E against #REGa.
 $9CCF LD HL,$B70E    ;
 $9CD2 CP (HL)        ; }
 $9CD3 POP HL         ; {If the result of the comparison was zero, jump back to
 $9CD4 JR Z,$9CB3     ; #R$9CB3 to try again.}
 $9CD6 LD ($B70E),A   ; Write #REGa to #R$B70E.
@label=CalculateRandom_HalveTheSeed
*$9CD9 CP B           ; {Jump to #R$9CE3 if the random seed is below the
 $9CDA JR C,$9CE3     ; doubled limit in #REGb.}
 $9CDC JR Z,$9CE3     ; Jump to #R$9CE3 if the random seed equals it.
 $9CDE SRL A          ; Halve the random seed.
 $9CE0 JP $9CD9       ; Jump back to #R$9CD9 to repeat this search.
@label=CalculateRandom_TakeTheResultOffTheRandomSeed
*$9CE3 SUB C          ; Take the result off the random seed.
 $9CE4 POP BC         ; {Restore #REGbc and #REGix from the stack.
 $9CE5 POP IX         ; }
 $9CE7 RET            ; Return.

; Condition: Total The Volume Inside
;
; Used by the routines at #R$8D9D, #R$9213 and #R$A55F.
; .
; Returns in #REGa the total volume of the objects inside object #REGa, or
; #N$FF on overflow.
@label=Condition_TotalTheVolumeInside
c$9CE8 PUSH BC       ; {Set #REGb to add volumes.
 $9CE9 LD B,$01      ; }
 $9CEB JR $9CF0      ; Jump to #R$9CF0 to add them up.

; Condition: Total The Mass Inside
;
; Used by the routines at #R$8CF1 and #R$939E.
; .
; Returns in #REGa the total mass of the objects inside object #REGa, including
; what they hold, or #N$FF on overflow.
@label=Condition_TotalTheMassInside
c$9CED PUSH BC       ; {Set #REGb to zero to add masses.
 $9CEE LD B,$00      ; }
; This entry point is used by the routine at #R$9CE8.
@label=Condition_TotalTheMassInside_StartTheTotal
*$9CF0 PUSH IX       ; {Start the total at zero.
 $9CF2 PUSH IY       ;
 $9CF4 LD C,$00      ; }
 $9CF6 CALL $9D00    ; Call #R$9D00 to add up the objects inside.
 $9CF9 LD A,C        ; Copy the total into #REGa.
 $9CFA POP IY        ; {Restore #REGiy, #REGix and #REGbc from the stack.
 $9CFC POP IX        ;
 $9CFE POP BC        ; }
 $9CFF RET           ; Return.

; Condition: Add Up The Objects Inside
;
; Used by the routine at #R$9CED.
; .
; Adds the volume or the mass of each object inside the id in #REGa. Volume covers
; those objects only; mass also adds what they hold. An overflow returns #N$FF.
@label=Condition_AddUpTheObjectsInside
c$9D00 PUSH IX        ; {Point #REGix at the object table.
 $9D02 LD IX,$C063    ; }
@label=Condition_AddUpTheObjectsInside_Loop
*$9D06 CALL $9BA9     ; Call #R$9BA9 to find the record.
 $9D09 JR Z,$9D2F     ; Jump to #R$9D2F at the end of the object index.
 $9D0B CP (IY+$01)    ; {Jump back to #R$9D06 if where this object is is not
 $9D0E JR NZ,$9D06    ; the id in #REGa.}
 $9D10 PUSH AF        ; {Jump to #R$9D1F if #REGb is zero (add masses instead
 $9D11 SUB A          ; of volumes).
 $9D12 CP B           ;
 $9D13 LD A,C         ;
 $9D14 JR Z,$9D1F     ; }
 $9D16 ADD A,(IY+$02) ; Add the object's volume onto the total.
 $9D19 JP PE,$9D32    ; Jump to #R$9D32 if the total overflowed.
 $9D1C LD C,A         ; Copy the result into #REGc.
 $9D1D JR $9D2C       ; Jump to #R$9D2C to find the next record.
@label=Condition_AddUpTheObjectsInside_AddTheMass
*$9D1F ADD A,(IY+$03) ; Add the object's mass onto the total.
 $9D22 JP PE,$9D32    ; Jump to #R$9D32 if the total overflowed.
 $9D25 LD C,A         ; Copy the result into #REGc.
 $9D26 LD A,(IX+$00)  ; Read the id from the index entry.
 $9D29 CALL $9D00     ; Call #R$9D00 to add the mass of what this object holds.
@label=Condition_AddUpTheObjectsInside_FindTheRecord
*$9D2C POP AF         ; {Jump back to #R$9D06 to find the record.
 $9D2D JR $9D06       ; }
@label=Condition_AddUpTheObjectsInside_RestoreAndReturn
*$9D2F POP IX         ; Restore #REGix from the stack.
 $9D31 RET            ; Return.
@label=Condition_AddUpTheObjectsInside_MarkTheTotalAsFull
*$9D32 POP AF         ; {Pop the saved id and mark the total as full (#N$FF).
 $9D33 LD C,$FF       ; }
 $9D35 JR $9D2F       ; Jump back to #R$9D2F to return.

; Get Object Location In IX
;
; Used by the routines at #R$95ED and #R$9E95.
; .
; Points #REGix at the location of the object.
;
; O:IX The object location
@label=GetObjectLocationInIX
c$9D37 PUSH AF       ; {Fetch the location ID for the object held by #R$B70C.
 $9D38 LD IX,($B70C) ;
 $9D3C LD A,(IX+$10) ; }
 $9D3F CALL $9BB1    ; Call #R$9BB1 to locate location.
 $9D42 POP AF        ; Restore #REGaf from the stack.
 $9D43 RET           ; Return.

; Condition: Suppress The Message
;
; Used by the routines at #R$8C4B, #R$8CA6, #R$8D33, #R$8D9D, #R$8EEC, #R$8F3B,
; #R$9034, #R$9076, #R$90EB, #R$910E, #R$9138, #R$9171, #R$9213, #R$92B5,
; #R$92ED, #R$939E, #R$93DA, #R$946D, #R$948D, #R$A244, #R$A248, #R$A2B4,
; #R$A302, #R$A3BC, #R$A3E6, #R$A4D9, #R$A4F5, #R$A4FE, #R$A541, #R$A55F,
; #R$A5CA, #R$A5FB, #R$A7AA, #R$A86E, #R$A971, #R$A9BD and #R$A9E5.
; .
; Suppresses a message when this character should stay quiet.
@label=ConditionSuppressTheMessage
c$9D44 LD A,($B6FA)  ; {If #R$B6FA is #N$01 then return.
 $9D47 CP $01        ;
 $9D49 RET Z         ; }
 $9D4A INC A         ; A message is being held back, so the flag becomes
                     ; non-zero.
 $9D4B LD ($B6FB),A  ; Store that in the message-suppressed flag and return
                     ; past the caller.
 $9D4E POP BC        ; Restore #REGbc from the stack.
 $9D4F RET           ; Return.

; Condition: Where The Object Is
;
; Used by the routines at #R$92ED and #R$93DA.
; .
; Works out where the object is. A fluid that is no longer contained evaporates, and
; "evaporate(s|d|ing|es)" is printed.
@label=Condition_WhereTheObjectIs
c$9D50 LD A,($B6E8)    ; Read the current object.
; This entry point is used by the routines at #R$977C, #R$A5FB and #R$A971.
*$9D53 PUSH IY         ; {Call #R$9BCA to locate the object.
 $9D55 PUSH IX         ;
 $9D57 PUSH HL         ;
 $9D58 CALL $9BCA      ; }
 $9D5B LD B,(IX+$01)   ; Read where this object is.
 $9D5E LD IX,$C060     ; Point #REGix at the slot before the object table.
@label=Condition_WhereTheObjectIs_Loop
*$9D62 CALL $9BA9      ; Call #R$9BA9 to find the record.
 $9D65 JR Z,$9D91      ; Jump to #R$9D91 if #R$9BA9 reached the end of the
                       ; index.
 $9D67 CP (IY+$01)     ; {Jump back to #R$9D62 if where this object is is not
 $9D6A JR NZ,$9D62     ; the id in #REGa.}
 $9D6C BIT 1,(IY+$07)  ; {Jump to #R$9D8B if the object is not a fluid.
 $9D70 JR Z,$9D8B      ; }
 $9D72 PUSH AF         ; {Clear the object's location.
 $9D73 LD (IY+$10),$00 ; }
 $9D77 LD (IY+$01),$FF ; Mark where this object is as unset.
 $9D7B RES 7,(IY+$07)  ; Mark the object not visible.
 $9D7F CALL $9EC7      ; Call #R$9EC7 to print the object's name.
 $9D82 LD HL,$B143     ; Point at the message "evaporate(s|d|ing|es)[0x15]"
                       ; (#R$B142).
 $9D85 CALL $72DD      ; Call #R$72DD to print message.
 $9D88 POP AF          ; {Jump back to #R$9D62 to find the record.
 $9D89 JR $9D62        ; }
@label=Condition_WhereTheObjectIs_UpdateWhereThisObject
*$9D8B LD (IY+$01),B   ; Update where this object is.
 $9D8E JP $9D62        ; Jump back to #R$9D62 to find the record.
@label=Condition_WhereTheObjectIs_RestoreAndReturn
*$9D91 POP HL          ; {Restore #REGhl, #REGix and #REGiy from the stack.
 $9D92 POP IX          ;
 $9D94 POP IY          ; }
 $9D96 RET             ; Return.

; Condition: Count The Visible Objects
;
; Used by the routines at #R$90EB, #R$910E, #R$93DA, #R$A050 and #R$A248.
; .
; Counts the visible objects at the location or container in #REGa. A character
; id counts what that character holds. An object is visible when bit 7 of its
; attribute byte is set.
;
; I:A Location or container id (the character id counts objects held)
; O:A The number of objects
@label=ObjectCount
c$9D97 PUSH IX        ; {Initialise the object count.
 $9D99 PUSH IY        ;
 $9D9B PUSH BC        ;
 $9D9C LD B,$00       ; }
 $9D9E LD IX,$C060    ; Use the slot before the object table as this object.
@label=ObjectCount_Loop
*$9DA2 CALL $9BA9     ; Call #R$9BA9 to fetch the next record in #REGiy.
 $9DA5 JR Z,$9DB6     ; Jump to #R$9DB6 at the end of the object index.
 $9DA7 CP (IY+$01)    ; {Jump back to #R$9DA2 without counting this object if
 $9DAA JR NZ,$9DA2    ; its location is not the id in #REGa.}
 $9DAC BIT 7,(IY+$07) ; {Jump back to #R$9DA2 without counting this object if
 $9DB0 JR Z,$9DA2     ; it is not visible.}
 $9DB2 INC B          ; Count one more object.
 $9DB3 JP $9DA2       ; Jump back to #R$9DA2 to find the record.
@label=ObjectCount_End
*$9DB6 LD A,B         ; Store the object count in #REGa.
 $9DB7 POP BC         ; {Restore #REGbc, #REGiy and #REGix from the stack.
 $9DB8 POP IY         ;
 $9DBA POP IX         ; }
 $9DBC RET            ; Return.

; Index ID Table
;
; Used by the routines at #R$6C00, #R$7F78, #R$83A0, #R$8D9D, #R$94D6, #R$950F,
; #R$9AA0, #R$9B81, #R$9BCA and #R$A971.
; .
; Looks an id up in a table of id-and-address pairs.
;
;   A Key ID
;   IX Address of table data
; O:IX The address in the table which matches the key ID
;
; Searches through what is essentially key value data to find a key match.
@label=IndexIdTable
c$9DBD EXX           ; Exchange registers.
 $9DBE PUSH IX       ; {Point #REGhl at the table in #REGix and keep the sought
 $9DC0 POP HL        ; id in #REGb.
 $9DC1 LD B,A        ; }
 $9DC2 LD E,$03      ; Each index entry is #N$03 bytes.
 $9DC4 LD D,$00      ; The index stride's high byte is zero.
; Begin searching the table.
@label=IndexIdTable_Loop
*$9DC6 LD A,(HL)     ; Grab the next ID.
 $9DC7 CP B          ; {Jump to #R$9DD2 if this entry's id is the one sought.
 $9DC8 JR Z,$9DD2    ; }
 $9DCA CP $FF        ; {Jump to #R$9DD2 at the end of the index.
 $9DCC JR Z,$9DD2    ; }
 $9DCE ADD HL,DE     ; Step #N$03 bytes to the next id.
 $9DCF JP $9DC6      ; Jump back to #R$9DC6 to begin searching the table.
; Handle the output.
@label=IndexIdTable_Found
*$9DD2 PUSH HL       ; {Set flags (checking if the key ID was not found).
 $9DD3 POP IX        ;
 $9DD5 CP $FF        ; }
 $9DD7 EXX           ; Exchange registers.
 $9DD8 RET           ; Return.

; Condition: Same Place As The Player
;
; Used by the routines at #R$7A73 and #R$7D74.
; .
; Tests whether an object is in the same place as the player.
@label=ConditionSamePlaceAsThePlayer
c$9DD9 PUSH BC       ; {Read *#R$B70C.
 $9DDA PUSH DE       ;
 $9DDB PUSH IY       ;
 $9DDD LD IY,($B70C) ; }
 $9DE1 LD D,(IY+$10) ; Read the location from #REGiy.
 $9DE4 LD A,($B710)  ; Read *#R$B710.
 $9DE7 LD E,A        ; Keep the kind filter (#N$00 not a live animal, #N$01 a
                     ; live animal, #N$02 anything).
@label=ConditionSamePlaceAsThePlayer_Loop
*$9DE8 CALL $9B93    ; Call #R$9B93 to step to the next index entry.
 $9DEB JR Z,$9E1D    ; Jump to #R$9E1D at the end of the index.
 $9DED LD A,$02      ; {Jump to #R$9E01 if the kind filter is #N$02 (any
 $9DEF CP E          ; object).
 $9DF0 JR Z,$9E01    ; }
 $9DF2 LD A,(IY+$07) ; Read the attribute flags from #REGiy.
 $9DF5 AND $48       ; Keep bits 3, 6.
 $9DF7 CP $40        ; {Take zero unless the object is an animal that is not
 $9DF9 LD A,$00      ; broken.
 $9DFB JR NZ,$9DFE   ; }
 $9DFD INC A         ; Count on from zero.
@label=ConditionSamePlaceAsThePlayer_TestTheKind
*$9DFE CP E          ; {Jump back to #R$9DE8 unless this object's kind (#N$01
 $9DFF JR NZ,$9DE8   ; for a live animal, else #N$00) matches the filter.}
@label=ConditionSamePlaceAsThePlayer_PointAtTheName
*$9E01 LD BC,$0008   ; Start at the object's name, #N$08 bytes into the record.
 $9E04 PUSH IY       ; {Add #N($0008,$04,$04) onto the current object record.
 $9E06 ADD IY,BC     ; }
 $9E08 CALL $71F3    ; Call #R$71F3 to match clause pairs.
 $9E0B POP IY        ; {Jump back to #R$9DE8 if #R$71F3 did not match the name.
 $9E0D JR NZ,$9DE8   ; }
; Test this flag.
 $9E0F LD A,($B70F)  ; {Jump to #R$9E1D if *#R$B70F is not zero.
 $9E12 AND A         ;
 $9E13 JR NZ,$9E1D   ; }
 $9E15 LD A,(IX+$00) ; Read the id from the index entry.
 $9E18 CALL $9E34    ; Call #R$9E34 to test whether the object is here.
 $9E1B JR Z,$9DE8    ; Jump back to #R$9DE8 if #R$9E34 did not find the object
                     ; here.
@label=ConditionSamePlaceAsThePlayer_ReturnTheId
*$9E1D LD A,(IX+$00) ; Read the id from the index entry.
 $9E20 POP IY        ; {Restore #REGiy, #REGde and #REGbc from the stack.
 $9E22 POP DE        ;
 $9E23 POP BC        ; }
 $9E24 RET           ; Return.

; Condition: Swap And Retest
;
; Used by the routines at #R$97FF and #R$A5FB.
; .
; Swaps the two object pointers and tests again whether the object is visible.
@label=Condition_SwapAndRetest
c$9E25 CALL $9E2B    ; Call #R$9E2B to swap the two object pointers.
 $9E28 CALL $9E40    ; Call #R$9E40 to test a visible object.
*$9E2B PUSH IX       ; {Swap #REGix with #REGiy.
 $9E2D PUSH IY       ;
 $9E2F POP IX        ;
 $9E31 POP IY        ; }
 $9E33 RET           ; Return.

; Condition: The Object Is Here
;
; Used by the routines at #R$95ED, #R$9DD9, #R$9FC7 and #R$A55F.
; .
; Tests whether the object is in the current location.
@label=ConditionTheObjectIsHere
c$9E34 PUSH IX       ; {Save #REGix and use the record of the character whose
 $9E36 LD IX,($B70C) ; turn it is.}
 $9E3A CALL $9E40    ; Call #R$9E40 to test a visible object.
 $9E3D POP IX        ; Restore #REGix from the stack.
 $9E3F RET           ; Return.

; Condition: A Visible Object
;
; Used by the routines at #R$9E25 and #R$9E34.
; .
; Returns whether the object is visible and in the location just tested.
@label=Condition_AVisibleObject
c$9E40 BIT 7,(IY+$07) ; {Return if the object is not "visible".
 $9E44 RET Z          ; }
 $9E45 PUSH IY        ; {Save #REGiy, #REGix and #REGbc, and keep #REGa in
 $9E47 PUSH IX        ; #REGb.
 $9E49 PUSH BC        ;
 $9E4A LD B,A         ; }
 $9E4B LD C,(IX+$10)  ; Read the object's location.
 $9E4E PUSH IY        ; {Call #R$9E7A to test whether the container is lit.
 $9E50 CALL $9E7A     ; }
 $9E53 CP B           ; Compare it with the result.
 $9E54 LD B,A         ; Keep the result in #REGb.
 $9E55 POP IX         ; {Jump to #R$9E72 if #R$9E7A's result matches the flag
 $9E57 JR Z,$9E72     ; kept in #REGb.}
 $9E59 CALL $9E7A     ; Call #R$9E7A to test whether the container is lit.
 $9E5C CP B           ; Compare it with the result.
 $9E5D JR NZ,$9E6F    ; Jump to #R$9E6F unless it matches #REGb.
 $9E5F INC A          ; {Jump to #R$9E72 unless the compared byte was #N$FF.
 $9E60 JR NZ,$9E72    ; }
 $9E62 LD B,(IY+$00)  ; Load the copy count into #REGb.
 $9E65 LD A,C         ; Use the object's location again.
@label=Condition_AVisibleObject_Loop
*$9E66 CP (IY+$10)    ; {Jump to #R$9E72 if this copy's location matches.
 $9E69 JR Z,$9E72     ; }
 $9E6B INC IY         ; Step to the next byte of this object.
 $9E6D DJNZ $9E66     ; Loop back to #R$9E66 until every copy's location has
                      ; been checked.
@label=Condition_AVisibleObject_ReturnNotVisible
*$9E6F XOR A          ; Set the zero flag.
 $9E70 JR $9E74       ; Jump to #R$9E74 to return with the zero flag set.
@label=Condition_AVisibleObject_ReturnVisible
*$9E72 OR $01         ; Clear the zero flag.
@label=Condition_AVisibleObject_Return
*$9E74 POP BC         ; {Restore #REGbc, #REGix and #REGiy from the stack.
 $9E75 POP IX         ;
 $9E77 POP IY         ; }
 $9E79 RET            ; Return.

; Condition: Is The Container Lit?
;
; Used by the routines at #R$95ED and #R$9E40.
; .
; Tests whether the container the object is inside is lit.
;
;   IX Object Data Address e.g. #R$C11B
; O:A Either #N$FF if this object is not inside a container, or the object ID
; .   of the container object
; O:IX Object Data Address of either the input value, or the address of the
; .    container object
@label=ContainerLit
c$9E7A PUSH IX       ; {If the object is not inside of anything then jump to
@label=ContainerLit_Fetch
*$9E7C LD A,(IX+$01) ; #R$9E92.
 $9E7F CP $FF        ;
 $9E81 JR Z,$9E92    ; }
 $9E83 EX AF,AF'     ; Switch to the shadow register for #REGaf.
 $9E84 LD A,(IX+$01) ; Read where this object is.
 $9E87 CALL $9BCA    ; Call #R$9BCA to locate object.
 $9E8A LD A,(IX+$07) ; Fetch the objects attributes.
 $9E8D AND %00101000 ; {Jump back to #R$9E7C if the container is open or
 $9E8F JR NZ,$9E7C   ; broken.}
 $9E91 EX AF,AF'     ; Switch back to the "normal" #REGaf register.
@label=ContainerLit_Return
*$9E92 POP IX        ; Restore #REGix from the stack.
 $9E94 RET           ; Return.

; Exits: Point At The Exit List
;
; Used by the routines at #R$7AA1, #R$7ABA, #R$7D74, #R$9F08 and #R$9F2D.
; .
; Points #REGix at the exit list (record + #N$07) of the location holding the
; object at #R$B70C.
@label=ExitsPointAtTheExitList
c$9E95 PUSH DE       ; {Call #R$9D37 to point #REGix at the location of the
 $9E96 CALL $9D37    ; object at #R$B70C.}
 $9E99 LD DE,$0007   ; {Add #N($0007,$04,$04) to the object location.
 $9E9C ADD IX,DE     ; }
 $9E9E POP DE        ; Restore #REGde from the stack.
 $9E9F RET           ; Return.

; Exits: Find The Exit To A Named Place
;
; Used by the routine at #R$7D74.
; .
; Walks the current location's exits, finds each destination and matches its
; name against the clause.
@label=ExitsFindTheExitToANamedPlace
c$9EA0 PUSH IY       ; {Set #REGde to #N($0002,$04,$04), the offset of a
 $9EA2 PUSH DE       ; location's name.
 $9EA3 LD DE,$0002   ; }
@label=ExitsFindTheExitToANamedPlace_Loop
*$9EA6 CALL $9B93    ; Call #R$9B93 to step to the next exit.
 $9EA9 JR Z,$9EC3    ; Jump to #R$9EC3 at the end of the exit list.
 $9EAB LD A,(IX+$02) ; Read this exit's destination.
 $9EAE PUSH IX       ; Call #R$9BB1 to find this location's record.
; Find the location's record.
 $9EB0 CALL $9BB1    ;
 $9EB3 PUSH IX       ; {Point #REGiy at this location's name.
 $9EB5 POP IY        ;
 $9EB7 POP IX        ;
 $9EB9 ADD IY,DE     ; }
 $9EBB CALL $71F3    ; Call #R$71F3 to match clause pairs.
 $9EBE JR NZ,$9EA6   ; Jump back to #R$9EA6 to try the next exit unless the
                     ; name matched.
 $9EC0 LD A,(IX+$02) ; Read the destination's location id to return it.
@label=ExitsFindTheExitToANamedPlace_RestoreAndReturn
*$9EC3 POP DE        ; {Restore #REGde and #REGiy from the stack.
 $9EC4 POP IY        ; }
 $9EC6 RET           ; Return.

; Message: Name An Object
;
; Used by the routines at #R$93DA, #R$9D50 and #R$9FC7.
; .
; Prints the name of an object.
@label=MessageNameAnObject
c$9EC7 PUSH IY       ; {Step the pointer on by #N$08 bytes.
 $9EC9 PUSH DE       ;
 $9ECA LD DE,$0008   ;
 $9ECD ADD IY,DE     ; }
 $9ECF CALL $9ED6    ; Call #R$9ED6 to choose which noun byte to print.
 $9ED2 POP DE        ; {Restore #REGde and #REGiy from the stack.
 $9ED3 POP IY        ; }
 $9ED5 RET           ; Return.

; Message: Choose The Noun Byte
;
; Used by the routines at #R$7434, #R$9686 and #R$9EC7.
; .
; Chooses which noun byte to print. A set #R$B703 prints the class token; otherwise the
; object's name tokens are printed.
@label=Message_ChooseTheNounByte
c$9ED6 PUSH AF       ; {If #R$B703 is not zero then jump to #R$9EFA.
 $9ED7 PUSH DE       ;
 $9ED8 LD A,($B703)  ;
 $9EDB CP $00        ;
 $9EDD JR NZ,$9EFA   ; }
 $9EDF LD D,(IY+$01) ; Read the high byte of the first name word.
 $9EE2 LD E,(IY+$00) ; Read the low byte of the first name word.
 $9EE5 CALL $743F    ; Call #R$743F to turn the class token into a word.
 $9EE8 LD E,(IY+$02) ; Read the low byte of the second name word.
 $9EEB LD D,(IY+$03) ; Read the high byte of the second name word.
 $9EEE CALL $74C1    ; Call #R$74C1 to print a dictionary token.
 $9EF1 LD E,(IY+$04) ; Read the low byte of the third name word.
 $9EF4 LD D,(IY+$05) ; Read the high byte of the third name word.
 $9EF7 CALL $74C1    ; Call #R$74C1 to print a dictionary token.
@label=Message_ChooseTheNounByte_PrintTheFirstWord
*$9EFA LD E,(IY+$00) ; Read the low byte of the first name word.
 $9EFD LD D,(IY+$01) ; Read the high byte of the first name word.
 $9F00 LD A,D        ; {If #REGde is not zero call #R$7478.
 $9F01 OR E          ;
 $9F02 CALL NZ,$7478 ; }
 $9F05 POP DE        ; {Restore #REGde and #REGaf from the stack.
 $9F06 POP AF        ; }
 $9F07 RET           ; Return.

; Table: Find An Exit In A Direction
;
; Used by the routines at #R$8D9D and #R$8FAD.
; .
; Finds the exit that leaves in a given direction.
@label=TableFindAnExitInADirection
c$9F08 PUSH BC       ; {Keep the direction.
 $9F09 PUSH IY       ;
 $9F0B LD B,A        ; }
 $9F0C CALL $9E95    ; Call #R$9E95 to point #REGix at the exit list.
@label=TableFindAnExitInADirection_Loop
*$9F0F CALL $9B93    ; Call #R$9B93 to step to the next exit.
 $9F12 JR Z,$9F21    ; Jump to #R$9F21 at the end of the exit list.
 $9F14 LD A,(IX+$02) ; Read this exit's destination.
 $9F17 AND A         ; {Jump back to #R$9F0F if byte 2 of this record is zero.
 $9F18 JR Z,$9F0F    ; }
 $9F1A LD A,(IX+$00) ; Read this exit's direction.
 $9F1D CP B          ; {Jump back to #R$9F0F unless this exit's direction is
 $9F1E JP NZ,$9F0F   ; the one in #REGb.}
@label=TableFindAnExitInADirection_RestoreAndReturn
*$9F21 POP IY        ; {Restore #REGiy and #REGbc from the stack.
 $9F23 POP BC        ; }
 $9F24 RET           ; Return.

; Exits: Find The Exit Through An Object
;
; Used by the routines at #R$8EEC, #R$8F3B, #R$A2B4 and #R$A5FB.
; .
; Searches the exit list for an exit whose via byte (offset #N$01) matches the
; object id in #REGa (#R$9F28 entry point). Returns with #REGix at the exit, or
; with #REGa=#N$FF and the zero flag set at the end of the list.
@label=ExitsFindTheExitThroughAnObject
c$9F25 LD A,($B6E8)  ; Read *#R$B6E8.
; This entry point is used by the routines at #R$948D and #R$A7AA.
*$9F28 PUSH AF       ; {Search on the via byte (offset #N$01).
 $9F29 LD A,$01      ; }
 $9F2B JR $9F30      ; Jump to #R$9F30 to search on that offset.

; Exits: Find The Exit To A Location
;
; Used by the routines at #R$8FCD, #R$8FD6 and #R$A9E5.
; .
; As #R$9F25, but matches the destination byte (offset #N$02).
@label=ExitsFindTheExitToALocation
c$9F2D PUSH AF       ; {Search on the destination byte (offset #N$02).
 $9F2E LD A,$02      ; }
; This entry point is used by the routine at #R$9F25.
@label=ExitsFindTheExitToALocation_PatchTheOffset
*$9F30 LD ($9F42),A  ; Patch the offset of the LD A,(IX+n) at #R$9F40.
 $9F33 POP AF        ; {Restore #REGa from the stack, save #REGbc and #REGiy,
 $9F34 PUSH BC       ; and keep the id being sought in #REGb.
 $9F35 PUSH IY       ;
 $9F37 LD B,A        ; }
 $9F38 CALL $9E95    ; Call #R$9E95 to point #REGix at the exit list.
@label=ExitsFindTheExitToALocation_Loop
*$9F3B CALL $9B93    ; Call #R$9B93 to step to the next exit.
 $9F3E JR Z,$9F46    ; Jump to #R$9F46 at the end of the exit list.
 $9F40 LD A,(IX+$02) ; Read the patched byte of this exit.
 $9F43 CP B          ; {Jump back to #R$9F3B unless it matches the id in #REGb.
 $9F44 JR NZ,$9F3B   ; }
@label=ExitsFindTheExitToALocation_RestoreAndReturn
*$9F46 POP IY        ; {Restore #REGiy and #REGbc from the stack.
 $9F48 POP BC        ; }
 $9F49 RET           ; Return.

; Action: Hand An Object Over
;
; Used by the routines at #R$8F3B, #R$8FF5 and #R$A248.
; .
; Moves an object from one character to another.
@label=ActionHandAnObjectOver
c$9F4A LD DE,($B708) ; Read the current object's record pointer.
 $9F4E LD IY,($B70A) ; Read the second object's record pointer.
 $9F52 LD ($B708),IY ; Store the second object's record as the current one.
 $9F56 LD ($B70A),DE ; Store the saved record as the second object's.
 $9F5A LD BC,($B6E8) ; Read *#R$B6E8.
 $9F5E LD A,B        ; Take the second object.
 $9F5F LD ($B6E8),A  ; Update *#R$B6E8.
 $9F62 LD A,C        ; Take the current object.
 $9F63 LD ($B6E9),A  ; Update *#R$B6E9.
 $9F66 CALL $9B6C    ; Call #R$9B6C to call the handler stored for this action.
 $9F69 LD ($B6E8),BC ; Update *#R$B6E8.
 $9F6D LD ($B708),DE ; Update *#R$B708.
 $9F71 LD ($B70A),IY ; Update *#R$B70A.
 $9F75 RET           ; Return.

; Response: That Will Not Work
;
; Used by the routines at #R$8D25, #R$8D33, #R$8D9D, #R$8EEC, #R$8F3B, #R$92ED,
; #R$948D, #R$A248, #R$A302, #R$A3E6, #R$A4C0, #R$A4FE, #R$A541, #R$A55F,
; #R$A5FB, #R$A7AA, #R$A86E and #R$A9E5.
; .
; Prints that the command will not work.
@label=ResponseThatWillNotWork
c$9F76 LD A,($B6FA)  ; Read the message gate.
 $9F79 DEC A         ; Step the message gate down by one.
 $9F7A JP Z,$712B    ; Jump to #R$712B if #REGa is now zero.
 $9F7D SUB A         ; {Clear the message-suppressed flag.
 $9F7E LD ($B6FB),A  ; }
 $9F81 RET           ; Return.

; Get Object First Location
;
; Used by the routines at #R$97FF, #R$99C6, #R$9ACD and #R$9B02.
; .
; Reads the first location an object appears in.
;
;   A Object ID
; O:A #N$FF if the object does not appear exactly once, otherwise the location
; .   where it first appears.
@label=ObjectFirstLocation
c$9F82 CP $FF        ; {Return if this is the terminator character (#N$FF).
 $9F84 RET Z         ; }
 $9F85 CALL $9BCA    ; Call #R$9BCA to set #REGix to the object data address.
 $9F88 LD A,$01      ; {Does the object appear in the game once?
 $9F8A CP (IX+$00)   ; }
 $9F8D LD A,$FF      ; The not-found id is #N$FF.
 $9F8F RET NZ        ; Return if not.
 $9F90 LD A,(IX+$10) ; Read the object's location.
 $9F93 RET           ; Return.

; Turn: Describe What Is Here
;
; Used by the routine at #R$965B.
; .
; Describes the place and what is in it.
@label=TurnDescribeWhatIsHere
c$9F94 PUSH IY       ; {Point at the message "You see :[0x14]".
 $9F96 PUSH AF       ;
 $9F97 PUSH BC       ;
 $9F98 LD HL,$B003   ; }
 $9F9B CALL $72DD    ; Call #R$72DD to print message.
 $9F9E LD A,$FF      ; Use #N$FF as the end marker while describing what is
                     ; here.
 $9FA0 LD IY,($B70C) ; Read the record of the character whose turn it is.
 $9FA4 LD B,(IY+$10) ; Read this character's location.
 $9FA7 CALL $9FAF    ; Call #R$9FAF to list the objects here.
 $9FAA POP BC        ; {Restore #REGbc, #REGaf and #REGiy from the stack.
 $9FAB POP AF        ;
 $9FAC POP IY        ; }
 $9FAE RET           ; Return.

; Message: List With A Separator
;
; Used by the routines at #R$8C4B, #R$90EB, #R$910E and #R$9F94.
; .
; Lists the objects with a separator. When the count is zero the player sees
; "nothing".
@label=Message_ListWithASeparator
c$9FAF PUSH IY       ; {Start the separator count at zero.
 $9FB1 PUSH DE       ;
 $9FB2 PUSH BC       ;
 $9FB3 LD C,$00      ; }
 $9FB5 LD D,$04      ; Four bytes of the separator list are considered.
 $9FB7 CALL $9FC7    ; Call #R$9FC7 to walk the objects here with the saved
                     ; separator.
 $9FBA SUB A         ; See whether the separator count in #REGc is zero.
 $9FBB CP C          ; Compare the separator count with zero.
 $9FBC LD HL,$B33B   ; Point at the message " {6} nothing" (#R$B33B).
 $9FBF CALL Z,$72DD  ; Print " nothing" if no objects were listed.
 $9FC2 POP BC        ; {Restore #REGbc, #REGde and #REGiy from the stack.
 $9FC3 POP DE        ;
 $9FC4 POP IY        ; }
 $9FC6 RET           ; Return.

; Message: Remember The Separator
;
; Used by the routine at #R$9FAF.
; .
; Remembers the separator at #R$869F and walks the objects here, skipping any with no
; copies left.
@label=Message_RememberTheSeparator
c$9FC7 PUSH HL       ; {Save #REGhl and keep the id in #REGl.
 $9FC8 LD L,A        ; }
 $9FC9 LD A,($869F)  ; Read the space count.
 $9FCC LD H,A        ; Keep the space count.
 $9FCD LD A,D        ; {Store #REGd in the space count.
 $9FCE LD ($869F),A  ; }
 $9FD1 LD A,L        ; Take the id back into #REGa.
 $9FD2 EX (SP),HL    ; Swap the id and the saved separator with #REGhl on the
                     ; stack.
 $9FD3 PUSH IX       ; {Point #REGix at the slot before the object table.
 $9FD5 LD IX,$C060   ; }
@label=Message_RememberTheSeparator_Loop
*$9FD9 CALL $9BA9    ; Call #R$9BA9 to find the record.
 $9FDC JR Z,$A046    ; Jump to #R$A046 when the object search returns with the
                     ; zero flag set.
 $9FDE CP (IY+$01)   ; {Jump back to #R$9FD9 unless this object is inside the
 $9FE1 JR NZ,$9FD9   ; one in #REGa.}
 $9FE3 PUSH AF       ; {Save #REGa, then increment it (the zero flag is set if
 $9FE4 INC A         ; it was #N$FF).}
 $9FE5 LD E,(IY+$00) ; Read the copy count from the object record.
 $9FE8 JR NZ,$9FEF   ; Jump to #R$9FEF unless #REGa was #N$FF.
 $9FEA LD A,$01      ; {Jump to #R$A03D unless this object has one copy.
 $9FEC CP E          ;
 $9FED JR NZ,$A03D   ; }
@label=Message_RememberTheSeparator_TestTheLocation
*$9FEF LD A,(IY+$10) ; Read the location from #REGiy.
 $9FF2 CP B          ; {Jump to #R$9FFE if the object is at the location in
 $9FF3 JR Z,$9FFE    ; #REGb.}
 $9FF5 DEC E         ; {Jump to #R$A03D if the copy count has run out.
 $9FF6 JR Z,$A03D    ; }
 $9FF8 LD A,(IY+$11) ; Read byte +#N$11 from #REGiy.
 $9FFB CP B          ; {Jump to #R$A03D if byte #N$11 of this record is not the
 $9FFC JR NZ,$A03D   ; object's location.}
@label=Message_RememberTheSeparator_TestWhoseTurn
*$9FFE LD A,($B6EA)  ; Read *#R$B6EA.
 $A001 CP (IX+$00)   ; {Jump to #R$A00B if the character whose turn it is is
 $A004 JR NZ,$A00B   ; not this object's id.}
 $A006 LD A,$04      ; {Jump to #R$A03D if the separator in #REGd is #N$04.
 $A008 CP D          ;
 $A009 JR Z,$A03D    ; }
@label=Message_RememberTheSeparator_TestTheObjectHere
*$A00B LD A,(IX+$00) ; Read the id from the index entry.
 $A00E CALL $9E34    ; Call #R$9E34 to test whether the object is here.
 $A011 JR Z,$A03D    ; Jump to #R$A03D if #R$9E34 did not find the object here.
 $A013 INC C         ; Count one more object.
 $A014 SUB A         ; Take zero for the two flags below.
 $A015 LD ($B704),A  ; Clear the capitalise-the-next-letter flag before the
                     ; object's name.
 $A018 LD ($B703),A  ; Update *#R$B703.
 $A01B CALL $9EC7    ; Call #R$9EC7 to print the object's name.
 $A01E LD A,($B6EA)  ; Read *#R$B6EA.
 $A021 CP (IX+$00)   ; {Jump to #R$A041 if the character whose turn it is is
 $A024 JR Z,$A041    ; this object's id.}
 $A026 LD A,$2E      ; Use the character '.'.
 $A028 CALL $858B    ; Call #R$858B to print one character.
 $A02B LD A,(IX+$00) ; Read the id from the index entry.
 $A02E CALL $A050    ; Call #R$A050 to list what is here.
 $A031 JR C,$A03D    ; Jump to #R$A03D if #R$A050 returned with carry set.
 $A033 LD A,(IX+$00) ; Read the id from the index entry.
 $A036 PUSH DE       ; {Save #REGde and step the separator on.
 $A037 INC D         ; }
 $A038 INC D         ; Step the separator on once more.
 $A039 CALL $9FC7    ; {Call #R$9FC7 to remember the separator and walk the
 $A03C POP DE        ; objects, then restore #REGde.}
@label=Message_RememberTheSeparator_FindTheRecord
*$A03D POP AF        ; {Jump back to #R$9FD9 to find the record.
 $A03E JP $9FD9      ; }
@label=Message_RememberTheSeparator_PrintANewline
*$A041 CALL $8583    ; Call #R$8583 to print a newline.
 $A044 JR $A03D      ; Jump back to #R$A03D to find the record.
@label=Message_RememberTheSeparator_RestoreTheSeparator
*$A046 POP IX        ; {Restore #REGix from the stack and swap #REGhl with the
 $A048 EX (SP),HL    ; address on the stack.}
 $A049 LD A,H        ; {Put the saved separator back at #R$869F.
 $A04A LD ($869F),A  ; }
 $A04D LD A,L        ; Take the id back into #REGa.
 $A04E POP HL        ; Restore #REGhl from the stack.
 $A04F RET           ; Return.

; Table: List What Is Here
;
; Used by the routines at #R$910E and #R$9FC7.
; .
; Lists the objects in the current place.
@label=TableListWhatIsHere
c$A050 PUSH IX        ; {Keep the object id.
 $A052 PUSH BC        ;
 $A053 PUSH DE        ;
 $A054 LD C,A         ; }
; Find the object's record.
 $A055 CALL $9BCA     ; Call #R$9BCA to locate object.
 $A058 LD A,(IX+$07)  ; Read the attribute flags from the object record.
 $A05B AND $28        ; Keep bits 3, 5.
 $A05D JR Z,$A097     ; Jump to #R$A097 when the object is neither broken nor
                      ; open.
 $A05F LD A,C         ; Use the result again.
; Count the visible objects.
 $A060 CALL $9D97     ; Call #R$9D97 to count the visible objects.
 $A063 CP $00         ; Compare it with zero.
 $A065 JR Z,$A097     ; Jump to #R$A097 if #R$9D97 counted nothing inside the
                      ; current object.
 $A067 BIT 6,(IX+$07) ; {Jump to #R$A074 if the object is not an animal.
 $A06B JR Z,$A074     ; }
 $A06D LD A,C         ; Use the result again.
 $A06E PUSH AF        ; {Point #REGhl at "[0x13] carrying[0x14]".
 $A06F LD HL,$ADF9    ; }
 $A072 JR $A08E       ; Jump to #R$A08E to print "carrying".
@label=TableListWhatIsHere_UseTheToken
*$A074 LD HL,$039B    ; Use the token #TOKEN($039B).
 $A077 DEC A          ; Drop one from the hold count.
 $A078 JR Z,$A07D     ; Jump to #R$A07D if the count was #N$01.
 $A07A LD HL,$0065    ; Use the token #TOKEN($0065).
@label=TableListWhatIsHere_ReadTheNameTokenFromTheObject
*$A07D PUSH HL        ; {Read the name token from the object record.
 $A07E LD L,(IX+$08)  ; }
 $A081 LD A,(IX+$09)  ; Read the name token's high byte from the object record.
 $A084 AND $0F        ; {Keep the low nibble of byte 9 of this object.
 $A086 LD H,A         ; }
 $A087 PUSH HL        ; {Call #R$A09D to list the exits for this location.
 $A088 CALL $A09D     ; }
 $A08B LD HL,$AFE0    ; Point at the message "[0x01] there[0x01][0x14]"
                      ; (#R$AFE0).
@label=TableListWhatIsHere_PrintCarryingOrThere
*$A08E CALL $72DD     ; Call #R$72DD to print message.
 $A091 AND A          ; Clear carry and return through #R$A092.
@label=TableListWhatIsHere_RestoreAndReturn
*$A092 POP DE         ; {Restore #REGde, #REGbc and #REGix from the stack.
 $A093 POP BC         ;
 $A094 POP IX         ; }
 $A096 RET            ; Return.
@label=TableListWhatIsHere_FinishTheList
*$A097 CALL $8583     ; Call #R$8583 to print a newline.
 $A09A SCF            ; Set carry and return: the list of what is here is
                      ; finished.
 $A09B JR $A092       ; Jump back to #R$A092.

; Message: Exits For This Location
;
; Used by the routines at #R$8C4B and #R$A050.
; .
; Prints the exit messages for this location from the list at #R$AFCA, indexed by the
; object's second flag.
@label=Message_ExitsForThisLocation
c$A09D LD HL,$AFCA   ; Point #REGhl at #R$AFCA.
 $A0A0 LD A,(IX+$04) ; Read the second flag from the object record.
 $A0A3 RLCA          ; {Shift the object's second flag and keep the middle
 $A0A4 RLCA          ; bits.
 $A0A5 AND $3C       ;
 $A0A7 LD E,A        ; }
 $A0A8 LD D,$00      ; The message offset's high byte is zero.
 $A0AA ADD HL,DE     ; Add the exit index to the message list.
 $A0AB JP $72DD      ; Jump back to #R$72DD to print this exit's message.

; Exits: Point At The List
;
; Used by the routines at #R$A0C8 and #R$A138.
; .
; Finds the current location and points #REGix at its exit list, seven
; bytes into the record. #REGbc is #N($03), the length of one exit.
;
; .
;
; Find the location's record.
@label=ExitsPointAtTheList
c$A0AE CALL $9BB1    ; Call #R$9BB1 to locate location.
 $A0B1 LD BC,$0007   ; {Step #REGix on by #N$07 bytes, to the exit list.
 $A0B4 ADD IX,BC     ; }
 $A0B6 LD BC,$0003   ; One exit is #N$03 bytes.
 $A0B9 RET           ; Return.

; Exits: The Direction Word
;
; Used by the routines at #R$A0C8, #R$A138 and #R$A7AA.
; .
; Looks a direction id up at #R$A20E plus twice the id. The words run
; from #TOKEN($0480) to #TOKEN($01C4). Bit 7 of the id is ignored.
@label=ExitsTheDirectionWord
c$A0BA LD HL,$A20E   ; Point at the token-address table at #N$A20E.
; This entry point is used by the routine at #R$A16C.
*$A0BD LD E,A        ; {Clear bit 7 of the token id.
 $A0BE RES 7,E       ; }
 $A0C0 LD D,$00      ; The direction-word offset's high byte is zero.
 $A0C2 ADD HL,DE     ; Add the token id.
 $A0C3 ADD HL,DE     ; Add the token id again. Each entry in #N$A20E is one
                     ; word.
 $A0C4 LD E,(HL)     ; Read the low byte of #N$A20E.
 $A0C5 INC HL        ; Step to the high byte of the direction token.
 $A0C6 LD D,(HL)     ; Read the high byte of the direction token at #R$A20E
                     ; plus twice the direction id.
 $A0C7 RET           ; Return.

; Exits: To The North There Is
;
; Used by the routine at #R$965B.
; .
; Walks the location's exit triples. For each exit guarded by a visible
; object it prints "to the <direction> there is". Direction #N$09 is printed
; as #TOKEN($07B5) and direction #N$0A as #TOKEN($082B).
;
; .
;
; Point at this location's exits.
@label=MessageListTheObjects
c$A0C8 PUSH BC        ; {Point at this location's exits.
 $A0C9 PUSH DE        ;
 $A0CA PUSH IY        ;
 $A0CC PUSH IX        ;
 $A0CE CALL $A0AE     ; }
 $A0D1 ADD IX,BC      ; {Step #REGix on by #REGbc to the next exit and point
 $A0D3 PUSH IX        ; #REGiy at it.
 $A0D5 POP IY         ; }
@label=MessageListTheObjects_Loop
*$A0D7 SUB A          ; {Jump to #R$A113 if this exit goes via no object.
 $A0D8 CP (IY+$01)    ;
 $A0DB JR Z,$A113     ; }
 $A0DD LD A,(IY+$01)  ; Read the object this exit goes via.
 $A0E0 CALL $9BCA     ; Call #R$9BCA to locate object.
 $A0E3 BIT 7,(IX+$07) ; {Jump to #R$A113 if the object is not visible.
 $A0E7 JR Z,$A113     ; }
 $A0E9 LD DE,$0008    ; {Step the pointer on by #N$08 bytes.
 $A0EC ADD IX,DE      ; }
 $A0EE PUSH IX        ; {Save the name pointer and read this exit's direction.
 $A0F0 LD A,(IY+$00)  ; }
 $A0F3 CALL $A0BA     ; Call #R$A0BA to describe the direction word.
 $A0F6 CP $09         ; {Jump to #R$A104 if the direction is below #N$09.
 $A0F8 JR C,$A104     ; }
 $A0FA LD DE,$07B5    ; {Use the token #TOKEN($07B5) when the direction is
 $A0FD JR Z,$A10A     ; #N$09.}
 $A0FF LD DE,$082B    ; Use the token #TOKEN($082B).
 $A102 JR $A10A       ; Jump to #R$A10A to print a dictionary token.
@label=MessageListTheObjects_PrintTheLeadIn
*$A104 LD HL,$AE17    ; Point at the message "to the[0x16]" (#R$AE17).
 $A107 CALL $72DD     ; Call #R$72DD to print message.
@label=MessageListTheObjects_PrintADictionaryToken
*$A10A CALL $74C1     ; Call #R$74C1 to print a dictionary token.
 $A10D LD HL,$B013    ; Point at the message "there is[0x00][0x14]" (#R$B013).
 $A110 CALL $72DD     ; Call #R$72DD to print message.
@label=MessageListTheObjects_StepToTheNextExit
*$A113 ADD IY,BC      ; {Step to the next exit and jump back to #R$A0D7 unless
 $A115 LD A,$FF       ; the direction is #N$FF.
 $A117 CP (IY+$00)    ;
 $A11A JP NZ,$A0D7    ; }
 $A11D POP IX         ; {Restore #REGix, #REGiy, #REGde and #REGbc from the
 $A11F POP IY         ; stack.
 $A121 POP DE         ;
 $A122 POP BC         ; }
 $A123 RET            ; Return.

; Message: A Conjunction
;
; Used by the routine at #R$A138.
; .
; Prints "and" between listed objects.
@label=MessageAConjunction
c$A124 ADD IX,BC     ; {Return if this direction is #N$FF.
 $A126 LD A,$FF      ;
 $A128 CP (IX+$00)   ;
 $A12B RET Z         ; }
 $A12C XOR A         ; {Jump back to #R$A124 if this exit goes via an object.
 $A12D CP (IX+$01)   ;
 $A130 JR NZ,$A124   ; }
 $A132 CP (IX+$00)   ; {Jump back to #R$A124 if this direction is zero.
 $A135 JR Z,$A124    ; }
 $A137 RET           ; Return.

; Display Exits
;
; Used by the routine at #R$965B.
; .
; Prints the exits out of the current place.
;
; .
;
; Save the registers used while the exits are listed.
@label=DisplayExits
c$A138 PUSH IX       ; {Save #REGix, #REGiy, #REGde and #REGbc, then call
 $A13A PUSH IY       ; #R$A0AE to list the exits.
 $A13C PUSH DE       ;
 $A13D PUSH BC       ;
 $A13E CALL $A0AE    ; }
 $A141 CALL $A124    ; Call #R$A124 to print a conjunction.
 $A144 JR Z,$A15D    ; Jump to #R$A15D if there are no exits.
 $A146 LD HL,$B020   ; Point at the message "visible exits are:[0x16]"
                     ; (#R$B020).
 $A149 CALL $72DD    ; Call #R$72DD to print message.
@label=DisplayExits_Loop
*$A14C LD A,(IX+$00) ; Read this exit's direction.
 $A14F CALL $A0BA    ; Call #R$A0BA to describe the direction word.
 $A152 CALL $74C1    ; Call #R$74C1 to print a dictionary token.
 $A155 CALL $A124    ; Call #R$A124 to print a conjunction.
 $A158 JR NZ,$A14C   ; Jump back to #R$A14C while #R$A124 reports another name
                     ; follows.
 $A15A CALL $8583    ; Call #R$8583 to print a newline.
; Restore the registers saved for the exit list.
@label=DisplayExits_RestoreAndReturn
*$A15D POP BC        ; {Restore #REGbc, #REGde, #REGiy and #REGix from the
 $A15E POP DE        ; stack.
 $A15F POP IY        ;
 $A161 POP IX        ; }
 $A163 RET           ; Return.

; Message: Name From The Other Record
;
; Used by the routines at #R$9213, #R$92B5, #R$946D and #R$948D.
; .
; Reads the name token from the other record and joins the name printer.
@label=Message_NameFromTheOtherRecord
c$A164 LD L,(IY+$08) ; Read the name token from #REGiy.
 $A167 LD H,(IY+$09) ; Read the name token's high byte from #REGiy.
 $A16A JR $A172      ; Jump to #R$A172 to save the address and #R$B020.

; Message: Name From This Record
;
; Used by the routines at #R$8EEC, #R$8F3B, #R$9076, #R$910E, #R$9138, #R$9171,
; #R$92ED, #R$93DA, #R$946D, #R$948D, #R$A541 and #R$A55F.
; .
; Reads the name token from this object's record and prints "is" with that
; name.
@label=Message_NameFromThisRecord
c$A16C LD L,(IX+$08) ; Read the name token from the object record.
 $A16F LD H,(IX+$09) ; Read the name token's high byte from the object record.
; This entry point is used by the routine at #R$A164.
@label=Message_NameFromThisRecord_ChooseTheNameTable
*$A172 PUSH DE       ; {Point #REGhl at the name table used when bit 7 is
 $A173 PUSH HL       ; clear.
 $A174 LD HL,$A224   ; }
 $A177 BIT 7,A       ; {Jump to #R$A17E if bit 7 of #REGa is clear.
 $A179 JR Z,$A17E    ; }
 $A17B LD HL,$A234   ; Point #REGhl at the name table used when bit 7 is set.
@label=Message_NameFromThisRecord_DescribeTheDirection
*$A17E CALL $A0BD    ; Call #R$A0BD to describe the direction word.
 $A181 POP HL        ; {Point at the message "[0x04] is[0x01][0x15]".
 $A182 PUSH DE       ;
 $A183 PUSH HL       ;
 $A184 LD HL,$AFBB   ; }
 $A187 CALL $72DD    ; Call #R$72DD to print message.
 $A18A POP DE        ; Restore #REGde from the stack.
 $A18B RET           ; Return.

; Action: Clear The Tie
;
; Used by the routines at #R$92ED, #R$977C and #R$A5FB.
; .
; Clears the tie on the object. An animal's name bytes are overwritten with #TOKEN($0192), and the
; object record is returned.
@label=Action_ClearTheTie
c$A18C PUSH IX         ; Call #R$9BCA to locate the object.
; Find the object's record.
 $A18E CALL $9BCA      ;
 $A191 LD (IX+$0C),$00 ; Clear byte #N$0C of this object.
 $A195 LD (IX+$0D),$00 ; Clear byte #N$0D of this object.
 $A199 LD DE,$00CD     ; {Keep #TOKEN($00CD) and jump to #R$A1A5 if the object
 $A19C BIT 6,(IX+$07)  ; is not an animal.
 $A1A0 JR Z,$A1A5      ; }
 $A1A2 LD DE,$0192     ; Use the token #TOKEN($0192).
@label=Action_ClearTheTie_StoreTheTie
*$A1A5 LD (IX+$0A),E   ; Update byte #N$0A of this object.
 $A1A8 LD (IX+$0B),D   ; Update byte #N$0B of this object.
 $A1AB POP IX          ; Restore #REGix from the stack.
 $A1AD RET             ; Return.
 $A1AE PUSH IY         ; {Start the object search one slot before #R$C063.
 $A1B0 PUSH IX         ;
 $A1B2 LD IX,$C060     ; }
@label=Action_ClearTheTie_FindTheRecord
*$A1B6 CALL $9BA9      ; Call #R$9BA9 to find the record.
 $A1B9 JR Z,$A1C0      ; Jump to #R$A1C0 if the index has ended.
 $A1BB CP (IY+$01)     ; {Jump back to #R$A1B6 if where this object is is not
 $A1BE JR NZ,$A1B6     ; the id in #REGa.}
@label=Action_ClearTheTie_ReadTheIdFromTheIndexEntry
*$A1C0 LD A,(IX+$00)   ; Read the id from the index entry.
 $A1C3 POP IX          ; {Restore #REGix and #REGiy from the stack.
 $A1C5 POP IY          ; }
 $A1C7 RET             ; Return.

; Condition: Animal And Not Broken
;
; Used by the routine at #R$9076.
; .
; Returns with the zero flag set when the object is an animal (bit 6) and not
; broken (bit 3).
@label=Condition_AnimalAndNotBroken
c$A1C8 LD A,(IX+$07) ; Read the attribute flags from the object record.
 $A1CB AND $48       ; Keep the animal bit and the broken bit.
 $A1CD CP $40        ; Compare with #N$40: animal set, broken clear.
 $A1CF RET           ; Return.

; Action: Match A Verb In The Table
;
; Used by the routines at #R$94D6 and #R$950F.
; .
; Matches the current action against the five verb bytes at #R$A20B and returns when one
; of them matches.
@label=Action_MatchAVerbInTheTable
c$A1D0 PUSH HL       ; {Count #N$05 passes.
 $A1D1 PUSH BC       ;
 $A1D2 LD B,$05      ; }
 $A1D4 LD HL,$A20B   ; Point #REGhl at table: Verb List.
 $A1D7 LD A,($B6E7)  ; Read *#R$B6E7.
@label=Action_MatchAVerbInTheTable_TestTheVerb
*$A1DA CP (HL)       ; {Jump to #R$A1E0 if the current action is the verb byte.
 $A1DB JR Z,$A1E0    ; }
 $A1DD INC HL        ; Step to the next byte in display exits.
 $A1DE DJNZ $A1DA    ; Loop back to #R$A1DA until #N$05 runs out.
@label=Action_MatchAVerbInTheTable_ReturnFromTheVerbTable
*$A1E0 POP BC        ; {Restore #REGbc and #REGhl from the stack.
 $A1E1 POP HL        ; }
 $A1E2 RET           ; Return.

; Response: You Say
;
; Used by the routines at #R$A4D9, #R$A4F5, #R$A4FE, #R$A5FB, #R$A7AA, #R$A86E
; and #R$A9BD.
; .
; Prints "You say ", then the message and a full stop, and arms the
; capitalise-the-next-letter flag.
@label=Response_YouSay
c$A1E3 PUSH HL       ; {Point at the message "You say ".
 $A1E4 LD HL,$B009   ; }
 $A1E7 CALL $72DD    ; Call #R$72DD to print message.
 $A1EA POP HL        ; {Set the capitalise-the-next-letter flag before the
 $A1EB LD A,$01      ; spoken message.
 $A1ED LD ($B704),A  ; }
 $A1F0 CALL $72DD    ; Call #R$72DD to print message.
 $A1F3 LD HL,$B00F   ; Point at the message ".[0x14]" (#R$B00F).
 $A1F6 JP $72DD      ; Jump back to #R$72DD to print the full stop.

; Action: Read The Object's Lock Flag
;
; Used by the routines at #R$910E and #R$946D.
; .
; Reads the current object's lock flag. A locked object returns #N$80; otherwise its attributes
; are tested.
@label=Action_ReadTheObjectLockFlag
c$A1F9 LD IX,($B708)  ; Read *#R$B708.
 $A1FD BIT 0,(IX+$07) ; {Take #N($80), and return if the object is locked.
 $A201 LD A,$80       ;
 $A203 RET NZ         ; }
; This entry point is used by the routine at #R$948D.
*$A204 BIT 5,(IX+$07) ; Test whether the object is open.
 $A208 LD A,$85       ; Return #N($85), the message code for an open object.
 $A20A RET            ; Return.

; Table: Verb List
;
; Five action ids. #R$A1D4 compares the current action with these bytes, and #R$A0BA reads #R$A20E as the direction-word table.
; Read by #R$A1D0.
b$A20B DEFB $0E,$11,$12 ; #N$0E drop, #N$11 put in, #N$12 put on.
 $A20E DEFB $14,$2C     ; #N$14 take out of, #N$2C throw. #R$A0BA adds twice
                        ; the direction id to this address.

; Table: Direction Words
;
; #TOKEN($0480) through #TOKEN($01C4). #R$A0BA reads the direction token at
; #R$A20E plus twice the direction id, so direction #N$01 is the first word
; here.
b$A210 DEFW $0480    ; #WORDPTR
 $A212 DEFW $0607    ; #WORDPTR
 $A214 DEFW $01FE    ; #WORDPTR
 $A216 DEFW $0779    ; #WORDPTR
 $A218 DEFW $0485    ; #WORDPTR
 $A21A DEFW $048E    ; #WORDPTR
 $A21C DEFW $060C    ; #WORDPTR
 $A21E DEFW $0615    ; #WORDPTR
 $A220 DEFW $0725    ; #WORDPTR
 $A222 DEFW $01C4    ; #WORDPTR

; Table: Names For A Clear Bit 7
;
; Eight words. #R$A174 points here when bit 7 of the name byte is clear, and
; #R$A0BD picks one word.
b$A224 DEFW $0718    ; #WORDPTR
 $A226 DEFW $0000    ; Empty.
 $A228 DEFW $0228    ; #WORDPTR
 $A22A DEFW $0000    ; Empty.
 $A22C DEFW $049F    ; #WORDPTR
 $A22E DEFW $0139    ; #WORDPTR
 $A230 DEFW $0192    ; #WORDPTR
 $A232 DEFW $0000    ; Empty.

; Table: Names For A Set Bit 7
;
; Eight words. #R$A17B points here when bit 7 of the name byte is set.
b$A234 DEFW $03F6    ; #WORDPTR
 $A236 DEFW $0000    ; Empty.
 $A238 DEFW $02B9    ; #WORDPTR
 $A23A DEFW $00CD    ; #WORDPTR
 $A23C DEFW $04AA    ; #WORDPTR
 $A23E DEFW $04B4    ; #WORDPTR
 $A240 DEFW $07D4    ; #WORDPTR
 $A242 DEFW $0000    ; Empty.

; Action: Drink Water
;
; Holds the message back when the player drinks #OBJECT($17,$01,$01)($).
; Reached through the action list of #OBJECT($17,$01,$01)($) for action
; #N($21), dispatched by #R$9B6C.
@label=Action_DrinkWater
c$A244 CALL $9D44    ; Call #R$9D44. If the message is held back, it returns
                     ; past this handler.
 $A247 RET           ; Return.

; Action: Tie
;
; Ties the current object to the second object.
; Reached through the action list of #OBJECT($12,$01,$01)($) for action #N($2E), dispatched by #R$9B6C.
; Reached through the action table at #R$C730, dispatched by #R$950F.
;
; .
;
; Test the current object.
@label=ActionTie
c$A248 LD A,($B6E8)    ; {Jump to #R$A2AE if *#R$B6E8 is #N$12.
 $A24B CP $12          ;
 $A24D JR Z,$A2AE      ; }
; Test the second object.
 $A24F LD A,($B6E9)    ; {Jump to #R$9F76 if *#R$B6E9 is not #N$12.
 $A252 CP $12          ;
 $A254 JP NZ,$9F76     ; }
 $A257 LD IX,($B708)   ; Read *#R$B708.
 $A25B BIT 1,(IX+$07)  ; {Jump back to #R$9F76 if the object is a fluid.
 $A25F JP NZ,$9F76     ; }
; Count the objects being held.
 $A262 CALL $9D97      ; Call #R$9D97 to count the visible objects.
 $A265 CP $00          ; {Point #REGhl at the message, and jump back to #R$72DD
 $A267 LD HL,$B07D     ; if #R$9D97 counted any visible objects inside it.
 $A26A JP NZ,$72DD     ; }
 $A26D BIT 3,(IX+$07)  ; {Jump to #R$A27A if the object is broken.
 $A271 JR NZ,$A27A     ; }
 $A273 BIT 6,(IX+$07)  ; {Jump back to #R$9F76 if the object is an animal.
 $A277 JP NZ,$9F76     ; }
; If the message is held back, the object is not tied.
@label=ActionTie_StartTheTie
*$A27A CALL $9D44      ; Call #R$9D44. If the message is held back, the object
                       ; is not tied.
 $A27D LD IY,($B70A)   ; Read *#R$B70A.
; Test whether the object is being carried.
 $A281 CALL $9C78      ; Call #R$9C78 to test whether the object is carried.
 $A284 LD A,($B6E9)    ; Read *#R$B6E9.
 $A287 LD (IX+$01),A   ; Update where this object is.
 $A28A JR C,$A2A2      ; Jump to #R$A2A2 if #R$9C78 found the object carried
                       ; (carry set).
 $A28C SUB A           ; Clear the message gate before the object is picked up.
 $A28D LD ($B6FA),A    ; Update *#R$B6FA.
 $A290 CALL $8D33      ; Call #R$8D33 to pick the object up.
 $A293 LD A,($B6FB)    ; Read the message-suppressed flag left by the pick-up.
 $A296 CP $00          ; Compare the message-suppressed flag with zero.
; Update the message gate.
 $A298 LD A,$01        ; {Hold later messages back.
 $A29A LD ($B6FA),A    ;
 $A29D LD ($B6FB),A    ; }
 $A2A0 JR Z,$A2A9      ; Jump to #R$A2A9 if the message-suppressed flag is
                       ; zero.
@label=ActionTie_ReadTheCurrentCharacter
*$A2A2 LD A,($B6EA)    ; Read *#R$B6EA.
 $A2A5 LD (IY+$01),A   ; Update where this object is.
 $A2A8 RET             ; Return.
@label=ActionTie_MarkWhereThisObjectIsAsUnset
*$A2A9 LD (IY+$01),$FF ; Mark where this object is as unset.
 $A2AD RET             ; Return.
@label=ActionTie_PointAtTheTieAction
*$A2AE LD HL,$A248     ; Point #REGhl at the tie action.
 $A2B1 JP $9F4A        ; Jump to #R$9F4A to hand an object over.

; Action: Untie
;
; Unties the current object.
; Reached through the action table at #R$C730, dispatched by #R$950F.
@label=ActionUntie
c$A2B4 LD IX,($B708)  ; Read *#R$B708.
 $A2B8 LD A,(IX+$01)  ; Read where this object is from the object record.
 $A2BB CP $12         ; Compare where this object is with #N$12.
 $A2BD LD HL,$B092    ; Point #REGhl at "[0x07] is not tied".
 $A2C0 JP NZ,$72DD    ; Jump back to #R$72DD if where this object is is not
                      ; #N$12.
; If the message is held back, the object stays tied.
 $A2C3 CALL $9D44     ; Call #R$9D44. If the message is held back, the object
                      ; stays tied.
 $A2C6 LD A,($C367)   ; {Copy where #OBJECT($12,$01,$01)($) is into where this
 $A2C9 LD (IX+$01),A  ; object is.}
 $A2CC RET            ; Return.
; Find the exit through the current object.
; .
; Reached through the action list of #OBJECT($2A,$01,$01)($) for action
; #N($32), dispatched by #R$9B6C.
 $A2CD CALL $9F25     ; Call #R$9F25 to find the exit through the current
                      ; object.
 $A2D0 LD A,(IX+$02)  ; Read this exit's destination.
 $A2D3 CP $00         ; {Jump to #R$A2DB if this exit's destination is not
 $A2D5 JR NZ,$A2DB    ; zero.}
; If the message is held back, the routine returns without untying.
 $A2D7 CALL $9D44     ; Call #R$9D44. If the message is held back, the routine
                      ; returns without untying.
 $A2DA RET            ; Return.
@label=ActionUntie_OpenAndMove
*$A2DB LD A,(IX+$00)  ; Read this exit's direction.
 $A2DE LD HL,($B6E7)  ; Read *#R$B6E7.
 $A2E1 PUSH HL        ; {Update *#R$B6E7.
 $A2E2 LD ($B6E7),A   ; }
 $A2E5 LD IX,($B708)  ; Read *#R$B708.
 $A2E9 SET 5,(IX+$07) ; Mark the object open.
 $A2ED PUSH IX        ; {Write #N$FF to *#R$B6E8.
 $A2EF LD A,$FF       ;
 $A2F1 LD ($B6E8),A   ; }
 $A2F4 CALL $8DAB     ; Call #R$8DAB to carry on with the move.
 $A2F7 POP IX         ; {Restore the object from the stack and close it.
 $A2F9 RES 5,(IX+$07) ; }
 $A2FD POP HL         ; {Update *#R$B6E7.
 $A2FE LD ($B6E7),HL  ; }
 $A301 RET            ; Return.

; Action: Burn
;
; Burns the current object.
; Reached through the action table at #R$C730, dispatched by #R$950F.
;
; .
;
; Test whose turn it is.
@label=ActionBurn
c$A302 LD A,($B6EA)   ; {Jump to #R$9F76 if *#R$B6EA is not #N$3C.
 $A305 CP $3C         ;
 $A307 JP NZ,$9F76    ; }
; If the message is held back, the object is not burned.
 $A30A CALL $9D44     ; Call #R$9D44. If the message is held back, the object
                      ; is not burned.
 $A30D JP $977C       ; Jump back to #R$977C to test the current object.
; If the message is held back, the river message is not printed.
; .
; Reached through the action list of #OBJECT($09,$01,$01)($) for action
; #N($32), dispatched by #R$9B6C.
 $A310 CALL $9D44     ; Call #R$9D44. If the message is held back, the river
                      ; message is not printed.
 $A313 LD HL,$B0B4    ; Point #REGhl at "as soon as you touch the river you
                      ; fall asleep and gently float away".
; Print the message at #REGhl.
@label=ActionBurn_Loop
*$A316 CALL $72DD     ; Call #R$72DD to print message.
 $A319 LD A,($B6EA)   ; Read *#R$B6EA.
 $A31C PUSH AF        ; {See whether the character whose turn it is is zero.
 $A31D AND A          ; }
 $A31E LD HL,$ADA9    ; Point #REGhl at "Time passes.." in #R$ADA3.
 $A321 CALL Z,$72DD   ; Call #R$72DD if it is the player's turn.
 $A324 POP AF         ; {Jump back to #R$977F to try the next object.
 $A325 JP $977F       ; }
; If the message is held back, the sleep message is not printed.
; .
; Reached through the action lists of #OBJECT($16,$01,$01)($) and
; #OBJECT($18,$01,$01)($) for action #N($21), dispatched by #R$9B6C.
 $A328 CALL $9D44     ; Call #R$9D44. If the message is held back, the sleep
                      ; message is not printed.
 $A32B LD HL,$B0F8    ; Point #REGhl at "You fall asleep".
 $A32E JR $A316       ; Jump back to #R$A316 to print "You fall asleep".
; Reached through the action list of #OBJECT($0B,$01,$01)($) for action
; #N($26), dispatched by #R$9B6C.
 $A330 LD B,$02       ; Use object #N$02.
 $A332 JR $A33A       ; Jump to #R$A33A to test whether that object is the
                      ; second object.
; Reached through the action list of #OBJECT($08,$01,$01)($) for actions #N$25
; and #N($26), dispatched by #R$9B6C.
 $A334 LD B,$0F       ; Use object #N$0F.
 $A336 JR $A33A       ; Jump to #R$A33A to test whether that object is the
                      ; second object.
; Reached through the action list of #OBJECT($01,$01,$01)($) for actions #N$25
; and #N($26), dispatched by #R$9B6C.
 $A338 LD B,$04       ; Use object #N$04.
@label=ActionBurn_TestTheSecondObject
*$A33A LD A,($B6E9)   ; Read *#R$B6E9.
 $A33D CP B           ; {Jump to #R$A34B unless the second object is the one in
 $A33E JR NZ,$A34B    ; #REGb.}
; Test the current action.
 $A340 LD A,($B6E7)   ; {Jump to #R$946D to lock the object if *#R$B6E7 is
 $A343 CP $25         ; #N$25.
 $A345 JP Z,$946D     ; }
 $A348 JP $948D       ; Jump to #R$948D to unlock the object.
@label=ActionBurn_TestTheAction
*$A34B CP $02         ; {Jump to #R$A358 if the current action is #N$02.
 $A34D JR Z,$A358     ; }
 $A34F CP $04         ; {Jump to #R$A358 if the current action is #N$04.
 $A351 JR Z,$A358     ; }
 $A353 CP $0F         ; {Jump back to #R$72CE if the current action is not
 $A355 JP NZ,$72CE    ; #N$0F.}
; Say "[0x09] does not fit this lock".
; .
; Reached through the action list of #OBJECT($05,$01,$01)($) for actions #N$25
; and #N($26), and of #OBJECT($1E,$01,$01)($) for action #N($26), dispatched by
; #R$9B6C.
@label=ActionBurn_PrintDoesNotFit
*$A358 LD HL,$B02D    ; {Point #REGhl at the message and call #R$72DD.
 $A35B JP $72DD       ; }
; Reached through the action list of #OBJECT($0B,$01,$01)($) for action
; #N($00), dispatched by #R$9B6C.
 $A35E CALL $97FF     ; Call #R$97FF to let the message through or hold it
                      ; back.
 $A361 LD IX,($B708)  ; Read *#R$B708.
 $A365 JP $9117       ; Jump back to #R$9117 to open the object.
; Reached through the action list of #OBJECT($06,$01,$01)($) for action
; #N($10), dispatched by #R$9B6C.
 $A368 LD IX,($B70C)  ; Read *#R$B70C.
 $A36C LD A,(IX+$10)  ; Read the location from the object record.
 $A36F CP $0F         ; {Jump back to #R$9F76 if the object's location is not
 $A371 JP NZ,$9F76    ; #N$0F.}
 $A374 JP $910E       ; Jump to #R$910E to open or close.
; Reached through the action list of #OBJECT($07,$01,$01)($) for action
; #N($00), dispatched by #R$9B6C.
 $A377 LD IX,($B708)  ; Read *#R$B708.
 $A37B BIT 3,(IX+$07) ; {Return if the object is not broken.
 $A37F RET Z          ; }
 $A380 SET 5,(IX+$07) ; Mark the object open.
 $A384 LD A,($CA8B)   ; {Store the object's location in the spider web script.
 $A387 LD ($CA8C),A   ; }
; Say "some spiders start mend(s|d|ing|es) the broken web".
 $A38A LD HL,$B099    ; {Point #REGhl at the message and call #R$72DD.
 $A38D JP $72DD       ; }
; Wear the ring: the character turns invisible and its strength is quartered.
; .
; If the message is held back, the ring is not put on.
; .
; Reached through the action list of #OBJECT($10,$01,$01)($) for action
; #N($28), dispatched by #R$9B6C.
 $A390 CALL $9D44     ; Call #R$9D44. If the message is held back, the ring is
                      ; not put on.
 $A393 LD IY,($B70C)  ; Read the character.
 $A397 LD IX,$C31A    ; Point #REGix at the ring.
 $A39B RES 7,(IY+$07) ; Make the character invisible.
 $A39F SRL (IY+$05)   ; Halve the strength.
 $A3A3 SRL (IY+$05)   ; Halve the strength.
 $A3A7 RES 7,(IX+$07) ; Hide the ring.
 $A3AB LD A,($B6EA)   ; {Move the ring onto the character.
 $A3AE LD (IX+$01),A  ; }
 $A3B1 LD A,$08       ; Roll a random number below #N$08.
; Roll a random number.
 $A3B3 CALL $9C9F     ; Call #R$9C9F to roll a number from the limit in #REGa.
 $A3B6 ADD A,$02      ; Add #N$02 to the roll.
 $A3B8 LD ($CAAF),A   ; Store the roll at #R$CAAF.
 $A3BB RET            ; Return.

; Action: Remove The Ring
;
; Used by the routine at #R$AAE0.
; .
; Takes the ring off. If the ring is not being worn (it is visible), prints "You are not wearing" and its name; otherwise the ring and the character become visible again, the strength is multiplied by four, and #R$CAAF is cleared.
; Reached through the action list of #OBJECT($10,$01,$01)($) for action #N($16), dispatched by #R$9B6C.
@label=Action_RemoveTheRing
c$A3BC LD IX,($B70C)  ; Read the character.
 $A3C0 LD IY,$C31A    ; Point #REGiy at the ring.
 $A3C4 BIT 7,(IY+$07) ; Test whether the ring is visible.
 $A3C8 LD HL,$B074    ; Point #REGhl at "You are not wearing[0x07]".
 $A3CB JP NZ,$72DD    ; Jump back to #R$72DD if the ring is not being worn.
; If the message is held back, the ring is not taken off.
 $A3CE CALL $9D44     ; Call #R$9D44. If the message is held back, the ring is
                      ; not taken off.
 $A3D1 SET 7,(IY+$07) ; Show the ring again.
 $A3D5 SET 7,(IX+$07) ; Make the character visible again.
 $A3D9 SLA (IX+$05)   ; Double the strength and keep the overflow.
 $A3DD SLA (IX+$05)   ; Double the strength and keep the overflow.
 $A3E1 SUB A          ; Clear the byte at #N$CAAF.
 $A3E2 LD ($CAAF),A   ; Store the result at #R$CAAF.
 $A3E5 RET            ; Return.

; Action: Capture
;
; Captures the current creature.
; Reached through the action table at #R$C730, dispatched by #R$950F.
@label=ActionCapture
c$A3E6 LD IX,($B708)   ; Read *#R$B708.
 $A3EA LD A,(IX+$04)   ; Read the second flag from the object record.
 $A3ED AND $70         ; {Keep bits 4-6 of the flags, save #REGix, and point
 $A3EF PUSH IX         ; #REGix at the object in *#R$B70C.
 $A3F1 LD IX,($B70C)   ; }
 $A3F5 AND (IX+$04)    ; Test these bits of the object's second flag.
 $A3F8 POP IX          ; {Restore the object record from the stack and jump to
 $A3FA JP NZ,$9F76     ; #R$9F76 if those flag bits were set.}
 $A3FD BIT 6,(IX+$07)  ; {Jump back to #R$9F76 if the object is not an animal.
 $A401 JP Z,$9F76      ; }
 $A404 LD A,($B6EA)    ; Read *#R$B6EA.
 $A407 LD B,$1F        ; {Use location #N$1F and jump to #R$A413 if this
 $A409 CP $40          ; character is #N$40.
 $A40B JR Z,$A413      ; }
 $A40D CP $42          ; {Jump to #R$A413 if the character whose turn it is is
 $A40F JR Z,$A413      ; #N$42.}
 $A411 LD B,$0D        ; Use location #N$0D for any other character.
@label=ActionCapture_TestTheLocation
*$A413 LD A,($B6F6)    ; Read *#R$B6F6.
 $A416 CP B            ; {Jump back to #R$9F76 if the script location is the
 $A417 JP Z,$9F76      ; location in #REGb.}
; If the message is held back, the creature is not captured.
 $A41A CALL $9D44      ; Call #R$9D44. If the message is held back, the
                       ; creature is not captured.
 $A41D LD IX,($B708)   ; Read *#R$B708.
 $A421 LD (IX+$10),B   ; Update the object's location.
 $A424 LD (IX+$01),$FF ; Mark where this object is as unset.
 $A428 LD A,($B6E8)    ; Read *#R$B6E8.
 $A42B CALL $9BDD      ; Call #R$9BDD to move what is inside the current object
                       ; to the capture location.
 $A42E LD A,($B6E8)    ; Read *#R$B6E8.
 $A431 CP $00          ; {Return if the current object is not zero.
 $A433 RET NZ          ; }
 $A434 LD ($B6EA),A    ; Update *#R$B6EA.
 $A437 LD HL,$C11B     ; {Point *#R$B70C at "#TEXTTOKEN($C11B+$08,$01)".
 $A43A LD ($B70C),HL   ; }
; Test whether the location is lit.
 $A43D CALL $95ED      ; Call #R$95ED to test whether the location is lit.
 $A440 RET C           ; Return if the location is dark (carry set).
 $A441 LD A,B          ; Take the capture location into #REGa.
 $A442 LD HL,$AFFC     ; Point #REGhl at "You are in".
 $A445 JP $964D        ; Jump to #R$964D to print the location text.

; Action: Goblin Capture
;
; Runs for the goblins #OBJECT($3D,$01,$01)($), #OBJECT($45,$01,$01)($) and #OBJECT($49,$01,$01)($)
; to #OBJECT($4C,$01,$01)($). Their action lists reach here through #R$9586 and #R$9B6C, called from
; #R$950F. #REGb holds the character from #R$B6EA when reached through #R$9A0C, and #N$00 when reached
; through #R$7B3A. The player's location is compared with it before the goblin speaks.
; Reached through the action lists of #OBJECT($3D,$01,$01)($), #OBJECT($45,$01,$01)($), #OBJECT($49,$01,$01)($), #OBJECT($4A,$01,$01)($), #OBJECT($4B,$01,$01)($) and #OBJECT($4C,$01,$01)($) for action #N($00), dispatched by #R$9B6C.
@label=ActionGoblinCapture
c$A448 LD IX,($B708)  ; Read *#R$B708.
 $A44C BIT 3,(IX+$07) ; {Return if the object is not broken.
 $A450 RET Z          ; }
 $A451 RES 3,(IX+$07) ; Mark the object not broken.
 $A455 LD DE,$0006    ; Each capture entry is #N$06 bytes.
@nowarn
 $A458 LD IY,$A49C    ; Point #REGiy at the capture table.
 $A45C LD A,($B6E8)   ; Read *#R$B6E8.
@label=ActionGoblinCapture_Loop
*$A45F CP (IY+$00)    ; {Jump to #R$A468 if this capture entry is the current
 $A462 JR Z,$A468     ; object.}
 $A464 ADD IY,DE      ; Step #REGiy on by one capture entry.
 $A466 JR $A45F       ; Jump back to #R$A45F to try the next object.
@label=ActionGoblinCapture_StepToTheNextByteInCapture
*$A468 PUSH IY        ; {Step to the next byte in capture.
 $A46A POP HL         ;
 $A46B INC HL         ; }
 $A46C LD E,(HL)      ; Read the low byte of the pointer in this capture entry.
 $A46D INC HL         ; Step to the next byte in capture.
 $A46E LD D,(HL)      ; Read the high byte of the pointer in this capture
                      ; entry.
 $A46F LD (DE),A      ; {Store the current object id at the address taken from
 $A470 INC HL         ; this entry.}
 $A471 LD A,(HL)      ; {Store the next table byte as the object's location.
 $A472 LD (IX+$10),A  ; }
 $A475 INC HL         ; Step to the next byte in capture.
 $A476 LD A,(HL)      ; {Store the next table byte as name byte #N$0A of the
 $A477 LD (IX+$0A),A  ; object.}
 $A47A INC HL         ; Step to the next byte in capture.
 $A47B LD A,(HL)      ; {Store the next table byte as name byte #N$0B of the
 $A47C LD (IX+$0B),A  ; object.}
; Say "[0x07] fall(s|d|ing|es) down a hole and vanish(s|d|ing|es)".
 $A47F LD HL,$B068    ; {Point #REGhl at the message and call #R$72DD.
 $A482 CALL $72DD     ; }
 $A485 LD A,($C12B)   ; {Return if the player's location is not the #REGb
 $A488 CP B           ; passed in by the caller of #R$950F.
 $A489 RET NZ         ; }
 $A48A LD DE,$005E    ; Use the token #TOKEN($005E).
; Print the token in #REGde.
 $A48D CALL $74C1     ; Call #R$74C1 to print a dictionary token.
 $A490 LD DE,$02E2    ; Use the token #TOKEN($02E2).
; Print the token in #REGde.
 $A493 CALL $74C1     ; Call #R$74C1 to print a dictionary token.
; Print the message at #REGhl.
 $A496 LD HL,$B018    ; {Point #REGhl at the message and call #R$72DD.
 $A499 JP $72DD       ; }

; Goblin Capture Table
;
; Six entries of #N$06 bytes. Read by #R$A45F when a goblin captures an object.
; Each is a goblin id, the address that stores this goblin's id, the location
; the object is moved to, and name bytes #N$0A and #N$0B.
@label=ActionGoblinCapture_CaptureTable
b$A49C DEFB $3D,$18,$CB,$0F,$6A,$04 ; #OBJECT($3D,$01,$01)($) stores this
                                    ; goblin's id at #R$CB18 and moves the
                                    ; object to #LOCATION($0F).
 $A4A2 DEFB $45,$1F,$CB,$3A,$37,$03 ; #OBJECT($45,$01,$01)($) stores this
                                    ; goblin's id at #R$CB1F and moves the
                                    ; object to #LOCATION($3A).
 $A4A8 DEFB $49,$2D,$CB,$12,$61,$03 ; #OBJECT($49,$01,$01)($) stores this
                                    ; goblin's id at #R$CB2D and moves the
                                    ; object to #LOCATION($12).
 $A4AE DEFB $4A,$34,$CB,$38,$34,$04 ; #OBJECT($4A,$01,$01)($) stores this
                                    ; goblin's id at #R$CB34 and moves the
                                    ; object to #LOCATION($38).
 $A4B4 DEFB $4B,$26,$CB,$40,$41,$07 ; #OBJECT($4B,$01,$01)($) stores this
                                    ; goblin's id at #R$CB26 and moves the
                                    ; object to #LOCATION($40).
 $A4BA DEFB $4C,$3B,$CB,$10,$B6,$01 ; #OBJECT($4C,$01,$01)($) stores this
                                    ; goblin's id at #R$CB3B and moves the
                                    ; object to #LOCATION($10).

; Action: Open The Goblins Door
;
; Opens #OBJECT($11,$01,$01)($) when the character in *#R$B70C is in #LOCATION($10). The action list stores this address at #N($C357), and the copy of the objects stores it at #N$F63C.
; Reached through the action list of #OBJECT($11,$01,$01)($) for action #N($10), dispatched by #R$9B6C.
@label=Action_OpenTheGoblinsDoor
c$A4C0 LD IX,($B70C) ; Point #REGix at the character in *#R$B70C.
 $A4C4 LD A,(IX+$10) ; Read the location from the object record.
 $A4C7 CP $10        ; {Jump back to #R$9F76 if the object's location is not
 $A4C9 JP NZ,$9F76   ; #N$10.}
 $A4CC CALL $910E    ; Call #R$910E to open or close the object.
 $A4CF CALL $97FF    ; Call #R$97FF to let the message through or hold it back.
 $A4D2 LD A,($CA99)  ; {Copy the goblins door id at #R$CA99 into the flag at
 $A4D5 LD ($CA9A),A  ; #R$CA9A.}
 $A4D8 RET           ; Return.

; Event: Close The Goblins Door
;
; Closes the object at #R$C34B. The goblins door record at #R$CA9B calls this.
@label=Event_CloseTheGoblinsDoor
c$A4D9 LD HL,$C34B   ; Point #REGhl at #R$C34B.
 $A4DC RES 5,(HL)    ; Close that object.
 $A4DE RET           ; Return.
; If the message is held back, the goblins' door is not closed.
 $A4DF CALL $9D44    ; Call #R$9D44. If the message is held back, the goblins'
                     ; door is not closed.
 $A4E2 LD A,$0A      ; Roll a random number below #N$0A.
; Roll a random number.
 $A4E4 CALL $9C9F    ; Call #R$9C9F to roll a number from the limit in #REGa.
 $A4E7 LD HL,$B0A6   ; Point #REGhl at "what do you expect me to do with this
                     ; ?".
 $A4EA CP $08        ; {Jump back to #R$A1E3 if the roll is not below #N$08.
 $A4EC JP NC,$A1E3   ; }
 $A4EF LD HL,$B047   ; Point #REGhl at "thank you.".
 $A4F2 JP $A1E3      ; Jump back to #R$A1E3 to print "thank you.".

; Event: What's This
;
; Prints "what's this ?" through #R$A1E3. A character script calls this from
; #R$C8C9.
;
; .
;
; If the message is held back, "what's this ?" is not printed.
@label=Event_WhatsThis
c$A4F5 CALL $9D44    ; Call #R$9D44. If the message is held back, "what's this
                     ; ?" is not printed.
 $A4F8 LD HL,$B04B   ; Point #REGhl at "what's this ?".
 $A4FB JP $A1E3      ; Jump back to #R$A1E3 to print "what's this ?".

; Event: A Short Reply
;
; Prints one of "you are doing a great job", "hurry up" or "hello". A character script
; calls this from #R$C8D7.
;
; .
;
; If the message is held back, the short reply is not printed.
@label=Event_AShortReply
c$A4FE CALL $9D44    ; Call #R$9D44. If the message is held back, the short
                     ; reply is not printed.
 $A501 LD A,$02      ; Roll a random number below #N$02.
; Roll a random number.
 $A503 CALL $9C9F    ; Call #R$9C9F to roll a number from the limit in #REGa.
 $A506 LD HL,$B052   ; Point #REGhl at "you are do(s|d|ing|es) a great job.".
 $A509 CP $00        ; {Jump back to #R$A1E3 when #REGa is zero.
 $A50B JP Z,$A1E3    ; }
 $A50E LD HL,$B05B   ; Point #REGhl at "hurry up.".
 $A511 CP $01        ; {Jump back to #R$A1E3 if the roll is #N$01.
 $A513 JP Z,$A1E3    ; }
 $A516 LD HL,$B05F   ; Point #REGhl at "hello.".
 $A519 JP $A1E3      ; Jump back to #R$A1E3 to print "hello.".
; If the message is held back, Thrain's key is not mentioned.
 $A51C CALL $9D44    ; Call #R$9D44. If the message is held back, Thrain's key
                     ; is not mentioned.
 $A51F LD HL,$B061   ; Point #REGhl at "this was Thrains key.".
 $A522 JP $A1E3      ; Jump back to #R$A1E3 to print "this was thrains key.".
 $A525 LD A,($B6F6)  ; Read *#R$B6F6.
 $A528 LD HL,$B6F5   ; {Return if the script location is not where the player
 $A52B CP (HL)       ; starts.
 $A52C RET NZ        ; }
; If the message is held back, the hello is not printed.
 $A52D CALL $9D44    ; Call #R$9D44. If the message is held back, the hello is
                     ; not printed.
 $A530 LD HL,$B05F   ; Point #REGhl at "hello.".
 $A533 JP $A1E3      ; Jump back to #R$A1E3 to print "hello.".
; Test whose turn it is.
 $A536 LD A,($B6EA)  ; {Jump to #R$9F76 if *#R$B6EA is not #N$40.
 $A539 CP $40        ;
 $A53B JP NZ,$9F76   ; }
 $A53E JP $910E      ; Jump to #R$910E to open or close.

; Action: Climb Out
;
; Climbs out of the container the character is in.
; Reached through the action table at #R$C730, dispatched by #R$950F.
@label=ActionClimbOut
c$A541 LD IY,($B70C)   ; Read the record of the character whose turn it is.
 $A545 LD A,($B6E8)    ; Read the current object.
 $A548 CP (IY+$01)     ; {Jump to #R$9F76 if the character is not inside the
 $A54B JP NZ,$9F76     ; current object.}
 $A54E CALL $9BCA      ; Call #R$9BCA to locate object.
 $A551 CALL $A5CA      ; Call #R$A5CA to test whether the object is open.
 $A554 JP Z,$A16C      ; Jump back to #R$A16C if the object is not open.
 $A557 CALL $9D44      ; Call #R$9D44. If the message is held back, the
                       ; character does not climb out.
 $A55A LD (IY+$01),$FF ; Mark where this object is as unset.
 $A55E RET             ; Return.

; Event: Containers And Scripts
;
; Runs container checks and the character scripts for this turn.
; Reached through the action lists of #OBJECT($13,$01,$01)($), #OBJECT($25,$01,$01)($) and #OBJECT($29,$01,$01)($) for action #N($36), dispatched by #R$9B6C.
@label=EventContainersAndScripts
c$A55F LD IY,($B70C)   ; Read *#R$B70C.
 $A563 LD A,($B6E8)    ; Read *#R$B6E8.
 $A566 CP (IY+$01)     ; {Jump back to #R$9F76 if the current object is where
 $A569 JP Z,$9F76      ; this object is.}
 $A56C LD IY,($B708)   ; Read *#R$B708.
 $A570 CALL $9E34      ; Call #R$9E34 to test whether the object is here.
 $A573 JP Z,$9F76      ; Jump back to #R$9F76 if #R$9E34 did not find the
                       ; object here.
 $A576 LD A,($B6E8)    ; Read *#R$B6E8.
; Find the object's record.
@label=EventContainersAndScripts_Loop
*$A579 CALL $9BCA      ; Call #R$9BCA to locate object.
 $A57C LD A,(IX+$01)   ; Read where this object is from the object record.
 $A57F CP $FF          ; {Jump to #R$A596 if this object is not inside another
 $A581 JR Z,$A596      ; object.}
 $A583 LD A,($B6EA)    ; Read *#R$B6EA.
 $A586 CP (IX+$01)     ; Compare the character whose turn it is with where this
                       ; object is.
 $A589 LD A,(IX+$01)   ; Read where this object is from the object record.
 $A58C JR NZ,$A579     ; Jump back to #R$A579 if the character whose turn it is
                       ; is not where this object is.
 $A58E LD IX,($B708)   ; Read *#R$B708.
 $A592 LD (IX+$01),$FF ; Mark where this object is as unset.
@label=EventContainersAndScripts_TotalTheVolume
*$A596 LD IY,($B70C)   ; Read *#R$B70C.
 $A59A LD A,($B6EA)    ; Read *#R$B6EA.
 $A59D CALL $9CE8      ; Call #R$9CE8 to total the volume inside the character.
 $A5A0 ADD A,(IY+$02)  ; Add the character's volume onto the total from
                       ; #R$9CE8.
 $A5A3 JR C,$A5A7      ; Jump to #R$A5A7 if the sum overflowed, keeping the
                       ; wrapped total.
 $A5A5 LD A,$FF        ; There was no carry, so take #N$FF as the total.
@label=EventContainersAndScripts_TestTheVolume
*$A5A7 LD B,A          ; Copy the result into #REGb.
 $A5A8 LD IX,($B708)   ; Read *#R$B708.
 $A5AC CALL $A5CA      ; Call #R$A5CA to test whether the object is open.
 $A5AF JP Z,$A16C      ; Jump to #R$A16C if the object is not open.
 $A5B2 LD A,(IX+$02)   ; Read the volume from the object record.
 $A5B5 CP $FF          ; {Jump to #R$A5C0 if this object's volume byte is
 $A5B7 JR Z,$A5C0      ; #N$FF.}
 $A5B9 SUB B           ; Subtract #REGb from the object's volume.
 $A5BA LD HL,$B13E     ; Point #REGhl at "You are too big".
 $A5BD JP NC,$72DD     ; Jump to #R$72DD to print it if the object's volume is
                       ; not below #REGb.
; If the message is held back, the container checks are skipped.
@label=EventContainersAndScripts_LetTheMessageThrough
*$A5C0 CALL $9D44      ; Call #R$9D44. If the message is held back, the
                       ; container checks are skipped.
 $A5C3 LD A,($B6E8)    ; Read *#R$B6E8.
 $A5C6 LD (IY+$01),A   ; Update where this object is.
 $A5C9 RET             ; Return.

; Event: Test The Open Flag
;
; Used by the routines at #R$8EEC, #R$9138, #R$93DA, #R$A541 and #R$A55F.
; .
; Tests whether the object is open and returns #N$05. The zero flag is set when the object is not
; open. The bytes after that return belong to later events.
@label=Event_TestTheOpenFlag
c$A5CA BIT 5,(IX+$07) ; Test whether the object is open.
 $A5CE LD A,$05       ; Take #N$05. The open test is left in the flags.
 $A5D0 RET            ; Return.
; If the message is held back, the container test is skipped.
 $A5D1 CALL $9D44     ; Call #R$9D44. If the message is held back, the
                      ; container test is skipped.
 $A5D4 LD HL,$C452    ; Point #REGhl at the location byte at #R$C452.
 $A5D7 LD A,($C12B)   ; {Return if the current location is not that object's
 $A5DA CP (HL)        ; location.
 $A5DB RET NZ         ; }
 $A5DC LD HL,$B085    ; Point at the message "the vicious warg run around you
                      ; and howls." (#R$B085).
 $A5DF JP $97F4       ; Jump back to #R$97F4 to print "the vicious warg run
                      ; around you and howls.".
; Reached through the action list of #OBJECT($0C,$01,$01)($) for action
; #N($00), dispatched by #R$9B6C.
 $A5E2 LD A,($B6E8)   ; Read *#R$B6E8.
 $A5E5 CP $13         ; {Return if the current object is not #N$13.
 $A5E7 RET NZ         ; }
 $A5E8 CALL $97FF     ; Call #R$97FF to let the message through or hold it
                      ; back.
 $A5EB LD IX,$C3EE    ; Point #REGix at #OBJECT($13,$01,$01)($).
 $A5EF LD A,(IX+$10)  ; Read the object's location.
 $A5F2 CP $21         ; {Return if "#TEXTTOKEN($C3EE+$08,$01)" is not at
 $A5F4 RET NZ         ; location #R$BDC1(#N$21) - "#TEXTTOKEN($BDC1+$02,$01)".}
 $A5F5 LD A,$02       ; {Write #N$02 to *#R$CA85.
 $A5F7 LD ($CA85),A   ; }
 $A5FA RET            ; Return.

; Event: The Barrel
;
; Runs for the barrel. When the player is inside it, the player is thrown onto the bank of
; the long lake. The barrel record at #R$CA86 calls this.
@label=Event_TheBarrel
c$A5FB SUB A           ; Clear the flag at #R$B6F0.
 $A5FC LD ($B6F0),A    ; Update *#R$B6F0.
 $A5FF LD A,($C11C)    ; Read where the player is.
 $A602 CP $13          ; Is the player inside object #N($13), i.e. using the
                       ; "#TEXTTOKEN($C3EE+$08,$01)"?
 $A604 LD HL,$B32C     ; Point at the message "you are thrown onto the bank of
                       ; the long lake" (#R$B32C).
 $A607 CALL Z,$72DD    ; Call #R$72DD to print it if the player is inside the
                       ; barrel.
 $A60A LD A,$22        ; {Write #N$22 to *#R$C3FE.
 $A60C LD ($C3FE),A    ; }
 $A60F LD B,A          ; Copy the result into #REGb.
 $A610 LD A,$13        ; Use the barrel, object #N$13.
 $A612 CALL $9BDD      ; Call #R$9BDD to move what is inside the barrel to
                       ; location #N$22.
 $A615 LD IX,$C3EE     ; Point #REGix at #OBJECT($13,$01,$01)($).
 $A619 LD (IX+$10),$20 ; Update the location of the object to location
                       ; #R$BDAD(#N$20) - "#TEXTTOKEN($BDAD+$02,$01)".
 $A61D RES 5,(IX+$07)  ; Close the object.
 $A621 SET 2,(IX+$07)  ; Mark the object full.
 $A625 SUB A           ; Clear the time-of-day flag, then look up object #N$13.
 $A626 LD ($B702),A    ; Update *#R$B702.
 $A629 LD A,$13        ; Look up where object #N$13 is.
 $A62B CALL $9D53      ; Call #R$9D53 to find where the object is.
 $A62E LD A,$01        ; {Write #N$01 (day) to *#R$B702.
 $A630 LD ($B702),A    ; }
 $A633 LD IY,$C418     ; Point #REGiy at #OBJECT($14,$01,$01)($).
 $A637 LD (IY+$10),$20 ; Set the object's location to #N$20.
 $A63B LD (IY+$01),$13 ; Set where this object is to #N$13.
 $A63F RET             ; Return.
 $A640 LD A,($B6F6)    ; Read *#R$B6F6.
 $A643 LD HL,$B6F5     ; {Return if the script location is not where the player
 $A646 CP (HL)         ; starts.
 $A647 RET NZ          ; }
 $A648 LD A,($C122)    ; {Return if the player is visible.
 $A64B BIT 7,A         ;
 $A64D RET NZ          ; }
; If the message is held back, the thief question is not printed.
 $A64E CALL $9D44      ; Call #R$9D44. If the message is held back, the thief
                       ; question is not printed.
 $A651 LD HL,$B0CB     ; Point at the message "where's the thief ?[0x16]"
                       ; (#R$B0CB).
 $A654 JP $A1E3        ; Jump back to #R$A1E3 to print "where's the thief ?".
; If the message is held back, the barrel does not throw the player out.
 $A657 CALL $9D44      ; Call #R$9D44. If the message is held back, the barrel
                       ; does not throw the player out.
 $A65A LD A,$08        ; Roll a random number below #N$08.
; Roll a random number.
 $A65C CALL $9C9F      ; Call #R$9C9F to roll a number from the limit in #REGa.
 $A65F CP $05          ; {Return if the roll is not below #N$05.
 $A661 RET NC          ; }
 $A662 CP $03          ; {Jump back to #R$97F4 if the roll is not below #N$03.
 $A664 LD HL,$B0F4     ;
 $A667 JP NC,$97F4     ; }
 $A66A LD HL,$B0D5     ; {Point #REGhl at #R$B0D5 and jump back to #R$A1E3 if
 $A66D JP Z,$A1E3      ; the roll is #N$03 (never taken: a roll of #N$03 has
                       ; already jumped at #R$A667).}
 $A670 LD HL,$B0E5     ; {Jump back to #R$97F4 when the roll is zero.
 $A673 CP $00          ;
 $A675 JP Z,$97F4      ; }
 $A678 LD HL,$B05B     ; Point at the message "hurry up." (#R$B05B).
 $A67B JP $A1E3        ; Jump back to #R$A1E3 to print "hurry up.".
; Reached through the action list of #OBJECT($0C,$01,$01)($) for actions #N$0C
; and #N($10), dispatched by #R$9B6C.
 $A67E LD IX,($B70C)   ; Read *#R$B70C.
 $A682 LD A,(IX+$10)   ; Read the location from the object record.
 $A685 CP $20          ; {Jump back to #R$72DD if the object's location is not
 $A687 LD HL,$B11B     ; #N$20.
 $A68A JP NZ,$72DD     ; }
; Test the current action.
 $A68D LD A,($B6E7)    ; {Jump to #R$9138 if *#R$B6E7 is #N$0C (close).
 $A690 CP $0C          ;
 $A692 JP Z,$9138      ; }
 $A695 JP $910E        ; Jump to #R$910E to open or close.
; Test the flag.
 $A698 LD A,($C12B)    ; {Jump to #R$A6A6 if *#R$C12B is #N$27.
 $A69B CP $27          ;
 $A69D JR Z,$A6A6      ; }
 $A69F CP $2C          ; {Jump to #R$A6A6 if the current location is #N$2C.
 $A6A1 JR Z,$A6A6      ; }
 $A6A3 CP $29          ; {Return if the current location is not #N$29.
 $A6A5 RET NZ          ; }
; If the message is held back, the location is not changed.
@label=Event_TheBarrel_LetTheMessageThrough
*$A6A6 CALL $9D44      ; Call #R$9D44. If the message is held back, the
                       ; location is not changed.
 $A6A9 LD A,($C12B)    ; Read the current location.
 $A6AC LD HL,$C143     ; Point #REGhl at the location byte at #R$C143.
 $A6AF CP (HL)         ; {Return if the current location is that object's
 $A6B0 RET Z           ; location.}
 $A6B1 LD (HL),A       ; Store it at #R$C143.
 $A6B2 LD A,$01        ; {Write #N$01 (day) to *#R$B702.
 $A6B4 LD ($B702),A    ; }
 $A6B7 LD HL,$C13B     ; Point #REGhl at "#TEXTTOKEN(#PC)".
 $A6BA PUSH HL         ; {Point at the message "[0x00]
 $A6BB LD HL,$B017     ; enter(s|d|ing|es).[0x14]".}
; Print the message at #REGhl.
@label=Event_TheBarrel_PrintMessage
*$A6BE CALL $72DD      ; Call #R$72DD to print message.
 $A6C1 RET             ; Return.
 $A6C2 LD A,($C12B)    ; {Return if the current location is not the script
 $A6C5 LD HL,$B6F6     ; location.
 $A6C8 CP (HL)         ;
 $A6C9 RET NZ          ; }
; If the message is held back, the player's attributes are left alone.
 $A6CA CALL $9D44      ; Call #R$9D44. If the message is held back, the
                       ; player's attributes are left alone.
 $A6CD LD A,($C122)    ; Read the player's attributes.
 $A6D0 AND $80         ; Keep only bit 7.
 $A6D2 LD HL,$B17E     ; Point #REGhl at "the dragon say(s|d|ing|es)".
 $A6D5 JR Z,$A6DA      ; Jump to #R$A6DA if the player is not visible.
 $A6D7 LD HL,$B15D     ; Point #REGhl at "the dragon say(s|d|ing|es)".
@label=Event_TheBarrel_DragonSays
*$A6DA JR $A6BE        ; Jump back to #R$A6BE to print "the dragon
                       ; say(s|d|ing|es)".
 $A6DC LD A,($C5DD)    ; {Return if that object's location is #N$29.
 $A6DF CP $29          ;
 $A6E1 RET Z           ; }
 $A6E2 LD A,($C12B)    ; Read the current location.
; Find the location's record.
 $A6E5 CALL $9BB1      ; Call #R$9BB1 to locate location.
 $A6E8 BIT 7,(IX+$00)  ; {Return if bit 7 of the location attribute is clear.
 $A6EC RET Z           ; }
; If the message is held back, day is not announced.
 $A6ED CALL $9D44      ; Call #R$9D44. If the message is held back, day is not
                       ; announced.
 $A6F0 LD A,$01        ; {Write #N$01 (day) to *#R$B702.
 $A6F2 LD ($B702),A    ; }
 $A6F5 LD HL,$B1A6     ; Point #REGhl at "in the distance you see the shape of
                       ; a monstrous dragon flying after you".
 $A6F8 LD A,$64        ; Take the roll limit #N$64.
; Roll a random number.
 $A6FA CALL $9C9F      ; Call #R$9C9F to roll a number from the limit in #REGa.
 $A6FD CP $50          ; {Jump to #R$A6BE if the roll is below #N$50.
 $A6FF JR C,$A6BE      ; }
; Print the message at #REGhl.
 $A701 LD HL,$B1BA     ; {Point #REGhl at the message and call #R$72DD.
 $A704 CALL $72DD      ; }
 $A707 JP $90D2        ; Jump to #R$90D2 to end the game.
; Find the exit through the current object.
 $A70A CALL $9F25      ; Call #R$9F25 to find the exit through the current
                       ; object.
 $A70D CP $FF          ; {Return if no matching exit was found.
 $A70F RET Z           ; }
 $A710 SUB A           ; Return zero; the exit is cleared below.
 $A711 LD (IX+$00),$00 ; Clear this exit's direction.
 $A715 LD (IX+$01),$00 ; Clear the object this exit goes via.
 $A719 LD (IX+$02),$00 ; Clear this exit's destination.
 $A71D RET             ; Return.
; If the message is held back, the barrel event stops.
; .
; Reached through the action list of #OBJECT($0D,$01,$01)($) for action
; #N($1C), dispatched by #R$9B6C.
 $A71E CALL $9D44      ; Call #R$9D44. If the message is held back, the barrel
                       ; event stops.
 $A721 LD IX,($B70C)   ; Read *#R$B70C.
 $A725 BIT 7,(IX+$07)  ; Test the object's attributes.
 $A729 LD HL,$AFF4     ; Point #REGhl at "You see nothing special here".
 $A72C JP NZ,$72DD     ; Jump back to #R$72DD if the object is visible.
 $A72F LD A,($CAA7)    ; {Copy the magic-door id at #N$CAA7 into the next byte.
 $A732 LD ($CAA8),A    ; }
; Say "The magic door warn(s|d|ing|es) of elves approach(s|d|ing|es)".
 $A735 LD HL,$B2AA     ; {Point #REGhl at the message and call #R$72DD.
 $A738 JP $72DD        ; }
; Reached through the action list of #OBJECT($3F,$01,$01)($) for action
; #N($00), dispatched by #R$9B6C.
 $A73B LD HL,$C3B9     ; {Return if that object is not broken.
 $A73E BIT 3,(HL)      ;
 $A740 RET Z           ; }
 $A741 CALL $97FF      ; Call #R$97FF to let the message through or hold it
                       ; back.
 $A744 LD IX,$C1AD     ; Point #REGix at #OBJECT($02,$01,$01)($).
 $A748 SET 3,(IX+$07)  ; Mark the object broken.
 $A74C LD A,$02        ; Clear the tie on object #N$02.
 $A74E CALL $A18C      ; Call #R$A18C to clear the tie on the object.
 $A751 LD A,$02        ; Pass object id #N$02.
 $A753 LD IY,$C11B     ; Point #REGiy at #OBJECT($00,$01,$01)($).
 $A757 CALL $9E25      ; Call #R$9E25 to swap the objects and test visibility
                       ; again.
 $A75A RET Z           ; Return if the object is not visible.
; Say "the small curious key shatter(s|d|ing|es)".
 $A75B LD HL,$B109     ; {Point #REGhl at the message and call #R$72DD.
 $A75E JP $72DD        ; }
; Test whose turn it is.
; .
; Reached through the action list of #OBJECT($1B,$01,$01)($) for actions #N$0C
; and #N($10), dispatched by #R$9B6C.
 $A761 LD A,($B6EA)    ; {Jump to #R$A776 if *#R$B6EA is not #N$00 (the
 $A764 CP $00          ; player).
 $A766 JR NZ,$A776     ; }
 $A768 LD A,($C11C)    ; Read where the player is.
 $A76B LD HL,$B11B     ; Point #REGhl at "you cannot reach[0x07]".
 $A76E CP $FF          ; {Jump back to #R$72DD if where the player is is #N$FF.
 $A770 JP Z,$72DD      ; }
 $A773 JP $9F76        ; Jump to #R$9F76 to say that will not work.
; Test the current action.
@label=Event_TheBarrel_TestForClose
*$A776 LD A,($B6E7)    ; {Jump to #R$9138 if *#R$B6E7 is #N$0C (close).
 $A779 CP $0C          ;
 $A77B JP Z,$9138      ; }
 $A77E CP $10          ; {Jump back to #R$910E if the current action is #N$10.
 $A780 JP Z,$910E      ; }
 $A783 RET             ; Return.
; Test whose turn it is.
; .
; Reached through the action list of #OBJECT($1B,$01,$01)($) for actions
; #N($0B), #N$18 and #N($1E), dispatched by #R$9B6C.
 $A784 LD A,($B6EA)    ; {Jump to #R$A797 if *#R$B6EA is not #N$00 (the
 $A787 CP $00          ; player).
 $A789 JP NZ,$A797     ; }
 $A78C LD A,($C11C)    ; Read where the player is.
 $A78F CP $FF          ; Compare where the player is with #N$FF.
 $A791 LD HL,$B11B     ; Point #REGhl at "you cannot reach[0x07]".
 $A794 JP Z,$72DD      ; Jump back to #R$72DD if where the player is is #N$FF.
; Test the current action.
@label=Event_TheBarrel_TestTheAction
*$A797 LD A,($B6E7)    ; {Jump to #R$8F3B if *#R$B6E7 is #N$1E.
 $A79A CP $1E          ;
 $A79C JP Z,$8F3B      ; }
 $A79F CP $0B          ; {Jump back to #R$92ED if the current action is #N$0B.
 $A7A1 JP Z,$92ED      ; }
 $A7A4 CP $18          ; {Jump back to #R$8EEC if the current action is #N$18.
 $A7A6 JP Z,$8EEC      ; }
 $A7A9 RET             ; Return.

; Event: The Deep Bog
;
; Prints that you are sinking into the bog, and the bog can be fatal. The deep bog record
; at #R$CAA0 calls this.
;
; .
;
; Test the flag.
@label=Event_TheDeepBog
c$A7AA LD A,($C12B)    ; {Jump to #R$A7B5 if *#R$C12B is not #N$1D.
 $A7AD CP $1D          ;
 $A7AF JR NZ,$A7B5     ; }
 $A7B1 SUB A           ; Clear the byte at #R$CAA1.
 $A7B2 LD ($CAA1),A    ; Store the result at #R$CAA1.
; Say "You are slowly sink(s|d|ing|es) into the bog".
@label=Event_TheDeepBog_PrintTheSinking
*$A7B5 LD HL,$B153     ; {Point #REGhl at the message and call #R$72DD.
 $A7B8 CALL $72DD      ; }
 $A7BB LD A,($CAA1)    ; {Return if the deep bog script is not zero.
 $A7BE CP $00          ;
 $A7C0 RET NZ          ; }
 $A7C1 JP $90D2        ; Jump to #R$90D2 to end the game.
; Test whose turn it is.
; .
; Reached through the action list of #OBJECT($03,$01,$01)($) for action
; #N($1C), dispatched by #R$9B6C.
 $A7C4 LD A,($B6EA)    ; {Jump to #R$93DA if *#R$B6EA is not #N$41.
 $A7C7 CP $41          ;
 $A7C9 JP NZ,$93DA     ; }
; If the message is held back, the sinking message is not printed.
 $A7CC CALL $9D44      ; Call #R$9D44. If the message is held back, the sinking
                       ; message is not printed.
 $A7CF LD IY,$0000     ; Point #REGiy at the extra-exit entry (#R$97CF writes
                       ; this address into #N$A7D1).
 $A7D3 LD L,(IY+$01)   ; Read the low byte of this extra exit's direction
                       ; token.
 $A7D6 LD H,(IY+$02)   ; Read the high byte of this extra exit's direction
                       ; token.
; Test the flag.
 $A7D9 LD A,($B6F1)    ; {Jump to #R$A7EF if *#R$B6F1 is not #N$00.
 $A7DC CP $00          ;
 $A7DE JR NZ,$A7EF     ; }
 $A7E0 LD B,$03        ; Count #N$03 passes.
@label=Event_TheDeepBog_ReadTheExtraByte
*$A7E2 LD A,(IY+$03)   ; Read the next byte of this extra exit.
 $A7E5 LD (HL),A       ; {Store it at #R$B153 and step on.
 $A7E6 INC HL          ; }
 $A7E7 INC IY          ; Step to the next byte of this extra exit.
 $A7E9 DJNZ $A7E2      ; Loop back to #R$A7E2 until #N$03 runs out.
 $A7EB LD IY,($A7D1)   ; Read the extra-exit pointer saved at #N$A7D1.
@label=Event_TheDeepBog_ReadTheDestination
*$A7EF LD A,(IY+$05)   ; Read the destination from this extra exit.
; Find the location's record.
 $A7F2 CALL $9BB1      ; Call #R$9BB1 to locate location.
 $A7F5 INC IX          ; {Step #REGix on to the location's name.
 $A7F7 INC IX          ; }
 $A7F9 PUSH IX         ; {Save the location's name and read the location from
 $A7FB LD A,(IY+$00)   ; this extra exit.}
; Find the location's record.
 $A7FE CALL $9BB1      ; Call #R$9BB1 to locate location.
 $A801 INC IX          ; {Step #REGix on to the location's name.
 $A803 INC IX          ; }
 $A805 PUSH IX         ; {Save that name and read the direction from this extra
 $A807 LD A,(IY+$03)   ; exit.}
 $A80A CALL $A0BA      ; Call #R$A0BA to describe the direction word.
 $A80D PUSH DE         ; {Point #REGhl at "{5} go[0x01] from[0x00] to{5} get
 $A80E LD HL,$B1D0     ; to[0x00]".}
 $A811 JP $A1E3        ; Jump back to #R$A1E3 to print the way from here to
                       ; there.
; Reached through the action list of #OBJECT($12,$01,$01)($) for action
; #N($2B), dispatched by #R$9B6C.
 $A814 LD A,($B6E9)    ; Read *#R$B6E9.
 $A817 CALL $9F28      ; Call #R$9F28 to find the exit through the object in
                       ; #REGa.
 $A81A CP $FF          ; {Jump back to #R$9F76 if no exit runs through this
 $A81C JP Z,$9F76      ; object.}
; If the message is held back, the fatal bog is not described.
 $A81F CALL $9D44      ; Call #R$9D44. If the message is held back, the fatal
                       ; bog is not described.
; Say "it sail(s|d|ing|es) across and.".
 $A822 LD HL,$AF66     ; {Point #REGhl at the message and call #R$72DD.
 $A825 CALL $72DD      ; }
 $A828 LD A,($C62B)    ; {Jump to #R$A84C if the location of
 $A82B CP (IX+$02)     ; #OBJECT($29,$01,$01)($) is not this exit's
 $A82E JR NZ,$A84C     ; destination.}
 $A830 CALL $A86E      ; Call #R$A86E to roll a random half.
 $A833 JR C,$A842      ; Jump to #R$A842 if the roll was below half.
 $A835 LD HL,$AF76     ; Point #REGhl at "fall(s|d|ing|es) just short of the
                       ; other side".
 $A838 CALL $A86E      ; Call #R$A86E to roll a random half.
 $A83B JR C,$A86B      ; Jump to #R$A86B if the roll was below half.
 $A83D LD HL,$AF82     ; Point #REGhl at "[0x0b][0x08] but slide(s|d|ing|es)
                       ; out again".
 $A840 JR $A86B        ; Jump to #R$A86B to print "but slide(s|d|ing|es) out
                       ; again".
@label=Event_TheDeepBog_LandTheRopeInTheBoat
*$A842 LD A,$12        ; {Put the rope (#N$12) into the boat's container at
 $A844 LD ($C61C),A    ; #R$C61C.}
 $A847 LD HL,$AF8B     ; Point #REGhl at "lands in the boat".
 $A84A JR $A86B        ; Jump to #R$A86B to print "lands in the boat".
@label=Event_TheDeepBog_PrintTheShortFall
*$A84C LD HL,$AF76     ; Point #REGhl at "fall(s|d|ing|es) just short of the
                       ; other side".
 $A84F CALL $A86E      ; Call #R$A86E to roll a random half.
 $A852 JR C,$A86B      ; Jump to #R$A86B if #R$A86E rolled below #N$32.
 $A854 LD A,(IX+$02)   ; Read this exit's destination.
 $A857 LD IX,($B708)   ; Read *#R$B708.
 $A85B LD (IX+$10),A   ; Update the object's location.
 $A85E LD (IX+$01),$FF ; Mark where this object is as unset.
 $A862 LD A,($B6E8)    ; Read *#R$B6E8.
 $A865 CALL $9BDD      ; Call #R$9BDD to move what is inside the current object
                       ; to the location in #REGb.
 $A868 LD HL,$AF6D     ; Point #REGhl at "lands on the other side".
@label=Event_TheDeepBog_PrintTheMessage
*$A86B JP $72DD        ; Jump to #R$72DD to print the message at #REGhl.

; Event: A Random Half
;
; Used by the routine at #R$A7AA.
; .
; Rolls a random half. Below #N$32 it returns at once; otherwise the boat may glide across
; the river.
@label=Event_ARandomHalf
c$A86E LD A,$64      ; Take the roll limit #N$64.
; Roll a random number.
 $A870 CALL $9C9F    ; Call #R$9C9F to roll a number from the limit in #REGa.
 $A873 CP $32        ; Compare the roll with #N$32.
 $A875 RET           ; Return.
; If the message is held back, the boat does not sail.
; .
; Reached through the action list of #OBJECT($12,$01,$01)($) for action
; #N($31), dispatched by #R$9B6C.
 $A876 CALL $9D44    ; Call #R$9D44. If the message is held back, the boat does
                     ; not sail.
 $A879 LD A,($C61C)  ; {Return if where that object is is not #N$12.
 $A87C CP $12        ;
 $A87E RET NZ        ; }
 $A87F LD HL,$AF92   ; Point #REGhl at "the boat glides across the river and
                     ; lands on this side".
; Print the message at #REGhl.
@label=Event_ARandomHalf_PrintMessage
*$A882 CALL $72DD    ; Call #R$72DD to print message.
 $A885 LD A,($C62B)  ; {Keep #N($42), and jump to #R$A890 if the boat's
 $A888 CP $42        ; location is not already #N$42.
 $A88A LD A,$42      ;
 $A88C JR NZ,$A890   ; }
 $A88E LD A,$43      ; Take location #N$43 for the boat.
@label=Event_ARandomHalf_MoveTheBoat
*$A890 LD ($C62B),A  ; Store the boat's new location at #R$C62B.
 $A893 LD B,A        ; Copy the result into #REGb.
 $A894 LD A,$FF      ; {Write #N$FF to *#R$C61C.
 $A896 LD ($C61C),A  ; }
 $A899 LD A,$29      ; Take the id of #OBJECT($29,$01,$01)($).
 $A89B JP $9BDD      ; Jump to #R$9BDD to move what is inside object #N$29 to
                     ; the boat's new location.
; Reached through the action list of #OBJECT($29,$01,$01)($) for action
; #N($00), dispatched by #R$9B6C.
 $A89E CALL $97FF    ; Call #R$97FF to let the message through or hold it back.
 $A8A1 LD A,($B6EA)  ; Read *#R$B6EA.
 $A8A4 AND A         ; {Return if it is not the player's turn.
 $A8A5 RET NZ        ; }
 $A8A6 LD HL,$AFA4   ; Point #REGhl at "with a lurch the boat glides across the
                     ; river and[0x02] ngfar".
 $A8A9 JR $A882      ; Jump back to #R$A882 to print "with a lurch the boat
                     ; glides across the river".
 $A8AB LD A,($B6F4)  ; {Return if the slot flag at #R$B6F4 is not #N$01.
 $A8AE CP $01        ;
 $A8B0 RET NZ        ; }
 $A8B1 SUB A         ; Clear the flag at #R$B6F4.
 $A8B2 LD ($B6F4),A  ; Store the result at #R$B6F4.
 $A8B5 INC A         ; Set #REGa to #N$01 for #R$7F1A.
 $A8B6 CALL $7F1A    ; Call #R$7F1A to save the clause and act.
 $A8B9 RET Z         ; Return if #R$7F1A returned with the zero flag set.
 $A8BA SUB A         ; Take zero.
 $A8BB LD ($B6FB),A  ; Clear the message-suppressed flag.
 $A8BE LD A,($B6E6)  ; Read *#R$B6E6.
 $A8C1 LD ($C9E3),A  ; Store the result at #R$C9E3.
 $A8C4 LD BC,($B6E8) ; Read *#R$B6E8.
 $A8C8 LD ($C9E4),BC ; Store #REGbc at #N$C9E4.
 $A8CC LD A,$42      ; {Write #N$42 to #N$C9E2.
 $A8CE LD ($C9E2),A  ; }
 $A8D1 RET           ; Return.
 $A8D2 LD A,($C4C1)  ; {Return if the location of #OBJECT($44,$01,$01)($) is
 $A8D5 LD HL,$B6F5   ; not where the player starts.
 $A8D8 CP (HL)       ;
 $A8D9 RET NZ        ; }
 $A8DA LD HL,$C122   ; {Return if the player is not visible.
 $A8DD BIT 7,(HL)    ;
 $A8DF RET Z         ; }
; If the message is held back, the glide is not started.
 $A8E0 CALL $9D44    ; Call #R$9D44. If the message is held back, the glide is
                     ; not started.
 $A8E3 LD HL,($B6EE) ; Read *#R$B6EE.
 $A8E6 INC HL        ; {Step on through the token held for the printer.
 $A8E7 INC HL        ; }
 $A8E8 LD E,(HL)     ; Read the low byte of the token held for the printer.
 $A8E9 INC HL        ; Step to the next byte of the token held for the printer.
 $A8EA LD D,(HL)     ; Read the high byte of the token held for the printer.
 $A8EB PUSH DE       ; {Call #R$A1E3 to print "You say " and the message.
 $A8EC POP HL        ;
 $A8ED CALL $A1E3    ; }
 $A8F0 LD A,$01      ; {Write #N$01 to *#R$B6F9.
 $A8F2 LD ($B6F9),A  ; }
 $A8F5 RET           ; Return.
; If the message is held back, the random half is not taken.
 $A8F6 CALL $9D44    ; Call #R$9D44. If the message is held back, the random
                     ; half is not taken.
 $A8F9 SUB A         ; Clear the talk flag at #R$B6F9.
 $A8FA LD ($B6F9),A  ; Update *#R$B6F9.
 $A8FD CALL $7F1A    ; Call #R$7F1A to save the clause and act.
 $A900 JR Z,$A915    ; Jump to #R$A915 when #R$7F1A returns with the zero flag
                     ; set.
 $A902 LD BC,$0018   ; Search #N$18 bytes of the clause slot for the riddle
                     ; answer.
 $A905 LD DE,($B6EE) ; Read *#R$B6EE.
 $A909 LD A,(DE)     ; Read the first byte of the riddle answer.
@label=Event_ARandomHalf_SearchForTheRiddleAnswer
*$A90A CPIR          ; Search from #REGhl for this byte of the riddle answer.
 $A90C JR NZ,$A915   ; Jump to #R$A915 if the byte was not found.
 $A90E INC DE        ; {Jump back to #R$A90A unless the next byte of the riddle
 $A90F LD A,(DE)     ; answer matches.
 $A910 DEC DE        ;
 $A911 CP (HL)       ;
 $A912 JR NZ,$A90A   ; }
 $A914 RET           ; Return.
; If the message is held back, day is not set.
@label=Event_ARandomHalf_HoldTheMessage
*$A915 CALL $9D44    ; Call #R$9D44. If the message is held back, day is not
                     ; set.
 $A918 LD A,$01      ; {Set #R$B702 to #N$01 (daytime).
 $A91A LD ($B702),A  ; }
 $A91D LD HL,$B1DB   ; Point at the message "someone strangle(s|d|ing|es) you
                     ; from behind" (#R$B1DB).
 $A920 CALL $72DD    ; Call #R$72DD to print message.
 $A923 JP $90D2      ; Jump back to #R$90D2 to end the game.
 $A926 LD A,($C4C1)  ; {Return if that object's location is not where the
 $A929 LD HL,$B6F5   ; player starts.
 $A92C CP (HL)       ;
 $A92D RET NZ        ; }
; If the message is held back, Gollum's question is not printed.
 $A92E CALL $9D44    ; Call #R$9D44. If the message is held back, Gollum's
                     ; question is not printed.
 $A931 LD HL,$B2D9   ; Point #REGhl at "what has it got in its
                     ; pocket(s|d|ing|es) ?".
 $A934 LD A,$08      ; Roll a random number below #N$08.
; Roll a random number.
 $A936 CALL $9C9F    ; Call #R$9C9F to roll a number from the limit in #REGa.
 $A939 JP NC,$A1E3   ; Jump back to #R$A1E3 unless #R$9C9F negated the roll
                     ; (carry clear).
 $A93C LD IX,$C31A   ; {Jump back to #R$A1E3 if #OBJECT($10,$01,$01)($) is with
 $A940 LD A,$44      ; #N$44.
 $A942 CP (IX+$01)   ;
 $A945 JP Z,$A1E3    ; }
 $A948 LD HL,$B2E7   ; Point #REGhl at "my birthday present".
 $A94B JP $A1E3      ; Jump back to #R$A1E3 to print "my birthday present".
 $A94E LD A,($B6F6)  ; Read *#R$B6F6.
 $A951 LD HL,$B6F5   ; {Return if the script location is not where the player
 $A954 CP (HL)       ; starts.
 $A955 RET NZ        ; }
; If the message is held back, the action code is not stored.
 $A956 CALL $9D44    ; Call #R$9D44. If the message is held back, the action
                     ; code is not stored.
 $A959 LD A,$1B      ; {Write #N$1B to *#R$B6E7.
 $A95B LD ($B6E7),A  ; }
 $A95E LD A,$00      ; {Write #N$00 to *#R$B6E8.
 $A960 LD ($B6E8),A  ; }
 $A963 LD A,$FF      ; {Write #N$FF to *#R$B6E9.
 $A965 LD ($B6E9),A  ; }
; Say that will not work.
 $A968 CALL $9F76    ; Call #R$9F76 to answer with that will not work.
 $A96B CALL $92B5    ; Call #R$92B5 to add #N$0A to the player's strength.
 $A96E JP $90D2      ; Jump to #R$90D2 to end the game.

; Event: Day Dawns On The Trolls
;
; Turns the two trolls to stone, announces day, and repaints Trolls Clearing. A character
; script in #R$C913 calls this through the handler address at #N$CA58.
@label=Event_DayDawnsOnTheTrolls
c$A971 CALL $9D44    ; Call #R$9D44. If the message is held back, the trolls
                     ; are not turned to stone.
 $A974 LD A,$47      ; {Call #R$977F using object #R$C63F(#N$47) -
 $A976 CALL $977F    ; "#TEXTTOKEN($C63F+$08,$01)".}
 $A979 LD A,$48      ; {Call #R$977F using object #R$C651(#N$48) -
 $A97B CALL $977F    ; "#TEXTTOKEN($C651+$08,$01)".}
 $A97E LD HL,$C646   ; Point #REGhl at the attributes of
                     ; #OBJECT($47,$01,$01)($).
 $A981 RES 7,(HL)    ; Mark that object not visible.
 $A983 LD HL,$C658   ; Point #REGhl at the attributes of
                     ; #OBJECT($48,$01,$01)($).
 $A986 RES 7,(HL)    ; Mark that object not visible.
 $A988 LD HL,$B262   ; Point at the message "in a clearing with two stone
                     ; trolls." (#R$B262).
 $A98B LD ($BAC4),HL ; Write #REGhl to #R$BAC4(the empty location description)
                     ; for #R$BABC(#N$05) - "#TEXTTOKEN($BABC+$02,$01)".
 $A98E LD HL,$BABC   ; Point #REGhl at the record for location #N$05 at
                     ; #R$BABC.
 $A991 RES 6,(HL)    ; Clear bit 6 of the attributes for #LOCATION($05) -
                     ; "#LOCATIONNAME($05)".
 $A993 LD A,$47      ; {Call #R$9D53 using object #R$C63F(#N$47) -
 $A995 CALL $9D53    ; "#TEXTTOKEN($C63F+$08,$01)".}
 $A998 LD A,$48      ; {Call #R$9D53 using object #R$C651(#N$48) -
 $A99A CALL $9D53    ; "#TEXTTOKEN($C651+$08,$01)".}
 $A99D LD HL,$B30B   ; Point at the message "day dawn(s|d|ing|es)" (#R$B30B).
 $A9A0 LD A,$01      ; {Set #R$B702 to #N$01 (daytime).
 $A9A2 LD ($B702),A  ; }
 $A9A5 CALL $72DD    ; Call #R$72DD to print message.
 $A9A8 LD IX,$CC00   ; Point #REGix at the location graphics table.
 $A9AC LD A,$05      ; {Load the graphics data for #R$E142 "#LOCATIONNAME$05".
 $A9AE CALL $9DBD    ; }
 $A9B1 LD L,(IX+$01) ; Read the low byte of the graphics address for
                     ; #LOCATION($05) (#R$E142).
 $A9B4 LD H,(IX+$02) ; Read the high byte of the graphics address for
                     ; #LOCATION($05) (#R$E142).
 $A9B7 LD (HL),$05   ; Change the paper colour to #INK$05.
 $A9B9 INC HL        ; Increment the graphics data pointer by one.
 $A9BA LD (HL),$28   ; Change the colour to #COLOUR$28.
 $A9BC RET           ; Return.

; Event: Gollum's Reply
;
; When the player started in Trolls Clearing, prints Gollum's reply. A character script
; in #R$C913 calls this through the handler address at #N$CA3C.
@label=Event_GollumsReply
c$A9BD LD A,($B6F5)  ; Read *#R$B6F5.
 $A9C0 CP $05        ; {Return if where the player starts is not #N$05.
 $A9C2 RET NZ        ; }
; If the message is held back, Gollum's reply is not printed.
 $A9C3 CALL $9D44    ; Call #R$9D44. If the message is held back, Gollum's
                     ; reply is not printed.
 $A9C6 LD A,($B6EA)  ; Read *#R$B6EA.
 $A9C9 LD HL,$B238   ; {Jump to #R$A9D3 if the character whose turn it is is
 $A9CC CP $47        ; #N$47.
 $A9CE JR Z,$A9D3    ; }
 $A9D0 LD HL,$B24C   ; Point #REGhl at #R$B24C.
@label=Event_GollumsReply_PrintGollumReply
*$A9D3 JP $A1E3      ; Jump back to #R$A1E3 to print Gollum's reply.

; Event: Location Twenty-Five
;
; Used by the routine at #R$96B3.
; .
; Runs when that object's location is #N$25. It prints the message at #R$B3D9
; and joins #R$90DF.
@label=Event_LocationTwentyFive
c$A9D6 LD A,($C5CE)  ; {Return if where that object is is not #N$25.
 $A9D9 CP $25        ;
 $A9DB RET NZ        ; }
 $A9DC LD HL,$B3D9   ; Point #REGhl at #R$B3D9.
 $A9DF CALL $72DD    ; Call #R$72DD to print message.
 $A9E2 JP $90DF      ; Jump back to #R$90DF to wait for a key and restart the
                     ; game.

; Event: Give The Lunch
;
; When the script location matches where the player started, gives the lunch (object
; #N$26). A character script in #R$C913 calls this through the handler address at #N$C9A1.
@label=Event_GiveTheLunch
c$A9E5 LD A,($B6F6)    ; Read *#R$B6F6.
 $A9E8 LD HL,$B6F5     ; {Return if the script location is not where the player
 $A9EB CP (HL)         ; starts.
 $A9EC RET NZ          ; }
 $A9ED LD IX,$C663     ; Point #REGix at #OBJECT($26,$01,$01)($).
 $A9F1 LD A,(IX+$10)   ; Read the location from the object record.
 $A9F4 CP $00          ; {Jump to #R$A9FE if the object's location is zero.
 $A9F6 JR Z,$A9FE      ; }
 $A9F8 LD A,$41        ; {Return unless this object is with #N$41.
 $A9FA CP (IX+$01)     ;
 $A9FD RET NZ          ; }
; If the message is held back, the lunch is not given.
@label=Event_GiveTheLunch_HoldTheMessage
*$A9FE CALL $9D44      ; Call #R$9D44. If the message is held back, the lunch
                       ; is not given.
 $AA01 LD A,($B6F6)    ; Read *#R$B6F6.
 $AA04 LD (IX+$10),A   ; Update the object's location.
 $AA07 LD (IX+$01),$41 ; Set where this object is to #N$41.
 $AA0B LD BC,$0026     ; Make #N$26 the current object and #N$00 (the player)
                       ; the second object.
 $AA0E LD ($B6E8),BC   ; Update *#R$B6E8.
 $AA12 LD A,$1D        ; {Write #N$1D (give) to *#R$B6E7.
 $AA14 LD ($B6E7),A    ; }
 $AA17 LD ($B708),IX   ; Update *#R$B708.
 $AA1B LD HL,$C11B     ; {Point *#R$B70A at "#TEXTTOKEN($C11B+$08,$01)".
 $AA1E LD ($B70A),HL   ; }
; Say that will not work.
 $AA21 CALL $9F76      ; Call #R$9F76 to answer with that will not work.
 $AA24 JP $939E        ; Jump to #R$939E to give.
; Reached through the action list of #OBJECT($13,$01,$01)($) for action
; #N($38), dispatched by #R$9B6C.
 $AA27 LD IY,($B708)   ; Read *#R$B708.
 $AA2B LD A,(IY+$10)   ; Read the current object's location.
 $AA2E LD B,A          ; Copy the result into #REGb.
 $AA2F CALL $9F2D      ; Call #R$9F2D to find an exit whose destination is that
                       ; location.
 $AA32 CP $FF          ; Compare the exit search with #N$FF.
 $AA34 LD HL,$B301     ; Point #REGhl at "You cannot jump onto[0x07] from
                       ; here".
 $AA37 JP Z,$72DD      ; Jump back to #R$72DD if no exit leads there.
 $AA3A LD A,(IX+$00)   ; Read this exit's direction.
 $AA3D CP $0A          ; {Jump to #R$B301 if this direction is not down
 $AA3F JP NZ,$B301     ; (#N$0A). #R$B301 is inside the message text, which
                       ; looks like a bug in the original.}
; If the message is held back, the lunch is not handed over.
 $AA42 CALL $9D44      ; Call #R$9D44. If the message is held back, the lunch
                       ; is not handed over.
 $AA45 LD A,($B6E8)    ; Read *#R$B6E8.
 $AA48 LD IX,($B70C)   ; Read *#R$B70C.
 $AA4C LD (IX+$01),A   ; Update where this object is.
 $AA4F CALL $9BDD      ; Call #R$9BDD to move what is inside the current object
                       ; to that location.
 $AA52 LD A,($B6EA)    ; Read *#R$B6EA.
 $AA55 CP $00          ; {Return if it is not the player's turn.
 $AA57 RET NZ          ; }
 $AA58 LD A,B          ; Use the object's location again.
 $AA59 JP $9630        ; Jump back to #R$9630 to locate location.

; Event: The Spider
;
; Clears bits on the spider and stores the token #TOKEN($0623). The spider record at
; #R$CA8D calls this.
@label=Event_TheSpider
c$AA5C LD IX,$C205    ; Point #REGix at #OBJECT($07,$01,$01)($).
 $AA60 RES 3,(IX+$07) ; Mark the spider as not broken (clear bit 3).
 $AA64 RES 5,(IX+$07) ; Close the object.
 $AA68 SLA (IX+$05)   ; Double the strength and keep the overflow.
 $AA6C LD DE,$0623    ; Store the token #TOKEN($0623).
 $AA6F LD ($C20F),DE  ; Store #REGde at #R$C20F.
 $AA73 RET            ; Return.

; Event: The Hole Vanishes
;
; Makes #OBJECT($0B,$01,$01)($) invisible, then at location #N$2A prints that
; the hole vanishes. The hole record at #R$CAC5 calls this.
@label=Event_TheHoleVanishes
c$AA74 LD HL,$C2BC   ; {Return if #OBJECT($0B,$01,$01)($) is open.
 $AA77 BIT 5,(HL)    ;
 $AA79 RET NZ        ; }
 $AA7A LD A,($CAC3)  ; {Store the object's location in the hole script.
 $AA7D LD ($CAC4),A  ; }
 $AA80 LD HL,$C2BC   ; {Make #OBJECT($0B,$01,$01)($) invisible, and return if
 $AA83 RES 7,(HL)    ; the current location is not #N$2A.
 $AA85 LD A,($C12B)  ;
 $AA88 CP $2A        ;
 $AA8A RET NZ        ; }
; This entry point is used by the routine at #R$AAA2.
@label=Event_TheHoleVanishes_PrintTheVanishing
*$AA8B LD HL,$B2A4   ; Point at the message "the hole vanish(s|d|ing|es)[0x15]"
                     ; (#R$B2A4).
 $AA8E JP $72DD      ; Jump back to #R$72DD to print "the hole
                     ; vanish(s|d|ing|es)".

; Event: A Hole Appears
;
; Makes #OBJECT($0B,$01,$01)($) visible, then at location #N$2A prints that a
; hole appears. The hole record at #R$CAC8 calls this.
@label=Event_AHoleAppears
c$AA91 LD HL,$C2BC   ; {Make #OBJECT($0B,$01,$01)($) visible, and return if the
 $AA94 SET 7,(HL)    ; current location is not #N$2A.
 $AA96 LD A,($C12B)  ;
 $AA99 CP $2A        ;
 $AA9B RET NZ        ; }
 $AA9C LD HL,$B277   ; Point #REGhl at #R$B277.
 $AA9F JP $72DD      ; Jump back to #R$72DD to print "there is a loud crack and
                     ; a hole appears".

; Event: Close The Hole
;
; Writes the hole script and then says the hole vanishes. An object record at #N$C2CB
; calls this.
; Reached through the action list of #OBJECT($0B,$01,$01)($) for action #N($00), dispatched by #R$9B6C.
@label=Event_CloseTheHole
c$AAA2 CALL $97FF    ; Call #R$97FF to let the message through or hold it back.
 $AAA5 LD A,$06      ; {Write #N$06 to *#R$CAC4.
 $AAA7 LD ($CAC4),A  ; }
 $AAAA LD HL,$C2BC   ; Point #REGhl at #R$C2BC.
 $AAAD SET 0,(HL)    ; Mark that object locked.
 $AAAF RES 7,(HL)    ; Mark that object not visible.
 $AAB1 JR $AA8B      ; Jump back to #R$AA8B to print "the hole
                     ; vanish(s|d|ing|es)".

; Event: Open The Magic Door
;
; Opens the magic door and an elf sweeps past. The magic door record at #R$CAAC calls
; this.
@label=Event_OpenTheMagicDoor
c$AAB3 LD HL,$C388   ; Point #REGhl at #R$C388.
 $AAB6 SET 5,(HL)    ; Mark that object open.
 $AAB8 LD HL,$B037   ; Point at the message "the magic door
                     ; open(s|d|ing|es).[0x14]" (#R$B037).
 $AABB CALL $AAC7    ; Call #R$AAC7 to print the lake or the river.
 $AABE LD HL,$B113   ; Point #REGhl at "an elf sweeps past".
 $AAC1 CALL $AAC7    ; Call #R$AAC7 to print the lake or the river.
 $AAC4 JP $AAE0      ; Jump to #R$AAE0 to handle the ring.

; Event: The Lake Or The River
;
; Used by the routines at #R$AAB3 and #R$AAD5.
; .
; Prints the lake or the river message when the current location is #N$1E or #N$1C. Any
; other location returns at once.
;
; .
;
; Test the flag.
@label=Event_TheLakeOrTheRiver
c$AAC7 LD A,($C12B)  ; {Jump to #R$72DD if *#R$C12B is #N$1E.
 $AACA CP $1E        ;
 $AACC JP Z,$72DD    ; }
 $AACF CP $1C        ; {Jump back to #R$72DD if the current location is #N$1C.
 $AAD1 JP Z,$72DD    ; }
 $AAD4 RET           ; Return.

; Event: Close The Magic Door
;
; Closes the magic door. The magic door record at #R$CAA9 calls this.
@label=Event_CloseTheMagicDoor
c$AAD5 LD HL,$C388   ; Point #REGhl at #R$C388.
 $AAD8 RES 5,(HL)    ; Close that object.
 $AADA LD HL,$B03F   ; Point at the message "the magic door
                     ; close(s|d|ing|es).[0x14]" (#R$B03F).
 $AADD JP $AAC7      ; Jump to #R$AAC7 to print it at #LOCATION($1E) or
                     ; #LOCATION($1C).

; Event: The Ring
;
; Used by the routine at #R$AAB3.
; .
; Handles the ring (object #N$10) when it is visible. The ring record at #R$CAB0 calls
; this.
@label=Event_TheRing
c$AAE0 LD IX,$C31A    ; Point #REGix at #OBJECT($10,$01,$01)($).
 $AAE4 LD A,(IX+$01)  ; Read where this object is from the object record.
 $AAE7 CP $FF         ; {Return if this object is not inside anything.
 $AAE9 RET Z          ; }
; Find the object's record.
 $AAEA CALL $9BCA     ; Call #R$9BCA to locate object.
 $AAED LD ($B70C),IX  ; Update *#R$B70C.
 $AAF1 BIT 7,(IX+$07) ; {Jump back to #R$A3BC if the character is invisible
 $AAF5 JP Z,$A3BC     ; (wearing the ring).}
 $AAF8 RET            ; Return.
; Reached through the action list of #OBJECT($14,$01,$01)($) for action
; #N($00), dispatched by #R$9B6C.
 $AAF9 LD A,($B6EA)   ; Read *#R$B6EA.
 $AAFC CP $00         ; {Return if it is not the player's turn.
 $AAFE RET NZ         ; }
 $AAFF LD A,$01       ; {Write #N$01 to *#R$B700.
 $AB01 LD ($B700),A   ; }
 $AB04 LD A,($CAB5)   ; {Copy the byte at #R$CAB5 into the next byte.
 $AB07 LD ($CAB6),A   ; }
 $AB0A RET            ; Return.

; Event: Clear The Flag
;
; Clears #R$B700, the flag that makes S type an F as well. The record at #R$CAB5 calls
; this.
@label=Event_ClearTheFlag
c$AB0B SUB A         ; Clear the flag at #R$B700.
 $AB0C LD ($B700),A  ; Update *#R$B700.
 $AB0F RET           ; Return.

; Event: The Web Smothers You
;
; At location #N($1A), prints that the spider web is smothering you. The web record at
; #R$CA94 calls this.
@label=Event_TheWebSmothersYou
c$AB10 LD A,($C12B)  ; {Return if the current location is not #N$1A.
 $AB13 CP $1A        ;
 $AB15 RET NZ        ; }
 $AB16 LD HL,$B0FD   ; Point at the message "the spider web is slowly
                     ; smothering you." (#R$B0FD).
 $AB19 CALL $72DD    ; Call #R$72DD to print message.
 $AB1C JP $90D2      ; Jump back to #R$90D2 to end the game.

; Event: Drops From Above
;
; Prints the forest warning and can sting the player. The forest record at #R$CAC1 calls
; this.
@label=Event_DropsFromAbove
c$AB1F LD HL,$B311   ; Point #REGhl at #R$B311.
 $AB22 CALL $72DD    ; Call #R$72DD to print message.
 $AB25 LD A,($C12B)  ; {Return if the current location is the one saved at
 $AB28 LD C,A        ; #R$B6F3.
 $AB29 LD HL,$B6F3   ;
 $AB2C CP (HL)       ;
 $AB2D RET Z         ; }
 $AB2E LD B,(HL)     ; Read a byte from the pointer into #REGb.
 $AB2F LD A,$02      ; {Take #N($02), and jump to #R$AB36 unless *#R$B6F3 is
 $AB31 CP B          ; #N$02.
 $AB32 JR NZ,$AB36   ; }
 $AB34 LD A,$03      ; Take #N$03.
@label=Event_DropsFromAbove_ReturnIfThisIsTheLocation
*$AB36 CP C          ; {Return if the current location is the one in #REGa.
 $AB37 RET Z         ; }
 $AB38 JR $AB4A      ; Jump to #R$AB4A to print "some thing drop(s|d|ing|es)
                     ; from above and sting(s|d|ing|es)".

; Event: Stung From Above
;
; In the forest, prints that something drops from above and stings. The forest record at
; #R$CABE calls this.
;
; .
;
; Test the flag.
@label=Event_StungFromAbove
c$AB3A LD A,($C12B)  ; {Jump to #R$AB44 if *#R$C12B is #N$02.
 $AB3D CP $02        ;
 $AB3F JR Z,$AB44    ; }
 $AB41 CP $03        ; {Return if the current location is not #N$03.
 $AB43 RET NZ        ; }
@label=Event_StungFromAbove_PointAtThePaleEyesMessage
*$AB44 LD HL,$B311   ; Point #REGhl at #R$B311.
 $AB47 CALL $72DD    ; Call #R$72DD to print message.
; This entry point is used by the routine at #R$AB1F.
@label=Event_StungFromAbove_PrintAndEnd
*$AB4A LD HL,$B31F   ; Point #REGhl at #R$B31F.
 $AB4D CALL $72DD    ; Call #R$72DD to print message.
 $AB50 JP $90D2      ; Jump back to #R$90D2 to end the game.

