; End of table.
 $C7A3 DEFB $FF      ; #TERMINATOR

; Event: #LOCATIONNAME($16)
;
; Runs this place's special event when a character's script reaches
; it.
; Reached through the event table at #R$C78E, dispatched by #R$8D9D.
;
; .
;
; At the start of the game, the #TEXTTOKEN($C430 + $08, $01) is invisible (!) and only becomes visible after
; entering #LOCATIONNAME($16).
@label=EventBeornsHouse
c$C7A4 LD HL,$C437   ; Point #REGhl at the attributes of
                     ; #OBJECT($42,$01,$01)($).
 $C7A7 BIT 3,(HL)    ; {Return if the "#TEXTTOKEN($C430 + $08, $01)" is
 $C7A9 RET NZ        ; "broken" (bit 3 is set).}
 $C7AA LD A,$42      ; {Write #N$42 to #R$CAE7.
 $C7AC LD ($CAE7),A  ; }
 $C7AF SET 7,(HL)    ; Set "visible" bit for "#TEXTTOKEN($C430 + $08, $01)".
 $C7B1 RET           ; Return.

; Event: #LOCATIONNAME($1A)
;
; Runs this place's special event when a character's script reaches
; it.
; Reached through the event table at #R$C78E, dispatched by #R$8D9D.
@label=EventSpiderThreadsPlace
c$C7B2 LD A,($CA92)  ; {Copy #R$CA92 to #R$CA93.
 $C7B5 LD ($CA93),A  ; }
 $C7B8 RET           ; Return.

; Event: #LOCATIONNAME($1D)
;
; Runs this place's special event when a character's script reaches
; it.
; Reached through the event table at #R$C78E, dispatched by #R$8D9D.
@label=EventDeepBog
c$C7B9 LD A,($CAA0)  ; {Copy #R$CAA0 to #R$CAA1.
 $C7BC LD ($CAA1),A  ; }
 $C7BF RET           ; Return.

; Event: #LOCATIONNAME($20)
;
; Runs this place's special event when a character's script reaches
; it.
; Reached through the event table at #R$C78E, dispatched by #R$8D9D.
@label=EventElvenkingsCellar
c$C7C0 LD A,$03      ; {Write #N$03 to #R$CAC4.
 $C7C2 LD ($CAC4),A  ; }
 $C7C5 LD HL,$C13A   ; Point #REGhl at the attributes of
                     ; #OBJECT($3C,$01,$01)($).
 $C7C8 BIT 3,(HL)    ; {Jump to #R$C7D1 if "#TEXTTOKEN($C133 + $08, $01)" is
 $C7CA JR NZ,$C7D1   ; "broken" (bit 3 is set).}
 $C7CC LD A,$3C      ; {Write #N$3C to #R$CB03.
 $C7CE LD ($CB03),A  ; }
@label=EventElvenkingsCellar_Skip
*$C7D1 LD HL,$C4CA   ; Point #REGhl at the attributes of
                     ; #OBJECT($46,$01,$01)($).
 $C7D4 BIT 3,(HL)    ; {Return if the "#TEXTTOKEN($C4C3 + $08, $01)" is
 $C7D6 RET NZ        ; "broken" (bit 3 is set).}
 $C7D7 LD A,$46      ; {Write #N$46 to #R$CAFC.
 $C7D9 LD ($CAFC),A  ; }
 $C7DC RET           ; Return.

; Event: #LOCATIONNAME($03)
;
; Runs this place's special event when a character's script reaches
; it.
; Reached through the event table at #R$C78E, dispatched by #R$8D9D.
@label=EventForest
c$C7DD LD A,($8D9B)  ; {Copy #R$8D9B to #R$B6F3.
 $C7E0 LD ($B6F3),A  ; }
 $C7E3 LD A,($CABC)  ; {Copy #R$CABC to #R$CABD.
 $C7E6 LD ($CABD),A  ; }
 $C7E9 RET           ; Return.

; Event: #LOCATIONNAME($21)
;
; Runs this place's special event when a character's script reaches
; it.
; Reached through the event table at #R$C78E, dispatched by #R$8D9D.
;
; .
;
; Is Player Protected in "#TEXTTOKEN($C3EE + $08, $01)"
@label=EventForestriver
c$C7EA LD A,($C11C)  ; {Return if the player's mother object is
 $C7ED CP $13        ; #OBJECT($13,$01,$01)($).
 $C7EF RET Z         ; }
; Uh oh... you dead.
 $C7F0 CALL $8E39    ; Call #R$8E39 to score this location when it is light.
 $C7F3 LD HL,$B26D   ; Point at the message "You are swept forcefully against
                     ; the portcullis" (#R$B26D).
 $C7F6 CALL $72DD    ; Call #R$72DD to print message.
 $C7F9 JP $90D2      ; Jump back to #R$90D2 to end the game.

