*$8EC4 XOR A          ; Return zero.
 $8EC5 RET            ; Return.
@label=Action_CheckTheObjectFlags_ReturnFlagValueThree
*$8EC6 LD A,$03       ; The flag value to return is #N$03.
 $8EC8 AND A          ; Set the flags from #N$03. The zero flag is clear.
 $8EC9 RET            ; Return.
@label=Action_CheckTheObjectFlags_ReturnFlagValueTwo
*$8ECA LD A,$02       ; The flag value to return is #N$02.
 $8ECC AND A          ; Set the flags from #N$02. The zero flag is clear.
