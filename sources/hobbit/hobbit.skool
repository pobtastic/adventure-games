@label=KeyboardMapUnshifted
b$8BFB DEFB $00,$5A,$58,$43,$56 ; #FOR$00,$04||n|#IF(#PEEK(#PC+n)>$00)(#CHR(#PEEK(#PC+n)),--)|,
                                ; ||
 $8C00 DEFB $41,$53,$44,$46,$47 ; #FOR$00,$04||n|#IF(#PEEK(#PC+n)>$00)(#CHR(#PEEK(#PC+n)),--)|,
