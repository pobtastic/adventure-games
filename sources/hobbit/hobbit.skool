@start=$6C00
@expand=#DEF(#COLOUR(id) #LET(ink=$id&$07)#IF({ink}>=$00)(INK:#HTML(&#10;)#MAP({ink})(#HTML(&#10;)UNKNOWN,0:BLACK,1:BLUE,2:RED,3:MAGENTA,4:GREEN,5:CYAN,6:YELLOW,7:WHITE)),#HTML(&#10;)#LET(paper=$id>>$03&$07)#IF({paper}>=$00)(PAPER:#HTML(&#10;)#MAP({paper})(#HTML(&#10;)UNKNOWN,0:BLACK,1:BLUE,2:RED,3:MAGENTA,4:GREEN,5:CYAN,6:YELLOW,7:WHITE))#HTML(&#10;)#LET(bright=$id&$40)#IF({bright}>$00)((BRIGHT))#HTML(&#10;)#LET(flash=$id&$80)#IF({flash}>$00)(FLASH: ON))
@expand=#DEF(#INK(id) #LET(bright=$id&$40)#HTML(&#10;)#LET(flash=$id&$80)#HTML(&#10;)#LET(ink=$id&$07)#IF({ink}>=$00)(#HTML(&#10;)#MAP({ink})(#HTML(&#10;)UNKNOWN,0:BLACK,1:BLUE,2:RED,3:MAGENTA,4:GREEN,5:CYAN,6:YELLOW,7:WHITE))#IF({bright}>$00)( (BRIGHT))#IF({flash}>$00)( (FLASH: ON)))
@expand=#DEF(#LOCATION(id) #LET(addr=$B9E0+$id*$02) #R(#PEEK({addr})+#PEEK({addr}+$01)*$100)(#N($id)))
@expand=#DEF(#ACTION #MAP(#PEEK(#PC))(?,$00:None,$01:North,$02:South,$03:East,$04:West,$05:Northeast,$06:Northwest,$07:Southeast,$08:Southwest,$09:Up,$0A:Down,$0B:Strike with,$0C:Close,$0D:Drop,$0F:Attack,$10:Open,$11:Put in,$12:Put on,$13:Take,$14:Take out of,$15:Take from,$16:Take off,$17:Look,$1A:Inventory,$1C:Examine,$1D:Give To,$1F:Enter,$20:Go Into,$24:Run,$27:Follow,$2A:Throw At,$2D:Burn,$2E:Tie To,$30:Capture,$33:Untie,$35:Talk To,$37:Climb Out Of,$3A:Shoot,$3B:Carry))
@expand=#DEF(#MOVEMENT(address) #TABLE(default,centre,centre,centre) { =h Direction | =h Via | =h Destination } { #MAP(#PEEK($address))(?,$01:N,$02:S,$03:E,$04:W,$05:NE,$06:NW,$07:SE,$08:SW,$09:UP,$0A:DN) | #IF(#PEEK($address+$01) > $00)(#OBJECT(#PEEK($address+$01), $01, $01)($),---) | #LOCATION(#PEEK($address+$02)) - "#LOCATIONNAME(#PEEK($address+$02))" } TABLE#)
@expand=#DEF(#DRAWLINE Draw a line #MAP(#PEEK(#PC)&$07)(?,$00:right rising,$01:up rightward,$02:right falling,$03:down rightward,$04:left rising,$05:up leftward,$06:left falling,$07:down leftward) #N((#PEEK(#PC+$01)&$3F)+1) pixels, stepping the other axis every #N((((#PEEK(#PC)&$78)>>1)+((#PEEK(#PC+$01)&$C0)>>6))+1) pixel(s).)
@expand=#DEF(#DRAWMOVE Move to X: #N(#PEEK(#PC+$01))/ Y: #N(#PEEK(#PC+$02)).)
@expand=#DEF(#DRAWFILL Fill at X: #N(#PEEK(#PC+$01))/ Y: #N(#PEEK(#PC+$02)) with ink #MAP(#PEEK(#PC)&$07)(?,$00:BLACK,$01:BLUE,$02:RED,$03:MAGENTA,$04:GREEN,$05:CYAN,$06:YELLOW,$07:WHITE).)
@expand=#DEF(#DRAWBORDER Border: #INK(#PEEK(#PC)). Colours: #COLOUR(#PEEK(#PC+$01)).)
@expand=#DEF(#DRAWPAINT Paint background at attribute buffer location #N((#PEEK(#PC+$01)*$100+#PEEK(#PC+$02))), colour #COLOUR(#PEEK(#PC)).)
@expand=#DEF(#DRAWSTOP Paint terminator.)
@expand=#DEF(#DRAWFORMAT Drawing commands for this location, read by #R$7F78. The first byte is the border colour and the second is the paper and ink. #N$00 ends the list. #N$08 followed by X and Y moves the pen. A byte with bit 7 set draws a line: bits 0-2 are the direction, and the next byte holds the length and the step, then #R$8151 plots it. A byte with bit 6 set and bit 7 clear is a fill: bits 0-2 are the colour and the next two bytes are the point #R$8071 floods from. A byte with bit 5 set and bits 6 and 7 clear paints attributes: bits 0-2 are the colour, the next two bytes are an attribute address, and the following bytes run until #N$FF. Any other byte below #N$20 is skipped. A dark location is drawn in black.)
@expand=#DEF(#TERMINATOR Termination character (#N(#PEEK(#PC), $02, $03, $01, $01)($)).)
@expand=#DEF(#WORDPTR #R(#EVAL($6000+((#PEEK(#PC)+#PEEK(#PC+$01)*$100)&$0FFF)))(#TOKEN((#PEEK(#PC)+#PEEK(#PC+$01)*$100)&$0FFF)))
@expand=#DEF(#OBJCOUNT Appears in the game #PEEK(#PC) #IF(#PEEK(#PC)>1)(times,time).)
@expand=#DEF(#OBJMOTHER Mother object (#OBJECT(#PEEK(#PC), $01, $01)($)).)
@expand=#DEF(#OBJVOLUME Volume (?))
@expand=#DEF(#OBJMASS Mass (?))
@expand=#DEF(#OBJFLAGS Second flag byte. #R$9154 tests bit 4 and #R$8E98 tests bit 7.)
@expand=#DEF(#OBJSTRENGTH Strength (?))
@expand=#DEF(#OBJCOMBAT Combat byte read with the strength at #R$91BB and adjusted beside it.)
@expand=#DEF(#OBJNAME Object Name: "#TEXTTOKEN(#PC)".)
@expand=#DEF(#OBJATTRS Attributes: #TABLE(default,centre,centre,centre,centre,centre,centre,centre,centre) { =h Visible | =h Animal | =h Open | =h Gives Light | =h Broken | =h Full | =h Fluid | =h Locked } { #FOR($07,$00,-$01)(x,#IF(#PEEK(#PC)&$01<<x)(yes,no), | ) } TABLE#)
