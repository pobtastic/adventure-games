; Flags: Game State
;
; Variables read and written by the turn loop, the Inglish matcher and the
; message printer. A saved game starts at #R$B6EB. The word at the start is
; read by #R$6CEC, #R$6E97, #R$77B9 and #R$7873.
b$B6DA DEFW $0000                           ; Start of the unknown word.
                                            ; #R$6DAD reads it while quoting
                                            ; the unknown word.
 $B6DC DEFW $0000                           ; Pointer into the token buffer.
                                            ; #R$6D8D stores #R$709C here, and
                                            ; the matcher saves and restores
                                            ; it.
 $B6DE DEFB $00                             ; High byte of the class being
                                            ; matched being matched. Compared
                                            ; with #N$C0 and #N$A0.
 $B6DF DEFB $00                             ; Low byte kept with the class
                                            ; being matched at #R$B6DE.
 $B6E0 DEFB $00,$00,$00,$00,$00,$00         ; Six bytes copied out of the match
                                            ; by #R$7C86.
 $B6E6 DEFB $00                             ; Scratch byte beside the match.
@label=CurrentAction
 $B6E7 DEFB $00                             ; Current action id. The verb
                                            ; routines store the verb here
                                            ; before it runs.
@label=CurrentObject
 $B6E8 DEFB $00                             ; Current object id. The noun the
                                            ; command names.
 $B6E9 DEFB $00                             ; Second object id, used by give,
                                            ; attack and message code #N$09.
@label=CurrentCharacter
 $B6EA DEFB $00                             ; Character whose turn it is. #N$00
                                            ; is the player. Stored in the
                                            ; saved game.
 $B6EB DEFB $00,$00,$00                     ; First three bytes of the saved
                                            ; game. #R$6C14 copies them to
                                            ; #R$5F00 and #R$6C52 copies them
                                            ; back.
 $B6EE DEFW $0000                           ; Word address held for the
                                            ; printer.
 $B6F0 DEFB $00                             ; Cleared at the start of #R$96B3,
                                            ; before the other characters run.
 $B6F1 DEFB $00                             ; Scratch byte beside #R$B6F0.
 $B6F2 DEFB $00                             ; Printer on. #R$8B22 returns at
                                            ; once when this is zero.
                                            ; #TOKEN($04FB) at #R$82A5 sets it
                                            ; and #TOKEN($0479) at #R$82AF
                                            ; clears it.
 $B6F3 DEFB $00                             ; A location id, copied from
                                            ; #R$8D9B by #R$C7DD. #R$AB25
                                            ; compares it with the current
                                            ; location.
 $B6F4 DEFB $00                             ; Slot flag. #R$987C stores #N$01
                                            ; when the character slot was
                                            ; found.
 $B6F5 DEFB $00                             ; Where the player starts. #R$9B02
                                            ; writes it.
 $B6F6 DEFB $00                             ; Location the script at #R$A6C2
                                            ; compares with the player's
                                            ; location.
@label=PercentageComplete
 $B6F7 DEFW $0000                           ; Percentage complete. #R$83EF
                                            ; prints it when the game is over.
 $B6F9 DEFB $00                             ; Talk flag. #R$9034 treats zero as
                                            ; a character who still has
                                            ; something to say.
 $B6FA DEFB $00                             ; Message gate. #R$72DD skips its
                                            ; setup when this is not zero. Set
                                            ; to #N$01 when a game starts.
 $B6FB DEFB $00                             ; Message suppressed. Non-zero when
                                            ; #R$9D44 holds a message back and
                                            ; returns past its caller. #R$72DD
                                            ; writes #N$00 here when a message
                                            ; is printed. #R$7D10 keeps running
                                            ; the action while this is zero.
 $B6FC DEFW $0000                           ; Weapon-name token. #R$9188 stores
                                            ; #TOKEN($026B) or the named
                                            ; object's name, and message code
                                            ; #N$03 at #R$738D returns it.
 $B6FE DEFB $00                             ; Tested by #R$7CD1 and by message
                                            ; code #N$09.
 $B6FF DEFB $00                             ; Tested by message code #N$09 at
                                            ; #R$73C7.
 $B700 DEFB $00                             ; When this is not zero, #R$858B
                                            ; watches for S and types an F as
                                            ; well. Cleared when a game starts.
@label=WaitCountdown
 $B701 DEFB $00                             ; #N$01=action countdown,
                                            ; #N$00=countdown finished.
@label=NightDay
 $B702 DEFB $00                             ; #N$00=night, #N$01=day.
 $B703 DEFB $00                             ; Which noun the printer is naming.
                                            ; The message codes write #N$00 or
                                            ; #N$01.
 $B704 DEFB $00                             ; Capitalise the next letter. A
                                            ; carriage return at #R$86CC sets
                                            ; it, a full stop at #R$8744 bumps
                                            ; it, and #R$873E clears it once a
                                            ; letter has been printed in upper
                                            ; case. #R$72C9 clears it after a
                                            ; printed carriage return.
 $B705 DEFB $00                             ; Set by #R$6D13 before a line is
                                            ; read, and cleared by #R$75F6.
 $B706 DEFB $FF                             ; #N$FF selects the replay path in
                                            ; #R$6CEC. The matcher also stores
                                            ; a class byte here.
 $B707 DEFB $00                             ; Picture switch. #R$6C7C stores
                                            ; bit 3 of port #N($7F), read while
                                            ; N is held. #R$7F78 draws nothing
                                            ; when this is zero.
 $B708 DEFB $00,$00                         ; Pointer to the current object's
                                            ; record (#R$B6E8).
 $B70A DEFW $0000                           ; Pointer to the second object's
                                            ; record (#R$B6E9).
@label=Pointer_CurrentCharacter
 $B70C DEFW $C11B                           ; Pointer to the character whose
                                            ; turn it is. A new game leaves it
                                            ; at #R$C11B, the player.
@label=RandomSeed
 $B70E DEFB $00                             ; Random seed, taken from the
                                            ; refresh register at #R$6CA7.
 $B70F DEFB $00                             ; Byte beside the random seed.
 $B710 DEFB $00                             ; Kind filter read by #R$9DD9:
                                            ; #N$00 not a live animal, #N$01 a
                                            ; live animal, #N$02 anything.
                                            ; #R$7D2E stores the low two bits
                                            ; of the clause and #R$7E0C stores
                                            ; #N$02.
 $B711 DEFB $00                             ; Byte beside #R$B710.
@label=RandomCounter
 $B712 DEFW $0000                           ; Random counter.
 $B714 DEFW $0000                           ; Delay. #R$6DD6 starts it at
                                            ; #N($0BB8,$04) and #R$7285 stores
                                            ; the next wait here.
 $B716 DEFB $00                             ; How many words will be accepted.
                                            ; #R$6CEC writes #N$11 and #R$6D18
                                            ; writes #N$09.
 $B717 DEFW $0000                           ; Scratch word beside the limit on
                                            ; how many words are accepted.
 $B719 DEFB $00                             ; Matcher phase. #R$82C4 sets
                                            ; #N($02), and #R$76F2 compares it
                                            ; with #N$02.
 $B71A DEFB $00                             ; Cleared when a game starts.
                                            ; #R$7574 takes another path when
                                            ; it is not zero.
 $B71B DEFB $00                             ; Conjunction count. #R$6D42 raises
                                            ; it, and #R$72D3 opens the message
                                            ; gate when it is set.
 $B71C DEFB $00                             ; Scratch byte. #R$7C06 clears it
                                            ; before a phrase is resolved.
 $B71D DEFB $00                             ; Scratch byte read at #R$7C5E
                                            ; while a phrase is resolved.
 $B71E DEFB $00                             ; Packed action scores. #R$70F3
                                            ; writes this byte, and the matcher
                                            ; reads it.
 $B71F DEFB $73,$00,$00,$00,$65,$73,$00,$00 ; {Verb endings read by #R$7519 in
 $B727 DEFB $69,$65,$73,$00,$08,$69,$65,$73 ; #R$74C1. Four bytes each: "s",
 $B72F DEFB $64,$00,$00,$00,$69,$6E,$67,$00 ; "es", "ies", a backspace and
                                            ; "ies", "d" and "ing". Copying one
                                            ; onto a stem turns "take" into
                                            ; "Thorin takes".}
 $B737 DEFB $00                             ; How many character slots #R$7EBA
