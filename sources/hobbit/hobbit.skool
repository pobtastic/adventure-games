; Find the object's record.
 $8ED4 CALL $9BCA     ;
@label=Action_LocateAndFollow_Direction_Loop
*$8ED7 LD A,(IX+$01)  ; Read where this object is from the object record.
 $8EDA CP $FF         ; {Jump to #R$8EE9 if this object is not inside another
 $8EDC JR Z,$8EE9     ; object.}
; Find the object's record.
 $8EDE CALL $9BCA     ; Call #R$9BCA to locate object.
 $8EE1 BIT 5,(IX+$07) ; {Jump back to #R$8ED7 if the object is open.
 $8EE5 JR NZ,$8ED7    ; }
 $8EE7 OR $01         ; Clear the zero flag.
@label=Action_LocateAndFollow_PopTheRecord
*$8EE9 POP IX         ; Restore #REGix from the stack.
 $8EEB RET            ; Return.

; Action: Carry On With The Object
;
; Used by the routine at #R$A5FB.
; .
; Carries on with the current object. An open object is followed, and a passage whose
; volume is zero is refused.
; Reached through the action lists of #OBJECT($01,$01,$01)($), #OBJECT($05,$01,$01)($), #OBJECT($06,$01,$01)($), #OBJECT($08,$01,$01)($), #OBJECT($0A,$01,$01)($), #OBJECT($0B,$01,$01)($), #OBJECT($0C,$01,$01)($), #OBJECT($0D,$01,$01)($) and #OBJECT($11,$01,$01)($) for action #N($18), dispatched by #R$9B6C.
@label=Action_CarryOnWithTheObject
c$8EEC LD A,($B6E8)   ; Read *#R$B6E8.
; Find the object's record.
 $8EEF CALL $9BCA     ; Call #R$9BCA to locate object.
 $8EF2 CALL $A5CA     ; Call #R$A5CA to test whether the object is open.
 $8EF5 JP Z,$A16C     ; Jump to #R$A16C if the object is not open.
; Reached through the action lists of #OBJECT($09,$01,$01)($) and
; #OBJECT($2A,$01,$01)($) for action #N($19), dispatched by #R$9B6C.
 $8EF8 LD A,($B6EA)   ; Read *#R$B6EA.
 $8EFB CALL $8ED2     ; Call #R$8ED2 to find where the object is.
 $8EFE RET NZ         ; Return if #R$8ED2 stopped inside a closed object.
; Find the exit through the current object.
 $8EFF CALL $9F25     ; Call #R$9F25 to find the exit through the current
                      ; object.
 $8F02 CP $FF         ; {Jump to #R$9F76 if #R$9F25 found no exit through the
 $8F04 JP Z,$9F76     ; current object.}
 $8F07 LD A,(IX+$02)  ; Read this exit's destination.
 $8F0A CP $00         ; {Jump to #R$9F76 if this exit's destination is zero.
 $8F0C JP Z,$9F76     ; }
; If the message is held back, the object is not followed.
 $8F0F CALL $9D44     ; Call #R$9D44. If the message is held back, the object
                      ; is not followed.
 $8F12 PUSH IX        ; Call #R$9BB1 to find this location's record.
; Find the location's record.
 $8F14 CALL $9BB1     ;
 $8F17 BIT 7,(IX+$00) ; Test bit 7 of the location attribute.
 $8F1B POP IX         ; {Restore the exit and jump to #R$8F35 if bit 7 of the
 $8F1D JR Z,$8F35     ; location attribute is clear.}
 $8F1F LD IY,($B70C)  ; Read *#R$B70C.
 $8F23 LD A,(IY+$10)  ; Read the location from #REGiy.
 $8F26 PUSH AF        ; {Save the location and read this exit's destination.
 $8F27 LD A,(IX+$02)  ; }
 $8F2A LD (IY+$10),A  ; Store the exit's destination in the character's
                      ; location.
 $8F2D CALL $962B     ; Call #R$962B to print that you see this place.
 $8F30 POP AF         ; {Put the character back in its saved location.
 $8F31 LD (IY+$10),A  ; }
 $8F34 RET            ; Return.
@label=Action_CarryOnWithTheObject_PrintItIsDark
*$8F35 LD HL,$AE1F    ; Point at the message "it is dark" (#R$AE1F).
 $8F38 JP $72DD       ; Jump back to #R$72DD to print "it is dark".

