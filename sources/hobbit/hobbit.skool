 $8FB2 CP $00        ; {Jump back to #R$8FAD when the roll is zero.
 $8FB4 JR Z,$8FAD    ; }
@label=Action_Run_Loop
*$8FB6 LD B,A        ; Copy the result into #REGb.
 $8FB7 CALL $9F08    ; Call #R$9F08 to find an exit in the direction in #REGa.
 $8FBA CP B          ; {Jump to #R$8FC7 if this exit's direction is the one
