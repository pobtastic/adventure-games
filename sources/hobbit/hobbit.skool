@label=Action_CheckTheObjectFlags_ReturnFlagValueOne
*$8ECE LD A,$01       ; The flag value to return is #N$01.
 $8ED0 AND A          ; Set the flags from #N$01. The zero flag is clear.
 $8ED1 RET            ; Return.

; Action: Locate And Follow
;
; Used by the routine at #R$8EEC.
; .
