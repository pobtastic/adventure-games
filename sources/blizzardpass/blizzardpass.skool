; Illustration Attribute Buffer
;
; The top twelve rows of attributes. The picture bytecode paints into this
; buffer and the result is copied to the screen.
@label=AttributeBuffer
b$6C7A DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6C82 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
