; Command Scripts
;
; Bytecode for the player's verbs: movement that the exit table did not
; handle, GET, DROP, WEAR and the rest. #R$6074 runs it after a command has been
; parsed. Each line is a verb and a noun, then conditions while bit 7 of the
; next byte is clear, then actions while bit 7 is set. Verb or noun #N$7E
; matches any word. #N$7F ends the table. Action bit 6 stops the runner after
; that action.
;
; .
;
; DOWN PASS.
@label=CommandScripts
b$9A54 DEFB $06,$D8     ; Verb DOWN or D, noun PASS, HOLE, TUNN or CREV.
 $9A56 DEFB $9C,$11,$D8 ; #R$69E8 as #R$9C9E(GO PASS).
; DOWN PASS.
 $9A59 DEFB $06,$D8     ; Verb DOWN or D, noun PASS, HOLE, TUNN or CREV.
 $9A5B DEFB $9C,$11,$D8 ; #R$69E8 as #R$9C9E(GO PASS).
