; Start Game
;
; The last loader block. It loads #N$0100 bytes over the command buffer
; and falls into the game. The snapshot is paused on the call into #R$5ECB.
;
; .
;
; The #N$0100 bytes are a headerless block, flagged by the carry.
@label=StartGame
c$FFDC LD IX,$5B00   ; {Load into #R$5B00.
 $FFE0 LD DE,$0100   ;
 $FFE3 LD A,$00      ;
 $FFE5 SCF           ; }
 $FFE6 CALL $0556    ; Call #SKOOLKID$0556(LD-BYTES).
@label=GameEntry
 $FFE9 CALL $5ECB    ; Call #R$5ECB to run the adventure.

; Bytes After Entry
;
; Not executed. The call into the game loop does not return here.
@label=AfterEntry
