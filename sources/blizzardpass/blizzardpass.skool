; Draw Room Once
;
; Used by the routines at #R$5ECB, #R$5F21 and #R$685B.
; .
; Draws the illustration when the room on screen is not the current one,
; and remembers the room.
@label=DrawRoomOnce
c$6B15 LD HL,$6185   ; {The picture is drawn only when #R$6185 is not this
 $6B18 LD A,($5D87)  ; room.
 $6B1B CP (HL)       ; }
 $6B1C DI            ; {Remember the room and draw it with interrupts off.
 $6B1D LD (HL),A     ;
 $6B1E CALL NZ,$6B4C ; }
 $6B21 EI            ; Allow interrupts again.
 $6B22 RET           ; Return.

; Glyph Buffer
;
; Eight bytes of the character currently being shifted onto the screen.
; It starts full of #N$FF.
@label=GlyphBuffer
b$6B23 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF

; Finish Word On Terminator
;
; Used by the routine at #R$62F2.
; .
; A space that follows a message terminator is forced, so the terminator
; itself is not printed in the middle of a word.
@label=FinishWord
c$6B2B LD A,($5B9B)  ; {A last character of #N$7E is a terminator.
 $6B2E CP $7E        ;
 $6B30 JR Z,$6B39    ; }
 $6B32 CP $5E        ; {A last character of #N$5E is a terminator. Anything else is
 $6B34 LD A,$20      ; collected as a space.
 $6B36 JP NZ,$6319   ; }
@label=FinishWord_Space
*$6B39 LD A,$20      ; {A terminator is replaced by a space as the last
 $6B3B LD ($5B9B),A  ; character.}
 $6B3E JP $6319      ; Jump to #R$6319 to collect that space.

; Error Stack
;
; Stored in #SKOOLKID$5C3D(ERR_SP) when the game starts. A ROM error sets
; the stack to this word, whose value is the address of the glyph buffer.
@label=ErrorStack
w$6B41 DEFW $6B23

; Action: Redraw
;
; Used by the routine at #R$662D.
; .
; Draws the picture, describes the room, and marks the room changed so
; the following turn keeps the description in step.
@label=RedrawLocation
c$6B43 CALL $6B4C    ; {Jump to #R$696C after the picture and the description.
 $6B46 CALL $6187    ;
 $6B49 JP $696C      ; }

; Draw Picture When Enabled
;
; Used by the routines at #R$6B15 and #R$6B43.
; .
; Returns immediately while pictures are switched off. Otherwise paints
; the illustration.
@label=DrawIfPictures
c$6B4C PUSH AF       ; {Pictures off are the path that returns.
 $6B4D LD A,($66D6)  ;
 $6B50 OR A          ;
 $6B51 JR NZ,$6B55   ; }
 $6B53 POP AF        ; Restore #REGaf from the stack.
 $6B54 RET           ; Return.
@label=DrawIfPictures_On
*$6B55 POP AF        ; Restore #REGaf from the stack.
 $6B56 JP $6DFA      ; Jump to #R$6DFA to paint the illustration.

; Unused Action Tail
;
; A second copy of the action-table tail, the redraw routine and the
; glyph buffer. Nothing calls it; the live copies are the routines above.
@label=UnusedActionTail
