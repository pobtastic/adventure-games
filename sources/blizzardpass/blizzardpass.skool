 $5DA0 DEFB $68      ; Flag #N($08+(#PC-$5D8F)).
 $5DA1 DEFB $60      ; Flag #N($08+(#PC-$5D8F)).
 $5DA2 DEFB $00      ; Flag #N($08+(#PC-$5D8F)).
 $5DA3 DEFB $2C      ; Flag #N($08+(#PC-$5D8F)).
 $5DA4 DEFB $28      ; Flag #N($08+(#PC-$5D8F)).
 $5DA5 DEFB $BE      ; Flag #N($08+(#PC-$5D8F)).
 $5DA6 DEFB $32      ; Flag #N($08+(#PC-$5D8F)).
 $5DA7 DEFB $34      ; Flag #N($08+(#PC-$5D8F)).
 $5DA8 DEFB $36      ; Flag #N($08+(#PC-$5D8F)).
 $5DA9 DEFB $38      ; Flag #N($08+(#PC-$5D8F)).
 $5DAA DEFB $30      ; Flag #N($08+(#PC-$5D8F)).
 $5DAB DEFB $0E      ; Flag #N($08+(#PC-$5D8F)).
 $5DAC DEFB $00      ; Flag #N($08+(#PC-$5D8F)).
 $5DAD DEFB $00      ; Flag #N($08+(#PC-$5D8F)).
 $5DAE DEFB $68      ; Flag #N($08+(#PC-$5D8F)).
 $5DAF DEFB $60      ; Flag #N($08+(#PC-$5D8F)).
 $5DB0 DEFB $00      ; Flag #N($08+(#PC-$5D8F)).
 $5DB1 DEFB $29      ; Flag #N($08+(#PC-$5D8F)).
 $5DB2 DEFB $2D      ; Flag #N($08+(#PC-$5D8F)).
 $5DB3 DEFB $33      ; Flag #N($08+(#PC-$5D8F)).
 $5DB4 DEFB $0E      ; Flag #N($08+(#PC-$5D8F)).
 $5DB5 DEFB $00      ; Flag #N($08+(#PC-$5D8F)).
 $5DB6 DEFB $00      ; Flag #N($08+(#PC-$5D8F)).
 $5DB7 DEFB $03      ; Flag #N($08+(#PC-$5D8F)).
 $5DB8 DEFB $00      ; Flag #N($08+(#PC-$5D8F)).
 $5DB9 DEFB $00      ; Flag #N($08+(#PC-$5D8F)).
 $5DBA DEFB $0D      ; Flag #N($08+(#PC-$5D8F)).
 $5DBB DEFB $00      ; Flag #N($08+(#PC-$5D8F)).
 $5DBC DEFB $0B      ; Flag #N($08+(#PC-$5D8F)).
 $5DBD DEFB $0E      ; Flag #N($08+(#PC-$5D8F)).
 $5DBE DEFB $00      ; Flag #N($08+(#PC-$5D8F)).
 $5DBF DEFB $F9      ; Flag #N($08+(#PC-$5D8F)).
 $5DC0 DEFB $C0      ; Flag #N($08+(#PC-$5D8F)).
 $5DC1 DEFB $36      ; Flag #N($08+(#PC-$5D8F)).
 $5DC2 DEFB $35      ; Flag #N($08+(#PC-$5D8F)).
 $5DC3 DEFB $35      ; Flag #N($08+(#PC-$5D8F)).
 $5DC4 DEFB $30      ; Flag #N($08+(#PC-$5D8F)).
 $5DC5 DEFB $30      ; Flag #N($08+(#PC-$5D8F)).
 $5DC6 DEFB $0E      ; Flag #N($08+(#PC-$5D8F)).
 $5DC7 DEFB $00      ; Flag #N($08+(#PC-$5D8F)).
 $5DC8 DEFB $00      ; Flag #N($08+(#PC-$5D8F)).
 $5DC9 DEFB $DC      ; Flag #N($08+(#PC-$5D8F)).

; Object Locations
;
; One byte per object, copied from #R$B6A8 at the start of a game. The
; byte is the room the object is in, or #N$FC when it is nowhere. Slots #N$3B
; and #N$3E are also the 'J' markers tested before the scripts run.
@label=ObjectLocations
b$5DCA DEFB $FF,$00,$0D,$00,$14,$1A,$00,$F5
 $5DD2 DEFB $AC,$32,$31,$0E,$00,$00,$15,$00
 $5DDA DEFB $00,$2C,$C3,$A7,$3B,$3A,$DA,$38
 $5DE2 DEFB $0E,$00,$00,$08,$00,$00,$3A,$FE
 $5DEA DEFB $0D,$72,$00,$00,$14,$00,$00,$7A
 $5DF2 DEFB $00,$00,$49,$71,$00,$79,$00,$00
 $5DFA DEFB $48,$71,$00,$80,$EF,$22,$22,$0D
 $5E02 DEFB $80,$00,$00,$DC,$FF,$00,$00,$00
 $5E0A DEFB $05,$00,$00,$00,$FF,$FD,$FF,$00
 $5E12 DEFB $30,$26,$03,$42,$6C,$69,$7A,$7A
 $5E1A DEFB $61,$72,$64,$30,$39,$24,$00,$DC
 $5E22 DEFB $FF,$00,$80,$00,$00,$00,$00,$00
 $5E2A DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5E32 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5E3A DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5E42 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5E4A DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5E52 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5E5A DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5E62 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5E6A DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5E72 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5E7A DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5E82 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5E8A DEFB $00,$00,$00,$00,$00,$00,$00,$DB
 $5E92 DEFB $02,$7C,$38,$F1,$5D,$4D,$00,$07
 $5E9A DEFB $5E,$DB,$02,$7C,$38,$14,$B1,$33
 $5EA2 DEFB $08,$5E,$05,$00,$B1,$B1,$33,$03
 $5EAA DEFB $5E,$B7,$2D,$03,$5E,$40,$FF,$E9
 $5EB2 DEFB $FF,$2B,$2D,$65,$33,$38,$00,$ED
 $5EBA DEFB $10,$0D,$00,$09,$00,$85,$1C,$10
 $5EC2 DEFB $1C,$52,$1B,$76,$1B,$03,$13,$00

; Condition Failed
;
; Set when a bytecode condition fails or an action wants the rest of the
; line skipped.
@label=ConditionFailed
g$5ECA DEFB $3E

; Game Loop
;
; Used by the routines at #R$685B, #R$6953 and #R$FFDC.
; .
; Runs the adventure. It prepares a new game, describes the room, runs the
; location scripts, draws the picture, then reads a command and obeys it. A ROM
; error returns with the stack at #R$6B41.
;
; .
;
; Install the word at #R$6B41 as the ROM error handler and give the game
; its own stack.
@label=GameLoop
c$5ECB LD HL,$6B41   ; {Store #R$6B41 in #SKOOLKID$5C3D(ERR_SP).
 $5ECE LD ($5C3D),HL ; }
 $5ED1 LD SP,$5D84   ; #REGsp=#R$5D84.
; Start in the first room with an empty inventory.
 $5ED4 CALL $600F    ; Call #R$600F.
 $5ED7 XOR A         ; {Clear *#R$6185.
 $5ED8 LD ($6185),A  ; }
; Describe the first room.
 $5EDB CALL $6187    ; Call #R$6187.
; This entry point is used by the routines at #R$5F21 and #R$5FAA.
; .
; Run the high-priority scripts, and describe the room again if they moved
; the player.
@label=GameLoop_Act
*$5EDE XOR A         ; {Clear *#R$5D8E.
 $5EDF LD ($5D8E),A  ; }
 $5EE2 CALL $6058    ; Call #R$6058.
 $5EE5 LD A,($5B95)  ; {Jump to #R$5EEE if *#R$5B95 is unset.
 $5EE8 OR A          ;
 $5EE9 JR Z,$5EEE    ; }
; Describe the new room.
 $5EEB CALL $6187    ; Call #R$6187.
; Draw the illustration once for this room, then either repeat or ask for
; a command.
@label=GameLoop_Draw
*$5EEE CALL $6B15    ; Call #R$6B15.
 $5EF1 XOR A         ; {Clear *#R$5B95.
 $5EF2 LD ($5B95),A  ; }
 $5EF5 LD A,($5D8E)  ; {Jump to #R$5F46 if *#R$5D8E is set.
 $5EF8 OR A          ;
 $5EF9 JR NZ,$5F46   ; }
; Read a command. An empty line is a complaint, not an action.
 $5EFB CALL $66C7    ; Call #R$66C7.
 $5EFE LD A,($5B7F)  ; {Jump to #R$5F21 if *#R$5B7F is set.
 $5F01 OR A          ;
 $5F02 JR NZ,$5F21   ; }
 $5F04 LD A,($5B80)  ; {Jump to #R$5F21 if *#R$5B80 is set.
 $5F07 OR A          ;
 $5F08 JR NZ,$5F21   ; }
; Print "that input contained no recognised words.".
 $5F0A LD A,$0B      ; {Print #R$7E65 using #R$63D4.
 $5F0C CALL $63D4    ; }
 $5F0F XOR A         ; {Clear *#R$5B85. After #R$7213 this can instead write #N$00
 $5F10 LD ($5B85),A  ; at #R$5B00 plus the last pictured object.}
; Start another turn.
 $5F13 JR $5EDE      ; Jump to #R$5EDE.

; Pictured Object
;
; The room-change scan compares a picture #N$F8 object with this byte.
; Nothing writes it; #R$7213 stores at #R$5F10(#N$5F11) instead, so the
; comparison is against #N$00.
@label=PicturedObject
g$5F15 DEFB $00

; Address Character Row
;
; Used by the routines at #R$654B, #R$655E and #R$65ED.
; .
; Turns a character row in #REGa into the display address of that row.
;
;   A Character row
; O:DE Display address of character row #REGa
@label=RowAddress
c$5F16 LD L,A        ; {Copy the row into #REGhl.
 $5F17 LD H,$00      ; }
 $5F19 ADD HL,HL     ; {Point at that word in #R$5BD0.
 $5F1A LD DE,$5BD0   ;
 $5F1D ADD HL,DE     ; }
 $5F1E JP $2AF0      ; Enter #SKOOLKID$2AEE,$2AF0(DE_DE_1) at #N$2AF0 to load the row
                     ; address into #REGde.

; Obey Command
;
; Used by the routine at #R$5ECB.
; .
; Turns the verb and noun into a movement or a scripted action. PUSH,
; PULL, ROLL or MOVE with CURTAINS is rewritten to noun #N$2B. WET, COOL, DAMP
; or SOAK is refused, except with the robe, the door or the running water.
;
; .
;
; Curtains are a special noun for the pushing verbs.
@label=ObeyCommand
c$5F21 CP $1B        ; {Verb #N$1B (PUSH, PULL, ROLL or MOVE) continues.
 $5F23 JR NZ,$5F31   ; }
 $5F25 LD A,($5B80)  ; {Noun #N$85 (CURTAINS) continues.
 $5F28 CP $85        ;
 $5F2A JR NZ,$5F31   ; }
 $5F2C LD A,$2B      ; {That pair becomes noun #N$2B.
 $5F2E LD ($5B80),A  ; }
; A movement that matches an exit changes the room and skips the scripts.
@label=ObeyCommand_Move
*$5F31 CALL $5FF1    ; Call #R$5FF1.
 $5F34 LD A,($5B7A)  ; {Write the match into #R$5B95.
 $5F37 LD ($5B95),A  ; }
 $5F3A OR A          ; {Jump to #R$5EDE if an exit was taken.
 $5F3B JR NZ,$5EDE   ; }
; Run the ordinary command scripts.
 $5F3D CALL $6074    ; Call #R$6074.
 $5F40 LD A,($5B79)  ; {Jump to #R$5F65 when no script line matched.
 $5F43 OR A          ;
 $5F44 JR Z,$5F65    ; }
; This entry point is used by the routine at #R$5ECB.
; .
; A script asked for the location to be reconsidered several times.
@label=ObeyCommand_Repeat
*$5F46 LD A,($5D8E)  ; {Jump to #R$5EDE once the repeat count has run out.
 $5F49 OR A          ;
 $5F4A JR Z,$5EDE    ; }
 $5F4C XOR A         ; {Write #N$00 to #R$5B95.
 $5F4D LD ($5B95),A  ; }
; Run the high-priority scripts.
 $5F50 CALL $6058    ; Call #R$6058.
 $5F53 LD A,($5B95)  ; {Jump to #R$5F5C if the room did not change.
 $5F56 OR A          ;
 $5F57 JR Z,$5F5C    ; }
 $5F59 CALL $6187    ; Call #R$6187 when those scripts moved the player.
; Count down one repeat after the redraw.
@label=ObeyCommand_Redraw
*$5F5C CALL $6B15    ; Call #R$6B15.
 $5F5F LD HL,$5D8E   ; Point #REGhl at #R$5D8E.
 $5F62 DEC (HL)      ; Count down one repeat.
 $5F63 JR $5F46      ; Jump to #R$5F46.
; WET, COOL, DAMP or SOAK only works on the robe, the door or the running
; water.
@label=ObeyCommand_Wet
*$5F65 LD A,($5B7F)  ; {Only verb #N$1C (WET, COOL, DAMP or SOAK) continues.
 $5F68 CP $1C        ;
 $5F6A JR NZ,$5FAA   ; }
 $5F6C LD A,($5B80)  ; {The robe, noun #N($B8), is allowed.
 $5F6F CP $B8        ;
 $5F71 JR Z,$5FAA    ; }
 $5F73 CP $DE        ; {The running water, noun #N($DE), is allowed.
 $5F75 JR Z,$5FAA    ; }
 $5F77 CP $D1        ; {The door, noun #N($D1), is allowed.
 $5F79 JR Z,$5FAA    ; }
 $5F7B LD HL,$5F8F   ; Point #REGhl at #R$5F8F.
 $5F7E LD B,$1B      ; #N$1B characters.
; Print the refusal one character at a time.
@label=ObeyCommand_Water
*$5F80 LD A,(HL)     ; Fetch this character.
 $5F81 CALL $63FC    ; Call #R$63FC.
 $5F84 INC HL        ; Advance to the next character.
 $5F85 DJNZ $5F80    ; Jump to #R$5F80 until the sentence is done.
 $5F87 LD A,$0D      ; {Print ENTER.
 $5F89 CALL $63FC    ; }
 $5F8C JP $5EDE      ; Jump to #R$5EDE.

; That Will Not Absorb Water
;
; Printed when something is asked to soak up water and cannot. The text is
; "#STR(#PC,,$1B)".
@label=AbsorbWater
t$5F8F DEFM "That will not absorb water."

; Refuse Command
;
; Used by the routine at #R$5F21.
; .
; The scripts did not handle the command. A direction says you cannot go
; that way, any other verb is beyond the game, and a blank verb produces the
; longer refusal.
@label=RefuseCommand
c$5FAA XOR A         ; {Clear *#R$5B85.
 $5FAB LD ($5B85),A  ; }
 $5FAE LD A,($5B7F)  ; {Jump to #R$5FBC if *#R$5B7F is unset.
 $5FB1 OR A          ;
 $5FB2 JR Z,$5FBC    ; }
 $5FB4 CP $0B        ; {Jump to #R$5FBC if the verb is not a direction.
 $5FB6 JR NC,$5FBC   ; }
; Print "you can't go that way.".
 $5FB8 LD A,$18      ; {Print #R$7F24 using #R$63D4.
 $5FBA JR $5FC4      ; }
; A recognised verb that is not a direction, or no verb at all.
@label=RefuseCommand_Verb
*$5FBC LD A,($5B7F)  ; {Jump to #R$5FCA if *#R$5B7F is unset.
 $5FBF OR A          ;
 $5FC0 JR Z,$5FCA    ; }
; Print "it's beyond my power to do that.".
 $5FC2 LD A,$0C      ; Print #R$7E7E using #R$63D4.
; Print the chosen refusal.
@label=RefuseCommand_Print
*$5FC4 CALL $63D4    ; Call #R$63D4.
 $5FC7 JP $5EDE      ; Jump to #R$5EDE.
; Print "I don't understand that verb".
@label=RefuseCommand_None
*$5FCA LD A,$20      ; {Print #R$7F79 using #R$63D4.
 $5FCC JR $5FC4      ; }

; Find Room In Exit Table
;
; Used by the routines at #R$5FF1 and #R$6187.
; .
; Looks through #R$AB67 for the current room. The room is stored as itself
; plus #N$80.
;
; O:HL The matching room key, or the end of a full sweep of the table
@label=FindExits
c$5FCE LD A,($5D87)  ; Fetch #R$5D87.
 $5FD1 ADD A,$80     ; {Write that room plus #N$80 to #R$5B84.
 $5FD3 LD ($5B84),A  ; }
 $5FD6 XOR A         ; {Write #N$00 to #R$5B7A.
 $5FD7 LD ($5B7A),A  ; }
 $5FDA LD DE,$AB67   ; Point #REGde at #R$AB67.
 $5FDD LD HL,$5B84   ; Point #REGhl at #R$5B84.
; Scan the exit table.
@label=FindExits_Scan
*$5FE0 LD A,(DE)     ; Fetch this key.
 $5FE1 CP (HL)       ; {Jump to #R$5FEF if it matches this room.
 $5FE2 JR Z,$5FEF    ; }
 $5FE4 INC DE        ; Advance the table pointer.
 $5FE5 LD A,E        ; {Jump to #R$5FE0 until #REGde is #N$34CE.
 $5FE6 CP $CE        ;
 $5FE8 JR NZ,$5FE0   ;
 $5FEA LD A,D        ;
 $5FEB CP $34        ;
 $5FED JR NZ,$5FE0   ; }
; The matching room key, or the end of the table.
@label=FindExits_Found
*$5FEF EX DE,HL      ; Put the table pointer in #REGhl.
 $5FF0 RET           ; Return.

; Take Exit
;
; Used by the routine at #R$5F21.
; .
; If the verb is one of the directions listed for this room, move to the
; destination that follows it.
;
; .
;
; Find this room's exits.
@label=TakeExit
c$5FF1 CALL $5FCE    ; Call #R$5FCE.
 $5FF4 DEC HL        ; Step back one byte so the walk starts at the first exit.
; Each exit is a verb byte with bit 7 clear, then the destination room.
; Bit 7 ends the room.
@label=TakeExit_Next
*$5FF5 INC HL        ; {Advance to the next exit.
 $5FF6 INC HL        ; }
 $5FF7 BIT 7,(HL)    ; {Jump to #R$600E if bit 7 is set.
 $5FF9 JR NZ,$600E   ; }
 $5FFB LD A,($5B7F)  ; {Jump to #R$5FF5 if this exit is not the typed verb.
 $5FFE CP (HL)       ;
 $5FFF JR NZ,$5FF5   ; }
 $6001 XOR A         ; {Write #N$00 to #R$5BCF.
 $6002 LD ($5BCF),A  ; }
 $6005 INC A         ; {Write #N$01 to #R$5B7A.
 $6006 LD ($5B7A),A  ; }
 $6009 INC HL        ; {Fetch the destination room.
 $600A LD A,(HL)     ; }
 $600B LD ($5D87),A  ; Write it to #R$5D87.
; No more exits, or the move is done.
@label=TakeExit_Done
*$600E RET           ; Return.

; Prepare New Game
;
; Used by the routine at #R$5ECB.
; .
; Clears the screen, forgets the previous command and copies the initial
; object locations and state into place.
;
; .
;
; The text window sits on rows #N$16 and #N$17 until a location
; description moves it.
@label=PrepareGame
c$600F LD A,$17      ; {Write #N$17 to #R$5B97.
 $6011 LD ($5B97),A  ; }
 $6014 LD A,$16      ; {Write #N$16 to #R$5B89.
 $6016 LD ($5B89),A  ; }
 $6019 CALL $654B    ; Call #R$654B.
 $601C XOR A         ; {Write #N$00 to #R$5B8A.
 $601D LD ($5B8A),A  ; }
 $6020 CALL $6618    ; Call #R$6618.
; Forget the verb, the noun and the three counters.
 $6023 LD HL,$5B7F   ; Point at the five command bytes at #R$5B7F.
 $6026 LD B,$05      ; Five bytes: the verb, the noun and the three counters.
; Clear the command bytes.
@label=PrepareGame_ClearCommand
*$6028 LD (HL),$00   ; Write #N$00.
 $602A INC HL        ; Advance.
 $602B DJNZ $6028    ; Jump to #R$6028 until the five bytes are done.
 $602D XOR A         ; {Write #N$00 to #R$5B85.
 $602E LD ($5B85),A  ; }
; A new game starts in room 0 with empty flags, then the authored state is
; copied in.
 $6031 LD HL,$5D87   ; Point at the state and flag area at #R$5D87.
 $6034 LD B,$41      ; #N$41 bytes, through the last flag.
; Clear the state and flags.
@label=PrepareGame_ClearState
*$6036 LD (HL),$00   ; Write #N$00.
 $6038 INC HL        ; Advance.
 $6039 DJNZ $6036    ; Jump to #R$6036 until the state is cleared.
 $603B LD HL,$B6A8   ; Point #REGhl at #R$B6A8.
 $603E LD DE,$5DCA   ; Point #REGde at #R$5DCA.
 $6041 LD BC,$0100   ; #N$0100 bytes.
 $6044 LDIR          ; Copy them.
 $6046 LD HL,$6052   ; Point #REGhl at #R$6052.
 $6049 LD DE,$5D88   ; Point #REGde at #R$5D88.
 $604C LD BC,$0006   ; #N($0006,$04,$04) bytes.
 $604F LDIR          ; Copy them.
 $6051 RET           ; Return.

; Initial State
;
; Copied onto #R$5D88 at the start of a game: not dark, nothing carried
; (#N$FD), nothing worn (#N$FE), flag byte 4 set to #N($04), nothing in the
; carried count, and #N$96 objects to scan.
@label=InitialState
b$6052 DEFB $00,$FD,$FE,$04,$00,$96

; Run High-Priority Scripts
;
; Used by the routines at #R$5ECB and #R$5F21.
; .
; Clears the first 'J' marker when both marker slots hold #N($4A), then
; runs the script table at #R$96D9.
;
; .
;
; The loader subtracted 3 from the address written below, so the snapshot
; clears #R$5DCA(#N$5E05) rather than #R$5DCA(#N$5E08).
@label=RunPriorityScripts
c$6058 LD A,($5E05)  ; {Object slot #N$3B must hold 'J' (#N$4A).
 $605B CP $4A        ;
 $605D JR NZ,$606A   ; }
 $605F LD A,($5E08)  ; {Object slot #N$3E must hold 'J' as well.
 $6062 CP $4A        ;
 $6064 JR NZ,$606A   ; }
 $6066 XOR A         ; {Clear slot #N$3B. A fresh game has #N$FC in slot #N($3E), so this
 $6067 LD ($5E05),A  ; does not fire.}
; Run the high-priority table.
@label=RunPriorityScripts_Run
*$606A LD HL,$96D9   ; Point at the high-priority table at #R$96D9.
 $606D LD A,$FF      ; {Write #N$FF to #R$5B96.
 $606F LD ($5B96),A  ; }
 $6072 JR $607B      ; Jump to #R$607B.

; Run Script Table
;
; Used by the routine at #R$5F21.
; .
; Walks a bytecode table. A line whose verb and noun match is executed; a
; failed condition or a bit-6 action stops the line. #N$7F ends the table.
;
; .
;
; The ordinary command scripts live at #R$9A54 and are marked by a clear
; script-set flag.
@label=RunScripts
c$6074 LD HL,$9A54   ; Point at the ordinary scripts at #R$9A54.
 $6077 XOR A         ; {Write #N$00 to #R$5B96.
 $6078 LD ($5B96),A  ; }
; This entry point is used by the routine at #R$6058.
; .
; Walk one script line.
@label=RunScripts_Line
*$607B PUSH HL       ; {Keep the line pointer in #REGde while #REGhl walks it.
 $607C POP DE        ; }
 $607D XOR A         ; {No line has matched yet, and no condition has failed.
 $607E LD ($5B79),A  ;
 $6081 LD ($5ECA),A  ; }
; Test the verb and noun.
 $6084 CALL $6155    ; Call #R$6155.
 $6087 JR $6090      ; Jump to #R$6090.
; This line failed.
@label=RunScripts_Failed
*$6089 XOR A         ; {Write #N$00 to #R$5ECA.
 $608A LD ($5ECA),A  ; }
; Skip the rest of this line.
 $608D CALL $6141    ; Call #R$6141.
; Advance to the next line.
@label=RunScripts_Next
*$6090 LD A,H        ; {Return at the #N$7F end marker.
 $6091 OR L          ;
 $6092 RET Z         ; }
 $6093 BIT 7,(HL)    ; {Bit 7 on the current byte starts the actions.
 $6095 JR NZ,$60D3   ; }
; A condition byte, shifted, picks a routine from #R$67CB. The object byte
; in front of it is looked up in #R$5DCA.
@label=RunScripts_Condition
*$6097 LD A,(HL)     ; Fetch the condition number.
 $6098 SLA A         ; Double it so it indexes a word.
 $609A LD IX,$67CB   ; Point #REGix at #R$67CB.
 $609E LD C,A        ; {Index by the condition number.
 $609F LD B,$00      ;
 $60A1 ADD IX,BC     ; }
 $60A3 LD A,(IX+$00) ; {Plant that routine over the call at #R$60C1(#N$60C2).
 $60A6 LD ($60C2),A  ;
 $60A9 LD A,(IX+$01) ;
 $60AC LD ($60C3),A  ; }
 $60AF PUSH HL       ; Stash the line pointer on the stack.
 $60B0 INC HL        ; Advance to the object number.
 $60B1 LD A,(HL)     ; {Fetch it into #REGc.
 $60B2 LD C,A        ; }
 $60B3 LD IX,$5DCA   ; Point #REGix at #R$5DCA.
 $60B7 ADD IX,BC     ; Add the object number.
 $60B9 LD B,A        ; Keep the object number.
 $60BA LD A,(IX+$00) ; {Fetch that object's location into #REGc.
 $60BD LD C,A        ; }
 $60BE INC HL        ; Advance to the parameter.
 $60BF LD A,(HL)     ; Fetch it.
 $60C0 PUSH DE       ; Stash #REGde on the stack.
 $60C1 CALL $0006    ; Call the planted condition routine.
 $60C4 POP DE        ; {Restore #REGde and #REGhl from the stack.
 $60C5 POP HL        ; }
 $60C6 CALL $612B    ; Call #R$612B.
 $60C9 LD A,($5ECA)  ; {A failure skips the rest of this line.
 $60CC OR A          ;
 $60CD JR NZ,$6089   ; }
 $60CF BIT 7,(HL)    ; {Otherwise keep testing while bit 7 is clear.
 $60D1 JR Z,$6097    ; }
; The line matched. Remember that, and perform each action until one asks
; to stop.
@label=RunScripts_Matched
*$60D3 LD A,$01      ; {Write #N$01 to *#R$5B79.
 $60D5 LD ($5B79),A  ; }
; Perform the next action.
@label=RunScripts_NextAction
*$60D8 LD A,($5B86)  ; {Jump to #R$60E2 if *#R$5B86 is zero.
 $60DB OR A          ;
 $60DC JR Z,$60E2    ; }
 $60DE XOR A         ; {The first matched line of a command clears #R$5B86.
 $60DF LD ($5B86),A  ; }
; Decode this action.
@label=RunScripts_Action
*$60E2 BIT 6,(HL)    ; {Jump to #R$60EB if bit 6 is clear.
 $60E4 JR Z,$60EB    ; }
 $60E6 LD A,$01      ; {Write #N$01 to #R$5ECA.
 $60E8 LD ($5ECA),A  ; }
; Call the action.
@label=RunScripts_Do
*$60EB LD A,(HL)     ; Fetch the action byte.
 $60EC AND %00111111 ; Keep only bits 0-5.
 $60EE SLA A         ; Double the action number.
 $60F0 LD IX,$6AD5   ; Point #REGix at the word inside #R$6AD4. Action 0 is the
                     ; beeper operand, and the routines start at #R$6AD7.
 $60F4 LD C,A        ; {Index by the action number.
 $60F5 LD B,$00      ;
 $60F7 ADD IX,BC     ; }
 $60F9 LD A,(IX+$00) ; {Plant that routine over the call at #R$6117(#N$6118).
 $60FC LD ($6118),A  ;
 $60FF LD A,(IX+$01) ;
 $6102 LD ($6119),A  ; }
 $6105 PUSH HL       ; Stash the line pointer on the stack.
 $6106 INC HL        ; Advance to the object number.
 $6107 LD A,(HL)     ; Fetch it.
 $6108 LD IX,$5DCA   ; Point #REGix at #R$5DCA.
 $610C LD C,A        ; Copy the object number into #REGc.
 $610D ADD IX,BC     ; Add it.
 $610F LD B,A        ; Keep the object number.
 $6110 LD A,(IX+$00) ; {Fetch that object's location into #REGc.
 $6113 LD C,A        ; }
 $6114 INC HL        ; Advance to the parameter.
 $6115 LD A,(HL)     ; Fetch it.
 $6116 PUSH DE       ; Stash #REGde on the stack.
 $6117 CALL $0006    ; Call the patched action.
 $611A POP DE        ; {Restore the line pointer and the table pointer.
 $611B POP HL        ; }
 $611C CALL $6133    ; Call #R$6133.
 $611F LD A,($5ECA)  ; {Stop the table when the action raised #R$5ECA.
 $6122 OR A          ;
 $6123 RET NZ        ; }
 $6124 BIT 7,(HL)    ; {Bit 7 continues this line's next action.
 $6126 JR NZ,$60D8   ; }
; Start the next line.
 $6128 JP $6089      ; Jump to #R$6089.

; Step Past Condition
;
; Used by the routines at #R$6074 and #R$6141.
; .
; Moves HL past a condition and its parameter. Condition numbers below
; #N$15 have no extra object byte.
@label=SkipCondition
c$612B LD A,(HL)     ; Fetch the condition number.
 $612C INC HL        ; {Step past the condition and its object byte.
 $612D INC HL        ; }
 $612E CP $15        ; {Return if the condition number is below #N$15.
 $6130 RET C         ; }
 $6131 INC HL        ; Step past the parameter byte.
 $6132 RET           ; Return.

; Step Past Action
;
; Used by the routines at #R$6074 and #R$6141.
; .
; Moves HL past an action. Actions #N$09 to #N$15 carry one extra byte,
; and higher actions carry two.
@label=SkipAction
c$6133 LD A,(HL)     ; Fetch the action byte.
 $6134 AND %00111111 ; Keep only bits 0-5.
 $6136 INC HL        ; Step past the action.
 $6137 CP $09        ; {Return if the action number is below #N$09.
 $6139 RET C         ; }
 $613A CP $16        ; {Actions #N$09 to #N$15 carry one extra byte.
 $613C JR C,$613F    ; }
 $613E INC HL        ; Higher actions carry a second extra byte.
; Step past the last parameter.
@label=SkipAction_One
*$613F INC HL        ; Step past the last parameter byte.
 $6140 RET           ; Return.

; Skip Failed Line
;
; Used by the routine at #R$6074.
; .
; Drops the remaining conditions and actions of a line that has already
; failed.
@label=SkipLine
c$6141 PUSH DE       ; {Copy the saved line pointer into #REGhl (using the
 $6142 POP HL        ; stack).}
; This entry point is used by the routine at #R$6155.
; .
; Skip remaining conditions.
@label=SkipLine_Conditions
*$6143 BIT 7,(HL)    ; {Bit 7 ends the conditions.
 $6145 JR NZ,$614E   ; }
; Skip one condition.
@label=SkipLine_Condition
*$6147 CALL $612B    ; Call #R$612B.
 $614A BIT 7,(HL)    ; {Keep going while bit 7 is clear.
 $614C JR Z,$6147    ; }
; Skip remaining actions.
@label=SkipLine_Action
*$614E CALL $6133    ; Call #R$6133.
 $6151 BIT 7,(HL)    ; {Keep going while bit 7 is set.
 $6153 JR NZ,$614E   ; }
; Continue on to #R$6155.

; Match Verb And Noun
;
; Used by the routine at #R$6074.
; .
; Accepts a script line whose verb and noun match the command. #N$7E
; matches any word. The high-priority table matches every line.
;
; O:HL Zero at the end of the table, otherwise the first condition or action
@label=MatchCommand
c$6155 LD A,(HL)     ; {The end marker #N$7F is not a verb.
 $6156 CP $7F        ;
 $6158 JR NZ,$615E   ; }
 $615A LD HL,$0000   ; It returns a zero pointer.
 $615D RET           ; Return.
; Test the verb.
@label=MatchCommand_Verb
*$615E LD A,($5B96)  ; {The high-priority table matches every line.
 $6161 OR A          ;
 $6162 JR NZ,$617F   ; }
 $6164 LD A,$7E      ; {A verb of #N$7E matches any command.
 $6166 CP (HL)       ;
 $6167 JR Z,$6172    ; }
 $6169 LD A,($5B7F)  ; {Otherwise the verb must be the one just typed.
 $616C CP (HL)       ;
 $616D JR Z,$6172    ; }
 $616F INC HL        ; Advance to the noun.
 $6170 JR $6182      ; Jump to #R$6182.
; Test the noun.
@label=MatchCommand_Noun
*$6172 INC HL        ; Advance to the noun.
 $6173 LD A,$7E      ; {Jump to #R$617E if the noun is #N$7E.
 $6175 CP (HL)       ;
 $6176 JR Z,$617E    ; }
 $6178 LD A,($5B80)  ; {Otherwise the noun must be the one just typed.
 $617B CP (HL)       ;
 $617C JR NZ,$6182   ; }
; The noun matched.
@label=MatchCommand_NounOk
*$617E INC HL        ; The noun matched, so the line's tests follow.
; This line is a hit.
@label=MatchCommand_Hit
*$617F PUSH HL       ; {Remember this line.
 $6180 POP DE        ; }
 $6181 RET           ; Return.
; This line missed.
@label=MatchCommand_Miss
*$6182 INC HL        ; Advance past the noun.
 $6183 JR $6143      ; Jump to #R$6143.

; Picture Already Drawn
;
; The room whose illustration is already on screen. A different room is
; drawn.
@label=PictureDrawn
g$6185 DEFB $FF

; Pause At The Bottom
;
; While a location is being described, reaching row #N$13 waits for a key
; and scrolls.
@label=PauseFlag
g$6186 DEFB $00

; Describe Location
;
; Used by the routines at #R$5ECB, #R$5F21, #R$685B and #R$6B43.
; .
; Prints where the player is, what is here, and which ways lead out. Bank
; 6 supplies the long text for rooms below #N($66), and it opens
; "#BANK6#MESSAGE($C000)#BANK0". A dark room says so and lists nothing. The
; text is underlined before the cursor is put back for the prompt.
;
; .
;
; Remember the cursor, and choose a row. Pictures use row #N$0D so the
; text sits under the illustration.
@label=DescribeLocation
c$6187 LD A,$FF      ; {The description pauses at the bottom of the picture.
 $6189 LD ($6186),A  ; }
 $618C LD A,$2E      ; {A full stop makes the first letter a capital.
 $618E LD ($5B9B),A  ; }
 $6191 LD HL,($5B89) ; {Stash the cursor on the stack.
 $6194 PUSH HL       ; }
 $6195 LD HL,($5B87) ; {Stash the print address on the stack.
 $6198 PUSH HL       ; }
; Clear the text rows.
 $6199 CALL $65ED    ; Call #R$65ED.
 $619C LD A,($66D6)  ; {Test whether pictures are on.
 $619F OR A          ; }
 $61A0 LD A,$0D      ; {Pictures on use row #N$0D.
 $61A2 JR NZ,$61A5   ;
 $61A4 XOR A         ; }
; Home the chosen row.
@label=DescribeLocation_Row
*$61A5 LD ($5B89),A  ; Write it to *#R$5B89.
 $61A8 CALL $654B    ; Call #R$654B.
 $61AB XOR A         ; {Write #N$00 to #R$5B8A.
 $61AC LD ($5B8A),A  ; }
 $61AF LD A,($5D88)  ; {Jump to #R$61BD if *#R$5D88 is zero.
 $61B2 OR A          ;
 $61B3 JR Z,$61BD    ; }
; Print "It is dark. You cannot see.".
 $61B5 LD A,$19      ; {Print #R$7F2F using #R$63D4.
 $61B7 CALL $63D4    ; }
; Underline the description.
 $61BA JP $6262      ; Jump to #R$6262.
; Rooms under #N$66 with pictures switched off are read from bank 6. Every
; other room uses the tokenised text at #R$75CE.
@label=DescribeLocation_Text
*$61BD LD HL,$75CE   ; The default text is the tokenised list at #R$75CE.
 $61C0 LD A,($5D87)  ; {Jump to #R$61DA if *#R$5D87 is at least #N$66.
 $61C3 CP $66        ;
 $61C5 JR NC,$61DA   ; }
 $61C7 LD A,($66D6)  ; {Test whether pictures are on.
 $61CA OR A          ; }
 $61CB LD A,($5D87)  ; Fetch #R$5D87.
 $61CE JR NZ,$61DA   ; Jump to #R$61DA if pictures are on.
; Page in the long descriptions.
@label=DescribeLocation_Page
 $61D0 PUSH AF       ; Stash the room number on the stack.
 $61D1 LD A,$06      ; {#PAGE$06.
 $61D3 CALL $66BD    ; }
 $61D6 LD HL,$C000   ; Point #REGhl at #R$C000@bank6.
 $61D9 POP AF        ; Restore the room number from the stack.
; Print this room's text.
@label=DescribeLocation_Print
*$61DA LD ($5B8F),A  ; Write it to *#R$5B8F.
 $61DD CALL $629D    ; Call #R$629D.
 $61E0 XOR A         ; {#PAGE$00.
 $61E1 CALL $66BD    ; }
 $61E4 XOR A         ; {Write #N$00 to #R$5B7A.
 $61E5 LD ($5B7A),A  ; }
 $61E8 LD HL,$5DCA   ; Point #REGhl at #R$5DCA.
 $61EB LD B,A        ; Start with a zero count.
; List every object whose location byte is this room. The first one is
; introduced with a colon.
@label=DescribeLocation_Objects
*$61EC LD A,($5D87)  ; {Jump to #R$6220 if it is not *#R$5D87.
 $61EF CP (HL)       ;
 $61F0 JR NZ,$6220   ; }
 $61F2 LD A,($5B7A)  ; {Jump to #R$6217 if *#R$5B7A is set.
 $61F5 OR A          ;
 $61F6 JR NZ,$6217   ; }
 $61F8 LD A,B        ; {An index below #N$46 is named without the introduction.
 $61F9 CP $46        ;
 $61FB JR C,$621C    ; }
; Print ". You can see".
 $61FD XOR A         ; Print #R$7E26 using #R$63D4.
 $61FE PUSH BC       ; {Call #R$63D4.
 $61FF CALL $63D4    ;
 $6202 POP BC        ; }
 $6203 LD A,$20      ; {Print a space.
 $6205 CALL $63FC    ; }
 $6208 LD A,$3A      ; {Print a colon.
 $620A CALL $63FC    ; }
 $620D LD A,$2D      ; {Print a dash.
 $620F CALL $63FC    ; }
 $6212 LD A,$20      ; {Print a space.
 $6214 CALL $63FC    ; }
; An object was listed.
@label=DescribeLocation_Seen
*$6217 LD A,$01      ; {Write #N$01 to *#R$5B7A.
 $6219 LD ($5B7A),A  ; }
; Print this object's name.
@label=DescribeLocation_Name
*$621C LD A,B        ; {Call #R$63D7.
 $621D CALL $63D7    ; }
; Step to the next object.
@label=DescribeLocation_Next
*$6220 LD A,($5D8D)  ; {Jump to #R$622A if #REGb equals *#R$5D8D.
 $6223 CP B          ;
 $6224 JR Z,$622A    ; }
 $6226 INC B         ; {The next location byte belongs to the next object.
 $6227 INC HL        ; }
 $6228 JR $61EC      ; Jump to #R$61EC.
; After the objects, list the directions that leave this room.
@label=DescribeLocation_Exits
*$622A LD A,($5B7A)  ; {An empty list needs no tidy-up.
 $622D OR A          ;
 $622E JR Z,$623A    ; }
 $6230 LD A,$0C      ; {Two backspaces remove the comma after the last object.
 $6232 CALL $63FC    ;
 $6235 LD A,$0C      ;
 $6237 CALL $63FC    ; }
; List the ways out.
@label=DescribeLocation_Moves
*$623A CALL $5FCE    ; Call #R$5FCE.
 $623D INC HL        ; Advance to the first exit.
 $623E BIT 7,(HL)    ; {Jump to #R$6262 if bit 7 is set.
 $6240 JR NZ,$6262   ; }
; Print ". You can go".
 $6242 LD A,$0D      ; {Print #R$7E91 using #R$63D4.
 $6244 CALL $63D4    ; }
; Print one direction.
@label=DescribeLocation_Exit
*$6247 LD A,(HL)     ; {Bit 7 ends the list of directions.
 $6248 BIT 7,A       ;
 $624A JR NZ,$6253   ; }
 $624C CALL $63D4    ; Call #R$63D4.
 $624F INC HL        ; {Advance to the next exit.
 $6250 INC HL        ; }
 $6251 JR $6247      ; Jump to #R$6247.
; Finish the exit list.
@label=DescribeLocation_Stop
*$6253 LD A,$0C      ; {Rub out the last comma.
 $6255 CALL $63FC    ;
 $6258 LD A,$0C      ;
 $625A CALL $63FC    ; }
 $625D LD A,$2E      ; {Finish with a full stop.
 $625F CALL $63FC    ; }
; Underline the description and restore the cursor the caller had saved.
@label=DescribeLocation_Rule
*$6262 XOR A         ; {The description is finished, so scrolling may resume.
 $6263 LD ($6186),A  ; }
 $6266 LD A,$0D      ; {Start the rule on a new line.
 $6268 CALL $6394    ; }
 $626B LD A,($66D6)  ; {Test whether pictures are on.
 $626E OR A          ; }
 $626F LD A,($5B89)  ; Fetch #R$5B89.
 $6272 JR NZ,$6282   ; Jump to #R$6282 if pictures are on.
 $6274 LD A,$0F      ; {Pictures off force row #N$0F.
 $6276 LD ($5B89),A  ; }
 $6279 XOR A         ; {Write #N$00 to #R$5B8A.
 $627A LD ($5B8A),A  ; }
 $627D CALL $654B    ; Call #R$654B.
 $6280 LD A,$0F      ; Row #N($0F), ready for the rule.
; Draw the underline.
@label=DescribeLocation_Bottom
*$6282 INC A         ; {The rule sits on the row under the text.
 $6283 LD ($5B97),A  ; }
 $6286 LD B,$2A      ; Forty-two underscores fill the row.
; Print the rule.
@label=DescribeLocation_Bar
*$6288 LD A,$5F      ; {Print this underscore.
 $628A CALL $63FC    ; }
 $628D DJNZ $6288    ; Jump to #R$6288 until the row is filled.
 $628F LD A,$0D      ; {Close the rule with ENTER.
 $6291 CALL $6394    ; }
 $6294 POP HL        ; {Restore the print address from the stack.
 $6295 LD ($5B87),HL ; }
 $6298 POP HL        ; {Restore the cursor from the stack.
 $6299 LD ($5B89),HL ; }
 $629C RET           ; Return.

; Print Terminated Message
;
; Used by the routines at #R$6187, #R$63D7 and #R$63E6.
; .
; Prints message number #R$5B8F from the table at HL. Each message ends at
; #N$5E or #N$7E.
@label=PrintMessage
c$629D CALL $62A2    ; Call #R$62A2.
 $62A0 EI            ; Enable interrupts.
 $62A1 RET           ; Return.

; Find And Print Message
;
; Used by the routine at #R$629D.
; .
; Skips earlier messages by counting #N$5E and #N$7E terminators, then
; expands each byte as a dictionary word.
@label=FindMessage
c$62A2 PUSH HL       ; {Point the next word at #R$5B60 (using the stack).
 $62A3 LD HL,$5B60   ;
 $62A6 LD ($5B99),HL ;
 $62A9 POP HL        ; }
 $62AA LD A,($5B8F)  ; {Fetch #R$5B8F into #REGb.
 $62AD LD B,A        ; }
 $62AE OR A          ; {Jump to #R$62C1 if it is message 0.
 $62AF JR Z,$62C1    ; }
 $62B1 DEC HL        ; The scan starts on the byte before the message.
; Skip earlier messages.
@label=FindMessage_Skip
*$62B2 INC HL        ; {Advance to the next byte.
 $62B3 LD A,(HL)     ; }
 $62B4 CP $5E        ; {Jump to #R$62BE if it is #N$5E.
 $62B6 JR Z,$62BE    ; }
 $62B8 CP $7E        ; {Jump to #R$62BE if it is #N$7E.
 $62BA JR Z,$62BE    ; }
 $62BC JR $62B2      ; Jump to #R$62B2.
; Count down to the chosen message.
@label=FindMessage_Count
*$62BE DJNZ $62B2    ; Jump to #R$62B2 until this is the chosen message.
 $62C0 INC HL        ; Step onto the chosen message.
; Expand this message byte.
@label=FindMessage_Byte
*$62C1 LD A,(HL)     ; Fetch this byte.
 $62C2 LD ($5B90),HL ; Write #REGhl to *#R$5B90.
 $62C5 CALL $62D7    ; Call #R$62D7.
 $62C8 LD A,($5B9B)  ; Fetch #R$5B9B.
 $62CB CP $7E        ; {Return if it is #N$7E.
 $62CD RET Z         ; }
 $62CE CP $5E        ; {#N$5E ends the message.
 $62D0 RET Z         ; }
 $62D1 LD HL,($5B90) ; Fetch #R$5B90.
 $62D4 INC HL        ; Advance it.
 $62D5 JR $62C1      ; Jump to #R$62C1.

; Expand Dictionary Word
;
; Used by the routine at #R$62A2.
; .
; Treats A as an index into #R$B1BC. Word 0 is empty. Every other word
; ends with bit 7 set.
@label=ExpandToken
c$62D7 LD HL,$B1BC   ; Point #REGhl at #R$B1BC.
 $62DA LD B,A        ; Copy the token number into #REGb.
 $62DB OR A          ; {Jump to #R$62E9 if it is token 0.
 $62DC JR Z,$62E9    ; }
 $62DE DEC HL        ; The scan starts on the byte before the dictionary.
; Skip to the next word.
@label=ExpandToken_Scan
*$62DF INC HL        ; Advance to the next character.
 $62E0 BIT 7,(HL)    ; {Jump to #R$62E6 if bit 7 is set.
 $62E2 JR NZ,$62E6   ; }
 $62E4 JR $62DF      ; Jump to #R$62DF.
; Count down to the requested word.
@label=ExpandToken_Next
*$62E6 DJNZ $62DF    ; Count down to the requested word.
; Step onto the first character.
@label=ExpandToken_Word
*$62E8 INC HL        ; Step onto its first character.
; Print this dictionary character.
@label=ExpandToken_Character
*$62E9 LD A,(HL)     ; Fetch this character.
 $62EA CALL $62F2    ; Call #R$62F2.
 $62ED BIT 7,(HL)    ; {Return if bit 7 is set.
 $62EF RET NZ        ; }
 $62F0 JR $62E8      ; Jump to #R$62E8.

; Capitalise After A Full Stop
;
; Used by the routine at #R$62D7.
; .
; After a full stop, a letter is forced to capitals. A space is handled by
; #R$6B2B so a terminator cannot split a word.
@label=Capitalise
c$62F2 PUSH BC       ; Stash #REGbc on the stack.
 $62F3 LD B,A        ; Copy the character into #REGb.
 $62F4 LD A,($5B9B)  ; {A preceding full stop capitalises the next letter.
 $62F7 CP $2E        ;
 $62F9 JR NZ,$630D   ; }
 $62FB LD A,B        ; The character is in #REGb.
 $62FC AND %01111111 ; Keep only bits 0-6.
 $62FE CP $40        ; {Jump to #R$630D if it is below #N$40.
 $6300 JR C,$630D    ; }
 $6302 CP $5E        ; {Jump to #R$630D if it is #N$5E.
 $6304 JR Z,$630D    ; }
 $6306 CP $7E        ; {Jump to #R$630D if it is #N$7E.
 $6308 JR Z,$630D    ; }
 $630A RES 5,A       ; Clear bit 5 to make the letter a capital.
 $630C LD B,A        ; Copy it into #REGb.
; Restore the character.
@label=Capitalise_Plain
*$630D LD A,B        ; Copy the character back into #REGa.
 $630E POP BC        ; Restore #REGbc from the stack.
 $630F AND %01111111 ; Keep only bits 0-6.
 $6311 CP $20        ; {Jump to #R$6B2B if the character is a space.
 $6313 JP Z,$6B2B    ; }
 $6316 LD ($5B9B),A  ; Remember this character as the last one printed.
; Continue on to #R$6319.

; Collect A Word
;
; Used by the routine at #R$6B2B.
; .
; Adds the character to the current word. A space, ENTER or a terminator
; flushes the word, wrapping when it would pass column #N$2B.
@label=CollectWord
c$6319 PUSH AF       ; {Stash the registers around the word buffer.
 $631A PUSH HL       ;
 $631B PUSH BC       ;
 $631C PUSH DE       ; }
 $631D LD HL,($5B99) ; {Store the character.
 $6320 LD (HL),A     ; }
 $6321 INC HL        ; {Advance the word pointer.
 $6322 LD ($5B99),HL ; }
 $6325 LD HL,$5B98   ; Point #REGhl at #R$5B98.
 $6328 INC (HL)      ; Count it.
 $6329 CP $20        ; {Jump to #R$633C if it is a space.
 $632B JR Z,$633C    ; }
 $632D CP $0D        ; {Jump to #R$633C if it is ENTER.
 $632F JR Z,$633C    ; }
 $6331 CP $5E        ; {Jump to #R$633C if it is #N$5E.
 $6333 JR Z,$633C    ; }
 $6335 CP $7E        ; {Jump to #R$633C if it is #N$7E.
 $6337 JR Z,$633C    ; }
 $6339 JP $63CF      ; Any other character returns.
; Flush the buffered word.
@label=CollectWord_Flush
*$633C LD HL,$5B98   ; Point #REGhl at #R$5B98.
 $633F CP $5E        ; {Jump to #R$634B if it is #N$5E.
 $6341 JR Z,$634B    ; }
 $6343 CP $7E        ; {Jump to #R$634B if it is #N$7E.
 $6345 JR Z,$634B    ; }
 $6347 CP $20        ; {A space is not part of the width either.
 $6349 JR NZ,$634C   ; }
; Drop the terminator from the width.
@label=CollectWord_Drop
*$634B DEC (HL)      ; Drop that character from the count.
; See whether the word fits.
@label=CollectWord_Width
*$634C PUSH AF       ; Remember the character being flushed.
 $634D LD A,($5B8A)  ; {Call #R$6378 when *#R$5B8A plus the word would pass
 $6350 ADD A,(HL)    ; #N$2A.
 $6351 CP $2B        ;
 $6353 CALL NC,$6378 ; }
 $6356 POP AF        ; Restore the character from the stack.
 $6357 LD HL,$5B60   ; The buffered word starts at #R$5B60.
; Print the flushed characters.
@label=CollectWord_Character
*$635A LD A,(HL)     ; {Jump to #R$6366 if it is not #N$7E.
 $635B CP $7E        ;
 $635D JR NZ,$6366   ; }
 $635F LD A,$20      ; {Print a space.
 $6361 CALL $6394    ; }
 $6364 JR $6388      ; Jump to #R$6388.
; Finish the message or keep printing.
@label=CollectWord_End
*$6366 CP $5E        ; {#N$5E finishes the message.
 $6368 JR Z,$637E    ; }
 $636A CP $20        ; {Jump to #R$6385 if it is a space.
 $636C JR Z,$6385    ; }
 $636E CP $0D        ; {Jump to #R$6385 if it is ENTER.
 $6370 JR Z,$6385    ; }
 $6372 CALL $6394    ; Call #R$6394.
 $6375 INC HL        ; Advance to the next buffered character.
 $6376 JR $635A      ; Jump to #R$635A.
; The word does not fit on this row.
@label=WrapLine
*$6378 LD A,$0D      ; {Start a new line.
 $637A CALL $6394    ; }
 $637D RET           ; Return.
; Start a new line, then reset the word.
@label=CollectWord_Newline
*$637E PUSH AF       ; Stash the character on the stack.
 $637F CALL $6378    ; Call #R$6378.
 $6382 POP AF        ; Restore the character from the stack.
 $6383 JR $6388      ; Jump to #R$6388.
; A space or ENTER is printed before the reset.
@label=CollectWord_Break
*$6385 CALL $6394    ; Call #R$6394.
; Reset the word buffer.
@label=CollectWord_Reset
*$6388 LD HL,$5B60   ; {Point the next word back at #R$5B60.
 $638B LD ($5B99),HL ; }
 $638E XOR A         ; {Write #N$00 to #R$5B98.
 $638F LD ($5B98),A  ; }
 $6392 JR $63CF      ; Jump to #R$63CF.

; Print Character
;
; Used by the routines at #R$6187, #R$6319, #R$680C and #R$6A3C.
; .
; Plots A. A space that would sit on top of another space is rubbed out
; first. ENTER pads the row out to the margin.
@label=PrintCharacter
c$6394 CP $20        ; {Jump to #R$639B if this is not a space.
 $6396 JR NZ,$639B   ; }
 $6398 PUSH AF       ; Stash the space on the stack.
 $6399 JR $63A3      ; Jump to #R$63A3.
; Any other character, or a space that is not doubled.
@label=PrintCharacter_Other
*$639B PUSH AF       ; Stash the character on the stack.
 $639C LD A,($5B8A)  ; {Jump to #R$63AF if *#R$5B8A is not #N$01.
 $639F CP $01        ;
 $63A1 JR NZ,$63AF   ; }
; Rub out a previous space.
@label=PrintCharacter_Rub
*$63A3 LD A,($5B9C)  ; {Jump to #R$63AF if *#R$5B9C is not a space.
 $63A6 CP $20        ;
 $63A8 JR NZ,$63AF   ; }
 $63AA LD A,$0C      ; {Rub it out.
 $63AC CALL $63FC    ; }
; Plot this character.
@label=PrintCharacter_Keep
*$63AF POP AF        ; {Write it to *#R$5B9C.
 $63B0 LD ($5B9C),A  ; }
 $63B3 PUSH AF       ; {Stash the registers around the plot.
 $63B4 PUSH HL       ;
 $63B5 PUSH BC       ;
 $63B6 PUSH DE       ; }
 $63B7 CP $0D        ; {Jump to #R$63CC if this is not ENTER.
 $63B9 JR NZ,$63CC   ; }
 $63BB LD A,($5B8A)  ; {Copy *#R$5B8A into #REGb.
 $63BE LD B,A        ; }
; Pad the row to the margin.
@label=PrintCharacter_Pad
*$63BF INC B         ; One more column.
 $63C0 LD A,$2B      ; {Stop at column #N$2A.
 $63C2 CP B          ;
 $63C3 JR Z,$63CF    ; }
 $63C5 LD A,$20      ; {Print a pad space.
 $63C7 CALL $63FC    ; }
 $63CA JR $63BF      ; Jump to #R$63BF.
; Plot any other character.
@label=PrintCharacter_Plot
*$63CC CALL $63FC    ; Call #R$63FC.
; This entry point is used by the routines at #R$6319, #R$63D7 and #R$63E6.
; .
; Restore the registers.
@label=PrintCharacter_Done
*$63CF POP DE        ; {Restore the registers from the stack.
 $63D0 POP BC        ;
 $63D1 POP HL        ;
 $63D2 POP AF        ; }
 $63D3 RET           ; Return.

; Print System Message
;
; Used by the routines at #R$5ECB, #R$5FAA, #R$6187, #R$680C, #R$685B, #R$687F,
; #R$68B0 and #R$6924.
; .
; Prints system message A from #R$7E26. The messages are the game's stock
; replies: what you can see, what you are carrying, and why a command failed.
@label=PrintSystemMessage
c$63D4 LD B,A        ; {Jump to #R$63E6 with the message number in #REGb.
 $63D5 JR $63E6      ; }

; Print Object Name
;
; Used by the routines at #R$6187 and #R$680C.
; .
; Prints object text A from #R$8CE6, the phrases used when a location
; lists what is here.
@label=PrintObjectName
c$63D7 PUSH AF       ; {Stash the registers the printer will use.
 $63D8 PUSH HL       ;
 $63D9 PUSH BC       ;
 $63DA PUSH DE       ; }
 $63DB LD ($5B8F),A  ; Write it to *#R$5B8F.
 $63DE LD HL,$8CE6   ; Point #REGhl at #R$8CE6.
 $63E1 CALL $629D    ; Call #R$629D.
 $63E4 JR $63CF      ; Jump to #R$63CF to restore the registers and return.

; Print Numbered Message
;
; Used by the routine at #R$63D4.
; .
; Prints message B from #R$7E26, forcing a capital at the start.
@label=PrintNumberedMessage
c$63E6 PUSH AF       ; {Stash the registers the printer will use.
 $63E7 PUSH HL       ;
 $63E8 PUSH BC       ;
 $63E9 PUSH DE       ; }
 $63EA LD A,$2E      ; {A full stop makes the first letter a capital.
 $63EC LD ($5B9B),A  ; }
 $63EF LD A,B        ; {#REGb is the system message number.
 $63F0 LD ($5B8F),A  ; }
 $63F3 LD HL,$7E26   ; Point #REGhl at #R$7E26.
 $63F6 CALL $629D    ; Call #R$629D.
 $63F9 JP $63CF      ; Jump to #R$63CF to restore the registers and return.

; Plot Character
;
; Used by the routines at #R$5F21, #R$6187, #R$6394 and #R$6A3C.
; .
; Puts A on the screen. #N$0C rubs out the previous character. #N$0D moves
; to the next row, pausing and scrolling when the text hits the bottom of the
; window.
;
; .
;
; DELETE is printed as a space and then another DELETE, so the cursor
; steps back.
@label=PlotCharacter
c$63FC CP $0C        ; {Jump to #R$640A if this is not DELETE.
 $63FE JR NZ,$640A   ; }
 $6400 CALL $640A    ; Call #R$640A.
 $6403 LD A,$20      ; {Plot a space.
 $6405 CALL $640A    ; }
 $6408 LD A,$0C      ; DELETE is the character that falls through.
; Plot this byte, or handle ENTER and DELETE.
@label=PlotCharacter_Byte
*$640A PUSH HL       ; {Save the screen address and the character.
 $640B PUSH BC       ;
 $640C PUSH DE       ;
 $640D PUSH AF       ; }
 $640E CP $0D        ; {ENTER starts a new row.
 $6410 JP Z,$6440    ; }
 $6413 CP $0C        ; {Anything except DELETE is a glyph.
 $6415 JR NZ,$6483   ; }
 $6417 LD A,($5B8A)  ; {Jump to #R$642B if *#R$5B8A is not zero.
 $641A OR A          ;
 $641B JR NZ,$642B   ; }
 $641D LD A,$29      ; {Write #N$29 to *#R$5B8A.
 $641F LD ($5B8A),A  ; }
 $6422 LD A,($5B89)  ; {Decrement *#R$5B89.
 $6425 DEC A         ;
 $6426 LD ($5B89),A  ; }
 $6429 JR $6436      ; Jump to #R$6436.
; Step one column left.
@label=PlotCharacter_Back
*$642B DEC A         ; {Decrement *#R$5B8A.
 $642C LD ($5B8A),A  ; }
 $642F AND %00000011 ; Keep only bits 0-1.
 $6431 CP $02        ; {Jump to #R$6546 if the column is #N$02.
 $6433 JP Z,$6546    ; }
; Move the pixel address back one byte.
@label=PlotCharacter_Pixel
*$6436 LD HL,($5B87) ; {Decrement *#R$5B87.
 $6439 DEC HL        ;
 $643A LD ($5B87),HL ; }
 $643D JP $6546      ; Jump to #R$6546.
; This entry point is used by the routine at #R$6483.
; .
; ENTER on row #N$13 while a description is on screen waits for a key.
; Below the window, the text scrolls.
@label=PlotCharacter_Newline
*$6440 LD A,($5B89)  ; {Jump to #R$645C if *#R$5B89 is not #N$13.
 $6443 CP $13        ;
 $6445 JR NZ,$645C   ; }
 $6447 LD A,($6186)  ; {The pause only happens when #R$6186 is set.
 $644A OR A          ;
 $644B JR Z,$645C    ; }
 $644D LD A,$0D      ; {The pause row's bottom is #N$0D.
 $644F LD ($5B97),A  ; }
 $6452 CALL $6884    ; Call #R$6884.
 $6455 CALL $655E    ; Call #R$655E.
 $6458 LD A,$13      ; {Stay on row #N$13.
 $645A JR $6465      ; }
; Rows below the pause line.
@label=PlotCharacter_Low
*$645C CP $17        ; {A row below #N$17 simply advances.
 $645E JR C,$6472    ; }
 $6460 CALL $655E    ; Call #R$655E.
 $6463 LD A,$17      ; Stay on row #N$17.
; Stay on this row.
@label=PlotCharacter_Stay
*$6465 LD ($5B89),A  ; Write the row to #R$5B89.
 $6468 CALL $654B    ; Call #R$654B.
 $646B XOR A         ; {Write #N$00 to #R$5B8A.
 $646C LD ($5B8A),A  ; }
 $646F JP $6546      ; Jump to #R$6546.
; Advance one row.
@label=PlotCharacter_Down
*$6472 LD A,($5B89)  ; {Increment *#R$5B89.
 $6475 INC A         ;
 $6476 LD ($5B89),A  ; }
 $6479 CALL $654B    ; Call #R$654B.
 $647C XOR A         ; {Write #N$00 to #R$5B8A.
 $647D LD ($5B8A),A  ; }
 $6480 JP $6546      ; Jump to #R$6546.

; Plot Glyph
;
; Used by the routine at #R$63FC.
; .
; Draws character A at the print position, using the ROM font. The eight
; bytes are shifted into whichever pixel column the cursor occupies inside its
; display byte, then ORed into the screen.
;
; .
;
; The ROM character set lives at #SKOOLKID$3D00(CHARSET). Subtracting
; #N$0100 makes the character code times 8 land on its glyph.
@label=PlotGlyph
c$6483 LD DE,($5B87) ; Keep the screen address.
 $6487 LD BC,$3C00   ; The font is #SKOOLKID$3D00(CHARSET) minus #N$0100.
 $648A LD H,$00      ; {Character A, widened.
 $648C LD L,A        ; }
 $648D ADD HL,HL     ; {Times eight.
 $648E ADD HL,HL     ;
 $648F ADD HL,HL     ; }
 $6490 ADD HL,BC     ; Add the font base.
 $6491 PUSH DE       ; {Stash the screen address and the glyph address on the
 $6492 PUSH HL       ; stack.}
 $6493 LD DE,$6B23   ; Point #REGde at #R$6B23.
 $6496 LD BC,$0800   ; Eight bytes, with #REGc clear.
; Copy the glyph into the buffer.
@label=PlotGlyph_Copy
*$6499 LD A,(HL)     ; {Copy one byte of the glyph.
 $649A LD (DE),A     ; }
 $649B INC HL        ; {Step both pointers.
 $649C INC DE        ; }
 $649D BIT 1,A       ; {Jump to #R$64A3 if bit 1 is clear.
 $649F JR Z,$64A3    ; }
 $64A1 LD C,$FF      ; Mark a descender.
; The next glyph byte.
@label=PlotGlyph_Copied
*$64A3 DJNZ $6499    ; The next byte.
; Tip the glyph so it sits in the right-hand pixels of its byte. A
; descender in the source sets the marker in #REGc.
@label=PlotGlyph_Align
 $64A5 LD DE,$6B23   ; Point #REGde at #R$6B23.
 $64A8 LD B,$08      ; Eight glyph bytes.
; Shift one glyph row.
@label=PlotGlyph_Row
*$64AA LD A,(DE)     ; Fetch the glyph byte.
 $64AB RLA           ; Rotate it left.
 $64AC JR NC,$64B0   ; Jump to #R$64B0 if there is no carry.
 $64AE OR %10000000  ; Set bit 7.
; Merge the shifted nibbles.
@label=PlotGlyph_Nibble
*$64B0 BIT 0,C       ; {The descender marker shifts the glyph one place
 $64B2 JR Z,$64BE    ; further.}
 $64B4 LD H,A        ; Copy the byte.
 $64B5 AND %00001111 ; Keep only bits 0-3.
 $64B7 LD L,A        ; Store the low nibble.
 $64B8 LD A,H        ; Fetch the saved byte.
 $64B9 AND %11110000 ; Keep only bits 4-7.
 $64BB RL L          ; {Merge in the shifted low nibble.
 $64BD OR L          ; }
; Store the aligned byte.
@label=PlotGlyph_Mask
*$64BE AND %11111100 ; Keep only bits 2-7.
 $64C0 LD (DE),A     ; Store the aligned byte.
 $64C1 INC DE        ; Step on.
 $64C2 DJNZ $64AA    ; Jump to #R$64AA until eight rows are done.
 $64C4 POP HL        ; {Restore the glyph address and the screen address from
 $64C5 POP DE        ; the stack.}
 $64C6 LD HL,$6B23   ; Point #REGhl at #R$6B23.
 $64C9 EX DE,HL      ; Swap the buffer into #REGde.
 $64CA PUSH HL       ; Stash the screen address on the stack.
; The column within the byte chooses how the shifted glyph is merged with
; the pixels already there.
@label=PlotGlyph_Column
 $64CB LD A,($5B8A)  ; Fetch #R$5B8A.
 $64CE AND %00000011 ; Keep only bits 0-1.
 $64D0 DEC A         ; {Column 1 uses the two-pixel shift.
 $64D1 JR Z,$64E8    ; }
 $64D3 DEC A         ; {Column 2 uses the four-pixel shift.
 $64D4 JR Z,$6500    ; }
 $64D6 DEC A         ; {Column 3 keeps the top two pixels.
 $64D7 JR Z,$6525    ; }
 $64D9 LD B,$08      ; Column 0 copies eight fresh bytes.
; Copy eight unshifted bytes.
@label=PlotGlyph_Byte0
*$64DB LD A,(DE)     ; {Copy one glyph byte.
 $64DC LD (HL),A     ; }
 $64DD INC DE        ; {Step to the next pixel row.
 $64DE INC H         ; }
 $64DF DJNZ $64DB    ; All eight bytes.
; Advance the print address.
@label=PlotGlyph_Stored
*$64E1 POP HL        ; Restore the screen address from the stack.
 $64E2 INC HL        ; {Move the print address on one byte.
 $64E3 LD ($5B87),HL ; }
 $64E6 JR $6538      ; Jump to #R$6538 to advance the column.
; Shift two pixels.
@label=PlotGlyph_Byte1
*$64E8 LD B,$08      ; Count the #N$08 pixel rows of this glyph.
; Merge a two-pixel shift.
@label=PlotGlyph_Shift2
*$64EA LD A,(DE)     ; Fetch the glyph byte.
 $64EB DEC HL        ; Step back to the previous screen byte.
 $64EC SRL (HL)      ; {Make room for two pixels.
 $64EE SRL (HL)      ; }
 $64F0 SLA A         ; {Shift two pixels of the glyph in.
 $64F2 RL (HL)       ;
 $64F4 SLA A         ;
 $64F6 RL (HL)       ; }
 $64F8 INC HL        ; {Store the shifted byte.
 $64F9 LD (HL),A     ; }
 $64FA INC H         ; {The next pixel row.
 $64FB INC DE        ; }
 $64FC DJNZ $64EA    ; All eight.
 $64FE JR $64E1      ; Jump to #R$64E1.
; Shift four pixels.
@label=PlotGlyph_Byte2
*$6500 LD B,$08      ; Count the #N$08 pixel rows of this glyph.
; Merge a four-pixel shift.
@label=PlotGlyph_Shift4
*$6502 LD A,(DE)     ; Fetch the glyph byte.
 $6503 DEC HL        ; Step back to the previous screen byte.
 $6504 SRL (HL)      ; {Make room for four pixels.
 $6506 SRL (HL)      ;
 $6508 SRL (HL)      ;
 $650A SRL (HL)      ; }
 $650C SLA A         ; {Shift the first two pixels in.
 $650E RL (HL)       ;
 $6510 SLA A         ;
 $6512 RL (HL)       ; }
 $6514 SLA A         ; {Shift the other two pixels in.
 $6516 RL (HL)       ;
 $6518 SLA A         ;
 $651A RL (HL)       ; }
 $651C INC HL        ; {Store the shifted byte on this pixel row.
 $651D LD (HL),A     ; }
 $651E INC H         ; {The next pixel row.
 $651F INC DE        ; }
 $6520 DJNZ $6502    ; All eight.
 $6522 POP HL        ; Restore the screen address from the stack.
 $6523 JR $6538      ; Jump to #R$6538.
; Keep the top two pixels.
@label=PlotGlyph_Byte3
*$6525 LD B,$08      ; Count the #N$08 pixel rows of this glyph.
; Merge a six-pixel shift.
@label=PlotGlyph_Top
*$6527 LD A,$C0      ; {Keep the top two pixels already on screen.
 $6529 AND (HL)      ;
 $652A LD (HL),A     ; }
 $652B LD A,(DE)     ; Fetch the glyph byte.
 $652C SRL A         ; {Shift it right by two.
 $652E SRL A         ; }
 $6530 OR (HL)       ; {#HTML(Merge the shifted glyph into the screen byte with
 $6531 LD (HL),A     ; <code>OR</code>.)}
 $6532 INC H         ; {Step both pointers.
 $6533 INC DE        ; }
 $6534 DJNZ $6527    ; Jump to #R$6527 until eight pixel rows are done.
 $6536 JR $64E1      ; Jump to #R$64E1.
; The next character moves one column right. Column #N$29 is the margin,
; so the cursor wraps.
@label=PlotGlyph_Advance
*$6538 POP AF        ; {Keep the character on the stack.
 $6539 PUSH AF       ; }
 $653A LD A,($5B8A)  ; Fetch #R$5B8A.
 $653D CP $29        ; {Column #N$29 wraps to the next row.
 $653F JP Z,$6440    ; }
 $6542 INC A         ; {Otherwise the cursor moves one column right.
 $6543 LD ($5B8A),A  ; }
; This entry point is used by the routine at #R$63FC.
; .
; Restore the registers.
@label=PlotGlyph_Done
*$6546 POP AF        ; {Restore the registers saved around the glyph from the
 $6547 POP DE        ; stack.
 $6548 POP BC        ;
 $6549 POP HL        ; }
 $654A RET           ; Return.

; Home Cursor On A Row
;
; Used by the routines at #R$600F, #R$6187 and #R$63FC.
; .
; Moves the cursor to the left of the row in #R$5B89.
@label=HomeRow
c$654B LD A,($5B89)  ; Fetch #R$5B89.
 $654E CALL $5F16    ; Call #R$5F16.
 $6551 XOR A         ; {Write #N$00 to #R$5B8A.
 $6552 LD ($5B8A),A  ; }
 $6555 LD ($5B87),DE ; Store it in #R$5B87.
 $6559 RET           ; Return.

; Key Repeat Timer
;
; How long to wait before scrolling, measured against the ROM frame
; counter. The cursor keys store #N($00), #N$0190 or #N$C8 here.
@label=RepeatTimer
w$655A DEFW $00C8    ; Delay.
; Rows already scrolled.
@label=RowsScrolled
 $655C DEFW $0000    ; Rows already scrolled.

; Scroll Text Window
;
; Used by the routine at #R$63FC.
; .
; Moves every pixel row of the text window up by one character and clears
; the bottom row. During a description the picture is left where it is.
;
; .
;
; A short delay, taken from #R$655A, lets the player read before the next
; scroll.
@label=ScrollWindow
c$655E LD A,($5B97)  ; {Copy #R$5B97 into #REGb.
 $6561 LD B,A        ; }
 $6562 LD A,$16      ; {Blank lines left are #N$16 minus that row.
 $6564 SUB B         ;
 $6565 LD B,A        ; }
 $6566 LD A,($655C)  ; {Fewer scrolls than blank lines means scroll now.
 $6569 CP B          ;
 $656A JR C,$6582    ; }
 $656C LD HL,($655A) ; {Otherwise copy the repeat delay into the frame counter,
 $656F LD ($5C78),HL ; #SKOOLKID$5C78(FRAMES).}
; Wait for a key or the delay.
@label=ScrollWindow_Wait
*$6572 LD A,($5C04)  ; {A key releases the pause.
 $6575 CP $FF        ;
 $6577 JR NZ,$6582   ; }
 $6579 CALL $0052    ; #HTML(Call the <code>RET</code> at the end of
                     ; #SKOOLKID$0038(MASK_INT).)
 $657C LD A,($5C79)  ; {Jump to #R$6572 until #SKOOLKID$5C78,$5C79(FRAMES) has
 $657F OR A          ; moved.
 $6580 JR Z,$6572    ; }
; Scroll the window up one character.
@label=ScrollWindow_Row
*$6582 LD HL,$655C   ; Point #REGhl at #R$655C.
 $6585 INC (HL)      ; Count this scroll.
 $6586 LD A,($5B97)  ; Fetch #R$5B97.
; Copy one character row onto the row above.
@label=ScrollWindow_Up
*$6589 CALL $5F16    ; Call #R$5F16.
 $658C PUSH DE       ; Keep this row.
 $658D INC A         ; The next character row.
 $658E CALL $5F16    ; Call #R$5F16.
 $6591 EX DE,HL      ; {That address is the destination.
 $6592 POP DE        ; }
 $6593 LD B,$08      ; Count the #N$08 pixel rows of this character.
; Copy eight pixel rows.
@label=ScrollWindow_Pixels
*$6595 PUSH HL       ; {Save the row pair.
 $6596 PUSH BC       ;
 $6597 PUSH DE       ; }
 $6598 LD BC,$0020   ; {Copy one pixel row, #N($0020,$04,$04) bytes.
 $659B LDIR          ; }
 $659D POP DE        ; {Restore the row pair from the stack.
 $659E POP BC        ;
 $659F POP HL        ; }
 $65A0 INC H         ; {The next pixel row.
 $65A1 INC D         ; }
 $65A2 DJNZ $6595    ; All eight pixel rows.
 $65A4 CP $13        ; {Row #N$13 is the pause row.
 $65A6 JR Z,$65AE    ; }
 $65A8 CP $17        ; {Row #N$17 is the bottom of the window.
 $65AA JR NZ,$6589   ; }
 $65AC JR $65BE      ; Otherwise the blank line is the bottom row.
; Blank the pause row during a description.
@label=ScrollWindow_Pause
*$65AE PUSH AF       ; Stash #REGaf on the stack.
 $65AF LD A,($6186)  ; {Jump to #R$65BB if a description is not in progress.
 $65B2 OR A          ;
 $65B3 JR Z,$65BB    ; }
 $65B5 POP AF        ; Restore #REGaf from the stack.
 $65B6 LD HL,$5060   ; The blank line is at #N$5060 (screen buffer).
 $65B9 JR $65C1      ; Clear that line.
; Keep copying rows.
@label=ScrollWindow_More
*$65BB POP AF        ; Restore #REGaf from the stack.
 $65BC JR $6589      ; Jump to #R$6589.
; Blank the bottom of the window.
@label=ScrollWindow_Bottom
*$65BE LD HL,$50E0   ; The ordinary blank line is at #N$50E0 (screen buffer).
; Clear the vacated row.
@label=ScrollWindow_Clear
*$65C1 PUSH HL       ; {Copy #REGhl to #REGde (using the stack).
 $65C2 POP DE        ; }
 $65C3 INC DE        ; Advance the destination.
 $65C4 LD B,$08      ; Count the #N$08 pixel rows to blank.
; Wipe eight pixel rows.
@label=ScrollWindow_Wipe
*$65C6 PUSH DE       ; {Save the row.
 $65C7 PUSH HL       ;
 $65C8 PUSH BC       ; }
 $65C9 LD (HL),$00   ; Write a zero.
 $65CB LD BC,$001F   ; {Copy it across the rest of the row.
 $65CE LDIR          ; }
 $65D0 POP BC        ; {Restore the row from the stack.
 $65D1 POP HL        ;
 $65D2 POP DE        ; }
 $65D3 INC H         ; {The next pixel row.
 $65D4 INC D         ; }
 $65D5 DJNZ $65C6    ; All eight.
 $65D7 LD A,($6186)  ; {A paused description leaves the cursor on the pause
 $65DA OR A          ; row.
 $65DB JR Z,$65E2    ; }
 $65DD LD HL,$5060   ; That row is #N$5060 (screen buffer).
 $65E0 JR $65E5      ; Home there.
; Home the cursor after the scroll.
@label=ScrollWindow_Home
*$65E2 LD HL,$50E0   ; Otherwise the cursor sits on #N$50E0 (screen buffer).
; Store the print address.
@label=ScrollWindow_Cursor
*$65E5 LD ($5B87),HL ; Write #REGhl to *#R$5B87.
 $65E8 XOR A         ; {Write #N$00 to #R$5B8A.
 $65E9 LD ($5B8A),A  ; }
 $65EC RET           ; Return.

; Clear Rows Under Picture
;
; Used by the routines at #R$6187 and #R$662D.
; .
; Blanks the pixel rows down to the bottom of the text window. Pictures on
; start at row #N($0C), under the illustration. Pictures off start at row 0.
@label=ClearLowerRows
c$65ED LD A,($66D6)  ; {Pictures off start clearing at row 0.
 $65F0 OR A          ;
 $65F1 JR Z,$65F5    ; }
 $65F3 LD A,$0C      ; Pictures on start at row #N$0C.
; Pictures off wrap the start row.
@label=ClearLower_Adjust
*$65F5 DEC A         ; Pictures off arrive here with zero, so this wraps to
                     ; #N$FF.
; Blank one character row.
@label=ClearLower_Row
*$65F6 INC A         ; The increment restores row 0, or restores #N$0C when pictures are
                     ; on.
 $65F7 LD HL,$5B97   ; Point #REGhl at #R$5B97.
 $65FA LD B,(HL)     ; Fetch *#R$5B97 into #REGb.
 $65FB CP B          ; {Return if this row has reached it.
 $65FC RET Z         ; }
 $65FD CALL $5F16    ; Call #R$5F16.
 $6600 PUSH DE       ; {Copy #REGde to #REGhl (using the stack).
 $6601 POP HL        ; }
 $6602 INC DE        ; {Eight pixel rows, filled from the next byte.
 $6603 LD B,$08      ; }
; Blank eight pixel rows.
@label=ClearLower_Pixel
*$6605 PUSH HL       ; {Save the row.
 $6606 PUSH DE       ;
 $6607 PUSH BC       ; }
 $6608 LD BC,$001F   ; #N($001F,$04,$04) more bytes.
 $660B LD (HL),$00   ; {Write #N$00 across the rest of the row.
 $660D LDIR          ; }
 $660F POP BC        ; {Restore the row from the stack.
 $6610 POP DE        ;
 $6611 POP HL        ; }
 $6612 INC D         ; {The next pixel row.
 $6613 INC H         ; }
 $6614 DJNZ $6605    ; All eight.
 $6616 JR $65F6      ; The next character row.

; Clear Screen
;
; Used by the routine at #R$600F.
; .
; Blanks the display and paints the attributes white on black.
@label=ClearScreen
c$6618 LD HL,$4000   ; Point #REGhl at #N$4000 (screen buffer).
 $661B LD DE,$4001   ; Point #REGde at the next byte.
 $661E LD BC,$1800   ; #N$1800 pixel bytes.
 $6621 LD (HL),$00   ; {Fill them with zero.
 $6623 LDIR          ; }
 $6625 LD (HL),$38   ; Paint this attribute #COLOUR$38.
 $6627 LD BC,$02FF   ; {Copy it across the block.
 $662A LDIR          ; }
 $662C RET           ; Return.

; Wait For Key
;
; Waits until the interrupt routine has seen a new key, ignores the
; characters the printer uses as terminators, and treats EDIT as the picture
; switch. The cursor keys change how long a scroll waits.
;
; O:A The key, with letters as typed
;
; #HTML(Bit 5 of #SKOOLKID$5C3B(FLAGS) is set by the maskable interrupt
; when a new key is ready. Calling the <code>RET</code> at the end of that
; routine lets one interrupt through.)
@label=WaitForKey
c$662D CALL $0052     ; #HTML(Call the <code>RET</code> at the end of
                      ; #SKOOLKID$0038(MASK_INT).)
 $6630 SET 3,(IY+$30) ; Set bit 3 of #SKOOLKID$5C6A(FLAGS2) (CAPS LOCK).
 $6634 BIT 5,(IY+$01) ; {Jump to #R$662D until bit 5 of #SKOOLKID$5C3B(FLAGS)
 $6638 JR Z,$662D     ; is set.}
 $663A RES 5,(IY+$01) ; Clear that bit for the next wait.
 $663E LD A,R         ; Read #REGr.
 $6640 AND %00000111  ; Keep only bits 0-2.
 $6642 INC A          ; {Write #REGr+#N$01 into the signature at #R$676E.
 $6643 LD ($676E),A   ; }
 $6646 LD IX,$676E    ; Point #REGix at #R$676E.
 $664A LD A,($676E)   ; {Plant that stirred byte over the displacement at
 $664D LD ($6655),A   ; #R$6653(#N$6655).}
 $6650 LD A,R         ; {Mix #REGr in again.
 $6652 ADD A,A        ;
 $6653 LD (IX+$00),A  ; }
 $6656 PUSH BC        ; Stash #REGbc on the stack.
 $6657 LD B,$05       ; Five passes.
 $6659 PUSH DE        ; {Save #REGde, #REGhl and #REGix.
 $665A PUSH HL        ;
 $665B PUSH IX        ; }
 $665D LD A,$1E       ; {Sound the key click with #REGa equal to #N$1E.
 $665F CALL $6AC4     ; }
 $6662 POP IX         ; {Restore the caller's registers from the stack.
 $6664 POP HL         ;
 $6665 POP DE         ;
 $6666 POP BC         ; }
; Cursor keys change the scroll delay.
@label=WaitForKey_Cursor
 $6667 LD A,($5C08)   ; #REGa is #SKOOLKID$5C08(LAST_K).
 $666A PUSH HL        ; Stash #REGhl on the stack.
 $666B CP $C7         ; {Cursor key #N$C7 stores no scroll delay.
 $666D LD HL,$0000    ;
 $6670 JR Z,$6680     ; }
 $6672 CP $C9         ; {Cursor key #N$C9 stores a long delay, #N$0190.
 $6674 LD HL,$0190    ;
 $6677 JR Z,$6680     ; }
 $6679 CP $C8         ; {Cursor key #N$C8 stores a short delay,
 $667B LD HL,$00C8    ; #N($00C8,$04,$04).
 $667E JR NZ,$6683    ; }
; Store the delay.
@label=WaitForKey_Delay
*$6680 LD ($655A),HL  ; Store the delay at #R$655A.
; Ignore printer terminators.
@label=WaitForKey_Ignore
*$6683 POP HL         ; Restore the key from the stack.
 $6684 CP $5E         ; {Jump to #R$662D if it is #N$5E.
 $6686 JR Z,$662D     ; }
 $6688 CP $5F         ; {Jump to #R$662D if it is #N$5F.
 $668A JR Z,$662D     ; }
 $668C CP $7F         ; {Jump to #R$662D if it is #N$7F.
 $668E JR Z,$662D     ; }
 $6690 CP $7E         ; {Jump to #R$662D if it is #N$7E.
 $6692 JR Z,$662D     ; }
; EDIT toggles the picture. The illustration attributes are cleared when
; pictures turn off, and the room is redrawn from bank 0.
@label=WaitForKey_Pictures
 $6694 CP $0E         ; {EDIT is #N$0E. Any other key returns.
 $6696 RET NZ         ; }
 $6697 PUSH BC        ; {Stash the registers around the redraw.
 $6698 PUSH DE        ;
 $6699 PUSH HL        ; }
 $669A CALL $65ED     ; Call #R$65ED.
 $669D LD HL,$66D6    ; Point #REGhl at #R$66D6.
 $66A0 LD A,(HL)      ; {Call #R$66D8 if pictures are currently on.
 $66A1 OR A           ;
 $66A2 CALL NZ,$66D8  ; }
 $66A5 XOR %00000001  ; Flip bit 0.
 $66A7 LD (HL),A      ; Write the new picture flag to *#R$66D6.
 $66A8 XOR A          ; {#PAGE$00.
 $66A9 CALL $66BD     ; }
; Redraw the room.
 $66AC CALL $6B43     ; Call #R$6B43.
 $66AF LD A,$03       ; {Page RAM bank #N$03 back in.
 $66B1 CALL $66BA     ; }
 $66B4 POP HL         ; {Restore the registers from the stack.
 $66B5 POP DE         ;
 $66B6 POP BC         ; }
; Read the next key.
 $66B7 JP $662D       ; Jump to #R$662D.

; Remember Paged Bank
;
; Used by the routines at #R$662D and #R$66C7.
; .
; Stores A in #R$66D7 and pages that RAM bank in.
@label=RememberBank
c$66BA LD ($66D7),A  ; Write #REGa to #R$66D7.
; Continue on to #R$66BD.

; Page RAM Bank
;
; Used by the routines at #R$6187 and #R$662D.
; .
; Selects RAM bank #REGa at #N$C000 and forces the 48K ROM, which is the
; ROM this game's calls expect. #REGa is the bank in the low three bits. Callers
; pass 0, 3 or 6. Bank 7, which the loader paged with OUT 32765,23, is never
; requested again.
@label=PageBank
c$66BD PUSH BC       ; Stash #REGbc on the stack.
 $66BE LD BC,$7FFD   ; Point #REGbc at port #N$7FFD.
 $66C1 OR %00010000  ; Keep bit 4 set (48K ROM).
 $66C3 OUT (C),A     ; Write the page to port #N$7FFD.
 $66C5 POP BC        ; Restore #REGbc from the stack.
 $66C6 RET           ; Return.

; Read Command
;
; Used by the routine at #R$5ECB.
; .
; Pages the parser in bank 3 over #N($C000), calls it, then pages bank 0
; back so the picture data is visible again.
@label=ReadCommand
c$66C7 LD A,$03      ; {Call #R$66BA using #PAGE$03.
 $66C9 CALL $66BA    ; }
 $66CC CALL $C000    ; Call #R$C000@bank3(ReadCommand).
 $66CF PUSH AF       ; Stash #REGaf on the stack.
 $66D0 XOR A         ; {Call #R$66BA using #PAGE$00.
 $66D1 CALL $66BA    ; }
 $66D4 POP AF        ; Restore #REGaf from the stack.
 $66D5 RET           ; Return.

; Pictures On
;
; Non-zero when illustrations are drawn. EDIT toggles it. It starts on.
@label=PicturesOn
g$66D6 DEFB $01

; Bank Paged In
;
; The last value passed to #R$66BA. It starts at #N($10), so the resting
; window is bank 0 with the 48K ROM bit already set. #R$66BD sets that bit again
; before the port write.
@label=PagedBank
g$66D7 DEFB $10

; Clear Illustration Colours
;
; Used by the routine at #R$662D.
; .
; Paints the top twelve character rows black ink on white paper, which is
; the area the illustration occupies.
@label=ClearPictureAttributes
c$66D8 PUSH AF       ; {Stash #REGaf and #REGhl on the stack.
 $66D9 PUSH HL       ; }
 $66DA LD HL,$5800   ; Point #REGhl at #N$5800 (attribute buffer).
 $66DD LD BC,$0180   ; #N$0180 bytes, the top twelve rows.
; Paint one attribute byte.
@label=ClearPicture_Byte
*$66E0 LD (HL),$38   ; Paint one attribute #COLOUR$38.
 $66E2 INC HL        ; {Step on.
 $66E3 DEC BC        ; }
 $66E4 LD A,B        ; {Continue until the block is done.
 $66E5 OR C          ;
 $66E6 JR NZ,$66E0   ; }
 $66E8 POP HL        ; {Restore #REGhl and #REGaf from the stack.
 $66E9 POP AF        ; }
 $66EA RET           ; Return.

; Condition: Room Is Parameter
;
; Passes when the current room is the parameter in #REGb.
;
;   B Room number
; O:F The zero flag is set when *#R$5D87 is the parameter
@label=RoomIs
c$66EB LD A,($5D87)  ; {Jump to #R$6753 to reject this bytecode condition
 $66EE CP B          ; when *#R$5D87 is not the parameter.
 $66EF JR NZ,$6753   ; }
 $66F1 RET           ; Return.

; Condition: Room Is Not Parameter
;
; Passes when the current room is not the parameter in #REGb.
;
;   B Room number
; O:F The zero flag is unset on a pass return
@label=RoomIsNot
c$66F2 LD A,($5D87)  ; {Jump to #R$6753 to reject this bytecode condition
 $66F5 CP B          ; when *#R$5D87 is the parameter.
 $66F6 JR Z,$6753    ; }
 $66F8 RET           ; Return.

; Condition: Room Above Parameter
;
; Passes when the current room is higher than the parameter in #REGb.
;
;   B Room number
; O:F Carry and zero are unset on a pass return
@label=RoomAbove
c$66F9 LD A,($5D87)  ; {Jump to #R$6753 to reject this bytecode condition
 $66FC CP B          ; when *#R$5D87 is not above the parameter.
 $66FD JR Z,$6753    ;
 $66FF JR C,$6753    ; }
 $6701 RET           ; Return.

; Condition: Room Below Parameter
;
; Passes when the current room is lower than the parameter in #REGb.
;
;   B Room number
; O:F Carry is set when *#R$5D87 is below the parameter
@label=RoomBelow
c$6702 LD A,($5D87)  ; {Jump to #R$6753 to reject this bytecode condition
 $6705 CP B          ; when *#R$5D87 is not below the parameter.
 $6706 JR NC,$6753   ; }
 $6708 RET           ; Return.

; Condition: Carrying, Wearing Or Here
;
; Passes when the object is carried, worn, or in this room.
;
;   C Object location
; O:F The zero flag is set when the object is carried, worn or here
@label=HoldingOrHere
c$6709 LD A,($5D89)  ; {Pass when it is *#R$5D89.
 $670C CP C          ;
 $670D RET Z         ; }
 $670E LD A,($5D8A)  ; {Pass when it is *#R$5D8A.
 $6711 CP C          ;
 $6712 RET Z         ; }
; Continue on to #R$6713.

; Condition: Object Is Here
;
; Loads *#R$5D87 as the location to match.
;
;   C Object location
; O:F The zero flag is set when the object is *#R$5D87
@label=IsHere
c$6713 LD A,($5D87)  ; Fetch #R$5D87.
; Continue on to #R$6716.

; Condition: Location Is Parameter
;
; Passes when the object's location equals #REGa.
;
;   A Location to match
;   C Object location
; O:F The zero flag is set when the location equals #REGa
;
; Compare the object's location with #REGa.
@label=LocationIsParameter
c$6716 CP C          ; {Jump to #R$6753 to reject this bytecode condition
 $6717 JR NZ,$6753   ; when it is not #REGa.}
 $6719 RET           ; Return.

; Condition: Not Carrying, Wearing Or Here
;
; Passes when the object is neither carried, nor worn, nor in this room.
;
;   C Object location
; O:F The zero flag is unset on a pass return
@label=NotHoldingOrHere
c$671A LD A,($5D89)  ; {Jump to #R$6753 to reject this bytecode condition
 $671D CP C          ; when it is *#R$5D89.
 $671E JR Z,$6753    ; }
 $6720 LD A,($5D8A)  ; {Jump to #R$6753 to reject this bytecode condition
 $6723 CP C          ; when it is *#R$5D8A.
 $6724 JR Z,$6753    ; }
; Continue on to #R$6726.

; Condition: Object Is Not Here
;
; Passes when the object is not in this room.
;
;   C Object location
; O:F The zero flag is unset on a pass return
@label=IsNotHere
c$6726 LD A,($5D87)  ; {Jump to #R$6753 to reject this bytecode condition
 $6729 CP C          ; when it is *#R$5D87.
 $672A JR Z,$6753    ; }
 $672C RET           ; Return.

; Condition: Object Is Somewhere
;
; Passes when the object's location is not #N$FC.
;
;   C Object location
; O:F The zero flag is unset on a pass return
@label=Somewhere
c$672D LD A,$FC      ; {Jump to #R$6753 to reject this bytecode condition.
 $672F CP C          ;
 $6730 RET NZ        ;
 $6731 JR $6753      ; }

; Condition: Object Is Nowhere
;
; Passes when the object's location is #N$FC.
;
;   C Object location
; O:F The zero flag is set when the object is nowhere
@label=Nowhere
c$6733 LD A,$FC      ; {Jump to #R$6753 to reject this bytecode condition.
 $6735 CP C          ;
 $6736 RET Z         ;
 $6737 JR $6753      ; }

; Condition: Object Is Carried
;
; Passes when the object is the one being carried.
;
;   C Object location
; O:F The zero flag is set when the object is *#R$5D89
@label=IsCarried
c$6739 LD A,($5D89)  ; {Jump to #R$6753 to reject this bytecode condition
 $673C CP C          ; when it is not *#R$5D89.
 $673D RET Z         ;
 $673E JR $6753      ; }

; Condition: Object Is Worn
;
; Passes when the object is the one being worn.
;
;   C Object location
; O:F The zero flag is set when the object is *#R$5D8A
@label=IsWorn
c$6740 LD A,($5D8A)  ; {Jump to #R$6753 to reject this bytecode condition
 $6743 CP C          ; when it is not *#R$5D8A.
 $6744 RET Z         ;
 $6745 JR $6753      ; }

; Condition: Object Is Not Worn
;
; Passes when the object is not being worn.
;
;   C Object location
; O:F The zero flag is unset on a pass return
@label=IsNotWorn
c$6747 LD A,($5D8A)  ; {Jump to #R$6753 to reject this bytecode condition
 $674A CP C          ; when it is *#R$5D8A.
 $674B RET NZ        ;
 $674C JR $6753      ; }

; Condition: Object Is Not Carried
;
; Passes when the object is not being carried.
;
;   C Object location
; O:F The zero flag is unset on a pass return
@label=IsNotCarried
c$674E LD A,($5D89)  ; {Return if the object is not *#R$5D89.
 $6751 CP C          ;
 $6752 RET NZ        ; }
; Continue on to #R$6753.

; Condition: Reject
;
; Used by the routines at #R$66EB, #R$66F2, #R$66F9, #R$6702, #R$6716, #R$671A,
; #R$6726, #R$672D, #R$6733, #R$6739, #R$6740, #R$6747, #R$6759, #R$6760,
; #R$6767, #R$6777, #R$67A1, #R$67A9, #R$67B1, #R$67B8, #R$67BF and #R$67C6.
; .
; Marks the current script line as failed so its actions are not
; performed.
@label=RejectCondition
c$6753 LD A,$01      ; {Write #N$01 to *#R$5ECA.
 $6755 LD ($5ECA),A  ; }
 $6758 RET           ; Return.

; Condition: Counter #N$01 Equals Parameter
;
; Passes when #R$5B81 equals the parameter.
;
;   B Value
; O:F The zero flag is set when *#R$5B81 is the parameter
@label=Counter1Is
c$6759 LD A,($5B81)  ; {Jump to #R$6753 to reject this bytecode condition
 $675C CP B          ; when *#R$5B81 is not the parameter.
 $675D RET Z         ;
 $675E JR $6753      ; }

; Condition: Counter #N$02 Equals Parameter
;
; Passes when #R$5B82 equals the parameter.
;
;   B Value
; O:F The zero flag is set when *#R$5B82 is the parameter
@label=Counter2Is
c$6760 LD A,($5B82)  ; {Jump to #R$6753 to reject this bytecode condition
 $6763 CP B          ; when *#R$5B82 is not the parameter.
 $6764 RET Z         ;
 $6765 JR $6753      ; }

; Condition: Counter #N$03 Equals Parameter
;
; Passes when #R$5B83 equals the parameter.
;
;   B Value
; O:F The zero flag is set when *#R$5B83 is the parameter
@label=Counter3Is
c$6767 LD A,($5B83)  ; {Jump to #R$6753 to reject this bytecode condition
 $676A CP B          ; when *#R$5B83 is not the parameter.
 $676B RET Z         ;
 $676C JR $6753      ; }

; Adventure Signature
;
; The bytes spell ADVENTURE. The key routine and the random condition
; overwrite them and use the first byte as scratch.
@label=Signature
t$676E DEFM "ADVENTURE"

; Condition: Random
;
; Passes when a value stirred from the frame counter and the signature
; comes out below the parameter.
;
;   B Threshold
; O:F Carry is set when the stirred value is below the parameter
@label=RandomTest
c$6777 LD A,($676E)  ; {Plant the signature byte over the displacement at
 $677A LD ($6783),A  ; #R$6781(#N$6783).}
 $677D LD IX,$676E   ; Point #REGix at #R$676E.
 $6781 LD A,(IX+$00) ; Fetch the stirred byte.
 $6784 LD L,A        ; {Widen the stirred byte.
 $6785 LD H,$00      ; }
 $6787 ADD HL,HL     ; {Times four.
 $6788 ADD HL,HL     ; }
 $6789 PUSH HL       ; Stash that product on the stack.
 $678A ADD HL,HL     ; {Shift further.
 $678B ADD HL,HL     ;
 $678C ADD HL,HL     ; }
 $678D PUSH HL       ; Stash that product on the stack.
 $678E ADD HL,HL     ; Double once more.
 $678F POP DE        ; Restore the first product from the stack.
 $6790 ADD HL,DE     ; {Add both saved products. The mix is the byte times
 $6791 POP DE        ; #N$64.
 $6792 ADD HL,DE     ; }
 $6793 LD A,($5C78)  ; Fetch #SKOOLKID$5C78(FRAMES).
 $6796 AND %00000111 ; Keep only bits 0-2.
 $6798 INC A         ; {Write that value plus #N$01 into the signature at
 $6799 LD ($676E),A  ; #R$676E.}
 $679C LD A,H        ; {Jump to #R$6753 to reject this bytecode condition.
 $679D CP B          ;
 $679E JR NC,$6753   ; }
 $67A0 RET           ; Return.

; Condition: Flag Is Zero
;
; Passes when the flag byte selected by the parameter is zero.
;
;   B Flag number
; O:F The zero flag is set when the selected flag is zero
@label=FlagZero
c$67A1 CALL $67FF    ; Call #R$67FF.
 $67A4 LD A,(HL)     ; {Return with pass when the flag is zero.
 $67A5 OR A          ;
 $67A6 RET Z         ; }
 $67A7 JR $6753      ; Jump to #R$6753 to reject this bytecode condition.

; Condition: Flag Is Not Zero
;
; Passes when the flag byte selected by the parameter is not zero.
;
;   B Flag number
; O:F The zero flag is unset on a pass return
@label=FlagNotZero
c$67A9 CALL $67FF    ; Call #R$67FF.
 $67AC LD A,(HL)     ; {Return with pass when the flag is not zero.
 $67AD OR A          ;
 $67AE RET NZ        ; }
 $67AF JR $6753      ; Jump to #R$6753 to reject this bytecode condition.

; Condition: Flag Equals Parameter
;
; Passes when the selected flag equals #REGa.
;
;   A Value
;   B Flag number
; O:F The zero flag is set when the selected flag equals #REGa
@label=FlagEquals
c$67B1 CALL $67FF    ; Call #R$67FF.
 $67B4 CP (HL)       ; {Return with pass when the selected flag equals #REGa.
 $67B5 RET Z         ; }
 $67B6 JR $6753      ; Jump to #R$6753 to reject this bytecode condition.

; Condition: Flag Differs From Parameter
;
; Passes when the selected flag differs from #REGa.
;
;   A Value
;   B Flag number
; O:F The zero flag is unset on a pass return
@label=FlagDiffers
c$67B8 CALL $67FF    ; Call #R$67FF.
 $67BB CP (HL)       ; {Return with pass when the selected flag differs from
 $67BC RET NZ        ; #REGa.}
 $67BD JR $6753      ; Jump to #R$6753 to reject this bytecode condition.

; Condition: Flag Below Parameter
;
; Passes when the selected flag is below #REGa.
;
;   A Value
;   B Flag number
; O:F Carry is set when the selected flag is below #REGa
@label=FlagBelow
c$67BF CALL $67FF    ; Call #R$67FF.
 $67C2 CP (HL)       ; {Return with pass when the selected flag is below #REGa.
 $67C3 RET C         ; }
 $67C4 JR $6753      ; Jump to #R$6753 to reject this bytecode condition.

; Condition: Flag Not Below Parameter
;
; Passes when the selected flag is not below #REGa. The failing jump at
; #R$67CB is also the first word of the condition table, so condition 0 does not
; have a routine of its own.
;
;   A Value
;   B Flag number
; O:F Carry is unset when the selected flag is not below #REGa
@label=FlagNotBelow
c$67C6 CALL $67FF    ; Call #R$67FF.
 $67C9 CP (HL)       ; {Return with pass when the selected flag is not below
 $67CA RET NC        ; #REGa.}
 $67CB JR $6753      ; Jump to #R$6753 to reject this bytecode condition.

; Table: Condition Routines
;
; One address per bytecode condition, after the dummy first word that
; overlaps #R$67CB. The runner shifts the condition number and reads the address
; from here.
;
; .
;
; Condition #N($01+(#PC-$67CB)/$02).
@label=ConditionTable
w$67CD DEFW $66EB    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67CF DEFW $66F2    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67D1 DEFW $66F9    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67D3 DEFW $6702    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67D5 DEFW $6709    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67D7 DEFW $6713    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67D9 DEFW $671A    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67DB DEFW $6726    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67DD DEFW $6739    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67DF DEFW $674E    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67E1 DEFW $6740    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67E3 DEFW $6747    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67E5 DEFW $672D    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67E7 DEFW $6733    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67E9 DEFW $67A1    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67EB DEFW $67A9    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67ED DEFW $6759    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67EF DEFW $6760    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67F1 DEFW $6767    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67F3 DEFW $6777    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67F5 DEFW $67C6    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67F7 DEFW $67BF    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67F9 DEFW $67B1    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67FB DEFW $67B8    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".
 $67FD DEFW $6716    ; "#D(#PEEK(#PC)+$100*#PEEK(#PC+$01))".

; Address Flag
;
; Used by the routines at #R$67A1, #R$67A9, #R$67B1, #R$67B8, #R$67BF, #R$67C6,
; #R$69CD, #R$69DB, #R$69E2, #R$69F4, #R$69FE, #R$6A11 and #R$6A3C.
; .
; Returns the address of flag byte #REGb. The flag bytes begin at the
; current room.
;
;   B Flag number
; O:HL Flag byte #REGb
@label=FlagAddress
c$67FF LD HL,$5D87   ; Point #REGhl at #R$5D87.
; This entry point is used by the routine at #R$6807.
; .
; Add the flag number.
@label=FlagAddress_Add
*$6802 LD E,B        ; {Add the parameter in #REGb.
 $6803 LD D,$00      ;
 $6805 ADD HL,DE     ; }
 $6806 RET           ; Return.

; Address Object
;
; Used by the routines at #R$68B0, #R$68E4, #R$695D, #R$6965, #R$69BF, #R$6A16,
; #R$6A2F, #R$6A83 and #R$6AAD.
; .
; Returns the address of object #REGb's location byte.
;
;   B Object number
; O:HL Location of object #REGb
@label=ObjectAddress
c$6807 LD HL,$5DCA   ; Point #REGhl at #R$5DCA.
 $680A JR $6802      ; Jump to #R$6802.

; Action: Inventory
;
; Prints message #N($10), you are carrying the following, then every
; carried or worn object. Nothing carried says so. A worn object is marked with
; message #N$1E.
;
; .
;
; Print "you are carrying the following:".
@label=ListCarried
c$680C LD A,$10      ; {Print #R$7EB6 using #R$63D4.
 $680E CALL $63D4    ; }
 $6811 XOR A         ; {Write #N$00 to #R$5B7A.
 $6812 LD ($5B7A),A  ; }
 $6815 LD B,$A0      ; #N$A0 object slots.
 $6817 LD HL,$5DCA   ; Point #REGhl at #R$5DCA.
; Scan the object locations.
@label=ListCarried_Scan
*$681A LD A,($5D89)  ; {Call #R$6845 if it is *#R$5D89.
 $681D CP (HL)       ;
 $681E CALL Z,$6845  ; }
 $6821 LD A,($5D8A)  ; {Call #R$6845 if it is *#R$5D8A.
 $6824 CP (HL)       ;
 $6825 CALL Z,$6845  ; }
 $6828 INC HL        ; The next object.
 $6829 DJNZ $681A    ; Jump to #R$681A until every slot is done.
 $682B LD A,($5B7A)  ; {Jump to #R$6836 if *#R$5B7A is set.
 $682E OR A          ;
 $682F JR NZ,$6836   ; }
; Print "nothing at all.".
 $6831 LD A,$11      ; {Print #R$7EC5 using #R$63D4.
 $6833 JP $63D4      ; }
; Finish the inventory list.
@label=ListCarried_End
*$6836 LD A,$0C      ; {Two backspaces remove the trailing comma.
 $6838 CALL $6394    ;
 $683B LD A,$0C      ;
 $683D CALL $6394    ; }
 $6840 LD A,$2E      ; {A full stop ends the list.
 $6842 JP $6394      ; }
; Print one carried or worn object.
@label=ListCarried_One
*$6845 LD A,$A0      ; {The object id is #N$A0 minus the countdown.
 $6847 SUB B         ; }
 $6848 CALL $63D7    ; Call #R$63D7.
 $684B LD ($5B7A),A  ; Write it to *#R$5B7A.
 $684E LD A,($5D8A)  ; {Return if it is not *#R$5D8A.
 $6851 CP (HL)       ;
 $6852 RET NZ        ; }
 $6853 PUSH BC       ; Stash the countdown on the stack.
; Print " (worn),".
 $6854 LD A,$1E      ; {Print #R$7F64 using #R$63D4.
 $6856 CALL $63D4    ; }
 $6859 POP BC        ; Restore the countdown from the stack.
 $685A RET           ; Return.

; Action: Play Again
;
; Prints message #N($12), the game is over, and asks Y or N. Y starts
; again at #R$5ECB. N resets the machine.
;
; .
;
; Describe the ending.
@label=OfferAnotherGame
c$685B CALL $6187    ; Call #R$6187.
 $685E XOR A         ; {The picture may be drawn again.
 $685F LD ($6185),A  ; }
 $6862 CALL $6B15    ; Call #R$6B15.
; Print "game's now over. do you want to play again (Y/N) ?".
 $6865 LD A,$12      ; {Print #R$7ECD using #R$63D4.
 $6867 CALL $63D4    ; }
; Wait for Y or N.
@label=OfferAnotherGame_Key
*$686A CALL $6884    ; Call #R$6884.
 $686D CP $4E        ; {N (#N$4E) resets the Spectrum.
 $686F JR Z,$6878    ; }
 $6871 CP $59        ; {Any key but Y (#N$59) asks again.
 $6873 JR NZ,$686A   ; }
; Start another game.
 $6875 JP $5ECB      ; Jump to #R$5ECB.

; Reset Machine
;
; Used by the routine at #R$685B.
; .
; The answer N to 'play again' executes #SKOOLKID$0000(START),
; which restarts the Spectrum.
@label=ResetMachine
c$6878 RST $00       ; Jump to #SKOOLKID$0000(START).

; Action: Reject Line
;
; Used by the routine at #R$68B0.
; .
; Sets the condition-failed flag so the runner stops this line. GET and
; DROP use it after explaining why they cannot.
@label=RejectLine
c$6879 LD A,$01      ; {Write #N$01 to *#R$5ECA.
 $687B LD ($5ECA),A  ; }
 $687E RET           ; Return.

; Action: Press Any Key
;
; Used by the routine at #R$6902.
; .
; Prints message #N($14), press any key to continue, and waits until a key
; is down.
;
; .
;
; Print "press any key to continue.".
@label=PressAnyKey
c$687F LD A,$14      ; {Print #R$7EEF using #R$63D4.
 $6881 CALL $63D4    ; }
; Continue on to #R$6884.

; Wait For Key Down
;
; Used by the routines at #R$63FC, #R$685B and #R$6924.
; .
; Spins while the second key slot of #SKOOLKID$5C00(KSTATE) is #N($FF),
; which is the value it holds when nothing is pressed.
;
; O:A The key state
@label=WaitKeyDown
c$6884 PUSH HL       ; {Stash the registers around the wait.
 $6885 PUSH BC       ;
 $6886 PUSH DE       ; }
; Spin until a key is down.
@label=WaitKeyDown_Spin
*$6887 LD A,($5C04)  ; {Spin while the second key slot of
 $688A CP $FF        ; #SKOOLKID$5C00(KSTATE) is #N$FF.
 $688C JR Z,$6887    ; }
 $688E POP DE        ; {Restore the registers from the stack.
 $688F POP BC        ;
 $6890 POP HL        ; }
 $6891 RET           ; Return.

; Action: Move To Room
;
; Makes the parameter the current room and marks the room as changed.
;
; B Room number
@label=MoveToRoom
c$6892 LD A,B        ; {Write #REGb to *#R$5D87.
 $6893 LD ($5D87),A  ; }
 $6896 JP $696C      ; Jump to #R$696C.

; Action: Wait
;
; Pauses for B times #N$32 halted frames.
;
; B Count
@label=WaitAWhile
c$6899 LD A,$32      ; #N$32 frames, once for each count in #REGb.
; Halt until this batch of frames is done.
@label=WaitAWhile_Frame
*$689B HALT          ; {Halt for one frame.
 $689C DEC A         ;
 $689D JR NZ,$689B   ; }
 $689F DJNZ $6899    ; Repeat for the count in #REGb.
 $68A1 RET           ; Return.

; Action: Move To Object
;
; Makes the object's location the current room.
;
; B Object number
@label=MoveToObject
c$68A2 LD C,B        ; {Copy the object number into #REGbc.
 $68A3 LD B,$00      ; }
 $68A5 LD HL,$5DCA   ; {Point #REGhl at this object's location in #R$5DCA.
 $68A8 ADD HL,BC     ; }
 $68A9 LD A,(HL)     ; {Write it to *#R$5D87.
 $68AA LD ($5D87),A  ; }
; Describe the new room.
 $68AD JP $696C      ; Jump to #R$696C.

; Action: Get
;
; Picks the object up. It must be in the room, not already carried, and
; not worn. The carried id is written into the object's own location slot and
; the carried count increases.
;
; B Object number
; C Object location
@label=GetObject
c$68B0 LD A,($5D89)  ; {Jump to #R$68C2 if it is not *#R$5D89.
 $68B3 CP C          ;
 $68B4 JR NZ,$68C2   ; }
; Print "you already have it.".
 $68B6 LD A,$15      ; Print #R$7F00 using #R$63D4.
; This entry point is used by the routines at #R$68E4, #R$6A83 and #R$6AAD.
; .
; Print the refusal and reject the line.
@label=GetObject_Refuse
*$68B8 CALL $63D4    ; Call #R$63D4.
 $68BB XOR A         ; {Write #N$00 to #R$5B85.
 $68BC LD ($5B85),A  ; }
 $68BF JP $6879      ; Jump to #R$6879.
; Already worn.
@label=GetObject_Worn
*$68C2 LD A,($5D8A)  ; {Jump to #R$68CC if it is not *#R$5D8A.
 $68C5 CP C          ;
 $68C6 JR NZ,$68CC   ; }
; Print "you are wearing it.".
 $68C8 LD A,$1D      ; {Print #R$7F5C using #R$63D4.
 $68CA JR $68B8      ; }
; Take it if it is here.
@label=GetObject_Here
*$68CC LD A,($5D87)  ; {Jump to #R$68D6 if it is *#R$5D87.
 $68CF CP C          ;
 $68D0 JR Z,$68D6    ; }
; Print "sorry, I don't see it here.".
 $68D2 LD A,$16      ; {Print #R$7F09 using #R$63D4.
 $68D4 JR $68B8      ; }
; Pick the object up.
@label=GetObject_Take
*$68D6 CALL $6807    ; Call #R$6807.
 $68D9 LD A,($5D89)  ; {Write *#R$5D89 into the object's location.
 $68DC LD (HL),A     ; }
 $68DD LD HL,$5D8C   ; {Increment *#R$5D8C.
 $68E0 INC (HL)      ; }
; Describe the room again.
 $68E1 JP $696C      ; Jump to #R$696C.

; Action: Drop
;
; Puts a carried or worn object down in the current room. Message #N$17
; says you don't have it.
;
; B Object number
; C Object location
@label=DropObject
c$68E4 LD A,($5D8A)  ; {Jump to #R$68F8 if it is *#R$5D8A.
 $68E7 CP C          ;
 $68E8 JR Z,$68F8    ; }
 $68EA LD A,($5D89)  ; {Jump to #R$68F4 if it is *#R$5D89.
 $68ED CP C          ;
 $68EE JR Z,$68F4    ; }
; Print "you don't have it.".
 $68F0 LD A,$17      ; {Print #R$7F1B using #R$63D4.
 $68F2 JR $68B8      ; }
; Count one fewer carried object.
@label=DropObject_Count
*$68F4 LD HL,$5D8C   ; {Decrement *#R$5D8C.
 $68F7 DEC (HL)      ; }
; Put the object in this room.
@label=DropObject_Put
*$68F8 CALL $6807    ; Call #R$6807.
 $68FB LD A,($5D87)  ; {Write *#R$5D87 into its location.
 $68FE LD (HL),A     ; }
; Describe the room again.
 $68FF JP $696C      ; Jump to #R$696C.

; Action: Save
;
; Asks for a key, then writes #N$0141 bytes from the room state as a SAVE
; block named with marker #N$2A. The ROM returns to #R$6914.
@label=SaveGame
c$6902 CALL $687F    ; Call #R$687F.
 $6905 LD IX,$5D87   ; Point #REGix at the state.
 $6909 LD DE,$0141   ; #N$0141 bytes.
 $690C LD HL,$6914   ; The return address is #R$6914.
 $690F LD A,$2A      ; Marker #N($2A).
 $6911 JP $04C5      ; Jump into #SKOOLKID$04C2,$04C5(SA_BYTES) at #N$04C5.

; Return From Saving
;
; Used by the routine at #R$6953.
; .
; Comes back from the ROM save. The border is turned white, the break flag
; is cleared, and the picture is allowed to be drawn again.
@label=Saved
c$6914 LD A,$07       ; {Set the border to #INK$07.
 $6916 OUT ($FE),A    ; }
 $6918 RES 0,(IY+$02) ; Clear the break flag.
 $691C EI             ; Enable interrupts.
 $691D XOR A          ; {Forget the drawn picture so it can be drawn again.
 $691E LD ($6185),A   ; }
; Describe the room again.
 $6921 JP $696C       ; Jump to #R$696C.

; Action: Restore
;
; Asks message #N($1A), do you want to restore a saved game. N returns. Y
; loads #N$0141 bytes back over the room state and jumps into the ROM loader.
;
; .
;
; Print "do you want to restore a saved game ?".
@label=RestoreGame
c$6924 LD A,$1A      ; Print #R$7F3C using #R$63D4.
 $6926 LD ($6A81),IX ; Store the pointer at #R$6A81.
 $692A CALL $63D4    ; Call #R$63D4.
; Wait for Y or N.
@label=RestoreGame_Key
*$692D CALL $6884    ; Call #R$6884.
 $6930 CP $4E        ; {N (#N$4E) leaves the saved game alone.
 $6932 JR Z,$6938    ; }
 $6934 CP $59        ; {Anything except Y (#N$59) asks again.
 $6936 JR NZ,$692D   ; }
; Load the saved state.
@label=RestoreGame_Load
*$6938 CP $4E        ; {N returns without loading.
 $693A RET Z         ; }
 $693B LD HL,$6953   ; Point #REGhl at #R$6953.
 $693E LD IX,$5D87   ; Point #REGix at the state block.
 $6942 LD DE,$0141   ; #N$0141 bytes.
 $6945 LD A,$2A      ; Marker #N($2A).
 $6947 SCF           ; Set carry.
 $6948 INC D         ; {The border dance around the alternate accumulator.
 $6949 EX AF,AF'     ;
 $694A DEC D         ; }
 $694B DI            ; Disable interrupts.
 $694C LD A,$0F      ; {Border yellow.
 $694E OUT ($FE),A   ; }
 $6950 JP $0561      ; Jump into #SKOOLKID$0556,$0561(LD_BYTES) at #N$0561.

; Return From Loading
;
; Comes back from the ROM loader. A failed load starts a new game; a
; successful one joins the save-return path.
@label=Restored
c$6953 EI            ; Enable interrupts.
 $6954 LD A,$07      ; {Set the border to #INK$07.
 $6956 OUT ($FE),A   ; }
 $6958 JP NC,$5ECB   ; Jump to #R$5ECB when the load failed.
 $695B JR $6914      ; Jump to #R$6914.

; Action: Remove Object
;
; Puts the object nowhere by storing #N($FC), then marks the room changed.
;
; B Object number
@label=RemoveObject
c$695D CALL $6807    ; Call #R$6807.
 $6960 LD A,$FC      ; {Write #N($FC) to its location.
 $6962 LD (HL),A     ; }
 $6963 JR $696C      ; Jump to #R$696C.

; Action: Put Object Here
;
; Stores the current room as the object's location.
;
; B Object number
@label=PutObjectHere
c$6965 CALL $6807    ; Call #R$6807.
 $6968 LD A,($5D87)  ; {Write *#R$5D87 into its location.
 $696B LD (HL),A     ; }
; Continue on to #R$696C.

; Action: Room Changed
;
; Used by the routines at #R$6892, #R$68A2, #R$68B0, #R$68E4, #R$6914, #R$695D,
; #R$69BF, #R$6A16, #R$6A68 and #R$6B43.
; .
; Sets the room-changed flag and walks the per-room records at #R$B798 so
; an illustration that depended on an object is redrawn. Verb #N($43), CAVE
; (#N$8A), LEVE (#N$8B), CURT (#N$85) and PIT (#N$8E) skip that walk.
@label=RoomHasChanged
c$696C LD A,$01      ; {The room has changed.
 $696E LD ($5B95),A  ; }
 $6971 PUSH HL       ; Stash the line pointer on the stack.
 $6972 LD A,($5BCF)  ; Fetch #R$5BCF.
 $6975 CP $43        ; {Jump to #R$69B6 if the verb is #N($43), CAVE (#N$8A),
 $6977 JR Z,$69B6    ; LEVE (#N$8B), CURT (#N$85) or PIT (#N$8E).
 $6979 CP $8A        ;
 $697B JR Z,$69B6    ;
 $697D CP $8B        ;
 $697F JR Z,$69B6    ;
 $6981 CP $85        ;
 $6983 JR Z,$69B6    ;
 $6985 CP $8E        ;
 $6987 JR Z,$69B6    ; }
 $6989 POP HL        ; Discard the saved line pointer.
 $698A LD HL,$B798   ; Point #REGhl at #R$B798.
 $698D LD A,($5D87)  ; {Fetch #R$5D87 into #REGb.
 $6990 LD B,A        ; }
 $6991 LD A,$FF      ; A record terminates with #N$FF.
; Skip bytes until the next terminator.
@label=RoomHasChanged_Sep
*$6993 CP (HL)       ; {Advance until this record ends.
 $6994 INC HL        ;
 $6995 JR NZ,$6993   ; }
 $6997 DJNZ $6993    ; Jump to #R$6993 until this is the current room's record.
; Walk this room's picture record.
@label=RoomHasChanged_Record
*$6999 LD A,(HL)     ; Fetch the next record byte.
 $699A CP $FF        ; {Return if it is the terminator #N$FF.
 $699C RET Z         ; }
 $699D INC HL        ; Advance to the opcode.
 $699E CP $F8        ; {Jump to #R$6999 if it is not #N$F8.
 $69A0 JR NZ,$6999   ; }
 $69A2 PUSH HL       ; Stash the record pointer on the stack.
 $69A3 LD A,($5F15)  ; {Jump to #R$69B6 if the object is not *#R$5F15.
 $69A6 CP (HL)       ;
 $69A7 JR NZ,$69B6   ; }
 $69A9 LD C,A        ; {Copy the object number into #REGbc.
 $69AA LD B,$00      ; }
 $69AC LD HL,$5DCA   ; Point #REGhl at #R$5DCA.
 $69AF ADD HL,BC     ; Add the object number.
 $69B0 LD A,($5D87)  ; {Jump to #R$69BC if it is *#R$5D87.
 $69B3 CP (HL)       ;
 $69B4 JR Z,$69BC    ; }
; Force the picture to be drawn again.
@label=RoomHasChanged_Redraw
*$69B6 XOR A         ; {Write #N$00 to #R$6185.
 $69B7 LD ($6185),A  ; }
 $69BA POP HL        ; Restore the record pointer from the stack.
 $69BB RET           ; Return.
; Keep scanning this record.
@label=RoomHasChanged_Keep
*$69BC POP HL        ; Restore the picture record pointer from the stack.
 $69BD JR $6999      ; Jump to #R$6999.

; Action: Swap Objects
;
; Exchanges the locations of the object in the parameter and the object
; addressed by #REGa, then marks the room changed.
;
; A Second object
; B First object
; C First object location
;
; Address the first object.
@label=SwapObjects
c$69BF CALL $6807    ; Call #R$6807.
 $69C2 PUSH HL       ; Stash that pointer on the stack.
 $69C3 LD B,A        ; {Point at the second object.
 $69C4 CALL $6807    ; }
 $69C7 LD A,(HL)     ; {Exchange the two location bytes.
 $69C8 LD (HL),C     ;
 $69C9 POP HL        ;
 $69CA LD (HL),A     ; }
 $69CB JR $696C      ; Jump to #R$696C.

; Action: Swap Flags
;
; Exchanges flag #REGb with the flag addressed by #REGa.
;
; A Second flag
; B First flag
@label=SwapFlags
c$69CD CALL $67FF    ; Call #R$67FF.
 $69D0 PUSH HL       ; Stash that pointer on the stack.
 $69D1 LD C,(HL)     ; Keep the first flag's value.
 $69D2 LD B,A        ; {Point at the flag selected by #REGa.
 $69D3 CALL $67FF    ; }
 $69D6 LD A,(HL)     ; {Exchange the two flag bytes.
 $69D7 LD (HL),C     ;
 $69D8 POP HL        ;
 $69D9 LD (HL),A     ; }
 $69DA RET           ; Return.

; Action: Set Flag On
;
; Writes #N$FF to flag #REGb.
;
; B Flag number
@label=SetFlagOn
c$69DB CALL $67FF    ; Call #R$67FF.
 $69DE LD A,$FF      ; {Write #N$FF there.
 $69E0 LD (HL),A     ; }
 $69E1 RET           ; Return.

; Action: Clear Flag
;
; Writes zero to flag #REGb.
;
; B Flag number
@label=ClearFlag
c$69E2 CALL $67FF    ; Call #R$67FF.
 $69E5 XOR A         ; {Write #N$00 there.
 $69E6 LD (HL),A     ; }
 $69E7 RET           ; Return.

; Action: Force Verb And Noun
;
; Replaces the command with verb #REGb and noun #REGa, and forgets that a
; script line has already matched so the new command can be tried.
;
; A Noun
; B Verb
@label=ForceCommand
c$69E8 LD ($5B80),A  ; Write #REGa to #R$5B80.
 $69EB LD A,B        ; {Write #REGb to #R$5B7F.
 $69EC LD ($5B7F),A  ; }
 $69EF XOR A         ; {Forget that a script line has already matched, so the new command
 $69F0 LD ($5B79),A  ; can be tried.}
 $69F3 RET           ; Return.

; Action: Add To Flag
;
; Adds #REGa to flag #REGb, sticking at #N$FF instead of wrapping.
;
; A Amount
; B Flag number
@label=AddToFlag
c$69F4 CALL $67FF    ; Call #R$67FF.
 $69F7 ADD A,(HL)    ; Add the flag to #REGa.
 $69F8 JR NC,$69FC   ; {The sum sticks at #N$FF.
 $69FA LD A,$FF      ; }
; Store the sum.
@label=AddFlag_Store
*$69FC LD (HL),A     ; Store it.
 $69FD RET           ; Return.

; Action: Subtract From Flag
;
; Subtracts #REGa from flag #REGb, sticking at #N$00 instead of wrapping.
;
; A Amount
; B Flag number
@label=SubtractFromFlag
c$69FE CALL $67FF    ; Call #R$67FF.
 $6A01 LD ($5B94),A  ; Write the amount to *#R$5B94.
 $6A04 LD A,(HL)     ; Fetch the flag.
 $6A05 PUSH HL       ; Stash the flag pointer on the stack.
 $6A06 LD HL,$5B94   ; Point #REGhl at #R$5B94.
 $6A09 AND A         ; {Subtract the amount.
 $6A0A SUB (HL)      ; }
 $6A0B JR NC,$6A0E   ; {The difference sticks at #N$00.
 $6A0D XOR A         ; }
; Store the difference.
@label=SubtractFlag_Store
*$6A0E POP HL        ; Restore the flag pointer from the stack.
 $6A0F LD (HL),A     ; Store it.
 $6A10 RET           ; Return.

; Action: Set Flag
;
; Writes #REGa into flag #REGb.
;
; A Value
; B Flag number
@label=SetFlag
c$6A11 CALL $67FF    ; Call #R$67FF.
 $6A14 LD (HL),A     ; Write #REGa there.
 $6A15 RET           ; Return.

; Action: Set Object Location
;
; Writes a new location for the object. A value of 1 for an object
; numbered #N$46 or higher is stored as zero. If the new location is the current
; room, the room is marked changed.
;
; A New location
; B Object number
@label=SetObjectLocation
c$6A16 CALL $6807    ; Call #R$6807.
 $6A19 LD C,A        ; #REGc is the new location.
 $6A1A LD A,B        ; {An index below #N$46 is stored as given.
 $6A1B CP $46        ;
 $6A1D JR C,$6A26    ; }
 $6A1F LD A,C        ; {Jump to #R$6A26 if the location is #N$01.
 $6A20 CP $01        ;
 $6A22 JR Z,$6A26    ; }
 $6A24 LD C,$00      ; Store #N$00 instead.
; Write the new location.
@label=SetObject_Write
*$6A26 LD (HL),C     ; Write the location.
; This entry point is used by the routine at #R$6A2F.
; .
; Redraw if the object is here.
@label=SetObject_Here
*$6A27 LD HL,$5D87   ; Point #REGhl at #R$5D87.
 $6A2A CP (HL)       ; {Jump to #R$696C if it is *#R$5D87.
 $6A2B JP Z,$696C    ; }
 $6A2E RET           ; Return.

; Action: Copy Object Location
;
; Gives the object in #REGb the same location as the object addressed by
; #REGa.
;
; A Source object
; B Destination object
;
; Address the destination object.
@label=CopyObjectLocation
c$6A2F CALL $6807    ; Call #R$6807.
 $6A32 PUSH HL       ; Stash the destination pointer on the stack.
 $6A33 LD B,A        ; Copy the source object into #REGb.
; Address the source object.
 $6A34 CALL $6807    ; Call #R$6807.
 $6A37 LD A,(HL)     ; Fetch its location.
 $6A38 POP HL        ; Restore the destination pointer from the stack.
 $6A39 LD (HL),A     ; Copy that location onto object #REGb.
 $6A3A JR $6A27      ; Jump to #R$6A27 so a copy into this room is described.

; Action: Print Flag
;
; Prints flag #REGb as a decimal number followed by a space. Zero is a
; single digit; any other value is two digits.
;
; B Flag number
@label=PrintFlag
c$6A3C CALL $67FF    ; Call #R$67FF.
 $6A3F LD A,(HL)     ; Fetch the flag.
 $6A40 OR A          ; {Jump to #R$6A49 if it is zero.
 $6A41 JR Z,$6A49    ; }
 $6A43 LD B,A        ; Count the flag in #REGb.
; Count the flag into two decimal digits.
 $6A44 XOR A         ; Start the decimal byte at #N$00.
; Count one decimal step.
@label=PrintFlag_Tens
*$6A45 INC A         ; Increment the decimal byte.
 $6A46 DAA           ; #HTML(Keep it as two decimal digits with
                     ; <code>DAA</code>.)
 $6A47 DJNZ $6A45    ; Jump to #R$6A45 until the flag has been counted.
; Print the tens digit unless the flag is zero.
@label=PrintFlag_High
*$6A49 PUSH AF       ; Stash the decimal byte on the stack.
 $6A4A OR A          ; {Jump to #R$6A5A if the flag is zero.
 $6A4B JR Z,$6A5A    ; }
 $6A4D SRL A         ; {Move the tens digit into the low nibble.
 $6A4F SRL A         ;
 $6A51 SRL A         ;
 $6A53 SRL A         ; }
; Add #N$30 so the tens digit is an ASCII character.
 $6A55 ADD A,$30     ; {Print the tens digit using #R$6394.
 $6A57 CALL $6394    ; }
; Print the units digit.
@label=PrintFlag_Units
*$6A5A POP AF        ; Restore the decimal byte from the stack.
 $6A5B AND %00001111 ; Keep only bits 0-3.
 $6A5D ADD A,$30     ; {Print the units digit using #R$6394.
 $6A5F CALL $6394    ; }
 $6A62 LD A,$20      ; {Print a following space using #R$63FC.
 $6A64 CALL $63FC    ; }
 $6A67 RET           ; Return.

; Action: Drop Everything
;
; Puts every object that is carried down in the current room and clears
; the carried count.
@label=DropEverything
c$6A68 LD B,$FE      ; Count #N$FE object slots.
 $6A6A LD HL,$5DCA   ; Point #REGhl at #R$5DCA.
; Drop one carried object into this room.
@label=DropEverything_One
*$6A6D LD A,($5D89)  ; {Jump to #R$6A77 if it is not *#R$5D89.
 $6A70 CP (HL)       ;
 $6A71 JR NZ,$6A77   ; }
 $6A73 LD A,($5D87)  ; {Write *#R$5D87 into its location.
 $6A76 LD (HL),A     ; }
; Move on to the next object.
@label=DropEverything_Next
*$6A77 INC HL        ; The next object.
 $6A78 DJNZ $6A6D    ; Jump to #R$6A6D until every slot is done.
 $6A7A XOR A         ; {Write #N$00 to *#R$5D8C.
 $6A7B LD ($5D8C),A  ; }
; The carried objects are now in this room.
 $6A7E JP $696C      ; Jump to #R$696C.

; Restore Pointer Scratch
;
; Two bytes overwritten when a restore is offered. They are not read back.
@label=RestoreScratch
g$6A81 DEFB $53,$00

; Action: Wear
;
; Wears the object. It must be carried and in this room, and it must not
; already be worn. The worn id replaces the object's location and the carried
; count drops.
;
; B Object number
; C Object location
@label=WearObject
c$6A83 CALL $6807    ; Call #R$6807.
 $6A86 LD A,($5D8A)  ; {Jump to #R$6A91 if it is not *#R$5D8A.
 $6A89 CP C          ;
 $6A8A JR NZ,$6A91   ; }
; Print "you are wearing it.".
 $6A8C LD A,$1D      ; {Print #R$7F5C using #R$63D4.
 $6A8E JP $68B8      ; }
; Wear it if it is carried or here.
@label=WearObject_Held
*$6A91 LD A,($5D89)  ; {Jump to #R$6AA2 if it is *#R$5D89.
 $6A94 CP C          ;
 $6A95 JR Z,$6AA2    ; }
 $6A97 LD A,($5D87)  ; {Jump to #R$6AA8 if it is *#R$5D87.
 $6A9A CP C          ;
 $6A9B JR Z,$6AA8    ; }
; Print "sorry, I don't see it here.".
 $6A9D LD A,$16      ; {Print #R$7F09 using #R$63D4.
 $6A9F JP $68B8      ; }
; Count one fewer carried object.
@label=WearObject_Count
*$6AA2 PUSH HL       ; Stash #REGhl on the stack.
 $6AA3 LD HL,$5D8C   ; {Decrement *#R$5D8C.
 $6AA6 DEC (HL)      ; }
 $6AA7 POP HL        ; Restore #REGhl from the stack.
; Mark the object as worn.
@label=WearObject_Take
*$6AA8 LD A,($5D8A)  ; {Write *#R$5D8A into the object's location.
 $6AAB LD (HL),A     ; }
 $6AAC RET           ; Return.

; Action: Take Object Off
;
; Stops wearing the object and carries it instead. Message #N$1C says you
; are not wearing it.
;
; B Object number
; C Object location
@label=RemoveWorn
c$6AAD CALL $6807    ; Call #R$6807.
 $6AB0 LD A,($5D8A)  ; {Jump to #R$6ABB if it is *#R$5D8A.
 $6AB3 CP C          ;
 $6AB4 JR Z,$6ABB    ; }
; Print "you are not wearing it.".
 $6AB6 LD A,$1C      ; {Print #R$7F52 using #R$63D4.
 $6AB8 JP $68B8      ; }
; The worn object is now carried.
@label=RemoveWorn_Do
*$6ABB LD A,($5D89)  ; {Write *#R$5D89 into the object's location.
 $6ABE LD (HL),A     ; }
 $6ABF LD HL,$5D8C   ; {Increment *#R$5D8C.
 $6AC2 INC (HL)      ; }
 $6AC3 RET           ; Return.

; Action: Beep
;
; Used by the routine at #R$662D.
; .
; Turns #REGa and #REGb into a duration and a pitch and hands them to the
; ROM beeper. The key click uses #REGa equal to #N$1E. Action 0 of the bytecode
; jumps straight to the same ROM routine, whose address is the operand of the
; jump below.
;
; A Duration
; B Pitch
;
; #HTML(#AUDIO0(key-click.wav)(#INCLUDE(KeyClick)))
@label=Beep
c$6AC4 AND A         ; Carry is clear.
 $6AC5 LD L,A        ; Put the duration in #REGl.
 $6AC6 LD A,B        ; Copy the pitch into #REGa.
 $6AC7 LD D,$00      ; {The high byte of the duration, and #REGd, start at
 $6AC9 LD H,D        ; zero.}
 $6ACA ADD A,A       ; {Shift the pitch two places, keeping the overflow in
 $6ACB ADD A,A       ; #REGd.
 $6ACC RL D          ; }
 $6ACE LD E,A        ; Put the pitch in #REGe.
 $6ACF PUSH DE       ; Stash it on the stack.
 $6AD0 CALL $30A9    ; Call #SKOOLKID$30A9(HL_HLxDE) to scale the duration by
                     ; the pitch.
 $6AD3 POP DE        ; Restore the pitch for the beeper from the stack.
 $6AD4 JP $03B5      ; Jump to #SKOOLKID$03B5(BEEPER).

; Table: Action Routines
;
; One address per bytecode action, after action 0, which is the BEEPER
; entry embedded in #R$6AC4. The runner shifts the action number and calls the
; address.
@label=ActionTable
w$6AD7 DEFW $6924    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AD9 DEFW $685B    ; Action #N($01+(#PC-$6AD5)/$02).
