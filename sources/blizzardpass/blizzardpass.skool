; Stack Top
;
; The stack pointer installed at the start of the game loop. Two bytes
; sit under the room byte.
@label=StackTop
g$5D84 DEFB $22,$AF,$0D

; Current Room
;
; The room the player is in. Its short text at #R$75CE is used for rooms
; #N$66 and above, and for every room while pictures are on. Otherwise the
; long description comes from bank 6.
@label=CurrentRoom
g$5D87 DEFB $00

; Darkness
;
; Non-zero when the location is dark and must be described as such.
@label=Darkness
g$5D88 DEFB $09

; Carried Object
;
; Object in the hands. #N$FD means the hands are empty.
@label=CarriedObject
g$5D89 DEFB $08

; Worn Object
;
; Object being worn. #N$FE means nothing is worn.
@label=WornObject
g$5D8A DEFB $00

; State Byte
;
; Copied from the initial state as flag byte 4. The bytecode addresses
; it through #R$67FF.
@label=StateByte
g$5D8B DEFB $ED

; Carried Count
;
; How many objects are currently carried. GET increments it and DROP
; decrements it.
@label=CarriedCount
g$5D8C DEFB $72

; Object Total
;
; How many object slots to scan when listing what is here. It starts at
; #N$96.
@label=ObjectTotal
g$5D8D DEFB $3A

; Repeat Counter
;
; While this is non-zero the game loop reruns the scripts and redraws,
; then decrements it.
@label=RepeatCounter
g$5D8E DEFB $EF

; Flag Bytes
;
; The rest of the flag area the bytecode indexes from #R$5D87. It is
; cleared at the start of a game.
@label=FlagBytes
