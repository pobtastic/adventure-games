; Word Being Printed
;
; The printer collects one word here and flushes it when it hits a
; space, ENTER, or a message terminator.
@label=WordBuffer
b$5B60 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B68 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B70 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B78 DEFB $00

; Script Matched
;
; Set when a bytecode line's verb and noun matched. The next line is
; skipped until this is cleared.
@label=ScriptMatched
g$5B79 DEFB $00

; Search Hit
;
; Set when a movement or an object list finds what it is looking for.
@label=SearchHit
g$5B7A DEFB $00

; Word Under Test
;
; Four characters of the word currently being matched, padded with
; spaces.
@label=WordToken
b$5B7B DEFB $00,$00,$00,$00

; Verb
;
; Token of the first word. Directions are #N$01 to #N($0A), inventory is
; #N($0B), GET is #N($0C), DROP is #N($0D), WEAR is #N$0E and QUIT is #N$10.
@label=Verb
g$5B7F DEFB $00

; Noun
;
; Token of the second word. IT and THEM reuse the previous noun.
@label=Noun
g$5B80 DEFB $00

; Counter #N$01
;
; Bytecode counter compared by condition #N$11.
@label=Counter1
g$5B81 DEFB $00

; Counter #N$02
;
; Bytecode counter compared by condition #N$12.
@label=Counter2
g$5B82 DEFB $00

; Counter #N$03
;
; Bytecode counter compared by condition #N$13.
@label=Counter3
g$5B83 DEFB $00

; Exit Key
;
; The current room plus #N($80), which is how that room is keyed in the
; exit table.
@label=ExitKey
g$5B84 DEFB $00

; Continuation
;
; Non-zero when a comma left more of the command line for the next turn.
@label=Continuation
g$5B85 DEFB $00

; Word Slot
;
; How many words of this command have been stored. The script runner
; clears it after the first matched line.
@label=WordSlot
g$5B86 DEFB $00

; Print Address
;
; Spectrum display address where the next glyph is plotted.
@label=PrintAddress
g$5B87 DEFB $00,$00

; Print Row
;
; Character row of the cursor. It is saved and restored as a pair with
; the column.
@label=PrintRow
g$5B89 DEFB $00

; Print Column
;
; Character column of the cursor. The text window is #N$2B columns wide.
@label=PrintColumn
g$5B8A DEFB $00

; Words Recognised
;
; How many vocabulary words the parser kept from the current line.
@label=WordCount
g$5B8B DEFB $00

; Rest Of The Line
;
; Where to resume after a comma, and the pointer the vocabulary scan
; restores.
@label=InputPointer
g$5B8C DEFB $00,$00

; Input Length
;
; Characters currently in the command buffer. DELETE is ignored when
; this is zero.
@label=InputLength
g$5B8E DEFB $00

; Message Number
;
; Which terminated message to print, counted from the start of the
; chosen table.
@label=MessageNumber
g$5B8F DEFB $00

; Message Pointer
;
; Address of the message byte just printed.
@label=MessagePointer
g$5B90 DEFB $00,$00

; Scratch
;
; Two unused bytes between the message pointer and the subtraction
; scratch.
@label=Scratch92
g$5B92 DEFB $00,$00

; Subtraction Scratch
;
; Holds the amount being subtracted from a flag byte.
@label=SubtractScratch
g$5B94 DEFB $00

; Room Changed
;
; Set when a script or a movement changes the room, so the loop
; describes it again.
@label=RoomChanged
g$5B95 DEFB $00

; Which Script Table
;
; #N$FF while the high-priority scripts run, and zero for the ordinary
; command scripts.
@label=ScriptSet
g$5B96 DEFB $00

; Bottom Row
;
; Last character row the text window may use before it scrolls.
@label=BottomRow
g$5B97 DEFB $00

; Word Length
;
; Characters collected for the word that is about to be flushed.
@label=WordLength
g$5B98 DEFB $00

; Word Pointer
;
; Next free byte in the word buffer.
@label=WordPointer
g$5B99 DEFB $00,$00

; Last Character
;
; The character just expanded. A full stop here makes the next letter a
; capital.
@label=LastCharacter
g$5B9B DEFB $00

; Previous Glyph
;
; The glyph just plotted, so a second space in a row can be rubbed out.
@label=PreviousGlyph
g$5B9C DEFB $00

; Previous Noun
;
; The noun IT and THEM refer to.
@label=PreviousNoun
g$5B9D DEFB $00

; Picture Workspace
;
; Coordinates, shape bytes and the last matched verb used while an
; illustration is drawn.
@label=PictureWorkspace
