 $6AE3 DEFW $6B43    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AE5 DEFW $6879    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AE7 DEFW $68B0    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AE9 DEFW $68E4    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AEB DEFW $6892    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AED DEFW $68A2    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AEF DEFW $69DB    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AF1 DEFW $69E2    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AF3 DEFW $63E6    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AF5 DEFW $6965    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AF7 DEFW $695D    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AF9 DEFW $6A3C    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AFB DEFW $6899    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AFD DEFW $6A83    ; Action #N($01+(#PC-$6AD5)/$02).
 $6AFF DEFW $6AAD    ; Action #N($01+(#PC-$6AD5)/$02).
 $6B01 DEFW $6A11    ; Action #N($01+(#PC-$6AD5)/$02).
 $6B03 DEFW $69F4    ; Action #N($01+(#PC-$6AD5)/$02).
 $6B05 DEFW $69FE    ; Action #N($01+(#PC-$6AD5)/$02).
 $6B07 DEFW $6A16    ; Action #N($01+(#PC-$6AD5)/$02).
 $6B09 DEFW $69BF    ; Action #N($01+(#PC-$6AD5)/$02).
 $6B0B DEFW $69CD    ; Action #N($01+(#PC-$6AD5)/$02).
 $6B0D DEFW $69E8    ; Action #N($01+(#PC-$6AD5)/$02).
 $6B0F DEFW $6A2F    ; Action #N($01+(#PC-$6AD5)/$02).
 $6B11 DEFW $6AC4    ; Action #N($01+(#PC-$6AD5)/$02).
 $6B13 DEFW $696C    ; Action #N($01+(#PC-$6AD5)/$02).

; Draw Room Once
;
; Used by the routines at #R$5ECB, #R$5F21 and #R$685B.
; .
; Draws the illustration when the room on screen is not the current one,
; and remembers the room.
@label=DrawRoomOnce
c$6B15 LD HL,$6185   ; Point #REGhl at #R$6185.
 $6B18 LD A,($5D87)  ; Fetch #R$5D87.
 $6B1B CP (HL)       ; Test the room on screen.
 $6B1C DI            ; Disable interrupts.
 $6B1D LD (HL),A     ; Remember this room.
 $6B1E CALL NZ,$6B4C ; Call #R$6B4C if the room on screen was not this one.
 $6B21 EI            ; Allow interrupts again.
 $6B22 RET           ; Return.

; Glyph Buffer
;
; Eight bytes of the character currently being shifted onto the screen. It
; starts full of #N$FF.
@label=GlyphBuffer
b$6B23 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF

; Finish Word On Terminator
;
; Used by the routine at #R$62F2.
; .
; A space that follows a message terminator is forced, so the terminator
; itself is not printed in the middle of a word.
@label=FinishWord
c$6B2B LD A,($5B9B)  ; {Jump to #R$6B39 if *#R$5B9B is #N$7E.
 $6B2E CP $7E        ;
 $6B30 JR Z,$6B39    ; }
 $6B32 CP $5E        ; {Jump to #R$6319 with a space if *#R$5B9B is not #N$5E.
 $6B34 LD A,$20      ;
 $6B36 JP NZ,$6319   ; }
; Collect a space after the terminator.
@label=FinishWord_Space
*$6B39 LD A,$20      ; {Write #N$20 to *#R$5B9B.
 $6B3B LD ($5B9B),A  ; }
 $6B3E JP $6319      ; Jump to #R$6319.

; Error Stack
;
; Stored in #SKOOLKID$5C3D(ERR_SP) when the game starts. A ROM error sets
; the stack to this word, whose value is the address of the glyph buffer.
@label=ErrorStack
w$6B41 DEFW $6B23

; Action: Redraw
;
; Used by the routine at #R$662D.
; .
; Draws the picture, describes the room, and marks the room changed so the
; following turn keeps the description in step.
@label=RedrawLocation
c$6B43 CALL $6B4C    ; Call #R$6B4C.
 $6B46 CALL $6187    ; Call #R$6187.
 $6B49 JP $696C      ; Jump to #R$696C.

; Draw Picture When Enabled
;
; Used by the routines at #R$6B15 and #R$6B43.
; .
; Returns immediately while pictures are switched off. Otherwise paints
; the illustration.
@label=DrawIfPictures
c$6B4C PUSH AF       ; Stash #REGaf on the stack.
 $6B4D LD A,($66D6)  ; {Jump to #R$6B55 if *#R$66D6 is set.
 $6B50 OR A          ;
 $6B51 JR NZ,$6B55   ; }
 $6B53 POP AF        ; Restore #REGaf from the stack.
 $6B54 RET           ; Return.
; Draw the illustration.
@label=DrawIfPictures_On
*$6B55 POP AF        ; Restore #REGaf from the stack.
 $6B56 JP $6DFA      ; Jump to #R$6DFA.

