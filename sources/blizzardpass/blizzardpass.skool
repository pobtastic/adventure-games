 $6CD2 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6CDA DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6CE2 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6CEA DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6CF2 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6CFA DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D02 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D0A DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D12 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D1A DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D22 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D2A DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D32 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D3A DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D42 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D4A DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D52 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D5A DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D62 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D6A DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D72 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D7A DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D82 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D8A DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D92 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6D9A DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6DA2 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6DAA DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6DB2 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6DBA DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6DC2 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6DCA DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6DD2 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6DDA DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6DE2 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6DEA DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $6DF2 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF

; Clear Illustration
;
; Used by the routine at #R$6B4C.
; .
; Blanks the illustration from pixel row #N$AF down to #N($50), lets the
; picture bytecode paint the saved attributes, then copies that buffer onto the
; screen.
;
; .
;
; Blank the illustration pixels, row by row, from row #N$AF down to
; row #N($50).
@label=ClearIllustration
c$6DFA LD BC,$AF00   ; Pixel row #N($AF), column #N$00.
; Blank one pixel row of #N($20) bytes.
@label=ClearIllustration_Row
*$6DFD PUSH BC       ; Stash the row counter on the stack.
 $6DFE CALL $22AA    ; Call #SKOOLKID$22AA(PIXEL_ADD) for this row's screen
                     ; address.
 $6E01 PUSH HL       ; {Copy the screen address to #REGde (using the stack).
 $6E02 POP DE        ; }
 $6E03 INC DE        ; Advance to the next byte.
 $6E04 LD BC,$001F   ; Count the remaining #N($001F,$04,$04) bytes of this row.
 $6E07 LD (HL),$00   ; {Write #N$00 across the rest of the row.
 $6E09 LDIR          ; }
 $6E0B POP BC        ; Restore the row counter from the stack.
 $6E0C DEC B         ; Count down one row.
 $6E0D LD A,$4F      ; {Jump to #R$6DFD until row #N($50) has been cleared.
 $6E0F CP B          ;
 $6E10 JR NZ,$6DFD   ; }
; Clear the matching attribute rows, then copy them into the
; illustration buffer.
 $6E12 LD HL,$5800   ; Point #REGhl at #N$5800 (attribute buffer).
 $6E15 LD DE,$5801   ; Point #REGde at the next byte.
 $6E18 LD BC,$017F   ; Count the remaining #N$017F bytes of the top twelve
                     ; rows.
 $6E1B LD (HL),$00   ; {Write #N$00 across the block.
 $6E1D LDIR          ; }
 $6E1F LD HL,$5800   ; {Copy #N$0180 bytes from #N$5800 (attribute buffer) to
 $6E22 LD DE,$6C7A   ; #R$6C7A.
 $6E25 LD BC,$0180   ;
 $6E28 LDIR          ; }
; Paint the picture into the buffer.
 $6E2A CALL $6E39    ; Call #R$6E39.
; Copy the painted attributes back onto the screen.
 $6E2D LD DE,$5800   ; {Copy #N$0180 bytes from #R$6C7A to #N$5800 (attribute
 $6E30 LD HL,$6C7A   ; buffer).
 $6E33 LD BC,$0180   ;
 $6E36 LDIR          ; }
 $6E38 RET           ; Return.

; Draw Room Picture
;
; Used by the routine at #R$6DFA.
; .
; Returns at once in the dark or in room 0. Otherwise finds this room's
; picture record and interprets it.
@label=DrawRoomPicture
c$6E39 LD A,($5D88)  ; {Return if *#R$5D88 is set.
 $6E3C OR A          ;
 $6E3D RET NZ        ; }
 $6E3E LD A,($5D87)  ; {Return if *#R$5D87 is #N$00.
 $6E41 OR A          ;
 $6E42 RET Z         ; }
; Continue on to #R$6E43.

; Find Room Picture Record
;
; Used by the routine at #R$6E53.
; .
; Walks #R$B798, whose records are separated by #N($FF), until it reaches
; the current room. Rooms from #N$60 up run on into bank 0 at #R$C000.
;
;   A Room number
; O:IX Picture record for that room
@label=FindPictureRecord
c$6E43 LD IX,$B798   ; Point #REGix at #R$B798.
 $6E47 LD B,A        ; Copy the room number into the counter.
 $6E48 LD A,$FF      ; Load the record terminator.
; Skip bytes until the next terminator.
@label=FindPictureRecord_Skip
*$6E4A CP (IX+$00)   ; {Advance until this record ends.
 $6E4D INC IX        ;
 $6E4F JR NZ,$6E4A   ; }
 $6E51 DJNZ $6E4A    ; Jump to #R$6E4A until this is the wanted room.
; Continue on to #R$6E53.

; Interpret Picture Record
;
; Used by the routines at #R$6EC1, #R$6F2C, #R$6F44, #R$7213, #R$72B5, #R$72C0,
; #R$7382, #R$738D, #R$73DC, #R$7428, #R$746E, #R$7512, #R$751D and #R$753E.
; .
; Reads the next record byte. #N$FF ends it. #N$FE draws with a fixed
; shift, #N$FD changes one colour to another in the ink and paper, #N$FC
; paints a run of attributes, #N$FB brightens the picture, #N$FA draws a
; fixed vertical stroke, and #N$F9 draws another room's record. Any other
; byte goes to #R$6E7F.
@label=PictureRecord
c$6E53 LD A,(IX+$00) ; Fetch the next record byte.
; Opcode #N$FF ends the record.
 $6E56 INC A         ; {Return if it is the terminator #N$FF.
 $6E57 RET Z         ; }
; Opcode #N$FE draws with the shift forced to #N$0C.
 $6E58 INC A         ; {Jump to #R$72C0 if it is #N$FE.
 $6E59 JP Z,$72C0    ; }
; Opcode #N$FD changes one colour to another.
 $6E5C INC A         ; {Jump to #R$6F2C if it is #N$FD.
 $6E5D JP Z,$6F2C    ; }
; Opcode #N$FC paints a run of attributes.
 $6E60 INC A         ; {Jump to #R$753E if it is #N$FC.
 $6E61 JP Z,$753E    ; }
; Opcode #N$FB sets bright on every attribute.
 $6E64 INC A         ; {Jump to #R$6F44 if it is #N$FB.
 $6E65 JP Z,$6F44    ; }
; Opcode #N$FA draws a fixed vertical stroke.
 $6E68 INC A         ; {Jump to #R$751D if it is #N$FA.
 $6E69 JP Z,$751D    ; }
; Any other opcode except #N$F9 goes to #R$6E7F.
 $6E6C INC A         ; {Jump to #R$6E7F if it is not #N$F9.
 $6E6D JR NZ,$6E7F   ; }
; Opcode #N$F9 draws another room's picture record.
 $6E6F INC IX        ; Advance the record pointer.
 $6E71 LD A,(IX+$00) ; Fetch the room number.
 $6E74 PUSH IX       ; Stash the record pointer on the stack.
 $6E76 CALL $6E43    ; Call #R$6E43.
 $6E79 POP IX        ; Restore the record pointer from the stack.
 $6E7B INC IX        ; Advance the record pointer.
 $6E7D JR $6E53      ; Jump to #R$6E53.

; Dispatch Picture Opcode
;
; Used by the routine at #R$6E53.
; .
; Opcodes #N$F8 to #N$EE jump to their own drawers. A smaller byte is a
; shape plotted by the routine below.
@label=DispatchShape
c$6E7F LD A,(IX+$00) ; Fetch the opcode.
; Opcode #N$F8 draws the following shape only when that object is here.
 $6E82 CP $F8        ; {Jump to #R$7213 if it is #N$F8.
 $6E84 JP Z,$7213    ; }
; Opcode #N$F7 plots the following shape after writing #N$0C to #R$6EEE.
 $6E87 CP $F7        ; {Jump to #R$73BE if it is #N$F7.
 $6E89 JP Z,$73BE    ; }
; Opcode #N$F6 plots the following shape after writing #N$08 to #R$6EEE.
 $6E8C CP $F6        ; {Jump to #R$73D2 if it is #N$F6.
 $6E8E JP Z,$73D2    ; }
; Opcode #N$F5 plots the following shape after writing #N$04 to #R$6EEE.
 $6E91 CP $F5        ; {Jump to #R$73C8 if it is #N$F5.
 $6E93 JP Z,$73C8    ; }
; Opcode #N$F4 continues the record only when that object is here.
 $6E96 CP $F4        ; {Jump to #R$73DC if it is #N$F4.
 $6E98 JP Z,$73DC    ; }
; Opcode #N$F3 resets the origin and copies the default rectangle.
 $6E9B CP $F3        ; {Jump to #R$738D if it is #N$F3.
 $6E9D JP Z,$738D    ; }
; Opcode #N$F2 patches the shift and draws.
 $6EA0 CP $F2        ; {Jump to #R$72B5 if it is #N$F2.
 $6EA2 JP Z,$72B5    ; }
; Opcode #N$F1 sets the origin and draws.
 $6EA5 CP $F1        ; {Jump to #R$7382 if it is #N$F1.
 $6EA7 JP Z,$7382    ; }
; Opcode #N$F0 draws a horizontal run of pixels.
 $6EAA CP $F0        ; {Jump to #R$7428 if it is #N$F0.
 $6EAC JP Z,$7428    ; }
; Opcode #N$EF draws a run shifted across the pixel columns.
 $6EAF CP $EF        ; {Jump to #R$746E if it is #N$EF.
 $6EB1 JP Z,$746E    ; }
; Opcode #N$EE patches the vertical shift.
 $6EB4 CP $EE        ; {Jump to #R$7512 if it is #N$EE.
 $6EB6 JP Z,$7512    ; }
; A smaller byte is a shape, plotted below.
 $6EB9 CP $EC        ; This compare with #N$EC is unused.
 $6EBB LD B,A        ; Copy the opcode into #REGb.
 $6EBC XOR A         ; Clear #REGa so an ordinary shape stores #N$00.
; This entry point is used by the routines at #R$73BE, #R$73C8 and #R$73D2.
; .
; Store that byte and plot the shape.
@label=DispatchShape_Flag
*$6EBD LD ($6EEE),A  ; Write #REGa to #R$6EEE.
 $6EC0 LD A,B        ; Restore the opcode.
; Continue on to #R$6EC1.

; Plot Shape
;
; Used by the routine at #R$7213.
; .
; Reads the shape's coordinates and paints it into the attribute buffer.
;
; .
;
; Find the shape in the picture font.
@label=PlotShape
c$6EC1 CALL $718B    ; Call #R$718B.
 $6EC4 INC IX        ; Advance the record pointer.
 $6EC6 LD A,(IX+$00) ; {Read the X coordinate into #R$5BC1 and #REGc.
 $6EC9 LD ($5BC1),A  ;
 $6ECC LD C,A        ; }
 $6ECD INC IX        ; Advance the record pointer.
 $6ECF LD A,(IX+$00) ; {Read the Y coordinate into #R$5BC2 and #R$5BC3.
 $6ED2 LD ($5BC2),A  ;
 $6ED5 LD ($5BC3),A  ; }
 $6ED8 INC IX        ; Advance the record pointer.
 $6EDA PUSH IX       ; Stash the record pointer on the stack.
; Address the destination byte.
 $6EDC CALL $6F57    ; Call #R$6F57.
 $6EDF LD DE,$6C7A   ; {Write #R$6C7A to #R$5BC9.
 $6EE2 LD ($5BC9),DE ; }
 $6EE6 CALL $710E    ; Call #R$710E.
 $6EE9 POP IX        ; Restore the record pointer from the stack.
 $6EEB JP $6E53      ; Jump to #R$6E53.

; Shape Suppressed
;
; Written by #R$6EBD before a shape is plotted. Ordinary shapes store
; #N$00; opcodes #N($F5), #N$F6 and #N$F7 store #N($04), #N$08 or #N$0C.
; No instruction reads this byte.
@label=ShapeSuppressed
g$6EEE DEFB $00

; Change Colour In Ink And Paper
;
; Used by the routine at #R$6F2C.
; .
; Changes colour #REGc to colour #REGl across the saved attribute buffer,
; first in the ink bits and then, with both colours moved up three bits, in the
; paper bits.
@label=ChangeInkAndPaperColour
c$6EEF LD B,$07      ; {The ink mask is #N($07), keeping bits 3-7.
 $6EF1 LD H,$F8      ; }
; Replace matching bits.
 $6EF3 CALL $6F0A    ; Call #R$6F0A.
; Move both colours into the paper bits.
 $6EF6 LD A,C        ; {Shift the source colour left by three.
 $6EF7 SLA A         ;
 $6EF9 SLA A         ;
 $6EFB SLA A         ;
 $6EFD LD C,A        ; }
 $6EFE LD A,L        ; {Shift the destination colour left by three.
 $6EFF SLA A         ;
 $6F01 SLA A         ;
 $6F03 SLA A         ;
 $6F05 LD L,A        ; }
 $6F06 LD B,$38      ; {Prepare the paper mask.
 $6F08 LD H,$C7      ; }
; Walks the attribute buffer. Wherever the bits selected by #REGb equal
; #REGc, those bits are replaced with #REGl and the bits in #REGh are kept.
@label=ChangeMatchingColourBits
*$6F0A PUSH IX       ; Stash #REGix on the stack.
 $6F0C LD IX,$6C7A   ; Point #REGix at #R$6C7A.
 $6F10 LD DE,$0180   ; Count the #N$0180 bytes of #R$6C7A.
; Test this attribute byte.
@label=ChangeMatchingColourBits_Byte
*$6F13 LD A,(IX+$00) ; {Jump to #R$6F22 if the selected bits are not #REGc.
 $6F16 AND B         ;
 $6F17 CP C          ;
 $6F18 JR NZ,$6F22   ; }
 $6F1A LD A,(IX+$00) ; {Replace those bits with #REGl.
 $6F1D AND H         ;
 $6F1E OR L          ;
 $6F1F LD (IX+$00),A ; }
; Advance through the buffer.
@label=ChangeMatchingColourBits_Next
*$6F22 INC IX        ; Advance the buffer pointer.
 $6F24 DEC DE        ; {Jump to #R$6F13 until the buffer is done.
 $6F25 LD A,D        ;
 $6F26 OR E          ;
 $6F27 JR NZ,$6F13   ; }
 $6F29 POP IX        ; Restore #REGix from the stack.
 $6F2B RET           ; Return.

; Change Picture Colour
;
; Used by the routine at #R$6E53.
; .
; Used for picture record #N$FD. Reads two colours from the record and
; changes one colour to another in the ink and paper: every ink of the first
; colour across the picture becomes the second, and so does every paper.
@label=ChangePictureColour
c$6F2C INC IX        ; Advance the record pointer.
 $6F2E LD A,(IX+$00) ; Fetch the source colour.
 $6F31 AND %00000111 ; Keep only bits 0-2.
 $6F33 LD C,A        ; That colour is #REGc.
 $6F34 INC IX        ; Advance the record pointer.
 $6F36 LD A,(IX+$00) ; Fetch the destination colour.
 $6F39 AND %00000111 ; Keep only bits 0-2.
 $6F3B LD L,A        ; That colour is #REGl.
; Recolour the buffer.
 $6F3C CALL $6EEF    ; Call #R$6EEF.
 $6F3F INC IX        ; Advance the record pointer.
 $6F41 JP $6E53      ; Jump to #R$6E53.

; Brighten Illustration
;
; Used by the routine at #R$6E53.
; .
; Sets the bright bit on every byte of the attribute buffer.
@label=BrightenAttributes
c$6F44 LD HL,$6C7A   ; Point #REGhl at #R$6C7A.
 $6F47 LD BC,$0180   ; Count the #N$0180 bytes of #R$6C7A.
; Set bright on each attribute byte.
@label=BrightenAttributes_Byte
*$6F4A SET 6,(HL)    ; Set the bright bit.
 $6F4C INC HL        ; Advance the buffer pointer.
 $6F4D DEC BC        ; Count down one byte.
 $6F4E LD A,C        ; {Jump to #R$6F4A until the buffer is done.
 $6F4F OR B          ;
 $6F50 JR NZ,$6F4A   ; }
 $6F52 INC IX        ; Advance the record pointer.
 $6F54 JP $6E53      ; Jump to #R$6E53.

; Address Picture Byte
;
; Used by the routines at #R$6EC1 and #R$70F8.
; .
; Turns a character row into a pointer inside the attribute buffer, using
; the same row table as the text printer. It then reads each shape byte and
; expands the tiles.
;
;   A Character row
;   HL Shape pointer
; O:HL Shape pointer
@label=PictureAddress
c$6F57 PUSH HL       ; Stash #REGhl on the stack.
 $6F58 CALL $7532    ; Call #R$7532.
 $6F5B EX DE,HL      ; {Add the picture origin.
 $6F5C ADD HL,BC     ; }
 $6F5D LD ($5BBA),HL ; Store the buffer address in #R$5BBA.
 $6F60 POP HL        ; Restore the shape pointer from the stack.
 $6F61 INC HL        ; {Store the next shape pointer in #R$5BBC.
 $6F62 LD ($5BBC),HL ; }
; Start this shape with overwrite and no run count.
 $6F65 XOR A         ; {Write #N$00 to #R$5BC8 and #R$5BC0.
 $6F66 LD ($5BC8),A  ;
 $6F69 LD ($5BC0),A  ; }
; Fetch the next shape byte and remember it for the shift that follows.
@label=ReadShapeByte
*$6F6C XOR A         ; {Write #N$00 to #R$5BBE.
 $6F6D LD ($5BBE),A  ; }
 $6F70 LD A,(HL)     ; Fetch the next shape byte.
; Marker #N$FB replaces this byte from the parameter block.
 $6F71 CP $FB        ; {Call #R$71EB if it is #N($FB), which replaces this
 $6F73 CALL Z,$71EB  ; byte.}
; Marker #N$EF paints a run of #N$01 blank tiles.
 $6F76 CP $EF        ; {Jump to #R$6F7E if it is not #N($EF), a blank run of
 $6F78 JR NZ,$6F7E   ; #N$01.}
 $6F7A LD A,$01      ; {Jump to #R$6F94 with a blank run of #N$01.
 $6F7C JR $6F94      ; }
; Marker #N$EE paints a run of #N$02 blank tiles.
@label=ReadShapeByte_Marker
*$6F7E CP $EE        ; {Jump to #R$6F86 if it is not #N($EE), a blank run of
 $6F80 JR NZ,$6F86   ; #N$02.}
 $6F82 LD A,$02      ; {Jump to #R$6F94 with a blank run of #N$02.
 $6F84 JR $6F94      ; }
; Marker #N$EB paints a run of #N$03 blank tiles.
@label=ReadShapeByte_Wide
*$6F86 CP $EB        ; {Jump to #R$6F8E if it is not #N($EB), a blank run of
 $6F88 JR NZ,$6F8E   ; #N$03.}
 $6F8A LD A,$03      ; {Jump to #R$6F94 with a blank run of #N$03.
 $6F8C JR $6F94      ; }
; Marker #N$F3 paints a run of blank tiles; the next byte is the count.
@label=ReadShapeByte_Literal
*$6F8E CP $F3        ; {Jump to #R$6FA5 if it is not #N($F3), a counted blank
 $6F90 JR NZ,$6FA5   ; run.}
 $6F92 INC HL        ; {Fetch the run count.
 $6F93 LD A,(HL)     ; }
; Store the run count and the default shift flags.
@label=ReadShapeByte_Store
*$6F94 LD ($5BC0),A  ; Store it in #R$5BC0.
 $6F97 LD A,$82      ; {Write default flags #N$82 (no shift, page 0, overwrite) to
 $6F99 LD ($5BBE),A  ; #R$5BBE and #R$5BBF.
 $6F9C LD ($5BBF),A  ; }
 $6F9F LD ($5BBC),HL ; Store #REGhl in #R$5BBC.
 $6FA2 XOR A         ; The tile number is #N$00.
 $6FA3 JR $6FC9      ; Jump to #R$6FC9.
; Marker #N$FA copies a parameter block. Other markers adjust the
; coordinate that follows.
@label=SpecialShape
*$6FA5 CP $FA        ; {Jump to #R$6FAE if it is not #N($FA), which copies a parameter
 $6FA7 JR NZ,$6FAE   ; block.}
; Copy the parameter block.
 $6FA9 CALL $71FF    ; Call #R$71FF.
 $6FAC JR $6F6C      ; Jump to #R$6F6C.
; Adjust the coordinate that follows.
@label=SpecialShape_Other
*$6FAE LD ($5BBC),HL ; Store #REGhl in #R$5BBC.
 $6FB1 BIT 7,A       ; {Jump to #R$6FC9 if bit 7 is reset.
 $6FB3 JR Z,$6FC9    ; }
 $6FB5 LD ($5BBE),A  ; {Copy the marker into #R$5BBE and #R$5BBF.
 $6FB8 LD ($5BBF),A  ; }
 $6FBB AND %00000010 ; Keep only bit 1.
 $6FBD JR Z,$6FC4    ; Jump to #R$6FC4 if bit 1 is reset.
 $6FBF INC HL        ; {Advance to the run count.
 $6FC0 LD A,(HL)     ; }
 $6FC1 LD ($5BC0),A  ; Store it in #R$5BC0.
; Step on to the coordinate.
@label=SpecialShape_Advance
*$6FC4 INC HL        ; {Advance #R$5BBC.
 $6FC5 LD ($5BBC),HL ; }
 $6FC8 LD A,(HL)     ; Fetch the coordinate.
; Multiply the coordinate by eight and add the picture origin.
@label=ScaleShape
*$6FC9 LD L,A        ; {Copy the coordinate into #REGhl.
 $6FCA LD H,$00      ; }
 $6FCC LD BC,$C350   ; Point #REGbc at #R$C350.
 $6FCF LD A,($5BBF)  ; {Jump to #R$6FDA if bit 0 of #R$5BBF is reset.
 $6FD2 BIT 0,A       ;
 $6FD4 JR Z,$6FDA    ; }
 $6FD6 INC B         ; {Add #N$0400 to the tile base.
 $6FD7 INC B         ;
 $6FD8 INC B         ;
 $6FD9 INC B         ; }
; Point at the tile bytes and choose a shift.
@label=ScaleShape_Offset
*$6FDA ADD HL,HL     ; {Multiply the coordinate by eight.
 $6FDB ADD HL,HL     ;
 $6FDC ADD HL,HL     ; }
 $6FDD ADD HL,BC     ; Add the tile base.
 $6FDE PUSH HL       ; {Point #REGix at those bytes (using the stack).
 $6FDF POP IX        ; }
 $6FE1 LD HL,$5BB2   ; Point #REGhl at #R$5BB2.
 $6FE4 LD B,$08      ; Count the #N$08 pixel rows of this tile.
 $6FE6 LD A,($5BBE)  ; Fetch #R$5BBE.
 $6FE9 AND %00110000 ; Keep only bits 4-5.
 $6FEB JR NZ,$6FF8   ; Jump to #R$6FF8 if a shift is needed.
; Copy eight unshifted bytes.
@label=ScaleShape_Copy
*$6FED LD A,(IX+$00) ; {Copy one tile byte.
 $6FF0 LD (HL),A     ; }
 $6FF1 INC IX        ; {Step both pointers.
 $6FF3 INC HL        ; }
 $6FF4 DJNZ $6FED    ; Jump to #R$6FED until eight bytes are copied.
 $6FF6 JR $704A      ; Jump to #R$704A.
; Shift left when bits 4-5 are #N$10.
@label=ScaleShape_Left
*$6FF8 CP $10        ; {Jump to #R$7014 if the shift is not #N$10.
 $6FFA JR NZ,$7014   ; }
 $6FFC LD C,$08      ; Count the #N$08 tile bytes to shift left.
; One left-shift pass.
@label=ScaleShape_LeftPass
*$6FFE LD B,$08      ; Count the #N$08 bits of this tile byte.
 $7000 LD A,(IX+$00) ; Fetch this tile byte.
; Rotate one tile byte left into the workspace.
@label=ScaleShape_LeftBit
*$7003 SLA A         ; {Rotate this bit into the workspace.
 $7005 RR (HL)       ; }
 $7007 INC HL        ; Advance the workspace pointer.
 $7008 DJNZ $7003    ; Jump to #R$7003 until eight bits are done.
 $700A LD HL,$5BB2   ; Point #REGhl at #R$5BB2.
 $700D INC IX        ; Advance the tile pointer.
 $700F DEC C         ; {Jump to #R$6FFE until eight bytes have been shifted.
 $7010 JR NZ,$6FFE   ; }
 $7012 JR $704A      ; Jump to #R$704A.
; Shift right when bits 4-5 are #N$20.
@label=ScaleShape_Right
*$7014 CP $20        ; {Jump to #R$7030 if the shift is not #N$20.
 $7016 JR NZ,$7030   ; }
 $7018 LD C,$08      ; Count the #N$08 tile bytes to shift right.
 $701A LD HL,$5BB9   ; Point #REGhl at #R$5BB2(#N$5BB9).
; One right-shift pass.
@label=ScaleShape_RightPass
*$701D LD B,$08      ; Count the #N$08 bits of this tile byte.
 $701F LD A,(IX+$00) ; Fetch this tile byte.
; Rotate one tile byte left into the workspace, backwards.
@label=ScaleShape_RightBit
*$7022 SLA A         ; {Rotate this bit into the workspace.
 $7024 RR (HL)       ;
 $7026 DJNZ $7022    ; }
 $7028 INC IX        ; {Step both pointers.
 $702A DEC HL        ; }
 $702B DEC C         ; {Jump to #R$701D until eight bytes have been shifted.
 $702C JR NZ,$701D   ; }
 $702E JR $704A      ; Jump to #R$704A.
; Shift right when bits 4-5 are #N$30.
@label=ScaleShape_Srl
*$7030 CP $30        ; {Jump to #R$704A if the shift is not #N$30.
 $7032 JR NZ,$704A   ; }
 $7034 LD C,$08      ; Count the #N$08 tile bytes to shift right.
; One logical-right pass.
@label=ScaleShape_SrlPass
*$7036 LD B,$08      ; Count the #N$08 bits of this tile byte.
 $7038 LD A,(IX+$00) ; Fetch this tile byte.
; Rotate one tile byte right into the workspace.
@label=ScaleShape_SrlBit
*$703B SRL A         ; {Rotate this bit into the workspace.
 $703D RL (HL)       ; }
 $703F INC HL        ; Advance the workspace pointer.
 $7040 DJNZ $703B    ; Jump to #R$703B until eight bits are done.
 $7042 LD HL,$5BB2   ; Point #REGhl at #R$5BB2.
 $7045 INC IX        ; Advance the tile pointer.
 $7047 DEC C         ; {Jump to #R$7036 until eight bytes have been shifted.
 $7048 JR NZ,$7036   ; }
; Optionally rotate the workspace once more.
@label=ScaleShape_Rotate
*$704A LD A,($5BBE)  ; Fetch #R$5BBE.
 $704D AND %01000000 ; Keep only bit 6.
 $704F OR A          ; {Jump to #R$7064 if bit 6 is reset.
 $7050 JR Z,$7064    ; }
 $7052 LD C,$08      ; Count the #N$08 workspace bytes to rotate left.
 $7054 LD HL,$5BB2   ; Point #REGhl at #R$5BB2.
; One extra left-shift pass.
@label=ScaleShape_RotatePass
*$7057 LD B,$08      ; {Fetch eight bits of this workspace byte.
 $7059 LD A,(HL)     ; }
; Rotate this workspace byte left.
@label=ScaleShape_RotateBit
*$705A SLA A         ; {Rotate this bit in place.
 $705C RR (HL)       ;
 $705E DJNZ $705A    ; }
 $7060 INC HL        ; Advance the workspace pointer.
 $7061 DEC C         ; {Jump to #R$7057 until eight bytes have been shifted.
 $7062 JR NZ,$7057   ; }
; Combine the workspace with the destination.
@label=ScaleShape_Combine
*$7064 LD DE,($5BBA) ; Point #REGde at #R$5BBA.
 $7068 LD HL,$5BB2   ; Point #REGhl at #R$5BB2.
 $706B LD B,$08      ; Count the #N$08 pixel rows to merge.
; Choose how this byte is merged.
@label=ScaleShape_Merge
*$706D LD A,($5BC8)  ; {Jump to #R$7078 if #R$5BC8 is not #N$04.
 $7070 CP $04        ;
 $7072 JR NZ,$7078   ; }
 $7074 LD A,(DE)     ; {#HTML(<code>OR</code> the workspace byte into the
 $7075 OR (HL)       ; destination.)
 $7076 JR $7089      ; }
; #HTML(<code>AND</code> when the combine mode is #N$08.)
@label=ScaleShape_And
*$7078 CP $08        ; {Jump to #R$7080 if #R$5BC8 is not #N$08.
 $707A JR NZ,$7080   ; }
 $707C LD A,(DE)     ; {#HTML(<code>AND</code> the workspace byte into the
 $707D AND (HL)      ; destination.)
 $707E JR $7089      ; }
; #HTML(<code>XOR</code> when the combine mode is #N$0C.)
@label=ScaleShape_Xor
*$7080 CP $0C        ; {Jump to #R$7088 if #R$5BC8 is not #N$0C.
 $7082 JR NZ,$7088   ; }
 $7084 LD A,(DE)     ; {#HTML(<code>XOR</code> the workspace byte into the
 $7085 XOR (HL)      ; destination.)
 $7086 JR $7089      ; }
; Write the merged byte.
@label=ScaleShape_Plain
*$7088 LD A,(HL)     ; Use the workspace byte as-is.
; Store this byte and step to the next pixel row.
@label=ScaleShape_Write
*$7089 LD (DE),A     ; {Write the byte to the destination and the workspace.
 $708A LD (HL),A     ; }
 $708B INC HL        ; {Step both pointers.
 $708C INC D         ; }
 $708D DJNZ $706D    ; Jump to #R$706D until eight rows are done.
 $708F LD A,($5BBE)  ; Fetch #R$5BBE.
 $7092 AND %00001100 ; Keep only bits 2-3.
 $7094 LD ($5BC8),A  ; Store that in #R$5BC8.
 $7097 JR NZ,$70BD   ; Jump to #R$70BD if it is set.
; Repeat the copy for the remaining run count.
@label=ScaleShape_Repeat
*$7099 LD A,($5BC0)  ; {Jump to #R$70BA if #R$5BC0 has reached #N$00.
 $709C OR A          ;
 $709D JR Z,$70BA    ; }
 $709F CALL $70C7    ; Call #R$70C7.
 $70A2 LD B,$08      ; Count the #N$08 pixel rows to copy.
 $70A4 LD HL,$5BB2   ; Point #REGhl at #R$5BB2.
 $70A7 LD DE,($5BBA) ; Point #REGde at #R$5BBA.
; Copy eight bytes to the destination.
@label=ScaleShape_RepeatCopy
*$70AB LD A,(HL)     ; {Copy this byte.
 $70AC LD (DE),A     ; }
 $70AD INC HL        ; {Step both pointers.
 $70AE INC D         ; }
 $70AF DJNZ $70AB    ; Jump to #R$70AB until eight rows are done.
 $70B1 LD A,($5BC0)  ; {Count down #R$5BC0.
 $70B4 DEC A         ;
 $70B5 LD ($5BC0),A  ; }
 $70B8 JR NZ,$7099   ; Jump to #R$7099 until the run is done.
; Step the destination on after the run.
@label=ScaleShape_Step
*$70BA CALL $70C7    ; Call #R$70C7.
; Fetch the next shape byte.
@label=ScaleShape_Next
*$70BD LD HL,($5BBC) ; {Advance #R$5BBC.
 $70C0 INC HL        ;
 $70C1 LD ($5BBC),HL ; }
 $70C4 JP $6F6C      ; Jump to #R$6F6C.
; Step the destination to the next column, wrapping at the row width.
@label=ScaleShape_Column
*$70C7 LD DE,($5BBA) ; {Advance #R$5BBA.
 $70CB INC DE        ;
 $70CC LD ($5BBA),DE ; }
 $70D0 LD HL,$5BC6   ; Point #REGhl at #R$5BC6.
 $70D3 DEC (HL)      ; {Return if this row still has columns left.
 $70D4 RET NZ        ; }
 $70D5 LD HL,$5BC7   ; Point #REGhl at #R$5BC7.
 $70D8 DEC (HL)      ; {Jump to #R$70F6 if the remaining rows have run out.
 $70D9 JR Z,$70F6    ; }
 $70DB LD A,($5BC4)  ; {Copy #R$5BC4 into #R$5BC6.
 $70DE LD ($5BC6),A  ; }
 $70E1 LD A,($5BC3)  ; {Step #R$5BC3.
 $70E4 INC A         ;
 $70E5 LD ($5BC3),A  ; }
; Look up the new row.
 $70E8 CALL $7532    ; Call #R$7532.
 $70EB LD A,($5BC1)  ; {Copy #R$5BC1 into #REGhl.
 $70EE LD L,A        ;
 $70EF LD H,$00      ; }
 $70F1 ADD HL,DE     ; Add the destination.
 $70F2 LD ($5BBA),HL ; Store it in #R$5BBA.
 $70F5 RET           ; Return.

; Abandon Shape
;
; Used by the routines at #R$6F57 and #R$710E.
; .
; Drops the return address of #R$70C7 so #R$6F57 returns at once.
@label=AbandonShape
c$70F6 POP AF        ; Drop the return address.
 $70F7 RET           ; Return.

; Paint Shape On Screen
;
; Finds the shape, expands it with #R$6F57, and points the destination
; at #N$5800 (attribute buffer).
@label=ScaleShape_Screen
c$70F8 CALL $718B    ; Call #R$718B.
 $70FB LD A,($5BC1)  ; {Copy #R$5BC1 into #REGbc.
 $70FE LD C,A        ;
 $70FF LD B,$00      ; }
 $7101 LD A,($5BC2)  ; Fetch #R$5BC2.
; Address the picture byte.
 $7104 CALL $6F57    ; Call #R$6F57.
 $7107 LD DE,$5800   ; Point #REGde at #N$5800 (attribute buffer).
 $710A LD ($5BC9),DE ; Store it in #R$5BC9.
; Continue on to #R$710E.

; Paint Shape Bytes
;
; Used by the routine at #R$6EC1.
; .
; Copies the expanded shape into the attribute buffer, honouring the #N$FE
; and #N$FB markers that end or repeat a run.
@label=PaintShape
c$710E LD HL,($5BBC) ; Fetch #R$5BBC.
 $7111 INC HL        ; Step to the first shape byte.
 $7112 PUSH HL       ; Stash that pointer on the stack.
 $7113 LD A,($5BC4)  ; {Copy #R$5BC4 into #R$5BC6.
 $7116 LD ($5BC6),A  ; }
 $7119 LD HL,($5BC2) ; Fetch #R$5BC2.
 $711C LD H,$00      ; Keep only the low byte.
 $711E CALL $0E93    ; Call #SKOOLKID$0E44,$0E93(CL_LINE).
 $7121 LD A,($5BC1)  ; {Copy #R$5BC1 into #REGde.
 $7124 LD E,A        ;
 $7125 LD D,$00      ; }
 $7127 ADD HL,DE     ; Add the X coordinate.
 $7128 LD DE,($5BC9) ; Fetch #R$5BC9.
 $712C ADD HL,DE     ; Add it.
 $712D EX DE,HL      ; Swap the destination into #REGde.
 $712E POP HL        ; Restore the shape pointer from the stack.
; Paint the next shape byte.
@label=PaintShape_Byte
*$712F PUSH HL       ; Stash the shape pointer on the stack.
 $7130 LD A,(HL)     ; Fetch this shape byte.
 $7131 CP $FB        ; {Jump to #R$713C if it is not #N$FB.
 $7133 JR NZ,$713C   ; }
 $7135 PUSH DE       ; Stash the destination on the stack.
; Fetch the parameter byte.
 $7136 CALL $71EB    ; Call #R$71EB.
 $7139 POP DE        ; Restore the destination from the stack.
 $713A POP BC        ; {Replace the shape pointer (using the stack).
 $713B PUSH HL       ; }
; The terminator #N$FE ends the shape, and #N$FA copies a parameter
; block.
@label=PaintShape_Markers
*$713C CP $FE        ; {Jump to #R$70F6 if it is the terminator #N$FE.
 $713E JR Z,$70F6    ; }
 $7140 CP $FA        ; {Jump to #R$714C if it is not #N$FA.
 $7142 JR NZ,$714C   ; }
; Copy the parameter block.
 $7144 PUSH DE       ; {Call #R$71FF.
 $7145 CALL $71FF    ;
 $7148 POP DE        ; }
 $7149 POP AF        ; Drop the old pointer.
 $714A JR $712F      ; Jump to #R$712F.
; A run-length byte has bit 7 set.
@label=PaintShape_Run
*$714C BIT 7,A       ; {Jump to #R$7159 if bit 7 is reset.
 $714E JR Z,$7159    ; }
 $7150 AND %01111111 ; Keep only bits 0-6.
 $7152 DEC A         ; {Store that in #R$5BC0.
 $7153 LD ($5BC0),A  ; }
 $7156 LD A,($5BCB)  ; Fetch #R$5BCB.
; Write this attribute byte.
@label=PaintShape_Write
*$7159 LD (DE),A     ; Write the byte.
 $715A LD ($5BCB),A  ; Store it in #R$5BCB.
 $715D INC DE        ; Advance the destination.
 $715E LD HL,$5BC6   ; Point #REGhl at #R$5BC6.
 $7161 DEC (HL)      ; {Jump to #R$7175 if this row still has columns left.
 $7162 JR NZ,$7175   ; }
 $7164 PUSH HL       ; Stash the column counter on the stack.
 $7165 LD A,($5BC4)  ; {Copy #R$5BC4 into #R$5BC6.
 $7168 LD ($5BC6),A  ; }
 $716B LD L,A        ; {#N$20 minus the columns used.
 $716C LD A,$20      ;
 $716E SUB L         ;
 $716F LD L,A        ; }
 $7170 LD H,$00      ; {Add that gap to the destination.
 $7172 ADD HL,DE     ;
 $7173 EX DE,HL      ; }
 $7174 POP HL        ; Restore the column counter from the stack.
; Repeat the last byte for the remaining run count.
@label=PaintShape_Repeat
*$7175 LD A,($5BC0)  ; {Jump to #R$7184 if #R$5BC0 has reached #N$00.
 $7178 OR A          ;
 $7179 JR Z,$7184    ; }
 $717B DEC A         ; {Decrement #R$5BC0.
 $717C LD ($5BC0),A  ; }
 $717F LD A,($5BCB)  ; Fetch #R$5BCB.
 $7182 JR $7159      ; Jump to #R$7159.
; Step on to the next shape byte.
@label=PaintShape_Next
*$7184 POP HL        ; Restore the shape pointer from the stack.
 $7185 INC HL        ; Advance it.
 $7186 JR $712F      ; Jump to #R$712F.

; Last Shape Number
;
; The shape last looked up by #R$718B. It starts at #N$FF so the first
; search does not reuse a match.
@label=LastShapeNumber
g$7188 DEFB $FF

; Last Shape Address
;
; The address of that shape. The same number is served from here without
; walking #R$C708 again.
@label=LastShapeAddress
g$7189 DEFW $0000

; Find Shape In Picture Font
;
; Used by the routines at #R$6EC1 and #R$70F8.
; .
; Looks the shape number up in #R$C708 and remembers its address.
@label=FindShape
c$718B LD HL,$7188   ; Point #REGhl at #R$7188.
 $718E CP (HL)       ; {Jump to #R$7199 if this is not the last matched shape.
 $718F JR NZ,$7199   ; }
 $7191 LD HL,($7189) ; Reuse the last matched address.
 $7194 LD B,$00      ; {Point #REGbc at this shape number.
 $7196 LD C,A        ; }
 $7197 JR $71AF      ; Jump to #R$71AF.
; Walk the shapes from #R$C708.
@label=FindShape_Search
*$7199 LD HL,$C708   ; Point #REGhl at #R$C708.
 $719C LD B,A        ; {Copy the shape number into #REGbc.
 $719D LD C,A        ; }
 $719E LD ($7188),A  ; Remember it at #R$7188.
 $71A1 OR A          ; {Jump to #R$71AF if the shape number is #N$00.
 $71A2 JR Z,$71AF    ; }
; Skip to the next #N$FE terminator.
@label=FindShape_Skip
*$71A4 INC HL        ; {Advance to the next byte.
 $71A5 LD A,(HL)     ; }
 $71A6 CP $FE        ; {Jump to #R$71AC if it is the terminator #N$FE.
 $71A8 JR Z,$71AC    ; }
 $71AA JR $71A4      ; Jump to #R$71A4.
; Count down through the remaining shapes.
@label=FindShape_Count
*$71AC DJNZ $71A4    ; Jump to #R$71A4 until this shape is reached.
 $71AE INC HL        ; Step to its first byte.
; Remember the match and decode its size.
@label=FindShape_Size
*$71AF LD ($7189),HL ; Store it in #R$7189.
 $71B2 LD A,(HL)     ; Fetch the header.
 $71B3 PUSH AF       ; Stash it on the stack.
 $71B4 AND %11110000 ; Keep only bits 4-7.
 $71B6 RRA           ; {Shift that width down.
 $71B7 RRA           ;
 $71B8 RRA           ;
 $71B9 RRA           ; }
 $71BA INC A         ; Add one.
 $71BB PUSH AF       ; Stash the width on the stack.
; Some shape numbers are sixteen pixels wider.
 $71BC LD A,C        ; Fetch the shape number.
 $71BD CP $0D        ; {Jump to #R$71D5 if it is #N($0D), #N($22), #N($6F),
 $71BF JR Z,$71D5    ; #N($0F) or #N$11.
 $71C1 CP $22        ;
 $71C3 JR Z,$71D5    ;
 $71C5 CP $6F        ;
 $71C7 JR Z,$71D5    ;
 $71C9 CP $0F        ;
 $71CB JR Z,$71D5    ;
 $71CD CP $11        ;
 $71CF JR Z,$71D5    ; }
 $71D1 CP $55        ; {Jump to #R$71D9 if it is not #N$55.
 $71D3 JR NZ,$71D9   ; }
; Add sixteen to the width of those shapes.
@label=FindShape_Wide
*$71D5 POP AF        ; {Add #N$10 to the width.
 $71D6 ADD A,$10     ;
 $71D8 PUSH AF       ; }
; Store the width and height.
@label=FindShape_Store
*$71D9 POP AF        ; Restore the width from the stack.
 $71DA LD ($5BC4),A  ; {Store the width in #R$5BC4 and #R$5BC6.
 $71DD LD ($5BC6),A  ; }
 $71E0 POP AF        ; Restore the header from the stack.
 $71E1 AND %00001111 ; Keep only bits 0-3.
 $71E3 INC A         ; Add one.
 $71E4 LD ($5BC5),A  ; {Store the height in #R$5BC5 and #R$5BC7.
 $71E7 LD ($5BC7),A  ; }
 $71EA RET           ; Return.

; Fetch Parameter Byte
;
; Used by the routines at #R$6F57 and #R$710E.
; .
; Returns the next parameter byte while #R$5B9E is non-zero, otherwise
; the next shape byte from #R$5BCC.
;
; O:A The byte
;
; Fetch a byte from the parameter block, or the next shape byte.
@label=FetchParameterByte
c$71EB LD A,($5B9E)  ; {Jump to #R$71FA if #R$5B9E is #N$00.
 $71EE OR A          ;
 $71EF JR Z,$71FA    ; }
 $71F1 DEC A         ; {Count one fewer in #R$5B9E.
 $71F2 LD ($5B9E),A  ; }
 $71F5 LD HL,$5B9F   ; Point #REGhl at #R$5B9F.
 $71F8 LD A,(HL)     ; Fetch that byte.
 $71F9 RET           ; Return.
; Fetch the next shape byte after the parameters.
@label=FetchParameterByte_Stream
*$71FA LD HL,($5BCC) ; Fetch #R$5BCC.
 $71FD LD A,(HL)     ; Fetch that byte.
 $71FE RET           ; Return.

; Copy Parameter Block
;
; Used by the routines at #R$6F57 and #R$710E.
; .
; Copies a length-prefixed parameter block from the shape stream to
; #R$5B9E and terminates it with #N$FB.
@label=CopyParameterBlock
c$71FF INC HL        ; Step to the length.
 $7200 LD C,(HL)     ; {Fetch it into #REGbc.
 $7201 LD B,$00      ; }
 $7203 LD DE,$5B9E   ; Point #REGde at #R$5B9E.
 $7206 INC HL        ; Step past the length.
 $7207 LDIR          ; Copy those bytes.
 $7209 LD ($5BCC),HL ; Store #REGhl in #R$5BCC.
 $720C LD HL,$5B9F   ; Point #REGhl at #R$5B9F.
 $720F LD A,$FB      ; {Terminate that copy with #N$FB.
 $7211 LD (DE),A     ; }
 $7212 RET           ; Return.

; Draw Shape When Object Is Here
;
; Used by the routine at #R$6E7F.
; .
; #HTML[Opcode #N$F8 names an object. The following shape is drawn only
; when that object is in the current room. The object id is written over the
; low address byte (#R$5F10(#N$5F11)) of <code>LD (*#R$5B85),#REGa</code> at
; #R$5F10, so the next unrecognised line zeros #R$5B00 plus that id. Those
; addresses are the command buffer and the bytes after it, not object state.
; When the object is absent the operand is set to #N$00. #R$696C compares
; #R$5F15, which this routine never writes.]
@label=ShapeIfPresent
c$7213 INC IX        ; Advance the record pointer.
 $7215 LD A,(IX+$00) ; Fetch the object id.
 $7218 LD HL,$5DCA   ; Point #REGhl at #R$5DCA.
 $721B LD C,A        ; {Index by the object number.
 $721C LD B,$00      ;
 $721E ADD HL,BC     ; }
 $721F LD A,($5D87)  ; {Jump to #R$7233 if it is not in *#R$5D87.
 $7222 CP (HL)       ;
 $7223 JR NZ,$7233   ; }
 $7225 LD A,(IX+$00) ; {#HTML[Patch #R$5F10(#N$5F11), the low address byte of
 $7228 LD ($5F11),A  ; <code>LD (*#R$5B85),#REGa</code>, with the object id.]}
 $722B INC IX        ; Advance the record pointer.
 $722D LD A,(IX+$00) ; Fetch the shape number.
 $7230 JP $6EC1      ; Jump to #R$6EC1.
; Skip the shape when the object is elsewhere.
@label=ShapeIfPresent_Skip
*$7233 INC IX        ; {Step past the unused operands.
 $7235 INC IX        ;
 $7237 INC IX        ;
 $7239 INC IX        ; }
 $723B XOR A         ; {#HTML[Clear #R$5F10(#N$5F11), the low address byte of
 $723C LD ($5F11),A  ; <code>LD (*#R$5B85),#REGa</code>.]}
 $723F JP $6E53      ; Jump to #R$6E53.

; Reverse Pixel Row
;
; Used by the routine at #R$728C.
; .
; Reverses each pixel row of the current strip into the illustration.
@label=ReversePixelRow
c$7242 PUSH BC       ; Stash the row counter on the stack.
 $7243 CALL $73F1    ; Call #R$73F1.
 $7246 PUSH HL       ; Stash the start of the row on the stack.
 $7247 LD DE,$0000   ; Load the patched width.
 $724A LD B,$08      ; Count the #N$08 pixel rows to reverse.
 $724C ADD HL,DE     ; {Point #REGde at the start and #REGhl at the far end.
 $724D DEC HL        ;
 $724E POP DE        ; }
; Reverse one pixel row.
@label=ReversePixelRow_Row
*$724F PUSH HL       ; {Stash the row pointers and the bit counter.
 $7250 PUSH DE       ;
 $7251 PUSH BC       ; }
 $7252 LD B,$00      ; Copy #N$0100 bytes.
; Reverse one byte.
@label=ReversePixelRow_Byte
*$7254 LD A,(DE)     ; Fetch the source byte.
 $7255 LD C,$80      ; Bit 7 of #REGc is set.
; Rotate its bits into #REGc.
@label=ReversePixelRow_Bit
*$7257 RL A          ; {Jump to #R$7257 until the byte is reversed.
 $7259 RR C          ;
 $725B JR NC,$7257   ; }
 $725D LD (HL),C     ; Write the reversed byte.
 $725E INC DE        ; {Step both pointers.
 $725F DEC HL        ; }
 $7260 DJNZ $7254    ; Jump to #R$7254 until the row is done.
 $7262 POP BC        ; {Restore the bit counter and the row pointers.
 $7263 POP DE        ;
 $7264 POP HL        ; }
 $7265 INC D         ; {Step both pointers.
 $7266 INC H         ; }
 $7267 DJNZ $724F    ; Jump to #R$724F until eight pixel rows are done.
 $7269 POP BC        ; Restore the row counter from the stack.
 $726A INC B         ; {Jump to #R$7242 until the patched row count is done.
 $726B LD A,$00      ;
 $726D CP B          ;
 $726E JR NZ,$7242   ; }
 $7270 RET           ; Return.

; Reverse Attribute Row
;
; Used by the routine at #R$728C.
; .
; Copies a reversed attribute row into the illustration buffer.
@label=ReverseAttributeRow
c$7271 PUSH BC       ; Stash the row counter on the stack.
 $7272 CALL $73AE    ; Call #R$73AE.
 $7275 LD DE,$0000   ; Load the patched width.
 $7278 PUSH HL       ; {Point #REGde at the start and #REGhl at the far end.
 $7279 ADD HL,DE     ;
 $727A DEC HL        ;
 $727B POP DE        ; }
 $727C LD B,$00      ; Copy #N$0100 bytes.
; Copy one reversed byte.
@label=ReverseAttributeRow_Byte
*$727E LD A,(DE)     ; {Copy this byte.
 $727F LD (HL),A     ; }
 $7280 INC DE        ; {Step both pointers.
 $7281 DEC HL        ; }
 $7282 DJNZ $727E    ; Jump to #R$727E until the row is done.
 $7284 POP BC        ; Restore the row counter from the stack.
 $7285 INC B         ; {Jump to #R$7271 until the patched row count is done.
 $7286 LD A,$00      ;
 $7288 CP B          ;
 $7289 JR NZ,$7271   ; }
 $728B RET           ; Return.

; Patch Shift Immediate
;
; Used by the routine at #R$72B5.
; .
; Writes the row count over the loop stops and the shift over the offset
; immediates, so the shape can move by a fraction of a pixel.
@label=PatchShift
c$728C LD A,(IX+$03) ; {Self-modify the loop stops at #R$726A(#N$726C) and
 $728F LD ($726C),A  ; #R$7285(#N$7287).
 $7292 LD ($7287),A  ; }
 $7295 LD A,(IX+$04) ; Fetch the shift.
 $7298 LD B,(IX+$01) ; Fetch the Y coordinate.
 $729B LD C,(IX+$02) ; Fetch the X coordinate.
; This entry point is used by the routine at #R$72C0.
; .
; Patch the offset immediates and draw both layers.
@label=PatchShift_Draw
*$729E LD ($7248),A  ; {Self-modify the reverse widths at #R$7247(#N$7248) and
 $72A1 LD ($7276),A  ; #R$7275(#N$7276).}
 $72A4 AND A         ; {Halve the shift.
 $72A5 RRA           ; }
 $72A6 LD ($7253),A  ; {Self-modify the inner counts at #R$7252(#N$7253) and
 $72A9 LD ($727D),A  ; #R$727C(#N$727D).}
; Reverse the pixels.
 $72AC PUSH BC       ; Stash the coordinates on the stack.
 $72AD CALL $7242    ; Call #R$7242.
 $72B0 POP BC        ; Restore the coordinates from the stack.
; Reverse the attributes.
 $72B1 CALL $7271    ; Call #R$7271.
 $72B4 RET           ; Return.

; Draw With Patched Shift
;
; Used by the routine at #R$6E7F.
; .
; Opcode #N$F2 patches the shift, draws, and steps the picture pointer on
; by five bytes.
@label=DrawPatched
c$72B5 CALL $728C    ; Call #R$728C.
 $72B8 LD DE,$0005   ; {Step the record pointer on by five.
 $72BB ADD IX,DE     ; }
 $72BD JP $6E53      ; Jump to #R$6E53.

; Draw With Fixed Shift
;
; Used by the routine at #R$6E53.
; .
; Used for picture record #N$FE. The shift immediate is forced to #N$0C.
@label=DrawFixedShift
c$72C0 LD A,$0C      ; {Write #N$0C over the loop stops at #R$726A(#N$726C) and
 $72C2 LD ($726C),A  ; #R$7285(#N$7287).
 $72C5 LD ($7287),A  ; }
 $72C8 LD A,$20      ; Reverse all #N$20 character columns of the illustration.
 $72CA LD BC,$0000   ; Start at column #N($00), row #N$00.
 $72CD CALL $729E    ; Call #R$729E.
 $72D0 INC IX        ; Advance the record pointer.
 $72D2 JP $6E53      ; Jump to #R$6E53.

; Copy Origin Attributes
;
; Used by the routine at #R$733B.
; .
; Copies attribute rows from #R$7337 into #R$7339 until *#R$733A
; equals the stop patched by #R$733B. #R$733B and #R$738D also patch the
; width copied on each row.
@label=CopyOrigin_Attributes
c$72D5 LD BC,($7337) ; Fetch *#R$7337.
 $72D9 CALL $73AE    ; Call #R$73AE.
 $72DC PUSH HL       ; Stash the source pointer on the stack.
 $72DD LD BC,($7339) ; Fetch *#R$7339.
 $72E1 CALL $73AE    ; Call #R$73AE.
 $72E4 POP DE        ; Copy the source pointer into #REGde (using the stack).
; The width immediate is self-modified by #R$733B and #R$738D.
 $72E5 LD BC,$0000   ; Load that width.
 $72E8 EX DE,HL      ; Point #REGhl at the source and #REGde at the
                     ; destination.
 $72E9 LDIR          ; Copy one attribute row.
; Step to the next row.
 $72EB LD A,($7338)  ; {Increment *#R$7338.
 $72EE INC A         ;
 $72EF LD ($7338),A  ; }
 $72F2 LD A,($733A)  ; {Decrement *#R$733A.
 $72F5 DEC A         ;
 $72F6 LD ($733A),A  ; }
; The stop immediate is self-modified by #R$7361.
 $72F9 CP $00        ; {Jump to #R$72D5 until *#R$733A equals that stop.
 $72FB JR NZ,$72D5   ; }
 $72FD RET           ; Return.

; Copy Origin Pixels
;
; Used by the routine at #R$733B.
; .
; Copies pixel rows from #R$7337 into #R$7339 until *#R$733A equals
; the stop patched by #R$733B.
@label=CopyOrigin_Pixels
c$72FE LD BC,($7337) ; Fetch *#R$7337.
 $7302 CALL $73F1    ; Call #R$73F1.
 $7305 PUSH HL       ; Stash the source pointer on the stack.
 $7306 LD BC,($7339) ; Fetch *#R$7339.
 $730A CALL $73F1    ; Call #R$73F1.
 $730D POP DE        ; Copy the source pointer into #REGde (using the stack).
 $730E LD A,H        ; {Move the destination seven rows down.
 $730F ADD A,$07     ;
 $7311 LD H,A        ; }
 $7312 LD B,$08      ; Count the #N$08 pixel rows to copy.
 $7314 EX DE,HL      ; Switch the destination into #REGde.
; Copy eight pixel rows.
@label=CopyOrigin_PixelRow
*$7315 PUSH BC       ; {Stash the counters on the stack.
 $7316 PUSH DE       ;
 $7317 PUSH HL       ; }
; The width immediate is self-modified by #R$733B and #R$738D.
 $7318 LD BC,$0000   ; Load that width.
 $731B LDIR          ; Copy those bytes.
 $731D POP HL        ; {Restore the counters from the stack.
 $731E POP DE        ;
 $731F POP BC        ; }
 $7320 INC H         ; {Step both pointers.
 $7321 DEC D         ; }
 $7322 DJNZ $7315    ; Jump to #R$7315 until eight pixel rows are done.
 $7324 LD A,($7338)  ; {Increment *#R$7338.
 $7327 INC A         ;
 $7328 LD ($7338),A  ; }
 $732B LD A,($733A)  ; {Decrement *#R$733A.
 $732E DEC A         ;
 $732F LD ($733A),A  ; }
; The stop immediate is self-modified by #R$7361.
 $7332 CP $00        ; {Jump to #R$72FE until *#R$733A equals that stop.
 $7334 JR NZ,$72FE   ; }
 $7336 RET           ; Return.

; Source Origin
;
; Column and row copied from by #R$72FE and #R$72D5.
@label=SourceOrigin
g$7337 DEFB $00
; Source row.
@label=SourceOrigin_Row
 $7338 DEFB $00

; Destination Origin
;
; Column and remaining height written with the source origin.
@label=DestinationOrigin
g$7339 DEFB $00
; Remaining height.
@label=DestinationOrigin_Height
 $733A DEFB $00

; Set Drawing Origin
;
; Used by the routine at #R$7382.
; .
; Opcode #N$F1 stores the source and destination from the picture
; record, patches the copy widths and loop stops, then copies pixels and
; attributes. The destination row counts down, so the rectangle is drawn
; upside down. #R$738D enters at #R$7361.
;
; IX Picture record
@label=SetOrigin
c$733B LD A,(IX+$01) ; {Write the source column to *#R$7337 and *#R$7339.
 $733E LD ($7337),A  ;
 $7341 LD ($7339),A  ; }
 $7344 LD A,(IX+$02) ; {Write the source row to *#R$7338.
 $7347 LD ($7338),A  ; }
 $734A LD A,(IX+$03) ; {Write the destination row to *#R$733A.
 $734D LD ($733A),A  ; }
 $7350 LD A,(IX+$04) ; {Self-modify the copy widths at #R$7318(#N$7319) and
 $7353 LD ($7319),A  ; #R$72E5(#N$72E6).
 $7356 LD ($72E6),A  ; }
 $7359 LD A,(IX+$03) ; {Subtract the source row from the destination row.
 $735C SUB (IX+$02)  ; }
 $735F AND A         ; {Halve that span.
 $7360 RRA           ; }
; This entry point is used by the routine at #R$738D.
; .
; Patch the loop stops and copy from the origin.
@label=SetOrigin_Copy
*$7361 LD ($7333),A  ; {Self-modify the loop stops at #R$7332(#N$7333) and
 $7364 LD ($72FA),A  ; #R$72F9(#N$72FA).}
 $7367 LD BC,($7337) ; Fetch *#R$7337.
 $736B LD DE,($7339) ; Fetch *#R$7339.
 $736F PUSH BC       ; {Stash #REGbc and #REGde on the stack.
 $7370 PUSH DE       ; }
; Copy the pixels, then put the origins back.
 $7371 CALL $72FE    ; Call #R$72FE.
 $7374 POP DE        ; {Restore #REGde and #REGbc from the stack.
 $7375 POP BC        ; }
 $7376 LD ($7337),BC ; Write #REGbc to *#R$7337.
 $737A LD ($7339),DE ; Write #REGde to *#R$7339.
; Copy the attributes.
 $737E CALL $72D5    ; Call #R$72D5.
 $7381 RET           ; Return.

; Draw From Origin
;
; Used by the routine at #R$6E7F.
; .
; Opcode #N$F1 sets the origin, draws, and steps on by five bytes.
@label=DrawFromOrigin
c$7382 CALL $733B    ; Call #R$733B.
 $7385 LD DE,$0005   ; {Step the record pointer on by five.
 $7388 ADD IX,DE     ; }
 $738A JP $6E53      ; Jump to #R$6E53.

; Reset Drawing Origin
;
; Used by the routine at #R$6E7F.
; .
; Opcode #N$F3 sets *#R$7337, *#R$7339 and *#R$7338 to #N($00), *#R$733A
; to the bottom illustration row #N($0B), and the copy width to #N$20. It
; then copies that full-width rectangle through #R$7361. The destination
; row counts down, so the copy is upside down.
;
; IX Picture record
@label=ResetOrigin
c$738D XOR A         ; {Write #N$00 to *#R$7337, *#R$7339 and *#R$7338.
 $738E LD ($7337),A  ;
 $7391 LD ($7339),A  ;
 $7394 LD ($7338),A  ; }
 $7397 LD A,$0B      ; {Write #N$0B to *#R$733A, the bottom row of the
 $7399 LD ($733A),A  ; illustration.}
 $739C LD A,$20      ; {Self-modify the copy widths at #R$7318(#N$7319) and
 $739E LD ($7319),A  ; #R$72E5(#N$72E6) to #N$20.
 $73A1 LD ($72E6),A  ; }
; Copy the default rectangle.
 $73A4 LD A,$05      ; {Call #R$7361 with the loop stop set to #N$05.
 $73A6 CALL $7361    ; }
 $73A9 INC IX        ; Step past this opcode.
 $73AB JP $6E53      ; Jump to #R$6E53.

; Address Attribute Row
;
; Used by the routines at #R$7271, #R$72D5 and #R$74BE.
; .
; Turns a character row in #REGb and a column in #REGc into a pointer
; inside #R$6C7A.
;
;   B Character row
;   C Column
; O:HL Attribute pointer
@label=AttributeRow
c$73AE LD H,$00      ; {Copy the row into #REGhl.
 $73B0 LD L,B        ; }
 $73B1 ADD HL,HL     ; {Multiply by #N$20.
 $73B2 ADD HL,HL     ;
 $73B3 ADD HL,HL     ;
 $73B4 ADD HL,HL     ;
 $73B5 ADD HL,HL     ; }
 $73B6 LD DE,$6C7A   ; Point #REGde at #R$6C7A.
 $73B9 ADD HL,DE     ; Add that buffer.
 $73BA LD B,$00      ; {Add the column.
 $73BC ADD HL,BC     ; }
 $73BD RET           ; Return.

; Plot Shape With #N$0C
;
; Used by the routine at #R$6E7F.
; .
; Opcode #N$F7 plots the following shape after writing #N$0C to #R$6EEE.
; No instruction reads that byte, and no picture record uses this opcode.
;
; IX Picture record
@label=OpcodeF7
c$73BE LD B,(IX+$01) ; Fetch the following shape.
 $73C1 LD A,$0C      ; Load #N$0C to store at #R$6EEE.
 $73C3 INC IX        ; Advance the record pointer.
 $73C5 JP $6EBD      ; Jump to #R$6EBD.

; Plot Shape With #N$04
;
; Used by the routine at #R$6E7F.
; .
; Opcode #N$F5 plots the following shape after writing #N$04 to #R$6EEE.
; No instruction reads that byte, and no picture record uses this opcode.
;
; IX Picture record
@label=OpcodeF5
c$73C8 LD B,(IX+$01) ; Fetch the following shape.
 $73CB LD A,$04      ; Load #N$04 to store at #R$6EEE.
 $73CD INC IX        ; Advance the record pointer.
 $73CF JP $6EBD      ; Jump to #R$6EBD.

; Plot Shape With #N$08
;
; Used by the routine at #R$6E7F.
; .
; Opcode #N$F6 plots the following shape after writing #N$08 to #R$6EEE.
; No instruction reads that byte, and no picture record uses this opcode.
;
; IX Picture record
@label=OpcodeF6
c$73D2 LD B,(IX+$01) ; Fetch the following shape.
 $73D5 LD A,$08      ; Load #N$08 to store at #R$6EEE.
 $73D7 INC IX        ; Advance the record pointer.
 $73D9 JP $6EBD      ; Jump to #R$6EBD.

; Continue If Present
;
; Used by the routine at #R$6E7F.
; .
; Continues the picture record when the named object is in this room. If
; it is elsewhere, the rest of the picture is abandoned.
@label=ShapeForObject
c$73DC LD E,(IX+$01) ; Fetch the object number.
 $73DF LD HL,$5DCA   ; Point #REGhl at #R$5DCA.
 $73E2 LD D,$00      ; {Index by the object number.
 $73E4 ADD HL,DE     ; }
 $73E5 LD A,($5D87)  ; {Return if it is not in *#R$5D87.
 $73E8 CP (HL)       ;
 $73E9 RET NZ        ; }
 $73EA INC IX        ; {Step past this opcode and the object.
 $73EC INC IX        ; }
 $73EE JP $6E53      ; Jump to #R$6E53.

; Address Pixel Row
;
; Used by the routines at #R$7242, #R$72FE, #R$7417, #R$745D and #R$748B.
; .
; Turns a pixel row in #REGb into a display address via the character-row
; table.
;
;   B Pixel row
;   C Column
; O:HL Display address
@label=PixelRow
c$73F1 LD A,B        ; {Call #R$7532 with the pixel row.
 $73F2 CALL $7532    ; }
 $73F5 PUSH DE       ; {Copy the screen address to #REGhl (using the stack).
 $73F6 POP HL        ; }
 $73F7 LD B,$00      ; {Add the column.
 $73F9 ADD HL,BC     ; }
 $73FA RET           ; Return.

; Rotate Row Left
;
; Used by the routine at #R$7417.
; .
; Rotates one character row left by one bit.
@label=PixelRow_Left
c$73FB PUSH BC       ; {Stash #REGbc and #REGhl on the stack.
 $73FC PUSH HL       ; }
; The width immediate is self-modified by #R$7428.
 $73FD LD BC,$0000   ; {Add that width.
 $7400 ADD HL,BC     ; }
 $7401 LD B,C        ; Copy the width into #REGb.
 $7402 DEC HL        ; Point at the last byte.
 $7403 PUSH HL       ; {Copy that address into #REGde (using the stack).
 $7404 POP DE        ; }
; Rotate this row left by one bit.
@label=PixelRow_LeftBit
*$7405 RL (HL)       ; Rotate this byte left.
 $7407 DEC HL        ; Step back one byte.
 $7408 DJNZ $7405    ; Jump to #R$7405 until the width is rotated.
 $740A EX DE,HL      ; {Wrap the outgoing bit into bit 0.
 $740B RES 0,(HL)    ;
 $740D JR NC,$7411   ;
 $740F SET 0,(HL)    ; }
; Restore the pointers after the wrap.
@label=PixelRow_Left_Restore
*$7411 POP HL        ; {Restore #REGhl and #REGbc from the stack.
 $7412 POP BC        ; }
 $7413 INC H         ; Step to the next pixel row.
 $7414 DJNZ $73FB    ; Jump to #R$73FB until eight pixel rows are done.
 $7416 RET           ; Return.

; Rotate Rows Left
;
; Used by the routine at #R$7428.
; .
; Rotates consecutive character rows left.
@label=PixelRow_LeftRun
c$7417 PUSH BC       ; Stash the row counter on the stack.
 $7418 CALL $73F1    ; Call #R$73F1.
 $741B LD B,$08      ; {Call #R$73FB with eight pixel rows.
 $741D CALL $73FB    ; }
 $7420 POP BC        ; Restore the row counter from the stack.
 $7421 INC B         ; Increment the row counter.
 $7422 LD A,B        ; Copy it into #REGa.
; The stop immediate is self-modified by #R$7428.
 $7423 CP $00        ; {Jump to #R$7417 until it equals that stop.
 $7425 JR NZ,$7417   ; }
 $7427 RET           ; Return.

; Draw Horizontal Run
;
; Used by the routine at #R$6E7F.
; .
; Opcode #N$F0 draws a horizontal run of pixels, patching its own length
; and shift bytes, then steps on by five.
@label=HorizontalRun
c$7428 LD C,(IX+$01) ; Fetch the column.
 $742B LD B,(IX+$02) ; Fetch the row.
 $742E LD A,(IX+$03) ; {Self-modify the loop stop at #R$7423(#N$7424).
 $7431 LD ($7424),A  ; }
 $7434 LD A,(IX+$04) ; {Self-modify the rotate width at #R$73FD(#N$73FE).
 $7437 LD ($73FE),A  ; }
 $743A CALL $7417    ; Call #R$7417.
 $743D LD DE,$0005   ; {Step the record pointer on by five.
 $7440 ADD IX,DE     ; }
 $7442 JP $6E53      ; Jump to #R$6E53.

; Rotate Row Right
;
; Used by the routine at #R$745D.
; .
; Rotates one character row right by one bit.
@label=HorizontalRun_Right
c$7445 PUSH BC       ; {Stash #REGbc and #REGhl on the stack.
 $7446 PUSH HL       ; }
; The width immediate is self-modified by #R$746E.
 $7447 LD B,$00      ; Load that width.
 $7449 PUSH HL       ; {Copy #REGhl to #REGde (using the stack).
 $744A POP DE        ; }
; Rotate this row right by one bit.
@label=HorizontalRun_RightBit
*$744B RR (HL)       ; Rotate this byte right.
 $744D INC HL        ; Step on one byte.
 $744E DJNZ $744B    ; Jump to #R$744B until the width is rotated.
 $7450 EX DE,HL      ; Point #REGhl at the start of the row.
 $7451 RES 7,(HL)    ; Clear bit 7.
 $7453 JR NC,$7457   ; Jump to #R$7457 if the outgoing bit is reset.
 $7455 SET 7,(HL)    ; Set bit 7.
; Restore the pointers after the wrap.
@label=HorizontalRun_Right_Restore
*$7457 POP HL        ; {Restore #REGhl and #REGbc from the stack.
 $7458 POP BC        ; }
 $7459 INC H         ; Step to the next pixel row.
 $745A DJNZ $7445    ; Jump to #R$7445 until eight pixel rows are done.
 $745C RET           ; Return.

; Rotate Rows Right
;
; Used by the routine at #R$746E.
; .
; Rotates consecutive character rows right.
@label=HorizontalRun_RightRun
c$745D PUSH BC       ; Stash the row counter on the stack.
 $745E CALL $73F1    ; Call #R$73F1.
 $7461 LD B,$08      ; {Call #R$7445 with eight pixel rows.
 $7463 CALL $7445    ; }
 $7466 POP BC        ; Restore the row counter from the stack.
 $7467 INC B         ; Increment the row counter.
 $7468 LD A,B        ; Copy it into #REGa.
; The stop immediate is self-modified by #R$746E.
 $7469 CP $00        ; {Jump to #R$745D until it equals that stop.
 $746B JR NZ,$745D   ; }
 $746D RET           ; Return.

; Draw Shifted Run
;
; Used by the routine at #R$6E7F.
; .
; Opcode #N$EF draws a run that is shifted across the pixel columns, using
; the same five-byte operand layout.
@label=VerticalRun
c$746E LD C,(IX+$01) ; Fetch the column.
 $7471 LD B,(IX+$02) ; Fetch the row.
 $7474 LD A,(IX+$03) ; {Self-modify the loop stop at #R$7469(#N$746A).
 $7477 LD ($746A),A  ; }
 $747A LD A,(IX+$04) ; {Self-modify the rotate width at #R$7447(#N$7448).
 $747D LD ($7448),A  ; }
 $7480 CALL $745D    ; Call #R$745D.
 $7483 LD DE,$0005   ; {Step the record pointer on by five.
 $7486 ADD IX,DE     ; }
 $7488 JP $6E53      ; Jump to #R$6E53.

; Mirror Pixel Row
;
; Used by the routine at #R$74E9.
; .
; Reverses eight pixel rows of the current character row about its
; midpoint. #R$74FB patches the span and the inner pair count; #R$74E9
; and #R$751D patch the outer loop stop.
;
; B Character row
; C Column
@label=VerticalRun_Mirror
c$748B PUSH BC       ; Stash the row counter on the stack.
 $748C CALL $73F1    ; Call #R$73F1.
 $748F PUSH HL       ; Stash the start of the row on the stack.
; The width immediate is self-modified by #R$74FB.
 $7490 LD DE,$0000   ; Load that width.
 $7493 LD B,$08      ; Count the #N$08 pixel rows to reverse.
 $7495 ADD HL,DE     ; {Point #REGde at the start and #REGhl at the far end.
 $7496 DEC HL        ;
 $7497 POP DE        ; }
; Reverse this pixel row from both ends.
@label=VerticalRun_MirrorRow
*$7498 PUSH HL       ; {Stash #REGhl, #REGde and #REGbc on the stack.
 $7499 PUSH DE       ;
 $749A PUSH BC       ; }
; The inner count immediate is self-modified by #R$74FB.
 $749B LD B,$00      ; Load that count.
; Reverse one pair of bytes.
@label=VerticalRun_MirrorByte
*$749D CALL $74DD    ; {Reverse the bits of the bytes at both ends.
 $74A0 EX DE,HL      ;
 $74A1 CALL $74DD    ;
 $74A4 EX DE,HL      ; }
 $74A5 LD A,(DE)     ; {Swap those two bytes.
 $74A6 LD C,(HL)     ;
 $74A7 EX DE,HL      ;
 $74A8 LD (DE),A     ;
 $74A9 LD (HL),C     ;
 $74AA EX DE,HL      ; }
 $74AB INC DE        ; {Step inward along the row.
 $74AC DEC HL        ; }
 $74AD DJNZ $749D    ; Jump to #R$749D until the row is done.
 $74AF POP BC        ; {Restore #REGbc, #REGde and #REGhl from the stack.
 $74B0 POP DE        ;
 $74B1 POP HL        ; }
 $74B2 INC D         ; {Step down one pixel row.
 $74B3 INC H         ; }
 $74B4 DJNZ $7498    ; Jump to #R$7498 until eight pixel rows are done.
 $74B6 POP BC        ; Restore the row counter from the stack.
 $74B7 INC B         ; Increment the row counter.
; The stop immediate is self-modified by #R$74E9 and #R$751D.
 $74B8 LD A,$00      ; {Jump to #R$748B until the row counter equals that stop.
 $74BA CP B          ;
 $74BB JR NZ,$748B   ; }
 $74BD RET           ; Return.

; Mirror Attribute Row
;
; Used by the routine at #R$74E9.
; .
; Reverses an attribute row about its midpoint.
@label=VerticalRun_Copy
c$74BE PUSH BC       ; Stash the row counter on the stack.
 $74BF CALL $73AE    ; Call #R$73AE.
; The width immediate is self-modified by #R$74FB.
 $74C2 LD DE,$0000   ; Load that width.
 $74C5 PUSH HL       ; Stash the start of the row on the stack.
 $74C6 ADD HL,DE     ; Add that width.
 $74C7 DEC HL        ; Point at the last byte.
 $74C8 POP DE        ; Restore the start into #REGde.
 $74C9 LD B,$00      ; Copy #N$0100 bytes.
; Swap one reversed pair.
@label=VerticalRun_CopyByte
*$74CB LD A,(DE)     ; {Swap this pair.
 $74CC LD C,(HL)     ;
 $74CD EX DE,HL      ;
 $74CE LD (HL),C     ;
 $74CF LD (DE),A     ;
 $74D0 EX DE,HL      ; }
 $74D1 INC DE        ; {Step both pointers.
 $74D2 DEC HL        ; }
 $74D3 DJNZ $74CB    ; Jump to #R$74CB until the row is done.
 $74D5 POP BC        ; Restore the row counter from the stack.
 $74D6 INC B         ; Increment the row counter.
; The stop immediate is self-modified by #R$74E9 and #R$751D.
 $74D7 LD A,$00      ; {Jump to #R$74BE until the row counter equals that stop.
 $74D9 CP B          ;
 $74DA JR NZ,$74BE   ; }
 $74DC RET           ; Return.

; Reverse Byte Bits
;
; Used by the routine at #R$748B.
; .
; Reverses the bits of one byte.
@label=VerticalRun_Reverse
c$74DD EX DE,HL      ; Point #REGhl at this end.
 $74DE LD C,$80      ; Bit 7 of #REGc is set.
; Rotate its bits into #REGc.
@label=VerticalRun_ReverseBit
*$74E0 RL (HL)       ; {Jump to #R$74E0 until the byte is reversed.
 $74E2 RR C          ;
 $74E4 JR NC,$74E0   ; }
 $74E6 LD (HL),C     ; Write the reversed byte back.
 $74E7 EX DE,HL      ; Swap the pointers.
 $74E8 RET           ; Return.

; Patch Vertical Shift
;
; Used by the routine at #R$7512.
; .
; Writes the next picture byte over the vertical-shift immediates and
; draws both layers.
@label=VerticalRun_Patch
c$74E9 LD A,(IX+$03) ; {Self-modify the loop stops at #R$74B8(#N$74B9) and
 $74EC LD ($74B9),A  ; #R$74D7(#N$74D8).
 $74EF LD ($74D8),A  ; }
 $74F2 LD A,(IX+$04) ; Fetch the shift.
 $74F5 LD B,(IX+$01) ; Fetch the Y coordinate.
 $74F8 LD C,(IX+$02) ; Fetch the X coordinate.
; This entry point is used by the routine at #R$751D.
; .
; Patch the offset immediates and draw both layers.
@label=VerticalRun_Draw
*$74FB LD ($7491),A  ; {Self-modify the reverse widths at #R$7490(#N$7491) and
 $74FE LD ($74C3),A  ; #R$74C2(#N$74C3).}
 $7501 AND A         ; {Halve the shift.
 $7502 RRA           ; }
 $7503 LD ($749C),A  ; {Self-modify the inner counts at #R$749B(#N$749C) and
 $7506 LD ($74CA),A  ; #R$74C9(#N$74CA).}
; Reverse the pixels.
 $7509 PUSH BC       ; Stash the coordinates on the stack.
 $750A CALL $748B    ; Call #R$748B.
 $750D POP BC        ; Restore the coordinates from the stack.
; Reverse the attributes.
 $750E CALL $74BE    ; Call #R$74BE.
 $7511 RET           ; Return.

; Draw Vertical Shift
;
; Used by the routine at #R$6E7F.
; .
; Opcode #N$EE patches the vertical shift and steps the picture pointer on
; by five.
@label=DrawVertical
c$7512 CALL $74E9    ; Call #R$74E9.
 $7515 LD DE,$0005   ; {Step the record pointer on by five.
 $7518 ADD IX,DE     ; }
 $751A JP $6E53      ; Jump to #R$6E53.

; Draw Fixed Vertical Stroke
;
; Used by the routine at #R$6E53.
; .
; Used for picture record #N$FA. The shift is forced to #N$0C.
@label=FixedVertical
c$751D LD A,$0C      ; {Self-modify the loop stops at #R$74B8(#N$74B9) and
 $751F LD ($74B9),A  ; #R$74D7(#N$74D8) to #N$0C.
 $7522 LD ($74D8),A  ; }
 $7525 LD A,$20      ; Reverse all #N$20 character columns of the illustration.
 $7527 LD BC,$0000   ; Start at column #N($00), row #N$00.
 $752A CALL $74FB    ; Call #R$74FB.
 $752D INC IX        ; Advance the record pointer.
 $752F JP $6E53      ; Jump to #R$6E53.

; Look Up Screen Row
;
; Used by the routines at #R$6F57 and #R$73F1.
; .
; The picture engine's copy of the row lookup.
;
;   A Character row
; O:DE Pixel address of that row
@label=RowWord
c$7532 LD L,A        ; {Copy the row into #REGhl.
 $7533 LD H,$00      ; }
 $7535 ADD HL,HL     ; {Point at that word in #R$5BD0.
 $7536 LD DE,$5BD0   ;
 $7539 ADD HL,DE     ; }
 $753A LD E,(HL)     ; {Fetch the screen address.
 $753B INC HL        ;
 $753C LD D,(HL)     ; }
 $753D RET           ; Return.

; Paint Attribute Run
;
; Used by the routine at #R$6E53.
; .
; Writes a run of attribute bytes into the illustration buffer and returns
; to the record loop.
;
; .
;
; Read the column, row, attribute and run length.
@label=PaintAttributeRun
c$753E INC IX        ; Advance the record pointer.
 $7540 LD L,(IX+$01) ; {Copy the row into #REGhl.
 $7543 LD H,$00      ; }
 $7545 ADD HL,HL     ; {Multiply by #N($20).
 $7546 ADD HL,HL     ;
 $7547 ADD HL,HL     ;
 $7548 ADD HL,HL     ;
 $7549 ADD HL,HL     ; }
 $754A LD D,$00      ; {Fetch the column.
 $754C LD E,(IX+$00) ; }
 $754F INC IX        ; {Step past the column and row.
 $7551 INC IX        ; }
 $7553 ADD HL,DE     ; Add the column.
 $7554 LD DE,$6C7A   ; Point #REGde at #R$6C7A.
 $7557 ADD HL,DE     ; Add that buffer.
 $7558 LD A,(IX+$00) ; Fetch the attribute byte.
 $755B INC IX        ; Advance the record pointer.
 $755D LD B,(IX+$00) ; Fetch the run length.
 $7560 INC IX        ; Advance the record pointer.
; Write the run.
@label=PaintAttributeRun_Byte
*$7562 LD (HL),A     ; Write this attribute.
 $7563 INC HL        ; Advance the destination.
 $7564 DJNZ $7562    ; Jump to #R$7562 until the run is done.
 $7566 JP $6E53      ; Jump to #R$6E53.

