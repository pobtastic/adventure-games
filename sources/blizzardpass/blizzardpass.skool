; Clear Illustration
;
; Used by the routine at #R$6B4C.
; .
; Blanks the illustration from pixel row #N$AF down to #N($50), lets the
; picture bytecode paint the saved attributes, then copies that buffer onto
; the screen.
@label=ClearIllustration
c$6DFA LD BC,$AF00   ;
*$6DFD PUSH BC       ;
 $6DFE CALL $22AA    ;
 $6E01 PUSH HL       ;
 $6E02 POP DE        ;
 $6E03 INC DE        ;
 $6E04 LD BC,$001F   ;
 $6E07 LD (HL),$00   ;
 $6E09 LDIR          ;
 $6E0B POP BC        ;
 $6E0C DEC B         ;
 $6E0D LD A,$4F      ;
 $6E0F CP B          ;
 $6E10 JR NZ,$6DFD   ;
 $6E12 LD HL,$5800   ;
 $6E15 LD DE,$5801   ;
 $6E18 LD BC,$017F   ;
 $6E1B LD (HL),$00   ;
