; Command Buffer
;
; Characters typed at the prompt, in capitals, ending with ENTER. The
; parser refuses a line longer than #N$5E characters.
@label=CommandBuffer
b$5B00 DEFB $00,$FF,$00,$00,$00,$00,$00,$00
 $5B08 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B10 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B18 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B20 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B28 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B30 DEFB $00,$00,$00,$00,$00,$00,$FF,$FF
 $5B38 DEFB $FF,$00,$00,$00,$00,$00,$00,$00
 $5B40 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B48 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B50 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B58 DEFB $00,$00,$00,$00,$00,$00
 $5B5E DEFB $00,$00

; Word Being Printed
;
; The printer collects one word here and flushes it when it hits a space,
; ENTER, or a message terminator.
@label=WordBuffer
b$5B60 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B68 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B70 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B78 DEFB $00

; Script Matched
;
; Set when a bytecode line's verb and noun matched. The next line is
; skipped until this is cleared.
@label=ScriptMatched
g$5B79 DEFB $00

; Search Hit
;
; Set when a movement or an object list finds what it is looking for.
@label=SearchHit
g$5B7A DEFB $00

; Word Under Test
;
; Four characters of the word currently being matched, padded with spaces.
@label=WordToken
b$5B7B DEFB $00,$00,$00,$00

; Verb
;
; Token of the first word. Directions are #N$01 to #N($0A), inventory is
; #N($0B), GET is #N($0C), DROP is #N($0D), WEAR is #N$0E and QUIT is #N$10.
@label=Verb
g$5B7F DEFB $00

; Noun
;
; Token of the second word. IT and THEM reuse the previous noun.
@label=Noun
g$5B80 DEFB $00

; Counter #N$01
;
; Bytecode counter compared by #R$6759.
@label=Counter1
g$5B81 DEFB $00

; Counter #N$02
;
; Bytecode counter compared by #R$6760.
@label=Counter2
g$5B82 DEFB $00

; Counter #N$03
;
; Bytecode counter compared by #R$6767.
@label=Counter3
g$5B83 DEFB $00

; Exit Key
;
; The current room plus #N($80), which is how that room is keyed in the
; exit table.
@label=ExitKey
g$5B84 DEFB $00

; Continuation
;
; Non-zero when a comma left more of the command line for the next turn.
@label=Continuation
g$5B85 DEFB $00

; Word Slot
;
; How many words of this command have been stored. The script runner
; clears it after the first matched line.
@label=WordSlot
g$5B86 DEFB $00

; Print Address
;
; Spectrum display address where the next glyph is plotted.
@label=PrintAddress
g$5B87 DEFB $00,$00

; Print Row
;
; Character row of the cursor. It is saved and restored as a pair with the
; column.
@label=PrintRow
g$5B89 DEFB $00

; Print Column
;
; Character column of the cursor. The text window is #N$2B columns wide.
@label=PrintColumn
g$5B8A DEFB $00

; Words Recognised
;
; How many vocabulary words the parser kept from the current line.
@label=WordCount
g$5B8B DEFB $00

; Rest Of The Line
;
; Where to resume after a comma, and the pointer the vocabulary scan
; restores.
@label=InputPointer
g$5B8C DEFB $00,$00

; Input Length
;
; Characters currently in the command buffer. DELETE is ignored when this
; is zero.
@label=InputLength
g$5B8E DEFB $00

; Message Number
;
; Which terminated message to print, counted from the start of the chosen
; table.
@label=MessageNumber
g$5B8F DEFB $00

; Message Pointer
;
; Address of the message byte just printed.
@label=MessagePointer
g$5B90 DEFB $00,$00

; Scratch
;
; Two unused bytes between the message pointer and the subtraction
; scratch.
@label=Scratch92
g$5B92 DEFB $00,$00

; Subtraction Scratch
;
; Amount subtracted from a flag by #R$69FE.
@label=SubtractScratch
g$5B94 DEFB $00

; Room Changed
;
; Set when a script or a movement changes the room, so the loop describes
; it again.
@label=RoomChanged
g$5B95 DEFB $00

; Which Script Table
;
; #N$FF while the high-priority scripts run, and zero for the ordinary
; command scripts.
@label=ScriptSet
g$5B96 DEFB $00

; Bottom Row
;
; Last character row the text window may use before it scrolls.
@label=BottomRow
g$5B97 DEFB $00

; Word Length
;
; Characters collected for the word that is about to be flushed.
@label=WordLength
g$5B98 DEFB $00

; Word Pointer
;
; Next free byte in the word buffer.
@label=WordPointer
g$5B99 DEFB $00,$00

; Last Character
;
; The character just expanded. A full stop here makes the next letter a
; capital.
@label=LastCharacter
g$5B9B DEFB $00

; Previous Glyph
;
; The glyph just plotted, so a second space in a row can be rubbed out.
@label=PreviousGlyph
g$5B9C DEFB $00

; Previous Noun
;
; The noun IT and THEM refer to.
@label=PreviousNoun
g$5B9D DEFB $00

; Parameter Count
;
; Remaining times #R$5B9F is returned from the copied parameter block.
@label=Parameter_Count
g$5B9E DEFB $00

; Parameter Byte
;
; Byte returned while #R$5B9E is non-zero.
@label=Parameter_Byte
g$5B9F DEFB $00

; Parameter Bytes
;
; Further bytes of the parameter block copied onto #R$5B9E by
; #R$71FF.
@label=Parameter_Bytes
b$5BA0 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5BA8 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5BB0 DEFB $00,$00

; Tile Workspace
;
; Eight shifted tile bytes used while a shape is scaled.
@label=Tile_Workspace
b$5BB2 DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Picture Destination
;
; Next byte in the illustration buffer being painted.
@label=Picture_Destination
g$5BBA DEFB $00,$00

; Shape Pointer
;
; Next byte of the shape currently being drawn.
@label=Shape_Pointer
g$5BBC DEFB $00,$00

; Shift Flags
;
; How the current tile is shifted and merged. Bit 0 selects the second
; tile page. Bits 2-3 are the combine mode:
; #HTML(#N$04 <code>OR</code>, #N$08 <code>AND</code>, #N$0C <code>XOR</code>.)
; Bits 4-5 choose the shift: #N$10 left, #N$20 right, #N$30 logical right.
; Bit 6 adds an extra left rotate. Bit 1 is set when a run count follows.
@label=Shift_Flags
g$5BBE DEFB $00

; Shift Flag
;
; Copy of #R$5BBE. Bit 0 chooses the tile page.
@label=Shift_Flag
g$5BBF DEFB $00

; Run Count
;
; Remaining repeats of the current tile or attribute byte.
@label=Run_Count
g$5BC0 DEFB $00

; Picture X
;
; Character column of the shape being drawn.
@label=Picture_X
g$5BC1 DEFB $00

; Picture Y
;
; Character row of the shape being drawn.
@label=Picture_Y
g$5BC2 DEFB $00

; Drawing Y
;
; Working copy of #R$5BC2, stepped after each character row.
@label=Drawing_Y
g$5BC3 DEFB $00

; Row Width
;
; Width of the shape in character columns.
@label=Row_Width
g$5BC4 DEFB $00

; Row Height
;
; Height of the shape in character rows.
@label=Row_Height
g$5BC5 DEFB $00

; Column Counter
;
; Columns left in the current row.
@label=Column_Counter
g$5BC6 DEFB $00

; Rows Remaining
;
; Rows left in the current shape.
@label=Rows_Remaining
g$5BC7 DEFB $00

; Combine Mode
;
; #HTML(How tile bytes are merged: #N$04 <code>OR</code>, #N$08
; <code>AND</code>, #N$0C <code>XOR</code>.)
@label=Combine_Mode
g$5BC8 DEFB $00

; Destination Base
;
; Start of the attribute destination for this shape.
@label=Destination_Base
g$5BC9 DEFB $00,$00

; Last Painted Byte
;
; Attribute byte to repeat when a run continues.
@label=Last_Painted_Byte
g$5BCB DEFB $00

; Saved Shape Pointer
;
; Shape stream position remembered while a parameter block is copied.
@label=Saved_Shape_Pointer
g$5BCC DEFB $00,$00

; Unused
u$5BCE DEFB $00

; Last Matched Verb
;
; Verb that last matched an exit. #R$5FF1 clears it.
@label=Last_Matched_Verb
g$5BCF DEFB $00

; Screen Row Addresses
;
; Pixel address of each character row in the text window. Row 0 is the top
; of the display.
;
; .
;
; The rows are #FOR$5BD0,$5BFE,$02||x|#N((x-$5BD0)/$02) at
; #N(#PEEK(x)+$100*#PEEK(x+$01))|, | and ||.
@label=ScreenRows
