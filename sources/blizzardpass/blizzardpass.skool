 $6E65 JP Z,$6F44    ;
 $6E68 INC A         ;
 $6E69 JP Z,$751D    ;
 $6E6C INC A         ;
 $6E6D JR NZ,$6E7F   ;
 $6E6F INC IX        ;
 $6E71 LD A,(IX+$00) ;
 $6E74 PUSH IX       ;
 $6E76 CALL $6E43    ;
 $6E79 POP IX        ;
 $6E7B INC IX        ;
 $6E7D JR $6E53      ;

