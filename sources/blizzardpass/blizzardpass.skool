; BASIC Residue
;
; Leftover 128 BASIC machine stack and a truncated copy of the default
; UDGs. The glyph plotter uses the ROM font, not this copy. Bank 7 keeps the
; intact stack at #R$FF18@bank7 and the UDGs at #R$FF58@bank7.
@label=BasicResidue
b$FF18 DEFB $F3,$0D,$CE,$0B,$E4,$50,$CE,$0B
 $FF20 DEFB $E5,$50,$1C,$17,$DC,$0A,$CE,$0B
 $FF28 DEFB $EB,$50,$16,$17,$DC,$0A,$D7,$18
 $FF30 DEFB $B1,$33,$DB,$02,$7C,$38,$D4,$03
 $FF38 DEFB $4D,$00,$40,$4F,$C0,$00,$3F,$4F
 $FF40 DEFB $8C,$10,$5C,$0E,$00,$47,$C0,$57
 $FF48 DEFB $71,$0E,$F3,$0D,$21,$17,$C6,$1E
 $FF50 DEFB $CA,$5E,$76,$1B,$03,$13,$00,$3E
 $FF58 DEFB $00,$3C,$42,$42,$7E,$42,$42,$00
 $FF60 DEFB $00,$7C,$42,$7C,$42,$42,$7C,$00
 $FF68 DEFB $00,$3C,$42,$40,$40,$42,$3C,$00
 $FF70 DEFB $00,$78,$44,$42,$42,$44,$78,$00
 $FF78 DEFB $00,$7E,$40,$7C,$40,$40,$7E,$00
 $FF80 DEFB $00,$7E,$40,$7C,$40,$40,$40,$00
 $FF88 DEFB $00,$3C,$42,$40,$4E,$42,$3C,$00
 $FF90 DEFB $00,$42,$42,$7E,$42,$42,$42,$00
 $FF98 DEFB $00,$3E,$08,$08,$08,$08,$3E,$00
 $FFA0 DEFB $00,$02,$02,$02,$42,$42,$3C,$00
 $FFA8 DEFB $00,$44,$48,$70,$48,$44,$42,$00
 $FFB0 DEFB $00,$40,$40,$40,$40,$40,$7E,$00
 $FFB8 DEFB $00,$42,$66,$5A,$42,$42,$DB,$02
 $FFC0 DEFB $F3,$0D,$CE,$0B,$E4,$50,$CE,$0B
 $FFC8 DEFB $E5,$50,$1C,$17,$DC,$0A,$CE,$0B
 $FFD0 DEFB $EB,$50,$16,$17,$DC,$0A,$D7,$18
 $FFD8 DEFB $B1,$33,$18,$5D

; Start Game
;
; The last loader block. It loads #N$0100 bytes over the command buffer
; and falls into the game. The snapshot is paused on the call into #R$5ECB.
;
; .
;
; The #N$0100 bytes are a headerless block, flagged by the carry.
@label=StartGame
c$FFDC LD IX,$5B00   ; Point #REGix at #R$5B00.
 $FFE0 LD DE,$0100   ; #N$0100 bytes.
 $FFE3 LD A,$00      ; {A headerless block.
 $FFE5 SCF           ; }
 $FFE6 CALL $0556    ; Call #SKOOLKID$0556(LD_BYTES).
; Enter the game.
@label=GameEntry
 $FFE9 CALL $5ECB    ; Call #R$5ECB.

; Bytes After Entry
;
; Not executed. The call into the game loop does not return here.
@label=AfterEntry
b$FFEC DEFB $4D,$00,$FF,$FF,$0E,$01,$00,$00
 $FFF4 DEFB $51,$00,$92,$09,$3F,$05,$76,$1B
 $FFFC DEFB $03,$13,$00,$3E
