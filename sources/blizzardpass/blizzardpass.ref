; Copyright 2026 Paul Maddern (paul@arcadegeek.co.uk)

;
; SkoolKit ref file for Blizzard Pass
;
; To build the HTML disassembly, run these commands:
;   tap2sna.py @blizzardpass.t2s
;   sna2skool.py -H -c sources/blizzardpass.ctl BlizzardPass.z80 > sources/blizzardpass.skool
;   skool2html.py -H sources/blizzardpass.skool -T dark -T wide -toOa

[Config]
Expand=#INCLUDE(Expand)
RefFiles=../analytics.ref;../bases.ref;changelog.ref;facts.ref;locations.ref;pokes.ref
HtmlWriterClass=sources:linking.AdventureGamesHtmlWriter
GameDir=adventure-games/blizzardpass

[skool2ctl]
ListRefs=2

[Game]
Game=Blizzard Pass
Logo=#SCR$02,$08,$00,$0F,$06,$4000,$5800{$00,$00,$F8,$4A}(/images/logo)
Copyright=&copy; 1986 Adventuresoft UK Ltd<br />&copy; 2026 ArcadeGeek LTD.
Repository=https://github.com/pobtastic/adventure-games/tree/main/sources/blizzardpass/
Canonical=https://skoolkit.arcadegeek.co.uk/adventure-games/blizzardpass/
GameIndexUrl=https://skoolkit.arcadegeek.co.uk/adventure-games/blizzardpass/
OgImage=https://skoolkit.arcadegeek.co.uk/adventure-games/blizzardpass/images/logo.png
LinkInternalOperands=1
AddressAnchor={address#IF({base}==16)(:04x)}

[Titles]
bank3-Index=Bank 3 (Parser)
bank6-Index=Bank 6 (Location Text)
bank7-Index=Bank 7 (BASIC Residue)

[OtherCode:bank3]
[OtherCode:bank6]
[OtherCode:bank7]

[Paths]
Locations=graphics/locations.html

[Page:Locations]
SectionPrefix=Location

[PageHeaders]
GameIndex=The complete<>RAM disassembly (work in progress)

[Index:Graphics:Graphics]
Locations

[Expand]

#DEF(#INK(id)
  #LET(bright=$id&$40)
  #LET(flash=$id&$80)
  #LET(ink=$id&$07)#IF({ink}>=$00)(
    #MAP({ink})(
      UNKNOWN,
      0:BLACK,
      1:BLUE,
      2:RED,
      3:MAGENTA,
      4:GREEN,
      5:CYAN,
      6:YELLOW,
      7:WHITE))#IF({bright}>$00)( (BRIGHT))#IF({flash}>$00)( (FLASH: ON)))
