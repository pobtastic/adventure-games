@org=$C000
@expand=#DEF1(#SKOOLKID(addr,anchor=0)(name)#HTML(<a rel="noopener nofollow" href="https://skoolkit.ca/disassemblies/rom/#IF({{mode[base]}}==16)(hex/)asm/#IF({{mode[base]}}==16)(#EVAL({addr},16,4),#EVAL({addr})).html#IF({anchor})(#CHR(35)#IF({{mode[base]}}==16)(#EVAL({anchor},16,4),#EVAL({anchor})))">){name}#HTML(</a>))
@remote=main:$66BD
@remote=main:$66D7
@remote=main:$FFDC

; Unused Bank 7
;
; Not the picture bytecode, and not the bank paged at #N$C000 in the
; resting snapshot or during play. That window is bank 0: port #N$7FFD holds
; #N($10), and the game's saved page value at #R$66D7@main(PagedBank) is #N$10.
; The page routine at #R$66BD@main(PageBank) ORs #N$10 and writes the port, and
; it is only ever asked for banks 0, 3 and 6. The BASIC loader does OUT 32765,23
; so that LOAD runs with this bank visible, but the copier then writes the
; adventure into banks 6, 3 and 0 and pages bank 0 back. Nothing is copied here,
; so the body is zero.
@label=UnusedBank7
s$C000 DEFS $3F18

; Machine Stack
;
; Leftover 128 BASIC machine stack and GO SUB stack, from the stack
; pointer up to #SKOOLKID$5CB2(RAMTOP). Frozen when the loader paged this bank
; out. The words are ROM return addresses and screen pointers, not game data.
@label=MachineStack
b$FF18 DEFB $F3,$0D
 $FF1A DEFB $CE,$0B
 $FF1C DEFB $E3,$50
 $FF1E DEFB $CE,$0B
 $FF20 DEFB $E4,$50
 $FF22 DEFB $1D,$17
 $FF24 DEFB $DC,$0A
 $FF26 DEFB $CE,$0B
 $FF28 DEFB $E7,$50
 $FF2A DEFB $1A,$17
 $FF2C DEFB $DC,$0A
 $FF2E DEFB $D7,$18
 $FF30 DEFB $38,$00
 $FF32 DEFB $DB,$02
 $FF34 DEFB $7C,$38
 $FF36 DEFB $F1,$5D
 $FF38 DEFB $4D,$00
 $FF3A DEFB $7A,$55
 $FF3C DEFB $86,$00
 $FF3E DEFB $79,$55
 $FF40 DEFB $8C,$08
 $FF42 DEFB $5C,$0E
 $FF44 DEFB $00,$47
 $FF46 DEFB $C0,$57
 $FF48 DEFB $71,$0E
 $FF4A DEFB $F3,$0D
 $FF4C DEFB $21,$17
 $FF4E DEFB $C6,$1E
 $FF50 DEFB $CA,$5E
 $FF52 DEFB $76,$1B
 $FF54 DEFB $03,$13
 $FF56 DEFB $00,$3E

; User-Defined Graphics
;
; The default UDGs copied from the ROM (letters A-U), pointed to by
; #SKOOLKID$5C7B(UDG). The glyph plotter uses the ROM font, not this copy. Bank
; 0 holds a truncated fragment at the same addresses, overwritten by
; #R$FFDC@main(StartGame).
;
; .
;
; UDG A (CHR$ #N$90).
@label=UDG
b$FF58 DEFB $00,$3C,$42,$42,$7E,$42,$42,$00 ; #UDG(#PC)
; UDG B (CHR$ #N$91).
 $FF60 DEFB $00,$7C,$42,$7C,$42,$42,$7C,$00 ; #UDG(#PC)
; UDG C (CHR$ #N$92).
 $FF68 DEFB $00,$3C,$42,$40,$40,$42,$3C,$00 ; #UDG(#PC)
; UDG D (CHR$ #N$93).
 $FF70 DEFB $00,$78,$44,$42,$42,$44,$78,$00 ; #UDG(#PC)
; UDG E (CHR$ #N$94).
 $FF78 DEFB $00,$7E,$40,$7C,$40,$40,$7E,$00 ; #UDG(#PC)
; UDG F (CHR$ #N$95).
 $FF80 DEFB $00,$7E,$40,$7C,$40,$40,$40,$00 ; #UDG(#PC)
; UDG G (CHR$ #N$96).
 $FF88 DEFB $00,$3C,$42,$40,$4E,$42,$3C,$00 ; #UDG(#PC)
; UDG H (CHR$ #N$97).
 $FF90 DEFB $00,$42,$42,$7E,$42,$42,$42,$00 ; #UDG(#PC)
; UDG I (CHR$ #N$98).
 $FF98 DEFB $00,$3E,$08,$08,$08,$08,$3E,$00 ; #UDG(#PC)
; UDG J (CHR$ #N$99).
 $FFA0 DEFB $00,$02,$02,$02,$42,$42,$3C,$00 ; #UDG(#PC)
; UDG K (CHR$ #N$9A).
 $FFA8 DEFB $00,$44,$48,$70,$48,$44,$42,$00 ; #UDG(#PC)
; UDG L (CHR$ #N$9B).
 $FFB0 DEFB $00,$40,$40,$40,$40,$40,$7E,$00 ; #UDG(#PC)
; UDG M (CHR$ #N$9C).
 $FFB8 DEFB $00,$42,$66,$5A,$42,$42,$42,$00 ; #UDG(#PC)
; UDG N (CHR$ #N$9D).
 $FFC0 DEFB $00,$42,$62,$52,$4A,$46,$42,$00 ; #UDG(#PC)
; UDG O (CHR$ #N$9E).
 $FFC8 DEFB $00,$3C,$42,$42,$42,$42,$3C,$00 ; #UDG(#PC)
; UDG P (CHR$ #N$9F).
 $FFD0 DEFB $00,$7C,$42,$42,$7C,$40,$40,$00 ; #UDG(#PC)
; UDG Q (CHR$ #N$A0).
