; UDG T (CHR$ #N$A3).
 $FFF0 DEFB $00,$FE,$10,$10,$10,$10,$10,$00 ; #UDG(#PC)
; UDG U (CHR$ #N$A4).
 $FFF8 DEFB $00,$42,$42,$42,$42,$42,$3C,$00 ; #UDG(#PC)
