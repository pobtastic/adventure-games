@org=$C000
@expand=#DEF1(#MESSAGE(addr)#STR{addr},$08($b==$5E||$b==$7E))
@expand=#DEF1(#SKOOLKID(addr,anchor=0)(name)#HTML(<a rel="noopener nofollow" href="https://skoolkit.ca/disassemblies/rom/#IF({{mode[base]}}==16)(hex/)asm/#IF({{mode[base]}}==16)(#EVAL({addr},16,4),#EVAL({addr})).html#IF({anchor})(#CHR(35)#IF({{mode[base]}}==16)(#EVAL({anchor},16,4),#EVAL({anchor})))">){name}#HTML(</a>))
@remote=main:$5B00
@remote=main:$5B7B
@remote=main:$5B7F
@remote=main:$5B80
@remote=main:$5B81
@remote=main:$5B83
@remote=main:$5B85
@remote=main:$5B86
@remote=main:$5B8B
@remote=main:$5B8C
@remote=main:$5B8E
@remote=main:$5B9D
@remote=main:$6394
@remote=main:$63D4
@remote=main:$655A,$655C
@remote=main:$662D
@remote=main:$A71F
@remote=main:$A720

; Read Command
;
; Clears the parser workspace. A comma on the previous line reprints a
; space and jumps to #R$C0B2; otherwise it continues into #R$C02E.
;
; .
;
; Forget the previous noun, the scroll count and the three counters.
@label=ReadCommand
c$C000 XOR A         ; {Clear *#R$5B80@main(Noun) and #REGhl.
 $C001 LD L,A        ;
 $C002 LD H,A        ;
 $C003 LD ($5B80),A  ; }
 $C006 LD ($655C),A  ; Clear *#R$655C@main(RowsScrolled).
 $C009 LD ($5B81),HL ; {Clear *#R$5B81@main(Counter1), *#R$5B83@main(Counter3)
 $C00C LD ($5B83),A  ; and *#R$5B8B@main(WordCount).
 $C00F LD ($5B8B),A  ; }
 $C012 INC A         ; {Write #N$01 to *#R$5B86@main(WordSlot).
 $C013 LD ($5B86),A  ; }
; A comma on the previous line left more words to read.
 $C016 LD A,($5B85)  ; {Jump to #R$C02E when there is no leftover command.
 $C019 OR A          ;
 $C01A JR Z,$C02E    ; }
 $C01C LD A,$1B      ; {Call #R$63D4@main(PrintSystemMessage) to print message
 $C01E CALL $63D4    ; #N$1B (a space).}
@label=ReadCommand_Wait
*$C021 LD A,($5C04)  ; {Wait until the key is not a space.
 $C024 CP $20        ;
 $C026 JR Z,$C021    ; }
 $C028 LD HL,($5B8C) ; Fetch the leftover pointer from
                     ; *#R$5B8C@main(InputPointer).
 $C02B JP $C0B2      ; Jump to #R$C0B2.

; Print Prompt
;
; Used by the routines at #R$C000 and #R$C091.
; .
; Prints ENTER, ">" and a space, then starts a new line in
; #R$5B00@main(CommandBuffer).
@label=PrintPrompt
c$C02E LD A,$0D       ; {Call #R$6394@main(PrintCharacter) to print ENTER.
 $C030 CALL $6394     ; }
 $C033 LD A,$3E       ; {Call #R$6394@main(PrintCharacter) to print ">".
 $C035 CALL $6394     ; }
 $C038 LD A,$20       ; {Call #R$6394@main(PrintCharacter) to print a space.
 $C03A CALL $6394     ; }
 $C03D XOR A          ; {Write #N$00 to *#R$5B8E@main(InputLength).
 $C03E LD ($5B8E),A   ; }
 $C041 RES 5,(IY+$01) ; Clear the new-key bit of #SKOOLKID$5C3B(FLAGS).
 $C045 LD HL,$5B00    ; Point #REGhl at #R$5B00@main(CommandBuffer).

; Read Key
;
; Reads keys until ENTER. DELETE rubs out, and letters are stored in
; capitals.
;
;   HL Command buffer pointer
; O:HL Pointer after the last stored character
@label=ReadKey
c$C048 CALL $662D    ; Call #R$662D@main(WaitForKey) to read one key.
 $C04B CP $0C        ; {Jump to #R$C055 if the key is DELETE.
 $C04D JR Z,$C055    ; }
 $C04F CP $0D        ; {Jump to #R$C091 if the key is ENTER.
 $C051 JR Z,$C091    ; }
 $C053 JR $C06D      ; Jump to #R$C06D to store the key.
; Rub the last character out, unless the buffer is already empty.
@label=ReadKey_Delete
*$C055 PUSH AF       ; Stash the key on the stack.
 $C056 LD A,($5B8E)  ; {Jump to #R$C06A if *#R$5B8E@main(InputLength) is empty.
 $C059 OR A          ;
 $C05A JR Z,$C06A    ; }
 $C05C POP AF        ; Restore the key from the stack.
 $C05D CALL $6394    ; Call #R$6394@main(PrintCharacter) to rub the character
                     ; out.
 $C060 DEC HL        ; {Decrement the buffer pointer and
 $C061 LD A,($5B8E)  ; *#R$5B8E@main(InputLength).
 $C064 DEC A         ;
 $C065 LD ($5B8E),A  ; }
 $C068 JR $C048      ; Jump to #R$C048.
; Throw the key away and read another.
@label=ReadKey_Ignore
*$C06A POP AF        ; Drop the rejected key from the stack.
 $C06B JR $C048      ; Jump to #R$C048.
; Store a capital letter if the buffer still has room.
@label=ReadKey_Store
*$C06D PUSH AF       ; Stash the key on the stack.
 $C06E LD A,($5B8E)  ; {Jump to #R$C06A if *#R$5B8E@main(InputLength) already holds
 $C071 CP $5E        ; #N$5E characters.
 $C073 JR Z,$C06A    ; }
 $C075 POP AF        ; Restore the key from the stack.
 $C076 CP $20        ; {Jump to #R$C048 if a control or a graphic is rejected.
 $C078 JR C,$C048    ; }
 $C07A CP $61        ; {Fold a lowercase letter to capitals.
 $C07C JR C,$C080    ;
 $C07E SUB $20       ; }
@label=ReadKey_Fold
*$C080 CP $5B        ; {Jump to #R$C048 if the character is above "Z".
 $C082 JR NC,$C048   ; }
 $C084 LD (HL),A     ; {Store the capital and call #R$6394@main(PrintCharacter)
 $C085 CALL $6394    ; to echo it.}
 $C088 INC HL        ; {Advance the pointer and increment
 $C089 PUSH HL       ; *#R$5B8E@main(InputLength).
 $C08A LD HL,$5B8E   ;
 $C08D INC (HL)      ; }
 $C08E POP HL        ; Restore the buffer pointer from the stack.
 $C08F JR $C048      ; Jump to #R$C048.

; Parse Line
;
; Used by the routine at #R$C048.
; .
; Stores ENTER. An empty line reprints the prompt; otherwise the line is
; parsed from the first character.
@label=ParseLine
c$C091 LD (HL),A     ; {Store ENTER and call #R$6394@main(PrintCharacter) to
 $C092 CALL $6394    ; echo it.}
 $C095 XOR A         ; {Clear *#R$5B7F@main(Verb).
 $C096 LD ($5B7F),A  ; }
 $C099 LD HL,$5B00   ; {Point #REGhl at #R$5B00@main(CommandBuffer) and fetch the
 $C09C LD A,(HL)     ; first character.}
 $C09D CP $0D        ; {Jump to #R$C02E if the line is empty.
 $C09F JP Z,$C02E    ; }
 $C0A2 JR $C0B2      ; Jump to #R$C0B2.

; Parse Word
;
; Used by the routines at #R$C0EE, #R$C104 and #R$C14C.
; .
; Skips to the next word and copies up to four letters. A comma after a
; word saves the rest of the line.
;
; HL Line pointer
;
; Move to the next word. A comma after a word saves the rest of the
; line.
@label=ParseWord
c$C0A4 CALL $C1A6    ; Call #R$C1A6 to skip to a space, a comma or ENTER.
 $C0A7 CP $0D        ; {Jump to #R$C173 to finish the command.
 $C0A9 JR NZ,$C0AE   ;
 $C0AB JP $C173      ; }
@label=ParseWord_NotEnter
*$C0AE CP $2C        ; {Jump to #R$C0D1 to keep the rest of the line.
 $C0B0 JR Z,$C0D1    ; }
; This entry point is used by the routines at #R$C000 and #R$C091.
; .
; Copy up to four characters, padding with spaces, then look the word
; up.
@label=ParseWord_Copy
*$C0B2 LD B,$04      ; {Fill #R$5B7B@main(WordToken) with four spaces.
 $C0B4 LD DE,$5B7B   ;
@label=ParseWord_Pad
*$C0B7 LD A,$20      ;
 $C0B9 LD (DE),A     ;
 $C0BA INC DE        ;
 $C0BB DJNZ $C0B7    ; }
 $C0BD LD DE,$5B7B   ; {The copy starts at the first character of
 $C0C0 LD B,$00      ; #R$5B7B@main(WordToken).}
@label=ParseWord_Letter
*$C0C2 LD A,(HL)     ; {Jump to #R$C0DA to test for a space or ENTER.
 $C0C3 CP $2C        ;
 $C0C5 JR NZ,$C0DA   ; }
 $C0C7 XOR A         ; {Jump to #R$C0EE to look the word up.
 $C0C8 CP B          ;
 $C0C9 JR NZ,$C0EE   ; }
 $C0CB LD A,($5B8B)  ; {Jump to #R$C0A4 to keep scanning.
 $C0CE OR A          ;
 $C0CF JR Z,$C0A4    ; }
; Save the rest of the line for the next turn.
@label=ParseWord_Comma
*$C0D1 LD A,$01      ; {Write #N$01 to *#R$5B85@main(Continuation) and store the pointer in
 $C0D3 LD ($5B85),A  ; *#R$5B8C@main(InputPointer).
 $C0D6 LD ($5B8C),HL ; }
 $C0D9 RET           ; Return.
; A space or ENTER ends the word; anything else is another letter.
@label=ParseWord_Break
*$C0DA CP $20        ; {Jump to #R$C0EE when a space or ENTER ends the word.
 $C0DC JR Z,$C0EE    ;
 $C0DE CP $0D        ;
 $C0E0 JR Z,$C0EE    ; }
 $C0E2 LD A,$04      ; {Jump to #R$C0EE if a fifth character is not stored.
 $C0E4 CP B          ;
 $C0E5 JR Z,$C0EE    ; }
 $C0E7 LD A,(HL)     ; {Store one character in #R$5B7B@main(WordToken).
 $C0E8 LD (DE),A     ; }
 $C0E9 INC HL        ; {Advance both pointers and jump to #R$C0C2.
 $C0EA INC DE        ;
 $C0EB INC B         ;
 $C0EC JR $C0C2      ; }

; Look Up Word
;
; Used by the routine at #R$C0A4.
; .
; Looks the four letters up. An unknown or leading noise word is
; skipped; a noise word after a real word keeps the rest of the line.
;
;   HL Line pointer
; O:A Token id, or #N$FF if the word is unknown
; O:HL Restored line pointer
@label=LookupWord
c$C0EE CALL $C181    ; Call #R$C181 to look the four characters up.
 $C0F1 CP $FF        ; {Jump to #R$C0A4 if the word is unknown (#N$FF).
 $C0F3 JR Z,$C0A4    ; }
 $C0F5 OR A          ; {Jump to #R$C104 to keep a real word.
 $C0F6 JR NZ,$C104   ; }
 $C0F8 LD A,($5B8B)  ; {Jump to #R$C0A4 if a noise word arrives before any real
 $C0FB OR A          ; word.
 $C0FC JR Z,$C0A4    ; }
 $C0FE LD A,$01      ; {Write #N$01 to *#R$5B85@main(Continuation) to keep the rest
 $C100 LD ($5B85),A  ; of the line.}
 $C103 RET           ; Return.

; Keep Token
;
; Used by the routine at #R$C0EE.
; .
; The first word below id #N$55 is the verb. IT and THEM substitute the
; previous noun. POLISH, SKIN and BRIDGE are rewritten to internal verbs
; #N($2C), #N$2B and #N$31. Later words are the noun, then extra words.
;
; A Token id
; HL Line pointer
;
; Count this word. A third word is stored as an extra, not as the noun.
@label=KeepToken
c$C104 PUSH AF       ; Stash the id on the stack.
 $C105 LD A,($5B8B)  ; {Increment *#R$5B8B@main(WordCount).
 $C108 INC A         ;
 $C109 LD ($5B8B),A  ; }
 $C10C CP $03        ; {Jump to #R$C14C if this is a third word.
 $C10E JR NC,$C14C   ; }
 $C110 CP $20        ; {Jump to #R$C16B if *#R$5B8B@main(WordCount) is #N$20.
 $C112 JR Z,$C16B    ; }
 $C114 POP AF        ; Restore the id from the stack.
 $C115 CP $55        ; {An id below #N$55 is the verb.
 $C117 JR NC,$C11F   ; }
@label=KeepToken_Verb
*$C119 LD ($5B7F),A  ; Write the id to *#R$5B7F@main(Verb).
 $C11C JP $C0A4      ; Jump to #R$C0A4 to take the next word.
; IT and THEM reuse the previous noun; other ids become the noun
; unless they rewrite to a verb.
@label=KeepToken_It
*$C11F CP $80        ; {IT and THEM (#N$80) reuse *#R$5B9D@main(PreviousNoun).
 $C121 JR NZ,$C126   ;
 $C123 LD A,($5B9D)  ; }
@label=KeepToken_Held
*$C126 LD B,A        ; {Jump to #R$C143 if a verb is already stored.
 $C127 LD A,($5B7F)  ;
 $C12A OR A          ;
 $C12B LD A,B        ;
 $C12C JR NZ,$C143   ; }
@label=KeepToken_Rewrite
 $C12E CP $AF        ; {Jump to #R$C119 with #N$2C if the token is POLISH
 $C130 LD A,$2C      ; (#N$AF).
 $C132 JR Z,$C119    ; }
 $C134 LD A,B        ; {Jump to #R$C119 with #N$2B if the token is SKIN
 $C135 CP $F9        ; (#N$F9).
 $C137 LD A,$2B      ;
 $C139 JR Z,$C119    ; }
 $C13B LD A,B        ; {Jump to #R$C119 with #N$31 if the token is BRIDGE
 $C13C CP $86        ; (#N$86).
 $C13E LD A,$31      ;
 $C140 JR Z,$C119    ; }
 $C142 LD A,B        ; Restore the id when none of those matched.
@label=KeepToken_Noun
*$C143 LD ($5B80),A  ; {Write the id to *#R$5B80@main(Noun) and
 $C146 LD ($5B9D),A  ; *#R$5B9D@main(PreviousNoun).}
 $C149 JP $C0A4      ; Jump to #R$C0A4 to take the next word.

; Store Extra
;
; Used by the routine at #R$C104.
; .
; A third word, and a word count of #N$20, go in the spare slots after
; the noun. A fifth word is ignored.
@label=StoreExtra
c$C14C LD A,($5B86)  ; {Increment *#R$5B86@main(WordSlot).
 $C14F INC A         ;
 $C150 LD ($5B86),A  ;
 $C153 LD C,A        ; }
 $C154 CP $05        ; {Jump to #R$C15C if there is still a spare slot.
 $C156 JR C,$C15C    ; }
 $C158 POP AF        ; Drop the id from the stack.
 $C159 JP $C0A4      ; Jump to #R$C0A4.
; Write the extra word into the next spare slot after the verb.
@label=StoreExtra_Slot
*$C15C LD B,$00      ; {The slot is an offset from *#R$5B7F@main(Verb).
 $C15E LD IX,$5B7F   ;
 $C162 ADD IX,BC     ; }
 $C164 POP AF        ; {Write the id into that slot.
 $C165 LD (IX+$00),A ; }
 $C168 JP $C0A4      ; Jump to #R$C0A4 to take the next word.
; This entry point is used by the routine at #R$C104.
@label=StoreExtra_Overflow
*$C16B PUSH AF       ; Stash the id on the stack.
 $C16C LD A,($5B8B)  ; {Use one less than *#R$5B8B@main(WordCount) as the slot
 $C16F DEC A         ; and jump to #R$C15C.
 $C170 LD C,A        ;
 $C171 JR $C15C      ; }

; Finish Parse
;
; Used by the routine at #R$C0A4.
; .
; An empty command clears the verb. The continuation flag is always
; cleared.
@label=FinishParse
c$C173 LD A,($5B8B)  ; {Clear *#R$5B7F@main(Verb) if no word was recognised.
 $C176 OR A          ;
 $C177 JR NZ,$C17C   ;
 $C179 LD ($5B7F),A  ; }
@label=FinishParse_Clear
*$C17C XOR A         ; {Clear *#R$5B85@main(Continuation).
 $C17D LD ($5B85),A  ; }
 $C180 RET           ; Return.

; Match Word
;
; Used by the routine at #R$C0EE.
; .
; Compares the four characters with every vocabulary entry.
;
;   HL Line pointer
; O:A Token id, or #N$FF if the word is unknown
; O:HL Restored line pointer
@label=MatchWord
c$C181 LD ($5B8C),HL ; Remember the line pointer in
                     ; *#R$5B8C@main(InputPointer).
 $C184 LD HL,$A71F   ; The vocabulary starts at #R$A720@main(Vocabulary), one byte
                     ; after #R$A71F@main(VocabularyLead).
@label=MatchWord_Next
*$C187 INC HL        ; {Compare the next entry with #R$5B7B@main(WordToken).
 $C188 LD DE,$5B7B   ;
 $C18B LD BC,$0400   ; }
@label=MatchWord_Character
*$C18E LD A,(DE)     ; {Compare four letters and count the matches.
 $C18F CP (HL)       ;
 $C190 JR NZ,$C193   ;
 $C192 INC C         ;
@label=MatchWord_Miss
*$C193 INC HL        ;
 $C194 INC DE        ;
 $C195 DJNZ $C18E    ; }
 $C197 LD A,(HL)     ; {Jump to #R$C1A2 if the table has ended (#N$FF).
 $C198 CP $FF        ;
 $C19A JR Z,$C1A2    ; }
 $C19C LD A,$04      ; {Jump back to #R$C187 unless all four letters matched.
 $C19E CP C          ;
 $C19F JR NZ,$C187   ; }
 $C1A1 LD A,(HL)     ; The token byte is the id.
@label=MatchWord_Done
*$C1A2 LD HL,($5B8C) ; Restore the line pointer from
                     ; *#R$5B8C@main(InputPointer).
 $C1A5 RET           ; Return.

; Skip To Break
;
; Used by the routine at #R$C0A4.
; .
; Advances #REGhl to the next space, comma or ENTER.
;
;   HL Line pointer
; O:A The break character
; O:HL Stepped past that character
@label=SkipToBreak
c$C1A6 LD A,(HL)     ; {A space ends the skip.
 $C1A7 INC HL        ;
 $C1A8 CP $20        ;
 $C1AA RET Z         ; }
 $C1AB CP $2C        ; {A comma ends the skip.
 $C1AD RET Z         ; }
 $C1AE CP $0D        ; {Jump back to #R$C1A6 unless the character is ENTER.
 $C1B0 JR NZ,$C1A6   ; }
 $C1B2 RET           ; Return.

; Location Text Under Parser
;
; The rest of this bank is the same location text as bank 6. The parser
; occupies the first #N$01B3 bytes, so this fragment begins in the middle of
; a description. Each description terminates with #N$7E.
@label=LocationTextUnderParser
t$C1B3 DEFM "ed in cloud. At one point however the cliff is nowhere near as st" ; {"#MESSAGE(#PC)".
 $C1F4 DEFM "eep and a fair way up a single window is cut into the cliff, look" ;
 $C235 DEFM "ing out across the snows"                                          ; }
 $C24D DEFB $7E                                                                 ; Terminator.
 $C24E DEFM "you are lost in a blizzard, almost blinded by the driving snows. " ; {"#MESSAGE(#PC)".
 $C28F DEFM "The howling icy wind sends huge clouds of snow whistling across t" ;
 $C2D0 DEFM "he plain totally obscuring your view"                              ; }
 $C2F4 DEFB $7E                                                                 ; Terminator.
 $C2F5 DEFM "you are hanging onto a fairly precipitous cliff, beside a rocky w" ; {"#MESSAGE(#PC)".
 $C336 DEFM "indow. Far below you can see the pass which seems to sway backwar" ;
 $C377 DEFM "ds and forwards as the icy wind tries to tear you away from the c" ;
 $C3B8 DEFM "liff and lashes you with huge clouds of blinding snow. "           ; }
 $C3EF DEFB $7E                                                                 ; Terminator.
 $C3F0 DEFM "you are in a small stonewalled chamber. Light streams in through " ; {"#MESSAGE(#PC)".
 $C431 DEFM "a somewhat vandalised window, to the north is another darker cham" ;
 $C472 DEFM "ber only partially lit from the window, while to the south throug" ;
 $C4B3 DEFM "h a doorway cloaked in deep shadow you can see a dark passage"     ; }
 $C4F0 DEFB $7E                                                                 ; Terminator.
 $C4F1 DEFM "you are in a dark gloomy room, light from the window to the south" ; {"#MESSAGE(#PC)".
 $C532 DEFM " dimly illuminates one wall. To the south is another much brighte" ;
 $C573 DEFM "r chamber"                                                         ; }
 $C57C DEFB $7E                                                                 ; Terminator.
 $C57D DEFM "empty"                                                             ; "#MESSAGE(#PC)".
 $C582 DEFB $7E                                                                 ; Terminator.
 $C583 DEFM "you are following a dark passage which leads north into a brighty" ; {"#MESSAGE(#PC)".
 $C5C4 DEFM " lit room and south towards a T junction. The thick dust on the f" ;
 $C605 DEFM "loor shows that you are the only person to have come this way for" ;
 $C646 DEFM " a long time"                                                      ; }
 $C652 DEFB $7E                                                                 ; Terminator.
 $C653 DEFM "you are walking along a long and fairly wide stonewalled passage " ; {"#MESSAGE(#PC)".
 $C694 DEFM "leading east and west through the mountain. To the north through " ;
 $C6D5 DEFM "a doorway the feeble light of the rock reveals a small room"       ; }
 $C710 DEFB $7E                                                                 ; Terminator.
 $C711 DEFM "empty"                                                             ; "#MESSAGE(#PC)".
 $C716 DEFB $7E                                                                 ; Terminator.
 $C717 DEFM "you are in a low secret passage that leads southwards to some kin" ; {"#MESSAGE(#PC)".
 $C758 DEFM "d of dark pillared room. The north wall has niches cut into it to" ;
 $C799 DEFM " allow you to climb through the hole in the roof which leads up p" ;
 $C7DA DEFM "ast the statue"                                                    ; }
 $C7E8 DEFB $7E                                                                 ; Terminator.
 $C7E9 DEFM "you are in a dark rather gloomy temple. Huge pillars hold up the " ; {"#MESSAGE(#PC)".
 $C82A DEFM "roof of this vast chamber and cast strange shadows that seem to d" ;
 $C86B DEFM "ance around you as you move around. The centre of the temple is a" ;
 $C8AC DEFM " flat platform with a now broken altar as it's centrepiece"        ; }
 $C8E6 DEFB $7E                                                                 ; Terminator.
 $C8E7 DEFM "you are in a large dark room, passages lead east and west. A set " ; {"#MESSAGE(#PC)".
 $C928 DEFM "of crumbling stone steps leads steeply downwards plunging into th" ;
 $C969 DEFM "e shadows"                                                         ; }
 $C972 DEFB $7E                                                                 ; Terminator.
 $C973 DEFM "you are in a short section of east west corridor. To the west the" ; {"#MESSAGE(#PC)".
 $C9B4 DEFM " corridor leads to a huge hall, while to the north through a door" ;
 $C9F5 DEFM "way is a small dimly lit room"                                     ; }
 $CA12 DEFB $7E                                                                 ; Terminator.
 $CA13 DEFM "you are in a small rather dirty room which appears to have been a" ; {"#MESSAGE(#PC)".
 $CA54 DEFM " store room of some kind. Through a doorway to the south is a cor" ;
 $CA95 DEFM "ridor"                                                             ; }
 $CA9A DEFB $7E                                                                 ; Terminator.
 $CA9B DEFM "you are in a huge pillared hall deep within the mountain. Huge or" ; {"#MESSAGE(#PC)".
 $CADC DEFM "nately carved pillars support the millions of tons of rock above " ;
 $CB1D DEFM "me. Sinister and rather ugly gargoyles protrude from the pillars " ;
 $CB5E DEFM "gazing centrally towards a mass of mystical symbols which are eng" ;
 $CB9F DEFM "raved all over the floor"                                          ; }
 $CBB7 DEFB $7E                                                                 ; Terminator.
 $CBB8 DEFM "you are on a landing with steep stairs leading both upwards and d" ; {"#MESSAGE(#PC)".
 $CBF9 DEFM "own. Below at the foot of the descending stairs you can see a dar" ;
 $CC3A DEFM "k hall and in the faint light from the rock you can just make out" ;
 $CC7B DEFM " several zombie guards"                                            ; }
 $CC91 DEFB $7E                                                                 ; Terminator.
 $CC92 DEFM "you are in a shattered hall. Huge scorch marks and strange burns " ; {"#MESSAGE(#PC)".
 $CCD3 DEFM "appear to indicate a tremendous amount of powerful sorcery was us" ;
 $CD14 DEFM "ed in here, indeed sufficient to blow huge chunks out of the wall" ; }
 $CD55 DEFB $7E                                                                 ; Terminator.
 $CD56 DEFM "you are in a low narrow corridor. To the south is a small chamber" ; {"#MESSAGE(#PC)".
 $CD97 DEFM " while to the east the passage opens up into a large cave"         ; }
