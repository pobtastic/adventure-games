; Game Entry Point
;
; Used by the routine at #R$8DB9.
; .
; The third load block is entered here. Jump straight into the
; initialisation routine.
@label=GameEntryPoint
c$61A8 JP $F8AF      ; Jump to #R$F8AF to initialise the game.

