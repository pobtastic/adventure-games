; Response: "Please Rephrase That"
;
; Used by the routines at #R$6972, #R$697D, #R$6992 and #R$937B.
; .
; Point at "Please rephrase that.".
@label=ResponsePleaseRephraseThat
c$6479 LD HL,$6445   ; {Print #MESSAGE$6445.
 $647C CALL $64E9    ; }
 $647F RET           ; Return.

; Response: "Please Be More Specific"
;
; Used by the routines at #R$697D and #R$937B.
; .
; Point at "Please be more specific.".
@label=ResponsePleaseBeMoreSpecific
c$6480 LD HL,$642C   ; {Print #MESSAGE$642C.
 $6483 CALL $64E9    ; }
 $6486 RET           ; Return.

; Response: "You Can't"
;
; Used by the routines at #R$93E4, #R$9670, #R$98AB and #R$9A2E.
; .
; Point at "You can't.".
@label=ResponseYouCanT
c$6487 LD HL,$645B   ; {Print #MESSAGE$645B.
 $648A CALL $64E9    ; }
 $648D RET           ; Return.

; Response: "O.K."
;
; Used by the routines at #R$96E7 and #R$975A.
; .
; Point at "O.K.".
@label=ResponseOK
c$648E LD HL,$6466   ; {Print #MESSAGE$6466.
 $6491 CALL $64E9    ; }
 $6494 RET           ; Return.

; Get User Input
;
; Used by the routines at #R$6604, #R$678A, #R$69A1, #R$8DB9 and #R$8FB1.
; .
; Wait until a new key is pressed, then return that key.
;
; O:A The keypress value
;
; Wait until a new key is pressed.
@label=GetUserInput
c$6495 LD A,($5C3B)  ; Read the key-state flags from #SKOOLKID$5C3B(FLAGS).
 $6498 BIT 5,A       ; {Jump back to #R$6495 until a new key is pressed.
 $649A JR Z,$6495    ; }
 $649C RES 5,A       ; Reset the new-key flag.
 $649E LD ($5C3B),A  ; Write the flags back to #SKOOLKID$5C3B(FLAGS).
; Fetch the keypress.
 $64A1 LD A,($5C08)  ; Read the key from #SKOOLKID$5C08(LAST_K).
 $64A4 RET           ; Return.

; Clear Screen
;
; Used by the routines at #R$678A, #R$8DCE and #R$8EC4.
; .
; Clear the screen before a new location is shown.
@label=ClearScreen
c$64A5 CALL $64CE    ; Call #R$64CE to switch to the normal screen output.
 $64A8 CALL $0D6B    ; Call #SKOOLKID$0D6B(CLS).
 $64AB RET           ; Return.

; Clear Lines
;
; Clear the lines given by *#R$629B from the bottom of the screen.
;
; B Line count from *#R$629B
@label=ClearLines
c$64AC CALL $64CE    ; Call #R$64CE to switch to the normal screen output.
 $64AF LD A,($629B)  ; {Clear the number of lines held by *#R$629B from the
 $64B2 LD B,A        ; bottom of the screen using #SKOOLKID$0E44(CL_LINE).
 $64B3 CALL $0E44    ; }
 $64B6 RET           ; Return.

; Set Default Screen Position
;
; Used by the routines at #R$6510 and #R$6604.
; .
; Park the cursor at the top-left of the text area.
@label=SetDefaultScreenPosition
c$64B7 CALL $64CE    ; Call #R$64CE to switch to the normal screen output.
 $64BA LD BC,$0321   ; {Place the cursor at row #N($03), column #N$21.
 $64BD CALL $0DD9    ; }
 $64C0 RET           ; Return.

; Set Screen Position
;
; Used by the routines at #R$678A, #R$8DCE and #R$8EC4.
; .
; Move the cursor to the row stored for the next line of text.
;
; A Line number to start printing at
@label=SetScreenPosition
c$64C1 CALL $64CE    ; Call #R$64CE to switch to the normal screen output.
 $64C4 LD A,($629B)  ; Fetch the row the cursor should use.
 $64C7 LD B,A        ; {Place the cursor on that row, column #N$21.
 $64C8 LD C,$21      ;
 $64CA CALL $0DD9    ; }
 $64CD RET           ; Return.

; Switch To Normal Screen Output
;
; Used by the routines at #R$64A5, #R$64AC, #R$64B7, #R$64C1, #R$64DC and
; #R$6604.
; .
; Send subsequent printing to the main screen.
@label=SwitchToNormalScreenOutput
c$64CE PUSH HL       ; {Keep the caller's registers while the screen channel is
 $64CF PUSH DE       ; selected.
 $64D0 PUSH BC       ;
 $64D1 PUSH AF       ; }
 $64D2 LD A,$02      ; {Open channel #N($02), the main screen.
 $64D4 CALL $1601    ; }
 $64D7 POP AF        ; {Restore the registers the channel change used from the
 $64D8 POP BC        ; stack.
 $64D9 POP DE        ;
 $64DA POP HL        ; }
 $64DB RET           ; Return.

; Print String
;
; Used by the routines at #R$64E9, #R$6604, #R$678A, #R$68A4, #R$6A1C, #R$8FCD,
; #R$9198, #R$941B, #R$952B, #R$97CA, #R$9861 and #R$99DD.
; .
; Print a message terminated by #N$FF.
;
; HL Pointer to a message terminated by #N$FF
@label=PrintString
c$64DC CALL $64CE    ; Call #R$64CE to switch to the normal screen output.
@label=PrintString_Loop1
*$64DF LD A,(HL)     ; {Print each character of the message until the #N$FF
 $64E0 INC HL        ; terminator.
 $64E1 CP $FF        ;
 $64E3 RET Z         ;
 $64E4 CALL $64F2    ;
 $64E7 JR $64DF      ; }

; Print String And A Newline
;
; Used by the routines at #R$6479, #R$6480, #R$6487, #R$648E, #R$6669, #R$6745,
; #R$6763, #R$678A, #R$68A4, #R$69A1, #R$69DC, #R$8D2A, #R$8D85, #R$8DAD,
; #R$8DB3, #R$8DB9, #R$8DCE, #R$8E0F, #R$8E18, #R$8E8D, #R$8EC4, #R$8EF8,
; #R$8F13, #R$8FB1, #R$9014, #R$9198, #R$93A1, #R$941B, #R$9469, #R$947C,
; #R$94B1, #R$952B, #R$9670, #R$96BE, #R$96E7, #R$975A, #R$97CA, #R$9861,
; #R$98AB, #R$98B9, #R$997F, #R$99DD, #R$9A36 and #R$9A41.
; .
; Print a message terminated by #N($FF), then print a newline.
;
; HL Pointer to a message terminated by #N$FF
@label=PrintStringAndANewline
c$64E9 CALL $64DC    ; Call #R$64DC to print the message.
 $64EC LD A,$0D      ; Print a newline after the message.
 $64EE CALL $64F2    ; Call #R$64F2 to print the character.
 $64F1 RET           ; Return.

; Print Character
;
; Used by the routines at #R$64DC, #R$64E9, #R$6604, #R$6669, #R$678A and
; #R$6A1C.
; .
; Print a character, scrolling when the cursor reaches the bottom
; of the text area.
;
; A Character to print
@label=PrintCharacter
c$64F2 PUSH AF       ; Preserve the character to print.
 $64F3 LD A,($5C89)  ; {Jump to #R$650D when the cursor row in
 $64F6 CP $03        ; #SKOOLKID$5C89(S_POSN) is not #N$03.
 $64F8 JR NZ,$650D   ; }
 $64FA POP AF        ; {Restore the character from the stack, keeping a copy
 $64FB PUSH AF       ; there.}
 $64FC CP $0D        ; {Jump to #R$6505 when this is not a newline (#N$0D).
 $64FE JR NZ,$6505   ; }
; A newline scrolls the text area.
 $6500 CALL $6510    ; Call #R$6510 to scroll the screen.
 $6503 POP AF        ; Discard the character. A newline only scrolls.
 $6504 RET           ; Return.
; Check the column position.
@label=PrintCharacter_Step1
*$6505 LD A,($5C88)  ; {Call #R$6510 to scroll when the column in
 $6508 CP $01        ; #SKOOLKID$5C88(S_POSN) is #N$01.
 $650A CALL Z,$6510  ; }
@label=PrintCharacter_Step2
*$650D POP AF        ; Restore the character to print from the stack.
; Print the character.
 $650E RST $10       ; Print the character with #SKOOLKID$0010(PRINT_A_1).
 $650F RET           ; Return.

; Scroll Screen
;
; Used by the routine at #R$64F2.
; .
; Scroll the text area up one row and home the cursor.
@label=ScrollScreen
c$6510 EXX           ; {Scroll the text area and home the cursor, preserving the game
 $6511 CALL $0DFE    ; registers.
 $6514 CALL $64B7    ;
 $6517 EXX           ; }
 $6518 RET           ; Return.

; Print Room Graphic
;
; Used by the routines at #R$6541, #R$F82B, #R$F838, #R$F845 and #R$F852.
; .
; Expand a room picture into the display file.
;
; I:IX Pointer to room image data
@label=PrintRoomGraphic
c$6519 LD B,$10      ; {Count #N$10 display-file blocks (passes) and point #REGh at #N($40),
 $651B LD H,$40      ; the first block of the top third of the display file.}
; Each pass fills one 256-byte block of the display file: pixel line n of
; all eight character rows in the top or middle third. #REGh is the high byte of
; the screen address, so the #N$10 values #N$40-#N$4F are pixel lines #N$00-#N$07
; of the top two thirds (128 pixels high, matching #N$10 attribute rows).
@label=PrintRoomGraphic_Loop1
*$651D LD L,$00      ; Start a new pass.
@label=PrintRoomGraphic_Loop2
*$651F LD E,(IX+$00) ; {Read the next (offset,byte) pair into #REGde.
 $6522 LD D,(IX+$01) ;
 $6525 INC IX        ;
 $6527 INC IX        ; }
 $6529 LD A,E        ; {A #N($00),#N$00 pair ends this pass.
 $652A OR D          ;
 $652B JR Z,$6531    ; }
 $652D LD L,E        ; {Set #REGl to the offset and write the pixel byte there, then read
 $652E LD (HL),D     ; the next pair.
 $652F JR $651F      ; }
@label=PrintRoomGraphic_Step1
*$6531 INC H         ; {Move to the next display-file block until all #N$10
 $6532 DJNZ $651D    ; passes are done.}
 $6534 RET           ; Return.

; Colour Room Image
;
; Used by the routine at #R$6541.
; .
; Copy the #N$0200 attribute bytes that follow the picture.
;
; IX Pointer to the room attribute data
@label=Colour_RoomImage
c$6535 LD DE,$5800   ; {Copy the #N$0200 attribute bytes onto the screen.
 $6538 PUSH IX       ;
 $653A POP HL        ;
 $653B LD BC,$0200   ;
 $653E LDIR          ; }
 $6540 RET           ; Return.

; Print Room Image
;
; Used by the routines at #R$F813, #R$F81B, #R$F823, #R$F877, #R$F87F, #R$F887,
; #R$F88F, #R$F897, #R$F89F and #R$F8A7.
; .
; Draw a room picture and its attributes.
;
; IX Pointer to room image data
@label=Print_RoomImage
c$6541 CALL $6519    ; Call #R$6519 to expand the room picture.
 $6544 CALL $6535    ; Call #R$6535 to colour the room picture.
 $6547 RET           ; Return.

; Paint Room Image
;
; Used by the routine at #R$F85F.
; .
; Copy one attribute through the #N$0200 bytes of the room picture.
;
; I:A Attribute byte
@label=PaintRoomImage
c$6548 LD BC,$0200   ; {Point #REGhl at the attribute file and count #N$0200
 $654B LD HL,$5800   ; bytes, keeping the attribute in #REGe.
 $654E LD E,A        ; }
@label=PaintRoomImage_Loop
*$654F LD (HL),E     ; {Write that attribute through the rest of the picture.
 $6550 INC HL        ;
 $6551 DEC BC        ;
 $6552 LD A,B        ;
 $6553 OR C          ;
 $6554 JR NZ,$654F   ; }
 $6556 RET           ; Return.

; Handler: Turn-Based Events
;
; Used by the routine at #R$8D2A.
; .
; Count down the active turn-based events and run each one that expires.
@label=HandlerTurnBasedEvents
c$6557 LD A,($6219)  ; Fetch the turn-based event flags.
 $655A OR A          ; {No turn-based event is running.
 $655B JR Z,$6589    ; }
 $655D LD C,A        ; {Keep the event flags and test all eight bits.
 $655E LD B,$08      ; }
; Each set bit is a countdown that is still running.
@label=HandlerTurnBasedEvents_Loop1
*$6560 SRL C         ; Take the next turn-based event bit.
 $6562 JR NC,$6587   ; This event is not running.
 $6564 LD DE,$0000   ; {Count down the turn-based event whose bit was just set.
 $6567 LD HL,$621A   ;
 $656A LD A,$08      ;
 $656C SUB B         ;
 $656D LD E,A        ;
 $656E ADD HL,DE     ;
 $656F DEC (HL)      ; }
 $6570 JR NZ,$6587   ; Leave this event when its countdown has not expired.
 $6572 LD IX,$62A2   ; Find the handler for this turn-based event.
 $6576 SLA E         ; {Index the handler for this event.
 $6578 ADD IX,DE     ; }
 $657A LD L,(IX+$00) ; {Read that handler's address.
 $657D LD H,(IX+$01) ; }
 $6580 PUSH BC       ; Remember which events are still to be checked.
@label=HandlerTurnBasedEvents_Step1
@nowarn
 $6581 LD DE,$6586   ; {Run the handler, then return here for the remaining
 $6584 PUSH DE       ; events.
 $6585 JP (HL)       ; }
 $6586 POP BC        ; Restore the event flags still to be checked.
@label=HandlerTurnBasedEvents_Step2
*$6587 DJNZ $6560    ; Repeat for the remaining event bits.
@label=HandlerTurnBasedEvents_Step3
*$6589 NOP           ; Leave this event for the next turn.

; Handler: Scenic Events
;
; Walk the scenic-event bits and fire a handler when the player is in its room.
@label=HandlerScenicEvents
c$658A LD A,($6222)  ; Fetch the scenic-event flags.
 $658D OR A          ; {No scenic event is running.
 $658E JR Z,$65D1    ; }
 $6590 LD C,A        ; {Keep the scenic flags and test all eight bits.
 $6591 LD B,$08      ; }
; Each set bit is a scenic event that can plant a message.
@label=HandlerScenicEvents_Loop1
*$6593 SRL C         ; Take the next scenic-event bit.
 $6595 JR NC,$65CF   ; This scenic event is not running.
 $6597 LD DE,$0000   ; {Index this scenic event's message list.
 $659A LD A,$08      ;
 $659C SUB B         ;
 $659D LD E,A        ;
 $659E SLA E         ; }
 $65A0 PUSH BC       ; Remember which scenic bits are still to be checked.
 $65A1 LD A,($5C78)  ; {Let the frame counter choose how far to walk the
 $65A4 LD B,A        ; message list.}
 $65A5 LD IX,$62B2   ; Find the messages for this scenic event.
 $65A9 ADD IX,DE     ; {Point at this event's messages and prepare the end
 $65AB LD A,$FF      ; marker.}
@label=HandlerScenicEvents_Loop2
*$65AD LD L,(IX+$00) ; {Read the address of this event's message list.
 $65B0 LD H,(IX+$01) ; }
@label=HandlerScenicEvents_Loop3
*$65B3 CP (HL)       ; {Walk the list for as many frames as have passed.
 $65B4 INC HL        ;
 $65B5 JR Z,$65AD    ;
 $65B7 DJNZ $65B3    ; }
 $65B9 DEC HL        ; Step back to the message those frames selected.
 $65BA SRA E         ; Recover the event number from the list index.
 $65BC LD IX,$6224   ; Find the room this scenic event belongs to.
 $65C0 ADD IX,DE     ; Point at this event's room.
 $65C2 POP BC        ; Restore the scenic flags still to be checked.
 $65C3 LD A,($6223)  ; Fetch the current room.
 $65C6 CP (IX+$00)   ; {Leave the event alone when the player is already in its
 $65C9 JR Z,$65CF    ; room.}
 $65CB LD A,(HL)     ; {Plant the chosen message in this event's room.
 $65CC LD (IX+$00),A ; }
@label=HandlerScenicEvents_Step1
*$65CF DJNZ $6593    ; Repeat for the remaining scenic events.
@label=HandlerScenicEvents_Step2
*$65D1 RET           ; Return.

; Pause Loop
;
; Pause for the number of frames passed by the caller.
;
; B Number of frames to wait
@label=Pause_Loop
c$65D2 HALT          ; Wait for the next frame.
 $65D3 DJNZ $65D2    ; Wait out the remaining frames.
 $65D5 RET           ; Return.

; Generate Random Number
;
; Used by the routines at #R$8D2A and #R$952B.
; .
; Return a number derived from the frame counter, used when an event may or
; may not happen.
;
; O:A A random number derived from *#SKOOLKID$5C78(FRAMES)
@label=GenerateRandomNumber
c$65D6 PUSH BC       ; {Take the frame counter as a countdown, limited by the
 $65D7 LD C,A        ; value passed in.
 $65D8 LD A,($5C78)  ;
 $65DB LD B,A        ;
 $65DC LD A,C        ; }
@label=GenerateRandomNumber_Loop1
*$65DD DEC A         ; {Wrap back to that limit when the countdown passes zero.
 $65DE JR NZ,$65E1   ;
 $65E0 LD A,C        ; }
@label=GenerateRandomNumber_Step1
*$65E1 DJNZ $65DD    ; Repeat for every frame that has passed.
 $65E3 DEC A         ; Step the result back one more.
 $65E4 POP BC        ; Restore the registers the caller needs from the stack.
 $65E5 RET           ; Return.

; Handler: Update Object Location
;
; Used by the routines at #R$8E18, #R$9014, #R$9198, #R$941B, #R$94B1, #R$952B,
; #R$96E7, #R$975A, #R$97CA, #R$9861, #R$98B9, #R$997F, #R$99DD and #R$9A41.
; .
; Write a new location for an object. The caller passes the object and the
; room, or #N$01 when the object is carried.
@label=UpdateObjectLocation
c$65E6 BIT 7,B       ; {An ordinary object is stored in the location table.
 $65E8 JR Z,$65F1    ; }
 $65EA RES 7,B       ; The scenic marker is not part of the object number.
 $65EC LD HL,$6224   ; {Continue at #R$65F4 to store this scenic
 $65EF JR $65F4      ; object's room.}
@label=UpdateObjectLocation_Step1
*$65F1 LD HL,$61AB   ; The ordinary objects are kept in the location table.
@label=UpdateObjectLocation_Step2
*$65F4 LD D,$00      ; {Store the new location for this object.
 $65F6 LD E,B        ;
 $65F7 ADD HL,DE     ;
 $65F8 LD (HL),C     ; }
 $65F9 RET           ; Return.

; Is Object Present?
;
; Used by the routine at #R$678A.
; .
; Report whether any object is in the room passed by the caller.
@label=IsObjectPresent
c$65FA LD BC,($62C4) ; Fetch the number of objects.
 $65FE LD HL,$61AB   ; The ordinary objects are kept in the location table.
 $6601 CPIR          ; Search the object locations for anything in this room.
 $6603 RET           ; Return.

; Handler: User Input
;
; Used by the routines at #R$6745, #R$8D2A and #R$9670.
; .
; Handles keyboard input, tokenises commands and validates the vocabulary.
;
; .
;
; Prepare a blank command line.
@label=Handler_UserInput
c$6604 CALL $64B7    ; Call #R$64B7 to park the cursor at the default position.
 $6607 LD HL,$625F   ; {Blank the command buffer with #N$32 spaces.
 $660A LD A,$20      ;
 $660C LD B,$32      ; }
@label=Handler_UserInput_Loop1
*$660E LD (HL),A     ; {Write spaces through the command buffer.
 $660F INC HL        ;
 $6610 DJNZ $660E    ; }
; Ask for a command.
 $6612 CALL $6A1C    ; Call #R$6A1C to print the prompt.
 $6615 LD HL,$625F   ; The next character is stored at the start of the
                     ; command.
; Read the next key.
@label=Handler_UserInput_Loop2
*$6618 CALL $6495    ; Call #R$6495 to wait for a keypress.
 $661B CP $0C        ; {Jump to #R$663B when DELETE (#N$0C) was pressed.
 $661D JR Z,$663B    ; }
 $661F CP $0D        ; {Jump to #R$6652 when ENTER (#N$0D) was pressed.
 $6621 JR Z,$6652    ; }
 $6623 CP $20        ; {Jump back to #R$6618 when the key is a control
 $6625 JR C,$6618    ; character.}
 $6627 EX DE,HL      ; {Jump back to #R$6618 when the command buffer is full.
 $6628 LD HL,$6290   ;
 $662B AND A         ;
 $662C SBC HL,DE     ;
 $662E EX DE,HL      ;
 $662F JR Z,$6618    ; }
 $6631 LD (HL),A     ; {Store the character in the command buffer and print it.
 $6632 CALL $64CE    ;
 $6635 CALL $64F2    ;
 $6638 INC HL        ;
 $6639 JR $6618      ; }
; The player pressed DELETE.
@label=Handler_UserInput_Step1
*$663B EX DE,HL      ; {Jump back to #R$6618 when there is nothing to delete.
 $663C LD HL,$625F   ;
 $663F AND A         ;
 $6640 SBC HL,DE     ;
 $6642 EX DE,HL      ;
 $6643 JR Z,$6618    ; }
 $6645 PUSH HL       ; {Print #MESSAGE$62E3 and rub out the last character.
 $6646 LD HL,$62E3   ;
 $6649 CALL $64DC    ;
 $664C POP HL        ;
 $664D DEC HL        ;
 $664E LD (HL),$20   ;
 $6650 JR $6618      ; }
; The player pressed ENTER.
@label=Handler_UserInput_Step2
*$6652 LD (HL),A     ; {Store the terminator and echo the newline.
 $6653 CALL $64CE    ;
 $6656 CALL $64F2    ; }
 $6659 LD HL,$6291   ; {Point at the word tokens and prepare the empty marker
 $665C LD A,$FF      ; (#N$FF).
 $665E LD B,$0A      ; }
@label=Handler_UserInput_Loop3
*$6660 LD (HL),A     ; {Mark every word token as empty.
 $6661 INC HL        ;
 $6662 DJNZ $6660    ; }
 $6664 LD HL,$625F   ; {Up to #N$0A words of the command are accepted.
 $6667 LD C,$0A      ; }

; Parser: Match Input Word
;
; Read the next word of the command and turn it into a vocabulary token.
@label=Parser_MatchInputWord
c$6669 LD DE,$629E   ; The typed word is held as four letters.
 $666C LD B,$04      ; A word is at most four letters.
 $666E LD A,$20      ; Pad the typed word with spaces.
@label=Parser_MatchInputWord_Loop1
*$6670 LD (DE),A     ; {Fill the four-letter word with spaces.
 $6671 INC DE        ;
 $6672 DJNZ $6670    ; }
 $6674 XOR A         ; {No words left means the command has been parsed.
 $6675 OR C          ; }
 $6676 JP Z,$6745    ; An empty command is an unknown word.
 $6679 LD A,(HL)     ; Read the next character of the command.
 $667A CP $0D        ; {Jump to #R$6745 when ENTER (#N$0D) was pressed.
 $667C JP Z,$6745    ; }
 $667F LD B,$04      ; Keep at most four letters of this word.
 $6681 LD DE,$629E   ; The typed word is held as four letters.
@label=Parser_MatchInputWord_Loop2
*$6684 LD A,(HL)     ; {Stop copying when ENTER ends the command.
 $6685 CP $0D        ;
 $6687 JR Z,$66B0    ; }
 $6689 CP $20        ; {Stop copying at a space or a comma.
 $668B JR Z,$66A6    ;
 $668D CP $2C        ;
 $668F JR Z,$66A6    ; }
 $6691 LD (DE),A     ; {Store this letter and read the next.
 $6692 INC HL        ;
 $6693 INC DE        ;
 $6694 DJNZ $6684    ; }
@label=Parser_MatchInputWord_Loop3
*$6696 LD A,(HL)     ; {Stop skipping when ENTER ends the command.
 $6697 CP $0D        ;
 $6699 JR Z,$66B0    ; }
 $669B CP $20        ; {Stop skipping at a space or a comma.
 $669D JR Z,$66A6    ;
 $669F CP $2C        ;
 $66A1 JR Z,$66A6    ; }
 $66A3 INC HL        ; {Skip this extra letter.
 $66A4 JR $6696      ; }
@label=Parser_MatchInputWord_Loop4
*$66A6 INC HL        ; {Skip spaces before the next word.
 $66A7 LD A,(HL)     ;
 $66A8 CP $20        ;
 $66AA JR Z,$66A6    ; }
 $66AC CP $2C        ; {Jump back to #R$66A6 when that character is a comma
 $66AE JR Z,$66A6    ; (#N$2C).}
; The word THE is ignored.
@label=Parser_MatchInputWord_Step1
*$66B0 EXX           ; {Compare the word with #MESSAGE$62E7 without losing the command
 $66B1 LD HL,$62E7   ; pointer.
 $66B4 LD DE,$629E   ;
 $66B7 LD B,$04      ; }
@label=Parser_MatchInputWord_Loop5
*$66B9 LD A,(DE)     ; {Match the four letters of "THE ".
 $66BA CP (HL)       ;
 $66BB JR NZ,$66C1   ;
 $66BD INC DE        ;
 $66BE INC HL        ;
 $66BF DJNZ $66B9    ; }
@label=Parser_MatchInputWord_Step2
*$66C1 EXX           ; {Ignore the word and parse again when it was "THE ".
 $66C2 JR Z,$6669    ;
 $66C4 DEC C         ; }
 $66C5 EXX           ; {Search the vocabulary addressed by *#R$629C.
 $66C6 LD HL,($629C) ;
 $66C9 LD C,$00      ; }
@label=Parser_MatchInputWord_Loop6
*$66CB LD A,(HL)     ; Read the next vocabulary letter.
 $66CC CP $FF        ; {Jump to #R$66FD when the vocabulary list ends (#N$FF).
 $66CE JR Z,$66FD    ; }
@label=Parser_MatchInputWord_Loop7
*$66D0 LD DE,$629E   ; The typed word is held as four letters.
 $66D3 LD B,$04      ; Compare four letters of this vocabulary word.
@label=Parser_MatchInputWord_Loop8
*$66D5 LD A,(DE)     ; {Match the typed word against this vocabulary entry.
 $66D6 CP (HL)       ;
 $66D7 JR NZ,$66EE   ;
 $66D9 INC DE        ;
 $66DA INC HL        ;
 $66DB DJNZ $66D5    ; }
 $66DD EXX           ; {Store this vocabulary number as the current word's
 $66DE LD A,$09      ; token.
 $66E0 SUB C         ;
 $66E1 EXX           ;
 $66E2 LD D,$00      ;
 $66E4 LD E,A        ;
 $66E5 LD HL,$6291   ;
 $66E8 ADD HL,DE     ;
 $66E9 LD (HL),C     ;
 $66EA EXX           ; }
 $66EB JP $6669      ; Jump to #R$6669 to read the next word.
@label=Parser_MatchInputWord_Step3
*$66EE LD E,B        ; {Skip the letters left in a word that did not match.
 $66EF LD D,$00      ;
 $66F1 ADD HL,DE     ; }
 $66F2 LD A,(HL)     ; Read the byte that follows this vocabulary word.
 $66F3 CP $2C        ; {A comma marks another synonym of the same word.
 $66F5 JR NZ,$66FA   ; }
 $66F7 INC HL        ; Step past that comma.
 $66F8 JR $66D0      ; Continue at #R$66D0 to match this synonym against
                     ; the typed word.
@label=Parser_MatchInputWord_Step4
*$66FA INC C         ; Try the next vocabulary word.
 $66FB JR $66CB      ; Continue at #R$66CB to try the next vocabulary word.
@label=Parser_MatchInputWord_Step5
*$66FD EXX           ; {The word is unknown. Count back to it from the end of
 $66FE LD A,$0A      ; the command.
 $6700 SUB C         ;
 $6701 LD C,A        ;
 $6702 LD HL,$625F   ; }
@label=Parser_MatchInputWord_Loop9
*$6705 DEC C         ; Step back to the previous word of the command.
 $6706 JR Z,$6720    ; This is the word the game could not recognise.
@label=Parser_MatchInputWord_Loop10
*$6708 LD A,(HL)     ; {Find the end of the previous word.
 $6709 CP $20        ;
 $670B JR Z,$6714    ;
 $670D CP $2C        ;
 $670F JR Z,$6714    ;
 $6711 INC HL        ;
 $6712 JR $6708      ; }
@label=Parser_MatchInputWord_Loop11
*$6714 INC HL        ; {Skip the gap after that word.
 $6715 LD A,(HL)     ;
 $6716 CP $20        ;
 $6718 JR Z,$6714    ; }
 $671A CP $2C        ; {Jump back to #R$6714 when that character is a comma
 $671C JR Z,$6714    ; (#N$2C).}
 $671E JR $6705      ; Continue at #R$6705 to count back another word of
                     ; the command.
@label=Parser_MatchInputWord_Step6
*$6720 PUSH HL       ; Remember where the unknown word starts.
 $6721 LD HL,$6300   ; {Print #MESSAGE$6300.
 $6724 CALL $64E9    ; }
 $6727 POP HL        ; The unknown word starts at the address just saved.
 $6728 LD A,$22      ; {Print a quotation mark before the unknown word.
 $672A CALL $64F2    ; }
@label=Parser_MatchInputWord_Loop12
*$672D LD A,(HL)     ; {Print the characters of the unknown word.
 $672E CP $21        ;
 $6730 JR C,$6738    ;
 $6732 INC HL        ;
 $6733 CALL $64F2    ;
 $6736 JR $672D      ; }
@label=Parser_MatchInputWord_Step7
*$6738 LD A,$22      ; {Close the quotation.
 $673A CALL $64F2    ; }
 $673D LD HL,$646B   ; {Print #MESSAGE$646B.
 $6740 CALL $64E9    ; }
 $6743 JR $6751      ; Continue at #R$6751 to ask for another command.

; Handler: Unknown Word
;
; Used by the routine at #R$6669.
; .
; Print "I don't understand." when the command did not match a verb, then ask
; again.
@label=Handler_UnknownWord
c$6745 LD A,($6291)  ; Fetch the first word of the command.
 $6748 CP $FF        ; {Return if the first word of the command is not the end
 $674A RET NZ        ; marker (#N$FF).}
 $674B LD HL,$62EC   ; {Print #MESSAGE$62EC.
 $674E CALL $64E9    ; }
; This entry point is used by the routine at #R$6669.
@label=Handler_UnknownWord_Step1
*$6751 JP $6604      ; Jump to #R$6604 to read another command.

; Get Table Entry
;
; Used by the routines at #R$6763, #R$678A, #R$68A4 and #R$8D85.
; .
; Retrieve an address from a table using a given index.
;
;   E Index of the entry
;   IX Base table address
; O:HL Address from the table entry
; O:IX Address of the table entry
@label=GetTableEntry
c$6754 LD D,$00      ; {Look up the address stored at this index.
 $6756 SLA E         ;
 $6758 RL D          ;
 $675A ADD IX,DE     ;
 $675C LD L,(IX+$00) ;
 $675F LD H,(IX+$01) ; }
 $6762 RET           ; Return.

; Print Objects
;
; Used by the routines at #R$678A and #R$8EC4.
; .
; List the objects in the room passed by the caller.
@label=PrintObjects
c$6763 LD HL,$61AB   ; Point at the object locations.
 $6766 LD BC,($62C4) ; Fetch the number of objects.
@label=PrintObjects_Loop1
*$676A CPIR          ; Find the next object that is in this room.
 $676C RET NZ        ; Return when no further object is in this room.
 $676D PUSH AF       ; {Keep the search state while this object's name is
 $676E PUSH HL       ; printed.
 $676F PUSH BC       ; }
 $6770 LD A,($62C4)  ; Fetch the number of objects.
 $6773 SUB C         ; {The bytes still to search give this object's number.
 $6774 DEC A         ;
 $6775 LD E,A        ; }
 $6776 LD IX,($62C6) ; Fetch the object-description table.
 $677A CALL $6754    ; Call #R$6754 to look up the table entry.
 $677D CALL $64E9    ; Print the object's name and start a new line.
 $6780 POP BC        ; {Restore the search and keep listing objects.
 $6781 POP HL        ;
 $6782 POP AF        ; }
 $6783 LD E,A        ; {Keep the room number and continue while objects remain.
 $6784 LD A,B        ;
 $6785 OR C          ;
 $6786 LD A,E        ; }
 $6787 JR NZ,$676A   ; List the next object that is in this room.
 $6789 RET           ; Return.

; Handler: Display Room
;
; Used by the routines at #R$69DC, #R$8E18 and #R$8EDA.
; .
; Draw the current location, its exits and the objects that are here.
@label=Handler_DisplayRoom
c$678A PUSH DE       ; Remember whether the caller asked for the picture.
 $678B CALL $64A5    ; Call #R$64A5 to clear the screen.
 $678E POP DE        ; Restore that request.
 $678F LD A,($62CA)  ; Fetch how many rooms have a picture.
 $6792 OR A          ; {No room has a picture.
 $6793 JR Z,$67E0    ; }
 $6795 LD A,($6223)  ; Fetch the current room.
 $6798 LD HL,($62CC) ; Fetch the list of rooms that have a picture.
 $679B LD BC,($62CA) ; Fetch how many rooms have a picture.
 $679F CPIR          ; Find this room in the list of pictures.
 $67A1 JR NZ,$67E0   ; This room has no picture.
 $67A3 LD A,($62CA)  ; Fetch how many rooms have a picture.
 $67A6 INC C         ; {Recover this room's slot in the picture list.
 $67A7 SUB C         ;
 $67A8 LD C,A        ; }
 $67A9 XOR A         ; {A nonzero request draws the picture even when it has
 $67AA OR E          ; been seen.}
 $67AB JR NZ,$67C9   ; Skip the seen-flag test when the picture was requested
                     ; again.
 $67AD LD HL,$6213   ; Check whether this room's picture has been shown.
 $67B0 LD A,C        ; The picture slot selects its seen flag.
@label=Handler_DisplayRoom_Loop1
*$67B1 CP $08        ; {Jump to #R$67BA when the picture slot is below #N($08),
 $67B3 JR C,$67BA    ; in this flag byte.}
 $67B5 SUB $08       ; {Move to the next flag byte while the slot is past this
 $67B7 INC HL        ; one.}
 $67B8 JR $67B1      ; Continue at #R$67B1 to test the next picture-seen flag.
@label=Handler_DisplayRoom_Step1
*$67BA LD B,A        ; {Build the bit that belongs to this picture.
 $67BB INC B         ;
 $67BC LD D,$00      ; }
@label=Handler_DisplayRoom_Loop2
*$67BE RL D          ; Shift that bit into place.
 $67C0 DJNZ $67BE    ; Repeat until the bit lines up with this picture.
 $67C2 LD A,(HL)     ; Read the seen flags for these pictures.
 $67C3 AND D         ; See whether this picture has already been shown.
 $67C4 JR NZ,$67E0   ; Skip the picture when it has already been shown.
 $67C6 LD A,(HL)     ; {Remember that this picture has now been shown.
 $67C7 OR D          ;
 $67C8 LD (HL),A     ; }
@label=Handler_DisplayRoom_Step2
*$67C9 LD A,$08      ; {Start the picture on text row #N$08.
 $67CB LD ($629B),A  ; }
 $67CE LD HL,$620F   ; The display flags record the room picture.
 $67D1 SET 0,(HL)    ; Remember to wait for a key once the picture is drawn.
 $67D3 LD IX,($62CE) ; Fetch the room-picture handlers.
 $67D7 LD E,C        ; The picture slot selects its drawing routine.
 $67D8 CALL $6754    ; Call #R$6754 to look up the table entry.
@label=Handler_DisplayRoom_Step3
@nowarn
 $67DB LD DE,$67E0   ; {Draw the picture, then continue with the room text.
 $67DE PUSH DE       ;
 $67DF JP (HL)       ; }
@label=Handler_DisplayRoom_Step4
*$67E0 CALL $64C1    ; Call #R$64C1 to move the cursor to the stored row.
 $67E3 LD A,$18      ; {Continue the description on text row #N$18.
 $67E5 LD ($629B),A  ; }
 $67E8 LD A,($6223)  ; Fetch the current room.
 $67EB LD IX,($62D0) ; Fetch the room-description table.
 $67EF LD E,A        ; The current room selects its description.
 $67F0 CALL $6754    ; Call #R$6754 to look up the table entry.
 $67F3 CALL $64E9    ; Print the room description and start a new line.
 $67F6 LD HL,$620F   ; The display flags record a picture waiting for a key.
 $67F9 BIT 0,(HL)    ; {No picture is waiting for a key.
 $67FB JR Z,$6802    ; }
 $67FD RES 0,(HL)    ; The picture no longer waits for a key.
 $67FF CALL $6495    ; Call #R$6495 to wait for a keypress.
@label=Handler_DisplayRoom_Step5
*$6802 CALL $6892    ; Call #R$6892 to find the exit record.
 $6805 LD D,H        ; {There are six exits to count.
 $6806 LD E,L        ;
 $6807 LD B,$06      ;
 $6809 LD C,$00      ; }
 $680B XOR A         ; A zero byte means that direction is closed.
; Count the open exits so they can be listed.
@label=Handler_DisplayRoom_Loop3
*$680C CP (HL)       ; {Count this exit when it is open.
 $680D JR Z,$6810    ;
 $680F INC C         ; }
@label=Handler_DisplayRoom_Step6
*$6810 INC HL        ; {Move on to the next direction.
 $6811 DJNZ $680C    ; }
 $6813 OR C          ; See whether any exit is open.
 $6814 JR Z,$687E    ; Skip the exit list when the room has none.
 $6816 LD A,C        ; One open exit uses the singular wording.
 $6817 CP $01        ; {More than one open exit uses the plural line.
 $6819 JR NZ,$683D   ; }
 $681B LD HL,$6347   ; {Print #MESSAGE$6347 on the same line.
 $681E CALL $64DC    ; }
 $6821 LD H,D        ; {Return to the exit record and the direction names.
 $6822 LD L,E        ;
 $6823 LD IX,$646D   ;
 $6827 XOR A         ;
 $6828 JR $682F      ; }
@label=Handler_DisplayRoom_Loop4
*$682A INC HL        ; {Skip a closed exit and its direction name.
 $682B INC IX        ;
 $682D INC IX        ; }
@label=Handler_DisplayRoom_Step7
*$682F CP (HL)       ; {Keep skipping while this exit is closed.
 $6830 JR Z,$682A    ; }
 $6832 LD L,(IX+$00) ; {Read the name of this open exit.
 $6835 LD H,(IX+$01) ; }
 $6838 CALL $64DC    ; Call #R$64DC to print the message.
 $683B JR $6878      ; Continue at #R$6878 to end the list of exits.
@label=Handler_DisplayRoom_Step8
*$683D LD HL,$6334   ; {Print #MESSAGE$6334.
 $6840 CALL $64E9    ; }
 $6843 LD H,D        ; {Return to the exit record and the direction names.
 $6844 LD L,E        ;
 $6845 LD IX,$646D   ;
 $6849 XOR A         ;
 $684A JR $6852      ; }
@label=Handler_DisplayRoom_Loop5
*$684C EX DE,HL      ; Hold the exit record while the next name is printed.
@label=Handler_DisplayRoom_Loop6
*$684D INC HL        ; {Skip a closed exit and its direction name.
 $684E INC IX        ;
 $6850 INC IX        ; }
@label=Handler_DisplayRoom_Step9
*$6852 CP (HL)       ; {Keep skipping while this exit is closed.
 $6853 JR Z,$684D    ; }
 $6855 EX DE,HL      ; Bring the exit record back after printing a name.
 $6856 LD L,(IX+$00) ; {Read the name of this open exit.
 $6859 LD H,(IX+$01) ; }
 $685C CALL $64DC    ; Call #R$64DC to print the message.
 $685F DEC C         ; {One fewer exit name remains.
 $6860 LD A,C        ; }
 $6861 CP $01        ; {Finish the list when no exit name remains.
 $6863 JR C,$6878    ; }
 $6865 JR Z,$686F    ; The last remaining exit is joined with "and".
 $6867 LD A,$2C      ; Separate these exit names with a comma.
 $6869 CALL $64F2    ; Call #R$64F2 to print the character.
 $686C XOR A         ; Prepare to test the next exit.
 $686D JR $684C      ; Continue at #R$684C to name another open exit.
@label=Handler_DisplayRoom_Step10
*$686F LD HL,$6330   ; {Print #MESSAGE$6330 on the same line.
 $6872 CALL $64DC    ; }
 $6875 XOR A         ; Prepare to test the next exit.
 $6876 JR $684C      ; Continue at #R$684C to name the last open exit.
@label=Handler_DisplayRoom_Step11
*$6878 LD HL,$646B   ; {Print #MESSAGE$646B.
 $687B CALL $64E9    ; }
@label=Handler_DisplayRoom_Step12
*$687E LD A,($6223)  ; Fetch the current room.
 $6881 CALL $65FA    ; Call #R$65FA to see whether anything is in the room.
 $6884 RET NZ        ; Return when the room is empty.
 $6885 LD HL,$6321   ; {Print #MESSAGE$6321.
 $6888 CALL $64E9    ; }
 $688B LD A,($6223)  ; Fetch the current room.
 $688E CALL $6763    ; Call #R$6763 to list the objects here.
 $6891 RET           ; Return.

; Get Room Pointer
;
; Used by the routines at #R$678A and #R$8EF8.
; .
; Find the six-byte exit record for the current room.
@label=GetRoomPointer
c$6892 LD A,($6223)  ; Fetch the current room.
 $6895 LD E,A        ; {Point at the six-byte exit record for this room.
 $6896 LD D,$00      ;
 $6898 LD HL,$0006   ;
 $689B CALL $30A9    ;
 $689E LD DE,($62C2) ;
 $68A2 ADD HL,DE     ; }
 $68A3 RET           ; Return.

; Parser: Resolve Phrase
;
; Used by the routine at #R$8D2A.
; .
; Replace a typed phrase with the verb it stands for.
@label=Parser_ResolvePhrase
c$68A4 INC BC        ; The search stops one byte past the matching noun.
 $68A5 LD A,($62C8)  ; Fetch how many nouns the game knows.
 $68A8 SUB C         ; {Select this noun's phrase and the marker that ends it.
 $68A9 LD B,A        ;
 $68AA LD E,A        ;
 $68AB LD A,$FE      ; }
 $68AD LD HL,($62D2) ; Fetch the noun-phrase table.
 $68B0 INC B         ; Count the phrase terminator as one more step.
 $68B1 JR $68B8      ; Continue at #R$68B8 to walk past the phrases already
                     ; considered.
@label=Parser_ResolvePhrase_Loop1
*$68B3 INC HL        ; Skip a byte inside the phrase just passed.
@label=Parser_ResolvePhrase_Loop2
*$68B4 INC HL        ; {Walk forward until the end-of-phrase marker.
 $68B5 CP (HL)       ;
 $68B6 JR Z,$68B3    ; }
@label=Parser_ResolvePhrase_Step1
*$68B8 DJNZ $68B4    ; Repeat for each phrase before this noun.
 $68BA JR $68BD      ; Continue at #R$68BD to read the object this phrase
                     ; names.
@label=Parser_ResolvePhrase_Loop3
*$68BC INC HL        ; Step to the next byte of the phrase.
@label=Parser_ResolvePhrase_Step2
*$68BD LD A,(HL)     ; Read the object this phrase refers to.
 $68BE CALL $68E0    ; Call #R$68E0 to test whether the object is here.
 $68C1 RET Z         ; Return when that object is here or being carried.
 $68C2 INC HL        ; Step to the next byte of the phrase.
 $68C3 LD A,(HL)     ; Read the marker that follows the object.
 $68C4 CP $FE        ; {Jump back to #R$68BC when another object follows in the
 $68C6 JR Z,$68BC    ; phrase (#N$FE).}
 $68C8 LD HL,$6378   ; {Print #MESSAGE$6378 on the same line.
 $68CB CALL $64DC    ; }
 $68CE LD IX,($62D4) ; Fetch the noun table.
 $68D2 CALL $6754    ; Call #R$6754 to look up the table entry.
 $68D5 CALL $64DC    ; Call #R$64DC to print the message.
 $68D8 LD HL,$6385   ; {Print #MESSAGE$6385.
 $68DB CALL $64E9    ; }
 $68DE SCF           ; Set the carry flag to reject the command.
 $68DF RET           ; Return.

; Is Object In The Current Room?
;
; Used by the routines at #R$68A4, #R$8DDC, #R$8DEC, #R$8DFC, #R$8E18, #R$8E8D,
; #R$8F13, #R$9014, #R$9198, #R$93A1, #R$93E4, #R$94B1, #R$952B, #R$96E7,
; #R$975A, #R$97CA, #R$98B9, #R$997F, #R$99DD and #R$9A41.
; .
; Report whether the given object is in the current room or is
; being carried.
;
;   A Object number
; O:F Zero flag set when the object is in the current room
@label=IsObjectInCurrentRoom
c$68E0 PUSH HL       ; {Keep the caller's registers while the location is
 $68E1 PUSH DE       ; tested.}
 $68E2 LD E,A        ; {Index the location tables by this object.
 $68E3 LD D,$00      ; }
 $68E5 BIT 7,E       ; {Bit 7 selects a scenic slot rather than an ordinary
 $68E7 JR NZ,$68EE   ; object.}
 $68E9 LD HL,$61AB   ; {Continue at #R$68F3 to compare an ordinary
 $68EC JR $68F3      ; object's location.}
@label=IsObjectInCurrentRoom_Step1
*$68EE RES 7,E       ; The scenic marker is not part of the object number.
 $68F0 LD HL,$6224   ; A scenic object is kept with the scenic rooms.
@label=IsObjectInCurrentRoom_Step2
*$68F3 ADD HL,DE     ; Index this object's byte in the location table.
 $68F4 LD A,($6223)  ; Fetch the current room.
 $68F7 CP (HL)       ; {The object is here when its location is the current
 $68F8 JR Z,$68FD    ; room.}
 $68FA LD A,$01      ; {A carried object counts as present too.
 $68FC CP (HL)       ; }
@label=IsObjectInCurrentRoom_Step3
*$68FD POP DE        ; {Restore the registers the caller needs from the stack.
 $68FE POP HL        ; }
 $68FF RET           ; Return.

; Parser: Advance To Separator
;
; Used by the routines at #R$8F13, #R$8FCD, #R$9014, #R$9198, #R$937B, #R$93A1,
; #R$93E4, #R$941B, #R$947C, #R$94B1, #R$952B, #R$9670, #R$96BE, #R$96E7,
; #R$975A, #R$97CA, #R$9861, #R$98B9, #R$997F, #R$99DD and #R$9A41.
; .
; Report whether the words still to be parsed match the phrase passed by
; the caller.
@label=Parser_AdvanceToSeparator
c$6900 EX DE,HL      ; Hold the phrase while the command tokens are checked.
 $6901 JR $6904      ; Continue at #R$6904 to start at the second word
                     ; of the command.
@label=Parser_AdvanceToSeparator_Loop1
*$6903 INC DE        ; Step to the next byte of the phrase.
@label=Parser_AdvanceToSeparator_Step1
*$6904 LD HL,$6292   ; Matching starts at the second word of the command.
 $6907 JR $690B      ; Continue at #R$690B to compare that word with the
                     ; phrase.
@label=Parser_AdvanceToSeparator_Loop2
*$6909 INC HL        ; The next token of the command has to match too.
 $690A INC DE        ; Step to the next word of the command.
@label=Parser_AdvanceToSeparator_Step2
*$690B LD A,(DE)     ; Read the next byte of the phrase.
 $690C CP (HL)       ; {Keep matching while this token agrees with the phrase.
 $690D JR Z,$6909    ; }
 $690F CP $FE        ; {This byte is a word token, not the end of the phrase.
 $6911 JR NZ,$6917   ; }
 $6913 LD A,(HL)     ; Read the token the phrase is waiting for.
 $6914 CP $FF        ; Compare with #N$FF.
 $6916 RET           ; Return.
@label=Parser_AdvanceToSeparator_Step3
*$6917 CP $FD        ; {This byte is not an alternative in the phrase.
 $6919 JR NZ,$6921   ; }
 $691B LD A,(HL)     ; Read the token the phrase is waiting for.
 $691C CP $FF        ; {Jump back to #R$6903 when the phrase token is not the
 $691E JR NZ,$6903   ; end marker (#N$FF).}
 $6920 RET           ; Return.
@label=Parser_AdvanceToSeparator_Loop3
*$6921 INC DE        ; {Match the next alternative in the phrase.
 $6922 LD A,(DE)     ;
 $6923 CP $FE        ;
 $6925 JR Z,$692D    ;
 $6927 CP $FD        ;
 $6929 JR NZ,$6921   ; }
 $692B JR $6903      ; Continue at #R$6903 to try the next wording of
                     ; the phrase.
@label=Parser_AdvanceToSeparator_Step4
*$692D OR A          ; Set flags from #REGa.
 $692E RET           ; Return.

; Parser: Find Phrase
;
; Used by the routines at #R$697D, #R$6992 and #R$9469.
; .
; Set the zero flag when none of the typed words is a known noun.
@label=Parser_FindPhrase
c$692F LD HL,$6291   ; Check the command's word tokens for a noun.
 $6932 LD B,$0A      ; A command has at most #N$0A words.
 $6934 LD E,$00      ; No noun has matched yet.
@label=Parser_FindPhrase_Loop1
*$6936 LD A,(HL)     ; Read the next word token.
 $6937 CP $FF        ; {Jump to #R$694C when the command has no more words
 $6939 JR Z,$694C    ; (#N$FF).}
 $693B EXX           ; {Look that token up in the noun list without losing the token
 $693C LD HL,($62D6) ; pointer.
 $693F LD BC,($62C8) ;
 $6943 CPIR          ;
 $6945 EXX           ; }
 $6946 JR NZ,$6949   ; Leave the match count alone when this token is not a
                     ; noun.
 $6948 INC E         ; Count this token as a noun.
@label=Parser_FindPhrase_Step1
*$6949 INC HL        ; Move on to the next word token.
 $694A DJNZ $6936    ; Repeat for the remaining words of the command.
@label=Parser_FindPhrase_Step2
*$694C XOR A         ; {Set the zero flag when the command named no noun.
 $694D OR E          ; }
 $694E RET           ; Return.

; Get Object Location
;
; Used by the routines at #R$6958, #R$93E4 and #R$9A41.
; .
; Return the location of the given object.
;
; I:A Object number
; O:A Location of the object
@label=GetObjectLocation
c$694F LD E,A        ; {Read where this object is.
 $6950 LD D,$00      ;
 $6952 LD HL,$61AB   ;
 $6955 ADD HL,DE     ;
 $6956 LD A,(HL)     ; }
 $6957 RET           ; Return.

; Is Object Carried?
;
; Used by the routines at #R$8FCD, #R$9198, #R$941B, #R$94B1, #R$952B, #R$97CA,
; #R$9861, #R$99DD and #R$9A41.
; .
; Report whether the given object is being carried.
@label=IsObjectCarried
c$6958 CALL $694F    ; Call #R$694F to read the object's location.
 $695B CP $01        ; Compare with #N$01.
 $695D RET           ; Return.

; Handler: Toggle Scenic Flag
;
; Used by the routine at #R$952B.
; .
; Flip the scenic-event bit selected by the caller.
;
; I:A Bit number
@label=HandlerToggleScenicFlag
c$695E PUSH BC       ; Remember the caller's registers.
 $695F LD C,$01      ; {Start with the bit for scenic event zero.
 $6961 LD B,A        ; }
 $6962 AND A         ; {Event zero uses that bit as it stands.
 $6963 JR Z,$6969    ; }
@label=HandlerToggleScenicFlag_Loop1
*$6965 RLC C         ; Line the bit up with this scenic event.
 $6967 DJNZ $6965    ; Repeat until the bit matches that event.
@label=HandlerToggleScenicFlag_Step1
*$6969 LD A,($6222)  ; Fetch the scenic-event flags.
 $696C XOR C         ; Flip this scenic event's bit.
 $696D LD ($6222),A  ; Store the scenic-event flags.
 $6970 POP BC        ; Restore the registers the caller needs from the stack.
 $6971 RET           ; Return.

; Parser: Validate No Direct Object
;
; Used by the routines at #R$8E8D, #R$8EC4, #R$8EDA, #R$8EF8, #R$8FA1, #R$8FA9,
; #R$8FB1 and #R$9670.
; .
; Return with the carry flag set, after asking the player to rephrase, when a
; command that takes no object was given one.
@label=Parser_ValidateNoDirectObject
c$6972 LD A,($6292)  ; Fetch the second word of the command.
 $6975 CP $FF        ; {Return if the command has no second word (#N$FF).
 $6977 RET Z         ; }
 $6978 CALL $6479    ; Call #R$6479 to ask the player to rephrase the command.
 $697B SCF           ; Set the carry flag to reject the command.
 $697C RET           ; Return.

; Parser: Validate Direct Object
;
; Used by the routines at #R$8F13, #R$8FCD, #R$9198, #R$93A1, #R$941B, #R$94B1,
; #R$952B, #R$9670, #R$96E7, #R$975A, #R$97CA, #R$9861, #R$98AB, #R$98B9,
; #R$99DD, #R$9A2E, #R$9A36 and #R$9A41.
; .
; Return with the carry flag set unless the command names one known object.
@label=Parser_ValidateDirectObject
c$697D LD A,($6292)  ; Fetch the second word of the command.
 $6980 CP $FF        ; {Jump to #R$6989 when the command has a second word.
 $6982 JR NZ,$6989   ; }
 $6984 CALL $6480    ; Call #R$6480 to say there is nothing there.
 $6987 SCF           ; Set the carry flag to reject the command.
 $6988 RET           ; Return.
@label=Parser_ValidateDirectObject_Step1
*$6989 CALL $692F    ; Call #R$692F to look for a noun.
 $698C RET NZ        ; Return when the command names a noun.
 $698D CALL $6479    ; Call #R$6479 to ask the player to rephrase the command.
 $6990 SCF           ; Set the carry flag to reject the command.
 $6991 RET           ; Return.

; Parser: Match Or Rephrase
;
; Used by the routines at #R$93E4 and #R$96BE.
; .
; Return when the next token is absent or the phrase matches. Otherwise print
; "Please rephrase that.".
@label=Parser_MatchOrRephrase
c$6992 LD A,($6292)  ; Fetch the second word of the command.
 $6995 CP $FF        ; {Return if the command has no second word (#N$FF).
 $6997 RET Z         ; }
 $6998 CALL $692F    ; Call #R$692F to look for a noun.
 $699B RET NZ        ; Return when the command names a noun.
 $699C CALL $6479    ; Call #R$6479 to ask the player to rephrase the command.
 $699F SCF           ; Set the carry flag to reject the command.
 $69A0 RET           ; Return.

; Save Game
;
; Used by the routine at #R$8FA9.
; .
; Save the game position to tape.
@label=SaveGame
c$69A1 LD A,($62DC)  ; Fetch how many locations the save file stores.
 $69A4 OR A          ; {The save file has no extra locations to copy.
 $69A5 JR Z,$69C0    ; }
 $69A7 LD B,A        ; {Prepare to copy each saved location into the tape
 $69A8 LD IX,($62DE) ; workspace.
 $69AC LD DE,$622D   ;
 $69AF JR $69B6      ; }
@label=SaveGame_Loop1
*$69B1 INC IX        ; {Step to the next saved-location pointer.
 $69B3 INC IX        ;
 $69B5 INC DE        ; }
@label=SaveGame_Step1
*$69B6 LD L,(IX+$00) ; {Read the address of this saved location.
 $69B9 LD H,(IX+$01) ; }
 $69BC LD A,(HL)     ; Read the byte that location holds.
 $69BD LD (DE),A     ; Store it in the tape workspace.
 $69BE DJNZ $69B1    ; Repeat for the remaining saved locations.
@label=SaveGame_Step2
*$69C0 LD HL,$63D3   ; {Print #MESSAGE$63D3.
 $69C3 CALL $64E9    ; }
 $69C6 CALL $6495    ; Call #R$6495 to wait for a keypress.
 $69C9 LD IX,$61AB   ; The save starts at the object locations.
 $69CD LD DE,$00B4   ; {Save #N$B4 bytes from the object locations as a data
 $69D0 LD A,$FF      ; block.}
 $69D2 CALL $04C2    ; Call #SKOOLKID$04C2(SA_BYTES).
 $69D5 LD HL,$63F5   ; {Print #MESSAGE$63F5.
 $69D8 CALL $64E9    ; }
 $69DB RET           ; Return.

; Load From Tape
;
; Used by the routine at #R$8FA1.
; .
; Load a game position from tape and redraw the room.
@label=LoadFromTape
c$69DC LD HL,$63B2   ; {Print #MESSAGE$63B2.
 $69DF CALL $64E9    ; }
 $69E2 LD IX,$61AB   ; The loaded game is written over the object locations.
 $69E6 LD DE,$00B4   ; {Load a data block of #N$B4 bytes over the object
 $69E9 LD A,$FF      ; locations.}
 $69EB SCF           ; Ask the ROM to load the block rather than verify it.
 $69EC CALL $0556    ; Call #SKOOLKID$0556(LD_BYTES).
 $69EF JR C,$69F8    ; Restore the saved bytes when the tape block has loaded.
 $69F1 LD HL,$63C7   ; {Print #MESSAGE$63C7.
 $69F4 CALL $64E9    ; }
 $69F7 RET           ; Return.
@label=LoadFromTape_Step1
*$69F8 LD A,($62DC)  ; Fetch how many locations the save file stores.
 $69FB OR A          ; {Return if the save file stores no locations.
 $69FC RET Z         ; }
 $69FD LD B,A        ; {Prepare to copy each saved location back into the game.
 $69FE LD IX,($62DE) ;
 $6A02 LD DE,$622D   ;
 $6A05 JR $6A0C      ; }
@label=LoadFromTape_Loop1
*$6A07 INC IX        ; {Step to the next saved-location pointer.
 $6A09 INC IX        ;
 $6A0B INC DE        ; }
@label=LoadFromTape_Step2
*$6A0C LD L,(IX+$00) ; {Read the address of this saved location.
 $6A0F LD H,(IX+$01) ; }
 $6A12 LD A,(DE)     ; Read the byte saved for that location.
 $6A13 LD (HL),A     ; Write it back into the game.
 $6A14 DJNZ $6A07    ; Repeat for the remaining saved locations.
 $6A16 LD E,$00      ; Show the room picture even if it has been seen before.
 $6A18 CALL $678A    ; Call #R$678A to display the room.
 $6A1B RET           ; Return.

; Print Input Prompt
;
; Used by the routine at #R$6604.
; .
; Print the ">" prompt.
@label=PrintInputPrompt
c$6A1C LD HL,$5080   ; The prompt is drawn in the prompt cell.
 $6A1F LD DE,$0100   ; {Look at the eight rows of the prompt cell.
 $6A22 LD B,$08      ;
 $6A24 XOR A         ; }
@label=PrintInputPrompt_Loop1
*$6A25 OR (HL)       ; {Combine those rows to see whether the prompt is already
 $6A26 ADD HL,DE     ; visible.
 $6A27 DJNZ $6A25    ; }
 $6A29 OR A          ; {The prompt cell is empty, so the prompt must be
 $6A2A JR Z,$6A31    ; printed.}
 $6A2C LD A,$0D      ; Start the prompt on a new line.
 $6A2E CALL $64F2    ; Call #R$64F2 to print the character.
@label=PrintInputPrompt_Step1
*$6A31 LD HL,$62E0   ; {Print #MESSAGE$62E0 on the same line.
 $6A34 CALL $64DC    ; }
 $6A37 RET           ; Return.

