; Tape Loader
;
; Load the screen, then the game image. The length check keeps
; the graphics and the code as two blocks.
;
; .
;
; Load the first block: the loading screen.
@label=TapeLoader
c$5CD0 LD IX,$4000   ; {Load the screen from tape into the display file.
 $5CD4 LD DE,$1B00   ;
 $5CD7 CALL $5D01    ; }
; Choose one graphics block or two.
 $5CDA LD HL,$7530   ; {Jump to #R$5CFA when the pictures fit in one tape
 $5CDD LD DE,$98F4   ; block.
 $5CE0 AND A         ;
 $5CE1 SBC HL,DE     ;
 $5CE3 JR NC,$5CFA   ; }
@label=TapeLoader_Step1
@nowarn
 $5CE5 LD IX,$61A8   ; {Load the engine, the text and the first pictures at
 $5CE9 LD DE,$7530   ; #R$61A8.
 $5CEC CALL $5D01    ; }
 $5CEF LD IX,$D6D8   ; {Load the remaining pictures at #N$D6D8.
 $5CF3 LD DE,$23C4   ;
 $5CF6 CALL $5D01    ; }
 $5CF9 RET           ; Return.
@label=TapeLoader_Step2
@nowarn
*$5CFA LD IX,$61A8   ; {Load the pictures and the code as one block at #R$61A8.
 $5CFE LD DE,$98F4   ; }

; Tape Loading
;
; Used by the routine at #R$5CD0.
; .
; Load the tape block at the address and length already set up.
@label=TapeLoading
c$5D01 LD A,$45      ; Load the data-block marker #N$45.
 $5D03 SCF           ; Set the carry flag so the ROM loads this block.
 $5D04 CALL $0802    ; Call #SKOOLKID$0802(LD_BLOCK).
 $5D07 RET           ; Return.

; BASIC Loader
;
; The BASIC program and its variables, left above the system
; variables after the tape has loaded. The machine-code game does
; not execute it again.
@label=BasicLoader
