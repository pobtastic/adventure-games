; Game Start
;
; Used by the routine at #R$61A8.
; .
; Initialise the game state and enter the game loop at room #N$02.
@label=GameStart
c$F8AF LD HL,$5C6A   ; The keyboard flags are #SKOOLKID$5C6A(FLAGS2).
 $F8B2 SET 3,(HL)    ; Turn CAPS LOCK on.
; These exit bytes start closed and are opened by the plot.
 $F8B4 XOR A         ; {Seal the down exit of #MESSAGE$72C9, south from #MESSAGE$7308 and
 $F8B5 LD ($8BD1),A  ; east from #MESSAGE$7336.
 $F8B8 LD ($8BE5),A  ;
 $F8BB LD ($8BF2),A  ; }
 $F8BE LD ($8C0A),A  ; {Seal the east and up exits of #MESSAGE$7395.
 $F8C1 LD ($8C0C),A  ; }
 $F8C4 LD ($8C61),A  ; {Seal the down exit of #MESSAGE$73F6, west from #MESSAGE$745A and
 $F8C7 LD ($8C7D),A  ; east from #MESSAGE$7499.
 $F8CA LD ($8C8E),A  ; }
 $F8CD LD A,$34      ; {Restore the north exit of #MESSAGE$74C2 to
 $F8CF LD ($8C98),A  ; #MESSAGE$74AD.}
 $F8D2 LD A,$06      ; {Restore the south exit of #MESSAGE$71C4 to room #N$06.
 $F8D4 LD ($8B79),A  ; }
 $F8D7 LD HL,$F8EA   ; The default game state is stored at #R$F8EA.
 $F8DA LD DE,$61AB   ; The workspace begins with the object locations.
 $F8DD LD BC,$0135   ; The initial game state is #N$0135 bytes.
 $F8E0 LDIR          ; Copy the default state into the workspace.
 $F8E2 LD A,$02      ; {Move the player to #MESSAGE$7160 (#N$02).
 $F8E4 CALL $8E18    ; }
 $F8E7 JP $8D2A      ; Jump to #R$8D2A to read the next command.

