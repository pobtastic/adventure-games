; Game Loop
;
; Used by the routines at #R$8D85 and #R$F8AF.
; .
; Run the scenic check, read a command and dispatch it.
@label=GameLoop
c$8D2A CALL $6557    ; Call #R$6557 to turn-based events.
 $8D2D LD HL,$6224   ; Check the scenic-event rooms.
 $8D30 LD BC,$0008   ; There are eight scenic rooms to check.
@label=GameLoop_Loop1
*$8D33 LD A,($6223)  ; Fetch the current room.
 $8D36 CPIR          ; See whether the player is standing in this scenic room.
 $8D38 JR NZ,$8D55   ; The player is not in this scenic room.
 $8D3A PUSH HL       ; {Keep the scenic search while the warning is printed.
 $8D3B PUSH BC       ; }
 $8D3C LD HL,$7851   ; {Print #MESSAGE$7851.
 $8D3F CALL $64E9    ; }
 $8D42 LD A,$14      ; The plasma shell has one chance in #N$14 of hitting.
 $8D44 CALL $65D6    ; Call #R$65D6 to generate random number.
 $8D47 JR Z,$8DAD    ; The shell hits when that draw comes up zero.
 $8D49 LD HL,$788F   ; {Print #MESSAGE$788F.
 $8D4C CALL $64E9    ; }
 $8D4F POP BC        ; {Restore the scenic-room search.
 $8D50 POP HL        ; }
 $8D51 XOR A         ; {See whether another scenic room is still to be checked.
 $8D52 OR C          ; }
 $8D53 JR NZ,$8D33   ; Check the next scenic room.
@label=GameLoop_Step1
*$8D55 CALL $6604    ; Call #R$6604 to read another command.
 $8D58 LD A,($6291)  ; Fetch the first word of the command.
 $8D5B CP $59        ; {Jump to #R$8D65 when Y (#N$59) was not pressed.
 $8D5D JR NZ,$8D65   ; }
@label=GameLoop_Step2
@nowarn
 $8D5F LD HL,$997F   ; {Continue at #R$8DA8 to run Action: Type.
 $8D62 JP $8DA8      ; }
@label=GameLoop_Step3
*$8D65 XOR A         ; Start the synonym scan with a clear result.
 $8D66 LD HL,$6291   ; Check the command's word tokens for a noun.
 $8D69 LD B,$0A      ; A command has at most #N$0A word tokens.
@label=GameLoop_Loop2
*$8D6B LD A,(HL)     ; Read the next word token.
 $8D6C CP $FF        ; {Jump to #R$8D85 when the command has no more words
 $8D6E JR Z,$8D85    ; (#N$FF).}
 $8D70 EXX           ; {Look that token up in the noun list without losing the token
 $8D71 LD HL,$8868   ; pointer.
 $8D74 LD BC,($62C8) ;
 $8D78 CPIR          ; }
 $8D7A JR NZ,$8D81   ; This token is not a noun, so try the next word.
 $8D7C CALL $68A4    ; Call #R$68A4 to resolve phrase.
 $8D7F JR C,$8D2A    ; Jump back to #R$8D2A when the carry flag is set.
@label=GameLoop_Step4
*$8D81 EXX           ; Bring the token pointer back.
 $8D82 INC HL        ; Move on to the next word token.
 $8D83 DJNZ $8D6B    ; Repeat for the remaining words of the command.

; Handler: Match Verb
;
; Used by the routines at #R$8D2A and #R$937B.
; .
; Find the typed verb and jump to its action routine.
@label=HandlerMatchVerb
c$8D85 LD HL,$891C   ; Point at the list of verb word numbers.
 $8D88 LD BC,($62DA) ; Fetch how many verbs the game knows.
 $8D8C LD A,($6291)  ; Fetch the first word of the command.
 $8D8F CPIR          ; Find the typed verb in that list.
 $8D91 JR Z,$8D9B    ; The typed word is one of those verbs.
 $8D93 LD HL,$62EC   ; {Print #MESSAGE$62EC.
 $8D96 CALL $64E9    ; }
 $8D99 JR $8D2A      ; Jump to #R$8D2A to read the next command.
@label=HandlerMatchVerb_Step1
*$8D9B LD A,($62DA)  ; Fetch how many verbs the game knows.
 $8D9E SUB C         ; {The matching verb selects its handler.
 $8D9F DEC A         ;
 $8DA0 LD E,A        ; }
 $8DA1 LD IX,($62D8) ; Fetch the verb handlers.
 $8DA5 CALL $6754    ; Call #R$6754 to look up the table entry.
; This entry point is used by the routine at #R$8D2A.
@label=HandlerMatchVerb_Step2
@nowarn
*$8DA8 LD DE,$8D2A   ; {Run the verb, then return to the game loop.
 $8DAB PUSH DE       ;
 $8DAC JP (HL)       ; }

; Handler: Plasma Shell
;
; Used by the routine at #R$8D2A.
; .
; Tell the player the plasma shell has hit, then end the game.
@label=HandlerPlasmaShell
c$8DAD LD HL,$789E   ; {Print #MESSAGE$789E.
 $8DB0 CALL $64E9    ; }

; Game Over
;
; Used by the routines at #R$8E0F and #R$97CA.
; .
; Announce that the player is dead.
@label=GameOver
c$8DB3 LD HL,$638C   ; {Print #MESSAGE$638C.
 $8DB6 CALL $64E9    ; }

; Handler: Ask To Play Again
;
; Used by the routines at #R$8DCE and #R$8FB1.
; .
; Read Y or N, then reset the machine or start another game.
@label=HandlerAskToPlayAgain
c$8DB9 LD HL,$639A   ; {Print #MESSAGE$639A.
 $8DBC CALL $64E9    ; }
@label=HandlerAskToPlayAgain_Loop1
*$8DBF CALL $6495    ; Call #R$6495 to wait for a keypress.
 $8DC2 CP $4E        ; {Reset the computer when N (#N$4E) was pressed.
 $8DC4 JP Z,$0000    ; }
 $8DC7 CP $59        ; {Jump back to #R$61A8 when Y (#N$59) was pressed.
 $8DC9 JP Z,$61A8    ; }
 $8DCC JR $8DBF      ; Continue at #R$8DBF until the player presses Y or N.

; Game Complete
;
; Used by the routine at #R$9014.
; .
; Announce that the ship is clear and offer another game.
@label=GameComplete
c$8DCE CALL $64A5    ; Call #R$64A5 to clear the screen.
 $8DD1 CALL $64C1    ; Call #R$64C1 to move the cursor to the stored row.
 $8DD4 LD HL,$8333   ; {Print "#MESSAGE$8333" and start a new line.
 $8DD7 CALL $64E9    ; }
 $8DDA JR $8DB9      ; Jump to #R$8DB9 to ask to play again.

; Handler: Android Attack
;
; Fire the android guard when his event bit is set.
@label=HandlerAndroidAttack
c$8DDC LD HL,$6219   ; {The android's attack is over for this turn.
 $8DDF RES 0,(HL)    ; }
 $8DE1 LD A,$12      ; {Return when #MESSAGE$6B2A (#N$12) is not here or being
 $8DE3 CALL $68E0    ; carried.
 $8DE6 RET NZ        ; }
 $8DE7 LD HL,$8417   ; {Print "#MESSAGE$8417" and start a new line.
 $8DEA JR $8E0F      ; }

; Handler: Slug Attack
;
; Let the slug attack when the player is still in its room.
@label=HandlerSlugAttack
c$8DEC LD HL,$6219   ; {The slug's attack is over for this turn.
 $8DEF RES 1,(HL)    ; }
 $8DF1 LD A,$24      ; {Return when #MESSAGE$6DBF (#N$24) is not here or being
 $8DF3 CALL $68E0    ; carried.
 $8DF6 RET NZ        ; }
 $8DF7 LD HL,$8440   ; {Print "#MESSAGE$8440" and start a new line.
 $8DFA JR $8E0F      ; }

; Handler: Second Android
;
; Fire the second android guard.
@label=HandlerSecondAndroid
c$8DFC LD HL,$6219   ; {The second android's attack is over for this turn.
 $8DFF RES 2,(HL)    ; }
 $8E01 LD A,$27      ; {Return when #MESSAGE$6E6D (#N$27) is not here or being
 $8E03 CALL $68E0    ; carried.
 $8E06 RET NZ        ; }
 $8E07 LD HL,$8417   ; {Print "#MESSAGE$8417" and start a new line.
 $8E0A JR $8E0F      ; }

; Handler: Complex Explodes
;
; Destroy the player when the alien complex explodes.
@label=HandlerComplexExplodes
c$8E0C LD HL,$8456   ; Point #REGhl at "#MESSAGE$8456" and continue at #R$8E0F
                     ; to print it and end the game.

; Handler: Player Killed
;
; Used by the routines at #R$8DDC, #R$8DEC and #R$8DFC.
; .
; Print the message in #REGhl, discard the return addresses and
; continue at #R$8DB3. An attack jumps here, and the complex explosion
; falls through from #R$8E0C.
@label=Handler_PlayerKilled
c$8E0F CALL $64E9    ; Call #R$64E9 to print the message and start a new line.
 $8E12 POP HL        ; {Discard the stacked return addresses; the player is
 $8E13 POP HL        ; dead.
 $8E14 POP HL        ; }
 $8E15 JP $8DB3      ; Jump to #R$8DB3 to game over.

; Move Player To Room
;
; Used by the routines at #R$8EF8, #R$93A1, #R$93E4, #R$9670, #R$96BE and
; #R$F8AF.
; .
; Store the given room as the current room and update the exit record.
@label=MovePlayerToRoom
c$8E18 LD C,A        ; Remember the room being entered.
 $8E19 LD A,($6223)  ; Fetch the current room.
 $8E1C LD HL,$6224   ; The scenic events remember the room the player just
                     ; left.
 $8E1F LD B,$08      ; Up to eight scenic rooms may name the room just left.
 $8E21 JR $8E24      ; Continue at #R$8E24 to see if this scenic slot names the
                     ; old room.
@label=MovePlayerToRoom_Loop1
*$8E23 INC HL        ; Move on to the next scenic room.
@label=MovePlayerToRoom_Step1
*$8E24 CP (HL)       ; {Leave this scenic slot when it does not name the old
 $8E25 JR NZ,$8E28   ; room.}
 $8E27 LD (HL),C     ; This scenic slot now names the room being entered.
@label=MovePlayerToRoom_Step2
*$8E28 DJNZ $8E23    ; Repeat for the remaining scenic rooms.
 $8E2A LD A,C        ; {Make the new room current.
 $8E2B LD ($6223),A  ; }
 $8E2E LD E,$00      ; Draw the room, including its picture.
 $8E30 CALL $678A    ; Call #R$678A to display the room.
 $8E33 LD A,$12      ; {Jump to #R$8E44 when #MESSAGE$6B2A (#N$12) is not here or being
 $8E35 CALL $68E0    ; carried.
 $8E38 JR NZ,$8E44   ; }
 $8E3A LD HL,$6219   ; Check the turn-based event flags.
 $8E3D SET 0,(HL)    ; {The android will attack in #N$02 turns.
 $8E3F LD A,$02      ;
 $8E41 LD ($621A),A  ; }
@label=MovePlayerToRoom_Step3
*$8E44 LD A,$24      ; {Jump to #R$8E55 when #MESSAGE$6DBF (#N$24) is not here or being
 $8E46 CALL $68E0    ; carried.
 $8E49 JR NZ,$8E55   ; }
 $8E4B LD HL,$6219   ; Check the turn-based event flags.
 $8E4E SET 1,(HL)    ; {The slug will attack in #N$06 turns.
 $8E50 LD A,$06      ;
 $8E52 LD ($621B),A  ; }
@label=MovePlayerToRoom_Step4
*$8E55 LD A,$27      ; {Jump to #R$8E66 when #MESSAGE$6E6D (#N$27) is not here or being
 $8E57 CALL $68E0    ; carried.
 $8E5A JR NZ,$8E66   ; }
 $8E5C LD HL,$6219   ; Check the turn-based event flags.
 $8E5F SET 2,(HL)    ; {The second android will attack in #N$06 turns.
 $8E61 LD A,$06      ;
 $8E63 LD ($621C),A  ; }
@label=MovePlayerToRoom_Step5
*$8E66 LD A,($6223)  ; Fetch the current room.
 $8E69 CP $05        ; {The tractor beam is only dealt with on #MESSAGE$71C4.
 $8E6B JR NZ,$8E8C   ; }
 $8E6D LD HL,$6219   ; Check the turn-based event flags.
 $8E70 BIT 3,(HL)    ; {The explosion countdown is not armed.
 $8E72 JR Z,$8E8C    ; }
 $8E74 RES 3,(HL)    ; Leave the explosion countdown unarmed.
 $8E76 LD BC,$3000   ; {Move #MESSAGE$6F31 (#N$30) to nowhere (#N$00).
 $8E79 CALL $65E6    ; }
 $8E7C XOR A         ; {Close the south exit of #MESSAGE$71C4.
 $8E7D LD ($8B79),A  ; }
 $8E80 LD BC,$4004   ; {Move #MESSAGE$7141 (#N$40) to #MESSAGE$719C (#N$04).
 $8E83 CALL $65E6    ; }
 $8E86 LD HL,$83C2   ; {Print #MESSAGE$83C2.
 $8E89 CALL $64E9    ; }
@label=MovePlayerToRoom_Step6
*$8E8C RET           ; Return.

; Action: Help
;
; Print the hint for this room, or a general hint.
@label=ActionHelp
c$8E8D CALL $6972    ; {Return if the command names an object: the player is
 $8E90 RET C         ; told to rephrase it.}
 $8E91 LD A,($6223)  ; Fetch the current room.
@label=ActionHelp_Step1
@nowarn
 $8E94 LD HL,$8EBC   ; Point at the rooms that have a hint of their own.
 $8E97 LD BC,$0008   ; #N$08 rooms have a hint of their own.
 $8E9A CPIR          ; Find this room among the rooms that have a hint.
@label=ActionHelp_Loop1
*$8E9C JR NZ,$8EAA   ; This room has no hint of its own.
 $8E9E LD HL,$7794   ; {Print "#MESSAGE$7794" and start a new line.
 $8EA1 JR $8EA6      ; }
@label=ActionHelp_Loop2
*$8EA3 LD HL,$77C2   ; {Print "#MESSAGE$77C2" and start a new line.
@label=ActionHelp_Loop3
*$8EA6 CALL $64E9    ; }
 $8EA9 RET           ; Return.
@label=ActionHelp_Step2
*$8EAA CP $19        ; {The special hint applies only in #MESSAGE$7336.
 $8EAC JR NZ,$8EBA   ; }
 $8EAE LD A,$0B      ; {Jump back to #R$8E9C when #MESSAGE$6ACF (#N$0B) is not here or
 $8EB0 CALL $68E0    ; being carried.
 $8EB3 JR NZ,$8E9C   ; }
 $8EB5 LD HL,$7765   ; {Print "#MESSAGE$7765" and start a new line.
 $8EB8 JR $8EA6      ; }
@label=ActionHelp_Step3
*$8EBA JR $8EA3      ; Continue at #R$8EA3 to print the general hint.

; Table: Help Rooms
;
; Room ids that have their own help text. #R$8E8D searches
; this list before printing the general hint.
@label=Table_HelpRooms
b$8EBC DEFB $1A      ; Room #N(#PEEK(#PC)).
 $8EBD DEFB $17      ; Room #N(#PEEK(#PC)).
 $8EBE DEFB $1C      ; Room #N(#PEEK(#PC)).
 $8EBF DEFB $13      ; Room #N(#PEEK(#PC)).
 $8EC0 DEFB $30      ; Room #N(#PEEK(#PC)).
 $8EC1 DEFB $3B      ; Room #N(#PEEK(#PC)).
 $8EC2 DEFB $35      ; Room #N(#PEEK(#PC)).
 $8EC3 DEFB $36      ; Room #N(#PEEK(#PC)).

; Action: Inventory
;
; List the objects being carried.
@label=ActionInventory
c$8EC4 CALL $6972    ; {Return if the command names an object: the player is
 $8EC7 RET C         ; told to rephrase it.}
 $8EC8 CALL $64A5    ; Call #R$64A5 to clear the screen.
 $8ECB CALL $64C1    ; Call #R$64C1 to move the cursor to the stored row.
 $8ECE LD HL,$77EF   ; {Print #MESSAGE$77EF.
 $8ED1 CALL $64E9    ; }
 $8ED4 LD A,$01      ; Carried objects are stored in location #N$01.
 $8ED6 CALL $6763    ; Call #R$6763 to list the objects here.
 $8ED9 RET           ; Return.

; Action: Look
;
; Redraw the current location.
@label=Action_Look
c$8EDA CALL $6972    ; {Return if the command names an object: the player is
 $8EDD RET C         ; told to rephrase it.}
 $8EDE LD E,$01      ; Redraw the room and show its picture again.
 $8EE0 CALL $678A    ; Call #R$678A to display the room.
 $8EE3 RET           ; Return.

; Action: North
;
; Try to leave by the north exit.
@label=Action_North
c$8EE4 LD C,$00      ; {Try to leave to the north.
 $8EE6 JR $8EFA      ; }

; Action: South
;
; Try to leave by the south exit.
@label=Action_South
c$8EE8 LD C,$01      ; {Try to leave to the south.
 $8EEA JR $8EFA      ; }

; Action: East
;
; Try to leave by the east exit.
@label=Action_East
c$8EEC LD C,$02      ; {Try to leave to the east.
 $8EEE JR $8EFA      ; }

; Action: West
;
; Try to leave by the west exit.
@label=Action_West
c$8EF0 LD C,$03      ; {Try to leave to the west.
 $8EF2 JR $8EFA      ; }

; Action: Up
;
; Try to leave by the up exit.
@label=Action_Up
c$8EF4 LD C,$04      ; {Try to leave to the up.
 $8EF6 JR $8EFA      ; }

; Action: Down
;
; Move in the given direction, or report that there is no exit.
@label=ActionDown
c$8EF8 LD C,$05      ; Select the down exit.
; This entry point is used by the routines at #R$8EE4, #R$8EE8, #R$8EEC,
; #R$8EF0 and #R$8EF4.
@label=ActionDown_Step1
*$8EFA CALL $6972    ; {Return if the command names an object: the player is
 $8EFD RET C         ; told to rephrase it.}
 $8EFE LD B,$00      ; {Read the exit byte for the chosen direction.
 $8F00 CALL $6892    ;
 $8F03 ADD HL,BC     ;
 $8F04 LD A,(HL)     ; }
 $8F05 OR A          ; {That direction is closed when the exit byte is zero.
 $8F06 JR Z,$8F0C    ; }
 $8F08 CALL $8E18    ; Call #R$8E18 to move the player.
 $8F0B RET           ; Return.
@label=ActionDown_Step2
*$8F0C LD HL,$7831   ; {Print #MESSAGE$7831.
 $8F0F CALL $64E9    ; }
 $8F12 RET           ; Return.

; Action: Examine
;
; Describe the object named in the command.
@label=ActionExamine
c$8F13 CALL $697D    ; {Return if the command does not name an object. Jump to #R$8F27 when exactly
 $8F16 RET C         ; one noun was named.
 $8F17 CP $01        ;
 $8F19 JR Z,$8F27    ; }
 $8F1B LD HL,$78CA   ; {Print "#MESSAGE$78CA" and start a new line.
 $8F1E JR $8F23      ; }
@label=ActionExamine_Loop1
*$8F20 LD HL,$78BC   ; {Print "#MESSAGE$78BC" and start a new line.
@label=ActionExamine_Loop2
*$8F23 CALL $64E9    ; }
 $8F26 RET           ; Return.
@label=ActionExamine_Step1
*$8F27 LD HL,$8940   ; {Jump to #R$8F34 unless the command matches the phrase
 $8F2A CALL $6900    ; at #R$8940.
 $8F2D JR NZ,$8F34   ; }
 $8F2F LD HL,$78F5   ; {Print "#MESSAGE$78F5" and start a new line.
 $8F32 JR $8F23      ; }
@label=ActionExamine_Step2
*$8F34 LD HL,$8942   ; {Jump to #R$8F41 unless the command matches the phrase
 $8F37 CALL $6900    ; at #R$8942.
 $8F3A JR NZ,$8F41   ; }
 $8F3C LD HL,$7948   ; {Print "#MESSAGE$7948" and start a new line.
 $8F3F JR $8F23      ; }
@label=ActionExamine_Step3
*$8F41 LD HL,$8947   ; {Jump to #R$8F4E unless the command matches the phrase
 $8F44 CALL $6900    ; at #R$8947.
 $8F47 JR NZ,$8F4E   ; }
 $8F49 LD HL,$7975   ; {Print "#MESSAGE$7975" and start a new line.
 $8F4C JR $8F23      ; }
@label=ActionExamine_Step4
*$8F4E LD HL,$8949   ; {Jump to #R$8F62 unless the command matches the phrase at #R$8949
 $8F51 CALL $6900    ; (#MESSAGE$6FF9 (#N$38)).
 $8F54 JR NZ,$8F62   ;
 $8F56 LD A,$38      ;
 $8F58 CALL $68E0    ;
 $8F5B JR NZ,$8F62   ; }
 $8F5D LD HL,$79A3   ; {Print "#MESSAGE$79A3" and start a new line.
 $8F60 JR $8F23      ; }
@label=ActionExamine_Step5
*$8F62 LD HL,$8949   ; {Jump to #R$8F76 unless the command matches the phrase at #R$8949
 $8F65 CALL $6900    ; (#MESSAGE$6C3E (#N$19)).
 $8F68 JR NZ,$8F76   ;
 $8F6A LD A,$19      ;
 $8F6C CALL $68E0    ;
 $8F6F JR NZ,$8F76   ; }
 $8F71 LD HL,$7A42   ; {Print "#MESSAGE$7A42" and start a new line.
 $8F74 JR $8F23      ; }
@label=ActionExamine_Step6
*$8F76 LD HL,$894B   ; {Jump to #R$8F83 unless the command matches the phrase
 $8F79 CALL $6900    ; at #R$894B.
 $8F7C JR NZ,$8F83   ; }
 $8F7E LD HL,$79D1   ; {Print "#MESSAGE$79D1" and start a new line.
 $8F81 JR $8F23      ; }
@label=ActionExamine_Step7
*$8F83 LD HL,$8957   ; {Jump to #R$8F90 unless the command matches the phrase
 $8F86 CALL $6900    ; at #R$8957.
 $8F89 JR NZ,$8F90   ; }
 $8F8B LD HL,$79F0   ; {Print "#MESSAGE$79F0" and start a new line.
 $8F8E JR $8F23      ; }
@label=ActionExamine_Step8
*$8F90 LD HL,$896E   ; {Jump to #R$8F9E unless the command matches the phrase
 $8F93 CALL $6900    ; at #R$896E.
 $8F96 JR NZ,$8F9E   ; }
 $8F98 LD HL,$848D   ; {Print "#MESSAGE$848D" and start a new line.
 $8F9B JP $8F23      ; }
@label=ActionExamine_Step9
*$8F9E JP $8F20      ; Continue at #R$8F20 to say there is nothing worth a
                     ; closer look.

; Action: Load
;
; Load a saved position from tape.
@label=Action_Load
c$8FA1 CALL $6972    ; {Return if the command names an object: the player is
 $8FA4 RET C         ; told to rephrase it.}
 $8FA5 CALL $69DC    ; Call #R$69DC to load the game.
 $8FA8 RET           ; Return.

; Action: Save
;
; Used by the routine at #R$8FB1.
; .
; Save the current position to tape.
@label=Action_Save
c$8FA9 CALL $6972    ; {Return if the command names an object: the player is
 $8FAC RET C         ; told to rephrase it.}
 $8FAD CALL $69A1    ; Call #R$69A1 to save the game.
 $8FB0 RET           ; Return.

; Action: Quit
;
; Ask whether to save, then offer another game.
@label=ActionQuit
c$8FB1 CALL $6972    ; {Return if the command names an object: the player is
 $8FB4 RET C         ; told to rephrase it.}
 $8FB5 LD HL,$6410   ; {Print #MESSAGE$6410.
 $8FB8 CALL $64E9    ; }
@label=ActionQuit_Loop1
*$8FBB CALL $6495    ; Call #R$6495 to wait for a keypress.
 $8FBE CP $4E        ; {Jump to #R$8FC9 when N (#N$4E) was pressed.
 $8FC0 JR Z,$8FC9    ; }
 $8FC2 CP $59        ; {Jump back to #R$8FBB when Y (#N$59) was not pressed.
 $8FC4 JR NZ,$8FBB   ; }
 $8FC6 CALL $8FA9    ; Call #R$8FA9 to save.
@label=ActionQuit_Step1
*$8FC9 POP HL        ; The player is leaving this game.
 $8FCA JP $8DB9      ; Jump to #R$8DB9 to ask to play again.

; Action: Take
;
; Parse the named object and take it when the rules allow.
@label=ActionTake
c$8FCD LD HL,$8B58   ; {Jump to #R$9029 when the command matches the phrase at
 $8FD0 CALL $6900    ; #R$8B58.
 $8FD3 JR Z,$9029    ; }
 $8FD5 CALL $697D    ; {Return if the command does not name an object. Jump to #R$9029 when exactly
 $8FD8 RET C         ; one noun was named.
 $8FD9 CP $01        ;
 $8FDB JR Z,$9029    ; }
 $8FDD LD HL,$6445   ; {Print "#MESSAGE$6445" and start a new line.
 $8FE0 JR $9025      ; }
; This entry point is used by the routine at #R$9014.
@label=ActionTake_Step1
*$8FE2 CALL $6958    ; Call #R$6958 to test whether the object is carried.
 $8FE5 JR NZ,$9003   ; The named object is not being carried yet.
 $8FE7 POP HL        ; Drop the return address; the failure message replaces
                     ; it.
 $8FE8 LD HL,$7A1F   ; {Print #MESSAGE$7A1F on the same line.
 $8FEB CALL $64DC    ; }
@label=ActionTake_Step2
@nowarn
 $8FEE LD HL,$9010   ; The objects called "them" are listed at #R$9010.
 $8FF1 LD A,E        ; {See whether this object is spoken of as "them".
 $8FF2 LD BC,$0004   ; }
 $8FF5 CPIR          ; Search the list of objects that are called "them".
 $8FF7 JR Z,$8FFE    ; A plural object uses the wording for "them".
 $8FF9 LD HL,$7A38   ; {Print "#MESSAGE$7A38" and start a new line.
 $8FFC JR $9025      ; }
@label=ActionTake_Step3
*$8FFE LD HL,$7A3C   ; {Print "#MESSAGE$7A3C" and start a new line.
 $9001 JR $9025      ; }
@label=ActionTake_Step4
*$9003 LD A,($622C)  ; Fetch how many objects are being carried.
 $9006 CP $05        ; {Five objects is the most the player can carry.
 $9008 LD B,E        ; }
 $9009 RET NZ        ; Return so the object can be taken when five are not
                     ; already carried.
 $900A POP HL        ; Drop the return address; the player is already fully
                     ; laden.
 $900B LD HL,$7802   ; {Print "#MESSAGE$7802" and start a new line.
 $900E JR $9025      ; }

; Table: Plural Objects
;
; Object numbers that are referred to as "them".
@label=Table_PluralObjects
b$9010 DEFB $08      ; Object #N(#PEEK(#PC)).
 $9011 DEFB $0B      ; Object #N(#PEEK(#PC)).
 $9012 DEFB $0C      ; Object #N(#PEEK(#PC)).
 $9013 DEFB $39      ; Object #N(#PEEK(#PC)).

; Handler: Pick Up Object
;
; Mark the given object as carried and print the result.
@label=HandlerPickUpObject
c$9014 LD C,$01      ; {Call #R$65E6 to mark the object as carried.
 $9016 CALL $65E6    ; }
 $9019 LD HL,$622C   ; {The player is carrying one more object.
 $901C INC (HL)      ; }
 $901D LD HL,$6466   ; {Print "#MESSAGE$6466" and start a new line.
 $9020 JR $9025      ; }
@label=HandlerPickUpObject_Loop1
*$9022 LD HL,$645B   ; {Print "#MESSAGE$645B" and start a new line.
; This entry point is used by the routine at #R$8FCD.
@label=HandlerPickUpObject_Loop2
*$9025 CALL $64E9    ; }
 $9028 RET           ; Return.
; This entry point is used by the routine at #R$8FCD.
@label=HandlerPickUpObject_Step1
*$9029 LD HL,$8959   ; {Point at the phrase at #R$8959 and call #R$6900 to
 $902C CALL $6900    ; match it against the command.}
 $902F JR NZ,$9039   ; Jump to #R$9039 if it doesn't match.
 $9031 LD A,$00      ; {Take #MESSAGE$6A38 (#N$00).
 $9033 CALL $8FE2    ;
 $9036 JP $9014      ; }
@label=HandlerPickUpObject_Step2
*$9039 LD HL,$8969   ; {Point at the phrase at #R$8969 and call #R$6900 to
 $903C CALL $6900    ; match it against the command.}
 $903F JR NZ,$9049   ; Jump to #R$9049 if it doesn't match.
 $9041 LD A,$01      ; {Take #MESSAGE$6A41 (#N$01).
 $9043 CALL $8FE2    ;
 $9046 JP $9014      ; }
@label=HandlerPickUpObject_Step3
*$9049 LD HL,$8960   ; {Point at the phrase at #R$8960 and call #R$6900 to
 $904C CALL $6900    ; match it against the command.}
 $904F JR NZ,$9059   ; Jump to #R$9059 if it doesn't match.
 $9051 LD A,$02      ; {Take #MESSAGE$6A51 (#N$02).
 $9053 CALL $8FE2    ;
 $9056 JP $9014      ; }
@label=HandlerPickUpObject_Step4
*$9059 LD HL,$896E   ; {Point at the phrase at #R$896E and call #R$6900 to
 $905C CALL $6900    ; match it against the command.}
 $905F JR NZ,$9069   ; Jump to #R$9069 if it doesn't match.
 $9061 LD A,$03      ; {Take #MESSAGE$6A59 (#N$03).
 $9063 CALL $8FE2    ;
 $9066 JP $9014      ; }
@label=HandlerPickUpObject_Step5
*$9069 LD HL,$8940   ; {Point at the phrase at #R$8940 and call #R$6900 to
 $906C CALL $6900    ; match it against the command.}
 $906F JR NZ,$9079   ; Jump to #R$9079 if it doesn't match.
 $9071 LD A,$04      ; {Take #MESSAGE$6A68 (#N$04).
 $9073 CALL $8FE2    ;
 $9076 JP $9014      ; }
@label=HandlerPickUpObject_Step6
*$9079 LD HL,$8964   ; {Point at the phrase at #R$8964 and call #R$6900 to
 $907C CALL $6900    ; match it against the command.}
 $907F JR NZ,$9089   ; Jump to #R$9089 if it doesn't match.
 $9081 LD A,$05      ; {Take #MESSAGE$6A75 (#N$05).
 $9083 CALL $8FE2    ;
 $9086 JP $9014      ; }
@label=HandlerPickUpObject_Step7
*$9089 LD HL,$8973   ; {Jump to #R$90C6 unless the command matches the phrase at #R$8973
 $908C CALL $6900    ; (#MESSAGE$6A82 (#N$06)).
 $908F JR NZ,$90C6   ;
 $9091 LD A,$06      ;
 $9093 CALL $8FE2    ; }
 $9096 LD A,$06      ; {Jump to #R$90C3 when #MESSAGE$6A82 (#N$06) is here or being
 $9098 CALL $68E0    ; carried.
 $909B JR Z,$90C3    ; }
