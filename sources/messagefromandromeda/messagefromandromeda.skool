; Handler: Resolve Synonym
;
; Replace a synonym with the verb it stands for and run that verb.
@label=HandlerResolveSynonym
c$937B LD HL,$89A7   ; {Jump to #R$9392 unless the command matches the phrase
 $937E CALL $6900    ; at #R$89A7.
 $9381 JR NZ,$9392   ; }
 $9383 LD A,($6292)  ; Fetch the second word of the command.
 $9386 LD ($6291),A  ; The second word takes the place of the verb.
 $9389 LD A,$FF      ; {The second word becomes the verb, and nothing follows
 $938B LD ($6292),A  ; it.}
 $938E POP HL        ; The synonym has replaced the typed verb.
 $938F JP $8D85      ; Jump to #R$8D85 to match verb.
@label=HandlerResolveSynonym_Step1
*$9392 LD A,($6292)  ; Fetch the second word of the command.
 $9395 CP $FF        ; {Jump to #R$939D when the command has no second word
 $9397 JR Z,$939D    ; (#N$FF).}
 $9399 CALL $6479    ; Call #R$6479 to ask the player to rephrase the command.
 $939C RET           ; Return.
@label=HandlerResolveSynonym_Step2
*$939D CALL $6480    ; Call #R$6480 to say there is nothing there.
 $93A0 RET           ; Return.

