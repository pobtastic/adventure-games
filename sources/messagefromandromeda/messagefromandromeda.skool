; Handler: Room Image: In Deep Space
;
; Used by the routine at #R$678A through #R$FA68.
; .
; Draw the picture for In Deep Space.
@label=HandlerRoomImageInDeepSpace
c$F813 LD IX,$9ACD   ; Point at the picture of deep space.
 $F817 CALL $6541    ; Call #R$6541 to draw the room picture.
 $F81A RET           ; Return.

; Handler: Room Image: In Orbit Around an Unknown Planet
;
; Used by the routine at #R$678A through #R$FA68.
; .
; Draw the picture for In Orbit Around an Unknown Planet.
@label=HandlerRoomImageInOrbitAroundAnUnknownPlanet
c$F81B LD IX,$9F03   ; Point at the picture of the planet from orbit.
 $F81F CALL $6541    ; Call #R$6541 to draw the room picture.
 $F822 RET           ; Return.

; Handler: Room Image: The Landing Pad
;
; Used by the routine at #R$678A through #R$FA68.
; .
; Draw the picture for The Landing Pad.
@label=HandlerRoomImageTheLandingPad
c$F823 LD IX,$DA47   ; Point at the picture of the landing pad.
 $F827 CALL $6541    ; Call #R$6541 to draw the room picture.
 $F82A RET           ; Return.

; Handler: Room Image: The Yellow Room
;
; Used by the routine at #R$678A through #R$FA68.
; .
; Draw the picture for The Yellow Room.
@label=HandlerRoomImageTheYellowRoom
c$F82B LD IX,$E911   ; Point at the shared picture before tinting it yellow.
 $F82F CALL $6519    ; Call #R$6519 to expand the room picture.
 $F832 LD A,$30      ; Tint that picture yellow (#N$30).
 $F834 CALL $F85F    ; Call #R$F85F to recolour the picture.
 $F837 RET           ; Return.

; Handler: Room Image: The Green Room
;
; Used by the routine at #R$678A through #R$FA68.
; .
; Draw the picture for The Green Room.
@label=HandlerRoomImageTheGreenRoom
c$F838 LD IX,$E911   ; Point at the shared picture before tinting it green.
 $F83C CALL $6519    ; Call #R$6519 to expand the room picture.
 $F83F LD A,$20      ; Tint that picture green (#N$20).
 $F841 CALL $F85F    ; Call #R$F85F to recolour the picture.
 $F844 RET           ; Return.

; Handler: Room Image: The Blue Room
;
; Used by the routine at #R$678A through #R$FA68.
; .
; Draw the picture for The Blue Room.
@label=HandlerRoomImageTheBlueRoom
c$F845 LD IX,$E911   ; Point at the shared picture before tinting it cyan.
 $F849 CALL $6519    ; Call #R$6519 to expand the room picture.
 $F84C LD A,$28      ; Tint that picture cyan (#N$28), the colour the game
                     ; calls blue.
 $F84E CALL $F85F    ; Call #R$F85F to recolour the picture.
 $F851 RET           ; Return.

; Handler: Room Image: The Red Room
;
; Used by the routine at #R$678A through #R$FA68.
; .
; Draw the picture for The Red Room.
@label=HandlerRoomImageTheRedRoom
c$F852 LD IX,$E911   ; Point at the shared picture before tinting it red.
 $F856 CALL $6519    ; Call #R$6519 to expand the room picture.
 $F859 LD A,$50      ; Tint that picture red (#N$50).
 $F85B CALL $F85F    ; Call #R$F85F to recolour the picture.
 $F85E RET           ; Return.

; Recolour Room Image
;
; Used by the routines at #R$F82B, #R$F838, #R$F845 and #R$F852.
; .
; Paint the whole picture with the attribute in #REGa first
; (#R$6548), then blank the #N$47 attribute cells listed at #R$F785.
;
; I:A Attribute byte
@label=RecolourRoomImage
c$F85F CALL $6548    ; Call #R$6548 to paint every picture attribute with
                     ; #REGa.
 $F862 LD IX,$F785   ; {Point at #R$F785 and prepare to blank its
 $F866 LD B,$47      ; #N$47 attribute cells (black ink on black paper).
 $F868 XOR A         ; }
@label=RecolourRoomImage_Loop
*$F869 LD L,(IX+$00) ; {Blank every attribute address in that list.
 $F86C LD H,(IX+$01) ;
 $F86F LD (HL),A     ;
 $F870 INC IX        ;
 $F872 INC IX        ;
 $F874 DJNZ $F869    ; }
 $F876 RET           ; Return.

