;
; SkoolKit ref file for Message From Andromeda
;
; To build the HTML disassembly, run these commands:
;   tap2sna.py @messagefromandromeda.t2s
;   sna2skool.py -H -c sources/messagefromandromeda/messagefromandromeda.ctl MessageFromAndromeda.z80 > sources/messagefromandromeda/messagefromandromeda.skool
;   skool2html.py -H sources/messagefromandromeda/messagefromandromeda.skool -T dark -T wide -toOa

[Config]
Expand=#INCLUDE(Expand)
RefFiles=../analytics.ref;../bases.ref;changelog.ref;facts.ref;pokes.ref;locations.ref;solution.ref
HtmlWriterClass=sources:linking.AdventureGamesHtmlWriter
GameDir=adventure-games/messagefromandromeda

[skool2ctl]
ListRefs=2

[Game]
Game=Message From Andromeda
Logo=#SCR$02,$01,$07,$0A,$06,$4000,$5800{$08}(/images/logo)
Copyright=&copy; 1984 Interceptor Software UK<br />&copy; 2026 ArcadeGeek LTD.
Repository=https://github.com/pobtastic/adventure-games/tree/main/sources/messagefromandromeda/
Canonical=https://skoolkit.arcadegeek.co.uk/adventure-games/messagefromandromeda/
GameIndexUrl=https://skoolkit.arcadegeek.co.uk/adventure-games/messagefromandromeda/
OgImage=https://skoolkit.arcadegeek.co.uk/adventure-games/messagefromandromeda/images/logo.png
LinkInternalOperands=1
AddressAnchor={address#IF({base}==16)(:04x)}

[Titles]
GameStatusBuffer=Game Status Buffer

[Paths]
Locations=graphics/locations.html
Solution=reference/solution.html

[Page:Locations]
SectionPrefix=Location

[Page:Solution]
SectionPrefix=Solution

[PageHeaders]
GameIndex=The complete<>RAM disassembly (work in progress)

[Index:DataTables:Data Tables And Buffers]
GameStatusBuffer

[Index:Graphics:Graphics]
Locations

[Index:Reference:Reference]
Changelog
Facts
Pokes
Solution

[Expand]
#DEF(#PICTURE()(title,fname,attr=0)
  #PUSHS
  #UDGTABLE
  { =h $title }
  { #POKES$4000,0,$1B00#IF($attr)(#SIM(start=$6519,stop=$6534,ix=#PC)#SIM(start=$F85F,stop=$F876,a=$attr),#SIM(start=$6541,stop=$6547,ix=#PC))#SCR$02{$00,$00,$200,$100}($fname) }
  UDGTABLE#
  #POPS)

#DEF(#COLOUR(id)
  #LET(ink=$id&$07)#IF({ink}>=$00)(INK:
    #MAP({ink})(
      UNKNOWN,
      0:BLACK,
      1:BLUE,
      2:RED,
      3:MAGENTA,
      4:GREEN,
      5:CYAN,
      6:YELLOW,
      7:WHITE)),
  #LET(paper=$id>>$03&$07)#IF({paper}>=$00)(PAPER:
    #MAP({paper})(
      UNKNOWN,
      0:BLACK,
      1:BLUE,
      2:RED,
      3:MAGENTA,
      4:GREEN,
      5:CYAN,
      6:YELLOW,
      7:WHITE))
  #LET(bright=$id&$40)#IF({bright}>$00)((BRIGHT))
  #LET(flash=$id&$80)#IF({flash}>$00)(FLASH: ON))

#DEF(#INK(id)
  #LET(bright=$id&$40)
  #LET(flash=$id&$80)
  #LET(ink=$id&$07)#IF({ink}>=$00)(
    #MAP({ink})(
      UNKNOWN,
      0:BLACK,
      1:BLUE,
      2:RED,
      3:MAGENTA,
      4:GREEN,
      5:CYAN,
      6:YELLOW,
      7:WHITE))#IF({bright}>$00)( (BRIGHT))#IF({flash}>$00)( (FLASH: ON)))
