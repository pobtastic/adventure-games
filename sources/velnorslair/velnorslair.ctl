b $F09D BASIC Variables
@ $F09D label=BasicVariables
D $F09D The BASIC variables, from #SKOOLKID$5C4B(VARS) up to the #N($80) end
. marker. They hold the adventure state and text (object names such as "A
. SILK HANDKERCHIEF", room strings, and numeric arrays). There is no machine
. code here.
B $F09D,$0D40,$10
B $FDDD,$01 End marker.

b $FDDE Edit Line
@ $FDDE label=EditLine
D $FDDE #HTML(The current BASIC edit line, from #SKOOLKID$5C59(E_LINE) up to
. #SKOOLKID$5C61(WORKSP). Left over from the ROM <code>LOAD ""</code>.)
B $FDDE,$05

b $FDE3 Workspace
@ $FDE3 label=Workspace
D $FDE3 Bytes from #SKOOLKID$5C61(WORKSP) to #SKOOLKID$5C63(STKBOT), including
. the tape header name "VELNOR".
B $FDE3,$0022,$10

u $FE05 Unused
D $FE05 Free memory between #SKOOLKID$5C65(STKEND) and the machine stack. The
. first byte is not zero; the non-zero bytes near the top are left over from
. earlier stack use.
B $FE05,$01
S $FE06,$0112
B $FF18,$0038,$10

b $FF50 Machine Stack
@ $FF50 label=MachineStack
D $FF50 The machine stack and the GO SUB stack, from the stack pointer up to
. #SKOOLKID$5CB2(RAMTOP).
B $FF50,$08,$02

b $FF58 User-Defined Graphics
@ $FF58 label=UDG
D $FF58 #HTML(The default UDGs copied from the ROM. Line 6035 later overwrites
. the first #N($10) bytes with a short attribute-clear routine
. (<code>LD HL,$5800; LD BC,$0003; LD A,$38; LD (HL),A; INC HL; DJNZ; DEC C;
. JR NZ; RET</code>), and line 6330 calls it with
. <code>RANDOMIZE USR 65368</code>.)
B $FF58,$00A8,$08

