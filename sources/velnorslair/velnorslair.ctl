b $FDDE Edit Line
@ $FDDE label=EditLine
D $FDDE #HTML(The current BASIC edit line, from #SKOOLKID$5C59(E_LINE) up to
. #SKOOLKID$5C61(WORKSP). Left over from the ROM <code>LOAD ""</code>.)
B $FDDE,$05

b $FDE3 Workspace
@ $FDE3 label=Workspace
D $FDE3 Bytes from #SKOOLKID$5C61(WORKSP) to #SKOOLKID$5C63(STKBOT), including
. the tape header name "VELNOR".
B $FDE3,$0022,$10

u $FE05
  $FE05,$014B

b $FF50 Machine Stack
@ $FF50 label=MachineStack
D $FF50 The machine stack and the GO SUB stack, from the stack pointer up to
. #SKOOLKID$5CB2(RAMTOP).
B $FF50,$08,$02

b $FF58 User-Defined Graphics
@ $FF58 label=UDG
D $FF58 The default UDGs copied from the ROM (letters A-U), pointed to by
. #SKOOLKID$5C7B(UDG). #HTML(Line 6035 later overwrites the first
. #N($10) bytes with a short attribute-clear routine
. (<code>LD HL,$5800; LD BC,$0003; LD A,$38; LD (HL),A; INC HL; DJNZ;
. DEC C; JR NZ; RET</code>), and line 6330 calls it with
. <code>RANDOMIZE USR 65368</code>.)
N $FF58 UDG A (CHR$ #N$90). Line 6035 overwrites this glyph and UDG B
. with the attribute-clear routine.
  $FF58,$08 #UDG(#PC)
