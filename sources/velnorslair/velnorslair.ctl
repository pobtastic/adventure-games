  $5E27,$0D Line 108: GO SUB VAL "6300".
  $5E34,$31 Line 112: IF SCREEN$(A,O)=" " AND C THEN PRINT INK INT PI;AT A,INT
. PI;"SPELL STRENGTH ";M.
  $5E65,$25 Line 113: INPUT "WHAT WILL YOU DO NOW ? "' LINE I$: CLS.
  $5E8A,$0F Line 114: PRINT I$: PRINT AT TU,O.
  $5E99,$0D Line 115: FOR N=A TO LEN I$.
  $5EA6,$17 Line 120: IF I$(N)=" " THEN GO TO VAL "140".
  $5EBD,$0B Line 125: LET N$="".
  $5EC8,$16 Line 130: NEXT N: LET V$=I$: GO TO VAL "155".
  $5EDE,$11 Line 140: LET V$=I$( TO N-A).
  $5EEF,$11 Line 150: LET N$=I$(N+A TO ).
  $5F00,$0C Line 155: GO SUB VAL "180".
  $5F0C,$15 Line 160: IF NM AND NOT CH THEN GO SUB VAL "5700".
  $5F21,$10 Line 165: IF MOVE THEN GO TO CODE "d".
  $5F31,$0A Line 170: GO TO CODE "P".
  $5F3B,$40 Line 182: IF I$="RUN" THEN PRINT AT TU,O;"IN WHICH DIRECTION ?":
. INPUT "DIRECTION ? "; LINE V$.
  $5F7B,$1C Line 183: IF V$="RUN" THEN LET V$=N$: LET N$="".
  $5F97,$23 Line 185: LET MOVE=O: IF N$<>"" THEN GO SUB VAL "1E3": LET CH=O:
. RETURN.
  $5FBA,$1A Line 190: GO SUB CODE ">=": IF Z<>Z1 THEN GO SUB VAL "500": RETURN.
  $5FD4,$14 Line 195: LET CH=O: GO SUB VAL "250": RETURN.
  $5FE8,$22 Line 210: IF V$="N" OR V$="NORTH" THEN LET z=z1+CODE "_".
  $600A,$22 Line 220: IF V$="S" OR V$="SOUTH" THEN LET z=z1-CODE "_".
  $602C,$1F Line 230: IF V$="E" OR V$="EAST" THEN LET Z=Z1+FV.
  $604B,$1F Line 240: IF V$="W" OR V$="WEST" THEN LET Z=Z1-FV.
  $606A,$1C Line 243: IF V$="U" OR V$="UP" THEN GO SUB VAL "400".
  $6086,$1E Line 245: IF V$="D" OR V$="DOWN" THEN GO SUB VAL "420".
  $60A4,$06 Line 249: RETURN.
  $60AA,$17 Line 251: IF V$<>"SAVE" THEN GO TO VAL "255".
