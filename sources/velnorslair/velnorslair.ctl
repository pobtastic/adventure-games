  $616C,$2A Line 260: IF V$="F" OR V$="FIGHT" OR V$="KILL" THEN GO TO VAL
. "5500".
  $6196,$2E Line 270: IF V$="HELP" THEN PRINT "SORRY, I CAN'T HELP YOU."':
. RETURN.
  $61C4,$23 Line 280: IF LEN V$>TU THEN IF V$( TO INT PI)="INV" THEN GO TO VAL
