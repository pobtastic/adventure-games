  $61E7,$19 Line 300: IF V$="TIAMAT" THEN GO TO VAL "460".
  $6200,$13 Line 305: IF V$=X$ THEN GO TO VAL "380".
  $6213,$1C Line 310: IF V$="EXTENDERE" THEN GO TO VAL "480".
  $622F,$13 Line 312: LET V$=V$+"     ".
