; Is Player Carrying Item
;
; Used by the routines at #R$EFE8, #R$F001, #R$F027, #R$F058, #R$F075, #R$F08C,
; #R$F0A4, #R$F1CE, #R$F1FA, #R$F211, #R$F231, #R$F2C9, #R$F305, #R$F326,
; #R$F351, #R$F364, #R$F387, #R$F3A8, #R$F3D1, #R$F3FB, #R$F50D, #R$F528,
; #R$F5E6, #R$F611, #R$F6A3, #R$F6B6, #R$F6C9 and #R$F6EF.
; .
; Return if the item is held; otherwise tell the player they are not
; carrying it.
;
;   A Item ID
; O:F Z flag set if the item is in the players inventory
@label=IsPlayerCarryingItem
c$EB49 CALL $B5CF    ; Call #R$B5CF.
 $EB4C RET Z         ; Return if the item is in the players inventory.
 $EB4D POP HL        ; Restore #REGhl from the stack.
; Print "#MESSAGE$B191".
 $EB4E LD HL,$B191   ; #REGhl=#R$B191.
 $EB51 JP $EAFD      ; Jump to #R$EAFD.
; View the equivalent code in;
; #LIST
; { #WARLORD$EDD0 }
