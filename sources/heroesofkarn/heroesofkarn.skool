; View the equivalent code in;
; #LIST
; { #SHOCK$9F88 }
; { #FOREST$B9C8 }
; { #JEWELS$BBF0 }
; { #ANDROMEDA$61AB }
; { #WARLORD$A66C }
; LIST#

; Unused
u$ADFD DEFS $79

; Flags: Room Change
;
; One byte of once-only and room-change flags. Bits #N$00 and #N$01
; are tested when entering or leaving #ROOM$37, but the shipped game never
; sets them. Bit #N$03 is tested after taking the copper key, but is never
; set.
; #TABLE(default,centre)
; { =h Bit | =h Relating To }
; { #N$00 | Enter #ROOM$37 without dying }
; { #N$01 | Skip the phoenix transformation }
; { #N$02 | #R$EC04(Revealing the jewelled key under the carpet) }
; { #N$03 | Awarding points for the copper key }
; { #N$04 | #R$EC6C(Awarding points for the gold key) }
; { #N$05 | #R$ECC0(Awarding points for the jewelled key) }
; { #N$06 | Unused }
; { #N$07 | Unused }
; TABLE#
@label=Flags_RoomChange
g$AE76 DEFB $00

; Flag: Beach Dug
;
; Bit 0 is set once the player has dug on the beach in room #N$3C.
@label=Flag_BeachDug
g$AE77 DEFB $00

; Flag: Turn Scratch
;
; Cleared at the start of every pass round the game loop.
@label=Flag_TurnScratch
g$AE78 DEFB $00

; Room: Pour Return
;
; Holds the room ID to restore after pouring.
@label=Room_PourReturn
g$AE79 DEFB $00

; Unused
u$AE7A DEFS $04

; Table: Already Seen Room Images
;
; Corresponds to whether the player has already seen the image for
; the following rooms:
; .
; #TABLE(default,centre,centre)
; { =h Bit | =h Room ID | =h Room Name }
; #FOR$FDFF,$FE06,,1(n,{ #N(n-$FDFF) | #N(#PEEKn) | #ROOM(#PEEKn) })
; TABLE#
; #TABLE(default,centre,centre)
; { =h Bit | =h Room ID | =h Room Name }
; #FOR$FE07,$FE08,,1(n,{ #N(n-$FE07) | #N(#PEEKn) | #ROOM(#PEEKn) })
; #FOR$02,$07,,1(n,{ #Nn | N/A | N/A })
; TABLE#
; .
; #R$B41F tests and sets the bit for the current room. The bit
; number is the room's place in #R$FDFF.
@label=Table_RoomImagesAlreadySeen
g$AE7E DEFB %00000000
 $AE7F DEFB %00000000

; Unused
u$AE80 DEFS $08

; Flags: Turn-Based Event States
;
; Holds a single byte, where each bit relates to a turn-based event.
; #R$B373 decrements the matching counter in #R$AE89 and, when a counter
; reaches zero, would call through #R$AED2. The shipped image leaves
; #R$AED2 as #N$00 and never sets these bits.
@label=Flag_TurnBasedEventState
g$AE88 DEFB $00

; Turn-Based Event Counters
;
; One countdown per bit of *#R$AE88. #R$B373 decrements a set
; counter each turn. The shipped image never arms any of them.
;
; .
;
; Unused.
@label=Counter_Unused_0
g$AE89 DEFB $00
; Unused.
@label=Counter_Unused_1
 $AE8A DEFB $00
; Unused.
@label=Counter_Unused_2
 $AE8B DEFB $00
; Unused.
@label=Counter_Unused_3
 $AE8C DEFB $00
; Unused.
@label=Counter_Unused_4
 $AE8D DEFB $00
; Unused.
@label=Counter_Unused_5
 $AE8E DEFB $00
; Unused.
@label=Counter_Unused_6
 $AE8F DEFB $00
; Unused.
@label=Counter_Unused_7
 $AE90 DEFB $00

; Flag: Following Heroes
;
; Each set bit makes the matching item in #R$AE92 follow the player
; when the room changes (#R$B714). Bits 0-3 default to #ITEM$00 (Beren),
; #ITEM$01 (Istar), #ITEM$02 (Haldir) and #ITEM$03 (Khadim). Bits 4-7 are
; never set. #R$E9E1 also reads this byte when checking the ruined cottage.
@label=Flag_FollowingHeroes
g$AE91 DEFB $00

; Table: Following Items
;
; Each bit of *#R$AE91 makes the item at the same position here follow
; the player when the room changes.
@label=Table_FollowingItems
g$AE92 DEFB $00             ; Bit 0: item #N(#PEEK(#PC)), #ITEM(#PEEK(#PC)).
 $AE93 DEFB $01             ; Bit 1: item #N(#PEEK(#PC)), #ITEM(#PEEK(#PC)).
 $AE94 DEFB $02             ; Bit 2: item #N(#PEEK(#PC)), #ITEM(#PEEK(#PC)).
 $AE95 DEFB $03             ; Bit 3: item #N(#PEEK(#PC)), #ITEM(#PEEK(#PC)).
 $AE96 DEFB $00,$00,$00,$00 ; Bits 4-7: not used by this game.

; Number Of Items In The Players Inventory
;
; The number of items the player is currently holding.
@label=Count_InventoryItems
g$AE9A DEFB $00

; Load/ Save Buffer
;
; Save Game copies the configurable-exit bytes here before writing
; the tape block. The buffer is #N$32 bytes, ending at the current room.
@label=LoadSaveBuffer
g$AE9B DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AEA3 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AEAB DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AEB3 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AEBB DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AEC3 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AECB DEFB $00,$00

