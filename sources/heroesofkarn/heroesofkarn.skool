; Game Start
;
; Used by the routine at #R$E99E.
; .
; Copy the default state into working memory, open the starting exits, and
; enter the game loop.
@label=GameStart
c$FBA9 LD HL,$FBDC   ; {Copy #N$0186 bytes from #R$FBDC to #R$AD76.
 $FBAC LD DE,$AD76   ;
 $FBAF LD BC,$0186   ;
 $FBB2 LDIR          ; }
; Remove a bunch of room exits (as actions in the game will open them
; back up).
 $FBB4 LD IX,$E972   ; Point #REGix at #R$E972.
 $FBB8 LD A,($AEFA)  ; {Count the configurable exits to close.
 $FBBB LD B,A        ; }
 $FBBC XOR A         ; Set #REGa to #N$00 which "removes" the exit.
@label=GameStart_Loop
*$FBBD LD L,(IX+$00) ; {Close this configurable exit.
 $FBC0 LD H,(IX+$01) ;
 $FBC3 LD (HL),A     ;
 $FBC4 INC IX        ;
 $FBC6 INC IX        ;
 $FBC8 DJNZ $FBBD    ; }
 $FBCA LD A,$24      ; {Open the east exit from the Hall of Infinity into the Lair of the
 $FBCC LD ($E8BA),A  ; Hydra.}
 $FBCF LD A,$3F      ; {Open the south exit from the Hall of the Phoenix into the Hall of
 $FBD1 LD ($E931),A  ; Black Magic.}
 $FBD4 LD A,$03      ; {Begin in the Field.
 $FBD6 CALL $E9E1    ; }
 $FBD9 JP $E9A1      ; Continue at #R$E9A1.
; View the equivalent code in;
; #LIST
; { #SHOCK$ADA1 }
; { #FOREST$F964 }
; { #JEWELS$FD82 }
; { #ANDROMEDA$F8AF }
; { #WARLORD$FCCE }
; LIST#

