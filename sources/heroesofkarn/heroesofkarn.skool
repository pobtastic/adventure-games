; Response: "You Have Nothing To Dig With."
;
; Used by the routine at #R$FAC8.
; .
; Tell the player "You Have Nothing To Dig With."
;
; .
;
; Print it as the reply: #MESSAGE$DE58.
@label=Messaging_YouHaveNothingToDigWith_Reply
c$F537 LD HL,$DE58   ; {Point at the message and print it as the reply.
 $F53A JP $EA9E      ; }

; Response: "You Find Nothing."
;
; Used by the routine at #R$FAC8.
; .
; Tell the player "You Find Nothing."
@label=Response_YouFindNothing
c$F53D CALL $EAE8    ; Call #R$EAE8 to tell the player that worked.
; Print it as the reply: #MESSAGE$DE76.
 $F540 LD HL,$DE76   ; {Point at the message and print it as the reply.
 $F543 JP $EA9E      ; }

; Response: "He's not keen on the idea."
;
; Tell the player "He's not keen on the idea."
@label=Response_NotKeen
c$F546 LD HL,$DEC1   ; {Print "#MESSAGE$DEC1" as the reply.
 $F549 JP $EA9E      ; }

; Handler: Shift Input Tokens
;
; Used by the routine at #R$FB3A.
; .
; Slide the word tokens down one place so the verb is dropped.
@label=Handler_ShiftInputTokens
c$F54C LD HL,$AF2F   ; Point #REGhl at the second word token.
 $F54F LD DE,$AF2E   ; {Slide the word tokens down one place and mark the last
 $F552 LD BC,$0009   ; slot empty.
 $F555 LDIR          ;
 $F557 LD A,$FF      ;
 $F559 LD ($AF37),A  ; }
 $F55C RET           ; Return.

