; Handler: The Treasury
;
; Show the picture for the Treasury.
@label=HandlerTheTreasury
c$FDD5 LD IX,$9B96   ; Point at the picture of the Treasury.
 $FDD9 JR $FDDF      ; Rejoin the shared picture display at #R$FDDF.

; Handler: The Edge Of The Sea
;
; Show the picture for the Edge Of The Sea.
@label=HandlerTheEdgeOfTheSea
c$FDDB LD IX,$A351   ; Point at the picture of the Edge of the Sea.
; This entry point is used by the routines at #R$FDAB, #R$FDB1, #R$FDB7,
; #R$FDBD, #R$FDC3, #R$FDC9, #R$FDCF and #R$FDD5.
@label=Handler_ShowPicture
*$FDDF CALL $AD60    ; Call #R$AD60 to draw the room picture.
 $FDE2 LD A,$08      ; {Call #R$B516 to print the room description.
 $FDE4 CALL $B516    ; }
 $FDE7 CALL $ABE1    ; Call #R$ABE1 to read the player's key.
 $FDEA RET           ; Return.

