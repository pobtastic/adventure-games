; Take: Carpet
;
; Take the carpet and reveal the jewelled key the first time.
@label=Take_Carpet
c$EC04 LD A,$27      ; {Call #R$EAF4 with item #N$27: #ITEM$27.
 $EC06 CALL $EAF4    ; }
 $EC09 CALL $EB25    ; Call #R$EB25.
 $EC0C LD HL,$AE76   ; {Return if bit 2 of *#R$AE76 is set, which relates to revealing
 $EC0F BIT 2,(HL)    ; the jewelled key.
 $EC11 RET NZ        ; }
 $EC12 SET 2,(HL)    ; Set bit 2 of *#R$AE76 to signify that the jewelled key has been
                     ; revealed.
 $EC14 LD A,$28      ; {Call #R$B5DC with item #N$28: #ITEM$28.
 $EC16 CALL $B5DC    ; }
; Print "#MESSAGE$D2A7".
 $EC19 LD HL,$D2A7   ; #REGhl=#R$D2A7.
 $EC1C JP $EA9E      ; Jump to #R$EA9E.

; Take: Key
;
; Take the key that is here, or ask the player to be more specific.
@label=Take_Key
c$EC1F LD HL,$E51D   ; #REGhl=#R$E51D.
 $EC22 CALL $B606    ; Call #R$B606.
 $EC25 CP $02        ; {Jump to #R$ECF4 if more than one key is present.
 $EC27 JP NC,$ECF4   ; }
 $EC2A LD HL,$E51D   ; #REGhl=#R$E51D.
 $EC2D CALL $B5EC    ; Call #R$B5EC.
 $EC30 CP $28        ; {Jump to #R$ECC0 if the key is #ITEM$28.
 $EC32 JP Z,$ECC0    ; }
 $EC35 CP $47        ; {Jump to #R$EC6C if the key is #ITEM$47.
 $EC37 JP Z,$EC6C    ; }
; Continue on to #R$EC3A.

; Take: Copper Key
;
; Take the copper key and open the copper gates.
@label=Take_CopperKey
c$EC3A LD A,$6C      ; {Call #R$B560 with item #N$6C: #ITEM$6C.
 $EC3C CALL $B560    ; }
 $EC3F JP NZ,$F589   ; Jump to #R$F589 if #ITEM$6C is not present.
 $EC42 LD A,$6C      ; {Call #R$EAF4 with item #N$6C: #ITEM$6C.
 $EC44 CALL $EAF4    ; }
 $EC47 CALL $EB25    ; Call #R$EB25.
; This action changes the map:
 $EC4A LD A,$11      ; {Write #N$11 to open southbound access to #ROOM$11 from
 $EC4C LD ($E81D),A  ; #ROOM$09.}
 $EC4F LD A,$09      ; {Write #N$09 to open northbound access to #ROOM$09 from
 $EC51 LD ($E84C),A  ; #ROOM$11.}
 $EC54 LD BC,$0B0A   ; {Call #R$B613 to transform #ITEM$0B into #ITEM$0A.
 $EC57 CALL $B613    ; }
 $EC5A LD BC,$0E0D   ; {Call #R$B613 to transform #ITEM$0E into #ITEM$0D.
 $EC5D CALL $B613    ; }
 $EC60 LD HL,$AE76   ; {Return if bit 3 of *#R$AE76 is set, which relates to taking the
 $EC63 BIT 3,(HL)    ; copper key.
 $EC65 RET NZ        ; }
 $EC66 LD A,$02      ; {Call #R$B78F with #N$02.
 $EC68 CALL $B78F    ; }
 $EC6B RET           ; Return.

; Take: Gold Key
;
; Used by the routine at #R$EC1F.
; .
; Take the gold key and open the golden gates.
@label=Take_GoldKey
c$EC6C LD A,$47      ; {Call #R$B560 with item #N$47: #ITEM$47.
 $EC6E CALL $B560    ; }
 $EC71 JP NZ,$F589   ; Jump to #R$F589 if #ITEM$47 is not present.
 $EC74 LD A,$47      ; {Call #R$EAF4 with item #N$47: #ITEM$47.
 $EC76 CALL $EAF4    ; }
 $EC79 CALL $EB25    ; Call #R$EB25.
; This action changes the map:
 $EC7C LD A,$16      ; {Write #N$16 to open northbound access to #ROOM$16 from
 $EC7E LD ($E89A),A  ; #ROOM$1E.}
 $EC81 LD A,$1E      ; {Write #N$1E to open southbound access to #ROOM$1E from
 $EC83 LD ($E86B),A  ; #ROOM$16.}
 $EC86 LD A,$2D      ; {Write #N$2D to open northbound access to #ROOM$2D from
 $EC88 LD ($E924),A  ; #ROOM$35.}
 $EC8B LD A,$35      ; {Write #N$35 to open southbound access to #ROOM$35 from
 $EC8D LD ($E8F5),A  ; #ROOM$2D.}
 $EC90 LD BC,$1716   ; {Call #R$B613 to transform #ITEM$17 into #ITEM$16.
 $EC93 CALL $B613    ; }
 $EC96 LD BC,$1A19   ; {Call #R$B613 to transform #ITEM$1A into #ITEM$19.
 $EC99 CALL $B613    ; }
 $EC9C LD BC,$1D1C   ; {Call #R$B613 to transform #ITEM$1D into #ITEM$1C.
 $EC9F CALL $B613    ; }
 $ECA2 LD BC,$201F   ; {Call #R$B613 to transform #ITEM$20 into #ITEM$1F.
 $ECA5 CALL $B613    ; }
 $ECA8 LD HL,$AE76   ; {Return if bit 4 of *#R$AE76 is set, which relates to taking the
 $ECAB BIT 4,(HL)    ; gold key.
 $ECAD RET NZ        ; }
 $ECAE SET 4,(HL)    ; Set bit 4 of *#R$AE76 to signify that the gold key has
                     ; been taken.
 $ECB0 LD A,$02      ; {Call #R$B78F with #N$02.
 $ECB2 CALL $B78F    ; }
 $ECB5 LD A,($AECD)  ; {Return if *#R$AECD is not room #N$23: "#ROOM$23".
 $ECB8 CP $23        ;
 $ECBA RET NZ        ; }
 $ECBB XOR A         ; {Write #N$00 to close the eastbound exit from #ROOM$23.
 $ECBC LD ($E8BA),A  ; }
 $ECBF RET           ; Return.

; Take: Jewelled Key
;
; Used by the routine at #R$EC1F.
; .
; Take the jewelled key and open the jewelled gates.
@label=Take_JewelledKey
c$ECC0 LD A,$28      ; {Call #R$B560 with item #N$28: #ITEM$28.
 $ECC2 CALL $B560    ; }
 $ECC5 JP NZ,$F589   ; Jump to #R$F589 if #ITEM$28 is not present.
 $ECC8 LD A,$28      ; {Call #R$EAF4 with item #N$28: #ITEM$28.
 $ECCA CALL $EAF4    ; }
 $ECCD CALL $EB25    ; Call #R$EB25.
; This action changes the map:
 $ECD0 LD A,$14      ; {Write #N$14 to open westbound access to #ROOM$14 from
 $ECD2 LD ($E867),A  ; #ROOM$15.}
 $ECD5 LD A,$15      ; {Write #N$15 to open eastbound access to #ROOM$15 from
 $ECD7 LD ($E860),A  ; #ROOM$14.}
 $ECDA LD BC,$1110   ; {Call #R$B613 to transform #ITEM$11 into #ITEM$10.
 $ECDD CALL $B613    ; }
 $ECE0 LD BC,$1413   ; {Call #R$B613 to transform #ITEM$14 into #ITEM$13.
 $ECE3 CALL $B613    ; }
 $ECE6 LD HL,$AE76   ; {Return if bit 5 of *#R$AE76 is set, which relates to taking the
 $ECE9 BIT 5,(HL)    ; jewelled key.
 $ECEB RET NZ        ; }
 $ECEC SET 5,(HL)    ; Set bit 5 of *#R$AE76 to signify that the jewelled key has been
                     ; taken.
 $ECEE LD A,$02      ; {Call #R$B78F with #N$02.
 $ECF0 CALL $B78F    ; }
 $ECF3 RET           ; Return.

