; Handler: Room Images
;
; Show the picture for the Field.
;
; .
;
; Displays the image for the field.
; .
; #PUSHS #UDGTABLE #POKES$AECD,$03
; { #SIM(start=#PC,stop=$FDE2)#SCR$01(game-the-field) }
; UDGTABLE# #POPS
@label=DisplayImage_Field
c$FDAB LD IX,$61A8   ; #REGix=#R$61A8.
 $FDAF JR $FDDF      ; Jump to #R$FDDF.
; Displays the image for the monastery.
; .
; #PUSHS #UDGTABLE #POKES$AECD,$0E
; { #SIM(start=#PC,stop=$FDE2)#SCR$01(game-the-monastery) }
; UDGTABLE# #POPS
@label=DisplayImage_Monastery
 $FDB1 LD IX,$6B37   ; #REGix=#R$6B37.
 $FDB5 JR $FDDF      ; Jump to #R$FDDF.
; Displays the image for the king's chamber.
; .
; #PUSHS #UDGTABLE #POKES$AECD,$1C
; { #SIM(start=#PC,stop=$FDE2)#SCR$01(game-the-kings-chamber) }
; UDGTABLE# #POPS
@label=DisplayImage_KingsChamber
 $FDB7 LD IX,$7313   ; #REGix=#R$7313.
 $FDBB JR $FDDF      ; Jump to #R$FDDF.
; Displays the image for the oil room and the acid room.
; .
; #PUSHS #UDGTABLE #POKES$AECD,$27
; { #SIM(start=#PC,stop=$FDE2)#SCR$01(game-the-oil-room) }
; UDGTABLE# #POPS
@label=DisplayImage_OilRoom
 $FDBD LD IX,$79F4   ; #REGix=#R$79F4.
 $FDC1 JR $FDDF      ; Jump to #R$FDDF.
; Displays the image for the sea cavern.
; .
