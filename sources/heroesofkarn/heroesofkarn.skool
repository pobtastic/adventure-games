 $EB79 CALL $B560    ; }
 $EB7C JR NZ,$EB89   ; Jump to #R$EB89 if #ITEM$83 is not present.
 $EB7E LD BC,$8332   ; {Call #R$B613 to transform #ITEM$83 into #ITEM$32.
 $EB81 CALL $B613    ; }
 $EB84 LD B,$58      ; {Jump to #R$EB25 with item #N$58: #ITEM$58.
 $EB86 JP $EB25      ; }
