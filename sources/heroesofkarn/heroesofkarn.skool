; Jump to Game Start
;
; Used by the routine at #R$B800.
; .
; Game Cold Start lands here and jumps on to Game Start.
@label=Jump_GameStart
c$E99E JP $FBA9      ; Continue at #R$FBA9.

; Game Loop
;
; Used by the routine at #R$FBA9.
; .
; One turn: run events, read a command, and dispatch its verb.
@label=GameLoop
c$E9A1 CALL $B373    ; Call #R$B373 to advance the turn-based events.
 $E9A4 XOR A         ; {Clear the turn scratch flag (#N$08 marks an attack).
 $E9A5 LD ($AE78),A  ; }
 $E9A8 CALL $B200    ; Call #R$B200 to read the next command.
 $E9AB CALL $B6BC    ; Call #R$B6BC to apply the command to the item.
 $E9AE JR C,$E9A1    ; Start the next turn without running the verb if a named
                     ; item isn't here (carry set by #R$B6BC).
 $E9B0 CALL $B753    ; Call #R$B753 to run the verb.
 $E9B3 JR $E9A1      ; Take another turn at #R$E9A1.

; Messaging: "You are dead."
;
; Print "You are dead." and fall into the play-again question.
;
; .
;
; Print it and start a new line: #MESSAGE$AFF9.
@label=Messaging_YouAreDead_Continue
c$E9B5 LD HL,$AFF9   ; {Point at the message and print it and start a new line.
 $E9B8 CALL $AC35    ; }

; Handler: Ask To Play Again
;
; Used by the routine at #R$E9D3.
; .
; Ask To Play Again.
@label=HandlerAskToPlayAgain
c$E9BB CALL $B79E    ; Call #R$B79E to tell the player the score.
; Print it and start a new line: #MESSAGE$B007.
 $E9BE LD HL,$B007   ; {Point at the message and print it and start a new line.
 $E9C1 CALL $AC35    ; }
@label=HandlerAskToPlayAgain_Loop
*$E9C4 CALL $ABE1    ; Call #R$ABE1 to read the player's key.
 $E9C7 CP $4E        ; {Branch to #SKOOLKID$0000(START) when the player pressed
 $E9C9 JP Z,$0000    ; "N".}
 $E9CC CP $59        ; {Branch to #R$ABD4 when the player pressed "Y".
 $E9CE JP Z,$ABD4    ; }
 $E9D1 JR $E9C4      ; Ask again at #R$E9C4 when the key is neither Y nor N.

; Game Complete
;
; Used by the routine at #R$E9E1.
; .
; Announce that the quest is over and offer another game.
@label=GameComplete
c$E9D3 CALL $ABF1    ; Call #R$ABF1 to clear the screen.
 $E9D6 CALL $AC0D    ; Call #R$AC0D to park the cursor on the current screen
                     ; line.
 $E9D9 LD HL,$CF7A   ; {Call #R$AC35 to print the string and start a new line.
 $E9DC CALL $AC35    ; }
 $E9DF JR $E9BB      ; Offer another game at #R$E9BB.

; Handler: Change Room
;
; Used by the routines at #R$EA75, #R$F7F8, #R$FB67 and #R$FBA9.
; .
; Change room, with the special cases for the gates and the cottage.
@label=Handler_ChangeRoom
c$E9E1 CP $37        ; {See whether the player is moving into the Hall of the
 $E9E3 JR NZ,$E9F8   ; Phoenix.}
 $E9E5 LD HL,$AE76   ; Point #REGhl at the room-change flags.
 $E9E8 BIT 0,(HL)    ; See whether the Hall of the Phoenix is safe to enter.
 $E9EA JR NZ,$E9F8   ; Jump to #R$E9F8 if the zero flag is clear.
 $E9EC POP HL        ; {Return via the "You are dead." message.
 $E9ED LD HL,$E9B5   ;
 $E9F0 EX (SP),HL    ; }
 $E9F1 LD HL,$D04C   ; {Print "#MESSAGE$D04C" and start a new line.
 $E9F4 CALL $AC35    ; }
 $E9F7 RET           ; Return.
*$E9F8 LD C,A        ; Remember the room being moved to.
 $E9F9 LD A,($AECD)  ; Read the current room into #REGa.
 $E9FC CP $37        ; {See whether the player is leaving the Hall of the
 $E9FE JR NZ,$EA36   ; Phoenix.}
 $EA00 LD HL,$AE76   ; Point #REGhl at the room-change flags.
 $EA03 BIT 1,(HL)    ; See whether the ashes have already become a phoenix.
 $EA05 JR NZ,$EA36   ; Jump to #R$EA36 if the zero flag is clear.
 $EA07 LD A,$3F      ; {See whether the move is into the Hall of Black Magic.
 $EA09 CP C          ;
 $EA0A JR NZ,$EA23   ; }
 $EA0C LD BC,$8182   ; {Turn the hot ashes into a phoenix.
 $EA0F CALL $B613    ; }
 $EA12 XOR A         ; {Close the south exit from the Hall of the Phoenix.
 $EA13 LD ($E931),A  ; }
@label=Handler_ChangeRoom_AshesBurst
 $EA16 LD HL,$D087   ; {Print "#MESSAGE$D087" and start a new line.
 $EA19 CALL $AC35    ; }
@label=Handler_ChangeRoom_PhoenixAppears
 $EA1C LD HL,$D0B0   ; {Pause, print "#MESSAGE$D0B0" and scroll.
 $EA1F CALL $B776    ; }
 $EA22 RET           ; Return.
*$EA23 LD A,C        ; Take the destination room.
 $EA24 PUSH AF       ; Remember the destination room.
 $EA25 LD A,$82      ; {Remove the phoenix.
 $EA27 CALL $B5D5    ; }
 $EA2A LD A,$81      ; {Leave the hot ashes in this room.
 $EA2C CALL $B5DC    ; }
 $EA2F LD A,$3F      ; {Open the south exit from the Hall of the Phoenix into
 $EA31 LD ($E931),A  ; the Hall of Black Magic.}
 $EA34 POP AF        ; Restore the destination room from the stack.
 $EA35 LD C,A        ; Put the destination room back.
*$EA36 LD A,C        ; Hand the destination room to the move.
 $EA37 CALL $B714    ; Call #R$B714 to move the player into the room.
 $EA3A LD A,($AECD)  ; Read the current room into #REGa.
 $EA3D CP $02        ; {See whether the player is inside the ruined cottage.
 $EA3F JR NZ,$EA75   ; }
 $EA41 LD A,($AE91)  ; Read the event-state flags into #REGa.
 $EA44 CP $0F        ; {See whether the cottage tasks are finished.
 $EA46 JR NZ,$EA75   ; }
 $EA48 LD HL,$EA70   ; {Count how many of the five gems are here.
 $EA4B LD B,$05      ;
 $EA4D LD C,$00      ; }
@label=Cottage_CountGem
*$EA4F LD A,(HL)     ; Read the next gem.
 $EA50 CALL $B560    ; Call #R$B560 to find where the object is.
 $EA53 JR NZ,$EA56   ; Jump to #R$EA56 if the zero flag is clear.
 $EA55 INC C         ; Count a gem that is here.
*$EA56 INC HL        ; Move on to the next gem.
 $EA57 DJNZ $EA4F    ; Step down #REGb by one and jump to #R$EA4F until it is
                     ; zero.
 $EA59 LD A,$05      ; {See whether all five gems are here.
 $EA5B CP C          ;
 $EA5C JR NZ,$EA75   ; }
 $EA5E LD HL,$E504   ; {Check the list of treasures at #N$E504.
 $EA61 CALL $B5EC    ; }
 $EA64 JR NZ,$EA75   ; Jump to #R$EA75 if none of the items listed at #N$E504
                     ; is here or carried.
 $EA66 POP HL        ; {Restore #REGhl, #REGhl from the stack.
 $EA67 POP HL        ; }
 $EA68 LD A,$04      ; {Score four points and finish the game.
 $EA6A CALL $B78F    ;
 $EA6D JP $E9D3      ; }

; Table: Gems
;
; The ruby, diamond, sapphire, emerald and pearl counted in the cottage.
@label=Table_Gems
b$EA70 DEFB $4A      ; Item #N(#PEEK(#PC)).
 $EA71 DEFB $4D      ; Item #N(#PEEK(#PC)).
 $EA72 DEFB $5C      ; Item #N(#PEEK(#PC)).
 $EA73 DEFB $72      ; Item #N(#PEEK(#PC)).
 $EA74 DEFB $75      ; Item #N(#PEEK(#PC)).

; Handler: Show The New Room
;
; Used by the routine at #R$E9E1.
; .
; Draw the new room after a move.
@label=Handler_ShowNewRoom
c$EA75 LD E,$00      ; {Call #R$B41F to show the room picture.
 $EA77 CALL $B41F    ; }
 $EA7A LD A,$84      ; {Call #R$B560 to find where the object is.
 $EA7C CALL $B560    ; }
 $EA7F JR NZ,$EA9C   ; Skip the guard when he is not here.
 $EA81 LD A,$84      ; {Call #R$B5D5 to remove the item.
 $EA83 CALL $B5D5    ; }
; Pause, print it and scroll: #MESSAGE$D154.
 $EA86 LD HL,$D154   ; {Point at the message and pause, print it and scroll.
 $EA89 CALL $B776    ; }
; Pause, print it and scroll: #MESSAGE$D168.
 $EA8C LD HL,$D168   ; {Point at the message and pause, print it and scroll.
 $EA8F CALL $B776    ; }
 $EA92 LD B,$64      ; {Call #R$AC65 to pause for the frame count in #REGb.
 $EA94 CALL $AC65    ; }
 $EA97 LD A,$3A      ; {Take the player to the Dungeon.
 $EA99 JP $E9E1      ; }
@label=Handler_ShowNewRoom_Next
*$EA9C RET           ; Return.

; Data
@label=Item_JadeFragments
b$EA9D DEFB $59

; Print Response
;
; Used by the routines at #R$EAA6, #R$EAAC, #R$EAB2, #R$EAB8, #R$EABE, #R$EADC,
; #R$EAE2, #R$EAE8, #R$EAFA, #R$EB8F, #R$ED2B, #R$EE63, #R$EFE2, #R$F09E,
; #R$F205, #R$F537, #R$F53D, #R$F546, #R$F715, #R$FAC8 and #R$FAF9.
; .
; Print the message at #REGhl and return to the command.
@label=PrintResponse
c$EA9E CALL $AC35    ; Call #R$AC35 to print the string and start a new line.
 $EAA1 RET           ; Return.

; Pause, Print String And Scroll
;
; Pause, print the string at #REGhl, and scroll. The phrase handlers
; call this entry.
@label=PausePrintAndScroll
c$EAA2 CALL $B776    ; Call #R$B776 to pause, print the string and scroll.
 $EAA5 RET           ; Return.

; Response: "Read The Information Carefully."
;
; Used by the routine at #R$F715.
; .
; Tell the player "Read The Information Carefully."
;
; .
;
; Print it as the reply: #MESSAGE$D0E6.
@label=Messaging_ReadTheInformationCarefully_Reply
c$EAA6 LD HL,$D0E6   ; {Point at the message and print it as the reply.
 $EAA9 JP $EA9E      ; }

; Response: "Try A Little Music."
;
; Used by the routine at #R$F715.
; .
; Tell the player "Try A Little Music."
;
; .
;
; Print it as the reply: #MESSAGE$D117.
@label=Messaging_TryALittleMusic_Reply
c$EAAC LD HL,$D117   ; {Point at the message and print it as the reply.
 $EAAF JP $EA9E      ; }

; Response: "You Don't Really Need It."
;
; Used by the routine at #R$F715.
; .
; Tell the player "You Don't Really Need It."
;
; .
;
; Print it as the reply: #MESSAGE$D13A.
@label=Messaging_YouDontReallyNeedIt_Reply
c$EAB2 LD HL,$D13A   ; {Point at the message and print it as the reply.
 $EAB5 JP $EA9E      ; }

; Response: "You're Not Carrying Anything."
;
; Used by the routine at #R$F756.
; .
; Tell the player "You're Not Carrying Anything."
;
