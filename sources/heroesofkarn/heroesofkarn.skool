; #PUSHS #UDGTABLE #POKES$AECD,$13
; { #SIM(start=#PC,stop=$FDE2)#SCR$01(game-the-edge-of-the-sea) }
; UDGTABLE# #POPS
@label=DisplayImage_EdgeOfTheSea
 $FDDB LD IX,$A351   ; #REGix=#R$A351.
; All the image routines use this same routine.
@label=Handler_Images
*$FDDF CALL $AD60    ; Call #R$AD60.
 $FDE2 LD A,$08      ; {Call #R$B516 and use line number #N$08 to start
 $FDE4 CALL $B516    ; printing.}
 $FDE7 CALL $ABE1    ; Call #R$ABE1.
 $FDEA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #FOREST$FACF }
; { #JEWELS$FEFA }
; { #ANDROMEDA$F813 }
; { #WARLORD$FF12 }
; LIST#

; Jump Table: Room Images
;
; One word per picture slot. The oil room and the acid room share the
; fourth entry.
@label=JumpTable_RoomImages
w$FDEB DEFW $FDAB
 $FDED DEFW $FDB1
 $FDEF DEFW $FDB7
 $FDF1 DEFW $FDBD
 $FDF3 DEFW $FDBD
 $FDF5 DEFW $FDC3
 $FDF7 DEFW $FDC9
 $FDF9 DEFW $FDCF
 $FDFB DEFW $FDD5
 $FDFD DEFW $FDDB
; View the equivalent code in;
; #LIST
; { #FOREST$FB75 }
; { #JEWELS$FFA8 }
; { #ANDROMEDA$FA68 }
; { #WARLORD$FEFC }
; LIST#

; Table: Rooms With Images
;
; Room ids that have a picture, in the same order as #R$FDEB, then an
; #N$00 end marker.
@label=Table_RoomsWithImages
b$FDFF DEFB $03      ; Room #N(#PEEK(#PC)).
 $FE00 DEFB $0E      ; Room #N(#PEEK(#PC)).
 $FE01 DEFB $1C      ; Room #N(#PEEK(#PC)).
 $FE02 DEFB $27      ; Room #N(#PEEK(#PC)).
 $FE03 DEFB $28      ; Room #N(#PEEK(#PC)).
 $FE04 DEFB $3D      ; Room #N(#PEEK(#PC)).
 $FE05 DEFB $12      ; Room #N(#PEEK(#PC)).
 $FE06 DEFB $2B      ; Room #N(#PEEK(#PC)).
 $FE07 DEFB $29      ; Room #N(#PEEK(#PC)).
 $FE08 DEFB $13      ; Room #N(#PEEK(#PC)).
 $FE09 DEFB $00      ; Terminator.

; Unused
u$FE0A DEFS $01F6
