@label=Table_DirectionNames
w$B1D8 DEFW $AFC7    ; #MESSAGE(#PEEK(#PC)+#PEEK(#PC+$01)*$100).
 $B1DA DEFW $AFCD    ; #MESSAGE(#PEEK(#PC)+#PEEK(#PC+$01)*$100).
 $B1DC DEFW $AFD3    ; #MESSAGE(#PEEK(#PC)+#PEEK(#PC+$01)*$100).
 $B1DE DEFW $AFD8    ; #MESSAGE(#PEEK(#PC)+#PEEK(#PC+$01)*$100).
 $B1E0 DEFW $AFDD    ; #MESSAGE(#PEEK(#PC)+#PEEK(#PC+$01)*$100).
 $B1E2 DEFW $AFE0    ; #MESSAGE(#PEEK(#PC)+#PEEK(#PC+$01)*$100).

; Messaging: "Please Rephrase That."
;
; Used by the routines at #R$B665, #R$B670, #R$B685 and #R$B694.
; .
; Print "Please Rephrase That."
;
; .
;
; Print it and start a new line: #MESSAGE$B0CC.
@label=Messaging_PleaseRephraseThat_Newline
c$B1E4 LD HL,$B0CC   ; {Point at the message and print it and start a new line.
 $B1E7 CALL $AC35    ; }
 $B1EA RET           ; Return.

; Messaging: "Please Be More Specific."
;
; Used by the routines at #R$B670, #R$B694 and #R$B6AC.
; .
; Print "Please Be More Specific."
;
; .
;
; Print it and start a new line: #MESSAGE$B0B3.
@label=Messaging_PleaseBeMoreSpecific_Newline
c$B1EB LD HL,$B0B3   ; {Point at the message and print it and start a new line.
 $B1EE CALL $AC35    ; }
 $B1F1 RET           ; Return.

; Messaging: "You can't."
;
; Print "You can't." Nothing calls this copy; play uses #R$EAE2.
;
; .
;
; Print it and start a new line: #MESSAGE$B0E2.
@label=Messaging_YouCant_Newline
c$B1F2 LD HL,$B0E2   ; {Point at the message and print it and start a new line.
 $B1F5 CALL $AC35    ; }
 $B1F8 RET           ; Return.

; Messaging: "O.K."
;
; Print "O.K." Nothing calls this copy; play uses #R$EAE8.
;
; .
;
; Print it and start a new line: #MESSAGE$B0ED.
@label=Messaging_OK_Newline
c$B1F9 LD HL,$B0ED   ; {Point at the message and print it and start a new line.
 $B1FC CALL $AC35    ; }
 $B1FF RET           ; Return.

; Handler: User Input
;
; Used by the routines at #R$B364 and #R$E9A1.
; .
; Read a command, tokenise it, and reject words the game does not know.
@label=HandlerUserInput
c$B200 CALL $AC03    ; Call #R$AC03 to park the cursor on the default line.
 $B203 LD HL,$AEFC   ; Point #REGhl at the command buffer.
 $B206 LD A,$20      ; {Fill the command buffer with spaces.
 $B208 LD B,$32      ; }
@label=HandlerUserInput_Loop
*$B20A LD (HL),A     ; Store #REGa at the buffer pointer.
 $B20B INC HL        ; Advance #REGhl to the next byte.
 $B20C DJNZ $B20A    ; Count down #REGb and repeat from #R$B20A until the count
                     ; is exhausted.
 $B20E CALL $ACEA    ; Call #R$ACEA to print the input prompt.
 $B211 LD HL,$AEFC   ; Point #REGhl at the command buffer.
; This entry point is used by the routine at #R$B237.
@label=Handler_UserInput_ReadKey
*$B214 CALL $ABE1    ; Call #R$ABE1 to read the player's key.
 $B217 CP $0C        ; {Branch to #R$B237 when the player pressed DELETE.
 $B219 JR Z,$B237    ; }
 $B21B CP $0D        ; {Branch to #R$B24E when the player pressed ENTER.
 $B21D JR Z,$B24E    ; }
 $B21F CP $20        ; {Branch to #R$B214 unless the player pressed SPACE.
 $B221 JR C,$B214    ; }
 $B223 EX DE,HL      ; Move the buffer position into #REGde so it can be
                     ; checked against the end of the command buffer.
 $B224 LD HL,$AF2D   ; {Ignore a space once the command fills the buffer.
 $B227 AND A         ;
 $B228 SBC HL,DE     ;
 $B22A EX DE,HL      ;
 $B22B JR Z,$B214    ; }
 $B22D LD (HL),A     ; Store #REGa at the buffer pointer.
 $B22E CALL $AC1A    ; Call #R$AC1A to switch to the normal screen output.
 $B231 CALL $AC47    ; Call #R$AC47 to print the character.
 $B234 INC HL        ; Advance #REGhl to the next byte.
 $B235 JR $B214      ; Read the next key at #R$B214.

; Handler: User Pressed "DELETE"
;
; Used by the routine at #R$B200.
; .
; Rub out the last character of the command when the player presses DELETE.
;
; HL Current position in the command buffer
@label=HandlerUserPressedDELETE
c$B237 EX DE,HL      ; {See whether the cursor is still on the first character.
 $B238 LD HL,$AEFC   ;
 $B23B AND A         ;
 $B23C SBC HL,DE     ;
 $B23E EX DE,HL      ; }
 $B23F JR Z,$B214    ; Ignore DELETE at the start of the command.
; Else delete the current character.
 $B241 PUSH HL       ; Keep the pointer to the command buffer on the stack.
 $B242 LD HL,$AF50   ; {Rub out the last character.
 $B245 CALL $AC28    ; }
 $B248 POP HL        ; Restore the pointer to the command buffer from the
                     ; stack.
; Now adjust the command buffer pointer to match the new position.
 $B249 DEC HL        ; Decrease the pointer to the command buffer by one.
 $B24A LD (HL),$20   ; Write an ASCII space (#N$20) into the command buffer at the current
                     ; position.
 $B24C JR $B214      ; Read the next key.

; Handler: User Pressed "ENTER"
;
; Used by the routine at #R$B200.
; .
; Turn the finished command into word tokens.
;
; HL Current position in the command buffer
; A Which contains #N$0D ("ENTER") at this point.
@label=HandlerUserPressedENTER
c$B24E LD (HL),A     ; Write #N$0D to the command buffer at the current
                     ; position for use as a termination character.
; Force a newline to be "printed" to the screen.
 $B24F CALL $AC1A    ; Call #R$AC1A.
 $B252 CALL $AC47    ; Call #R$AC47 to print the character.
; Initialise the word token buffer. This buffer will store up to #N$0A
; vocabulary tokens (one per word in the command). Each token is the index of
; the word in the vocabulary table.
 $B255 LD HL,$AF2E   ; Point #REGhl at the first word token.
 $B258 LD A,$FF      ; Use the the terminator key code.
 $B25A LD B,$0A      ; Set a counter in #REGb for the size of the word token
                     ; buffer (#N$0A bytes).
; Fill the word token buffer with #N$FF (the terminator value) to mark all
; slots as empty.
@label=EmptyWordTokenBuffer_Loop
*$B25C LD (HL),A     ; {Mark every word slot empty.
 $B25D INC HL        ;
 $B25E DJNZ $B25C    ; }
 $B260 LD HL,$AEFC   ; Point #REGhl at the command buffer.
 $B263 LD C,$0A      ; Allow ten words in the command.
@label=ParserMatchInputWord
@label=Parser_MatchInputWord
*$B265 LD DE,$AF39   ; {Blank the four-byte word scratch with spaces.
 $B268 LD B,$04      ;
 $B26A LD A,$20      ; }
*$B26C LD (DE),A     ; {Fill the word scratch with spaces.
 $B26D INC DE        ;
 $B26E DJNZ $B26C    ; }
 $B270 XOR A         ; {Finish when every word slot is full.
 $B271 OR C          ;
 $B272 JP Z,$B364    ; }
 $B275 LD A,(HL)     ; Read the next character of the command.
 $B276 CP $0D        ; {Finish the command at ENTER.
 $B278 JP Z,$B364    ; }
 $B27B LD B,$04      ; {Copy the next word into the four-byte scratch.
 $B27D LD DE,$AF39   ; }
*$B280 LD A,(HL)     ; Read the next character of this word.
 $B281 CP $0D        ; {End the word at ENTER.
 $B283 JR Z,$B2AC    ; }
 $B285 CP $20        ; {End the word at a space.
 $B287 JR Z,$B2A2    ; }
 $B289 CP $2C        ; {End the word at a comma.
 $B28B JR Z,$B2A2    ; }
 $B28D LD (DE),A     ; Store that character in the word scratch.
 $B28E INC HL        ; {Advance through the command and the word scratch.
 $B28F INC DE        ; }
 $B290 DJNZ $B280    ; Copy up to four letters of this word into the word
                     ; scratch.
*$B292 LD A,(HL)     ; Read the character past a word that did not fit.
 $B293 CP $0D        ; {Stop skipping once ENTER is reached.
 $B295 JR Z,$B2AC    ; }
 $B297 CP $20        ; {Stop skipping at a space.
 $B299 JR Z,$B2A2    ; }
 $B29B CP $2C        ; {Stop skipping at a comma.
 $B29D JR Z,$B2A2    ; }
 $B29F INC HL        ; Skip the rest of a word that does not fit the scratch.
 $B2A0 JR $B292      ; Keep skipping to the end of a long word.
*$B2A2 INC HL        ; Step past the space or comma between words.
 $B2A3 LD A,(HL)     ; Read the character after that space or comma.
 $B2A4 CP $20        ; {Skip spaces between words.
 $B2A6 JR Z,$B2A2    ; }
 $B2A8 CP $2C        ; {Skip commas between words.
 $B2AA JR Z,$B2A2    ; }
*$B2AC PUSH HL       ; {Remember the command, the scratch and the word count.
 $B2AD PUSH DE       ;
 $B2AE PUSH BC       ; }
 $B2AF LD HL,$AF54   ; {Compare the scratch word with "#MESSAGE$AF54".
 $B2B2 LD DE,$AF39   ;
 $B2B5 LD B,$04      ; }
@label=CompareWord_Loop
*$B2B7 LD A,(DE)     ; {Jump to #R$B2BF if the characters don't match (the word
 $B2B8 CP (HL)       ; is not "The").
 $B2B9 JR NZ,$B2BF   ; }
 $B2BB INC DE        ; {Compare the next letter of "THE".
 $B2BC INC HL        ; }
 $B2BD DJNZ $B2B7    ; Keep going until all four letters have been compared.
*$B2BF POP BC        ; {Restore #REGbc, #REGde, #REGhl from the stack.
 $B2C0 POP DE        ;
 $B2C1 POP HL        ; }
 $B2C2 JR Z,$B265    ; Jump to #R$B265 if the words matched (this was "The", so skip it and
                     ; process the next word).
 $B2C4 DEC C         ; Use up one of the ten word slots for this word.
 $B2C5 LD ($AF45),HL ; Write #REGhl to the word scratch.
 $B2C8 LD ($AF47),DE ; Write #REGde to the word pointer.
 $B2CC LD ($AF49),BC ; Write #REGbc to *#R$AF49.
; Look up the word in the vocabulary table. The vocabulary contains all
; recognised verbs, nouns, and other words the game understands. Each entry can
; have synonyms separated by commas.
 $B2D0 LD HL,($AED0) ; Load the pointer for the vocabulary pointer into #REGhl.
 $B2D3 LD C,$00      ; Select the north exit.
@label=VocabularyLookup_Loop
*$B2D5 LD A,(HL)     ; {Jump to #R$B312 if *#REGhl is equal to #N$FF (end of
 $B2D6 CP $FF        ; vocabulary table).
 $B2D8 JR Z,$B312    ; }
@label=CompareVocabularyWord
*$B2DA LD DE,$AF39   ; {Compare this vocabulary word with the scratch word.
 $B2DD LD B,$04      ; }
@label=CompareVocabularyWord_Loop
*$B2DF LD A,(DE)     ; {Jump to #R$B303 if the characters don't match (this
 $B2E0 CP (HL)       ; vocabulary entry doesn't match the word).
 $B2E1 JR NZ,$B303   ; }
 $B2E3 INC DE        ; Move to the next character in the extracted word.
 $B2E4 INC HL        ; Move to the next character in the vocabulary entry.
 $B2E5 DJNZ $B2DF    ; Decrease counter by one and loop back to #R$B2DF until
                     ; all #N$04 characters have been compared.
; Word matched in vocabulary! Calculate which slot in the token buffer to use
; (based on how many words have been processed so far) and store the vocabulary
; index as the token.
 $B2E7 LD HL,$AF49   ; {Work out which token slot this word fills.
 $B2EA LD A,$09      ;
 $B2EC SUB (HL)      ;
 $B2ED LD D,$00      ; }
 $B2EF LD E,A        ; Use the filled slot as an offset into the token buffer.
 $B2F0 LD HL,$AF2E   ; {Calculate the address of the token buffer slot:
 $B2F3 ADD HL,DE     ; #REGhl=the first word token+#REGde.}
 $B2F4 LD (HL),C     ; Store the vocabulary index (#REGc) in the token buffer
                     ; slot.
 $B2F5 LD HL,($AF45) ; Put back the command buffer position from the word
                     ; scratch.
 $B2F8 LD DE,($AF47) ; Put back the word buffer position from the word pointer.
 $B2FC LD BC,($AF49) ; Put back the word counter from *#R$AF49.
 $B300 JP $B265      ; Take the next word.
; Word didn't match this vocabulary entry. Check if there's a synonym
; (indicated by a comma). If found, try matching against the synonym instead.
@label=VocabularyWordNoMatch
*$B303 LD E,B        ; {Step past the vocabulary word that did not match.
 $B304 LD D,$00      ;
 $B306 ADD HL,DE     ; }
 $B307 LD A,(HL)     ; Read the character at this position and store it in
                     ; #REGa.
 $B308 CP $2C        ; {Jump to #R$B30F if this character is not a comma
 $B30A JR NZ,$B30F   ; (#N($2C), meaning no synonym exists).}
 $B30C INC HL        ; Move past the comma to the synonym.
 $B30D JR $B2DA      ; Jump to #R$B2DA to try matching the synonym.
@label=VocabularyNextEntry
*$B30F INC C         ; Advance to the next vocabulary word.
 $B310 JR $B2D5      ; Jump to #R$B2D5 to check the next vocabulary entry.
; All recognised words have been tokenised. Now check if there are any
; unrecognised words remaining in the input. If so, display an error message to
; the player showing which word(s) weren't understood.
@label=ProcessUnrecognisedWords
*$B312 LD HL,($AF45) ; Load the pointer for the word scratch into #REGhl.
 $B315 LD DE,($AF47) ; Restore the word pointer.
 $B319 LD BC,($AF49) ; Restore the word count.
 $B31D LD A,$0A      ; {Count the words still to check.
 $B31F SUB C         ;
 $B320 LD C,A        ; }
 $B321 LD HL,$AEFC   ; Point #REGhl at the command buffer.
@label=ProcessUnrecognisedWords_Loop
*$B324 DEC C         ; Count off one recognised word; the unrecognised word is
                     ; reached when the count runs out.
 $B325 JR Z,$B33F    ; Jump to #R$B33F if #REGc is equal to #N$0A (no
                     ; unrecognised words found).
@label=FindUnrecognisedWord_Loop
*$B327 LD A,(HL)     ; Read the character from *#REGhl and store it in #REGa.
 $B328 CP $20        ; {Jump to #R$B333 if the character is an ASCII "SPACE"
 $B32A JR Z,$B333    ; (#N$20).}
 $B32C CP $2C        ; {Jump to #R$B333 if the character is an ASCII comma
 $B32E JR Z,$B333    ; (#N$2C).}
 $B330 INC HL        ; Move to the next character in the command buffer.
 $B331 JR $B327      ; Keep reading this unrecognised word.
@label=SkipDelimiters_Loop2
*$B333 INC HL        ; Move to the next character in the command buffer.
 $B334 LD A,(HL)     ; Read the character from *#REGhl and store it in #REGa.
 $B335 CP $20        ; {Jump to #R$B333 if the character is an ASCII "SPACE"
 $B337 JR Z,$B333    ; (#N$20).}
 $B339 CP $2C        ; {Jump to #R$B333 if the character is an ASCII comma
 $B33B JR Z,$B333    ; (#N$2C).}
 $B33D JR $B324      ; Look for the next unrecognised word.
; Print the unrecognised word(s) in quotes.
@label=PrintUnrecognisedWord
*$B33F PUSH HL       ; Remember where the unrecognised word starts.
 $B340 LD HL,$AF6D   ; {Print "#MESSAGE$AF6D" and start a new line.
 $B343 CALL $AC35    ; }
 $B346 POP HL        ; Restore the start of the unrecognised word from the
                     ; stack.
 $B347 LD A,$22      ; Open a quote around the unrecognised word.
 $B349 CALL $AC47    ; Call #R$AC47 to print the character.
@label=PrintUnrecognisedWord_Loop
*$B34C LD A,(HL)     ; Read the character from *#REGhl and store it in #REGa.
 $B34D CP $21        ; {Jump to #R$B357 if this character is less than #N$21 (a
 $B34F JR C,$B357    ; control character, indicating end of word).}
 $B351 INC HL        ; Move to the next character in the command buffer.
 $B352 CALL $AC47    ; Call #R$AC47 to print the character.
 $B355 JR $B34C      ; Print the next character of the unrecognised word.
@label=PrintUnrecognisedWord_End
*$B357 LD A,$22      ; Close the quote around the unrecognised word.
 $B359 CALL $AC47    ; Call #R$AC47 to print the character.
 $B35C LD HL,$B10B   ; {Print "#MESSAGE$B10B" and start a new line.
 $B35F CALL $AC35    ; }
 $B362 JR $B370      ; Read another command.

; Handler: Unknown Word
;
; Used by the routine at #R$B24E.
; .
; Answer a command the game cannot parse.
@label=HandlerUnknownWord
c$B364 LD A,($AF2E)  ; Read the first word token into #REGa.
 $B367 CP $FF        ; {Return when the command contains a word.
 $B369 RET NZ        ; }
 $B36A LD HL,$AF59   ; {Print "#MESSAGE$AF59" and start a new line.
 $B36D CALL $AC35    ; }
; This entry point is used by the routine at #R$B24E.
*$B370 JP $B200      ; Continue at #R$B200.

; Process Game Events
;
; Used by the routine at #R$E9A1.
; .
; Advance turn-based events, then any scenic events, before the player types
; again.
;
; .
;
; First process the turn-based events (if any are active).
@label=ProcessGameEvents
c$B373 LD A,($AE88)  ; Load the turn-based event flags into #REGa.
 $B376 OR A          ; {Jump to #R$B3A5 if no turn-based events are currently
 $B377 JR Z,$B3A5    ; active.}
; One of the events has triggered, find which one.
 $B379 LD C,A        ; Copy the turn-based event flags into #REGc.
 $B37A LD B,$08      ; Set a counter in #REGb for the number of possible turn-based events
                     ; (#N$08).
; Keep shifting the event flags one-by-one to find which bits are set.
@label=GameEventChecker_Loop
*$B37C SRL C         ; Test the next turn-based event flag.
 $B37E JR NC,$B3A3   ; Jump to #R$B3A3 if this event bit isn't set.
; The currently processed turn-based event is active, so process it.
; .
; This is: the turn-based event counters+(#N$08-the current event counter).
 $B380 LD DE,$0000   ; {Calculate the turn-based event index and store it in
 $B383 LD HL,$AE89   ; #REGhl.
 $B386 LD A,$08      ;
 $B388 SUB B         ;
 $B389 LD E,A        ;
 $B38A ADD HL,DE     ; }
 $B38B DEC (HL)      ; Decrease the turn-based event counter at *#REGhl by one.
 $B38C JR NZ,$B3A3   ; Jump to #R$B3A3 if the event turn counter at *#REGhl was still more
                     ; than zero.
; The event turn counter is zero, so activate the event itself.
 $B38E LD IX,($AED2) ; Load the turn-based handler pointer into #REGix.
 $B392 SLA E         ; Double the index as this table contains addresses.
 $B394 ADD IX,DE     ; Add this offset to #REGix to point to the current
                     ; handler.
 $B396 LD L,(IX+$00) ; {Get the handler address and store it in #REGhl.
 $B399 LD H,(IX+$01) ; }
 $B39C PUSH BC       ; Keep the bit index and event flag byte on the stack.
 $B39D LD DE,$B3A2   ; {Push #R$B3A2 onto the stack so that the next return will go on to
 $B3A0 PUSH DE       ; continue processing events.}
 $B3A1 JP (HL)       ; Jump to the routine pointed to by *#REGhl to action the current
                     ; event.
; Once the event handler has run, this is where the routine will resume.
@label=GameEventChecker_Return
 $B3A2 POP BC        ; Restore the event bit index counter and event flag byte
                     ; from the stack.
@label=GameEventChecker_Next
*$B3A3 DJNZ $B37C    ; Decrease the event bit counter by one and loop back to #R$B37C
                     ; until all the event status bits have been processed.
; Process scenic events.
@label=GameScenicEventsProcessor
*$B3A5 NOP           ; #HTML(A spare <code>NOP</code>, probably where an
                     ; instruction was patched out, before the scenic events
                     ; are processed.)
 $B3A6 LD HL,($AEEC) ; Point #REGhl at the scenic-event list.
 $B3A9 LD A,($AEF8)  ; Read the scenic-event count into #REGa.
 $B3AC OR A          ; {Leave scenic events alone when none are defined.
 $B3AD JR Z,$B3F0    ; }
 $B3AF LD B,A        ; {Count the scenic events and read the first one.
 $B3B0 JR $B3B3      ; }
@label=ScenicEvent_Loop
*$B3B2 INC HL        ; {Read this scenic event's item.
*$B3B3 LD A,(HL)     ; }
 $B3B4 PUSH HL       ; Remember which scenic event this is.
 $B3B5 CALL $B5C6    ; Call #R$B5C6 to read which room holds the item.
 $B3B8 POP HL        ; Restore the pointer to this scenic event from the stack.
 $B3B9 AND A         ; {Skip a scenic event that is not in play.
 $B3BA JR Z,$B3EE    ; }
 $B3BC LD C,A        ; Remember which room holds this scenic item.
 $B3BD LD A,($AECD)  ; Read the current room into #REGa.
 $B3C0 CP C          ; {Skip a scenic event that is already in this room.
 $B3C1 JR Z,$B3EE    ; }
 $B3C3 PUSH BC       ; {Remember this scenic event while its next room is
 $B3C4 PUSH HL       ; chosen.}
 $B3C5 LD A,($AEF8)  ; Read the scenic-event count into #REGa.
 $B3C8 SUB B         ; {Turn the remaining count into this event's index.
 $B3C9 LD E,A        ; }
 $B3CA LD IX,($AEEE) ; Point #REGix at this event's room list.
 $B3CE CALL $B3F1    ; Call #R$B3F1 to look up the table entry.
 $B3D1 CALL $AC69    ; Call #R$AC69 to read the frame counter.
 $B3D4 LD B,A        ; Use the frame counter as a step through the room list.
 $B3D5 LD A,$FF      ; Use #N$FF as the end of the room list.
*$B3D7 LD L,(IX+$00) ; {Point at this event's room list.
 $B3DA LD H,(IX+$01) ; }
 $B3DD JR $B3E0      ; Start at the first room in the list.
@label=ScenicEvent_PickRoom
*$B3DF INC HL        ; Step to the next room in the list.
*$B3E0 CP (HL)       ; Stop at the end of the room list.
 $B3E1 JR Z,$B3D7    ; Wrap to the start of the list at the terminator.
 $B3E3 DJNZ $B3DF    ; Take another step while the frame count remains.
 $B3E5 LD C,(HL)     ; Take the room chosen for this scenic item.
 $B3E6 POP HL        ; Restore the pointer to this scenic event from the stack.
 $B3E7 LD B,(HL)     ; Take this scenic event's item.
 $B3E8 PUSH HL       ; Remember the scenic event while its item is moved.
 $B3E9 CALL $B5FD    ; Call #R$B5FD to store the item's room.
 $B3EC POP HL        ; {Restore #REGhl, #REGbc from the stack.
 $B3ED POP BC        ; }
*$B3EE DJNZ $B3B2    ; Step down #REGb by one and jump to #R$B3B2 until it is
                     ; zero.
*$B3F0 RET           ; Return.

; Get Table Entry
;
; Used by the routines at #R$B373, #R$B41F, #R$B516, #R$B52B, #R$B64B and
; #R$B753.
; .
; Look up one entry in a word table.
;
;   E Index of item
;   IX Base table address
; O:HL Address from the relevant table entry
; O:IX Address of the table entry
@label=GetTableEntry
c$B3F1 LD D,$00      ; {Double the entry index so it addresses a word in the
 $B3F3 SLA E         ; table.
 $B3F5 RL D          ; }
 $B3F7 ADD IX,DE     ; Step to the chosen entry in the word table.
 $B3F9 LD L,(IX+$00) ; {Read the address stored in that entry.
 $B3FC LD H,(IX+$01) ; }
 $B3FF RET           ; Return.

; Print Objects
;
; Used by the routines at #R$B46B and #R$F756.
; .
; List the objects the player can see in this room.
;
; A #N$01 for inventory items, or room number for room objects
@label=PrintObjects
c$B400 LD HL,$AD76   ; Point #REGhl at #R$AD76.
 $B403 LD BC,($AEF0) ; Load the number of items into #REGbc.
@label=PrintObjects_Loop
*$B407 CPIR          ; Search #R$AD76 for the next item in this room.
 $B409 RET NZ        ; Return if no matching items remain.
 $B40A PUSH HL       ; Stash the current place in #R$AD76 on the stack.
 $B40B CALL $B64B    ; Call #R$B64B to see whether this item has a description.
 $B40E JR Z,$B417    ; Skip an item that has no description.
 $B410 PUSH AF       ; {Remember the room ID and the remaining count while the name is
 $B411 PUSH BC       ; printed.}
 $B412 CALL $AC35    ; Call #R$AC35 to print the string and start a new line.
 $B415 POP BC        ; {Restore the remaining count and the room ID from the
 $B416 POP AF        ; stack.}
@label=PrintObjects_Next
*$B417 LD E,A        ; Hold the room ID in #REGe.
 $B418 POP HL        ; Restore the current place in #R$AD76 from the stack.
 $B419 LD A,B        ; {See whether any items remain.
 $B41A OR C          ; }
 $B41B LD A,E        ; Restore the room ID to #REGa.
 $B41C JR NZ,$B407   ; Jump to #R$B407 while items remain.
 $B41E RET           ; Return.

; Handler: Display Room Image
;
; Used by the routines at #R$ACA8, #R$EA75 and #R$F773.
; .
; Show the picture for the current room when that room has one.
;
; E #N$01 If the image should be displayed, #N$00 if it should be skipped
;
; The game can also load without any graphics at all, so bail if there's
; nothing needed to do here.
@label=HandlerDisplayRoomImage
c$B41F LD A,($AEF6)  ; {Jump to #R$B46B if the picture-room count is set to
 $B422 OR A          ; zero.
 $B423 JR Z,$B46B    ; }
; The version of the game being played DOES have graphics, so continue.
 $B425 LD A,($AECD)  ; Fetch the current room and load it into #REGa.
 $B428 LD HL,($AED8) ; Fetch the address of the table from the
                     ; rooms-with-images pointer.
 $B42B LD BC,($AEF6) ; Fetch the count of the number of rooms in the table from
                     ; the picture-room count.
 $B42F CPIR          ; Search to see if the current room ID is in the table.
 $B431 JR NZ,$B46B   ; Jump to #R$B46B if the current room ID does not appear in the
                     ; table.
; The current room does have an image associated with it.
 $B433 LD A,($AEF6)  ; Read the picture-room count into #REGa.
 $B436 INC C         ; {Turn the picture search into this room's image index.
 $B437 SUB C         ;
 $B438 LD C,A        ; }
; The #REGe register is used as a flag to indicate that the room image should
; not be displayed, e.g. after the player has requested to view their inventory
; and have seen the room image already when they entered the location.
 $B439 XOR A         ; {Jump to #R$B459 if #REGe was set to #N$01 (Display the
 $B43A OR E          ; image).
 $B43B JR NZ,$B459   ; }
; The game also maintains a table of "already seen room images" so the player
; doesn't have to view an image for a room they've already been in.
; .
; The player can view it manually by typing "LOOK" (or just "L").
 $B43D LD HL,$AE7E   ; Point #REGhl at the room-image-seen flags.
 $B440 LD A,C        ; Copy the room image index into #REGa.
; Only two bytes hold the data for all #N$0C rooms with images so first - find
; the correct byte which references this room.
@label=FindAlreadySeenByte_Loop
*$B441 CP $08        ; {Jump to #R$B44A if the room index is less than #N$08.
 $B443 JR C,$B44A    ; }
 $B445 SUB $08       ; Move this room into the next flag byte.
 $B447 INC HL        ; Increment the "image already seen" table pointer by one.
 $B448 JR $B441      ; Jump back to #R$B441 until the flag byte for this room
                     ; is found.
; Now the correct byte has been found, check the appropriate bit.
; .
; Create a mask with a single bit set corresponding to this rooms position
; (0-7) in the byte.
@label=FoundAlreadySeenByte
*$B44A LD B,A        ; Copy the "image already seen" byte into #REGb.
 $B44B INC B         ; Include a shift for bit 0.
 $B44C LD D,$00      ; Start with all bits clear in #REGd.
@label=AlreadySeenBitShift_Loop
*$B44E RL D          ; {Slide this room's bit into place.
 $B450 DJNZ $B44E    ; }
; Test the bit held in #REGd against the room flag.
 $B452 LD A,(HL)     ; Fetch the current room flag.
 $B453 AND D         ; {If the room image has already been seen ... jump to
 $B454 JR NZ,$B46B   ; #R$B46B.}
; The room image hasn't already been seen, so update the bit to indicate that
; the player will have viewed it for the next time this routine runs.
 $B456 LD A,(HL)     ; {Merge the set room bit with the room flags and write the result
 $B457 OR D          ; back to the room flag byte.
 $B458 LD (HL),A     ; }
; Finally! Display the room image.
@label=DisplayRoomImage
*$B459 PUSH BC       ; {Call #R$ABF1 to clear the screen, keeping the location
 $B45A CALL $ABF1    ; image index in #REGc.
 $B45D POP BC        ; }
 $B45E LD IX,($AEDA) ; Fetch the address of the table from the room-image jump
                     ; pointer.
 $B462 LD E,C        ; Load the location image index into #REGe.
 $B463 CALL $B3F1    ; Call #R$B3F1 to look up the table entry.
 $B466 LD DE,$B46B   ; {Push #R$B46B onto the stack so that the next return will go on to
 $B469 PUSH DE       ; show the room exits.}
 $B46A JP (HL)       ; Jump to the routine pointed to by *#REGhl to display the room
                     ; image.

; Handler: Display Room Exits
;
; Used by the routine at #R$B41F.
; .
; Print the exits that leave the current room.
@label=HandlerDisplayRoomExits
c$B46B CALL $ABF1    ; Call #R$ABF1 to clear the screen.
 $B46E LD A,$18      ; {Set up the printing position.
 $B470 CALL $B516    ; }
 $B473 CALL $B503    ; Call #R$B503 which loads #REGhl with the room data
                     ; pointer.
 $B476 LD D,H        ; {Store this in #REGde for later.
 $B477 LD E,L        ; }
; Count the number of exits in the room data.
 $B478 LD B,$06      ; Set an "exits" counter in #REGb of #N$06.
 $B47A LD C,$00      ; Initialise #REGc to #N$00 to count the number of valid
                     ; exits.
 $B47C XOR A         ; Set #REGa to #N$00 which is used just for the
                     ; comparison.
@label=RoomExitsCount_Loop
*$B47D CP (HL)       ; Does this room have an exit?
 $B47E JR Z,$B481    ; Jump to #R$B481 if this room doesn't have an exit for this
                     ; position.
 $B480 INC C         ; Increment the valid exits count by one.
@label=RoomExitsCount_Skip
*$B481 INC HL        ; Move to the next byte of room data.
 $B482 DJNZ $B47D    ; Decrease the exits counter by one and loop back to #R$B47D until
                     ; all the exits have been checked.
; Process the exits count result.
 $B484 OR C          ; {Jump to #R$B4EF if no exits were found.
 $B485 JR Z,$B4EF    ; }
 $B487 LD A,C        ; {Jump to #R$B4AE if more than #N$01 exit was found.
 $B488 CP $01        ;
 $B48A JR NZ,$B4AE   ; }
; Only one exit was found:
 $B48C LD HL,$AFB4   ; {Print "#MESSAGE$AFB4".
 $B48F CALL $AC28    ; }
 $B492 LD H,D        ; {Retrieve the room data pointer and load it into #REGhl.
 $B493 LD L,E        ; }
 $B494 LD IX,$B1D8   ; Set a pointer in #REGix to #R$B1D8.
 $B498 XOR A         ; Set #REGa to #N$00 which is used just for the
                     ; comparison.
 $B499 JR $B4A0      ; Start at the north exit.
; Move both the pointers to the next item of data (increment by two for the
; direction name table pointer as it contains addresses).
@label=RoomCheckForExit_Loop
*$B49B INC HL        ; Move to the next byte of room data.
 $B49C INC IX        ; {Increment the direction name table pointer by two.
 $B49E INC IX        ; }
@label=RoomCheckForExit
*$B4A0 CP (HL)       ; {Jump to #R$B49B if the current exit isn't a valid exit.
 $B4A1 JR Z,$B49B    ; }
 $B4A3 LD L,(IX+$00) ; {Get the direction name from the direction name table.
 $B4A6 LD H,(IX+$01) ; }
 $B4A9 CALL $AC28    ; Call #R$AC28 to print the direction name.
 $B4AC JR $B4E9      ; Finish the exit sentence.
; More than one exit was found:
@label=RoomMultipleExits
*$B4AE LD HL,$AFA1   ; {Print "#MESSAGE$AFA1" and start a new line.
 $B4B1 CALL $AC35    ; }
 $B4B4 LD H,D        ; {Retrieve the room data pointer and load it into #REGhl.
 $B4B5 LD L,E        ; }
 $B4B6 LD IX,$B1D8   ; Set a pointer in #REGix to #R$B1D8.
 $B4BA XOR A         ; Set #REGa to #N$00 which is used just for the
                     ; comparison.
 $B4BB JR $B4C3      ; Start at the north exit.
; So as not to corrupt the pointer to the room data (as #REGhl is also used
; when printing), it's temporarily held in #REGde.
@label=RoomExits_Initialise
*$B4BD EX DE,HL      ; Bring the room data pointer back into #REGhl.
; Move both the pointers to the next item of data (increment by two for the
; direction name table pointer as it contains addresses).
@label=RoomCheckForExits_Loop
*$B4BE INC HL        ; Move to the next byte of room data.
 $B4BF INC IX        ; {Increment the direction name table pointer by two.
 $B4C1 INC IX        ; }
@label=RoomCheckForExits
*$B4C3 CP (HL)       ; {Jump to #R$B4BE if the current exit isn't a valid exit.
 $B4C4 JR Z,$B4BE    ; }
 $B4C6 EX DE,HL      ; Temporarily store the room data pointer in #REGde.
 $B4C7 LD L,(IX+$00) ; {Get the direction name from the direction name table.
 $B4CA LD H,(IX+$01) ; }
 $B4CD CALL $AC28    ; Call #R$AC28 to print the direction name.
 $B4D0 DEC C         ; Decrease the valid exits count by one.
 $B4D1 LD A,C        ; {Jump to #R$B4E9 if there are no more exits to process.
 $B4D2 CP $01        ;
 $B4D4 JR C,$B4E9    ; }
 $B4D6 JR Z,$B4E0    ; Jump to #R$B4E0 if there is only one exit left to
                     ; process.
; #HTML(Print a comma character: "<code>#CHR$2C</code>".)
 $B4D8 LD A,$2C      ; Print a comma between the exit names.
 $B4DA CALL $AC47    ; Call #R$AC47 to print the character.
 $B4DD XOR A         ; Reset #REGa back to #N$00 for the comparison.
 $B4DE JR $B4BD      ; Jump back to #R$B4BD to continue processing.
@label=RoomExits_PrintAmpersand
*$B4E0 LD HL,$AF9D   ; {Print "#MESSAGE$AF9D".
 $B4E3 CALL $AC28    ; }
 $B4E6 XOR A         ; Reset #REGa back to #N$00 for the comparison.
 $B4E7 JR $B4BD      ; Jump to #R$B4BD to continue processing.
@label=RoomExits_PrintFullStop
*$B4E9 LD HL,$B10B   ; {Print "#MESSAGE$B10B" and start a new line.
 $B4EC CALL $AC35    ; }
; Are there any objects here?
@label=RoomExits_YouCanSee
*$B4EF LD A,($AECD)  ; Read the current room into #REGa.
 $B4F2 CALL $B62E    ; Call #R$B62E to see which objects are in the room.
 $B4F5 RET NZ        ; Return if no objects were found at this location.
 $B4F6 LD HL,$AF8E   ; {Print "#MESSAGE$AF8E" and start a new line.
 $B4F9 CALL $AC35    ; }
; Print the objects at this location.
 $B4FC LD A,($AECD)  ; Read the current room into #REGa.
 $B4FF CALL $B400    ; Call #R$B400 to list the objects here.
 $B502 RET           ; Return.

; Get Room Pointer
;
; Used by the routines at #R$B46B and #R$F7F8.
; .
; Point at the current room's six exit bytes.
;
; O:HL Pointer to the room data
@label=GetRoomPointer
c$B503 LD A,($AECD)  ; Read the current room into #REGa.
 $B506 LD E,A        ; {Turn the room number into an offset of six bytes in the
 $B507 LD D,$00      ; room map.
 $B509 LD H,D        ;
 $B50A LD L,E        ;
 $B50B ADD HL,DE     ;
 $B50C ADD HL,DE     ;
 $B50D ADD HL,DE     ;
 $B50E ADD HL,DE     ;
 $B50F ADD HL,DE     ; }
 $B510 LD DE,($AED4) ; Load the register pair from the room-map pointer.
 $B514 ADD HL,DE     ; Point at this room's exits.
 $B515 RET           ; Return.

; Print Room Description
;
; Used by the routines at #R$B46B and #R$FDDB.
; .
; Print the description of the current room.
;
; A Line number to begin printing
@label=PrintRoomDescription
c$B516 LD ($AF38),A  ; Store #REGa in the screen line.
 $B519 CALL $AC0D    ; Call #R$AC0D to park the cursor on the current screen
                     ; line.
 $B51C LD A,($AECD)  ; Read the current room into #REGa.
 $B51F LD IX,($AEDC) ; Load #REGix from the room-description pointer.
 $B523 LD E,A        ; Use the room number to find its description.
 $B524 CALL $B3F1    ; Call #R$B3F1 to look up the table entry.
 $B527 CALL $AC35    ; Call #R$AC35 to print the string and start a new line.
 $B52A RET           ; Return.

; Action: Examine Item
;
; Used by the routine at #R$B6BC.
; .
; Carry out the "Examine Item" command.
;
;   C Item ID
; O:F Carry flag set when the item isn't present
@label=ActionExamineItem
c$B52B INC BC        ; {Turn the search position into this object's index.
 $B52C LD A,($AEF2)  ;
 $B52F SUB C         ;
 $B530 LD E,A        ; }
 $B531 PUSH DE       ; Remember the object index.
 $B532 LD IX,($AEDE) ; Point #REGix at the item groups.
 $B536 CALL $B3F1    ; Call #R$B3F1 to look up the table entry.
 $B539 POP DE        ; Restore the object index from the stack.
 $B53A JR $B53D      ; Check the first item in this group.
@label=ExamineItem_Loop
*$B53C INC HL        ; Step to the next item in this group.
@label=ExamineItem
*$B53D LD A,(HL)     ; {Jump to #R$B548 if *#REGhl is equal to #N$FF.
 $B53E CP $FF        ;
 $B540 JR Z,$B548    ; }
 $B542 CALL $B560    ; Call #R$B560 to find where the object is.
 $B545 JR NZ,$B53C   ; Jump to #R$B53C if the item wasn't found.
 $B547 RET           ; Return.
; The item being examined isn't in the room or in the players inventory.
@label=Response_ItemNotHere
*$B548 LD HL,$AFE5   ; {Print "#MESSAGE$AFE5".
 $B54B CALL $AC28    ; }
; Print the object name.
 $B54E LD IX,($AEE0) ; Point #REGix at the noun for this item.
 $B552 CALL $B3F1    ; Call #R$B3F1 to look up the table entry.
 $B555 CALL $AC28    ; Call #R$AC28 to print the string.
 $B558 LD HL,$AFF2   ; {Print "#MESSAGE$AFF2" and start a new line.
 $B55B CALL $AC35    ; }
 $B55E SCF           ; Set the carry flag to report that the item isn't here,
                     ; so the command goes no further.
 $B55F RET           ; Return.

; Get Object Location
;
; Used by the routines at #R$B52B, #R$B5EC, #R$B714, #R$E9E1, #R$EA75 and
; #R$F715.
; .
; Get Object Location.
@label=Get_ObjectLocation
c$B560 PUSH HL       ; {Keep the caller's pointers.
 $B561 PUSH DE       ; }
 $B562 LD E,A        ; {Look this object up in the item-location table.
 $B563 LD D,$00      ;
 $B565 LD HL,$AD76   ;
 $B568 ADD HL,DE     ; }
 $B569 LD A,($AECD)  ; Read the current room into #REGa.
 $B56C CP (HL)       ; {Branch to #R$B572 when the byte at #REGhl means the
 $B56D JR Z,$B572    ; values match.}
 $B56F LD A,$01      ; {See whether the object is in the inventory.
 $B571 CP (HL)       ; }
@label=Get_ObjectLocation_Return
*$B572 POP DE        ; {Restore the caller's pointers from the stack, keeping
 $B573 POP HL        ; the zero flag from the location test.}
 $B574 RET           ; Return.

; Match Phrase Tokens
;
; Used by the routines at #R$B7D3, #R$FB13, #R$FB20, #R$FB2D and #R$FB3A.
; .
; Match Phrase Tokens.
;
;   HL A pointer to phrase token data
; O:F The Z flag is set if the input matches any pattern
@label=MatchPhraseTokens
c$B575 EX DE,HL      ; Move the phrase token pointer into #REGde.
 $B576 JR $B579      ; Start the match at the first pattern byte, #R$B579.
@label=Match_PhraseTokens_Loop
*$B578 INC DE        ; Advance #REGde to the next byte.
@label=MatchPhraseTokens_Next
*$B579 LD HL,$AF2F   ; Point #REGhl at the second word token.
 $B57C JR $B580      ; Compare the command from its first word at #R$B580.
@label=MatchPhraseTokens_Loop
*$B57E INC HL        ; Advance #REGhl to the next byte.
 $B57F INC DE        ; Advance #REGde to the next byte.
@label=Match_PhraseTokens_Compare
*$B580 LD A,(DE)     ; Read the next vocabulary byte into #REGa.
 $B581 CP (HL)       ; {Branch to #R$B57E when the byte at #REGhl means the
 $B582 JR Z,$B57E    ; values match.}
 $B584 CP $FE        ; {Branch to #R$B58C when #N$FE means the values differ.
 $B586 JR NZ,$B58C   ; }
 $B588 LD A,(HL)     ; {Accept the phrase when the command has ended.
 $B589 CP $FF        ;
 $B58B RET           ; }
@label=Match_PhraseTokens_Alternative
*$B58C CP $FD        ; {Branch to #R$B596 when #N$FD means the values differ.
 $B58E JR NZ,$B596   ; }
 $B590 LD A,(HL)     ; {Match this alternative when the command has ended, and
 $B591 CP $FF        ; try the next one when the player typed another word.
 $B593 JR NZ,$B578   ;
 $B595 RET           ; }
@label=Match_PhraseTokens_Skip
*$B596 INC DE        ; Advance #REGde to the next byte.
 $B597 LD A,(DE)     ; Read the next vocabulary byte into #REGa.
 $B598 CP $FE        ; {Branch to #R$B5A2 when #N$FE means the values match.
 $B59A JR Z,$B5A2    ; }
 $B59C CP $FD        ; {Branch to #R$B596 when #N$FD means the values differ.
 $B59E JR NZ,$B596   ; }
 $B5A0 JR $B578      ; Try the next phrase alternative at #R$B578.
@label=Match_PhraseTokens_Done
*$B5A2 OR A          ; Test #REGa so the following branch can see whether it is
                     ; zero.
 $B5A3 RET           ; Return.

; Parser: Count Item References
;
; Used by the routines at #R$B670, #R$B685 and #R$B6AC.
; .
; Parser: Count Item References.
;
; O:A The number of references to items in the user input tokens
; O:E As #REGa
; O:F The Z flag is set when there are no items present in the input
@label=ParserCountItemReferences
c$B5A4 LD HL,$AF2E   ; Set a pointer to the first word token in #REGhl.
 $B5A7 LD B,$0A      ; Set a token count in #REGb of #N$0A which is the total length of
                     ; the user input tokens.
 $B5A9 LD E,$00      ; Initialise the item counter held in #REGe to #N$00.
@label=Parser_CountItems_Loop
*$B5AB LD A,(HL)     ; Fetch a user input token.
 $B5AC CP $FF        ; {Jump to #R$B5C3 if the terminator character (#N$FF) has been
 $B5AE JR Z,$B5C3    ; reached.}
 $B5B0 PUSH HL       ; {Remember the token and the count while the object list
 $B5B1 PUSH BC       ; is searched.}
 $B5B2 LD HL,($AEE2) ; Load the pointer for the character-set pointer into
                     ; #REGhl.
 $B5B5 LD BC,($AEF2) ; Fetch the count of the number of items in the table from
                     ; the object count.
 $B5B9 CPIR          ; Search to see if the item room ID is in the table.
 $B5BB POP BC        ; {Restore #REGbc, #REGhl from the stack.
 $B5BC POP HL        ; }
 $B5BD JR NZ,$B5C0   ; Jump to #R$B5C0 if this token doesn't refer to a game
                     ; item.
; This token does point to a game item, so increase the item counter.
 $B5BF INC E         ; Increment item counter by one.
@label=Parser_CountItems_Skip
*$B5C0 INC HL        ; Move to the next token.
 $B5C1 DJNZ $B5AB    ; Decrease the token counter by one and loop back to #R$B5AB until
                     ; all the tokens have been evaluated.
@label=Parser_CountItems_Process
*$B5C3 XOR A         ; {Leave the number of items named in the command in
 $B5C4 OR E          ; #REGa. The zero flag is set when none were named.}
 $B5C5 RET           ; Return.

; Get Item Room
;
; Used by the routines at #R$B373, #R$B5CF, #R$B613 and #R$B626.
; .
; Get Item Room.
@label=GetItemRoom
c$B5C6 LD E,A        ; {Look this item up in the item-location table.
 $B5C7 LD D,$00      ;
 $B5C9 LD HL,$AD76   ;
 $B5CC ADD HL,DE     ; }
 $B5CD LD A,(HL)     ; Read the room that holds this item.
 $B5CE RET           ; Return.

; Is Object In Inventory?
;
; Used by the routine at #R$FAC8.
; .
; Is Object In Inventory?.
;
;   A Object ID
; O:F Z flag set if object is in the players inventory
;
; The #R$B5C6 routine returns with #REGa containing the room ID of the
; requested object.
@label=IsObjectInInventory
c$B5CF CALL $B5C6    ; Call #R$B5C6.
 $B5D2 CP $01        ; See whether that room is the inventory.
 $B5D4 RET           ; Return.

; Handler: Destroy Item/ Event
;
; Used by the routines at #R$E9E1, #R$EA75 and #R$EE63.
; .
; Destroy Item/ Event.
;
; A Item/ event ID
@label=HandlerDestroyItemEvent
c$B5D5 LD B,A        ; Hold the item while its room is cleared.
 $B5D6 LD C,$00      ; {Call #R$B5FD to store the item's room.
 $B5D8 CALL $B5FD    ; }
 $B5DB RET           ; Return.

; Handler: Update Item/ Event For The Current Room
;
; Used by the routines at #R$B714, #R$E9E1 and #R$FAC8.
; .
; Update Item/ Event For The Current Room.
;
; A Item/ event ID
@label=HandlerUpdateItemEventForTheCurrentRoom
c$B5DC LD B,A        ; Hold the item while the current room is read.
 $B5DD LD A,($AECD)  ; Read the current room into #REGa.
 $B5E0 LD C,A        ; Give the item the player's current room.
 $B5E1 CALL $B5FD    ; Call #R$B5FD to store the item's room.
 $B5E4 RET           ; Return.

; Handler: Set Scenic Event As Triggered
;
; Mark the scenic event in #REGa as already fired. The scenic-event
; count is zero, so nothing calls this routine.
;
; A Scenic event id
@label=ScenicEventTriggered
c$B5E5 LD B,A        ; Copy the scenic event id into #REGb.
 $B5E6 LD C,$FF      ; Use #N$FF for #REGc so the event is not repeated.
 $B5E8 CALL $B5FD    ; Call #R$B5FD to store the item's room.
 $B5EB RET           ; Return.

; Check Active Scenic Events
;
; Used by the routines at #R$B606 and #R$E9E1.
; .
; Check Active Scenic Events.
;
;   HL Pointer to scenic data
; O:A The listed item that is here, or #N$FF if there is none
; O:F The zero flag is set when an item on the list is here or carried
@label=CheckActiveScenicEvents
c$B5EC JR $B5EF      ; Check the first scenic item at #R$B5EF.
@label=CheckActiveScenicEvents_Loop
*$B5EE INC HL        ; Advance #REGhl to the next byte.
@label=CheckActiveScenicEvents_Next
*$B5EF LD A,(HL)     ; Read the next scenic item.
 $B5F0 CP $FF        ; {Stop at the end of the scenic list.
 $B5F2 JR Z,$B5FB    ; }
 $B5F4 CALL $B560    ; Call #R$B560 to find where the object is.
 $B5F7 JR NZ,$B5EE   ; Try the next entry when this one is not here or carried.
 $B5F9 LD A,(HL)     ; {Return the scenic item that is here.
 $B5FA RET           ; }
@label=Check_ActiveScenicEvents_Done
*$B5FB AND A         ; Clear the zero flag (#REGa holds the #N$FF end marker)
                     ; to report that nothing on the list is here.
 $B5FC RET           ; Return.

; Set Item Room
;
; Used by the routines at #R$B373, #R$B5D5, #R$B5DC, #R$B5E5, #R$B613 and
; #R$B714.
; .
; Set Item Room.
@label=SetItemRoom
c$B5FD LD HL,$AD76   ; Point #REGhl at the item-location table.
 $B600 LD D,$00      ; {Write the room into the item's slot in the
 $B602 LD E,B        ; item-location table.
 $B603 ADD HL,DE     ;
 $B604 LD (HL),C     ; }
 $B605 RET           ; Return.

; Find Active Scenic Event
;
; Walk the scenic-event list at #REGhl and return the index of the
; first one that matches.
@label=FindActiveScenicEvent
c$B606 LD B,$00      ; Start the index at #N$00.
 $B608 JR $B60C      ; Check the first scenic event at #R$B60C.
@label=FindActiveScenicEvent_Loop
*$B60A INC B         ; Advance the index in #REGb.
 $B60B INC HL        ; Advance #REGhl to the next event.
@label=FindActiveScenicEvent_Next
*$B60C CALL $B5EC    ; Call #R$B5EC to check the scenic events.
 $B60F JR Z,$B60A    ; Branch to #R$B60A to count each listed item that is
                     ; here, until the end of the list.
 $B611 LD A,B        ; Copy the index into #REGa.
 $B612 RET           ; Return.

; Transform Item
;
; Used by the routines at #R$E9E1 and #R$EE63.
; .
; Transform Item.
;
; B From item ID (the item to be destroyed)
; C To item ID (the item to be created)
;
; Get the location of the "from" item so the "to" item can be created in the
; same place.
@label=TransformItem
c$B613 LD A,B        ; Copy the "from" item ID into #REGa.
 $B614 CALL $B5C6    ; Call #R$B5C6 to get the room ID where the "from" item is located
                     ; (returns in #REGa).
 $B617 PUSH BC       ; {Remember the items and the room while the first is
 $B618 PUSH AF       ; removed.}
; Destroy the "from" item by setting its location to #N$00 (inactive).
 $B619 LD C,$00      ; Set the room ID to #N$00 to deactivate the "from" item.
 $B61B CALL $B5FD    ; Call #R$B5FD to update the "from" item's location to
                     ; #N$00.
 $B61E POP AF        ; {Restore #REGaf, #REGbc from the stack.
 $B61F POP BC        ; }
; Create the "to" item at the same location where the "from" item was.
 $B620 LD B,C        ; Copy the "to" item ID into #REGb.
 $B621 LD C,A        ; Copy the location (from #REGa) into #REGc.
 $B622 CALL $B5FD    ; Call #R$B5FD to create the "to" item at the stored
                     ; location.
 $B625 RET           ; Return.

; Is Item In Current Room
;
; Compare the item's room with the room the player is in.
;
;   A Item id
; O:F The zero flag is set when the item is in the current room
@label=IsItemInCurrentRoom
c$B626 CALL $B5C6    ; Call #R$B5C6 to read which room holds the item.
 $B629 LD HL,$AECD   ; Point #REGhl at the current room.
 $B62C CP (HL)       ; See whether the item is in this room.
 $B62D RET           ; Return.

; Check Room Objects
;
; Used by the routine at #R$B46B.
; .
; Check Room Objects.
;
;   A Room number
; O:A #N$00 or #N$01 if objects are found or not
@label=CheckRoomObjects
c$B62E LD HL,$AD76   ; Point #REGhl at the item-location table.
 $B631 LD BC,($AEF0) ; Take the length of the item-location table.
@label=CheckRoomObjects_Loop
*$B635 CPIR          ; Search for the room number in the table.
 $B637 RET NZ        ; Return if no objects are found.
 $B638 PUSH HL       ; Keep the object location table pointer on the stack.
 $B639 CALL $B64B    ; Call #R$B64B to check that the object is here.
 $B63C POP HL        ; Restore the object location table pointer from the
                     ; stack.
 $B63D JR NZ,$B649   ; Jump to #R$B649 if there are no objects found here.
 $B63F LD E,A        ; Temporarily store #REGa in #REGe.
 $B640 LD A,B        ; {Are there more objects to check?
 $B641 OR C          ; }
 $B642 LD A,E        ; Put back the #REGa register.
 $B643 JR NZ,$B635   ; Jump to #R$B635 if there are more objects to check.
; Set the "successful" output.
 $B645 LD A,$01      ; Set #REGa to #N$01 to indicate that objects were found.
 $B647 AND A         ; Clear the zero flag to report that objects were found.
 $B648 RET           ; Return.
; Set the "failure" output.
@label=NoRoomObjectsFound
*$B649 XOR A         ; Set #REGa to #N$00 to indicate that no objects were
                     ; found.
 $B64A RET           ; Return.

; Validate Object
;
; Used by the routines at #R$B400 and #R$B62E.
; .
; Validate Object.
@label=ValidateObject
c$B64B PUSH AF       ; {Remember the room and the search position.
 $B64C PUSH BC       ; }
 $B64D INC BC        ; Advance #REGbc to the next byte.
 $B64E LD A,($AEF0)  ; Read the item count into #REGa.
 $B651 SUB C         ; {Turn the search position into this item's index.
 $B652 LD E,A        ; }
 $B653 LD IX,($AED6) ; {Call #R$B3F1 to look up the table entry.
 $B657 CALL $B3F1    ; }
 $B65A POP BC        ; Restore the search position from the stack.
 $B65B LD A,H        ; See whether this item has a description.
 $B65C OR L          ; Combine #REGl into the working value.
 $B65D JR Z,$B662    ; Reject an item that has no description.
 $B65F POP AF        ; Restore the room ID from the stack.
 $B660 AND A         ; Test #REGa so the following branch can see whether it is
                     ; zero.
 $B661 RET           ; Return.
@label=ValidateObject_Next
*$B662 POP AF        ; Restore the room ID from the stack.
 $B663 CP A          ; Report that this item has no description.
 $B664 RET           ; Return.

; Parser: Validate No Direct Object
;
; Used by the routines at #R$F715, #R$F756, #R$F773, #R$F77D, #R$F7AC, #R$F7BC,
; #R$F7C4, #R$F7F8, #R$FAC8 and #R$FB67.
; .
; Parser: Validate No Direct Object.
;
; O:F The Z flag is set when there's no direct object present
; O:F The carry flag is set when there's a second token set
@label=ParserValidateNoDirectObject
c$B665 LD A,($AF2F)  ; {Return if the second token (*#N$AF2F) is the terminator
 $B668 CP $FF        ; character (#N$FF).
 $B66A RET Z         ; }
 $B66B CALL $B1E4    ; Call #R$B1E4 to ask the player to rephrase.
 $B66E SCF           ; Set the carry flag to indicate the command is malformed.
 $B66F RET           ; Return.

; Parser: Validate Direct Object
;
; Used by the routines at #R$B694, #R$F785, #R$F80D, #R$F8D0, #R$F972, #R$F989,
; #R$F9DC, #R$F9E3, #R$FA02, #R$FA19, #R$FA72, #R$FA8A, #R$FAA5, #R$FAF9,
; #R$FB50 and #R$FB92.
; .
; Parser: Validate Direct Object.
;
; O:F The carry flag is set when the command is malformed
;
; The first token is the verb, so target the second token for the direct
; object.
@label=ParserValidateDirectObject
c$B670 LD A,($AF2F)  ; Fetch the #N$AF2F(second token from the user input) and store it in
                     ; #REGa.
 $B673 CP $FF        ; {Jump forward to #R$B67C if the token is anything other than the
 $B675 JR NZ,$B67C   ; terminator character (#N$FF).}
; The token was the terminator character (#N$FF), so the sentence is malformed.
; .
; E.g. They tried "TAKE" but didn't write anything after it.
 $B677 CALL $B1EB    ; Call #R$B1EB.
 $B67A SCF           ; Set the carry flag to indicate this call was a failure.
 $B67B RET           ; Return.
; Process the direct object.
@label=DirectObject_Process
*$B67C CALL $B5A4    ; Call #R$B5A4.
 $B67F RET NZ        ; Return if #REGa is not equal to #N$FF.
 $B680 CALL $B1E4    ; Call #R$B1E4 to ask the player to rephrase.
 $B683 SCF           ; Set the carry flag to indicate the command is malformed.
 $B684 RET           ; Return.

; Parser: Validate Input Tokens
;
; Check the words after the verb, and ask for a rephrase when none of
; them is a known item. Nothing calls this routine.
;
; O:F The carry flag is set when the command is malformed
;
; The first token is the verb, so read the second token.
@label=Parser_ValidateInputTokens
c$B685 LD A,($AF2F)  ; Read the second word token into #REGa.
 $B688 CP $FF        ; Compare the token with the terminator.
 $B68A RET Z         ; Return if there is no second token.
; There is a second token, so count the known items.
 $B68B CALL $B5A4    ; Call #R$B5A4 to count how the command refers to the
                     ; item.
 $B68E RET NZ        ; Return if a known item was named.
; The words are not known items.
 $B68F CALL $B1E4    ; Call #R$B1E4 to ask the player to rephrase.
 $B692 SCF           ; Mark the command as malformed.
 $B693 RET           ; Return.

; Parser: Validate Two Direct Objects
;
; Used by the routines at #R$F93B and #R$FA38.
; .
; Parser: Validate Two Direct Objects.
;
; O:F The carry flag is set when the command is malformed
@label=ParserValidateTwoDirectObjects
c$B694 CALL $B670    ; Call #R$B670 to check that the command names an object.
 $B697 RET C         ; Return if there is no direct object in the user input (so the
                     ; command is malformed).
; #REGa now contains the count of the number of valid direct objects.
 $B698 CP $01        ; {Jump to #R$B6A1 if the number of valid direct objects in the user
 $B69A JR NZ,$B6A1   ; input is not #N$01.}
; There is only one valid direct object in the user input and the command needs
; two...
 $B69C CALL $B1EB    ; Call #R$B1EB to ask for a more specific command.
 $B69F SCF           ; Set the carry flag to report that the command is
                     ; malformed.
 $B6A0 RET           ; Return.
; There are two or more valid direct objects in the user input.
@label=ValidateTwoDirectObjects
*$B6A1 CP $03        ; {Jump to #R$B6A7 if the number of valid direct objects in the user
 $B6A3 JR NC,$B6A7   ; input is greater than or equal to #N$03.}
 $B6A5 AND A         ; Clear the carry flag: exactly two objects were named, so
                     ; the command is valid.
 $B6A6 RET           ; Return.
; There are more than two valid direct objects in the user input.
@label=ValidateTwoDirectObjects_TooMany
*$B6A7 CALL $B1E4    ; Call #R$B1E4 to ask the player to rephrase.
 $B6AA SCF           ; Set the carry flag to report that the command is
                     ; malformed.
 $B6AB RET           ; Return.

; Parser: Validate Any Direct Object
;
; Parser: Validate Any Direct Object.
;
; O:A The number of valid direct objects in the user input tokens
; O:F The carry flag is set when the command is malformed
; O:F The zero flag is set when there are no valid direct objects present in
; .   the input tokens
;
; The first token is the verb, so target the second token for the direct
; object.
@label=ParserValidateAnyDirectObject
c$B6AC LD A,($AF2F)  ; Fetch the #N$AF2F(second token from the user input) and store it in
                     ; #REGa.
 $B6AF CP $FF        ; {Jump forward to #R$B6B8 if the token is anything other than the
 $B6B1 JR NZ,$B6B8   ; terminator character (#N$FF).}
; The token was the terminator character (#N$FF), so the sentence is malformed.
; .
; E.g. They tried "TAKE" but didn't write anything after it.
 $B6B3 CALL $B1EB    ; Call #R$B1EB to ask for a more specific command.
 $B6B6 SCF           ; Set the carry flag to indicate this call was a failure.
 $B6B7 RET           ; Return.
; The user input tokens have a direct object, return how many are in the
; command buffer.
@label=ValidateAnyDirectObject
*$B6B8 CALL $B5A4    ; Call #R$B5A4.
 $B6BB RET           ; Return.

; Parser: Process Item
;
; Used by the routine at #R$E9A1.
; .
; Parser: Process Item.
;
; .
;
; Set up to loop through all word tokens in the token buffer.
@label=ParserProcessItem
c$B6BC LD HL,$AF2E   ; Set a pointer to the word token buffer (the first word
                     ; token) in #REGhl.
 $B6BF LD B,$0A      ; Set a counter in #REGb for #N$0A tokens (the maximum
                     ; number of words).
; Check if there are any tokens to process. Return immediately if the first
; token is the terminator (#N$FF), meaning the input was empty.
@label=ProcessItem_Loop
*$B6C1 LD A,(HL)     ; {Return if the current token is #N$FF (no more tokens to
 $B6C2 CP $FF        ; process).
 $B6C4 RET Z         ; }
 $B6C5 PUSH HL       ; {Remember the token and the count while the object list
 $B6C6 PUSH BC       ; is searched.}
 $B6C7 LD HL,($AEE2) ; Load the object list table pointer into #REGhl.
 $B6CA LD BC,($AEF2) ; #HTML(Load the number of objects into #REGbc (for the
                     ; <code>CPIR</code> search).)
 $B6CE CPIR          ; Search the object list table to see if the token matches
                     ; any object ID.
 $B6D0 JR NZ,$B6DA   ; Jump to #R$B6DA if the token doesn't match any object ID
                     ; (not an item token).
; The token matches an object ID. Now verify that the item is actually present
; (in the current room or player's inventory).
 $B6D2 CALL $B52B    ; Call #R$B52B to check if the item is present and
                     ; accessible.
 $B6D5 JR NC,$B6DA   ; Jump to #R$B6DA to check the next token if the item is
                     ; here (carry flag clear).
 $B6D7 POP BC        ; {Restore #REGbc, #REGhl from the stack.
 $B6D8 POP HL        ; }
 $B6D9 RET           ; Return with the carry flag set, as a named item isn't
                     ; here.
*$B6DA POP BC        ; {Restore #REGbc, #REGhl from the stack.
 $B6DB POP HL        ; }
 $B6DC INC HL        ; Move to the next token in the buffer.
 $B6DD DJNZ $B6C1    ; Decrease the counter by one and loop back to #R$B6C1 until all #N$0A
                     ; tokens have been checked.
 $B6DF RET           ; Return (no valid item tokens were found in the input).

; Data
@label=Handler_ScenicEvents
b$B6E0 DEFB $3A,$F8,$AE,$A7,$C8

; Data
@label=Handler_ScenicEvents_List
b$B6E5 DEFB $47,$2A,$EC,$AE,$18,$01

; Data
@label=Handler_ScenicEvents_Loop
b$B6EB DEFB $23,$7E,$CD,$60,$B5,$20,$1F

; Data
@label=Handler_ScenicEvents_Found
b$B6F2 DEFB $22,$45,$AF,$ED

; Data
@label=Handler_ScenicEvents_Dispatch
b$B6F6 DEFB $43,$47,$AF,$3A,$F8,$AE,$90,$5F
 $B6FE DEFB $DD,$2A,$E8,$AE,$CD,$F1,$B3,$11
 $B706 DEFB $0A,$B7,$D5,$E9

; Data
@label=Handler_ScenicEvents_Restore
b$B70A DEFB $2A,$45,$AF,$ED

; Data
@label=Handler_ScenicEvents_Next
b$B70E DEFB $4B,$47,$AF,$10,$D8,$C9

; Handler: Set Current Room
;
; Used by the routine at #R$E9E1.
; .
; Move the player into the room held in #REGa and update events there.
@label=Handler_SetCurrentRoom
c$B714 LD C,A        ; Remember the destination room.
 $B715 LD A,($AEF8)  ; Read the scenic-event count into #REGa.
 $B718 AND A         ; {Skip scenic events when the game defines none.
 $B719 JR Z,$B732    ; }
 $B71B LD B,A        ; Take the scenic-event count.
 $B71C LD HL,($AEEC) ; Load the word at *#R$AEEC into #REGhl.
 $B71F JR $B722      ; Read the first scenic item at #R$B722.
@label=Handler_SetCurrentRoom_Loop
*$B721 INC HL        ; Advance #REGhl to the next byte.
@label=Handler_SetCurrentRoom_Scenic
*$B722 LD A,(HL)     ; Read this scenic item.
 $B723 CALL $B560    ; Call #R$B560 to find where the object is.
 $B726 JR NZ,$B730   ; Leave a scenic item that is not here.
 $B728 PUSH HL       ; {Keep this scenic item while it is moved.
 $B729 PUSH BC       ; }
 $B72A LD B,(HL)     ; Read the buffer byte into #REGb.
 $B72B CALL $B5FD    ; Call #R$B5FD to store the item's room.
 $B72E POP BC        ; {Restore the scenic item count and this scenic item from
 $B72F POP HL        ; the stack.}
@label=Handler_SetCurrentRoom_ScenicNext
*$B730 DJNZ $B721    ; Count down #REGb and repeat from #R$B721 until the count
                     ; is exhausted.
@label=Handler_SetCurrentRoom_Next
*$B732 LD A,C        ; Restore the destination room.
 $B733 LD ($AECD),A  ; Store #REGa in the current room.
 $B736 LD A,($AE91)  ; Read the event-state flags into #REGa.
 $B739 AND A         ; {Leave the turn-based events alone when none are armed.
 $B73A RET Z         ; }
 $B73B LD B,$08      ; Use #N$08 as the count in #REGb.
 $B73D LD HL,$AE92   ; Point #REGhl at the turn-based event items.
 $B740 LD C,A        ; Hold the event flags while each one is tested.
 $B741 JR $B744      ; Test the first turn-based event at #R$B744.
@label=Handler_SetCurrentRoom_EventLoop
*$B743 INC HL        ; Advance #REGhl to the next byte.
@label=Handler_SetCurrentRoom_Event
*$B744 SRL C         ; Test the next turn-based event flag.
 $B746 JR NC,$B750   ; Branch to #R$B750 when the carry flag is clear.
 $B748 LD A,(HL)     ; Read the item this event places in the room.
 $B749 PUSH HL       ; {Keep this turn-based event while its item is placed.
 $B74A PUSH BC       ; }
 $B74B CALL $B5DC    ; Call #R$B5DC to update the item for this room.
 $B74E POP BC        ; {Restore the event count and flags, and this turn-based
 $B74F POP HL        ; event from the stack.}
@label=Handler_SetCurrentRoom_EventNext
*$B750 DJNZ $B743    ; Count down #REGb and repeat from #R$B743 until the count
                     ; is exhausted.
 $B752 RET           ; Return.

; Handler: Match Verb
;
; Used by the routine at #R$E9A1.
; .
; Turn the first word token into a verb and run its action.
;
; .
;
; Set up to search the verb word tokens table for the first word token.
@label=HandlerMatchVerb
c$B753 LD HL,($AEEA) ; Set a pointer to the verb-token pointer in #REGhl.
 $B756 LD BC,($AEF4) ; Load the verb-token count tokens into #REGbc for the
                     ; search.
 $B75A LD A,($AF2E)  ; Get the the first word token from the user input.
 $B75D CPIR          ; Search the verb word tokens table for a matching token.
 $B75F JR Z,$B768    ; Jump to #R$B768 if a match was found (Z flag is set).
; The token doesn't match any verb.
 $B761 LD HL,$AF59   ; {Print "#MESSAGE$AF59" and start a new line.
 $B764 CALL $AC35    ; }
 $B767 RET           ; Return.
; A verb was matched! Calculate its index in the table and jump to its handler
; routine.
@label=VerbMatched
*$B768 LD A,($AEF4)  ; {Calculate the verb index: #REGa=the verb-token count-#REGc (total tokens minus
 $B76B SUB C         ; remaining tokens after match).}
 $B76C DEC A         ; Adjust the index (decrease by one, as indices are
                     ; zero-based).
 $B76D LD E,A        ; Store the verb index in #REGe for the table lookup.
 $B76E LD IX,($AEE4) ; Set a pointer to the verb-jump pointer in #REGix.
 $B772 CALL $B3F1    ; Call #R$B3F1 to get the address of the verb handler routine for this
                     ; index.
 $B775 JP (HL)       ; Jump to the verb handler routine to execute the command.

; Pause, Print String And Scroll
;
; Used by the routines at #R$E9E1, #R$EA75 and #R$EAA2.
; .
; Pause, Print String And Scroll.
@label=PausePrintStringAndScroll
c$B776 LD B,$19      ; {Call #R$AC65 to pause for the frame count in #REGb.
 $B778 CALL $AC65    ; }
 $B77B CALL $AC35    ; Call #R$AC35 to print the string and start a new line.
 $B77E RET           ; Return.

; Generate Random Number
;
; Pick a number below the limit in #REGa.
;
; A Maximum value of generated number
@label=GenerateRandomNumber
c$B77F PUSH BC       ; Remember the caller's registers.
 $B780 LD C,A        ; Remember the upper limit.
 $B781 CALL $AC69    ; Call #R$AC69 to read the frame counter.
 $B784 LD B,A        ; {Use the frame counter as the spin count.
 $B785 LD A,C        ; }
@label=GenerateRandomNumber_Loop
*$B786 DEC A         ; {Count down inside the limit.
 $B787 JR NZ,$B78A   ;
 $B789 LD A,C        ; }
@label=GenerateRandomNumber_Next
*$B78A DJNZ $B786    ; Count down #REGb and repeat from #R$B786 until the count
                     ; is exhausted.
 $B78C DEC A         ; Step the count in #REGa down.
 $B78D POP BC        ; Restore the caller's #REGbc from the stack, leaving the
                     ; random number in #REGa.
 $B78E RET           ; Return.

; Add To Score
;
; Used by the routines at #R$E9E1 and #R$FAC8.
; .
; Add the points in #REGa to the BCD score.
@label=AddToScore
c$B78F PUSH HL       ; Remember the caller's pointer.
 $B790 LD HL,($AECE) ; Load the word at the score into #REGhl.
 $B793 ADD A,L       ; {Add the points into the decimal score.
 $B794 DAA           ;
 $B795 LD L,A        ; }
 $B796 JR NC,$B799   ; Branch to #R$B799 when the carry flag is clear.
 $B798 INC H         ; Advance the count in #REGh.
@label=AddToScore_Next
*$B799 LD ($AECE),HL ; Store #REGhl in the score.
 $B79C POP HL        ; Restore the caller's pointer from the stack.
 $B79D RET           ; Return.

; Messaging: "You Have Scored"
;
; Used by the routines at #R$E9BB, #R$F77D and #R$F7C4.
; .
; Print "You Have Scored"
;
; .
;
; Print it: #MESSAGE$B1C4.
@label=Messaging_YouHaveScored_Print
c$B79E LD HL,$B1C4   ; {Point at the message and print it.
 $B7A1 CALL $AC28    ; }
 $B7A4 LD HL,($AECE) ; Load the word at the score into #REGhl.
 $B7A7 LD A,H        ; Take the hundreds digit.
 $B7A8 AND $0F       ; {Skip a leading zero in the hundreds digit.
 $B7AA JR Z,$B7B1    ; }
 $B7AC ADD A,$30     ; Add #N$30.
 $B7AE CALL $AC47    ; Call #R$AC47 to print the character.
@label=PrintScore_Tens
*$B7B1 LD A,L        ; Take the tens and units.
 $B7B2 AND $F0       ; {Print the tens digit when it is not zero.
 $B7B4 JR NZ,$B7BB   ; }
 $B7B6 LD A,H        ; {Skip a leading zero in the tens digit.
 $B7B7 AND A         ;
 $B7B8 JR Z,$B7C4    ; }
 $B7BA XOR A         ; The tens digit is zero but there is a hundreds digit, so
                     ; print a "0".
@label=PrintScore_TensDigit
*$B7BB RRCA          ; {Move the tens digit into the low four bits.
 $B7BC RRCA          ;
 $B7BD RRCA          ;
 $B7BE RRCA          ; }
 $B7BF ADD A,$30     ; Add #N$30.
 $B7C1 CALL $AC47    ; Call #R$AC47 to print the character.
@label=PrintScore_Units
*$B7C4 LD A,L        ; Take the units digit.
 $B7C5 AND $0F       ; Mask with #N$0F.
 $B7C7 ADD A,$30     ; Add #N$30.
 $B7C9 CALL $AC47    ; Call #R$AC47 to print the character.
; Print it and start a new line: #MESSAGE$B1D5.
 $B7CC LD HL,$B1D5   ; {Point at the message and print it and start a new line.
 $B7CF CALL $AC35    ; }
 $B7D2 RET           ; Return.

; Handler: Dispatch Matching Phrase
;
; Used by the routines at #R$F785, #R$F80D, #R$F8D0, #R$F93B, #R$F972, #R$F989,
; #R$F9E3, #R$FA02, #R$FA19, #R$FA38, #R$FA72, #R$FA8A, #R$FAA5, #R$FAF9,
; #R$FB50 and #R$FB92.
; .
; Find the phrase pattern that matches the command and jump to its handler.
@label=Handler_DispatchPhrase
c$B7D3 PUSH HL       ; {Copy the phrase table from #REGhl into #REGix.
 $B7D4 POP IX        ; }
@label=Handler_DispatchPhrase_Loop
*$B7D6 LD L,(IX+$00) ; {Call #R$B575 to match the phrase tokens.
 $B7D9 LD H,(IX+$01) ;
 $B7DC PUSH IX       ;
 $B7DE PUSH DE       ;
 $B7DF PUSH BC       ;
 $B7E0 CALL $B575    ; }
 $B7E3 POP BC        ; {Restore the phrase count and the handler and phrase
 $B7E4 POP DE        ; table pointers from the stack.
 $B7E5 POP IX        ; }
 $B7E7 JR NZ,$B7F4   ; Try the next phrase when this one does not match.
 $B7E9 PUSH DE       ; {Copy the handler address from #REGde into #REGix.
 $B7EA POP IX        ; }
 $B7EC LD L,(IX+$00) ; {Read the handler for this phrase.
 $B7EF LD H,(IX+$01) ; }
 $B7F2 POP DE        ; Drop the return address into the action routine, so the
                     ; phrase handler returns straight to its caller.
 $B7F3 JP (HL)       ; Jump to the handler address now in #REGhl.
@label=Handler_DispatchPhrase_Next
*$B7F4 INC IX        ; {Step to the next phrase entry.
 $B7F6 INC IX        ; }
 $B7F8 INC DE        ; Advance #REGde to the next byte.
 $B7F9 INC DE        ; Advance #REGde to the next byte.
 $B7FA DEC BC        ; Move #REGbc back one byte.
 $B7FB LD A,B        ; {See whether another phrase remains.
 $B7FC OR C          ; }
 $B7FD JR NZ,$B7D6   ; Match the next phrase.
 $B7FF RET           ; Return.

