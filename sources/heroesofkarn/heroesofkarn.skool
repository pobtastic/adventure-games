; Action: Pour
;
; Carry out the "Pour" command.
@label=Action_Pour
c$FB67 CALL $B665    ; Call #R$B665.
 $FB6A RET C         ; Return if the direct object is malformed.
 $FB6B LD A,($AECD)  ; #REGa=*#R$AECD.
; Is the current room one Pour carries into the cottage?
 $FB6E LD HL,$FB8F   ; {Search #R$FB8F for *#R$AECD.
 $FB71 LD BC,$0003   ;
 $FB74 CPIR          ; }
 $FB76 JR NZ,$FB7F   ; Jump to #R$FB7F if the room is not in that list.
 $FB78 LD ($AE79),A  ; Write #REGa to *#R$AE79.
 $FB7B LD A,$02      ; {#REGa=#N$02; jump to #R$FB8B.
 $FB7D JR $FB8B      ; }
; Returning from inside the cottage?
@label=Action_Pour_Return
*$FB7F CP $02        ; {Jump to #R$ED2B if *#R$AECD is not room #N$02:
 $FB81 JP NZ,$ED2B   ; "#ROOM$02".}
 $FB84 LD A,($AE79)  ; #REGa=*#R$AE79.
 $FB87 AND A         ; {Jump to #R$ED2B if *#R$AE79 is zero.
 $FB88 JP Z,$ED2B    ; }
@label=Action_Pour_ChangeRoom
*$FB8B CALL $E9E1    ; Call #R$E9E1.
 $FB8E RET           ; Return.

