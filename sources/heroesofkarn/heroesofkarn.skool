; Action: Pour
;
; Carry out the "Pour" command.
@label=Action_Pour
c$FB67 CALL $B665    ; {Call #R$B665 to check that the command has no object,
 $FB6A RET C         ; and return if it does not.}
 $FB6B LD A,($AECD)  ; Read the current room into #REGa.
 $FB6E LD HL,$FB8F   ; {See whether this room is one Pour carries to the
 $FB71 LD BC,$0003   ; cottage.
 $FB74 CPIR          ; }
 $FB76 JR NZ,$FB7F   ; Try to return when this room is not one of the three.
 $FB78 LD ($AE79),A  ; Store #REGa in *#R$AE79.
 $FB7B LD A,$02      ; {Take the player inside the ruined cottage.
 $FB7D JR $FB8B      ; }
@label=Action_Pour_Next
*$FB7F CP $02        ; {Branch to #R$ED2B when the exit is east.
 $FB81 JP NZ,$ED2B   ; }
 $FB84 LD A,($AE79)  ; Read *#R$AE79 into #REGa.
 $FB87 AND A         ; {Do nothing when Pour has nowhere to return.
 $FB88 JP Z,$ED2B    ; }
@label=Action_Pour_ChangeRoom
*$FB8B CALL $E9E1    ; Call #R$E9E1 to change room.
 $FB8E RET           ; Return.

; Table: Pour Tokens
;
; The rooms in which Pour carries the player to the ruined cottage.
@label=Table_PourTokens
b$FB8F DEFB $17      ; Room #N(#PEEK(#PC)).
 $FB90 DEFB $1C      ; Room #N(#PEEK(#PC)).
 $FB91 DEFB $25      ; Room #N(#PEEK(#PC)).

