; Action: Load
;
; Carry out the "Load" command.
@label=Action_Load
c$F7AC CALL $B665    ; Call #R$B665.
; The "LOAD" command can only be called on its own.
 $F7AF RET C         ; Return if the direct object is malformed.
 $F7B0 CALL $ACA8    ; Call #R$ACA8.
 $F7B3 RET NC        ; Return if the load failed.
 $F7B4 CALL $ABE1    ; Call #R$ABE1.
; Restart at the game entry point.
 $F7B7 LD HL,$ABD4   ; {Restart at #R$ABD4.
 $F7BA EX (SP),HL    ; }
 $F7BB RET           ; Return.
