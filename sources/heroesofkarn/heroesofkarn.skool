; Take: Is Player Holding Item
;
; Used by the routines at #R$EB54, #R$EB5A, #R$EB72, #R$EB9F, #R$EBB2, #R$EBD4,
; #R$EBEC, #R$EC04, #R$EC3A, #R$EC6C, #R$ECC0, #R$ED00, #R$ED3A, #R$ED65,
; #R$ED8B, #R$EDE2, #R$EE29, #R$F58F and #R$F690.
; .
; Refuse the take when the object is already carried or the inventory is
; full; otherwise return so the caller can take it.
;
;   A Object ID
; O:B The object ID (when returning so the take may proceed)
@label=Take_IsPlayerHoldingItem
c$EAF4 CALL $B5CF    ; Call #R$B5CF.
; Refuse when that object is already being carried.
 $EAF7 JR NZ,$EB17   ; Jump to #R$EB17 if the item is not being held.
 $EAF9 POP HL        ; Restore #REGhl from the stack.
; Finish the sentence "You're already carrying" with "it" or "them".
; .
; Print "#MESSAGE$B0F2".
 $EAFA LD HL,$B0F2   ; #REGhl=#R$B0F2.
; This entry point is used by the routines at #R$EB31 and #R$EB49.
; .
; Print the string at #REGhl, then finish with "it." or "them.".
@label=PrintStringAndItThemHandler
*$EAFD CALL $AC28    ; Call #R$AC28.
; Search #R$EA9D among the plural items.
@label=Take_AlreadyCarrying_CheckPlural
 $EB00 LD HL,$EA9D   ; #REGhl=#R$EA9D.
 $EB03 LD A,E        ; Copy the object ID back into #REGa.
 $EB04 LD BC,$0001   ; #REGbc=#N($0001,$04,$04).
 $EB07 CPIR          ; Search #R$EA9D for the item ID among the plural items.
 $EB09 JR Z,$EB11    ; Jump to #R$EB11 if the item is plural.
; Print "#MESSAGE$B10D".
 $EB0B LD HL,$B10D   ; #REGhl=#R$B10D.
 $EB0E JP $EA9E      ; Jump to #R$EA9E.
; Print "#MESSAGE$B111".
@label=Take_AlreadyCarrying_Them
*$EB11 LD HL,$B111   ; #REGhl=#R$B111.
 $EB14 JP $EA9E      ; Jump to #R$EA9E.
; Refuse the object when the player is already holding #N$08 things.
@label=Take_InventoryFull
*$EB17 LD A,($AE9A)  ; {Compare *#R$AE9A with #N$08.
 $EB1A CP $08        ; }
 $EB1C LD B,E        ; #REGb=#REGe.
 $EB1D RET NZ        ; Return if *#R$AE9A is not equal to #N$08.
 $EB1E POP HL        ; Restore #REGhl from the stack.
; Print "#MESSAGE$B117".
 $EB1F LD HL,$B117   ; #REGhl=#R$B117.
 $EB22 JP $EA9E      ; Jump to #R$EA9E.
; View the equivalent code in;
; #LIST
; { #FOREST$EEBA }
; { #JEWELS$F26A }
; { #ANDROMEDA$8FE2 }
; { #WARLORD$ED75 }
; LIST#

; Take Item
;
; Used by the routines at #R$EB54, #R$EB5A, #R$EB72, #R$EB9F, #R$EBB2, #R$EBD4,
; #R$EBEC, #R$EC04, #R$EC3A, #R$EC6C, #R$ECC0, #R$ED00, #R$EDE2, #R$EE29,
; #R$F58F and #R$F690.
; .
; Places the item in the player's inventory and acknowledges success.
;
; B Item ID
@label=TakeItem
c$EB25 LD C,$01      ; Load #REGc with #N$01 which indicates the item will be in the
                     ; players inventory.
 $EB27 CALL $B5FD    ; Call #R$B5FD.
 $EB2A LD HL,$AE9A   ; {Increment *#R$AE9A by one.
