; Action: Dig
;
; Carry out the "Dig" command.
@label=Action_Dig
c$FAC8 CALL $B665    ; Call #R$B665.
 $FACB RET C         ; Return if the direct object is malformed.
; Does the player have the shovel (#ITEM$60)?
 $FACC LD A,$60      ; {Jump to #R$F537 if #R$B5CF reports that #ITEM$60 is not
 $FACE CALL $B5CF    ; held.
 $FAD1 JP NZ,$F537   ; }
 $FAD4 LD A,($AECD)  ; #REGa=*#R$AECD.
; Is the player in room #N$3C: "#ROOM$3C"?
 $FAD7 CP $3C        ; {Jump to #R$F53D if *#R$AECD is not room #N$3C:
 $FAD9 JP NZ,$F53D   ; "#ROOM$3C".}
; Has this spot on the beach already been dug?
 $FADC LD HL,$AE77   ; {Jump to #R$F53D if bit 0 of *#R$AE77 is set.
 $FADF BIT 0,(HL)    ;
 $FAE1 JP NZ,$F53D   ; }
 $FAE4 SET 0,(HL)    ; Set bit 0 of *#R$AE77.
 $FAE6 LD A,$72      ; {Call #R$B5DC with item #N$72: #ITEM$72.
 $FAE8 CALL $B5DC    ; }
 $FAEB LD A,$03      ; {Call #R$B78F with #N$03.
 $FAED CALL $B78F    ; }
 $FAF0 CALL $EAE8    ; Call #R$EAE8.
; Print "#MESSAGE$DE88".
 $FAF3 LD HL,$DE88   ; #REGhl=#R$DE88.
 $FAF6 JP $EA9E      ; Jump to #R$EA9E.

