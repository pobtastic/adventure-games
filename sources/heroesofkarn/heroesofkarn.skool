; Carry out the "Light" command.
;
; .
;
; Match the phrase tokens.
@label=Action_Light
c$FB13 LD HL,$E7B5   ; #REGhl=#R$E7B5.
 $FB16 CALL $B575    ; Call #R$B575.
 $FB19 JP NZ,$EB8F   ; Jump to #R$EB8F if the tokens do not match.
 $FB1C LD A,$01      ; {#REGa=#N$01; jump to #R$FB45.
 $FB1E JR $FB45      ; }
; View the equivalent code in;
; #LIST
; { #JEWELS$FC24 }
; LIST#

