; Game Entry Point
;
; Used by the routine at #R$E9BB.
; .
; Turn caps lock on, set the screen line, and enter the cold start.
@label=GameEntryPoint
c$ABD4 LD HL,$5C6A   ; Point #REGhl at *#SKOOLKID$5C6A(FLAGS2).
 $ABD7 SET 3,(HL)    ; Turn caps lock on.
 $ABD9 LD A,$18      ; {Set the screen line to #N$18.
 $ABDB LD ($AF38),A  ; }
 $ABDE JP $B800      ; Continue at #R$B800.

; Get User Input
;
; Used by the routines at #R$AC6D, #R$B200, #R$E9BB, #R$F7AC, #R$F7C4 and
; #R$FDDB.
; .
; Wait until the player presses a key, then return that key.
;
; O:A The keypress value
@label=GetUserInput
c$ABE1 LD A,($5C3B)  ; #REGa=*#SKOOLKID$5C3B(FLAGS).
 $ABE4 BIT 5,A       ; {Jump back to #R$ABE1 until a new key is pressed.
 $ABE6 JR Z,$ABE1    ; }
 $ABE8 RES 5,A       ; Reset the "new key has been pressed" flag in #REGa.
 $ABEA LD ($5C3B),A  ; Write it back to *#SKOOLKID$5C3B(FLAGS).
; Fetch the keypress.
 $ABED LD A,($5C08)  ; #REGa=*#SKOOLKID$5C08(LAST_K).
 $ABF0 RET           ; Return.

; Clear Screen
;
; Used by the routines at #R$B41F, #R$B46B, #R$E9D3 and #R$F756.
; .
; Clear the display before a new room or a full-screen message.
@label=ClearScreen
c$ABF1 CALL $AC1A    ; Call #R$AC1A to switch to the normal screen output.
 $ABF4 CALL $0D6B    ; Clear the display with #SKOOLKID$0D6B(CLS).
 $ABF7 RET           ; Return.

; Clear Lines
;
; Clear the lines given by *#R$AF38 from the bottom of the screen.
; Nothing calls this routine.
@label=ClearLines
c$ABF8 CALL $AC1A    ; Call #R$AC1A to switch to the normal screen output.
 $ABFB LD A,($AF38)  ; {Clear the number of lines held by *#R$AF38 from the
 $ABFE LD B,A        ; bottom of the screen using #SKOOLKID$0E44(CL_LINE).
 $ABFF CALL $0E44    ; }
 $AC02 RET           ; Return.

; Set Default Screen Position
;
; Used by the routines at #R$AC3E and #R$B200.
; .
; Open the normal screen channel and park the cursor at the default line.
@label=SetDefaultScreenPosition
c$AC03 CALL $AC1A    ; Call #R$AC1A to switch to the normal screen output.
 $AC06 LD BC,$0321   ; {Call #SKOOLKID$0DD9(CL_SET).
 $AC09 CALL $0DD9    ; }
 $AC0C RET           ; Return.

; Set Screen Position
;
; Used by the routines at #R$B516, #R$E9D3 and #R$F756.
; .
; Open the normal screen channel and park the cursor on the current screen
; line.
@label=SetScreenPosition
c$AC0D CALL $AC1A    ; Call #R$AC1A to switch to the normal screen output.
 $AC10 LD A,($AF38)  ; Read the screen line into #REGa.
 $AC13 LD B,A        ; Use the screen line as the cursor row.
 $AC14 LD C,$21      ; {Call #SKOOLKID$0DD9(CL_SET).
 $AC16 CALL $0DD9    ; }
 $AC19 RET           ; Return.

; Switch To Normal Screen Output
;
; Used by the routines at #R$ABF1, #R$ABF8, #R$AC03, #R$AC0D, #R$AC28, #R$AD06,
; #R$B200 and #R$B24E.
; .
; Select the normal screen channel without losing the registers.
@label=SwitchToNormalScreenOutput
c$AC1A PUSH HL       ; {Hold the caller's values while the screen channel
 $AC1B PUSH DE       ; opens.
 $AC1C PUSH BC       ;
 $AC1D PUSH AF       ; }
 $AC1E LD A,$02      ; {Call #SKOOLKID$1601(CHAN_OPEN).
 $AC20 CALL $1601    ; }
 $AC23 POP AF        ; {Restore the caller's values from the stack.
 $AC24 POP BC        ;
 $AC25 POP DE        ;
 $AC26 POP HL        ; }
 $AC27 RET           ; Return.

; Print String
;
; Used by the routines at #R$AC35, #R$ACEA, #R$B237, #R$B46B, #R$B52B, #R$B79E
; and #R$EAFA.
; .
; Print an #N$FF-terminated string.
;
; HL Pointer to string to be printed
@label=PrintString
c$AC28 CALL $AC1A    ; Call #R$AC1A to switch to the normal screen output.
; Just keep looping and printing the fetched character until the termination
; byte is reached (#N$FF).
@label=PrintString_Loop
*$AC2B LD A,(HL)     ; Load a character from the string pointer into #REGa.
 $AC2C INC HL        ; Move the string pointer to the next character.
 $AC2D CP $FF        ; {Return if the string termination character (#N$FF) has been
 $AC2F RET Z         ; reached.}
 $AC30 CALL $AC47    ; Call #R$AC47 to print the character.
 $AC33 JR $AC2B      ; Print the next character.

; Print String And A Newline
;
; Used by the routines at #R$AC6D, #R$ACA8, #R$B1E4, #R$B1EB, #R$B1F2, #R$B1F9,
; #R$B24E, #R$B364, #R$B400, #R$B46B, #R$B516, #R$B52B, #R$B753, #R$B776,
; #R$B79E, #R$E9B5, #R$E9BB, #R$E9D3, #R$E9E1, #R$EA9E, #R$F756 and #R$F7C4.
; .
; Print an #N$FF-terminated string and move to the next line.
@label=PrintStringAndANewline
c$AC35 CALL $AC28    ; Call #R$AC28 to print the string.
; Force a newline to be "printed".
 $AC38 LD A,$0D      ; Load a "newline" character into #REGa (#N$0D).
 $AC3A CALL $AC47    ; Call #R$AC47 to print the character.
 $AC3D RET           ; Return.

; Scroll Screen
;
; Used by the routine at #R$AC47.
; .
; Scroll the screen and put the cursor back on the default line.
@label=ScrollScreen
c$AC3E EXX           ; Keep the caller's #REGbc, #REGde and #REGhl safe in the
                     ; shadow registers while the screen scrolls.
; Scroll the screen up.
 $AC3F CALL $0DFE    ; Call #SKOOLKID$0DFE(CL_SC_ALL).
; Reset the print position.
 $AC42 CALL $AC03    ; Call #R$AC03.
 $AC45 EXX           ; Bring back the caller's #REGbc, #REGde and #REGhl.
 $AC46 RET           ; Return.

; Print Character
;
; Used by the routines at #R$AC28, #R$AC35, #R$ACEA, #R$B200, #R$B24E, #R$B46B
; and #R$B79E.
; .
; Print one character on the screen channel.
;
; A The character to print
@label=PrintCharacter
c$AC47 PUSH AF       ; Keep the character to print on the stack.
 $AC48 LD A,($5C89)  ; {Jump to #R$AC62 if the line byte of
 $AC4B CP $03        ; #SKOOLKID$5C88(S_POSN) (#N$5C89) is not equal to #N$03.
 $AC4D JR NZ,$AC62   ; }
 $AC4F POP AF        ; {Restore the character to print from the stack, keeping
 $AC50 PUSH AF       ; a copy there.}
 $AC51 CP $0D        ; {Jump to #R$AC5A if this isn't a newline character
 $AC53 JR NZ,$AC5A   ; (#N$0D).}
; This is a newline, so scroll the screen up to action it.
 $AC55 CALL $AC3E    ; Call #R$AC3E.
 $AC58 POP AF        ; Clear the character off the stack (as there's nothing to print for
                     ; a newline, just the screen scroll).
 $AC59 RET           ; Return.
; Check the column position.
@label=CheckColumnPosition
*$AC5A LD A,($5C88)  ; {Call #R$AC3E if *#SKOOLKID$5C88(S_POSN) is equal to
 $AC5D CP $01        ; #N$01.
 $AC5F CALL Z,$AC3E  ; }
; Actions printing #REGa to the screen.
@label=PrintCharacterDirect
*$AC62 POP AF        ; Restore the character to print from the stack.
 $AC63 RST $10       ; Print to the screen using #SKOOLKID$0010(PRINT_A_1).
 $AC64 RET           ; Return.

; Pause Loop
;
; Used by the routines at #R$B776 and #R$EA75.
; .
; Wait for the number of frames held in #REGb.
@label=PauseLoop
c$AC65 HALT          ; Wait for the next frame.
 $AC66 DJNZ $AC65    ; Count down #REGb and repeat from #R$AC65 until the count
                     ; is exhausted.
 $AC68 RET           ; Return.

; Fetch Frames
;
; Used by the routines at #R$B373 and #R$B77F.
; .
; Read the ROM frame counter, used as a seed for chance.
@label=FetchFrames
c$AC69 LD A,($5C78)  ; Read *#SKOOLKID$5C78(FRAMES) into #REGa.
 $AC6C RET           ; Return.

; Save Game
;
; Used by the routines at #R$F7BC and #R$F7C4.
; .
; Copy the configurable exits into the save buffer and write them to tape.
@label=SaveGame
c$AC6D LD A,($AEFA)  ; Read the configurable-exit count into #REGa.
 $AC70 OR A          ; {Jump to #R$AC8C if #REGa is zero.
 $AC71 JR Z,$AC8C    ; }
; #REGb counts the exits, #REGix walks their addresses and #REGde the save
; buffer.
 $AC73 LD B,A        ; {Take the exit count and point at the exit table and the
 $AC74 LD IX,($AEE6) ; save buffer.
 $AC78 LD DE,$AE9B   ; }
 $AC7B JR $AC82      ; Start with the first configurable exit.
@label=SaveGame_CopyExit
*$AC7D INC IX        ; {Copy each configurable exit's current destination into
 $AC7F INC IX        ; the save buffer.
 $AC81 INC DE        ;
*$AC82 LD L,(IX+$00) ;
 $AC85 LD H,(IX+$01) ;
 $AC88 LD A,(HL)     ;
 $AC89 LD (DE),A     ;
 $AC8A DJNZ $AC7D    ; }
@label=SaveGame_StartTape
*$AC8C LD HL,$B05A   ; {Print "#MESSAGE$B05A" and start a new line.
 $AC8F CALL $AC35    ; }
 $AC92 CALL $ABE1    ; Call #R$ABE1 to read the player's key.
 $AC95 LD IX,$AD76   ; Point #REGix at the item-location table.
 $AC99 LD DE,$0186   ; {Save #N$0186 bytes from the item-location table to tape
 $AC9C LD A,$FF      ; as a data block.
 $AC9E CALL $04C2    ; }
 $ACA1 LD HL,$B07C   ; {Print "#MESSAGE$B07C" and start a new line.
 $ACA4 CALL $AC35    ; }
 $ACA7 RET           ; Return.

; Load From Tape
;
; Used by the routine at #R$F7AC.
; .
; Read a save block back from tape into the configurable exits.
@label=LoadFromTape
c$ACA8 LD HL,$B01F   ; {Print "#MESSAGE$B01F" and start a new line.
 $ACAB CALL $AC35    ; }
 $ACAE LD IX,$AD76   ; Load the starting address into #REGix at the
                     ; item-location table.
 $ACB2 LD DE,$0186   ; Set the block length in #REGde to #N$0186 bytes.
 $ACB5 LD A,$FF      ; Set #REGa to #N$FF which indicates this is a data block.
 $ACB7 SCF           ; Set the carry flag to indicate this is loading.
 $ACB8 CALL $0556    ; Call #SKOOLKID$0556(LD_BYTES).
 $ACBB JR C,$ACC5    ; Branch to #R$ACC5 if the block loaded without error
                     ; (carry flag set).
 $ACBD LD HL,$B034   ; {Print "#MESSAGE$B034" and start a new line.
 $ACC0 CALL $AC35    ; }
 $ACC3 SCF           ; Set the carry flag to report that the load failed, so
                     ; #R$F7AC restarts the game.
 $ACC4 RET           ; Return.
@label=LoadTape_Success
*$ACC5 LD A,($AEFA)  ; Read the configurable-exit count into #REGa.
 $ACC8 OR A          ; {Return if #REGa is zero.
 $ACC9 RET Z         ; }
; #REGb counts the exits, #REGix walks their addresses and #REGde the save
; buffer.
 $ACCA LD B,A        ; {Take the exit count and point at the exit table and the
 $ACCB LD IX,($AEE6) ; save buffer.
 $ACCF LD DE,$AE9B   ; }
 $ACD2 JR $ACD9      ; Restore the first configurable exit.
@label=LoadTape_RestoreExit
*$ACD4 INC IX        ; {Copy each saved destination back into the configurable
 $ACD6 INC IX        ; exits.
 $ACD8 INC DE        ;
*$ACD9 LD L,(IX+$00) ;
 $ACDC LD H,(IX+$01) ;
 $ACDF LD A,(DE)     ;
 $ACE0 LD (HL),A     ;
 $ACE1 DJNZ $ACD4    ; }
 $ACE3 LD E,$00      ; {Show the room picture only when it has not already been
 $ACE5 CALL $B41F    ; seen.}
 $ACE8 AND A         ; Clear the carry flag to report that the load worked, so
                     ; #R$F7AC goes back to the game.
 $ACE9 RET           ; Return.

; Print Input Prompt
;
; Used by the routine at #R$B200.
; .
; Print the input prompt.
@label=PrintInputPrompt
c$ACEA LD HL,$5080   ; Point at the prompt graphic in the display file.
 $ACED LD DE,$0100   ; Set the increment in #REGde for the next screen line.
 $ACF0 LD B,$08      ; {Scan the eight pixel rows of the prompt cell.
 $ACF2 XOR A         ; }
@label=PrintInputPrompt_Loop
*$ACF3 OR (HL)       ; Collect the pixels of this row of the prompt cell.
 $ACF4 ADD HL,DE     ; Move down one line.
 $ACF5 DJNZ $ACF3    ; Repeat for all eight pixel rows, so #REGa is non-zero if
                     ; anything is already drawn in the cell.
 $ACF7 OR A          ; {Jump to #R$ACFF if #REGa is zero.
 $ACF8 JR Z,$ACFF    ; }
; Force a newline to be "printed".
 $ACFA LD A,$0D      ; Use the ENTER key code.
 $ACFC CALL $AC47    ; Call #R$AC47 to print the character.
@label=PrintPrompt
*$ACFF LD HL,$AF4D   ; {Print "#MESSAGE$AF4D".
 $AD02 CALL $AC28    ; }
 $AD05 RET           ; Return.

; Print Room Graphic
;
; Used by the routine at #R$AD60.
; .
; Expand one compressed room picture into the display.
;
; IX Pointer to room image data
@label=PrintRoomGraphic
c$AD06 CALL $AC1A    ; Call #R$AC1A to switch to the normal screen output.
 $AD09 LD BC,$1821   ; Park the cursor where the room picture is printed.
 $AD0C CALL $0DD9    ; Call #SKOOLKID$0DD9(CL_SET).
; Reset graphic display area.
 $AD0F LD HL,$5C8F   ; Point #REGhl at #SKOOLKID$5C8F(ATTR_T) which holds the
                     ; current attribute value.
 $AD12 LD A,(HL)     ; Fetch the attribute byte.
 $AD13 AND %00111000 ; Keep only the PAPER bits 3-5.
 $AD15 RRA           ; {Move the PAPER bits into the INK bits.
 $AD16 RRA           ;
 $AD17 RRA           ; }
 $AD18 LD B,A        ; Store the result in #REGb.
 $AD19 LD A,(HL)     ; Fetch the attribute byte again.
 $AD1A AND %11111000 ; Keep everything except the INK bits.
 $AD1C OR B          ; Combine the two values.
 $AD1D LD (HL),A     ; Write the result back to *#SKOOLKID$5C8F(ATTR_T).
 $AD1E LD BC,$0200   ; Set a byte counter in #REGbc of #N($0200,$04,$04).
@label=Print_RoomGraphic_Loop
*$AD21 PUSH BC       ; Keep the byte counter on the stack.
 $AD22 LD HL,$AF3D   ; Point #REGhl at the character-cell buffer.
 $AD25 LD B,$08      ; Take the eight pixel rows of this character cell.
 $AD27 LD C,(IX+$00) ; Take this cell's mask byte.
 $AD2A INC IX        ; Move past the mask byte.
 $AD2C JR $AD2F      ; Expand the first row of this cell.
*$AD2E INC HL        ; Step to the next row of the cell.
*$AD2F SRL C         ; Test the next mask bit.
 $AD31 JR NC,$AD3A   ; Skip the stored row when this mask bit is clear.
 $AD33 LD A,(IX+$00) ; Take the pixel row stored for this mask bit.
 $AD36 INC IX        ; Move past that pixel row.
 $AD38 JR $AD3B      ; Store the pixel row for this mask bit.
*$AD3A XOR A         ; Use a blank pixel row when this mask bit is clear.
*$AD3B LD (HL),A     ; Store the row in this cell.
 $AD3C DJNZ $AD2E    ; Repeat for all eight pixel rows of this character cell.
 $AD3E LD DE,$AF3D   ; Point #REGde at the character-cell buffer.
 $AD41 CALL $0B03    ; Call #SKOOLKID$0B03(PO_FETCH).
 $AD44 CALL $0B7F    ; Call PR_ALL at #N$0B7F, part of #SKOOLKID$0B24(PO_ANY).
 $AD47 CALL $0ADC    ; Call #SKOOLKID$0ADC(PO_STORE).
 $AD4A POP BC        ; Restore the byte counter from the stack.
 $AD4B DEC BC        ; Decrease the byte counter by one.
 $AD4C LD A,C        ; {Jump back to #R$AD21 until the byte counter is zero.
 $AD4D OR B          ;
 $AD4E JR NZ,$AD21   ; }
 $AD50 CALL $0D4D    ; Call #SKOOLKID$0D4D(TEMPS).
 $AD53 RET           ; Return.

; Colour Room Image
;
; Used by the routine at #R$AD60.
; .
; Copy the picture's attribute bytes onto the screen.
;
; IX Pointer to the room attribute data
@label=ColourRoomImage
c$AD54 LD DE,$5800   ; Point #REGde at the attribute file.
 $AD57 PUSH IX       ; {Copy the attribute pointer from #REGix into #REGhl.
 $AD59 POP HL        ; }
 $AD5A LD BC,$0200   ; Use #N$0200 as the count in #REGbc.
 $AD5D LDIR          ; Copy the counted bytes from #REGhl to #REGde.
 $AD5F RET           ; Return.

; Print Room Image
;
; Used by the routine at #R$FDDB.
; .
; Draw the room picture and then colour it.
@label=Print_RoomImage
c$AD60 CALL $AD06    ; Call #R$AD06 to draw the room picture.
 $AD63 CALL $AD54    ; Call #R$AD54 to colour the room picture.
 $AD66 RET           ; Return.

; Clear Room Image
;
; Copy one attribute byte across the #N$0200 cells of the picture.
; Nothing calls this routine.
;
; A Attribute byte value
@label=ClearRoomImage
c$AD67 LD BC,$0200   ; Set a counter in #REGbc of #N$0200 bytes.
 $AD6A LD HL,$5800   ; Point #REGhl at the attribute buffer (#N$5800).
 $AD6D LD E,A        ; Copy the attribute byte into #REGe.
@label=ClearRoomImage_Loop
*$AD6E LD (HL),E     ; Write the byte to the attribute buffer.
 $AD6F INC HL        ; Advance #REGhl to the next cell.
 $AD70 DEC BC        ; Step the picture-cell count down.
 $AD71 LD A,B        ; {See whether any picture cells remain.
 $AD72 OR C          ; }
 $AD73 JR NZ,$AD6E   ; Branch to #R$AD6E while cells remain.
 $AD75 RET           ; Return.

