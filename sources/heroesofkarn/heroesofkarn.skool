; Tape Loader
;
; Load the screen, the room pictures and the game. The last block falls
; straight into the tape loading routine.
;
; .
;
; Load the first block: the loading screen.
@label=TapeLoader
c$5B00 LD IX,$4000   ; {Load #N$1B00 bytes of the loading screen to #N$4000
 $5B04 LD DE,$1B00   ; with flag byte #N$D7.
 $5B07 LD A,$D7      ;
 $5B09 CALL $5B21    ; }
; Load the second block: the room pictures.
 $5B0C LD IX,$61A8   ; {Load #N$4A2C bytes of picture data to #R$61A8 with flag
 $5B10 LD DE,$4A2C   ; byte #N$0A.
 $5B13 LD A,$0A      ;
 $5B15 CALL $5B21    ; }
; Load the third block: the game. Execution falls into #R$5B21.
 $5B18 LD IX,$ABD4   ; {Load #N$5235 bytes of the game to #R$ABD4 with flag
 $5B1C LD DE,$5235   ; byte #N$2B.
 $5B1F LD A,$2B      ; }

; Tape Loading
;
; Used by the routine at #R$5B00.
; .
; Pull one tape block into the address and length set up by the caller.
;
; .
;
; Tape loading routine.
@label=TapeLoading
c$5B21 SCF           ; Set the carry flag to indicate "loading".
 $5B22 INC D         ; This resets the Z flag (#REGd cannot hold +#N$FF.)
 $5B23 EX AF,AF'     ; The #REGa register holds +#N$00 for a header and +#N$FF for a block
                     ; of data. The carry flag is reset for verifying and set for loading.
 $5B24 DEC D         ; Put back #REGd to its original value.
 $5B25 DI            ; Disable interrupts while the tape loads, as the start of
                     ; #SKOOLKID$0556(LD_BYTES) would.
 $5B26 LD A,$0F      ; {Set the border to #INK$0F.
 $5B28 OUT ($FE),A   ; }
 $5B2A CALL $0562    ; Call #SKOOLKID$0556(LD_BYTES) at #N$0562.
 $5B2D PUSH AF       ; Remember whether the block loaded.
 $5B2E LD A,($5C48)  ; #REGa=*#SKOOLKID$5C48(BORDCR).
 $5B31 AND %00111000 ; Keep the border colour (bits 3-5 of
                     ; *#SKOOLKID$5C48(BORDCR)).
 $5B33 RRC A         ; {Move the border colour into the low three bits.
 $5B35 RRC A         ;
 $5B37 RRC A         ; }
 $5B39 OUT ($FE),A   ; Set border to the colour held by #REGa.
 $5B3B LD A,$7F      ; {See whether SPACE is pressed.
 $5B3D IN A,($FE)    ;
 $5B3F RRA           ; }
 $5B40 EI            ; Re-enable interrupts, as the ROM does when its own load
                     ; ends.
 $5B41 JP NC,$0000   ; Jump to #SKOOLKID$0000(START) if the carry flag is not
                     ; set.
 $5B44 POP AF        ; Restore the load result from the stack (the carry flag
                     ; is set when the block loaded).
 $5B45 RET C         ; Return if the carry flag is set.
 $5B46 LD HL,($5C53) ; {Write *#SKOOLKID$5C53(PROG) to *#SKOOLKID$5C4B(VARS).
 $5B49 LD ($5C4B),HL ; }
 $5B4C LD (HL),$80   ; Write #N$80 to *#SKOOLKID$5C53(PROG).
 $5B4E RST $08       ; Call #SKOOLKID$0008(ERROR_1).

; Unused
;
; The remainder of the printer buffer after the tape loader at #R$5B00.
; The game does not read these bytes.
u$5B4F DEFB $1A
 $5B50 DEFS $B0

