; Table: Configurable Exits
;
; One word per configurable exit. Each entry points at the exit record
; Game Start clears.
@label=Table_ConfigurableExits
w$E972 DEFW $E80C
 $E974 DEFW $E812
 $E976 DEFW $E81D
 $E978 DEFW $E84C
 $E97A DEFW $E860
 $E97C DEFW $E867
 $E97E DEFW $E86D
 $E980 DEFW $E87D
 $E982 DEFW $E89A
 $E984 DEFW $E8A9
 $E986 DEFW $E8AC
 $E988 DEFW $E8BA
 $E98A DEFW $E8C1
 $E98C DEFW $E8EB
 $E98E DEFW $E8F5
 $E990 DEFW $E90C
 $E992 DEFW $E924
 $E994 DEFW $E931
 $E996 DEFW $E944
 $E998 DEFW $E95E
 $E99A DEFW $E86B
 $E99C DEFW $E963
; View the equivalent code in;
; #LIST
; { #FOREST$EB02 }
; { #JEWELS$ED9E }
; { #WARLORD$E978 }
; LIST#

; Jump to Game Start
;
; Used by the routine at #R$B800.
; .
; Game Cold Start lands here and jumps on to Game Start.
@label=Jump_GameStart
c$E99E JP $FBA9      ; Continue at #R$FBA9.

; Game Loop
;
; Used by the routine at #R$FBA9.
; .
; One turn: run events, read a command, and dispatch its verb.
@label=GameLoop
c$E9A1 CALL $B373    ; Call #R$B373 to advance the turn-based events.
 $E9A4 XOR A         ; {Clear the turn scratch flag (#N$08 marks an attack).
 $E9A5 LD ($AE78),A  ; }
 $E9A8 CALL $B200    ; Call #R$B200 to read the next command.
 $E9AB CALL $B6BC    ; Call #R$B6BC to apply the command to the item.
 $E9AE JR C,$E9A1    ; Start the next turn without running the verb if a named item isn't
                     ; here (carry set by #R$B6BC).
 $E9B0 CALL $B753    ; Call #R$B753 to run the verb.
 $E9B3 JR $E9A1      ; Take another turn at #R$E9A1.
; View the equivalent code in;
; #LIST
; { #FOREST$EB10 }
; { #JEWELS$EDC4 }
; { #ANDROMEDA$8D2A }
; { #WARLORD$E99F }
; LIST#

; Game Over
;
; Print "You are dead." and fall into the play-again question.
;
; .
;
; Print it and start a new line: #MESSAGE$AFF9.
@label=GameOver
c$E9B5 LD HL,$AFF9   ; {Point at the message and print it and start a new line.
 $E9B8 CALL $AC35    ; }
; View the equivalent code in;
; #LIST
; { #SHOCK$AE0D }
; { #FOREST$EB23 }
; { #JEWELS$EDD7 }
; { #ANDROMEDA$8DB3 }
; { #WARLORD$E9B2 }
; LIST#

; Want Another Game Input
;
; Used by the routine at #R$E9D3.
; .
; Ask To Play Again.
@label=WantAnotherGameInput
c$E9BB CALL $B79E    ; Call #R$B79E to tell the player the score.
; Print it and start a new line: #MESSAGE$B007.
 $E9BE LD HL,$B007   ; {Point at the message and print it and start a new line.
 $E9C1 CALL $AC35    ; }
@label=WantAnotherGameInput_Loop
*$E9C4 CALL $ABE1    ; Call #R$ABE1 to read the player's key.
 $E9C7 CP $4E        ; {Branch to #SKOOLKID$0000(START) when the player pressed
 $E9C9 JP Z,$0000    ; "N".}
 $E9CC CP $59        ; {Branch to #R$ABD4 when the player pressed "Y".
 $E9CE JP Z,$ABD4    ; }
 $E9D1 JR $E9C4      ; Ask again at #R$E9C4 when the key is neither Y nor N.
; View the equivalent code in;
; #LIST
; { #ANDROMEDA$8DB9 }
; LIST#

; Game Complete
;
; Used by the routine at #R$E9E1.
; .
; Announce that the quest is over and offer another game.
@label=GameComplete
c$E9D3 CALL $ABF1    ; Call #R$ABF1 to clear the screen.
 $E9D6 CALL $AC0D    ; Call #R$AC0D to park the cursor on the current screen
                     ; line.
 $E9D9 LD HL,$CF7A   ; {Call #R$AC35 to print the string and start a new line.
 $E9DC CALL $AC35    ; }
 $E9DF JR $E9BB      ; Offer another game at #R$E9BB.
; View the equivalent code in;
; #LIST
; { #FOREST$EB3E }
; { #JEWELS$EDF2 }
; { #ANDROMEDA$8DCE }
; LIST#

; Change Room
;
; Used by the routines at #R$EA75, #R$F7FA, #R$FB67 and #R$FBA9.
; .
; Commits a move into the destination room held in #REGa. It handles
; the Hall of the Phoenix and the ruined cottage, calls #R$B714 to update
; the current room, then jumps to #R$EA75 to describe the new room.
;
; A Destination room ID
;
; Entering the Hall of the Phoenix is fatal. Bit 0 of *#R$AE76, when
; set, means the firegate does not incinerate the player.
@label=ChangeRoom
c$E9E1 CP $37        ; {Jump to #R$E9F8 if the destination is not room #N$37:
 $E9E3 JR NZ,$E9F8   ; "#ROOM$37".}
 $E9E5 LD HL,$AE76   ; {Jump to #R$E9F8 if bit 0 of *#R$AE76 is set.
 $E9E8 BIT 0,(HL)    ;
 $E9EA JR NZ,$E9F8   ; }
; The player is dead, so do not resume the movement handler.
 $E9EC POP HL        ; Discard the calling address of #R$E9E1.
 $E9ED LD HL,$E9B5   ; {Switch #R$E9B5 onto the stack so the next return actions a "game
 $E9F0 EX (SP),HL    ; over".}
; Print "#MESSAGE$D04C".
 $E9F1 LD HL,$D04C   ; {Point #REGhl at #R$D04C and print it and start a new
 $E9F4 CALL $AC35    ; line.}
 $E9F7 RET           ; Return.
; Leaving the Hall of the Phoenix.
@label=ChangeRoom_LeavePhoenix
*$E9F8 LD C,A        ; Copy the destination room ID into #REGc.
 $E9F9 LD A,($AECD)  ; Fetch *#R$AECD into #REGa.
 $E9FC CP $37        ; {Jump to #R$EA36 if the current room is not #N$37:
 $E9FE JR NZ,$EA36   ; "#ROOM$37".}
 $EA00 LD HL,$AE76   ; {Jump to #R$EA36 if bit 1 of *#R$AE76 is set.
 $EA03 BIT 1,(HL)    ;
 $EA05 JR NZ,$EA36   ; }
; South into the Hall of Black Magic turns the ashes into a phoenix.
 $EA07 LD A,$3F      ; {Jump to #R$EA23 if the destination is not room #N$3F:
 $EA09 CP C          ; "#ROOM$3F".
 $EA0A JR NZ,$EA23   ; }
 $EA0C LD BC,$8182   ; {Call #R$B613 to transform #ITEM$81 into #ITEM$82.
 $EA0F CALL $B613    ; }
; This action changes the map:
 $EA12 XOR A         ; {Write #N$00 to close southbound access to #ROOM$3F from
 $EA13 LD ($E931),A  ; #ROOM$37.}
; Print "#MESSAGE$D087".
@label=ChangeRoom_AshesBurst
 $EA16 LD HL,$D087   ; {Point #REGhl at #R$D087 and print it and start a new
 $EA19 CALL $AC35    ; line.}
; Print "#MESSAGE$D0B0".
@label=ChangeRoom_PhoenixAppears
 $EA1C LD HL,$D0B0   ; {Point #REGhl at #R$D0B0 and pause, print it and scroll.
 $EA1F CALL $B776    ; }
 $EA22 RET           ; Return.
; Any other exit from the Hall of the Phoenix turns the phoenix back
; into ashes and opens the south.
@label=ChangeRoom_PhoenixToAshes
*$EA23 LD A,C        ; Copy the destination room ID into #REGa.
 $EA24 PUSH AF       ; Stash the destination room ID on the stack.
 $EA25 LD A,$82      ; {Call #R$B5D5 with item #N$82: #ITEM$82.
 $EA27 CALL $B5D5    ; }
 $EA2A LD A,$81      ; {Call #R$B5DC with item #N$81: #ITEM$81.
 $EA2C CALL $B5DC    ; }
; This action changes the map:
 $EA2F LD A,$3F      ; {Write #N$3F to open southbound access to #ROOM$3F from
 $EA31 LD ($E931),A  ; #ROOM$37.}
 $EA34 POP AF        ; Restore the destination room ID from the stack.
 $EA35 LD C,A        ; Copy it into #REGc.
; Move into the destination room.
@label=ChangeRoom_EnterRoom
*$EA36 LD A,C        ; Copy the destination room ID into #REGa.
 $EA37 CALL $B714    ; Call #R$B714 to move the player into the room.
; Winning in the ruined cottage.
 $EA3A LD A,($AECD)  ; Fetch *#R$AECD into #REGa.
 $EA3D CP $02        ; {Jump to #R$EA75 if it is not room #N$02: "#ROOM$02".
 $EA3F JR NZ,$EA75   ; }
 $EA41 LD A,($AE91)  ; Fetch *#R$AE91 into #REGa.
 $EA44 CP $0F        ; {Jump to #R$EA75 if it is not #N$0F (all four heroes
 $EA46 JR NZ,$EA75   ; following).}
 $EA48 LD HL,$EA70   ; {Count how many of the five gems at #R$EA70 are here.
 $EA4B LD B,$05      ;
 $EA4D LD C,$00      ; }
; Count each gem that is here.
@label=Cottage_CountGem
*$EA4F LD A,(HL)     ; Fetch the next gem item ID.
 $EA50 CALL $B560    ; Call #R$B560 to test whether it is here.
 $EA53 JR NZ,$EA56   ; Jump to #R$EA56 if it is not here.
 $EA55 INC C         ; Count a gem that is here.
; Continue the gem count.
@label=Cottage_CountGem_Next
*$EA56 INC HL        ; Advance to the next gem.
 $EA57 DJNZ $EA4F    ; Decrease the gem counter by one and loop back to #R$EA4F until
                     ; it is zero.
 $EA59 LD A,$05      ; {Jump to #R$EA75 if fewer than five gems are here.
 $EA5B CP C          ;
 $EA5C JR NZ,$EA75   ; }
 $EA5E LD HL,$E504   ; {Call #R$B5EC with the jade-flower group at #R$E504.
 $EA61 CALL $B5EC    ; }
 $EA64 JR NZ,$EA75   ; Jump to #R$EA75 if the jade flower is neither here nor
                     ; carried.
; The game is won, so do not resume the movement handler or the
; command loop.
 $EA66 POP HL        ; {Discard the return address of #R$E9E1 and of its
 $EA67 POP HL        ; caller.}
 $EA68 LD A,$04      ; {Call #R$B78F to score four points.
 $EA6A CALL $B78F    ; }
 $EA6D JP $E9D3      ; Jump to #R$E9D3.
; View the equivalent code in;
; #LIST
; { #SHOCK$AD79 }
; { #FOREST$ECB6 }
; { #JEWELS$EF54 }
; { #ANDROMEDA$8E18 }
; { #WARLORD$EB10 }
; LIST#

; Table: Gems
;
; The ruby, diamond, sapphire, emerald and pearl counted in the cottage.
@label=Table_Gems
b$EA70 DEFB $4A      ; Item #N(#PEEK(#PC)).
 $EA71 DEFB $4D      ; Item #N(#PEEK(#PC)).
 $EA72 DEFB $5C      ; Item #N(#PEEK(#PC)).
 $EA73 DEFB $72      ; Item #N(#PEEK(#PC)).
 $EA74 DEFB $75      ; Item #N(#PEEK(#PC)).

; Handler: Show The New Room
;
; Used by the routine at #R$E9E1.
; .
; Draw the new room after a move.
@label=Handler_ShowNewRoom
c$EA75 LD E,$00      ; {Call #R$B41F to show the room picture.
 $EA77 CALL $B41F    ; }
 $EA7A LD A,$84      ; {Call #R$B560 with item #N$84 (unnamed; the guard
 $EA7C CALL $B560    ; arrest).}
 $EA7F JR NZ,$EA9C   ; Skip the arrest when that item is not here.
 $EA81 LD A,$84      ; {Call #R$B5D5 with item #N$84 (unnamed; the guard
 $EA83 CALL $B5D5    ; arrest).}
; Print "#MESSAGE$D154".
 $EA86 LD HL,$D154   ; {Point #REGhl at #R$D154 and pause, print it and scroll.
 $EA89 CALL $B776    ; }
; Print "#MESSAGE$D168".
 $EA8C LD HL,$D168   ; {Point #REGhl at #R$D168 and pause, print it and scroll.
 $EA8F CALL $B776    ; }
 $EA92 LD B,$64      ; {Call #R$AC65 to pause for the frame count in #REGb.
 $EA94 CALL $AC65    ; }
 $EA97 LD A,$3A      ; Take the player to room #N$3A: "#ROOM$3A".
 $EA99 JP $E9E1      ; Jump to #R$E9E1.
; The guard is not in this room.
@label=Handler_ShowNewRoom_Next
*$EA9C RET           ; Return.

; Table: Items Which Are Plural
