 $F6B3 JP $EA9E      ; Jump to #R$EA9E.

; Close: Scroll
;
; Close the scroll.
@label=Close_Scroll
c$F6B6 LD A,$25      ; {Call #R$EB49 with item #N$25: #ITEM$25.
 $F6B8 CALL $EB49    ; }
 $F6BB LD HL,$AE78   ; {Jump to #R$EAD6 if bit 1 of *#R$AE78 is not set.
 $F6BE BIT 1,(HL)    ;
 $F6C0 JP Z,$EAD6    ; }
; Print "#MESSAGE$E13F".
 $F6C3 LD HL,$E13F   ; #REGhl=#R$E13F.
 $F6C6 JP $EA9E      ; Jump to #R$EA9E.

; Wave: Lyre
;
; Wave the golden lyre.
@label=Wave_Lyre
c$F6C9 LD A,$45      ; {Call #R$EB49 with item #N$45: #ITEM$45.
 $F6CB CALL $EB49    ; }
 $F6CE LD HL,$AE78   ; {Jump to #R$EAE8 if bit 2 of *#R$AE78 is not set.
 $F6D1 BIT 2,(HL)    ;
 $F6D3 JP Z,$EAE8    ; }
 $F6D6 LD A,$4E      ; {Call #R$B560 with item #N$4E: #ITEM$4E.
 $F6D8 CALL $B560    ; }
 $F6DB JP NZ,$EAE8   ; Jump to #R$EAE8 if the Z flag is not set.
 $F6DE LD BC,$4E4F   ; {Call #R$B613 to transform #ITEM$4E into #ITEM$4F.
 $F6E1 CALL $B613    ; }
 $F6E4 LD A,$03      ; {Call #R$B78F with #N$03.
 $F6E6 CALL $B78F    ; }
; Print "#MESSAGE$E169".
 $F6E9 LD HL,$E169   ; #REGhl=#R$E169.
 $F6EC JP $EA9E      ; Jump to #R$EA9E.

; Play: Pirate With Dagger
;
; Play the dagger against the pirate.
@label=Play_PirateWithDagger
c$F6EF LD A,$63      ; {Call #R$B560 with item #N$63: #ITEM$63.
 $F6F1 CALL $B560    ; }
 $F6F4 JP Z,$F320    ; Jump to #R$F320 if the Z flag is set.
 $F6F7 LD A,$31      ; {Call #R$EB49 with item #N$31: #ITEM$31.
 $F6F9 CALL $EB49    ; }
 $F6FC LD HL,$AE78   ; {Jump to #R$F3F5 if bit 3 of *#R$AE78 is not set.
 $F6FF BIT 3,(HL)    ;
 $F701 JP Z,$F3F5    ; }
 $F704 LD BC,$6263   ; {Call #R$B613 to transform #ITEM$62 into #ITEM$63.
 $F707 CALL $B613    ; }
 $F70A LD A,$03      ; {Call #R$B78F with #N$03.
 $F70C CALL $B78F    ; }
; Print "#MESSAGE$E1C5".
 $F70F LD HL,$E1C5   ; #REGhl=#R$E1C5.
 $F712 JP $EA9E      ; Jump to #R$EA9E.

; Action: Help
;
; Carry out the "Help" command.
@label=Action_Help
c$F715 CALL $B665    ; Call #R$B665.
 $F718 RET C         ; Return if the direct object is malformed.
; Is #ITEM$06 in the current room?
 $F719 LD A,$06      ; {Jump to #R$EAA6 if #R$B560 reports that #ITEM$06 is
 $F71B CALL $B560    ; present.
 $F71E JP Z,$EAA6    ; }
; Is #ITEM$2C in the current room?
 $F721 LD A,$2C      ; {Jump to #R$EAA6 if #R$B560 reports that #ITEM$2C is
 $F723 CALL $B560    ; present.
 $F726 JP Z,$EAA6    ; }
; Is #ITEM$07 in the current room?
 $F729 LD A,$07      ; {Jump to #R$F736 if #R$B560 reports that #ITEM$07 is not
 $F72B CALL $B560    ; present.
 $F72E JR NZ,$F736   ; }
; Print "#MESSAGE$D106".
 $F730 LD HL,$D106   ; #REGhl=#R$D106.
 $F733 JP $EA9E      ; Jump to #R$EA9E.
; Is #ITEM$4E in the current room?
@label=Action_Help_Next
*$F736 LD A,$4E      ; {Jump to #R$EAAC if #R$B560 reports that #ITEM$4E is
 $F738 CALL $B560    ; present.
 $F73B JP Z,$EAAC    ; }
 $F73E LD A,($AECD)  ; #REGa=*#R$AECD.
; Is the player in room #N$23: "#ROOM$23"?
 $F741 CP $23        ; {Jump to #R$EAAC if *#R$AECD is room #N$23: "#ROOM$23".
 $F743 JP Z,$EAAC    ; }
; Is #ITEM$56 in the current room?
 $F746 LD A,$56      ; {Jump to #R$EAB2 if #R$B560 reports that #ITEM$56 is not
 $F748 CALL $B560    ; present.
 $F74B JR NZ,$F753   ; }
; Print "#MESSAGE$D12B".
 $F74D LD HL,$D12B   ; #REGhl=#R$D12B.
 $F750 JP $EA9E      ; Jump to #R$EA9E.
@label=Action_Help_Next2
*$F753 JP $EAB2      ; Jump to #R$EAB2.
; View the equivalent code in;
; #LIST
; { #FOREST$EDC3 }
; { #JEWELS$F09C }
; { #ANDROMEDA$8E8D }
; LIST#

; Action: Inventory
;
; Carry out the "Inventory" command.
@label=Action_Inventory
c$F756 CALL $B665    ; Call #R$B665.
; The "INVENTORY" command can only be called on its own.
 $F759 RET C         ; Return if the direct object is malformed.
 $F75A LD A,($AE9A)  ; {Jump to #R$EAB8 if *#R$AE9A is zero (the player isn't holding any
 $F75D AND A         ; items).
 $F75E JP Z,$EAB8    ; }
; Clear the screen and display the players inventory.
 $F761 CALL $ABF1    ; Call #R$ABF1.
 $F764 CALL $AC0D    ; Call #R$AC0D.
; Print "#MESSAGE$B131".
 $F767 LD HL,$B131   ; {Print "#MESSAGE$B131" and start a new line.
 $F76A CALL $AC35    ; }
 $F76D LD A,$01      ; {Call #R$B400 with a room ID of #N$01 which is the players
 $F76F CALL $B400    ; inventory.}
 $F772 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SHOCK$A6CF }
; { #FOREST$EDE8 }
; { #JEWELS$F12E }
; { #ANDROMEDA$8EC4 }
; { #WARLORD$F824 }
; LIST#

; Action: Look
;
; Carry out the "Look" command.
@label=Action_Look
c$F773 CALL $B665    ; Call #R$B665.
; The "LOOK" command can only be called on its own.
 $F776 RET C         ; Return if the direct object is malformed.
 $F777 LD E,$01      ; {Call #R$B41F with #REGe set to #N$01 (which will force any room
 $F779 CALL $B41F    ; images to be re-displayed).}
 $F77C RET           ; Return.
