; Action: Load
;
; Carry out the "Load" command.
@label=Action_Load
c$F7AC CALL $B665    ; {Call #R$B665 to check that the command has no object,
 $F7AF RET C         ; and return if it does not.}
 $F7B0 CALL $ACA8    ; {Call #R$ACA8 to read the saved game from tape, and
 $F7B3 RET NC        ; return if it does not.}
 $F7B4 CALL $ABE1    ; Call #R$ABE1 to read the player's key.
 $F7B7 LD HL,$ABD4   ; {Restart at the game entry point.
 $F7BA EX (SP),HL    ; }
 $F7BB RET           ; Return.

; Action: Save
;
; Carry out the "Save" command.
@label=Action_Save
c$F7BC CALL $B665    ; {Call #R$B665 to check that the command has no object,
 $F7BF RET C         ; and return if it does not.}
 $F7C0 CALL $AC6D    ; Call #R$AC6D to write the game to tape.
 $F7C3 RET           ; Return.

; Action: Quit
;
; Carry out the "Quit" command.
@label=Action_Quit
c$F7C4 CALL $B665    ; {Call #R$B665 to check that the command has no object,
 $F7C7 RET C         ; and return if it does not.}
 $F7C8 CALL $B79E    ; Call #R$B79E to tell the player the score.
; Print it and start a new line: #MESSAGE$B097.
 $F7CB LD HL,$B097   ; {Point at the message and print it and start a new line.
 $F7CE CALL $AC35    ; }
@label=Action_Quit_Loop
*$F7D1 CALL $ABE1    ; Call #R$ABE1 to read the player's key.
 $F7D4 CP $4E        ; {Branch to #R$F7DF when the player pressed "N".
 $F7D6 JR Z,$F7DF    ; }
 $F7D8 CP $59        ; {Branch to #R$F7D1 unless the player pressed "Y".
 $F7DA JR NZ,$F7D1   ; }
 $F7DC CALL $AC6D    ; Call #R$AC6D to write the game to tape.
@label=Action_Quit_Next
*$F7DF LD HL,$E9BE   ; {Return to the play-again question.
 $F7E2 EX (SP),HL    ; }
 $F7E3 RET           ; Return.

; Action: North
;
; Carry out the "North" command.
@label=Action_North
c$F7E4 LD C,$00      ; {Head north and continue at #R$F7FA.
 $F7E6 JR $F7FA      ; }

; Action: South
;
; Carry out the "South" command.
@label=Action_South
c$F7E8 LD C,$01      ; {Head south and continue at #R$F7FA.
 $F7EA JR $F7FA      ; }

; Action: East
;
; Carry out the "East" command.
@label=Action_East
c$F7EC LD C,$02      ; {Head east and continue at #R$F7FA.
 $F7EE JR $F7FA      ; }

; Action: West
;
; Carry out the "West" command.
@label=Action_West
c$F7F0 LD C,$03      ; {Head west and continue at #R$F7FA.
 $F7F2 JR $F7FA      ; }

; Action: Up
;
; Carry out the "Up" command.
@label=Action_Up
c$F7F4 LD C,$04      ; {Head up and continue at #R$F7FA.
 $F7F6 JR $F7FA      ; }

; Action: Down
;
; Carry out the "Down" command.
@label=Action_Down
c$F7F8 LD C,$05      ; Select the down exit.
; This entry point is used by the routines at #R$F7E4, #R$F7E8, #R$F7EC,
; #R$F7F0 and #R$F7F4.
@label=Action_Move
*$F7FA CALL $B665    ; Call #R$B665 to check that the command has no object.
 $F7FD RET C         ; Leave the routine when the carry flag is set.
 $F7FE LD B,$00      ; {Call #R$B503 to point at the current room's exits.
 $F800 CALL $B503    ; }
 $F803 ADD HL,BC     ; Point at the exit for this direction.
 $F804 LD A,(HL)     ; Read this exit's destination room.
 $F805 OR A          ; {Refuse the move when that exit is closed.
 $F806 JP Z,$EADC    ; }
 $F809 CALL $E9E1    ; Call #R$E9E1 to change room.
 $F80C RET           ; Return.

; Action: Take
;
; Carry out the "Take" command.
@label=Action_Take
c$F80D CALL $B670    ; {Call #R$B670 to check that the command names an object,
 $F810 RET C         ; and return if it does not.}
 $F811 LD HL,$F820   ; {Call #R$B7D3 to dispatch the matching phrase, for #N$2C
 $F814 LD DE,$F878   ; entries.
 $F817 LD BC,$002C   ;
 $F81A CALL $B7D3    ; }
 $F81D JP $EAE2      ; Continue at #R$EAE2.

