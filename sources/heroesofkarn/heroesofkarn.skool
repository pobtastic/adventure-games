 $FB00 LD DE,$FB11   ; #N($0001,$04,$04) entry.
 $FB03 LD BC,$0001   ;
 $FB06 CALL $B7D3    ; }
; Print "#MESSAGE$DEA0".
 $FB09 LD HL,$DEA0   ; #REGhl=#R$DEA0.
 $FB0C JP $EA9E      ; Jump to #R$EA9E.

