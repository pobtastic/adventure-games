; Handler: The Field
;
; Show the picture for the Field.
@label=HandlerTheField
c$FDAB LD IX,$61A8   ; Point at the picture of the Field.
 $FDAF JR $FDDF      ; Rejoin the shared picture display at #R$FDDF.

; Handler: The Monastery
;
; Show the picture for the Monastery.
@label=HandlerTheMonastery
c$FDB1 LD IX,$6B37   ; Point at the picture of the Monastery.
 $FDB5 JR $FDDF      ; Rejoin the shared picture display at #R$FDDF.

; Handler: The King's Chamber
;
; Show the picture for the King's Chamber.
@label=HandlerTheKingsChamber
c$FDB7 LD IX,$7313   ; Point at the picture of the King's Chamber.
 $FDBB JR $FDDF      ; Rejoin the shared picture display at #R$FDDF.

; Handler: The Oil Room And The Acid Room
;
; Show the picture for the Oil Room And The Acid Room.
@label=HandlerTheOilRoomAndTheAcidRoom
c$FDBD LD IX,$79F4   ; Point at the picture shared by the Oil Room and the Acid
                     ; Room.
 $FDC1 JR $FDDF      ; Rejoin the shared picture display at #R$FDDF.

