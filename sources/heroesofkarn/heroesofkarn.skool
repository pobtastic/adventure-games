; Action: Help
;
; Carry out the "Help" command.
@label=Action_Help
c$F715 CALL $B665    ; {Call #R$B665 to check that the command has no object,
 $F718 RET C         ; and return if it does not.}
 $F719 LD A,$06      ; {Send the player to read the information when the swamp
 $F71B CALL $B560    ; lizard is here.
 $F71E JP Z,$EAA6    ; }
 $F721 LD A,$2C      ; {Send the player to read the information when the balrog
 $F723 CALL $B560    ; is here.
 $F726 JP Z,$EAA6    ; }
 $F729 LD A,$07      ; {Skip the bear's answer when the bear is not here.
 $F72B CALL $B560    ;
 $F72E JR NZ,$F736   ; }
; Print it as the reply: #MESSAGE$D106.
 $F730 LD HL,$D106   ; {Point at the message and print it as the reply.
 $F733 JP $EA9E      ; }
@label=Action_Help_Next
*$F736 LD A,$4E      ; {Suggest a little music when the venomous spider is
 $F738 CALL $B560    ; here.
 $F73B JP Z,$EAAC    ; }
 $F73E LD A,($AECD)  ; Read the current room into #REGa.
 $F741 CP $23        ; {Branch to #R$EAAC when the room is #MESSAGE$C621.
 $F743 JP Z,$EAAC    ; }
 $F746 LD A,$56      ; {Skip the corrosion hint when the Black Knight is not
 $F748 CALL $B560    ; here.
 $F74B JR NZ,$F753   ; }
; Print it as the reply: #MESSAGE$D12B.
 $F74D LD HL,$D12B   ; {Point at the message and print it as the reply.
 $F750 JP $EA9E      ; }
@label=Action_Help_Next2
*$F753 JP $EAB2      ; Continue at #R$EAB2.

; Action: Inventory
;
; Carry out the "Inventory" command.
@label=Action_Inventory
c$F756 CALL $B665    ; Call #R$B665 to check that the command has no object.
; The "INVENTORY" command can only be called on its own.
 $F759 RET C         ; Return if there's any token set in #N$AF2F.
 $F75A LD A,($AE9A)  ; {Jump to #R$EAB8 if *#R$AE9A is zero (the player isn't holding any
 $F75D AND A         ; items).
 $F75E JP Z,$EAB8    ; }
; Clear the screen and display the players inventory.
 $F761 CALL $ABF1    ; Call #R$ABF1.
 $F764 CALL $AC0D    ; Call #R$AC0D to park the cursor on the current screen
                     ; line.
 $F767 LD HL,$B131   ; {Print "#MESSAGE$B131" and start a new line.
 $F76A CALL $AC35    ; }
 $F76D LD A,$01      ; {Call #R$B400 with a room ID of #N$01 which is the players
 $F76F CALL $B400    ; inventory.}
 $F772 RET           ; Return.

; Action: Look
;
; Carry out the "Look" command.
@label=Action_Look
c$F773 CALL $B665    ; Call #R$B665 to check that the command has no object.
; The "LOOK" command can only be called on its own.
 $F776 RET C         ; Return if there's any token set in #N$AF2F.
 $F777 LD E,$01      ; {Call #R$B41F with #REGe set to #N$01 (which will force any room
 $F779 CALL $B41F    ; images to be re-displayed).}
 $F77C RET           ; Return.

; Action: Score
;
; Carry out the "Score" command.
@label=Action_Score
c$F77D CALL $B665    ; Call #R$B665 to check that the command has no object.
; The "LOAD" command can only be called on its own.
 $F780 RET C         ; Return if there's any token set in #N$AF2F.
 $F781 CALL $B79E    ; Call #R$B79E to tell the player the score.
 $F784 RET           ; Return.

; Action: Examine
;
; Carry out the "Examine" command.
@label=Action_Examine
c$F785 CALL $B670    ; {Call #R$B670 to check that the command names an object,
 $F788 RET C         ; and return if it does not.}
 $F789 LD HL,$F798   ; {Call #R$B7D3 to dispatch the matching phrase, for #N$05
 $F78C LD DE,$F7A2   ; entries.
 $F78F LD BC,$0005   ;
 $F792 CALL $B7D3    ; }
 $F795 JP $EABE      ; Continue at #R$EABE.

