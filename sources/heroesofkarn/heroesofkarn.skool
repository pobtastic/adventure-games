; Action: Dig
;
; Carry out the "Dig" command.
@label=Action_Dig
c$FAC8 CALL $B665    ; {Call #R$B665 to check that the command has no object,
 $FACB RET C         ; and return if it does not.}
 $FACC LD A,$60      ; {Refuse to dig without the shovel.
 $FACE CALL $B5CF    ;
 $FAD1 JP NZ,$F537   ; }
 $FAD4 LD A,($AECD)  ; Read the current room into #REGa.
 $FAD7 CP $3C        ; {Branch to #R$F53D when #N$3C means the values differ.
 $FAD9 JP NZ,$F53D   ; }
 $FADC LD HL,$AE77   ; {See whether this spot on the beach has already been
 $FADF BIT 0,(HL)    ; dug.
 $FAE1 JP NZ,$F53D   ; }
 $FAE4 SET 0,(HL)    ; Remember that this spot on the beach has been dug.
 $FAE6 LD A,$72      ; {Call #R$B5DC to update the item for this room.
 $FAE8 CALL $B5DC    ; }
 $FAEB LD A,$03      ; {Call #R$B78F to add the points to the score.
 $FAED CALL $B78F    ; }
 $FAF0 CALL $EAE8    ; Call #R$EAE8 to tell the player that worked.
; Print it as the reply: #MESSAGE$DE88.
 $FAF3 LD HL,$DE88   ; {Point at the message and print it as the reply.
 $FAF6 JP $EA9E      ; }

; Action: Empty
;
; Carry out the "Empty" command.
@label=Action_Empty
c$FAF9 CALL $B670    ; {Call #R$B670 to check that the command names an object,
 $FAFC RET C         ; and return if it does not.}
 $FAFD LD HL,$FB0F   ; {Call #R$B7D3 to dispatch the matching phrase, for #N$01
 $FB00 LD DE,$FB11   ; entry.
 $FB03 LD BC,$0001   ;
 $FB06 CALL $B7D3    ; }
; Print it as the reply: #MESSAGE$DEA0.
 $FB09 LD HL,$DEA0   ; {Point at the message and print it as the reply.
 $FB0C JP $EA9E      ; }

; Table: Empty Phrases
;
; The Empty phrase pointer and its handler.
@label=Table_EmptyPhrases
w$FB0F DEFW $E79D
 $FB11 DEFW $F546

; Action: Light
;
; Carry out the "Light" command.
@label=Action_Light
c$FB13 LD HL,$E7B5   ; {Call #R$B575 to match the phrase tokens.
 $FB16 CALL $B575    ; }
 $FB19 JP NZ,$EB8F   ; Refuse to light when the words do not match.
 $FB1C LD A,$01      ; {Flag this turn as lighting.
 $FB1E JR $FB45      ; }

; Action: Rub
;
; Carry out the "Rub" command.
@label=Action_Rub
c$FB20 LD HL,$E7CE   ; {Call #R$B575 to match the phrase tokens.
 $FB23 CALL $B575    ; }
 $FB26 JP NZ,$EB8F   ; Refuse to rub when the words do not match.
 $FB29 LD A,$02      ; {Flag this turn as rubbing.
 $FB2B JR $FB45      ; }

; Action: Say
;
; Carry out the "Say" command.
@label=Action_Say
c$FB2D LD HL,$E7DA   ; {Call #R$B575 to match the phrase tokens.
 $FB30 CALL $B575    ; }
 $FB33 JP NZ,$EB8F   ; Refuse to say it when the words do not match.
 $FB36 LD A,$04      ; {Flag this turn as saying.
 $FB38 JR $FB45      ; }

; Action: Attack
;
; Carry out the "Attack" command.
@label=Action_Attack
c$FB3A LD HL,$E7E1   ; {Call #R$B575 to match the phrase tokens.
 $FB3D CALL $B575    ; }
 $FB40 JP NZ,$EB8F   ; Refuse to attack when the words do not match.
 $FB43 LD A,$08      ; Flag this turn as an attack.
; This entry point is used by the routines at #R$FB13, #R$FB20 and #R$FB2D.
*$FB45 LD ($AE78),A  ; Store #REGa in the turn scratch flag.
 $FB48 CALL $F54C    ; Call #R$F54C to drop the verb from the word tokens.
 $FB4B LD HL,$E9B0   ; {Hand the rest of the command to the verb dispatcher.
 $FB4E EX (SP),HL    ; }
 $FB4F RET           ; Return.

