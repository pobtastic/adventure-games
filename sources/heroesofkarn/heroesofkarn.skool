; The "QUIT" command can only be called on its own.
 $F7C7 RET C         ; Return if the direct object is malformed.
 $F7C8 CALL $B79E    ; Call #R$B79E.
; Print "#MESSAGE$B097".
 $F7CB LD HL,$B097   ; #REGhl=#R$B097.
 $F7CE CALL $AC35    ; Call #R$AC35.
@label=WantToSave_Loop
*$F7D1 CALL $ABE1    ; Call #R$ABE1.
 $F7D4 CP $4E        ; {Jump to #R$F7DF if the player pressed "N".
 $F7D6 JR Z,$F7DF    ; }
 $F7D8 CP $59        ; {Jump to #R$F7D1 unless the player pressed "Y".
 $F7DA JR NZ,$F7D1   ; }
 $F7DC CALL $AC6D    ; Call #R$AC6D.
@label=QuitGame
*$F7DF LD HL,$E9BE   ; {Return to the play-again question.
 $F7E2 EX (SP),HL    ; }
 $F7E3 RET           ; Return.
