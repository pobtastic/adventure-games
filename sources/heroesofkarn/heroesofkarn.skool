; This entry point is used by the routines at #R$FB13, #R$FB20 and #R$FB2D.
@label=Action_FlagTurnEvent
*$FB45 LD ($AE78),A  ; Write #REGa to *#R$AE78.
 $FB48 CALL $F54C    ; Call #R$F54C.
 $FB4B LD HL,$E9B0   ; {Jump to the verb dispatcher.
 $FB4E EX (SP),HL    ; }
 $FB4F RET           ; Return.

