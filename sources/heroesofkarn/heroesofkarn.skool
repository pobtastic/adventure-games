@expand=#DEF(#ITEM(id) #MAP($id)(#HTML(&#10;)N/A,000:"Beren#RAW(,)the King.",001:"Istar#RAW(,)the wizard.",002:"Haldir#RAW(,)the minstrel.",003:"Khadim#RAW(,)the dwarf.",004:"A tinderbox.",005:"A frog.",006:"A swamp lizard.",007:"A bear.",008:"A sleeping bear.",009:"Copper gates#RAW(,)to the South.",010:"The gates are open.",011:"The gates are closed.",012:"Copper gates#RAW(,)to the North.",013:"The gates are open.",014:"The gates are closed.",015:"Jewelled gates#RAW(,)to the East.",016:"The gates are open.",017:"The gates are closed.",018:"Jewelled gates#RAW(,)to the West.",019:"The gates are open.",020:"The gates are closed.",021:"Golden gates#RAW(,)to the South.",022:"The gates are open.",023:"The gates are closed.",024:"Golden gates#RAW(,)to the North.",025:"The gates are open.",026:"The gates are closed.",027:"Golden gates#RAW(,)to the South.",028:"The gates are open.",029:"The gates are closed.",030:"Golden gates#RAW(,)to the North.",031:"The gates are open.",032:"The gates are closed.",033:"Some money.",034:"A barrowight.",035:"A bible.",036:"A wand.",037:"A scroll.",038:"A silver flute.",039:"A carpet.",040:"A jewelled key.",041:"A spirit.",042:"A songbird.",043:"A songbird in a wicker cage.",044:"A balrog.",045:"A crystal bridge over the chasm.",046:"A crystal bridge over the chasm.",047:"A sword.",048:"A spear.",049:"A dagger.",050:"A velvet pillow.",054:"A falcon.",055:"A bottle.",056:"A bottle of water.",057:"A bottle of acid.",058:"A bottle of oil.",059:"A broken bottle.",060:"A serpent.",061:"A dead serpent.",062:"Istar#RAW(,)held behind crystal bars.",069:"A golden lyre.",070:"A mandolin.",071:"A gold key.",072:"A hydra.",073:"A dead hydra.",074:"A ruby.",075:"A pool of oil.",076:"A pool of acid.",077:"A diamond.",078:"A venomous spider.",079:"A sleeping spider.",080:"A rusty#RAW(,)iron chest.",081:"A chest with oiled hinges.",082:"An open chest.",083:"A coffin.",084:"An open coffin.",085:"A vampire.",086:"The Black Knight.",087:"The body of the Black