; Move Player
;
; Used by the routines at #R$F7E4, #R$F7E8, #R$F7EC, #R$F7F0 and #R$F7F4.
;
; C Requested direction where: #TABLE { #N$00 | NORTH } { #N$01 | SOUTH } {
; . #N$02 | EAST } { #N$03 | WEST } { #N$04 | UP } { #N$05 | DOWN } TABLE#
@label=MovePlayer
c$F7FA CALL $B665    ; Call #R$B665.
 $F7FD RET C         ; Return if the direct object is malformed.
 $F7FE LD B,$00      ; {Call #R$B503.
 $F800 CALL $B503    ; }
 $F803 ADD HL,BC     ; #REGhl+=#REGbc.
 $F804 LD A,(HL)     ; #REGa=*#REGhl.
 $F805 OR A          ; {Jump to #R$EADC if the exit is closed.
 $F806 JP Z,$EADC    ; }
 $F809 CALL $E9E1    ; Call #R$E9E1.
 $F80C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SHOCK$A6E8 }
; { #FOREST$EE25 }
; { #JEWELS$F16B }
; { #WARLORD$F8DF }
; LIST#

