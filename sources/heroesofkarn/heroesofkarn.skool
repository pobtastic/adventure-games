; #R$EFB9, #R$EFBE, #R$EFD8 and #R$EFDD.
; .
; Refuse the drop when the object is not carried; otherwise drop it.
;
; A Object ID
@label=Drop_IsPlayerHoldingItem
c$EB31 CALL $B5CF    ; Call #R$B5CF.
; Print "#MESSAGE$B191".
 $EB34 LD HL,$B191   ; #REGhl=#R$B191.
 $EB37 JP NZ,$EAFD   ; Jump to #R$EAFD if the item is not being held.
; The player has the item in their inventory so drop it.
@label=DropItem
 $EB3A LD B,E        ; Copy the item ID into #REGb.
 $EB3B LD A,($AECD)  ; {#REGc=*#R$AECD.
 $EB3E LD C,A        ; }
; Alter the items location from the players inventory to the current room
; ID.
 $EB3F CALL $B5FD    ; Call #R$B5FD.
 $EB42 LD HL,$AE9A   ; {Decrease *#R$AE9A by one.
 $EB45 DEC (HL)      ; }
 $EB46 JP $EAE8      ; Jump to #R$EAE8.
