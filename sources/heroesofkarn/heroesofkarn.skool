 $EB5C CALL $EAF4    ; }
 $EB5F LD A,$06      ; {Call #R$B560 with item #N$06: #ITEM$06.
 $EB61 CALL $B560    ; }
 $EB64 JP NZ,$EB25   ; Jump to #R$EB25 if #ITEM$06 is not present.
; Print "#MESSAGE$D21E".
 $EB67 LD HL,$D21E   ; #REGhl=#R$D21E.
 $EB6A JP $EA9E      ; Jump to #R$EA9E.

