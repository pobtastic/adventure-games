@start
@remote=main:$4000
@remote=main:$E9B6
@expand=#DEF1(#SKOOLKID(addr,anchor=0)(name)#HTML(<a rel="noopener nofollow" href="https://skoolkit.ca/disassemblies/rom/#IF({{mode[base]}}==16)(hex/)asm/#IF({{mode[base]}}==16)(#EVAL({addr},16,4),#EVAL({addr})).html#IF({anchor})(#CHR(35)#IF({{mode[base]}}==16)(#EVAL({anchor},16,4),#EVAL({anchor})))">){name}#HTML(</a>))

; BASIC Bootstrap
;
; #HTML(The short BASIC program "KENTILLA" that starts the Micromega
; tape. It autostarts at line 1. The REM on line 1 holds the bootstrap at
; #R$5CD0, the loader at #R$5CFC, a header workspace at #R$5D96 and the
; loader messages. Line 2 is <code>POKE 0,0</code> (an intentional ROM
; no-op). Line 3 sets black INK/PAPER/BORDER, CLS, CLEARs just below the
; loader (#R$E9B6) and enters it with <code>RANDOMIZE USR</code> #R$5CD0.
; Line 4 is the ordinary ROM <code>LOAD "" CODE</code> that later
; replaces the stage-2 loader with the final support block at
; #R$E9B6@main(SupportCode).)
@label=BasicBootstrap
b$5CCB DEFB $00,$01,$3A,$01,$EA ; Line 1 header and REM token.

; Load Stage Two
;
; Stage-1 loader kept inside the line-1 REM. It reads a 17-byte
; custom header into #R$5D96, pulls the stage-2 length and address from that
; header, loads #N($0258,$04,$04) bytes to #R$E9B6, then jumps there.
;
; .
;
; Load the 17-byte stage-2 header.
@label=Load_Stage_Two
c$5CD0 LD IX,$5D96   ; Point #REGix at #R$5D96.
 $5CD4 LD DE,$0011   ; Set the block length in #REGde to #N($0011,$04,$04).
 $5CD7 XOR A         ; {Clear #REGa and set the carry flag (load a header
 $5CD8 SCF           ; block).}
 $5CD9 CALL $5CFC    ; Call #R$5CFC.
 $5CDC JP NC,$5D89   ; Jump to #R$5D89 if the carry flag is reset.
; Refuse to continue unless *#SKOOLKID$5C47(SUBPPC) is #N$06.
 $5CDF LD A,($5C47)  ; {Jump to #SKOOLKID$0000(START) if *#SKOOLKID$5C47(SUBPPC) is
 $5CE2 CP $06        ; not #N$06.
 $5CE4 JP NZ,$0000   ; }
; Load the stage-2 Micromega block named by that header.
 $5CE7 LD DE,($5D96) ; Fetch the stage-2 length from *#R$5D96 into #REGde.
 $5CEB LD IX,($5D98) ; Fetch the stage-2 destination from *#R$5D98 into #REGix.
 $5CEF LD A,$FF      ; {Set #REGa to #N$FF and set the carry flag (load a data
 $5CF1 SCF           ; block).}
 $5CF2 CALL $5CFC    ; Call #R$5CFC.
 $5CF5 JP NC,$5D89   ; Jump to #R$5D89 if the carry flag is reset.
 $5CF8 EI            ; Enable interrupts.
 $5CF9 JP $E9B6      ; Jump to #R$E9B6.

; Load Tape Block
;
; Used by the routine at #R$5CD0.
; .
; Custom edge sampler used by the bootstrap. It still calls the ROM
; edge routines #SKOOLKID$05E3(LD-EDGE-1) / #SKOOLKID$05E7(LD-EDGE-2), but
; with Micromega timing thresholds rather than the standard ROM pilot. On
; success it returns through #R$5DAC; tape errors from #R$5CD0 jump to
; #R$5D89, which prints "TAPE LOADING ERROR" via #R$5DC9.
;
;   IX Destination address for the block
;   DE Block length
;   A Expected flag byte; carry set to load, reset to verify
; O:F Carry is set on success; #REGa' holds the preserved flag byte
;
; Preserve the flag byte and install the post-load return at #R$5DAC.
@label=Load_Tape_Block
c$5CFC INC D         ; {Preserve the flag byte in #REGaf'.
 $5CFD EX AF,AF'     ;
 $5CFE DEC D         ; }
 $5CFF DI            ; Disable interrupts.
 $5D00 LD A,$0F      ; {Set the border to white via port #N$FE.
 $5D02 OUT ($FE),A   ; }
 $5D04 LD HL,$5DAC   ; {Point #REGhl at #R$5DAC and stash it as the return
 $5D07 PUSH HL       ; address.}
; Seed the EAR/border state in #REGc from the current EAR bit.
 $5D08 IN A,($FE)    ; Read the EAR port.
 $5D0A RRA           ; Rotate the EAR bit into bit 0 of #REGa.
 $5D0B AND %00100000 ; Keep only the EAR bit.
 $5D0D OR %00000010  ; Set the blue border bit.
 $5D0F LD C,A        ; {Copy the EAR/border state into #REGc and set the zero
 $5D10 CP A          ; flag.}
; Wait for the pilot tone.
@label=Load_Tape_Block_WaitPilot
*$5D11 RET NZ        ; Return if the zero flag is reset (BREAK was pressed).
; Listen for a pair of edges that look like the pilot.
@label=Load_Tape_Block_PilotPair
*$5D12 CALL $05E7    ; {Jump back to #R$5D11 if #SKOOLKID$05E7(LD-EDGE-2) resets the
 $5D15 JR NC,$5D11   ; carry flag.}
 $5D17 LD HL,$0415   ; Set the leader timing budget in #REGhl to
                     ; #N($0415,$04,$04).
; Exhaust the leader timing budget while edges continue to arrive.
@label=Load_Tape_Block_LeaderDelay
*$5D1A DJNZ $5D1A    ; Decrease #REGb and loop until it is zero.
 $5D1C DEC HL        ; Decrease #REGhl.
 $5D1D LD A,H        ; {Jump back to #R$5D1A if #REGhl is non-zero.
 $5D1E OR L          ;
 $5D1F JR NZ,$5D1A   ; }
 $5D21 CALL $05E3    ; {Jump back to #R$5D11 if #SKOOLKID$05E3(LD-EDGE-1) resets the
 $5D24 JR NC,$5D11   ; carry flag.}
; Confirm a long enough run of short pilot pulses.
@label=Load_Tape_Block_PilotPulse
*$5D26 LD B,$9C      ; Set the pulse timing constant in #REGb to #N$9C.
 $5D28 CALL $05E3    ; {Jump back to #R$5D11 if #SKOOLKID$05E3(LD-EDGE-1) resets the
 $5D2B JR NC,$5D11   ; carry flag.}
 $5D2D LD A,$A6      ; {Jump back to #R$5D12 if #REGb is at least #N$A6.
 $5D2F CP B          ;
 $5D30 JR NC,$5D12   ; }
 $5D32 INC H         ; {Increase #REGh by one and jump back to #R$5D26 until it
 $5D33 JR NZ,$5D26   ; wraps.}
; Wait for the sync pulse that ends the pilot.
@label=Load_Tape_Block_Sync
*$5D35 LD B,$C9      ; Set the sync timing constant in #REGb to #N$C9.
 $5D37 CALL $05E7    ; {Jump back to #R$5D11 if #SKOOLKID$05E7(LD-EDGE-2) resets the
 $5D3A JR NC,$5D11   ; carry flag.}
 $5D3C LD A,B        ; {Jump back to #R$5D35 if #REGb is at least #N$D4.
 $5D3D CP $D4        ;
 $5D3F JR NC,$5D35   ; }
 $5D41 CALL $05E7    ; {Call #SKOOLKID$05E7(LD-EDGE-2) and return if the carry flag is
 $5D44 RET NC        ; reset.}
; Flip the border colour and start the byte-load loop.
 $5D45 LD A,C        ; Fetch the EAR/border state from #REGc.
 $5D46 XOR %00000011 ; Toggle the border colour bits.
 $5D48 LD C,A        ; Store the updated EAR/border state in #REGc.
 $5D49 LD H,$00      ; Clear the parity byte in #REGh.
 $5D4B LD B,$B0      ; Set #REGb to #N$B0.
 $5D4D JR $5D6E      ; Jump to #R$5D6E.
; Handle each loaded byte under the preserved flag in #REGaf'.
@label=Load_Tape_Block_NextByte
*$5D4F EX AF,AF'     ; Switch to #REGaf'.
 $5D50 JR NZ,$5D59   ; Jump to #R$5D59 if the flag byte is not zero.
 $5D52 JR NC,$5D63   ; Jump to #R$5D63 if the carry flag is reset (verify
                     ; mode).
 $5D54 LD (IX+$00),L ; Store the assembled byte in *#REGix+#N$00.
 $5D57 JR $5D68      ; Jump to #R$5D68.
; Compare the assembled byte against the expected flag byte.
@label=Load_Tape_Block_FlagByte
*$5D59 RL C          ; Rotate the stored flag bits in #REGc.
 $5D5B XOR L         ; {Return if the assembled byte does not match.
 $5D5C RET NZ        ; }
 $5D5D LD A,C        ; {Restore #REGc from the rotated value.
 $5D5E RRA           ;
 $5D5F LD C,A        ; }
 $5D60 INC DE        ; Advance #REGde past the flag byte.
 $5D61 JR $5D6A      ; Jump to #R$5D6A.
; Verify the assembled byte against *#REGix.
@label=Load_Tape_Block_VerifyByte
*$5D63 LD A,(IX+$00) ; {Return if *#REGix+#N$00 does not match the assembled
 $5D66 XOR L         ; byte.
 $5D67 RET NZ        ; }
; Advance the destination and continue for the remaining length.
@label=Load_Tape_Block_Advance
*$5D68 INC IX        ; Advance #REGix.
; Prepare the timing constant for the next byte.
@label=Load_Tape_Block_Continue
*$5D6A DEC DE        ; Decrease the remaining length.
 $5D6B EX AF,AF'     ; Switch back to #REGaf'.
 $5D6C LD B,$B2      ; Set #REGb to #N$B2.
; Sample eight edges to assemble the next byte into #REGl.
@label=Load_Tape_Block_SampleByte
*$5D6E LD L,$01      ; Seed the assembled byte in #REGl with #N$01.
; Sample one bit into #REGl.
@label=Load_Tape_Block_SampleBit
*$5D70 CALL $05E3    ; {Call #SKOOLKID$05E3(LD-EDGE-1) and return if the carry flag is
 $5D73 RET NC        ; reset.}
 $5D74 LD A,$CB      ; {Compare #REGb with the bit-threshold #N$CB.
 $5D76 CP B          ; }
 $5D77 RL L          ; Rotate that comparison result into #REGl.
 $5D79 LD B,$B0      ; Set #REGb to #N$B0.
 $5D7B JP NC,$5D70   ; Jump back to #R$5D70 until eight bits are in.
 $5D7E LD A,H        ; {Mix the assembled byte into the running parity in
 $5D7F XOR L         ; #REGh.
 $5D80 LD H,A        ; }
 $5D81 LD A,D        ; {Jump back to #R$5D4F until the remaining length in #REGde is
 $5D82 OR E          ; zero.
 $5D83 JR NZ,$5D4F   ; }
 $5D85 LD A,H        ; {Compare the parity byte with #N$01.
 $5D86 CP $01        ; }
 $5D88 RET           ; Return.
; This entry point is used by the routine at #R$5CD0.
; .
; Print "TAPE LOADING ERROR" after a failed load from #R$5CD0.
@label=Load_Tape_Block_PrintError
*$5D89 LD A,$01      ; {Open stream #N$01 via #SKOOLKID$1601(CHAN_OPEN).
 $5D8B CALL $1601    ; }
 $5D8E LD B,$19      ; {Point #REGde at #R$5DEA with length #N$19.
 $5D90 LD DE,$5DEA   ; }
 $5D93 JP $5DC9      ; Jump to #R$5DC9.

; Stage-2 Header
;
; Seventeen bytes read from the tape's special header for the stage-2
; loader. After a successful header read this holds the length
; #N($0258,$04,$04) and destination #R$E9B6.
@label=Stage2Header
b$5D96 DEFB $58,$02                         ; Stage-2 length.
; Fetched into #REGix by #R$5CD0 after the header load.
@label=Stage_Two_Destination
 $5D98 DEFB $B6,$E9                         ; Stage-2 destination.
 $5D9A DEFB $20,$4B,$4E,$20,$4C,$4F,$20,$58 ; {Name and copy of the
 $5DA2 DEFB $02,$B6,$E9,$00                 ; length/destination fields.}
 $5DA6 DEFB $80                             ; End marker.

; Unused
u$5DA7 DEFB $00,$00,$00,$00,$01

; Restore Border
;
; Success return from #R$5CFC. Restores the border from
; #SKOOLKID$5C48(BORDCR), then either returns with the load flags intact or
; prints "ATTEMPTED BREAK!" and hangs. #R$5D89 also enters the print loop at
; #R$5DC9 for "TAPE LOADING ERROR".
;
; .
;
; Preserve the load flags and restore the border colour.
@label=Restore_Border
c$5DAC PUSH AF       ; Stash #REGaf on the stack.
 $5DAD LD A,($5C48)  ; Fetch *#SKOOLKID$5C48(BORDCR) into #REGa.
 $5DB0 AND %00111000 ; Keep only the PAPER bits that hold the border colour.
 $5DB2 RRCA          ; {Move the border colour into bits 0-2.
 $5DB3 RRCA          ;
 $5DB4 RRCA          ; }
 $5DB5 OUT ($FE),A   ; Set the border from #REGa.
; Test whether SPACE is still held (BREAK during the load).
 $5DB7 LD A,$7F      ; {Read from the keyboard;
 $5DB9 IN A,($FE)    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7F | SPACE | SYMBOL SHIFT | M | N | B }
                     ; TABLE#}
 $5DBB RRA           ; Rotate the SPACE bit into the carry flag.
 $5DBC EI            ; Enable interrupts.
 $5DBD JR C,$5DD1    ; Jump to #R$5DD1 if SPACE is not pressed.
; Print "ATTEMPTED BREAK!" and hang.
 $5DBF LD A,$01      ; {Open stream #N$01 via #SKOOLKID$1601(CHAN_OPEN).
 $5DC1 CALL $1601    ; }
 $5DC4 LD B,$17      ; {Point #REGde at #R$5DD3 with length #N$17.
 $5DC6 LD DE,$5DD3   ; }
; This entry point is used by the routine at #R$5CFC.
; .
; Print #REGb characters from #REGde.
@label=Restore_Border_PrintLoop
*$5DC9 LD A,(DE)     ; {Print the character at *#REGde with
 $5DCA RST $10       ; #SKOOLKID$0010(PRINT_A_1).}
 $5DCB INC DE        ; Advance #REGde.
 $5DCC DJNZ $5DC9    ; Jump back to #R$5DC9 until #REGb is zero.
; Hang after a loader message.
@label=Restore_Border_Hang
*$5DCE JP $5DCE      ; Jump to #R$5DCE.
; Return to the caller with the preserved load flags.
@label=Restore_Border_Return
*$5DD1 POP AF        ; Restore #REGaf from the stack.
 $5DD2 RET           ; Return.

; Messaging: Attempted Break
;
; Control codes and text for the BREAK message printed by #R$5DBF.
@label=Messaging_AttemptedBreak
t$5DD3 DEFB $16,$01,$07,$12,$01,$20 ; AT #N($01), #N$07 / INK #N$01 / leading
                                    ; space.
 $5DD9 DEFM "ATTEMPTED BREAK! "     ; "#STR$5DD9,$00,$11"

; Messaging: Tape Loading Error
;
; Control codes and text for the tape-error message printed by
; #R$5D89.
@label=Messaging_TapeLoadingError
t$5DEA DEFB $16,$01,$06,$12,$01,$20 ; AT #N($01), #N$06 / INK #N$01 / leading
                                    ; space.
 $5DF0 DEFM "TAPE LOADING ERROR "   ; "#STR$5DF0,$00,$13"

; Line 1 Terminator
;
; Spare bytes and the trailing #HTML(<code>ENTER</code>) that end the
; line-1 REM.
@label=Line1Terminator
b$5E03 DEFB $00,$30,$30,$30,$30,$0D

; BASIC Lines 2 To 4
;
; Tokenised BASIC lines that finish the bootstrap program.
@label=BasicLines2To4
b$5E09 DEFB $00,$02,$11,$00,$F4,$30,$0E,$00 ; {Line 2: POKE 0,0.
 $5E11 DEFB $00,$00,$00,$00,$2C,$30,$0E,$00 ;
 $5E19 DEFB $00,$00,$00,$00,$0D             ; }
 $5E1E DEFB $00,$03,$FF,$00,$D9,$30,$0E,$00 ; {Line 3: INK 0: PAPER 0: BORDER 0: CLS: CLEAR just below the
 $5E26 DEFB $00,$00,$00,$00,$3A,$DA,$30,$0E ; loader (#R$E9B6): RANDOMIZE USR #R$5CD0.
 $5E2E DEFB $00,$00,$00,$00,$00,$3A,$E7,$30 ;
 $5E36 DEFB $0E,$00,$00,$00,$00,$00,$3A,$FB ;
 $5E3E DEFB $3A,$FD,$35,$39,$38,$32,$39,$10 ;
 $5E46 DEFB $00,$0E,$00,$00,$B5,$E9,$00,$3A ;
 $5E4E DEFB $F9,$C0,$32,$33,$37,$36,$30,$10 ;
 $5E56 DEFB $07,$0E,$00,$00,$D0,$5C,$00,$0D ; }
 $5E5E DEFB $00,$04,$05,$00,$EF,$22,$22,$AF ; {Line 4: LOAD ""CODE.
 $5E66 DEFB $0D                             ; }

i$5E67

; Micromega Loader
;
; Used by the routine at #R$5CD0.
; .
; Stage-2 Micromega 1.1 loader. It first checksums itself, then reads
; a 16-byte custom header that names destination #N$4000 (screen buffer),
; total length #N($A81D,$04,$04) and #N$0C overlapping chunks. Each of the
; twelve main chunks carries #N($0DB6,$04,$04) tape bytes but only advances
; the destination by #N($0DAC,$04,$04), so the last ten bytes of one chunk
; overlap the next. A short final chunk finishes the #N($A81D,$04,$04)-byte
; main image at #R$4000@main(Loading), which overwrites the REM bootstrap.
; Control then returns to BASIC so line 4 can ROM-load the final support
; block on top of this loader. While the chunks load, #R$E9F4 alternates
; two timing-parameter sets and #R$EA15 patches them into the sampler at
; #R$EAAE.
;
; .
;
; Clear the running total and point the scan at the first timed byte.
@label=MicromegaLoader
c$E9B6 LD HL,$0000   ; {Write #N($0000,$04,$04) to *#R$E9E5.
 $E9B9 LD ($E9E5),HL ; }
 $E9BC LD HL,$E9E9   ; {Point *#R$E9E3 at #R$E9E9.
 $E9BF LD ($E9E3),HL ; }
; Add each byte from #R$E9E9 through #R$EBE6 into the running total.
@label=MicromegaLoader_ChecksumLoop
*$E9C2 LD A,(HL)     ; {Fetch the next byte into #REGde.
 $E9C3 LD E,A        ;
 $E9C4 LD D,$00      ; }
 $E9C6 LD HL,($E9E5) ; {Add it into *#R$E9E5.
 $E9C9 ADD HL,DE     ;
 $E9CA LD ($E9E5),HL ; }
 $E9CD LD HL,($E9E3) ; Fetch the scan pointer from *#R$E9E3.
 $E9D0 LD DE,$EBE6   ; {Jump to #R$EA2E if the scan pointer has reached
 $E9D3 SCF           ; #R$EBE6.
 $E9D4 CCF           ;
 $E9D5 SBC HL,DE     ;
 $E9D7 JP Z,$EA2E    ; }
 $E9DA LD HL,($E9E3) ; {Advance *#R$E9E3.
 $E9DD INC HL        ;
 $E9DE LD ($E9E3),HL ; }
 $E9E1 JR $E9C2      ; Jump back to #R$E9C2.

; Loader Checksum Data
;
; Stored checksum word, running-total workspace, timing-switch flag,
; and the two five-byte timing-parameter tables used by #R$E9F4.
@label=LoaderChecksumData
b$E9E3 DEFW $0000               ; Checksum scan pointer.
; Additive total compared with *#R$E9E7 before each tape sample.
@label=Running_Checksum_Total
 $E9E5 DEFW $0000               ; Running checksum total.
; Compared with *#R$E9E5 before each tape sample.
@label=Expected_Checksum
 $E9E7 DEFW $EFBD               ; Expected checksum.
; Toggled by #R$E9F4 to choose which timing table to copy next.
@label=Timing_Switch_Flag
 $E9E9 DEFB $00                 ; Timing switch flag.
; Copied into #R$EAAE when *#R$E9E9 is zero.
@label=Timing_Parameters_First
 $E9EA DEFB $16,$B0,$B2,$CB,$B0 ; Timing parameter set #N$00.
; Copied into #R$EAAE when *#R$E9E9 is non-zero.
@label=Timing_Parameters_Second
 $E9EF DEFB $15,$C2,$C4,$D8,$C2 ; Timing parameter set #N$01.

; Switch Timing
;
; Used by the routine at #R$EA2E.
; .
; Chooses which of the two timing-parameter sets to copy next, then
; hands it to #R$EA15.
@label=Switch_Timing
c$E9F4 LD A,($E9E9)  ; {Jump to #R$EA07 if *#R$E9E9 is zero.
 $E9F7 CP $00        ;
 $E9F9 JP Z,$EA07    ; }
 $E9FC XOR A         ; {Write #N$00 to *#R$E9E9.
 $E9FD LD ($E9E9),A  ; }
 $EA00 LD HL,$E9EF   ; Point #REGhl at #R$E9EF.
 $EA03 CALL $EA15    ; Call #R$EA15.
 $EA06 RET           ; Return.
; This entry point is used by the routine at #R$EA2E.
; .
; Copy #R$E9EA into the sampler and advance the switch flag.
@label=Switch_Timing_FirstSet
*$EA07 LD HL,$E9EA   ; Point #REGhl at #R$E9EA.
 $EA0A CALL $EA15    ; Call #R$EA15.
 $EA0D LD A,($E9E9)  ; {Increment *#R$E9E9.
 $EA10 INC A         ;
 $EA11 LD ($E9E9),A  ; }
 $EA14 RET           ; Return.

; Patch Timing
;
; Used by the routine at #R$E9F4.
; .
; Copies the selected five timing parameters into the sampler at
; #R$EAAE.
;
; HL Address of the five-byte timing parameter set
@label=Patch_Timing
c$EA15 LD A,(HL)     ; {Write the first parameter to *#R$EB50(#N$EB51).
 $EA16 LD ($EB51),A  ; }
 $EA19 INC HL        ; Advance #REGhl.
 $EA1A LD A,(HL)     ; {Write the second parameter to *#R$EB0E(#N$EB0F).
 $EA1B LD ($EB0F),A  ; }
 $EA1E INC HL        ; Advance #REGhl.
 $EA1F LD A,(HL)     ; {Write the third parameter to *#R$EB2F(#N$EB30).
 $EA20 LD ($EB30),A  ; }
 $EA23 INC HL        ; Advance #REGhl.
 $EA24 LD A,(HL)     ; {Write the fourth parameter to *#R$EB37(#N$EB38).
 $EA25 LD ($EB38),A  ; }
 $EA28 INC HL        ; Advance #REGhl.
 $EA29 LD A,(HL)     ; {Write the fifth parameter to *#R$EB3C(#N$EB3D).
 $EA2A LD ($EB3D),A  ; }
 $EA2D RET           ; Return.

; Control Loading
;
; Used by the routine at #R$E9B6.
; .
; Reads the 16-byte main-image header into #R$EB70, then loads the
; twelve overlapping chunks and the final short block.
;
; .
;
; Load the main-image header.
@label=Control_Loading
c$EA2E CALL $EA07    ; Call #R$EA07.
 $EA31 LD IX,$EB70   ; Point #REGix at #R$EB70.
 $EA35 LD DE,$0010   ; Set the block length in #REGde to #N($0010,$04,$04).
 $EA38 XOR A         ; {Clear #REGa and set the carry flag (load a header
 $EA39 SCF           ; block).}
 $EA3A CALL $EAAE    ; Call #R$EAAE.
 $EA3D JP NC,$0000   ; Jump to #SKOOLKID$0000(START) if the carry flag is
                     ; reset.
; Prime the timing switch and read the destination and chunk count.
 $EA40 LD A,$01      ; {Write #N$01 to *#R$E9E9.
 $EA42 LD ($E9E9),A  ; }
 $EA45 CALL $E9F4    ; Call #R$E9F4.
 $EA48 LD IX,($EB7D) ; {Copy the destination from *#R$EB7D into #REGix and
 $EA4C LD ($EB84),IX ; *#R$EB84.}
 $EA50 XOR A         ; {Write #N$00 to *#R$EB86.
 $EA51 LD ($EB86),A  ; }
 $EA54 LD A,($EB7F)  ; {Fetch the chunk count from *#R$EB7F into #REGb.
 $EA57 LD B,A        ; }
; Load each overlapping chunk.
@label=Control_Loading_ChunkLoop
*$EA58 PUSH BC       ; Stash the remaining chunk count on the stack.
 $EA59 CALL $EB96    ; Call #R$EB96.
 $EA5C LD DE,$0DB6   ; Set the tape length in #REGde to #N($0DB6,$04,$04).
 $EA5F LD IX,($EB84) ; Point #REGix at *#R$EB84.
 $EA63 LD A,$FF      ; {Set #REGa to #N$FF and set the carry flag (load a data
 $EA65 SCF           ; block).}
 $EA66 CALL $EAAE    ; Call #R$EAAE.
 $EA69 JP NC,$0000   ; Jump to #SKOOLKID$0000(START) if the carry flag is
                     ; reset.
 $EA6C CALL $E9F4    ; Call #R$E9F4.
 $EA6F EI            ; Enable interrupts.
 $EA70 LD HL,($EB84) ; {Advance *#R$EB84 by #N($0DAC,$04,$04).
 $EA73 LD DE,$0DAC   ;
 $EA76 ADD HL,DE     ;
 $EA77 LD ($EB84),HL ; }
 $EA7A POP BC        ; Restore the remaining chunk count from the stack.
 $EA7B DJNZ $EA58    ; Jump back to #R$EA58 until the chunk count is zero.
; Reload the header, then load the final short chunk.
 $EA7D LD A,($EB86)  ; {Decrease *#R$EB86 by one.
 $EA80 DEC A         ;
 $EA81 LD ($EB86),A  ; }
 $EA84 CALL $EB96    ; Call #R$EB96.
 $EA87 LD IX,$EB70   ; Point #REGix at #R$EB70.
 $EA8B LD DE,$0010   ; Set the block length in #REGde to #N($0010,$04,$04).
 $EA8E XOR A         ; {Clear #REGa and set the carry flag (load a header
 $EA8F SCF           ; block).}
 $EA90 CALL $EAAE    ; Call #R$EAAE.
 $EA93 JP NC,$0000   ; Jump to #SKOOLKID$0000(START) if the carry flag is
                     ; reset.
 $EA96 CALL $E9F4    ; Call #R$E9F4.
 $EA99 CALL $EB96    ; Call #R$EB96.
 $EA9C LD IX,($EB84) ; Point #REGix at *#R$EB84.
 $EAA0 LD DE,($EB7B) ; Fetch the final length from *#R$EB7B into #REGde.
 $EAA4 LD A,$FF      ; {Set #REGa to #N$FF and set the carry flag (load a data
 $EAA6 SCF           ; block).}
 $EAA7 CALL $EAAE    ; Call #R$EAAE.
 $EAAA JP NC,$0000   ; Jump to #SKOOLKID$0000(START) if the carry flag is
                     ; reset.
 $EAAD RET           ; Return.

; Sample Tape
;
; Used by the routine at #R$EA2E.
; .
; Custom turbo sampler. Before sampling it compares the loader's
; additive checksum in *#R$E9E5 against the expected value in *#R$E9E7.
;
;   IX Destination address for the block
;   DE Block length
;   A Expected flag byte; carry set to load, reset to verify
; O:F Carry is set on success
;
; Refuse to load if the self-check total is wrong.
@label=Sample_Tape
c$EAAE PUSH DE       ; {Stash #REGde and #REGaf on the stack.
 $EAAF PUSH AF       ; }
 $EAB0 LD HL,($E9E7) ; {Jump to #SKOOLKID$0000(START) if *#R$E9E7 does not equal
 $EAB3 LD DE,($E9E5) ; *#R$E9E5.
 $EAB7 SCF           ;
 $EAB8 CCF           ;
 $EAB9 SBC HL,DE     ;
 $EABB JP NZ,$0000   ; }
 $EABE POP AF        ; {Restore #REGaf and #REGde from the stack.
 $EABF POP DE        ; }
; Preserve the flag byte and blank the border.
 $EAC0 INC D         ; {Preserve the flag byte in #REGaf'.
 $EAC1 EX AF,AF'     ;
 $EAC2 DEC D         ; }
 $EAC3 DI            ; Disable interrupts.
 $EAC4 LD A,$00      ; {Set the border to black via port #N$FE.
 $EAC6 OUT ($FE),A   ; }
 $EAC8 LD HL,$053F   ; Set the initial timing budget in #REGhl to
                     ; #N($053F,$04,$04).
; Seed the EAR/border state in #REGc from the current EAR bit.
 $EACB IN A,($FE)    ; Read the EAR port.
 $EACD RRA           ; Rotate the EAR bit into bit 0 of #REGa.
 $EACE AND %00100000 ; Keep only the EAR bit.
 $EAD0 OR %00000010  ; Set the blue border bit.
 $EAD2 LD C,A        ; {Copy the EAR/border state into #REGc and set the zero
 $EAD3 CP A          ; flag.}
; Wait for the pilot tone.
@label=Sample_Tape_WaitPilot
*$EAD4 RET NZ        ; Return if the zero flag is reset (BREAK was pressed).
; Listen for a pair of edges that look like the pilot.
@label=Sample_Tape_PilotPair
*$EAD5 CALL $EB50    ; {Jump back to #R$EAD4 if #R$EB50 resets the carry flag.
 $EAD8 JR NC,$EAD4   ; }
 $EADA LD HL,$0415   ; Set the leader timing budget in #REGhl to
                     ; #N($0415,$04,$04).
; Exhaust the leader timing budget while edges continue to arrive.
@label=Sample_Tape_LeaderDelay
*$EADD DJNZ $EADD    ; Decrease #REGb and loop until it is zero.
 $EADF DEC HL        ; Decrease #REGhl.
 $EAE0 LD A,H        ; {Jump back to #R$EADD if #REGhl is non-zero.
 $EAE1 OR L          ;
 $EAE2 JR NZ,$EADD   ; }
 $EAE4 CALL $EB4C    ; {Jump back to #R$EAD4 if #R$EB4C resets the carry flag.
 $EAE7 JR NC,$EAD4   ; }
; Confirm a long enough run of short pilot pulses.
@label=Sample_Tape_PilotPulse
*$EAE9 LD B,$9C      ; Set the pulse timing constant in #REGb to #N$9C.
 $EAEB CALL $EB4C    ; {Jump back to #R$EAD4 if #R$EB4C resets the carry flag.
 $EAEE JR NC,$EAD4   ; }
 $EAF0 LD A,$A6      ; {Jump back to #R$EAD5 if #REGb is at least #N$A6.
 $EAF2 CP B          ;
 $EAF3 JR NC,$EAD5   ; }
 $EAF5 INC H         ; {Increase #REGh by one and jump back to #R$EAE9 until it
 $EAF6 JR NZ,$EAE9   ; wraps.}
; Wait for the sync pulse that ends the pilot.
@label=Sample_Tape_Sync
*$EAF8 LD B,$C9      ; Set the sync timing constant in #REGb to #N$C9.
 $EAFA CALL $EB50    ; {Jump back to #R$EAD4 if #R$EB50 resets the carry flag.
 $EAFD JR NC,$EAD4   ; }
 $EAFF LD A,B        ; {Jump back to #R$EAF8 if #REGb is at least #N$D4.
 $EB00 CP $D4        ;
 $EB02 JR NC,$EAF8   ; }
 $EB04 CALL $EB50    ; {Call #R$EB50 and return if the carry flag is reset.
 $EB07 RET NC        ; }
; Flip the border colour and start the byte-load loop.
 $EB08 LD A,C        ; Fetch the EAR/border state from #REGc.
 $EB09 XOR %00000011 ; Toggle the border colour bits.
 $EB0B LD C,A        ; Store the updated EAR/border state in #REGc.
 $EB0C LD H,$00      ; Clear the parity byte in #REGh.
; First-byte #REGb timing, patched by #R$EA15.
@label=Sample_Tape_First_Byte_Timing
 $EB0E LD B,$B0      ; Set #REGb to the patched first-byte timing constant.
 $EB10 JR $EB31      ; Jump to #R$EB31.
; Handle each loaded byte under the preserved flag in #REGaf'.
@label=Sample_Tape_NextByte
*$EB12 EX AF,AF'     ; Switch to #REGaf'.
 $EB13 JR NZ,$EB1C   ; Jump to #R$EB1C if the flag byte is not zero.
 $EB15 JR NC,$EB26   ; Jump to #R$EB26 if the carry flag is reset (verify
                     ; mode).
 $EB17 LD (IX+$00),L ; Store the assembled byte in *#REGix+#N$00.
 $EB1A JR $EB2B      ; Jump to #R$EB2B.
; Compare the assembled byte against the expected flag byte.
@label=Sample_Tape_FlagByte
*$EB1C RL C          ; Rotate the stored flag bits in #REGc.
 $EB1E XOR L         ; {Return if the assembled byte does not match.
 $EB1F RET NZ        ; }
 $EB20 LD A,C        ; {Restore #REGc from the rotated value.
 $EB21 RRA           ;
 $EB22 LD C,A        ; }
 $EB23 INC DE        ; Advance #REGde past the flag byte.
 $EB24 JR $EB2D      ; Jump to #R$EB2D.
; Verify the assembled byte against *#REGix.
@label=Sample_Tape_VerifyByte
*$EB26 LD A,(IX+$00) ; {Return if *#REGix+#N$00 does not match the assembled
 $EB29 XOR L         ; byte.
 $EB2A RET NZ        ; }
; Advance the destination and continue for the remaining length.
@label=Sample_Tape_Advance
*$EB2B INC IX        ; Advance #REGix.
; Prepare the timing constant for the next byte.
@label=Sample_Tape_Continue
*$EB2D DEC DE        ; Decrease the remaining length.
 $EB2E EX AF,AF'     ; Switch back to #REGaf'.
; Next-byte #REGb timing, patched by #R$EA15.
@label=Sample_Tape_Next_Byte_Timing
 $EB2F LD B,$B2      ; Set #REGb to the patched next-byte timing constant.
; Sample eight edges to assemble the next byte into #REGl.
@label=Sample_Tape_SampleByte
*$EB31 LD L,$01      ; Seed the assembled byte in #REGl with #N$01.
; Sample one bit into #REGl.
@label=Sample_Tape_SampleBit
*$EB33 CALL $EB4C    ; {Call #R$EB4C and return if the carry flag is reset.
 $EB36 RET NC        ; }
; Bit-threshold comparison, patched by #R$EA15.
@label=Sample_Tape_Bit_Threshold
 $EB37 LD A,$CB      ; {Compare #REGb with the patched bit-threshold.
 $EB39 CP B          ; }
 $EB3A RL L          ; Rotate that comparison result into #REGl.
; Bit-loop #REGb timing, patched by #R$EA15.
@label=Sample_Tape_Bit_Loop
 $EB3C LD B,$B0      ; Set #REGb to the patched bit-loop timing constant.
 $EB3E JP NC,$EB33   ; Jump back to #R$EB33 until eight bits are in.
 $EB41 LD A,H        ; {Mix the assembled byte into the running parity in
 $EB42 XOR L         ; #REGh.
 $EB43 LD H,A        ; }
 $EB44 LD A,D        ; {Jump back to #R$EB12 until the remaining length in #REGde is
 $EB45 OR E          ; zero.
 $EB46 JR NZ,$EB12   ; }
 $EB48 LD A,H        ; {Compare the parity byte with #N$01.
 $EB49 CP $01        ; }
 $EB4B RET           ; Return.

; Sample Edge
;
; Used by the routine at #R$EAAE.
; .
; Local edge-sampling helpers used by #R$EAAE. #R$EB4C waits for two
; edges, and #R$EB50 waits for one. #R$EA15 patches the delay operand at
; #R$EB50(#N$EB51).
;
; .
;
; Wait for a second edge after the first succeeds.
@label=Sample_Edge
c$EB4C CALL $EB50    ; {Call #R$EB50 and return if the carry flag is reset.
 $EB4F RET NC        ; }
; This entry point is used by the routine at #R$EAAE.
; .
; Wait for one EAR transition. #R$EA15 patches the delay operand at
; #R$EB50(#N$EB51).
@label=Sample_Edge_Wait
*$EB50 LD A,$16      ; Set the delay counter in #REGa.
; Burn the patched delay before sampling.
@label=Sample_Edge_Delay
*$EB52 DEC A         ; {Decrease #REGa and jump back to #R$EB52 until it is
 $EB53 JR NZ,$EB52   ; zero.}
 $EB55 AND A         ; Clear the carry flag.
; Poll the EAR bit until it changes.
@label=Sample_Edge_Scan
*$EB56 INC B         ; {Increase #REGb and return if it wraps to zero.
 $EB57 RET Z         ; }
 $EB58 LD A,$FF      ; {Read from the keyboard;
 $EB5A IN A,($FE)    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FF | SPACE | SYMBOL SHIFT | M | N | B }
                     ; TABLE#}
 $EB5C RRA           ; {Return if BREAK is pressed.
 $EB5D RET NC        ; }
 $EB5E XOR C         ; Match the new EAR state against #REGc.
 $EB5F AND %00100000 ; Keep only the EAR bit.
 $EB61 JR Z,$EB56    ; Jump back to #R$EB56 if the EAR bit is unchanged.
 $EB63 LD A,C        ; {Invert the stored EAR/border state in #REGc.
 $EB64 CPL           ;
 $EB65 LD C,A        ; }
 $EB66 LD A,$00      ; Clear #REGa ready for the border update.
 $EB68 AND %00000111 ; Keep only the border colour bits.
 $EB6A OR %00001000  ; Force the MIC bit off so the border shows.
 $EB6C OUT ($FE),A   ; Update the border from #REGa.
 $EB6E SCF           ; Set the carry flag.
 $EB6F RET           ; Return.

; Main Image Header
;
; Sixteen-byte custom header for the main image, plus the progress
; workspace and "Loading:-" banner used by #R$EB96.
@label=MainImageHeader
b$EB70 DEFB $C9                                 ; First header byte, skipped by
                                                ; #R$EB96.
; Printed by #R$EB96 after the "Loading:-" banner.
@label=Main_Image_Header_Text
 $EB71 DEFB $00,$00,$00,$00,$00,$00,$00,$00     ; {Header bytes before the
 $EB79 DEFB $00,$00                             ; final-length word.}
; Length of the final short tape block loaded by #R$EA2E.
@label=Final_Chunk_Length
 $EB7B DEFW $0000                               ; Final chunk length.
; Start address of the main image, copied into #R$EB84.
@label=Main_Image_Destination
 $EB7D DEFW $0000                               ; Destination address.
; Number of overlapping chunks loaded by #R$EA2E.
@label=Main_Image_Chunk_Count
 $EB7F DEFB $00                                 ; Chunk count.
 $EB80 DEFB $00,$00,$00,$00                     ; Spare bytes before the
                                                ; progress workspace.
; Advances by #N($0DAC,$04,$04) after each overlapping chunk.
@label=Current_Load_Destination
 $EB84 DEFW $0000                               ; Current load destination.
; Printed as two hexadecimal digits by #R$EB96.
@label=Load_Progress_Counter
 $EB86 DEFB $00                                 ; Load progress counter.
; Banner printed by #R$EB96 while the chunks load.
@label=Messaging_Loading
 $EB87 DEFM $16,$00,$00,"Loading:-",$16,$01,$00 ; "#STR$EB87,$00,$0F"

; Print Progress
;
; Used by the routine at #R$EA2E.
; .
; Prints the "Loading:-" banner and the current progress counter while
; the overlapping chunks arrive.
;
; .
;
; Open the upper screen and print the banner plus header bytes.
@label=Print_Progress
c$EB96 LD A,$01      ; {Open stream #N$01 via #SKOOLKID$1601(CHAN_OPEN).
 $EB98 CALL $1601    ; }
 $EB9B LD BC,$000F   ; {Point #REGde at #R$EB87 with length #N($000F,$04,$04).
 $EB9E LD DE,$EB87   ; }
 $EBA1 CALL $203D    ; Call #SKOOLKID$203C,$203D(PR_STRING).
 $EBA4 LD BC,$000A   ; {Point #REGde at #R$EB71 with length #N($000A,$04,$04).
 $EBA7 LD DE,$EB71   ; }
 $EBAA CALL $203D    ; Call #SKOOLKID$203C,$203D(PR_STRING).
 $EBAD LD A,$20      ; {Print two spaces with #SKOOLKID$0010(PRINT_A_1).
 $EBAF RST $10       ;
 $EBB0 LD A,$20      ;
 $EBB2 RST $10       ; }
; Print the progress counter as two hexadecimal digits.
 $EBB3 LD A,($EB86)  ; Fetch *#R$EB86 into #REGa.
 $EBB6 PUSH AF       ; Stash the counter on the stack.
 $EBB7 CALL $EBC6    ; Call #R$EBC6.
 $EBBA POP AF        ; Restore the counter from the stack.
 $EBBB CALL $EBD8    ; Call #R$EBD8.
 $EBBE LD A,($EB86)  ; {Increment *#R$EB86.
 $EBC1 INC A         ;
 $EBC2 LD ($EB86),A  ; }
 $EBC5 RET           ; Return.
; Print the high nibble of #REGa as a hexadecimal digit.
@label=Print_Progress_HighDigit
*$EBC6 SRL A         ; {Shift #REGa down by four bits.
 $EBC8 SRL A         ;
 $EBCA SRL A         ;
 $EBCC SRL A         ; }
; Convert a nibble in #REGa to ASCII and print it.
@label=Print_Progress_HexDigit
*$EBCE CP $0A        ; {Jump to #R$EBD4 if the nibble is less than #N$0A.
 $EBD0 JR C,$EBD4    ; }
 $EBD2 ADD A,$07     ; Add #N$07 to step from #N$0A up to "A".
; Make the digit printable and send it to the screen.
@label=Print_Progress_PrintDigit
*$EBD4 ADD A,$30     ; Add #N$30 to form an ASCII digit or letter.
 $EBD6 RST $10       ; Print it with #SKOOLKID$0010(PRINT_A_1).
 $EBD7 RET           ; Return.
; Print the low nibble of #REGa as a hexadecimal digit.
@label=Print_Progress_LowDigit
*$EBD8 AND %00001111 ; Keep only the low nibble.
 $EBDA JR $EBCE      ; Jump to #R$EBCE.

; Loader Padding
;
; Remaining padding through the end of the #N($0258,$04,$04)-byte
; stage-2 block. #R$EBE6 is the exclusive end address of the checksum scan
; in #R$E9B6.
@label=LoaderPadding
b$EBDC DEFB $F2,$00,$00,$00,$00,$00,$00,$00 ; {Padding before the checksum end
 $EBE4 DEFB $00,$00                         ; address.}
; Exclusive end of the #R$E9B6 checksum scan.
@label=LoaderChecksumEnd
 $EBE6 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Padding through the end of the
 $EBEE DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; stage-2 block.
 $EBF6 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $EBFE DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $EC06 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; }

