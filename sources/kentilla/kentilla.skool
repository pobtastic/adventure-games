; Print Left Margin Column
;
; Remembers the left-margin column for #R$EEF1 newline
; (#N$1D) and sub-message (#N$1F) handling.
@label=PrintLeftMarginColumn
g$5B00 DEFB $00

; Location Id
;
; Current location. BASIC writes this before #R$EA87.
@label=LocationId
g$5B01 DEFB $00

i$5B02

; Parser List Pointer
;
; Copy of #SKOOLKID$5C57(NSPPC) kept while walking a BASIC list.
@label=ParserState
g$5BA0 DEFB $00,$00

; Parser Work Pointer
;
; Pointer into the work buffer at #R$FA00 or #R$FA2D.
@label=ParserState_WorkPointer
g$5BA2 DEFB $00,$00

; Parser Match Length
;
; Characters required to accept a vocabulary match.
@label=ParserState_MatchLength
g$5BA4 DEFB $00

; Parser Word Index
;
; Index of the matched word, returned to BASIC.
@label=ParserState_WordIndex
g$5BA5 DEFB $00

; Unused
u$5BA6 DEFB $00

; Token Start Pointer
;
; Pointer to the current token in #R$5BAE.
@label=InputBuffer_TokenStart
g$5BA7 DEFB $00,$00

; Next Token Pointer
;
; Pointer to the next token in #R$5BAE.
@label=InputBuffer_NextToken
g$5BA9 DEFB $00,$00

; Parser Token Character
;
; First character of the current token.
@label=ParserState_TokenChar
g$5BAB DEFB $00

; Parser Token Delimiter
;
; Character that ended the current token.
@label=ParserState_TokenDelimiter
g$5BAC DEFB $00

; Parser Entry Count
;
; Number of entries to scan in the current BASIC list.
@label=ParserState_EntryCount
g$5BAD DEFB $00

; Input Buffer
;
; Line buffer filled by #R$EB51. Holds up to #N$3E characters
; plus a trailing #N$0D written on ENTER.
