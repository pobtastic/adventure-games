@label=ParserState_MatchLength
 $5BA4 DEFB $00      ; Minimum match length.
@label=ParserState_WordIndex
 $5BA5 DEFB $00      ; Word index.
 $5BA6 DEFB $00      ; Unused.
@label=InputBuffer_TokenStart
 $5BA7 DEFB $00,$00  ; Current token start.
@label=InputBuffer_NextToken
