; { #R$EA7B | #R$EEC8 }
; { #R$EA7E | #R$EEE7 }
; { #R$EA81 | #R$F14C }
; { #R$EA84 | #R$F140 }
; { #R$EA87 | #R$EFFB }
; { #R$EA8A | #R$F0D3 }
; TABLE#
; .
; #HTML(Action dispatch (BASIC). After #R$F0E6 returns from Enter,
; line 130 <code>GO SUB 1000</code>. Line 1010 calls <code>USR</code>
; #R$EA63 (#R$ED2D); on a hit, line 1020 advances the token, reads an
; optional noun via <code>USR</code> #R$EA69, then
; <code>GO TO n*100+1000</code> for verb index <code>n</code>. Separately,
; line 310 calls <code>USR</code> #R$EA6F (#R$ED7E) for #R$F99C:
; indices #N$01-#N$06 move; #N$07+ go to line 400.)
; .
; Core command handlers (BASIC, via #R$ED7E). LOOK at line
; 441 goes to 350 to redraw the room; lines 450-499 ("I see") are a
; shared subroutine reached from there and elsewhere.
; .
; #TABLE(default,centre,centre,centre)
; { =h Idx | =h Word | =h Summary }
; { #N$01-#N$06 | NORTH..DOWN | Exit; redraw }
; { #N$07 | INVENTORY | List carried }
; { #N$08 | LOOK | Redraw room }
; { #N$09 | HELP | Can't help }
; { #N$0A | SAVE | Tape SAVE }
; { #N$0B | LOAD | Tape LOAD }
; { #N$0C | QUIT | Quit }
; { #N$0D | SCORE | Completion % }
; { #N$0E | WAIT | "I wait." }
; TABLE#
; .
; #HTML(Core verb handlers (BASIC, via #R$ED2D then
; <code>n*100+1000</code>). Noun index from #R$ED71 is BASIC
; <code>x</code> where used. ENTER (<code>GO TO</code> 1800) and GO
; (<code>GO TO</code> 1900) share one handler at line 1910, since there
; are no lines from 1800 to 1909.)
; .
; #TABLE(default,centre,centre,centre)
; { =h Idx | =h Word | =h Summary }
; { #N$01 | GET | Take item }
; { #N$02 | TAKE | Same as GET }
; { #N$03 | DROP | Drop item }
; { #N$04 | EXAMINE | Examine; may reveal }
; { #N$05 | SEARCH | Find concealed items }
; { #N$08/#N$09 | ENTER/GO | Shared at 1910 }
; { #N$19 | LOOK | Look at noun/dir }
; TABLE#
; .
; #HTML(Remaining verbs in #R$FAA9 (indices #N$06-#N$2E
; except the core rows above). Line 1020 still uses
; <code>GO TO n*100+1000</code>; when that line is missing, BASIC
; continues at the next existing line.)
; .
; Combat and speech. ATTACK and KILL share one fight
; routine: with a carried weapon they injure or slay a creature in
; the room. SAY talks to creatures (and can trigger give/take replies).
; HIT smashes a magical ward or, with the staff, turns a foe to dust;
; BREAK is the same fight path. SHOOT fires the bow.
; .
; Movement and the boat. CLIMB covers the rope, a tree and
; the boat mast. SWIM crosses the river; SWING on a hanging rope joins
; that same crossing. PULL and MOVE share one routine for hauling the
; boat into the sea, tugging the tied rope, or opening a sliding panel.
; PUSH works the lever. LEAVE, ROW and BAIL handle getting out of nested
; places and travelling or emptying the boat (ROW needs the oars; BAIL
; needs a helmet).
; .
; Inventory and wearables. THROW drops a carried object into
; the scenery (river, tree, far bank). WEAR and REMOVE put on or take
; off clothing and gems. GIVE hands an object to a creature. EAT
; consumes food and can restore hits. PUT stashes things in containers,
; the furnace crucible, the black sack or a chest. INSERT seats the pin
; that locks the sword arm.
; .
; Doors, chests and light. UNLOCK, OPEN, CLOSE and LOCK all
; resolve the target door or chest through the shared helper at line
; 2650, then change its open/locked state (keys must fit). LIGHT and
; EXTINGUISH manage the torch. TURN works the furnace or the dial.
; .
; Magic and discovery. READ shows book and scroll texts.
; CAST spends a scroll plus its ingredient (fire protection, cure
; disease, heal). RUB the lamp for the Jinni. DIG may unearth a buried
; find; DIP melts metal in the furnace; LISTEN can reveal the death-
; beetle hint. TIE and UNTIE fasten or free the rope on a stalagmite
; (UNTIE also frees Timandra). USE only asks for a more specific verb.
; .
; #HTML(Landing notes where the nominal
; <code>n*100+1000</code> line is missing or shared:)
; .
; #TABLE(default,centre,centre,centre)
; { =h Idx | =h Word | =h Lands }
; { #N$06/#N$07 | ATTACK/KILL | 1701 (no 1600-1700) }
; { #N$0A | SAY | 2001 }
; { #N$0B | CLIMB | 2105 }
; { #N$0C | TIE | 2205 }
; { #N$0D | THROW | 2310 }
; { #N$0E | WEAR | 2410 }
; { #N$0F | REMOVE | 2510 }
; { #N$10 | UNLOCK | 2610 }
; { #N$11 | OPEN | 2715 }
; { #N$12 | CLOSE | 2810 }
; { #N$13 | READ | 2905 }
; { #N$14 | LOCK | 3010 }
; { #N$15 | SWIM | 3110 }
; { #N$16 | GIVE | 3205 }
; { #N$17/#N$18 | PULL/MOVE | 3410 (no 3300-3409) }
; { #N$1A | PUSH | 3605 }
; { #N$1B | EAT | 3700 }
; { #N$1C | LIGHT | 3820 }
; { #N$1D | EXTINGUISH | 3920 }
; { #N$1E | TURN | 4010 }
; { #N$1F | HIT | 4105 }
; { #N$20 | PUT | 4205 }
; { #N$21 | DIG | 4305 }
; { #N$22 | DIP | 4405 }
; { #N$23 | RUB | 4510 }
; { #N$24 | LISTEN | 4605 }
; { #N$25 | SHOOT | 4705 }
; { #N$26 | CAST | 4810 }
; { #N$27 | LEAVE | 4910 }
; { #N$28 | ROW | 5005 }
; { #N$29 | INSERT | 5110 }
; { #N$2A | UNTIE | 5210 }
; { #N$2B | BREAK | 5300→4100 (HIT) }
; { #N$2C | SWING | 5410→3130 (SWIM) }
; { #N$2D | BAIL | 5500 }
; { #N$2E | USE | 5600 }
; TABLE#
@label=JumpTable
c$EA60 JP $ED65      ; Jump to #R$ED65.
@label=JumpTable_SearchVerbs
 $EA63 JP $ED2D      ; Jump to #R$ED2D.
@label=JumpTable_InputLine
 $EA66 JP $EB51      ; Jump to #R$EB51.
@label=JumpTable_SearchNouns
 $EA69 JP $ED71      ; Jump to #R$ED71.
@label=JumpTable_AdvanceInputPointer
 $EA6C JP $EDAF      ; Jump to #R$EDAF.
@label=JumpTable_SearchCommands
 $EA6F JP $ED7E      ; Jump to #R$ED7E.
@label=JumpTable_TokenHelper
 $EA72 JP $EDEE      ; Jump to #R$EDEE.
@label=JumpTable_BasicHelper
 $EA75 JP $EE60      ; Jump to #R$EE60.
@label=JumpTable_SeedPrimaryBuffer
 $EA78 JP $EEB9      ; Jump to #R$EEB9.
@label=JumpTable_StepWorkBuffer
 $EA7B JP $EEC8      ; Jump to #R$EEC8.
@label=JumpTable_SeedSecondaryBuffer
 $EA7E JP $EEE7      ; Jump to #R$EEE7.
@label=JumpTable_ScanInputSpaces
 $EA81 JP $F14C      ; Jump to #R$F14C.
@label=JumpTable_CopyWorkBuffer
 $EA84 JP $F140      ; Jump to #R$F140.
@label=JumpTable_LocationGraphicSetup
 $EA87 JP $EFFB      ; Jump to #R$EFFB.
@label=JumpTable_ScrollAdjust
 $EA8A JP $F0D3      ; Jump to #R$F0D3.

; Print Character
;
; Used by the routines at #R$EB51, #R$ECC0, #R$EF82 and #R$F0E6.
; .
; Plots one character glyph into the display file. Callers set
; up #R$5BF5 first.
@label=PrintCharacter
c$EA8D PUSH AF       ; {Stash the flags, counters, screen pointer and glyph pointer
 $EA8E PUSH BC       ; on the stack.
 $EA8F PUSH DE       ;
 $EA90 PUSH HL       ; }
; #HTML(Pick the plot opcode written into #R$EAF1: #N$AE (<code>XOR
; (HL)</code>) or #N$B6 (<code>OR (HL)</code>) from bit 2 of the flags.)
 $EA91 LD A,($5BF6)  ; {Fetch *#R$5BF6 and test bit 2.
 $EA94 BIT 2,A       ; }
 $EA96 LD A,$AE      ; {Prefer #N$AE (XOR) unless bit 2 was set.
 $EA98 JR Z,$EA9C    ; }
 $EA9A LD A,$B6      ; #REGa=#N$B6 (OR).
@label=PrintCharacter_SetPlotOpcode
@keep
*$EA9C LD ($EAF1),A  ; Patch that opcode into #R$EAF1.
; Point #REGhl at the 8-byte glyph. Codes below #N$8F use
; #SKOOLKID$5C36(CHARS); #N$90 and above were meant to index
; #SKOOLKID$5C7B(UDG), but the unconditional jump at #R$EAA4 always takes
; the #SKOOLKID$5C36(CHARS) path.
 $EA9F LD A,($5BF9)  ; {Fetch *#R$5BF9 and compare it with #N$8F.
 $EAA2 CP $8F        ; }
@label=PrintCharacter_ForceChars
 $EAA4 JR $EAB6      ; Always take the #SKOOLKID$5C36(CHARS) path at #R$EAB6.
; Unreachable #SKOOLKID$5C7B(UDG) path (left in the binary after
; #R$EAA4).
 $EAA6 JR C,$EAB6    ; {Scale the UDG index and point #REGhl at
 $EAA8 SUB $90       ; #SKOOLKID$5C7B(UDG).
 $EAAA ADD A,A       ;
 $EAAB ADD A,A       ;
 $EAAC ADD A,A       ;
 $EAAD LD E,A        ;
 $EAAE LD D,$00      ;
 $EAB0 LD HL,($5C7B) ;
 $EAB3 ADD HL,DE     ; }
 $EAB4 JR $EAC1      ; Jump to #R$EAC1.
@label=PrintCharacter_CharsGlyph
*$EAB6 LD DE,($5C36) ; {Point #REGhl at glyph *#R$5BF9 in
 $EABA LD L,A        ; #SKOOLKID$5C36(CHARS).
 $EABB LD H,$00      ;
 $EABD ADD HL,HL     ;
 $EABE ADD HL,HL     ;
 $EABF ADD HL,HL     ;
 $EAC0 ADD HL,DE     ; }
; Convert row/column at #R$5BF7 into a display-file address in
; #REGde.
@label=PrintCharacter_ScreenAddress
*$EAC1 LD DE,$4000   ; #REGde=#N$4000.
 $EAC4 LD BC,($5BF7) ; #REGbc=*#R$5BF7.
 $EAC8 LD A,C        ; {Jump to #R$EB39 if the column is out of range.
 $EAC9 CP $20        ;
 $EACB JR NC,$EB39   ; }
 $EACD LD A,B        ; {Jump to #R$EB39 if the row is out of range.
 $EACE CP $18        ;
 $EAD0 JR NC,$EB39   ; }
@label=PrintCharacter_RowThirds
*$EAD2 CP $08        ; {Jump to #R$EAE0 if this row is already in the current
 $EAD4 JR C,$EAE0    ; third.}
 $EAD6 SUB $08       ; {Move #REGd down one screen third and try again.
 $EAD8 PUSH AF       ;
 $EAD9 LD A,D        ;
 $EADA ADD A,$08     ;
 $EADC LD D,A        ;
 $EADD POP AF        ;
 $EADE JR $EAD2      ; }
@label=PrintCharacter_ColumnOffset
*$EAE0 ADD A,A       ; {Fold the row remainder and column into #REGe.
 $EAE1 ADD A,A       ;
 $EAE2 ADD A,A       ;
 $EAE3 ADD A,A       ;
 $EAE4 ADD A,A       ;
 $EAE5 ADD A,C       ;
 $EAE6 LD E,A        ; }
; Copy or XOR the 8 glyph rows into the display file.
 $EAE7 LD A,($5BF6)  ; {Jump to #R$EAF9 if bit 0 of *#R$5BF6 clears XOR mode.
 $EAEA AND $01       ;
 $EAEC JR Z,$EAF9    ; }
 $EAEE LD B,$08      ; #REGb=#N$08.
@label=PrintCharacter_XorLoop
*$EAF0 LD A,(DE)     ; {Plot one glyph row with the patched XOR/OR at #R$EAF1
@label=PrintCharacter_PlotOpcode
 $EAF1 XOR (HL)      ; and move down a pixel line.
 $EAF2 LD (DE),A     ;
 $EAF3 INC HL        ;
 $EAF4 INC D         ;
 $EAF5 DJNZ $EAF0    ; }
 $EAF7 JR $EB01      ; Jump to #R$EB01.
@label=PrintCharacter_CopyLoop
*$EAF9 LD B,$08      ; #REGb=#N$08.
@label=PrintCharacter_CopyLoop_Body
*$EAFB LD A,(HL)     ; {Copy one glyph row into the display file and move down a
 $EAFC LD (DE),A     ; pixel line.
 $EAFD INC HL        ;
 $EAFE INC D         ;
 $EAFF DJNZ $EAFB    ; }
; Unless bit 1 of the flags is set, write the attribute from
; #R$5BF5 into the matching attribute-file cell.
@label=PrintCharacter_Attributes
*$EB01 LD A,($5BF6)  ; {Jump to #R$EB28 if bit 1 of *#R$5BF6 skips attributes.
 $EB04 AND $02       ;
 $EB06 JR NZ,$EB28   ; }
 $EB08 LD A,($5BF5)  ; {Point #REGhl at the attribute-file cell for *#R$5BF7.
 $EB0B LD C,A        ;
 $EB0C LD DE,($5BF7) ;
 $EB10 LD H,$58      ;
 $EB12 LD A,D        ; }
@label=PrintCharacter_AttrRow
*$EB13 SUB $08       ; {Jump to #R$EB19 if another attribute third remains.
 $EB15 JR NC,$EB19   ; }
 $EB17 JR $EB1C      ; Jump to #R$EB1C.
@label=PrintCharacter_AttrNextThird
*$EB19 INC H         ; {Step #REGh to the next attribute third and retry.
 $EB1A JR $EB13      ; }
@label=PrintCharacter_AttrColumn
*$EB1C ADD A,$08     ; {Restore the row remainder and load the column.
 $EB1E LD B,A        ;
 $EB1F LD A,E        ;
 $EB20 JR Z,$EB26    ; }
*$EB22 ADD A,$20     ; {Add #N$20 per remaining row to reach the cell.
 $EB24 DJNZ $EB22    ; }
@label=PrintCharacter_WriteAttr
*$EB26 LD L,A        ; {Write *#R$5BF5 into that attribute-file cell.
 $EB27 LD (HL),C     ; }
; Advance the cursor: move to the next column, or wrap to the next
; row.
@label=PrintCharacter_AdvanceCursor
*$EB28 LD DE,($5BF7) ; {Advance the column; jump to #R$EB35 if still on this
 $EB2C INC E         ; row.
 $EB2D LD A,E        ;
 $EB2E CP $20        ;
 $EB30 JR NZ,$EB35   ; }
 $EB32 LD E,$00      ; {Wrap to column #N$00 on the next row.
 $EB34 INC D         ; }
@label=PrintCharacter_StoreCursor
*$EB35 LD ($5BF7),DE ; Store the updated cursor back in *#R$5BF7.
@label=PrintCharacter_Exit
*$EB39 POP HL        ; {Restore the glyph pointer, screen pointer, counters and
 $EB3A POP DE        ; flags from the stack.
 $EB3B POP BC        ;
 $EB3C POP AF        ; }
 $EB3D RET           ; Return.

; Input Line Symbol-Shift Remap
;
; Used by the routine at #R$EB51.
; .
; #HTML(Reached from #R$EB81 when Symbol Shift is held. Remaps
; <code>P</code> to <code>"</code> and <code>J</code> to "-", then
; continues into #R$EB83; any other key returns to the poll loop at
; #R$EB5E.)
@label=InputLine_SymbolShiftRemap
c$EB3E LD A,E        ; {Jump to #R$EB48 unless the key is "P".
 $EB3F CP $50        ;
 $EB41 JR NZ,$EB48   ; }
 $EB43 LD A,$22      ; {#HTML(Remap it to <code>"</code> and handle it at
 $EB45 LD E,A        ; #R$EB83.)
 $EB46 JR $EB83      ; }
@label=InputLine_SymbolShiftRemap_J
*$EB48 CP $4A        ; {Jump to #R$EB5E unless the key is "J".
 $EB4A JR NZ,$EB5E   ; }
 $EB4C LD A,$2D      ; {Remap it to "-" and handle it at #R$EB83.
 $EB4E LD E,A        ;
 $EB4F JR $EB83      ; }

; Input Line
;
; Used by the routine at #R$EA60.
; .
; Main game entry from #R$EA66. Clears #R$5BFA, draws the cursor
; via #R$ECF0, then loops on #SKOOLKID$5C00(KSTATE) (second key slot) until the
; player presses Enter. Ordinary keys are echoed through #R$EA8D into the
; buffer at #R$5BAE; Caps Shift chords edit the line; Enter
; submits via #R$F0E6.)
@label=InputLine
c$EB51 SUB A         ; {Clear the length, cursor and dirty flag.
 $EB52 LD ($5BFB),A  ;
 $EB55 LD ($5BFA),A  ;
 $EB58 LD ($5BFD),A  ; }
 $EB5B CALL $ECF0    ; Call #R$ECF0.
; This entry point is used by the routine at #R$EB3E.
; .
; Wait for #SKOOLKID$5C00(KSTATE) (second key slot) to change to a new
; non-#N$FF value.
@label=InputLine_Poll
*$EB5E LD A,($5BFC)  ; {Remember the previous key; read #SKOOLKID$5C00(KSTATE).
 $EB61 LD D,A        ;
 $EB62 LD A,($5C04)  ; }
 $EB65 LD ($5BFC),A  ; {Store the key and jump to #R$EB5E if none is down.
 $EB68 CP $FF        ;
 $EB6A JR Z,$EB5E    ; }
 $EB6C CP D          ; {Jump to #R$EB5E if the key has not changed.
 $EB6D JR Z,$EB5E    ; }
 $EB6F LD E,A        ; #REGe=#REGa.
; Caps Shift held: dispatch editing chords at #R$EBF5.
 $EB70 LD BC,$FEFE   ; {Jump to #R$EBF5 when Caps Shift is held.
 $EB73 IN A,(C)      ;
 $EB75 BIT 0,A       ;
 $EB77 JP Z,$EBF5    ; }
; Test Symbol Shift on the CAPS/Symbol Shift row.
 $EB7A LD BC,$7FFE   ; {Fetch that row and test Symbol Shift.
 $EB7D IN A,(C)      ;
 $EB7F BIT 1,A       ; }
; Jump to #R$EB3E when Symbol Shift is held.
@label=InputLine_SymbolShiftHeld
 $EB81 JR Z,$EB3E    ; Jump to #R$EB3E when Symbol Shift is held.
; This entry point is used by the routine at #R$EB3E.
@label=InputLine_HandleKey
*$EB83 LD A,E        ; {Jump to #R$EBD9 if Enter was pressed.
 $EB84 CP $0D        ;
 $EB86 JR Z,$EBD9    ; }
; Append #REGe to the buffer when there is room (length < #N$3E).
 $EB88 LD A,($5BFA)  ; {Jump to #R$EB5E if the line already holds #N$3E
 $EB8B LD D,A        ; characters.
 $EB8C CP $3E        ;
 $EB8E JR NC,$EB5E   ; }
 $EB90 LD HL,$5BAE   ; {Store the key into the buffer at #R$5BAE.
 $EB93 ADD A,L       ;
 $EB94 LD L,A        ;
 $EB95 LD A,E        ;
 $EB96 LD (HL),A     ;
 $EB97 LD ($5BF9),A  ; }
 $EB9A LD A,$16      ; {Set print state for echoing on row #N$16.
 $EB9C LD ($5BF8),A  ;
 $EB9F SUB A         ;
 $EBA0 LD ($5BF6),A  ;
 $EBA3 LD A,$05      ;
 $EBA5 LD ($5BF5),A  ; }
 $EBA8 LD A,D        ; {Wrap onto row #N$17 when the cursor column is past
 $EBA9 LD ($5BF7),A  ; #N$20.
 $EBAC CP $20        ;
 $EBAE JR C,$EBBA    ;
 $EBB0 SUB $20       ;
 $EBB2 LD ($5BF7),A  ;
 $EBB5 LD A,$17      ;
 $EBB7 LD ($5BF8),A  ; }
@label=InputLine_EchoChar
*$EBBA CALL $EA8D    ; Call #R$EA8D.
 $EBBD LD A,($5BFB)  ; {Grow the stored length if this column is new.
 $EBC0 CP D          ;
 $EBC1 JR NZ,$EBC7   ;
 $EBC3 INC A         ;
 $EBC4 LD ($5BFB),A  ; }
@label=InputLine_AdvanceCursor
*$EBC7 LD A,D        ; {Advance the cursor and redraw it.
 $EBC8 INC A         ;
 $EBC9 LD ($5BFA),A  ;
 $EBCC CALL $ECF0    ; }
 $EBCF LD A,$01      ; {Mark the line dirty, click, and poll again.
 $EBD1 LD ($5BFD),A  ;
 $EBD4 CALL $ED23    ;
 $EBD7 JR $EB5E      ; }
; Terminate the buffer with #N($0D), point both read pointers at the
; input buffer, and submit via #R$F0E6.
@label=InputLine_Enter
*$EBD9 LD A,($5BFB)  ; {Save the length and CR-terminate the buffer.
 $EBDC LD ($5BFE),A  ;
 $EBDF LD A,($5BFB)  ;
 $EBE2 LD HL,$5BAE   ;
 $EBE5 ADD A,L       ;
 $EBE6 LD L,A        ;
 $EBE7 LD (HL),$0D   ; }
 $EBE9 LD HL,$5BAE   ; {Point both token pointers at the input buffer.
 $EBEC LD ($5BA7),HL ;
 $EBEF LD ($5BA9),HL ; }
 $EBF2 JP $F0E6      ; Jump to #R$F0E6.
; #HTML(Caps Shift chords: <code>1</code> restore length, <code>5</code>/
; <code>8</code> move the cursor, <code>9</code> insert a space,
; <code>0</code> delete, <code>2</code> is a no-op stub.)
@label=InputLine_CapsShift
*$EBF5 LD A,E        ; {Jump to #R$EC12 if Caps Shift + 1.
 $EBF6 CP $31        ;
 $EBF8 JR Z,$EC12    ; }
 $EBFA CP $32        ; {Jump to #R$EC25 if Caps Shift + 2.
 $EBFC JR Z,$EC25    ; }
 $EBFE CP $35        ; {Jump to #R$EC36 if Caps Shift + 5.
 $EC00 JR Z,$EC36    ; }
 $EC02 CP $38        ; {Jump to #R$EC4D if Caps Shift + 8.
 $EC04 JR Z,$EC4D    ; }
 $EC06 CP $30        ; {Jump to #R$EC97 if Caps Shift + 0.
 $EC08 JP Z,$EC97    ; }
 $EC0B CP $39        ; {Jump to #R$EC68 if Caps Shift + 9.
 $EC0D JR Z,$EC68    ; }
 $EC0F JP $EB5E      ; Jump to #R$EB5E.
@label=InputLine_Caps1
*$EC12 LD A,($5BFD)  ; {Jump to #R$EB5E if the line is dirty.
 $EC15 AND A         ;
 $EC16 JP NZ,$EB5E   ; }
 $EC19 LD A,($5BFE)  ; {Restore the saved length and redraw the line.
 $EC1C LD ($5BFB),A  ;
 $EC1F CALL $ECC0    ;
 $EC22 JP $EB5E      ; }
@label=InputLine_Caps2
*$EC25 LD A,($5BFD)  ; {Jump to #R$EB5E (Caps Shift + 2 is a no-op).
 $EC28 AND A         ;
 $EC29 JP Z,$EB5E    ;
 $EC2C JP NZ,$EB5E   ; }
 $EC2F LD A,($5BFE)  ; {Unreachable restore of the saved length.
 $EC32 LD ($5BFB),A  ;
 $EC35 RET           ; }
; Move the cursor one column left and redraw it.
@label=InputLine_Caps5
*$EC36 LD A,($5BFA)  ; {Jump to #R$EB5E if already at the start.
 $EC39 AND A         ;
 $EC3A JP Z,$EB5E    ; }
 $EC3D CALL $ED1C    ; {Clear the old cursor, step left, and redraw.
 $EC40 LD A,($5BFA)  ;
 $EC43 DEC A         ;
 $EC44 LD ($5BFA),A  ;
 $EC47 CALL $ECF0    ;
 $EC4A JP $EB5E      ; }
; Move the cursor one column right (not past the line length).
@label=InputLine_Caps8
*$EC4D LD A,($5BFB)  ; {Jump to #R$EB5E if already at the end of the line.
 $EC50 LD B,A        ;
 $EC51 LD A,($5BFA)  ;
 $EC54 CP B          ;
 $EC55 JP Z,$EB5E    ; }
 $EC58 CALL $ED1C    ; {Clear the old cursor, step right, and redraw.
 $EC5B LD A,($5BFA)  ;
 $EC5E INC A         ;
 $EC5F LD ($5BFA),A  ;
 $EC62 CALL $ECF0    ;
 $EC65 JP $EB5E      ; }
; Insert a space at the cursor by shifting the tail right.
@label=InputLine_Caps9
*$EC68 LD A,($5BFB)  ; {Jump to #R$EB5E if the line is full.
 $EC6B CP $3E        ;
 $EC6D JP NC,$EB5E   ; }
 $EC70 INC A         ; {Grow the length and work out how many bytes to shift.
 $EC71 LD ($5BFB),A  ;
 $EC74 LD E,A        ;
 $EC75 LD A,($5BFA)  ;
 $EC78 LD B,A        ;
 $EC79 LD A,E        ;
 $EC7A SUB B         ;
 $EC7B LD C,A        ;
 $EC7C LD A,E        ; }
 $EC7D LD HL,$5BAE   ; {LDDR the tail right and write a space at the cursor.
 $EC80 ADD A,L       ;
 $EC81 LD L,A        ;
 $EC82 PUSH HL       ;
 $EC83 POP DE        ;
 $EC84 DEC HL        ;
 $EC85 LD B,$00      ;
 $EC87 LDDR          ;
 $EC89 LD A,$20      ;
 $EC8B LD (DE),A     ; }
 $EC8C CALL $ECC0    ; {Redraw, mark the line dirty, and poll again.
 $EC8F LD A,$01      ;
 $EC91 LD ($5BFD),A  ;
 $EC94 JP $EB5E      ; }
; Delete the character left of the cursor by shifting the tail left.
@label=InputLine_Caps0
*$EC97 LD A,($5BFA)  ; {Jump to #R$EB5E if already at the start.
 $EC9A AND A         ;
 $EC9B JP Z,$EB5E    ; }
 $EC9E DEC A         ; {Step the cursor left and shrink the stored length.
 $EC9F LD ($5BFA),A  ;
 $ECA2 LD B,A        ;
 $ECA3 LD A,($5BFB)  ;
 $ECA6 DEC A         ;
 $ECA7 LD ($5BFB),A  ;
 $ECAA SUB B         ;
 $ECAB LD C,A        ;
 $ECAC INC C         ; }
 $ECAD LD HL,$5BAE   ; {LDIR the tail left over the deleted character.
 $ECB0 LD A,B        ;
 $ECB1 ADD A,L       ;
 $ECB2 LD L,A        ;
 $ECB3 PUSH HL       ;
 $ECB4 POP DE        ;
 $ECB5 INC HL        ;
 $ECB6 LD B,$00      ;
 $ECB8 LDIR          ; }
 $ECBA CALL $ECC0    ; {Redraw the line and poll again.
 $ECBD JP $EB5E      ; }

; Input Line Redraw
;
; Used by the routine at #R$EB51.
; .
; Repaint the buffered characters at row #N$16 via #R$EA8D, pad
; with two spaces, then fall into #R$ECF0 to draw the cursor.
@label=InputLine_Redraw
c$ECC0 LD HL,$5BAE   ; {Point at the buffer and reset print state for row
 $ECC3 SUB A         ; #N$16.
 $ECC4 LD ($5BF6),A  ;
 $ECC7 LD ($5BF7),A  ;
 $ECCA LD A,$05      ;
 $ECCC LD ($5BF5),A  ;
 $ECCF LD A,$16      ;
 $ECD1 LD ($5BF8),A  ; }
 $ECD4 LD A,($5BFB)  ; {Jump to #R$ECE5 if the line is empty.
 $ECD7 AND A         ;
 $ECD8 JR Z,$ECE5    ;
 $ECDA LD B,A        ; }
@label=InputLine_Redraw_Loop
*$ECDB LD A,(HL)     ; {Print each buffered character through #R$EA8D.
 $ECDC LD ($5BF9),A  ;
 $ECDF CALL $EA8D    ;
 $ECE2 INC HL        ;
 $ECE3 DJNZ $ECDB    ; }
@label=InputLine_Redraw_Pad
*$ECE5 LD A,$20      ; {Pad with two spaces, then fall into the cursor draw.
 $ECE7 LD ($5BF9),A  ;
 $ECEA CALL $EA8D    ;
 $ECED CALL $EA8D    ; }
; This entry point is used by the routine at #R$EB51.
@label=InputLine_DrawCursor
*$ECF0 LD A,$28      ; {Use attribute #N$28 for the blinking cursor.
 $ECF2 LD ($5BF5),A  ; }
; This entry point is used by the routine at #R$ED1C.
@label=InputLine_DrawCursor_Body
*$ECF5 LD A,$01      ; {Set XOR mode and load a space glyph.
 $ECF7 LD ($5BF6),A  ;
 $ECFA LD A,$20      ;
 $ECFC LD ($5BF9),A  ; }
 $ECFF LD A,$16      ; {Plot it on row #N$16 at the cursor column.
 $ED01 LD ($5BF8),A  ;
 $ED04 LD A,($5BFA)  ;
 $ED07 LD ($5BF7),A  ;
 $ED0A CP $20        ;
 $ED0C JR C,$ED18    ; }
 $ED0E SUB $20       ; {Wrap onto row #N$17 when the column is past #N$20.
 $ED10 LD ($5BF7),A  ;
 $ED13 LD A,$17      ;
 $ED15 LD ($5BF8),A  ; }
@label=InputLine_DrawCursor_Print
*$ED18 CALL $EA8D    ; Call #R$EA8D.
 $ED1B RET           ; Return.

; Input Line Clear Cursor
;
; Used by the routine at #R$EB51.
; .
; Same as #R$ECF0 but with attribute #N($05), used to erase the
; old cursor before moving it.
@label=InputLine_ClearCursor
c$ED1C LD A,$05      ; {Use attribute #N$05 to erase the cursor.
 $ED1E LD ($5BF5),A  ; }
 $ED21 JR $ECF5      ; Jump to #R$ECF5.

; Input Line Click
;
; Used by the routine at #R$EB51.
; .
; Short click via ROM #SKOOLKID$03B5(BEEPER) after a character is
; accepted.
@label=InputLine_Click
c$ED23 LD DE,$0005   ; {Play a short click through #SKOOLKID$03B5(BEEPER).
 $ED26 LD HL,$01F4   ;
 $ED29 CALL $03B5    ; }
 $ED2C RET           ; Return.

; Search Vocabulary (Verbs)
;
; Used by the routine at #R$EA60.
; .
; #HTML(Jump-table target #R$EA63 (<code>USR</code> #R$EA63):
; search #R$FAA9 for the token at #R$5BA7. Sets #R$5BA4 to #N$02 and
; walks up to index #N$2E. On a hit, returns #REGbc=word index for
; BASIC <code>GO TO n*100+1000</code> (see #R$EA60); on a miss,
; #REGbc=#N($0000,$04,$04).)
@label=SearchVocabulary_Verbs
c$ED2D LD A,$02      ; {Set the minimum match length to #N$02.
 $ED2F LD ($5BA4),A  ; }
 $ED32 LD B,$2F      ; {Point #REGhl at #R$FAA9 with word limit #N$2F.
 $ED34 LD HL,$FAA9   ; }
; This entry point is used by the routines at #R$ED65, #R$ED71 and #R$ED7E.
; .
; Shared search loop used by #R$ED2D, #R$ED65, #R$ED71 and #R$ED7E.
@label=SearchVocabulary_Loop
*$ED37 LD A,$01      ; {Start the word index at #N$01.
 $ED39 LD ($5BA5),A  ; }
@label=SearchVocabulary_TryWord
*$ED3C PUSH HL       ; {Compare the current table word to the token at #R$5BA7.
 $ED3D PUSH BC       ;
 $ED3E LD DE,($5BA7) ;
 $ED42 CALL $ED8A    ;
 $ED45 POP BC        ;
 $ED46 POP HL        ; }
 $ED47 JR NC,$ED5E   ; Jump to #R$ED5E if the word matched.
@label=SearchVocabulary_SkipWord
*$ED49 INC HL        ; {Skip ahead to the CR that ends this table word.
 $ED4A LD A,(HL)     ;
 $ED4B CP $0D        ;
 $ED4D JR NZ,$ED49   ; }
 $ED4F INC HL        ; {Advance the word index and try the next entry.
 $ED50 LD A,($5BA5)  ;
 $ED53 INC A         ;
 $ED54 LD ($5BA5),A  ;
 $ED57 CP B          ; }
 $ED58 JR C,$ED3C    ; Jump to #R$ED3C if there are more words to try.
 $ED5A LD BC,$0000   ; #REGbc=#N($0000,$04,$04) on a miss.
 $ED5D RET           ; Return.
@label=SearchVocabulary_Matched
*$ED5E LD A,($5BA5)  ; {#REGbc=the matched word index.
 $ED61 LD C,A        ;
 $ED62 LD B,$00      ; }
 $ED64 RET           ; Return.

; Search Vocabulary (Prepositions)
;
; Used by the routines at #R$EA60 and #R$EDEE.
; .
; #HTML(Jump-table target #R$EA60 (<code>USR</code> #R$EA60):
; search #R$FBA8 for the token at #R$5BA7. Same loop as #R$ED37 with
; match length #N$02.)
@label=SearchVocabulary_Prepositions
c$ED65 LD A,$02      ; {Set match length #N$02 and point at #R$FBA8.
 $ED67 LD ($5BA4),A  ;
 $ED6A LD B,$09      ;
 $ED6C LD HL,$FBA8   ; }
 $ED6F JR $ED37      ; Jump to #R$ED37.

; Search Vocabulary (Nouns)
;
; Used by the routine at #R$EA60.
; .
; #HTML(Jump-table target #R$EA69 (<code>USR</code> #R$EA69):
; search #R$FBF4 for the token at #R$5BA7. BASIC stores the index as
; <code>x</code> for verb handlers (see #R$EA60).)
@label=SearchVocabulary_Nouns
c$ED71 LD A,$02      ; {Set match length #N$02 and point at #R$FBF4.
 $ED73 LD ($5BA4),A  ;
 $ED76 LD B,$43      ;
 $ED78 LD HL,$FBF4   ; }
 $ED7B JP $ED37      ; Jump to #R$ED37.

; Search Vocabulary (Commands)
;
; Used by the routine at #R$EA60.
; .
; #HTML(Jump-table target #R$EA6F (<code>USR</code> #R$EA6F):
; search #R$F99C for the token at #R$5BA7. Match length #N$01 so short
; commands like <code>UP</code> still hit. BASIC line 310 uses the index
; for movement (#N$01-#N$06) or the command handlers at line 400+
; (see #R$EA60).)
@label=SearchVocabulary_Commands
c$ED7E LD A,$01      ; {Set match length #N$01 and point at #R$F99C.
 $ED80 LD ($5BA4),A  ;
 $ED83 LD B,$0F      ;
 $ED85 LD HL,$F99C   ; }
 $ED88 JR $ED37      ; Jump to #R$ED37.

; Compare Token To Vocabulary Word
;
; Used by the routines at #R$ED2D, #R$EDAF, #R$EDEE and #R$EE60.
; .
; Compare the token at #REGde to the table word at #REGhl.
; Counts token characters until space, quote or control, requires at least
; *#R$5BA4 characters, then matches that many bytes. Returns with carry
; reset on a match, set on a miss.
@label=CompareTokenToWord
c$ED8A LD B,$00      ; {Clear the length counter and stash the token pointer.
 $ED8C PUSH DE       ; }
@label=CompareTokenToWord_Count
*$ED8D LD A,(DE)     ; {Jump to #R$ED9A if *#REGde is a control character (<
 $ED8E CP $21        ; #N$21).
 $ED90 JR C,$ED9A    ; }
 $ED92 CP $22        ; {Jump to #R$ED9A if *#REGde is a quote.
 $ED94 JR Z,$ED9A    ; }
 $ED96 INC B         ; {Count this character and keep scanning the token.
 $ED97 INC DE        ;
 $ED98 JR $ED8D      ; }
@label=CompareTokenToWord_CheckLength
*$ED9A POP DE        ; {Restore the token pointer; jump to #R$EDAD if it is too
 $ED9B LD A,($5BA4)  ; short.
 $ED9E LD C,A        ;
 $ED9F LD A,B        ;
 $EDA0 CP C          ;
 $EDA1 JR C,$EDAD    ; }
@label=CompareTokenToWord_Match
*$EDA3 LD A,(DE)     ; {Jump to #R$EDAD if the next characters differ.
 $EDA4 CP (HL)       ;
 $EDA5 JR NZ,$EDAD   ; }
 $EDA7 INC HL        ; {Advance both pointers and keep matching.
 $EDA8 INC DE        ;
 $EDA9 DJNZ $EDA3    ; }
 $EDAB AND A         ; Clear carry on a full match.
 $EDAC RET           ; Return.
@label=CompareTokenToWord_Miss
*$EDAD SCF           ; Set carry on a miss.
 $EDAE RET           ; Return.

; Advance Input Pointer
;
; Used by the routines at #R$EA60 and #R$F14C.
; .
; #HTML(Jump-table target #R$EA6C: advance #R$5BA7 / #R$5BA9 through
; #R$5BAE. Skips a leading <code>THE</code> via #R$FBA4, then leaves
; #R$5BAC holding the delimiter that ended the token.)
@label=AdvanceInputPointer
c$EDAF LD HL,($5BA7) ; {Fetch the current token and compare it with
 $EDB2 LD A,(HL)     ; end-of-line.
 $EDB3 CP $0D        ; }
 $EDB5 RET Z         ; Return if the current token is already at end-of-line.
 $EDB6 LD HL,($5BA9) ; {Promote #R$5BA9 to #R$5BA7 and test for an empty token.
 $EDB9 LD ($5BA7),HL ;
 $EDBC LD A,(HL)     ;
 $EDBD LD ($5BAB),A  ;
 $EDC0 CP $0D        ; }
 $EDC2 RET Z         ; Return if that token is empty.
@label=AdvanceInputPointer_Scan
*$EDC3 INC HL        ; {Jump to #R$EDD7 at end-of-line or a quote.
 $EDC4 LD A,(HL)     ;
 $EDC5 CP $0D        ;
 $EDC7 JR Z,$EDD7    ; }
 $EDC9 CP $22        ; {Jump to #R$EDD7 on a quote.
 $EDCB JR Z,$EDD7    ; }
 $EDCD CP $20        ; {Keep scanning until a space.
 $EDCF JR NZ,$EDC3   ; }
@label=AdvanceInputPointer_SkipSpaces
*$EDD1 INC HL        ; {Skip any run of spaces.
 $EDD2 LD A,(HL)     ;
 $EDD3 CP $20        ;
 $EDD5 JR Z,$EDD1    ; }
@label=AdvanceInputPointer_Store
*$EDD7 LD ($5BAC),A  ; {Store the delimiter and next-token pointer; require #N$03
 $EDDA LD ($5BA9),HL ; matching characters for "THE".
 $EDDD LD A,$03      ;
 $EDDF LD ($5BA4),A  ; }
 $EDE2 LD HL,($5BA7) ; {Skip a leading "THE" via #R$FBA4.
 $EDE5 LD DE,$FBA4   ;
 $EDE8 CALL $ED8A    ;
 $EDEB JR NC,$EDAF   ; }
 $EDED RET           ; Return if "THE" was not skipped.

; Match Token In BASIC List
;
; Used by the routine at #R$EA60.
; .
; Jump-table target #R$EA72: using the delimiter in #R$5BAC,
; try #R$ED65 (prepositions) and then walk a BASIC-resident word list via
; #R$EE9C. Returns #REGbc=index or #N($0000,$04,$04).
@label=MatchTokenInBasicList
c$EDEE LD A,$02      ; {Set match length #N$02 and reset the word index.
 $EDF0 LD ($5BA4),A  ;
 $EDF3 DEC A         ;
 $EDF4 LD ($5BA5),A  ; }
 $EDF7 LD A,($5BAC)  ; {Jump to #R$EE23 if the delimiter ends the line or is a
 $EDFA CP $0D        ; quote.
 $EDFC JR Z,$EE23    ;
 $EDFE CP $22        ;
 $EE00 JR Z,$EE23    ; }
 $EE02 LD HL,($5BA7) ; {Stash #R$5BA7 in #REGhl, promote #R$5BA9 as the current
 $EE05 PUSH HL       ; token, try a preposition match (#R$ED65) and seed #R$5BA5 to #N$01.
 $EE06 LD HL,($5BA9) ;
 $EE09 LD ($5BA7),HL ;
 $EE0C CALL $ED65    ;
 $EE0F LD A,$01      ;
 $EE11 LD ($5BA5),A  ; }
 $EE14 POP HL        ; {Pop the stashed pointer back into #R$5BA7 via #REGhl.
 $EE15 LD ($5BA7),HL ; }
 $EE18 LD A,C        ; {Jump to #R$EE23 if #REGc holds a preposition hit.
 $EE19 AND A         ;
 $EE1A JR NZ,$EE23   ; }
 $EE1C LD A,$01      ; {Mark the line dirty and scan the BASIC list.
 $EE1E LD ($5BFD),A  ;
 $EE21 JR $EE29      ; }
@label=MatchTokenInBasicList_ClearDirty
*$EE23 SUB A         ; {Clear the dirty flag and use the BASIC-helper scan.
 $EE24 LD ($5BFD),A  ;
 $EE27 JR $EE6E      ; }
@label=MatchTokenInBasicList_Scan
*$EE29 LD HL,($5C57) ; {Compare the next BASIC-list word to the token at
 $EE2C LD DE,$0008   ; #R$5BA7.
 $EE2F ADD HL,DE     ;
 $EE30 LD DE,($5BA7) ;
 $EE34 PUSH HL       ;
 $EE35 CALL $ED8A    ;
 $EE38 POP HL        ;
 $EE39 JR C,$EE4F    ; }
@label=MatchTokenInBasicList_NextWord
*$EE3B INC HL        ; {Skip to the next space-separated word in this entry.
 $EE3C LD A,(HL)     ;
 $EE3D CP $22        ;
 $EE3F JR Z,$EE4F    ;
 $EE41 CP $20        ;
 $EE43 JR NZ,$EE3B   ; }
 $EE45 INC HL        ; {Compare that word to the next input token.
 $EE46 LD DE,($5BA9) ;
 $EE4A CALL $ED8A    ;
 $EE4D JR NC,$EE59   ; }
; This entry point is used by the routine at #R$EE60.
@label=MatchTokenInBasicList_AdvanceEntry
*$EE4F CALL $EE9C    ; {Step to the next BASIC-list entry and keep scanning.
 $EE52 CP B          ;
 $EE53 JR C,$EE29    ; }
; This entry point is used by the routines at #R$EE60 and #R$EEB9.
@label=MatchTokenInBasicList_Miss
*$EE55 LD BC,$0000   ; #REGbc=#N($0000,$04,$04) on a miss.
 $EE58 RET           ; Return.
; This entry point is used by the routines at #R$EE60 and #R$EEB9.
@label=MatchTokenInBasicList_Hit
*$EE59 LD A,($5BA5)  ; {#REGbc=the matched word index.
 $EE5C LD C,A        ;
 $EE5D LD B,$00      ; }
 $EE5F RET           ; Return.

; BASIC Helper
;
; Used by the routine at #R$EA60.
; .
; Jump-table target #R$EA75: reload #SKOOLKID$5C57(NSPPC) from
; #R$5BA0 and continue the BASIC-list match.
@label=BasicHelper
c$EE60 LD HL,($5BA0) ; {Reload NSPPC from #R$5BA0; jump to #R$EE4F if dirty.
 $EE63 LD ($5C57),HL ;
 $EE66 LD A,($5BFD)  ;
 $EE69 AND A         ;
 $EE6A JR NZ,$EE4F   ; }
 $EE6C JR $EE94      ; Jump to #R$EE94.
; This entry point is used by the routine at #R$EDEE.
@label=BasicHelper_Scan
*$EE6E LD HL,($5C57) ; {Compare the next BASIC-list word to the token at
 $EE71 LD DE,$0008   ; #R$5BA7.
 $EE74 ADD HL,DE     ;
 $EE75 PUSH HL       ;
 $EE76 LD DE,($5BA7) ;
 $EE7A CALL $ED8A    ;
 $EE7D POP HL        ; }
 $EE7E JR NC,$EE59   ; Jump to #R$EE59 if matched.
@label=BasicHelper_NextWord
*$EE80 INC HL        ; {Skip to the next space-separated word in this entry.
 $EE81 LD A,(HL)     ;
 $EE82 CP $22        ;
 $EE84 JR Z,$EE94    ;
 $EE86 CP $20        ;
 $EE88 JR NZ,$EE80   ; }
 $EE8A INC HL        ; {Compare that word to the token at #R$5BA7.
 $EE8B LD DE,($5BA7) ;
 $EE8F CALL $ED8A    ;
 $EE92 JR NC,$EE59   ; }
@label=BasicHelper_AdvanceEntry
*$EE94 CALL $EE9C    ; {Step to the next entry or report a miss.
 $EE97 CP B          ;
 $EE98 JR C,$EE6E    ;
 $EE9A JR $EE55      ; }

; Step BASIC List Entry
;
; Used by the routines at #R$EDEE and #R$EE60.
; .
; Advance #SKOOLKID$5C57(NSPPC) / #R$5BA0 to the next
; length-prefixed BASIC list entry and bump #R$5BA5.
@label=StepBasicListEntry
c$EE9C LD HL,($5C57) ; {Skip the length prefix and advance NSPPC by that many
 $EE9F INC HL        ; bytes.
 $EEA0 INC HL        ;
 $EEA1 INC HL        ;
 $EEA2 LD E,(HL)     ;
 $EEA3 LD D,$00      ;
 $EEA5 ADD HL,DE     ;
 $EEA6 INC HL        ; }
 $EEA7 LD ($5C57),HL ; {Store the new NSPPC in #R$5BA0 as well.
 $EEAA LD ($5BA0),HL ; }
 $EEAD LD A,($5BAD)  ; {Bump the word index; leave the entry limit in #REGb.
 $EEB0 LD B,A        ;
 $EEB1 LD A,($5BA5)  ;
 $EEB4 INC A         ;
 $EEB5 LD ($5BA5),A  ; }
 $EEB8 RET           ; Return.

; Seed Primary Work Buffer
;
; Used by the routine at #R$EA60.
; .
; #HTML(Jump-table target #R$EA78 (<code>USR</code> #R$EA78): point
; #R$5BA2 at #R$FA00 and scan up to #N$2D entries. BASIC uses this for
; INVENTORY / LOOK object lists (see #R$EA60).)
@label=SeedPrimaryWorkBuffer
c$EEB9 LD HL,$FA00   ; {Point #R$5BA2 at #R$FA00 with #N$2D entries.
 $EEBC LD ($5BA2),HL ;
 $EEBF LD A,$2D      ; }
; This entry point is used by the routine at #R$EEE7.
@label=SeedWorkBuffer_Common
*$EEC1 LD ($5BFB),A  ; {Remember the entry limit and clear the index.
 $EEC4 SUB A         ;
 $EEC5 LD ($5BA5),A  ; }
; This entry point is used by the routine at #R$EA60.
; .
; Jump-table target #R$EA7B: step #R$5BA2 and compare *#REGhl to
; #R$5BFD.
@label=StepWorkBuffer
*$EEC8 LD A,($5BA5)  ; {Step the work-buffer pointer and compare to #R$5BFD.
 $EECB INC A         ;
 $EECC LD ($5BA5),A  ;
 $EECF LD C,A        ;
 $EED0 LD HL,($5BA2) ;
 $EED3 INC HL        ;
 $EED4 LD ($5BA2),HL ; }
 $EED7 LD A,($5BFD)  ; {Jump to #R$EE59 if this entry matches.
 $EEDA CP (HL)       ;
 $EEDB JP Z,$EE59    ; }
 $EEDE LD A,($5BFB)  ; {Keep scanning, or fall through to a miss.
 $EEE1 CP C          ;
 $EEE2 JR NZ,$EEC8   ;
 $EEE4 JP $EE55      ; }

; Seed Secondary Work Buffer
;
; Used by the routine at #R$EA60.
; .
; #HTML(Jump-table target #R$EA7E (<code>USR</code> #R$EA7E): same
; as #R$EEB9 but starting at #R$FA2D with #N$22 entries.)
@label=SeedSecondaryWorkBuffer
c$EEE7 LD HL,$FA2D   ; {Point #R$5BA2 at #R$FA2D with #N$22 entries.
 $EEEA LD ($5BA2),HL ;
 $EEED LD A,$22      ; }
 $EEEF JR $EEC1      ; Jump to #R$EEC1.

; Print Message
;
; Used by the routines at #R$EF92 and #R$EFA4.
; .
; Walks a message script pointed to by #REGhl. Most bytes are
; literal character codes passed to #R$EF82; values below #N$20 are
; control codes:
; .
; #TABLE(default,centre,centre)
; { =h Code | =h Action }
; { #N$00-#N$17 | Set row, then column (also #R$5B00) }
; { #N$18 | Set attribute at #R$5BF5 }
; { #N$19 | Set flags at #R$5BF6 }
; { #N$1A | End of script (return) }
; { #N$1B | Repeat current character }
; { #N$1C | Fill a box of spaces }
; { #N$1D | New line from #R$5B00 }
; { #N$1E | Add to column; advance row }
; { #N$1F | Call sub-script via #R$EF92 }
; TABLE#
;
; .
;
; Dispatch the next script byte to a control handler, or print it
; as a literal character.
@label=PrintMessage
c$EEF1 LD A,(HL)     ; {Fetch the next script byte.
 $EEF2 INC HL        ; }
; Codes #N$00-#N$17 set the print row and column.
 $EEF3 CP $18        ; {Jump to #R$EF17 if #REGa is less than #N$18.
 $EEF5 JR C,$EF17    ; }
; Code #N$18 sets the print attribute.
 $EEF7 JR Z,$EF24    ; Jump to #R$EF24 if #REGa is #N$18.
; Code #N$1A ends the script.
 $EEF9 CP $1A        ; Compare #REGa with #N$1A.
 $EEFB RET Z         ; Return if this is the end-of-script code.
; Code #N$19 sets the print flags.
 $EEFC JR C,$EF2B    ; Jump to #R$EF2B if #REGa is less than #N$1A.
; Code #N$1B repeats the current character.
 $EEFE CP $1C        ; {Jump to #R$EF32 if #REGa is less than #N$1C.
 $EF00 JR C,$EF32    ; }
; Code #N$1C fills a box of spaces.
 $EF02 JR Z,$EF3C    ; Jump to #R$EF3C if #REGa is #N$1C.
; Code #N$1D starts a new line from the left margin.
 $EF04 CP $1E        ; {Jump to #R$EF67 if #REGa is less than #N$1E.
 $EF06 JR C,$EF67    ; }
; Code #N$1E adds to the column, then advances the row.
 $EF08 JR Z,$EF77    ; Jump to #R$EF77 if #REGa is #N$1E.
; Code #N$1F calls a location-art sub-script.
 $EF0A CP $1F        ; {Jump to #R$EF92 if #REGa is #N$1F.
 $EF0C JP Z,$EF92    ; }
; Literal character: store it and print via #R$EF82.
 $EF0F LD ($5BF9),A  ; {Store the character in *#R$5BF9 and print it.
 $EF12 CALL $EF82    ; }
 $EF15 JR $EEF1      ; Jump to #R$EEF1.
@label=PrintMessage_SetPosition
*$EF17 LD ($5BF8),A  ; {Store the new row and column in the print state.
 $EF1A LD A,(HL)     ;
 $EF1B LD ($5BF7),A  ; }
 $EF1E LD ($5B00),A  ; {Remember the left margin at #R$5B00 and continue.
 $EF21 INC HL        ;
 $EF22 JR $EEF1      ; }
@label=PrintMessage_SetAttribute
*$EF24 LD A,(HL)     ; {Store the next script byte as the print attribute.
 $EF25 LD ($5BF5),A  ;
 $EF28 INC HL        ;
 $EF29 JR $EEF1      ; }
@label=PrintMessage_SetFlags
*$EF2B LD A,(HL)     ; {Store the next script byte as the print flags.
 $EF2C LD ($5BF6),A  ;
 $EF2F INC HL        ;
 $EF30 JR $EEF1      ; }
@label=PrintMessage_Repeat
*$EF32 LD A,(HL)     ; {Load the repeat count from the script.
 $EF33 LD B,A        ; }
@label=PrintMessage_Repeat_Loop
*$EF34 CALL $EF82    ; {Print the current character that many times.
 $EF37 DJNZ $EF34    ; }
 $EF39 INC HL        ; {Advance the script and continue.
 $EF3A JR $EEF1      ; }
@label=PrintMessage_FillBox
*$EF3C LD B,(HL)     ; {Set the fill character to a space and load the row
 $EF3D LD A,$20      ; count.
 $EF3F LD ($5BF9),A  ;
 $EF42 INC HL        ; }
 $EF43 LD A,(HL)     ; {Store the fill attribute and start row from the script.
 $EF44 LD ($5BF5),A  ;
 $EF47 INC HL        ;
 $EF48 LD A,(HL)     ;
 $EF49 LD ($5BF8),A  ; }
@label=PrintMessage_FillBox_Row
*$EF4C PUSH BC       ; {Begin a row of #N$14 spaces from column #N$06.
 $EF4D LD B,$14      ;
 $EF4F LD A,$06      ;
 $EF51 LD ($5BF7),A  ; }
@label=PrintMessage_FillBox_Column
*$EF54 CALL $EF82    ; {Print one row of spaces.
 $EF57 DJNZ $EF54    ; }
 $EF59 LD A,($5BF8)  ; {Advance the print row and loop until the box is filled.
 $EF5C INC A         ;
 $EF5D LD ($5BF8),A  ;
 $EF60 POP BC        ;
 $EF61 DJNZ $EF4C    ; }
 $EF63 INC HL        ; {Advance the script and continue.
 $EF64 JP $EEF1      ; }
@label=PrintMessage_NewLine
*$EF67 LD A,($5B00)  ; {Restore the column from the left-margin copy at
 $EF6A LD ($5BF7),A  ; #R$5B00.}
@label=PrintMessage_AdvanceRow
*$EF6D LD A,($5BF8)  ; {Advance the print row.
 $EF70 INC A         ;
 $EF71 LD ($5BF8),A  ; }
 $EF74 JP $EEF1      ; Jump to #R$EEF1.
@label=PrintMessage_AddColumn
*$EF77 LD B,(HL)     ; {Add the next script byte to the left-margin column.
 $EF78 LD A,($5B00)  ;
 $EF7B ADD A,B       ;
 $EF7C LD ($5BF7),A  ;
 $EF7F INC HL        ; }
 $EF80 JR $EF6D      ; Jump to #R$EF6D to advance the row.

; Clip And Print Character
;
; Used by the routine at #R$EEF1.
; .
; Gate before #R$EA8D: ignore columns past #N($1A), and skip
; printing for the left margin (columns below #N$06) while still
; advancing the cursor.
@label=ClipAndPrintCharacter
c$EF82 LD A,($5BF7)  ; {Fetch the column and compare it with #N$1A.
 $EF85 CP $1A        ; }
 $EF87 RET NC        ; Return if the column is past #N$1A.
 $EF88 CP $06        ; {Jump to #R$EA8D if the column is in the printable area.
 $EF8A JP NC,$EA8D   ; }
 $EF8D INC A         ; {Otherwise just bump the cursor.
 $EF8E LD ($5BF7),A  ; }
 $EF91 RET           ; Return.

; Call Sub-Message
;
; Used by the routine at #R$EEF1.
; .
; Control code #N$1F: read a new column and a sub-script id,
; then dispatch via #R$EFA4.
@label=CallSubMessage
c$EF92 LD A,(HL)     ; {Set the column and left margin from the next script
 $EF93 LD ($5BF7),A  ; byte.
 $EF96 LD ($5B00),A  ;
 $EF99 INC HL        ; }
 $EF9A LD A,(HL)     ; {Fetch the sub-script id and stash the script pointer.
 $EF9B INC HL        ;
 $EF9C PUSH HL       ; }
 $EF9D CALL $EFA4    ; {Call #R$EFA4 and restore the script pointer.
 $EFA0 POP HL        ; }
 $EFA1 JP $EEF1      ; Jump to #R$EEF1.

; Sub-Message Select
;
; Used by the routine at #R$EF92.
; .
; Picks one of the small graphic scripts at #R$FDE8 and jumps
; into #R$EEF1. Ids #N$00-#N$05 cover the fragments used while drawing
; location art.
@label=SubMessageSelect
c$EFA4 CP $01        ; {Jump to #R$EFB9 if the id is #N$00.
 $EFA6 JR C,$EFB9    ; }
 $EFA8 JR Z,$EFC4    ; Jump to #R$EFC4 if the id is #N$01.
 $EFAA CP $02        ; {Jump to #R$EFCF if the id is #N$02.
 $EFAC JR Z,$EFCF    ; }
 $EFAE CP $04        ; {Jump to #R$EFDF if the id is #N$03.
 $EFB0 JR C,$EFDF    ; }
 $EFB2 JR Z,$EFEA    ; Jump to #R$EFEA if the id is #N$04.
 $EFB4 CP $06        ; {Jump to #R$EFF5 if the id is #N$05.
 $EFB6 JR C,$EFF5    ; }
 $EFB8 RET           ; Return.
; Select sub-script #R$FDE8 (digit/punct rows at attr #N$0C).
@label=SubMessageSelect_DigitPunctuation
*$EFB9 LD A,$01      ; {Set row #N$01 and point at sub-script #R$FDE8.
 $EFBB LD ($5BF8),A  ;
 $EFBE LD HL,$FDE8   ; }
 $EFC1 JP $EEF1      ; Jump to #R$EEF1.
; Select sub-script #R$FE12 (punct/symbol rows at attr #N$0C).
@label=SubMessageSelect_Punctuation
*$EFC4 LD A,$02      ; {Set row #N$02 and point at sub-script #R$FE12.
 $EFC6 LD ($5BF8),A  ;
 $EFC9 LD HL,$FE12   ; }
 $EFCC JP $EEF1      ; Jump to #R$EEF1.
; Select the alternate font at #R$F278 and sub-script #N$01.
@label=SubMessageSelect_AlternateCharset
@keep
*$EFCF LD HL,$F178   ; {Write #R$F278(#N$F178) to *#SKOOLKID$5C36(CHARS) and run
 $EFD2 LD ($5C36),HL ; sub-script #N$01.
 $EFD5 CALL $EFC4    ; }
@keep
 $EFD8 LD HL,$F128   ; {Write #R$F228(#N$F128) to *#SKOOLKID$5C36(CHARS).
 $EFDB LD ($5C36),HL ; }
 $EFDE RET           ; Return.
; Select sub-script #R$FE2D (two glyphs at attr #N$27).
@label=SubMessageSelect_DualGlyph
*$EFDF LD A,$06      ; {Set row #N$06 and point at sub-script #R$FE2D.
 $EFE1 LD ($5BF8),A  ;
 $EFE4 LD HL,$FE2D   ; }
 $EFE7 JP $EEF1      ; Jump to #R$EEF1.
; Select sub-script #R$FE37 (three glyphs at attr #N$27).
@label=SubMessageSelect_TripleGlyph
*$EFEA LD A,$05      ; {Set row #N$05 and point at sub-script #R$FE37.
 $EFEC LD ($5BF8),A  ;
 $EFEF LD HL,$FE37   ; }
 $EFF2 JP $EEF1      ; Jump to #R$EEF1.
; Select sub-script #R$FE41 (glyph band at attr #N$28/#N$38).
@label=SubMessageSelect_GlyphStrip
*$EFF5 LD HL,$FE41   ; #REGhl=#R$FE41.
 $EFF8 JP $EEF1      ; Jump to #R$EEF1.

; Location Graphic Setup
