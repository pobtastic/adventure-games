@label=ParserState_TokenChar
 $5BAB DEFB $00      ; Token first character.
@label=ParserState_TokenDelimiter
 $5BAC DEFB $00      ; Token delimiter.
@label=ParserState_EntryCount
 $5BAD DEFB $00      ; BASIC-list entry count.

