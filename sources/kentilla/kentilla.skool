; Jump Table
;
; #HTML(BASIC <code>USR</code> <code>n</code> lands on address
; <code>n</code> and follows the <code>JP</code> there.)
;
; .
;
; #HTML(Action dispatch (BASIC). After #R$F0E6 returns from ENTER,
; line 130 <code>GO SUB 1000</code>. Line 1010 calls <code>USR</code>
; #R$EA63 (#R$ED2D); on a hit, line 1020 advances the token, reads an
; optional noun via <code>USR</code> #R$EA69, then
; <code>GO TO n*100+1000</code> for verb index <code>n</code>. Separately,
; line 310 calls <code>USR</code> #R$EA6F (#R$ED7E) for #R$F99C:
; indices #N$01-#N$06 move; #N$07+ go to line 400.)
; .
; Core command handlers (BASIC, via #R$ED7E). LOOK at line
; 441 goes to 350 to redraw the room; lines 450-499 ("I see") are a
; shared subroutine reached from there and elsewhere.
; .
; #TABLE(default,centre,centre,centre)
; { =h Idx | =h Word | =h Summary }
; { #N$01-#N$06 | NORTH..DOWN | Exit; redraw }
; { #N$07 | INVENTORY | List carried }
; { #N$08 | LOOK | Redraw room }
; { #N$09 | HELP | Can't help }
; { #N$0A | SAVE | Tape SAVE }
; { #N$0B | LOAD | Tape LOAD }
; { #N$0C | QUIT | Quit }
; { #N$0D | SCORE | Completion % }
; { #N$0E | WAIT | "I wait." }
; TABLE#
; .
; #HTML(Core verb handlers (BASIC, via #R$ED2D then
; <code>n*100+1000</code>). Noun index from #R$ED71 is BASIC
; <code>x</code> where used. ENTER (<code>GO TO</code> 1800) and GO
; (<code>GO TO</code> 1900) share one handler at line 1910, since there
; are no lines from 1800 to 1909.)
; .
; #TABLE(default,centre,centre,centre)
; { =h Idx | =h Word | =h Summary }
; { #N$01 | GET | Take item }
; { #N$02 | TAKE | Same as GET }
; { #N$03 | DROP | Drop item }
; { #N$04 | EXAMINE | Examine; may reveal }
; { #N$05 | SEARCH | Find concealed items }
; { #N$08/#N$09 | ENTER/GO | Shared at 1910 }
; { #N$19 | LOOK | Look at noun/dir }
; TABLE#
; .
; #HTML(Remaining verbs in #R$FAA9 (indices #N$06-#N$2E
; except the core rows above). Line 1020 still uses
; <code>GO TO n*100+1000</code>; when that line is missing, BASIC
; continues at the next existing line.)
; .
; Combat and speech. ATTACK and KILL share one fight
; routine: with a carried weapon they injure or slay a creature in
; the room. SAY talks to creatures (and can trigger give/take replies).
; HIT smashes a magical ward or, with the staff, turns a foe to dust;
; BREAK is the same fight path. SHOOT fires the bow.
; .
; Movement and the boat. CLIMB covers the rope, a tree and
; the boat mast. SWIM crosses the river; SWING on a hanging rope joins
; that same crossing. PULL and MOVE share one routine for hauling the
; boat into the sea, tugging the tied rope, or opening a sliding panel.
; PUSH works the lever. LEAVE, ROW and BAIL handle getting out of nested
; places and travelling or emptying the boat (ROW needs the oars; BAIL
; needs a helmet).
; .
; Inventory and wearables. THROW drops a carried object into
; the scenery (river, tree, far bank). WEAR and REMOVE put on or take
; off clothing and gems. GIVE hands an object to a creature. EAT
; consumes food and can restore hits. PUT stashes things in containers,
; the furnace crucible, the black sack or a chest. INSERT seats the pin
; that locks the sword arm.
; .
; Doors, chests and light. UNLOCK, OPEN, CLOSE and LOCK all
; resolve the target door or chest through the shared helper at line
; 2650, then change its open/locked state (keys must fit). LIGHT and
; EXTINGUISH manage the torch. TURN works the furnace or the dial.
; .
; Magic and discovery. READ shows book and scroll texts.
; CAST spends a scroll plus its ingredient (fire protection, cure
; disease, heal). RUB the lamp for the Jinni. DIG may unearth a buried
; find; DIP melts metal in the furnace; LISTEN can reveal the death-
; beetle hint. TIE and UNTIE fasten or free the rope on a stalagmite
; (UNTIE also frees Timandra). USE only asks for a more specific verb.
; .
; #HTML(Landing notes where the nominal
; <code>n*100+1000</code> line is missing or shared:)
; .
; #TABLE(default,centre,centre,centre)
; { =h Idx | =h Word | =h Lands }
; { #N$06/#N$07 | ATTACK/KILL | 1701 (no 1600-1700) }
; { #N$0A | SAY | 2001 }
; { #N$0B | CLIMB | 2105 }
; { #N$0C | TIE | 2205 }
; { #N$0D | THROW | 2310 }
; { #N$0E | WEAR | 2410 }
; { #N$0F | REMOVE | 2510 }
; { #N$10 | UNLOCK | 2610 }
; { #N$11 | OPEN | 2715 }
; { #N$12 | CLOSE | 2810 }
; { #N$13 | READ | 2905 }
; { #N$14 | LOCK | 3010 }
; { #N$15 | SWIM | 3110 }
; { #N$16 | GIVE | 3205 }
; { #N$17/#N$18 | PULL/MOVE | 3410 (no 3300-3409) }
; { #N$1A | PUSH | 3605 }
; { #N$1B | EAT | 3700 }
; { #N$1C | LIGHT | 3820 }
; { #N$1D | EXTINGUISH | 3920 }
; { #N$1E | TURN | 4010 }
; { #N$1F | HIT | 4105 }
; { #N$20 | PUT | 4205 }
; { #N$21 | DIG | 4305 }
; { #N$22 | DIP | 4405 }
; { #N$23 | RUB | 4510 }
; { #N$24 | LISTEN | 4605 }
; { #N$25 | SHOOT | 4705 }
; { #N$26 | CAST | 4810 }
; { #N$27 | LEAVE | 4910 }
; { #N$28 | ROW | 5005 }
; { #N$29 | INSERT | 5110 }
; { #N$2A | UNTIE | 5210 }
; { #N$2B | BREAK | 5300→4100 (HIT) }
; { #N$2C | SWING | 5410→3130 (SWIM) }
; { #N$2D | BAIL | 5500 }
; { #N$2E | USE | 5600 }
; TABLE#
@label=JumpTable
c$EA60 JP $ED65      ; Jump to #R$ED65.
@label=JumpTable_SearchVerbs
 $EA63 JP $ED2D      ; Jump to #R$ED2D.
@label=JumpTable_InputLine
 $EA66 JP $EB51      ; Jump to #R$EB51.
@label=JumpTable_SearchNouns
 $EA69 JP $ED71      ; Jump to #R$ED71.
@label=JumpTable_AdvanceInputPointer
 $EA6C JP $EDAF      ; Jump to #R$EDAF.
@label=JumpTable_SearchCommands
 $EA6F JP $ED7E      ; Jump to #R$ED7E.
@label=JumpTable_TokenHelper
 $EA72 JP $EDEE      ; Jump to #R$EDEE.
@label=JumpTable_BasicHelper
 $EA75 JP $EE60      ; Jump to #R$EE60.
@label=JumpTable_SeedPrimaryBuffer
 $EA78 JP $EEB9      ; Jump to #R$EEB9.
@label=JumpTable_StepWorkBuffer
 $EA7B JP $EEC8      ; Jump to #R$EEC8.
@label=JumpTable_SeedSecondaryBuffer
 $EA7E JP $EEE7      ; Jump to #R$EEE7.
@label=JumpTable_ScanInputSpaces
 $EA81 JP $F14C      ; Jump to #R$F14C.
@label=JumpTable_CopyWorkBuffer
 $EA84 JP $F140      ; Jump to #R$F140.
@label=JumpTable_LocationGraphicSetup
 $EA87 JP $EFFB      ; Jump to #R$EFFB.
@label=JumpTable_ScrollAdjust
 $EA8A JP $F0D3      ; Jump to #R$F0D3.

; Print Character
;
; Used by the routines at #R$EB51, #R$ECC0, #R$EF82, #R$EFFB and #R$F0E6.
; .
; Plots one character glyph into the display file. Callers set
; up #R$5BF5 first.
@label=PrintCharacter
c$EA8D PUSH AF       ; {Stash the flags, counters, screen pointer and glyph pointer
 $EA8E PUSH BC       ; on the stack.
 $EA8F PUSH DE       ;
 $EA90 PUSH HL       ; }
; #HTML(Pick the plot opcode written into #R$EAF0(#N$EAF1):
; #N$AE (<code>XOR (HL)</code>) or #N$B6 (<code>OR (HL)</code>) from
; bit 2 of the flags.)
 $EA91 LD A,($5BF6)  ; Fetch *#R$5BF6.
 $EA94 BIT 2,A       ; Test bit 2.
 $EA96 LD A,$AE      ; {#HTML(Prefer #N$AE (<code>XOR</code>) unless bit 2 was
 $EA98 JR Z,$EA9C    ; set.)}
 $EA9A LD A,$B6      ; #HTML(#REGa=#N$B6 (<code>OR</code>).)
@label=PrintCharacter_SetPlotOpcode
@keep
*$EA9C LD ($EAF1),A  ; Patch that opcode into #R$EAF0(#N$EAF1).
; Point #REGhl at the 8-byte glyph. Codes below #N$8F use
; #SKOOLKID$5C36(CHARS); #N$90 and above were meant to index
; #SKOOLKID$5C7B(UDG), but the unconditional jump at #R$EAA4 always takes
; the #SKOOLKID$5C36(CHARS) path.
 $EA9F LD A,($5BF9)  ; {Fetch *#R$5BF9 and compare it with #N$8F.
 $EAA2 CP $8F        ; }
@label=PrintCharacter_ForceChars
 $EAA4 JR $EAB6      ; Always take the #SKOOLKID$5C36(CHARS) path at #R$EAB6.
; Unreachable #SKOOLKID$5C7B(UDG) path (left in the binary after
; #R$EAA4).
 $EAA6 JR C,$EAB6    ; Jump to #R$EAB6 if carry is set.
 $EAA8 SUB $90       ; {Scale the UDG index and point #REGhl at
 $EAAA ADD A,A       ; #SKOOLKID$5C7B(UDG).
 $EAAB ADD A,A       ;
 $EAAC ADD A,A       ;
 $EAAD LD E,A        ;
 $EAAE LD D,$00      ;
 $EAB0 LD HL,($5C7B) ;
 $EAB3 ADD HL,DE     ; }
 $EAB4 JR $EAC1      ; Jump to #R$EAC1.
@label=PrintCharacter_CharsGlyph
*$EAB6 LD DE,($5C36) ; {Point #REGhl at glyph *#R$5BF9 in
 $EABA LD L,A        ; #SKOOLKID$5C36(CHARS).
 $EABB LD H,$00      ;
 $EABD ADD HL,HL     ;
 $EABE ADD HL,HL     ;
 $EABF ADD HL,HL     ;
 $EAC0 ADD HL,DE     ; }
; Convert row/column at #R$5BF7 into a display-file address in
; #REGde.
@label=PrintCharacter_ScreenAddress
*$EAC1 LD DE,$4000   ; #REGde=#N$4000 (screen buffer).
 $EAC4 LD BC,($5BF7) ; #REGbc=*#R$5BF7.
 $EAC8 LD A,C        ; {Jump to #R$EB39 if the column is out of range.
 $EAC9 CP $20        ;
 $EACB JR NC,$EB39   ; }
 $EACD LD A,B        ; {Jump to #R$EB39 if the row is out of range.
 $EACE CP $18        ;
 $EAD0 JR NC,$EB39   ; }
@label=PrintCharacter_RowThirds
*$EAD2 CP $08        ; {Jump to #R$EAE0 if this row is already in the current
 $EAD4 JR C,$EAE0    ; third.}
 $EAD6 SUB $08       ; {Move #REGd down one screen third and try again.
 $EAD8 PUSH AF       ;
 $EAD9 LD A,D        ;
 $EADA ADD A,$08     ;
 $EADC LD D,A        ;
 $EADD POP AF        ;
 $EADE JR $EAD2      ; }
@label=PrintCharacter_ColumnOffset
*$EAE0 ADD A,A       ; {Fold the row remainder and column into #REGe.
 $EAE1 ADD A,A       ;
 $EAE2 ADD A,A       ;
 $EAE3 ADD A,A       ;
 $EAE4 ADD A,A       ;
 $EAE5 ADD A,C       ;
 $EAE6 LD E,A        ; }
; #HTML(Copy or <code>XOR</code> the 8 glyph rows into the display
; file.)
 $EAE7 LD A,($5BF6)  ; Fetch *#R$5BF6.
 $EAEA AND %00000001 ; Keep only bit 0.
 $EAEC JR Z,$EAF9    ; #HTML(Jump to #R$EAF9 if <code>XOR</code> mode is
                     ; clear.)
 $EAEE LD B,$08      ; #REGb=#N$08.
@label=PrintCharacter_XorLoop
*$EAF0 LD A,(DE)     ; {#HTML(Plot one glyph row with the patched
 $EAF1 XOR (HL)      ; <code>XOR</code>/<code>OR</code> at #R$EAF0(#N$EAF1) and move down a
 $EAF2 LD (DE),A     ; pixel line.)
 $EAF3 INC HL        ;
 $EAF4 INC D         ;
 $EAF5 DJNZ $EAF0    ; }
 $EAF7 JR $EB01      ; Jump to #R$EB01.
@label=PrintCharacter_CopyLoop
*$EAF9 LD B,$08      ; #REGb=#N$08.
@label=PrintCharacter_CopyLoop_Body
*$EAFB LD A,(HL)     ; {Copy one glyph row into the display file and move down a
 $EAFC LD (DE),A     ; pixel line.
 $EAFD INC HL        ;
 $EAFE INC D         ;
 $EAFF DJNZ $EAFB    ; }
; Unless bit 1 of the flags is set, write the attribute from
; #R$5BF5 into the matching attribute-file cell.
@label=PrintCharacter_Attributes
*$EB01 LD A,($5BF6)  ; Fetch *#R$5BF6.
 $EB04 AND %00000010 ; Keep only bit 1.
 $EB06 JR NZ,$EB28   ; Jump to #R$EB28 if attributes are skipped.
 $EB08 LD A,($5BF5)  ; {Point #REGhl at the attribute-file cell for *#R$5BF7.
 $EB0B LD C,A        ;
 $EB0C LD DE,($5BF7) ;
 $EB10 LD H,$58      ;
 $EB12 LD A,D        ; }
@label=PrintCharacter_AttrRow
*$EB13 SUB $08       ; {Jump to #R$EB19 if another attribute third remains.
 $EB15 JR NC,$EB19   ; }
 $EB17 JR $EB1C      ; Jump to #R$EB1C.
@label=PrintCharacter_AttrNextThird
*$EB19 INC H         ; {Step #REGh to the next attribute third and retry.
 $EB1A JR $EB13      ; }
@label=PrintCharacter_AttrColumn
*$EB1C ADD A,$08     ; {Restore the row remainder into #REGb and load the
 $EB1E LD B,A        ; column.
 $EB1F LD A,E        ; }
 $EB20 JR Z,$EB26    ; Jump to #R$EB26 if that remainder is zero.
*$EB22 ADD A,$20     ; {Add #N$20 per remaining row to reach the cell.
 $EB24 DJNZ $EB22    ; }
@label=PrintCharacter_WriteAttr
*$EB26 LD L,A        ; {Write *#R$5BF5 into that attribute-file cell.
 $EB27 LD (HL),C     ; }
; Advance the cursor: move to the next column, or wrap to the next
; row.
@label=PrintCharacter_AdvanceCursor
*$EB28 LD DE,($5BF7) ; {Advance the column.
 $EB2C INC E         ; }
 $EB2D LD A,E        ; {Jump to #R$EB35 if the column is still on this row.
 $EB2E CP $20        ;
 $EB30 JR NZ,$EB35   ; }
 $EB32 LD E,$00      ; {Wrap to column #N$00 on the next row.
 $EB34 INC D         ; }
@label=PrintCharacter_StoreCursor
*$EB35 LD ($5BF7),DE ; Store the updated cursor back in *#R$5BF7.
@label=PrintCharacter_Exit
*$EB39 POP HL        ; {Restore the glyph pointer, screen pointer, counters and
 $EB3A POP DE        ; flags from the stack.
 $EB3B POP BC        ;
 $EB3C POP AF        ; }
 $EB3D RET           ; Return.

; Input Line Symbol-Shift Remap
;
; Used by the routine at #R$EB51.
; .
; #HTML(Reached from #R$EB81. Any other key returns to #R$EB5E.)
@label=InputLine_SymbolShiftRemap
c$EB3E LD A,E        ; {Jump to #R$EB48 unless the key is "P".
 $EB3F CP $50        ;
 $EB41 JR NZ,$EB48   ; }
 $EB43 LD A,$22      ; {#HTML(#REGe=<code>"</code>.)
 $EB45 LD E,A        ; }
 $EB46 JR $EB83      ; Jump to #R$EB83.
@label=InputLine_SymbolShiftRemap_J
*$EB48 CP $4A        ; {Jump to #R$EB5E unless the key is "J".
 $EB4A JR NZ,$EB5E   ; }
 $EB4C LD A,$2D      ; {#REGe="-".
 $EB4E LD E,A        ; }
 $EB4F JR $EB83      ; Jump to #R$EB83.

; Input Line
;
; Used by the routine at #R$EA60.
; .
; Main game entry from #R$EA66. ENTER submits via #R$F0E6.
@label=InputLine
c$EB51 SUB A         ; {Write #N$00 to *#R$5BFB, *#R$5BFA and *#R$5BFD.
 $EB52 LD ($5BFB),A  ;
 $EB55 LD ($5BFA),A  ;
 $EB58 LD ($5BFD),A  ; }
 $EB5B CALL $ECF0    ; Call #R$ECF0.
; This entry point is used by the routine at #R$EB3E.
; .
; Wait until a new key is down.
@label=InputLine_Poll
*$EB5E LD A,($5BFC)  ; {Copy *#R$5BFC to #REGd.
 $EB61 LD D,A        ; }
 $EB62 LD A,($5C04)  ; Read #SKOOLKID$5C00(KSTATE) (second key slot).
 $EB65 LD ($5BFC),A  ; Write the key to *#R$5BFC.
 $EB68 CP $FF        ; {Jump to #R$EB5E if none is down.
 $EB6A JR Z,$EB5E    ; }
 $EB6C CP D          ; {Jump to #R$EB5E if the key has not changed.
 $EB6D JR Z,$EB5E    ; }
 $EB6F LD E,A        ; #REGe=#REGa.
; Test for Caps Shift.
 $EB70 LD BC,$FEFE   ; {Read from the keyboard;
 $EB73 IN A,(C)      ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FE | CAPS SHIFT | Z | X | C | V }
                     ; TABLE#}
 $EB75 BIT 0,A       ; {Jump to #R$EBF5 when Caps Shift is held.
 $EB77 JP Z,$EBF5    ; }
 $EB7A LD BC,$7FFE   ; {Read from the keyboard;
 $EB7D IN A,(C)      ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7F | SPACE | SYMBOL SHIFT | M | N | B }
                     ; TABLE#}
 $EB7F BIT 1,A       ; Test the Symbol Shift bit.
; Test for Symbol Shift.
@label=InputLine_SymbolShiftHeld
 $EB81 JR Z,$EB3E    ; Jump to #R$EB3E when it is held.
; This entry point is used by the routine at #R$EB3E.
; .
; Handle an ordinary keypress.
@label=InputLine_HandleKey
*$EB83 LD A,E        ; {Jump to #R$EBD9 if ENTER was pressed.
 $EB84 CP $0D        ;
 $EB86 JR Z,$EBD9    ; }
; Append the character to the input buffer.
 $EB88 LD A,($5BFA)  ; {Fetch *#R$5BFA into #REGd.
 $EB8B LD D,A        ; }
 $EB8C CP $3E        ; {Jump to #R$EB5E if the line already holds #N$3E
 $EB8E JR NC,$EB5E   ; characters.}
 $EB90 LD HL,$5BAE   ; {Store the key in #R$5BAE and *#R$5BF9.
 $EB93 ADD A,L       ;
 $EB94 LD L,A        ;
 $EB95 LD A,E        ;
 $EB96 LD (HL),A     ;
 $EB97 LD ($5BF9),A  ; }
 $EB9A LD A,$16      ; {Set #R$5BF8, #R$5BF6 and #R$5BF5 for echoing on row
 $EB9C LD ($5BF8),A  ; #N$16.
 $EB9F SUB A         ;
 $EBA0 LD ($5BF6),A  ;
 $EBA3 LD A,$05      ;
 $EBA5 LD ($5BF5),A  ; }
 $EBA8 LD A,D        ; {Copy *#R$5BFA to *#R$5BF7.
 $EBA9 LD ($5BF7),A  ; }
 $EBAC CP $20        ; {Jump to #R$EBBA if the column is still on this row.
 $EBAE JR C,$EBBA    ; }
 $EBB0 SUB $20       ; {Wrap onto row #N$17.
 $EBB2 LD ($5BF7),A  ;
 $EBB5 LD A,$17      ;
 $EBB7 LD ($5BF8),A  ; }
; Echo it onto the input row.
@label=InputLine_EchoChar
*$EBBA CALL $EA8D    ; Call #R$EA8D.
 $EBBD LD A,($5BFB)  ; {Grow *#R$5BFB if this column is new.
 $EBC0 CP D          ;
 $EBC1 JR NZ,$EBC7   ;
 $EBC3 INC A         ;
 $EBC4 LD ($5BFB),A  ; }
; Advance the cursor, click, and poll again.
@label=InputLine_AdvanceCursor
*$EBC7 LD A,D        ; {Advance *#R$5BFA.
 $EBC8 INC A         ;
 $EBC9 LD ($5BFA),A  ; }
 $EBCC CALL $ECF0    ; Call #R$ECF0.
 $EBCF LD A,$01      ; {Set *#R$5BFD.
 $EBD1 LD ($5BFD),A  ; }
 $EBD4 CALL $ED23    ; Call #R$ED23.
 $EBD7 JR $EB5E      ; Jump to #R$EB5E.
; Terminate the buffer with ENTER and submit the line.
@label=InputLine_Enter
*$EBD9 LD A,($5BFB)  ; {Copy *#R$5BFB to *#R$5BFE.
 $EBDC LD ($5BFE),A  ; }
 $EBDF LD A,($5BFB)  ; {Write ENTER (#N$0D) at the end of #R$5BAE.
 $EBE2 LD HL,$5BAE   ;
 $EBE5 ADD A,L       ;
 $EBE6 LD L,A        ;
 $EBE7 LD (HL),$0D   ; }
 $EBE9 LD HL,$5BAE   ; {Point #R$5BA7 and #R$5BA9 at #R$5BAE.
 $EBEC LD ($5BA7),HL ;
 $EBEF LD ($5BA9),HL ; }
 $EBF2 JP $F0E6      ; Jump to #R$F0E6.
; #HTML(Caps Shift chords: <code>1</code> restore length, <code>5</code>/
; <code>8</code> move the cursor, <code>9</code> insert a space,
; <code>0</code> delete, <code>2</code> is a no-op stub.)
@label=InputLine_CapsShift
*$EBF5 LD A,E        ; {Jump to #R$EC12 if Caps Shift + 1.
 $EBF6 CP $31        ;
 $EBF8 JR Z,$EC12    ; }
 $EBFA CP $32        ; {Jump to #R$EC25 if Caps Shift + 2.
 $EBFC JR Z,$EC25    ; }
 $EBFE CP $35        ; {Jump to #R$EC36 if Caps Shift + 5.
 $EC00 JR Z,$EC36    ; }
 $EC02 CP $38        ; {Jump to #R$EC4D if Caps Shift + 8.
 $EC04 JR Z,$EC4D    ; }
 $EC06 CP $30        ; {Jump to #R$EC97 if Caps Shift + 0.
 $EC08 JP Z,$EC97    ; }
 $EC0B CP $39        ; {Jump to #R$EC68 if Caps Shift + 9.
 $EC0D JR Z,$EC68    ; }
 $EC0F JP $EB5E      ; Jump to #R$EB5E.
; Restore the saved length and redraw.
@label=InputLine_Caps1
*$EC12 LD A,($5BFD)  ; {Jump to #R$EB5E if *#R$5BFD is set.
 $EC15 AND A         ;
 $EC16 JP NZ,$EB5E   ; }
 $EC19 LD A,($5BFE)  ; {Copy *#R$5BFE to *#R$5BFB.
 $EC1C LD ($5BFB),A  ; }
 $EC1F CALL $ECC0    ; Call #R$ECC0.
 $EC22 JP $EB5E      ; Jump to #R$EB5E.
; Caps Shift + 2 is a no-op.
@label=InputLine_Caps2
*$EC25 LD A,($5BFD)  ; {Jump to #R$EB5E.
 $EC28 AND A         ;
 $EC29 JP Z,$EB5E    ;
 $EC2C JP NZ,$EB5E   ; }
 $EC2F LD A,($5BFE)  ; {Copy *#R$5BFE to *#R$5BFB.
 $EC32 LD ($5BFB),A  ; }
 $EC35 RET           ; Return.
; Move the cursor one column left and redraw it.
@label=InputLine_Caps5
*$EC36 LD A,($5BFA)  ; {Jump to #R$EB5E if already at the start.
 $EC39 AND A         ;
 $EC3A JP Z,$EB5E    ; }
 $EC3D CALL $ED1C    ; Call #R$ED1C.
 $EC40 LD A,($5BFA)  ; {Decrease *#R$5BFA.
 $EC43 DEC A         ;
 $EC44 LD ($5BFA),A  ; }
 $EC47 CALL $ECF0    ; Call #R$ECF0.
 $EC4A JP $EB5E      ; Jump to #R$EB5E.
; Move the cursor one column right and redraw it.
@label=InputLine_Caps8
*$EC4D LD A,($5BFB)  ; {Jump to #R$EB5E if already at the end of the line.
 $EC50 LD B,A        ;
 $EC51 LD A,($5BFA)  ;
 $EC54 CP B          ;
 $EC55 JP Z,$EB5E    ; }
 $EC58 CALL $ED1C    ; Call #R$ED1C.
 $EC5B LD A,($5BFA)  ; {Increase *#R$5BFA.
 $EC5E INC A         ;
 $EC5F LD ($5BFA),A  ; }
 $EC62 CALL $ECF0    ; Call #R$ECF0.
 $EC65 JP $EB5E      ; Jump to #R$EB5E.
; Insert a space at the cursor by shifting the tail right.
@label=InputLine_Caps9
*$EC68 LD A,($5BFB)  ; {Jump to #R$EB5E if the line is full.
 $EC6B CP $3E        ;
 $EC6D JP NC,$EB5E   ; }
 $EC70 INC A         ; {Increase *#R$5BFB.
 $EC71 LD ($5BFB),A  ; }
 $EC74 LD E,A        ; {Work out how many bytes to shift.
 $EC75 LD A,($5BFA)  ;
 $EC78 LD B,A        ;
 $EC79 LD A,E        ;
 $EC7A SUB B         ;
 $EC7B LD C,A        ; }
 $EC7C LD A,E        ; {Point #REGhl at the end of #R$5BAE.
 $EC7D LD HL,$5BAE   ;
 $EC80 ADD A,L       ;
 $EC81 LD L,A        ; }
 $EC82 PUSH HL       ; {Copy #REGhl to #REGde (using the stack).
 $EC83 POP DE        ; }
 $EC84 DEC HL        ; {Shift the tail right.
 $EC85 LD B,$00      ;
 $EC87 LDDR          ; }
 $EC89 LD A,$20      ; {Write a space at the cursor.
 $EC8B LD (DE),A     ; }
 $EC8C CALL $ECC0    ; Call #R$ECC0.
 $EC8F LD A,$01      ; {Set *#R$5BFD.
 $EC91 LD ($5BFD),A  ; }
 $EC94 JP $EB5E      ; Jump to #R$EB5E.
; Delete the character left of the cursor by shifting the tail left.
@label=InputLine_Caps0
*$EC97 LD A,($5BFA)  ; {Jump to #R$EB5E if already at the start.
 $EC9A AND A         ;
 $EC9B JP Z,$EB5E    ; }
 $EC9E DEC A         ; {Decrease *#R$5BFA.
 $EC9F LD ($5BFA),A  ; }
 $ECA2 LD B,A        ; {Decrease *#R$5BFB.
 $ECA3 LD A,($5BFB)  ;
 $ECA6 DEC A         ;
 $ECA7 LD ($5BFB),A  ; }
 $ECAA SUB B         ; {Count the bytes to shift.
 $ECAB LD C,A        ;
 $ECAC INC C         ; }
 $ECAD LD HL,$5BAE   ; {Point #REGhl at the cursor in #R$5BAE.
 $ECB0 LD A,B        ;
 $ECB1 ADD A,L       ;
 $ECB2 LD L,A        ; }
 $ECB3 PUSH HL       ; {Copy #REGhl to #REGde (using the stack).
 $ECB4 POP DE        ; }
 $ECB5 INC HL        ; {Shift the tail left.
 $ECB6 LD B,$00      ;
 $ECB8 LDIR          ; }
 $ECBA CALL $ECC0    ; Call #R$ECC0.
 $ECBD JP $EB5E      ; Jump to #R$EB5E.

; Input Line Redraw
;
; Used by the routine at #R$EB51.
; .
; Redraws the input row, then the cursor at #R$ECF0.
@label=InputLine_Redraw
c$ECC0 LD HL,$5BAE   ; Point #REGhl at #R$5BAE.
 $ECC3 SUB A         ; {Write #N$00 to *#R$5BF6 and *#R$5BF7.
 $ECC4 LD ($5BF6),A  ;
 $ECC7 LD ($5BF7),A  ; }
 $ECCA LD A,$05      ; {Write #N$05 to *#R$5BF5.
 $ECCC LD ($5BF5),A  ; }
 $ECCF LD A,$16      ; {Write #N$16 to *#R$5BF8.
 $ECD1 LD ($5BF8),A  ; }
 $ECD4 LD A,($5BFB)  ; {Jump to #R$ECE5 if the line is empty.
 $ECD7 AND A         ;
 $ECD8 JR Z,$ECE5    ; }
 $ECDA LD B,A        ; #REGb=the line length.
; Print each buffered character.
@label=InputLine_Redraw_Loop
*$ECDB LD A,(HL)     ; {Call #R$EA8D for the next character.
 $ECDC LD ($5BF9),A  ;
 $ECDF CALL $EA8D    ;
 $ECE2 INC HL        ;
 $ECE3 DJNZ $ECDB    ; }
; Pad the rest of the row with spaces.
@label=InputLine_Redraw_Pad
*$ECE5 LD A,$20      ; {Write a space to *#R$5BF9.
 $ECE7 LD ($5BF9),A  ; }
 $ECEA CALL $EA8D    ; Call #R$EA8D.
 $ECED CALL $EA8D    ; Call #R$EA8D.
; This entry point is used by the routine at #R$EB51.
; .
; Draw the blinking cursor.
@label=InputLine_DrawCursor
*$ECF0 LD A,$28      ; {Write #N$28 to *#R$5BF5.
 $ECF2 LD ($5BF5),A  ; }
; This entry point is used by the routine at #R$ED1C.
; .
; #HTML(Set <code>XOR</code> mode and load a space glyph.)
@label=InputLine_DrawCursor_Body
*$ECF5 LD A,$01      ; {#HTML(Set <code>XOR</code> mode in *#R$5BF6.)
 $ECF7 LD ($5BF6),A  ; }
 $ECFA LD A,$20      ; {Write a space to *#R$5BF9.
 $ECFC LD ($5BF9),A  ; }
 $ECFF LD A,$16      ; {Write #N$16 to *#R$5BF8.
 $ED01 LD ($5BF8),A  ; }
 $ED04 LD A,($5BFA)  ; {Copy *#R$5BFA to *#R$5BF7.
 $ED07 LD ($5BF7),A  ; }
 $ED0A CP $20        ; {Jump to #R$ED18 if the column is still on this row.
 $ED0C JR C,$ED18    ; }
 $ED0E SUB $20       ; {Wrap onto row #N$17.
 $ED10 LD ($5BF7),A  ;
 $ED13 LD A,$17      ;
 $ED15 LD ($5BF8),A  ; }
; Print the cursor glyph.
@label=InputLine_DrawCursor_Print
*$ED18 CALL $EA8D    ; Call #R$EA8D.
 $ED1B RET           ; Return.

; Input Line Clear Cursor
;
; Used by the routine at #R$EB51.
; .
; Same as #R$ECF0, used before moving the cursor.
@label=InputLine_ClearCursor
c$ED1C LD A,$05      ; {Write #N$05 to *#R$5BF5.
 $ED1E LD ($5BF5),A  ; }
 $ED21 JR $ECF5      ; Jump to #R$ECF5.

; Input Line Click
;
; Used by the routine at #R$EB51.
; .
; Heard after a character is accepted.
@label=InputLine_Click
c$ED23 LD DE,$0005   ; {Play a short click through #SKOOLKID$03B5(BEEPER).
 $ED26 LD HL,$01F4   ;
 $ED29 CALL $03B5    ; }
 $ED2C RET           ; Return.

; Search Vocabulary (Verbs)
;
; Used by the routine at #R$EA60.
; .
; #HTML(Jump-table target #R$EA63 (<code>USR</code> #R$EA63). On a
; hit, BASIC <code>GO TO n*100+1000</code> for verb index <code>n</code>
; (see #R$EA60).)
@label=SearchVocabulary_Verbs
c$ED2D LD A,$02      ; {Write #N$02 to *#R$5BA4.
 $ED2F LD ($5BA4),A  ; }
 $ED32 LD B,$2F      ; {Point #REGhl at #R$FAA9 with word limit #N$2F.
 $ED34 LD HL,$FAA9   ; }
; This entry point is used by the routines at #R$ED65, #R$ED71 and #R$ED7E.
; .
; Shared search loop used by #R$ED2D, #R$ED65, #R$ED71 and #R$ED7E.
@label=SearchVocabulary_Loop
*$ED37 LD A,$01      ; {Write #N$01 to *#R$5BA5.
 $ED39 LD ($5BA5),A  ; }
; Compare this table word.
@label=SearchVocabulary_TryWord
*$ED3C PUSH HL       ; {Stash #REGhl and #REGbc on the stack.
 $ED3D PUSH BC       ; }
 $ED3E LD DE,($5BA7) ; Copy *#R$5BA7 to #REGde.
 $ED42 CALL $ED8A    ; Call #R$ED8A.
 $ED45 POP BC        ; {Restore #REGbc and #REGhl from the stack.
 $ED46 POP HL        ; }
 $ED47 JR NC,$ED5E   ; Jump to #R$ED5E if the word matched.
@label=SearchVocabulary_SkipWord
*$ED49 INC HL        ; {Skip ahead to the ENTER that ends this table word.
 $ED4A LD A,(HL)     ;
 $ED4B CP $0D        ;
 $ED4D JR NZ,$ED49   ; }
 $ED4F INC HL        ; Advance #REGhl past the ENTER.
 $ED50 LD A,($5BA5)  ; {Increment *#R$5BA5.
 $ED53 INC A         ;
 $ED54 LD ($5BA5),A  ; }
 $ED57 CP B          ; {Jump to #R$ED3C if there are more words to try.
 $ED58 JR C,$ED3C    ; }
 $ED5A LD BC,$0000   ; #REGbc=#N($0000,$04,$04) on a miss.
 $ED5D RET           ; Return.
; A vocabulary word matched.
@label=SearchVocabulary_Matched
*$ED5E LD A,($5BA5)  ; {Copy *#R$5BA5 into #REGbc.
 $ED61 LD C,A        ;
 $ED62 LD B,$00      ; }
 $ED64 RET           ; Return.

; Search Vocabulary (Prepositions)
;
; Used by the routines at #R$EA60 and #R$EDEE.
; .
; #HTML(Jump-table target #R$EA60 (<code>USR</code> #R$EA60). Uses
; the shared loop at #R$ED37.)
@label=SearchVocabulary_Prepositions
c$ED65 LD A,$02      ; {Write #N$02 to *#R$5BA4.
 $ED67 LD ($5BA4),A  ; }
 $ED6A LD B,$09      ; {Point #REGhl at #R$FBA8 with word limit #N$09.
 $ED6C LD HL,$FBA8   ; }
 $ED6F JR $ED37      ; Jump to #R$ED37.

; Search Vocabulary (Nouns)
;
; Used by the routine at #R$EA60.
; .
; #HTML(Jump-table target #R$EA69 (<code>USR</code> #R$EA69). BASIC
; stores the index as <code>x</code> for verb handlers (see #R$EA60).)
@label=SearchVocabulary_Nouns
c$ED71 LD A,$02      ; {Write #N$02 to *#R$5BA4.
 $ED73 LD ($5BA4),A  ; }
 $ED76 LD B,$43      ; {Point #REGhl at #R$FBF4 with word limit #N$43.
 $ED78 LD HL,$FBF4   ; }
 $ED7B JP $ED37      ; Jump to #R$ED37.

; Search Vocabulary (Commands)
;
; Used by the routine at #R$EA60.
; .
; #HTML(Jump-table target #R$EA6F (<code>USR</code> #R$EA6F). Short
; commands like <code>UP</code> still hit. BASIC line 310 uses the index
; for movement (#N$01-#N$06) or the command handlers at line 400+
; (see #R$EA60).)
@label=SearchVocabulary_Commands
c$ED7E LD A,$01      ; {Write #N$01 to *#R$5BA4.
 $ED80 LD ($5BA4),A  ; }
 $ED83 LD B,$0F      ; {Point #REGhl at #R$F99C with word limit #N$0F.
 $ED85 LD HL,$F99C   ; }
 $ED88 JR $ED37      ; Jump to #R$ED37.

; Compare Token To Vocabulary Word
;
; Used by the routines at #R$ED2D, #R$EDAF, #R$EDEE and #R$EE60.
; .
; Returns with carry reset on a match, set on a miss.
@label=CompareTokenToWord
c$ED8A LD B,$00      ; #REGb=#N$00.
 $ED8C PUSH DE       ; Stash the token pointer on the stack.
@label=CompareTokenToWord_Count
*$ED8D LD A,(DE)     ; {Jump to #R$ED9A if *#REGde is a control character (<
 $ED8E CP $21        ; #N$21).
 $ED90 JR C,$ED9A    ; }
 $ED92 CP $22        ; {Jump to #R$ED9A if *#REGde is a quote.
 $ED94 JR Z,$ED9A    ; }
 $ED96 INC B         ; {Count this character and keep scanning the token.
 $ED97 INC DE        ;
 $ED98 JR $ED8D      ; }
@label=CompareTokenToWord_CheckLength
*$ED9A POP DE        ; Restore the token pointer from the stack.
 $ED9B LD A,($5BA4)  ; {Jump to #R$EDAD if the token is shorter than *#R$5BA4.
 $ED9E LD C,A        ;
 $ED9F LD A,B        ;
 $EDA0 CP C          ;
 $EDA1 JR C,$EDAD    ; }
@label=CompareTokenToWord_Match
*$EDA3 LD A,(DE)     ; {Jump to #R$EDAD if the next characters differ.
 $EDA4 CP (HL)       ;
 $EDA5 JR NZ,$EDAD   ; }
 $EDA7 INC HL        ; {Advance both pointers and keep matching.
 $EDA8 INC DE        ;
 $EDA9 DJNZ $EDA3    ; }
 $EDAB AND A         ; Clear carry on a full match.
 $EDAC RET           ; Return.
; The token did not match this table word.
@label=CompareTokenToWord_Miss
*$EDAD SCF           ; Set carry on a miss.
 $EDAE RET           ; Return.

; Advance Input Pointer
;
; Used by the routines at #R$EA60 and #R$F14C.
; .
; #HTML(Jump-table target #R$EA6C.)
@label=AdvanceInputPointer
c$EDAF LD HL,($5BA7) ; {Fetch *#R$5BA7.
 $EDB2 LD A,(HL)     ; }
 $EDB3 CP $0D        ; {Return if this token is ENTER.
 $EDB5 RET Z         ; }
; Move on to the next token.
 $EDB6 LD HL,($5BA9) ; {Copy *#R$5BA9 to *#R$5BA7.
 $EDB9 LD ($5BA7),HL ; }
 $EDBC LD A,(HL)     ; {Write *#REGhl to *#R$5BAB.
 $EDBD LD ($5BAB),A  ; }
 $EDC0 CP $0D        ; {Return if that token is ENTER.
 $EDC2 RET Z         ; }
; Walk to the delimiter that ends this token.
@label=AdvanceInputPointer_Scan
*$EDC3 INC HL        ; {Jump to #R$EDD7 if this character is ENTER.
 $EDC4 LD A,(HL)     ;
 $EDC5 CP $0D        ;
 $EDC7 JR Z,$EDD7    ; }
 $EDC9 CP $22        ; {Jump to #R$EDD7 on a quote.
 $EDCB JR Z,$EDD7    ; }
 $EDCD CP $20        ; {Keep scanning until a space.
 $EDCF JR NZ,$EDC3   ; }
@label=AdvanceInputPointer_SkipSpaces
*$EDD1 INC HL        ; {Skip any run of spaces.
 $EDD2 LD A,(HL)     ;
 $EDD3 CP $20        ;
 $EDD5 JR Z,$EDD1    ; }
@label=AdvanceInputPointer_Store
*$EDD7 LD ($5BAC),A  ; Write the delimiter to *#R$5BAC.
 $EDDA LD ($5BA9),HL ; Write #REGhl to *#R$5BA9.
 $EDDD LD A,$03      ; {Write #N$03 to *#R$5BA4.
 $EDDF LD ($5BA4),A  ; }
; Skip a leading "THE".
 $EDE2 LD HL,($5BA7) ; Copy *#R$5BA7 to #REGhl.
 $EDE5 LD DE,$FBA4   ; #REGde=#R$FBA4.
 $EDE8 CALL $ED8A    ; Call #R$ED8A.
 $EDEB JR NC,$EDAF   ; Jump to #R$EDAF if "THE" was skipped.
 $EDED RET           ; Return.

; Match Token In BASIC List
;
; Used by the routine at #R$EA60.
; .
; Jump-table target #R$EA72. Returns #REGbc=index or
; #N($0000,$04,$04).
@label=MatchTokenInBasicList
c$EDEE LD A,$02      ; {Write #N$02 to *#R$5BA4.
 $EDF0 LD ($5BA4),A  ; }
 $EDF3 DEC A         ; {Write #N$01 to *#R$5BA5.
 $EDF4 LD ($5BA5),A  ; }
 $EDF7 LD A,($5BAC)  ; {Jump to #R$EE23 if *#R$5BAC is ENTER.
 $EDFA CP $0D        ;
 $EDFC JR Z,$EE23    ; }
 $EDFE CP $22        ; {Jump to #R$EE23 if *#R$5BAC is a quote.
 $EE00 JR Z,$EE23    ; }
 $EE02 LD HL,($5BA7) ; {Stash *#R$5BA7 on the stack.
 $EE05 PUSH HL       ; }
 $EE06 LD HL,($5BA9) ; {Copy *#R$5BA9 to *#R$5BA7.
 $EE09 LD ($5BA7),HL ; }
 $EE0C CALL $ED65    ; Call #R$ED65.
 $EE0F LD A,$01      ; {Write #N$01 to *#R$5BA5.
 $EE11 LD ($5BA5),A  ; }
 $EE14 POP HL        ; {Restore *#R$5BA7 from the stack.
 $EE15 LD ($5BA7),HL ; }
 $EE18 LD A,C        ; {Jump to #R$EE23 if #REGc holds a preposition hit.
 $EE19 AND A         ;
 $EE1A JR NZ,$EE23   ; }
 $EE1C LD A,$01      ; {Set *#R$5BFD.
 $EE1E LD ($5BFD),A  ; }
 $EE21 JR $EE29      ; Jump to #R$EE29.
; Clear the dirty flag and scan.
@label=MatchTokenInBasicList_ClearDirty
*$EE23 SUB A         ; {Write #N$00 to *#R$5BFD.
 $EE24 LD ($5BFD),A  ; }
 $EE27 JR $EE6E      ; Jump to #R$EE6E.
; Compare the next BASIC-list word.
@label=MatchTokenInBasicList_Scan
*$EE29 LD HL,($5C57) ; {Point #REGhl at the next BASIC-list word.
 $EE2C LD DE,$0008   ;
 $EE2F ADD HL,DE     ; }
 $EE30 LD DE,($5BA7) ; Copy *#R$5BA7 to #REGde.
 $EE34 PUSH HL       ; Stash #REGhl on the stack.
 $EE35 CALL $ED8A    ; Call #R$ED8A.
 $EE38 POP HL        ; Restore #REGhl from the stack.
 $EE39 JR C,$EE4F    ; Jump to #R$EE4F if it missed.
@label=MatchTokenInBasicList_NextWord
*$EE3B INC HL        ; {Skip to the next space-separated word in this entry.
 $EE3C LD A,(HL)     ;
 $EE3D CP $22        ;
 $EE3F JR Z,$EE4F    ;
 $EE41 CP $20        ;
 $EE43 JR NZ,$EE3B   ; }
 $EE45 INC HL        ; Advance #REGhl.
 $EE46 LD DE,($5BA9) ; Copy *#R$5BA9 to #REGde.
 $EE4A CALL $ED8A    ; Call #R$ED8A.
 $EE4D JR NC,$EE59   ; Jump to #R$EE59 if it matched.
; This entry point is used by the routine at #R$EE60.
@label=MatchTokenInBasicList_AdvanceEntry
*$EE4F CALL $EE9C    ; Call #R$EE9C.
 $EE52 CP B          ; {Jump to #R$EE29 if there are more entries.
 $EE53 JR C,$EE29    ; }
; This entry point is used by the routines at #R$EE60 and #R$EEB9.
@label=MatchTokenInBasicList_Miss
*$EE55 LD BC,$0000   ; #REGbc=#N($0000,$04,$04) on a miss.
 $EE58 RET           ; Return.
; This entry point is used by the routines at #R$EE60 and #R$EEB9.
; .
; A BASIC-list word matched.
@label=MatchTokenInBasicList_Hit
*$EE59 LD A,($5BA5)  ; {Copy *#R$5BA5 into #REGbc.
 $EE5C LD C,A        ;
 $EE5D LD B,$00      ; }
 $EE5F RET           ; Return.

; BASIC Helper
;
; Used by the routine at #R$EA60.
; .
; Jump-table target #R$EA75.
@label=BasicHelper
c$EE60 LD HL,($5BA0) ; {Copy *#R$5BA0 to *#SKOOLKID$5C57(NSPPC).
 $EE63 LD ($5C57),HL ; }
 $EE66 LD A,($5BFD)  ; {Jump to #R$EE4F if *#R$5BFD is set.
 $EE69 AND A         ;
 $EE6A JR NZ,$EE4F   ; }
 $EE6C JR $EE94      ; Jump to #R$EE94.
; This entry point is used by the routine at #R$EDEE.
; .
; Compare the next BASIC-list word.
@label=BasicHelper_Scan
*$EE6E LD HL,($5C57) ; {Point #REGhl at the next BASIC-list word.
 $EE71 LD DE,$0008   ;
 $EE74 ADD HL,DE     ; }
 $EE75 PUSH HL       ; Stash #REGhl on the stack.
 $EE76 LD DE,($5BA7) ; Copy *#R$5BA7 to #REGde.
 $EE7A CALL $ED8A    ; Call #R$ED8A.
 $EE7D POP HL        ; Restore #REGhl from the stack.
 $EE7E JR NC,$EE59   ; Jump to #R$EE59 if it matched.
@label=BasicHelper_NextWord
*$EE80 INC HL        ; {Skip to the next space-separated word in this entry.
 $EE81 LD A,(HL)     ;
 $EE82 CP $22        ;
 $EE84 JR Z,$EE94    ;
 $EE86 CP $20        ;
 $EE88 JR NZ,$EE80   ; }
 $EE8A INC HL        ; Advance #REGhl.
 $EE8B LD DE,($5BA7) ; Copy *#R$5BA7 to #REGde.
 $EE8F CALL $ED8A    ; Call #R$ED8A.
 $EE92 JR NC,$EE59   ; Jump to #R$EE59 if it matched.
@label=BasicHelper_AdvanceEntry
*$EE94 CALL $EE9C    ; Call #R$EE9C.
 $EE97 CP B          ; {Jump to #R$EE6E if there are more entries.
 $EE98 JR C,$EE6E    ; }
 $EE9A JR $EE55      ; Jump to #R$EE55.

; Step BASIC List Entry
;
; Used by the routines at #R$EDEE and #R$EE60.
; .
; Step one length-prefixed BASIC-list entry.
@label=StepBasicListEntry
c$EE9C LD HL,($5C57) ; {Skip the length prefix and advance
 $EE9F INC HL        ; #SKOOLKID$5C57(NSPPC) by that many bytes.
 $EEA0 INC HL        ;
 $EEA1 INC HL        ;
 $EEA2 LD E,(HL)     ;
 $EEA3 LD D,$00      ;
 $EEA5 ADD HL,DE     ;
 $EEA6 INC HL        ; }
 $EEA7 LD ($5C57),HL ; {Store the new #SKOOLKID$5C57(NSPPC) in #R$5BA0 as well.
 $EEAA LD ($5BA0),HL ; }
 $EEAD LD A,($5BAD)  ; {Copy *#R$5BAD into #REGb.
 $EEB0 LD B,A        ; }
 $EEB1 LD A,($5BA5)  ; {Increment *#R$5BA5.
 $EEB4 INC A         ;
 $EEB5 LD ($5BA5),A  ; }
 $EEB8 RET           ; Return.

; Seed Primary Work Buffer
;
; Used by the routine at #R$EA60.
; .
; #HTML(Jump-table target #R$EA78 (<code>USR</code> #R$EA78). BASIC
; uses this for INVENTORY / LOOK object lists (see #R$EA60).)
@label=SeedPrimaryWorkBuffer
c$EEB9 LD HL,$FA00   ; {Point #R$5BA2 at #R$FA00 with #N$2D entries.
 $EEBC LD ($5BA2),HL ;
 $EEBF LD A,$2D      ; }
; This entry point is used by the routine at #R$EEE7.
; .
; Remember the entry limit and clear the word index.
@label=SeedWorkBuffer_Common
*$EEC1 LD ($5BFB),A  ; Write #REGa to *#R$5BFB.
 $EEC4 SUB A         ; {Write #N$00 to *#R$5BA5.
 $EEC5 LD ($5BA5),A  ; }
; This entry point is used by the routine at #R$EA60.
; .
; Step to the next work-buffer entry.
@label=StepWorkBuffer
*$EEC8 LD A,($5BA5)  ; {Increment *#R$5BA5 into #REGc.
 $EECB INC A         ;
 $EECC LD ($5BA5),A  ;
 $EECF LD C,A        ; }
 $EED0 LD HL,($5BA2) ; {Step *#R$5BA2.
 $EED3 INC HL        ;
 $EED4 LD ($5BA2),HL ; }
 $EED7 LD A,($5BFD)  ; {Jump to #R$EE59 if this entry matches.
 $EEDA CP (HL)       ;
 $EEDB JP Z,$EE59    ; }
 $EEDE LD A,($5BFB)  ; {Jump to #R$EEC8 if there are more entries.
 $EEE1 CP C          ;
 $EEE2 JR NZ,$EEC8   ; }
 $EEE4 JP $EE55      ; Jump to #R$EE55.

; Seed Secondary Work Buffer
;
; Used by the routine at #R$EA60.
; .
; #HTML(Jump-table target #R$EA7E (<code>USR</code> #R$EA7E). Same
; path as #R$EEB9 from the secondary buffer.)
@label=SeedSecondaryWorkBuffer
c$EEE7 LD HL,$FA2D   ; {Point #R$5BA2 at #R$FA2D with #N$22 entries.
 $EEEA LD ($5BA2),HL ;
 $EEED LD A,$22      ; }
 $EEEF JR $EEC1      ; Jump to #R$EEC1.

; Print Message
;
; Used by the routines at #R$EF92, #R$EFA4 and #R$EFFB.
; .
; Walks a message script pointed to by #REGhl. Bytes below #N$20
; are control codes; the rest print as literals via #R$EF82.
@label=PrintMessage
c$EEF1 LD A,(HL)     ; {Fetch the next script byte.
 $EEF2 INC HL        ; }
; Codes #N$00-#N$17 set the print row and column.
 $EEF3 CP $18        ; {Jump to #R$EF17 if #REGa is less than #N$18.
 $EEF5 JR C,$EF17    ; }
; Code #N$18 sets the print attribute.
 $EEF7 JR Z,$EF24    ; Jump to #R$EF24 if #REGa is #N$18.
; Code #N$1A ends the script.
 $EEF9 CP $1A        ; {Return if #REGa is #N$1A.
 $EEFB RET Z         ; }
; Code #N$19 sets the print flags.
 $EEFC JR C,$EF2B    ; Jump to #R$EF2B if #REGa is less than #N$1A.
; Code #N$1B repeats the current character.
 $EEFE CP $1C        ; {Jump to #R$EF32 if #REGa is less than #N$1C.
 $EF00 JR C,$EF32    ; }
; Code #N$1C fills a box of spaces.
 $EF02 JR Z,$EF3C    ; Jump to #R$EF3C if #REGa is #N$1C.
; Code #N$1D starts a new line from the left margin.
 $EF04 CP $1E        ; {Jump to #R$EF67 if #REGa is less than #N$1E.
 $EF06 JR C,$EF67    ; }
; Code #N$1E adds to the column, then advances the row.
 $EF08 JR Z,$EF77    ; Jump to #R$EF77 if #REGa is #N$1E.
; Code #N$1F calls a location-art sub-script.
 $EF0A CP $1F        ; {Jump to #R$EF92 if #REGa is #N$1F.
 $EF0C JP Z,$EF92    ; }
; Literal character.
 $EF0F LD ($5BF9),A  ; Write #REGa to *#R$5BF9.
 $EF12 CALL $EF82    ; Call #R$EF82.
 $EF15 JR $EEF1      ; Jump to #R$EEF1.
; Set the print row, column and left margin.
@label=PrintMessage_SetPosition
*$EF17 LD ($5BF8),A  ; Write #REGa to *#R$5BF8.
 $EF1A LD A,(HL)     ; {Write the next script byte to *#R$5BF7.
 $EF1B LD ($5BF7),A  ; }
 $EF1E LD ($5B00),A  ; Write #REGa to *#R$5B00.
 $EF21 INC HL        ; Advance #REGhl.
 $EF22 JR $EEF1      ; Jump to #R$EEF1.
; Set the print attribute.
@label=PrintMessage_SetAttribute
*$EF24 LD A,(HL)     ; {Write the next script byte to *#R$5BF5.
 $EF25 LD ($5BF5),A  ; }
 $EF28 INC HL        ; Advance #REGhl.
 $EF29 JR $EEF1      ; Jump to #R$EEF1.
; Set the print flags.
@label=PrintMessage_SetFlags
*$EF2B LD A,(HL)     ; {Write the next script byte to *#R$5BF6.
 $EF2C LD ($5BF6),A  ; }
 $EF2F INC HL        ; Advance #REGhl.
 $EF30 JR $EEF1      ; Jump to #R$EEF1.
; Repeat the current character.
@label=PrintMessage_Repeat
*$EF32 LD A,(HL)     ; {Load the repeat count from the script.
 $EF33 LD B,A        ; }
@label=PrintMessage_Repeat_Loop
*$EF34 CALL $EF82    ; {Call #R$EF82 until the count is done.
 $EF37 DJNZ $EF34    ; }
 $EF39 INC HL        ; Advance #REGhl.
 $EF3A JR $EEF1      ; Jump to #R$EEF1.
; Fill a box of spaces.
@label=PrintMessage_FillBox
*$EF3C LD B,(HL)     ; #REGb=the row count.
 $EF3D LD A,$20      ; {Write a space to *#R$5BF9.
 $EF3F LD ($5BF9),A  ; }
 $EF42 INC HL        ; {Write the next script byte to *#R$5BF5.
 $EF43 LD A,(HL)     ;
 $EF44 LD ($5BF5),A  ; }
 $EF47 INC HL        ; {Write the next script byte to *#R$5BF8.
 $EF48 LD A,(HL)     ;
 $EF49 LD ($5BF8),A  ; }
; Print one row of the box.
@label=PrintMessage_FillBox_Row
*$EF4C PUSH BC       ; Stash the row counter on the stack.
 $EF4D LD B,$14      ; {Begin a row of #N$14 spaces from column #N$06.
 $EF4F LD A,$06      ;
 $EF51 LD ($5BF7),A  ; }
@label=PrintMessage_FillBox_Column
*$EF54 CALL $EF82    ; {Call #R$EF82 until the column count is done.
 $EF57 DJNZ $EF54    ; }
 $EF59 LD A,($5BF8)  ; {Advance *#R$5BF8.
 $EF5C INC A         ;
 $EF5D LD ($5BF8),A  ; }
 $EF60 POP BC        ; {Restore the row counter and loop.
 $EF61 DJNZ $EF4C    ; }
 $EF63 INC HL        ; Advance #REGhl.
 $EF64 JP $EEF1      ; Jump to #R$EEF1.
; Start a new line from the left margin.
@label=PrintMessage_NewLine
*$EF67 LD A,($5B00)  ; {Restore the column from the left-margin copy at
 $EF6A LD ($5BF7),A  ; #R$5B00.}
@label=PrintMessage_AdvanceRow
*$EF6D LD A,($5BF8)  ; {Advance *#R$5BF8.
 $EF70 INC A         ;
 $EF71 LD ($5BF8),A  ; }
 $EF74 JP $EEF1      ; Jump to #R$EEF1.
; Add to the column, then advance the row.
@label=PrintMessage_AddColumn
*$EF77 LD B,(HL)     ; {Add the next script byte to the left-margin column.
 $EF78 LD A,($5B00)  ;
 $EF7B ADD A,B       ;
 $EF7C LD ($5BF7),A  ; }
 $EF7F INC HL        ; Advance #REGhl.
 $EF80 JR $EF6D      ; Jump to #R$EF6D.

; Clip And Print Character
;
; Used by the routine at #R$EEF1.
; .
; Gate before #R$EA8D.
@label=ClipAndPrintCharacter
c$EF82 LD A,($5BF7)  ; Fetch *#R$5BF7.
 $EF85 CP $1A        ; {Return if the column is past #N$1A.
 $EF87 RET NC        ; }
; Print, or just advance the cursor.
 $EF88 CP $06        ; {Jump to #R$EA8D if the column is in the printable area.
 $EF8A JP NC,$EA8D   ; }
 $EF8D INC A         ; {Otherwise just bump the cursor.
 $EF8E LD ($5BF7),A  ; }
 $EF91 RET           ; Return.

; Call Sub-Message
;
; Used by the routine at #R$EEF1.
; .
; Control code #N$1F.
@label=CallSubMessage
c$EF92 LD A,(HL)     ; {Write the next script byte to *#R$5BF7 and *#R$5B00.
 $EF93 LD ($5BF7),A  ;
 $EF96 LD ($5B00),A  ; }
 $EF99 INC HL        ; Advance #REGhl.
 $EF9A LD A,(HL)     ; {Fetch the sub-script id.
 $EF9B INC HL        ; }
 $EF9C PUSH HL       ; Stash the script pointer on the stack.
 $EF9D CALL $EFA4    ; Call #R$EFA4.
 $EFA0 POP HL        ; Restore the script pointer from the stack.
 $EFA1 JP $EEF1      ; Jump to #R$EEF1.

; Sub-Message Select
;
; Used by the routine at #R$EF92.
; .
; Picks one of the small graphic scripts at #R$FDE8 and jumps
; into #R$EEF1. Ids #N$00-#N$05 cover the fragments used while drawing
; location art.
@label=SubMessageSelect
c$EFA4 CP $01        ; {Jump to #R$EFB9 if the id is #N$00.
 $EFA6 JR C,$EFB9    ; }
 $EFA8 JR Z,$EFC4    ; Jump to #R$EFC4 if the id is #N$01.
 $EFAA CP $02        ; {Jump to #R$EFCF if the id is #N$02.
 $EFAC JR Z,$EFCF    ; }
 $EFAE CP $04        ; {Jump to #R$EFDF if the id is #N$03.
 $EFB0 JR C,$EFDF    ; }
 $EFB2 JR Z,$EFEA    ; Jump to #R$EFEA if the id is #N$04.
 $EFB4 CP $06        ; {Jump to #R$EFF5 if the id is #N$05.
 $EFB6 JR C,$EFF5    ; }
 $EFB8 RET           ; Return.
; Digit/punct rows at attribute #N$0C.
@label=SubMessageSelect_DigitPunctuation
*$EFB9 LD A,$01      ; {Write #N$01 to *#R$5BF8.
 $EFBB LD ($5BF8),A  ; }
 $EFBE LD HL,$FDE8   ; Point #REGhl at #R$FDE8.
 $EFC1 JP $EEF1      ; Jump to #R$EEF1.
; Punct/symbol rows at attribute #N$0C.
@label=SubMessageSelect_Punctuation
*$EFC4 LD A,$02      ; {Write #N$02 to *#R$5BF8.
 $EFC6 LD ($5BF8),A  ; }
 $EFC9 LD HL,$FE12   ; Point #REGhl at #R$FE12.
 $EFCC JP $EEF1      ; Jump to #R$EEF1.
; Alternate font at #R$F278.
@label=SubMessageSelect_AlternateCharset
@keep
*$EFCF LD HL,$F178   ; {Write #R$F278(#N$F178) to *#SKOOLKID$5C36(CHARS).
 $EFD2 LD ($5C36),HL ; }
 $EFD5 CALL $EFC4    ; Call #R$EFC4.
@keep
 $EFD8 LD HL,$F128   ; {Write #R$F228(#N$F128) to *#SKOOLKID$5C36(CHARS).
 $EFDB LD ($5C36),HL ; }
 $EFDE RET           ; Return.
; Two glyphs at attribute #N$27.
@label=SubMessageSelect_DualGlyph
*$EFDF LD A,$06      ; {Write #N$06 to *#R$5BF8.
 $EFE1 LD ($5BF8),A  ; }
 $EFE4 LD HL,$FE2D   ; Point #REGhl at #R$FE2D.
 $EFE7 JP $EEF1      ; Jump to #R$EEF1.
; Three glyphs at attribute #N$27.
@label=SubMessageSelect_TripleGlyph
*$EFEA LD A,$05      ; {Write #N$05 to *#R$5BF8.
 $EFEC LD ($5BF8),A  ; }
 $EFEF LD HL,$FE37   ; Point #REGhl at #R$FE37.
 $EFF2 JP $EEF1      ; Jump to #R$EEF1.
; Glyph band at attributes #N$28/#N$38.
@label=SubMessageSelect_GlyphStrip
*$EFF5 LD HL,$FE41   ; #REGhl=#R$FE41.
 $EFF8 JP $EEF1      ; Jump to #R$EEF1.

; Draw Location Graphic
;
; Used by the routine at #R$EA60.
; .
; Jump-table target #R$EA87. Points #SKOOLKID$5C36(CHARS) at
; #R$F228(#N$F128), draws the script for *#R$5B01, then restores the
; ROM font at #N$3C00.
@label=LocationGraphicSetup
c$EFFB LD A,$05      ; {Write #N$05 to *#R$5BF6.
 $EFFD LD ($5BF6),A  ; }
 $F000 LD HL,$F128   ; {Write #R$F228(#N$F128) to *#SKOOLKID$5C36(CHARS).
 $F003 LD ($5C36),HL ; }
 $F006 CALL $F010    ; Call #R$F010.
; Restore the ROM font after #R$F010 returns.
 $F009 LD HL,$3C00   ; {Write #N$3C00 to *#SKOOLKID$5C36(CHARS).
 $F00C LD ($5C36),HL ; }
 $F00F RET           ; Return.
; Match *#R$5B01 to a location script and jump into #R$EEF1.
@label=LocationGraphicSetup_SelectScript
*$F010 LD A,($5B01)  ; Fetch *#R$5B01.
 $F013 LD HL,$FE79   ; {Jump to #R$EEF1 if the id is #N$04 (dense forest).
 $F016 CP $04        ;
 $F018 JP Z,$EEF1    ; }
 $F01B LD HL,$FE97   ; {Jump to #R$EEF1 if the id is #N$12 (Carawood).
 $F01E CP $12        ;
 $F020 JP Z,$EEF1    ; }
 $F023 LD HL,$FEB8   ; {Jump to #R$EEF1 if the id is #N$13 (Carawood).
 $F026 CP $13        ;
 $F028 JP Z,$EEF1    ; }
 $F02B LD HL,$FED6   ; {Jump to #R$EEF1 if the id is #N$14 (Carawood).
 $F02E CP $14        ;
 $F030 JP Z,$EEF1    ; }
 $F033 LD HL,$FEF4   ; {Jump to #R$EEF1 if the id is #N$15 (Carawood).
 $F036 CP $15        ;
 $F038 JP Z,$EEF1    ; }
 $F03B LD HL,$FF12   ; {Jump to #R$EEF1 if the id is #N$16 (Carawood).
 $F03E CP $16        ;
 $F040 JP Z,$EEF1    ; }
 $F043 LD HL,$FF30   ; {Jump to #R$EEF1 if the id is #N$17 (Carawood).
 $F046 CP $17        ;
 $F048 JP Z,$EEF1    ; }
 $F04B LD HL,$FF45   ; {Jump to #R$F0D0 if the id is #N$18 (Carawood).
 $F04E CP $18        ;
 $F050 JR Z,$F0D0    ; }
 $F052 LD HL,$FF63   ; {Jump to #R$F0D0 if the id is #N$19 (Carawood).
 $F055 CP $19        ;
 $F057 JR Z,$F0D0    ; }
 $F059 LD HL,$FF7E   ; {Jump to #R$F0D0 if the id is #N$1A (Carawood).
 $F05C CP $1A        ;
 $F05E JR Z,$F0D0    ; }
 $F060 LD HL,$FF99   ; {Jump to #R$F0D0 if the id is #N$47 (at sea).
 $F063 CP $47        ;
 $F065 JR Z,$F0D0    ; }
 $F067 LD HL,$FFAA   ; {Jump to #R$F0D0 if the id is #N$2F (water's edge).
 $F06A CP $2F        ;
 $F06C JR Z,$F0D0    ; }
 $F06E LD HL,$FFCE   ; {Jump to #R$F0D0 if the id is #N$2E (Serpent Sea beach).
 $F071 CP $2E        ;
 $F073 JR Z,$F0D0    ; }
 $F075 LD HL,$F168   ; {Jump to #R$F0D0 if the id is #N$0F (high platform).
 $F078 CP $0F        ;
 $F07A JR Z,$F0D0    ; }
 $F07C LD HL,$F1D0   ; {Jump to #R$F0D0 if the id is #N$06 (arid scrubland).
 $F07F CP $06        ;
 $F081 JR Z,$F0D0    ; }
 $F083 LD HL,$F1DE   ; {Jump to #R$F0D0 if the id is #N$05 (scorched plains).
 $F086 CP $05        ;
 $F088 JR Z,$F0D0    ; }
 $F08A LD HL,$F744   ; {Jump to #R$F0D0 if the id is #N$1B (beside Tylon's
 $F08D CP $1B        ; castle).
 $F08F JR Z,$F0D0    ; }
 $F091 LD HL,$F7AA   ; {Jump to #R$F0D0 if the id is #N$0E (Cavezats cavern).
 $F094 CP $0E        ;
 $F096 JR Z,$F0D0    ; }
 $F098 LD HL,$F80B   ; {Jump to #R$F0D0 if the id is #N$01 (Ogeron's house).
 $F09B CP $01        ;
 $F09D JR Z,$F0D0    ; }
 $F09F LD HL,$F879   ; {Jump to #R$F0D0 if the id is #N$02 (edge of a large
 $F0A2 CP $02        ; forest).
 $F0A4 JR Z,$F0D0    ; }
 $F0A6 LD HL,$F8CA   ; {Jump to #R$F0D0 if the id is #N$0B (Urga-Maul dungeon).
 $F0A9 CP $0B        ;
 $F0AB JR Z,$F0D0    ; }
; No graphic script. Print a row of asterisks instead.
 $F0AD LD A,$18      ; {Write #N$18 to the line byte of #SKOOLKID$5C88(S_POSN).
 $F0AF LD ($5C89),A  ; }
 $F0B2 LD A,$03      ; {Write #N$03 to *#R$5BF5.
 $F0B4 LD ($5BF5),A  ; }
 $F0B7 LD HL,$0700   ; {Write row #N$07 and column #N$00 to *#R$5BF7.
 $F0BA LD ($5BF7),HL ; }
 $F0BD LD B,$20      ; #REGb=#N$20.
 $F0BF LD A,$2A      ; {#HTML(Write <code>*</code> to *#R$5BF9.)
 $F0C1 LD ($5BF9),A  ; }
 $F0C4 LD HL,$3C00   ; {Write #N$3C00 to *#SKOOLKID$5C36(CHARS).
 $F0C7 LD ($5C36),HL ; }
; Print one row of asterisks.
@label=LocationGraphicSetup_FillRow
*$F0CA CALL $EA8D    ; {Call #R$EA8D until the count is done.
 $F0CD DJNZ $F0CA    ; }
 $F0CF RET           ; Return.
; The later id matches cannot relative-jump to #R$EEF1.
@label=LocationGraphicSetup_PrintScript
*$F0D0 JP $EEF1      ; Jump to #R$EEF1.

; Scroll Screen
;
; Used by the routines at #R$EA60 and #R$F0E6.
; .
; Jump-table target #R$EA8A. Raises the line byte of
; #SKOOLKID$5C88(S_POSN) until it is at least #N$05. Each step calls
; #SKOOLKID$0DFE,$0E00(CL_SCROLL).
@label=ScrollAdjust
c$F0D3 LD A,($5C89)  ; {Return if the line byte of #SKOOLKID$5C88(S_POSN) is at
 $F0D6 CP $05        ; least #N$05.
 $F0D8 RET NC        ; }
 $F0D9 INC A         ; {Increment the line byte of #SKOOLKID$5C88(S_POSN).
 $F0DA LD ($5C89),A  ; }
 $F0DD LD B,$0F      ; {Call #SKOOLKID$0DFE,$0E00(CL_SCROLL) #N$0F times.
*$F0DF CALL $0E00    ;
 $F0E2 DJNZ $F0DF    ; }
 $F0E4 JR $F0D3      ; Jump to #R$F0D3.

; Submit Input Line
;
; Used by the routine at #R$EB51.
; .
; #HTML(Reached from #R$EBD9 when ENTER is pressed. Token walks
; and vocabulary lookup are separate jump-table entries (#R$EDAF,
; #R$ED7E and neighbours).)
@label=SubmitInputLine
c$F0E6 LD A,$20      ; {Write a space to *#R$5BF9.
 $F0E8 LD ($5BF9),A  ; }
 $F0EB LD B,$40      ; #REGb=#N$40.
 $F0ED SUB A         ; {Write #N$00 to *#R$5BF6, *#R$5BF5 and *#R$5BF7.
 $F0EE LD ($5BF6),A  ;
 $F0F1 LD ($5BF5),A  ;
 $F0F4 LD ($5BF7),A  ; }
 $F0F7 LD A,$16      ; {Write #N$16 to *#R$5BF8.
 $F0F9 LD ($5BF8),A  ; }
; Clear the input rows.
@label=SubmitInputLine_ClearLoop
*$F0FC CALL $EA8D    ; {Call #R$EA8D until the count is done.
 $F0FF DJNZ $F0FC    ; }
 $F101 SUB A         ; {Write #N$00 to *#R$5BF7.
 $F102 LD ($5BF7),A  ; }
 $F105 CALL $F0D3    ; Call #R$F0D3.
; Print a ">" prompt on the lower screen.
 $F108 LD A,($5C89)  ; {Write the prompt row to *#R$5BF8.
 $F10B LD B,A        ;
 $F10C LD A,$18      ;
 $F10E SUB B         ;
 $F10F LD ($5BF8),A  ; }
 $F112 LD A,$07      ; {Write #N$07 to *#R$5BF5.
 $F114 LD ($5BF5),A  ; }
 $F117 LD A,$3E      ; {#HTML(Write <code>></code> to *#R$5BF9.)
 $F119 LD ($5BF9),A  ; }
 $F11C CALL $EA8D    ; Call #R$EA8D.
; Echo the submitted line.
 $F11F LD A,$05      ; {Write #N$05 to *#R$5BF5.
 $F121 LD ($5BF5),A  ; }
 $F124 LD HL,$5BAE   ; Point #REGhl at #R$5BAE.
@label=SubmitInputLine_Echo
*$F127 LD A,(HL)     ; Fetch the next character.
 $F128 CP $0D        ; {Jump to #R$F135 if it is ENTER.
 $F12A JR Z,$F135    ; }
 $F12C INC HL        ; {Write this character to *#R$5BF9.
 $F12D LD ($5BF9),A  ; }
 $F130 CALL $EA8D    ; Call #R$EA8D.
 $F133 JR $F127      ; Jump to #R$F127.
; Scroll the lower screen back two rows.
@label=SubmitInputLine_ScrollBack
*$F135 LD A,($5C89)  ; {Subtract #N$02 from the line byte of
 $F138 SUB $02       ; #SKOOLKID$5C88(S_POSN).
 $F13A LD ($5C89),A  ; }
 $F13D JP $F0D3      ; Jump to #R$F0D3.

; Copy Work Buffer
;
; Used by the routine at #R$EA60.
; .
; Jump-table target #R$EA84. The copy source sits near the start
; of #R$E9B6.
@label=CopyWorkBuffer
c$F140 LD HL,$E9B7   ; {Copy #N($0096,$04,$04) bytes into the work buffer at
@keep
 $F143 LD DE,$FA01   ; #R$FA00(#N$FA01).
 $F146 LD BC,$0096   ;
 $F149 LDIR          ; }
 $F14B RET           ; Return.

; Scan Input Spaces
;
; Used by the routine at #R$EA60.
; .
; Jump-table target #R$EA81. A character below space returns
; with #REGbc unchanged.
@label=ScanInputSpaces
c$F14C LD DE,$5BAE   ; {Point #REGde at #R$5BAE.
 $F14F LD B,D        ; }
@label=ScanInputSpaces_Loop
*$F150 LD A,(DE)     ; {Fetch the next character.
 $F151 INC DE        ; }
 $F152 CP $20        ; {Return if it is below space.
 $F154 RET C         ; }
; A quote starts a token.
 $F155 CP $22        ; {Keep scanning until a quote.
 $F157 JR NZ,$F150   ; }
 $F159 LD ($5BA7),DE ; {Write #REGde to *#R$5BA7 and *#R$5BA9.
 $F15D LD ($5BA9),DE ; }
 $F161 CALL $EDAF    ; Call #R$EDAF.
 $F164 LD BC,$0000   ; #REGbc=#N($0000,$04,$04).
 $F167 RET           ; Return.

; Location Graphic Script: High Platform
;
; Location graphic script for location id #N$0F (high
; platform), picked by the dispatcher in #R$EFFB. Also here:
; #R$F1D0 (arid scrubland, id #N$06) and #R$F1DE (scorched plains,
; id #N$05). Drawn through #R$EEF1 using character codes into
; #R$F228. The arid-scrubland script has no #N$1A terminator, so
; after drawing location #N$06 the interpreter continues into
; #R$F1DE.
;
; .
;
; Location id #N$0F (high platform).
; .
; #UDGTABLE
; { =h High Platform }
; { #UDGS$14,$08,$02(high-platform)(
; #LET(ch=#MAP($y)($20,0:#MAP($x)($20,0:$63,1:$63,2:$62,3:$62,4:$62,11:$6E,
; 12:$70,13:$6E,14:$62,15:$62,16:$63,17:$63,18:$64,19:$64),1:#MAP($x)($20,
; 11:$6F,12:$71,13:$6F),2:#MAP($x)($20,4:$5E,5:$3B,6:$5F),3:#MAP($x)($20,4:$74,
; 5:$74,6:$74),4:#MAP($x)($20,4:$72,5:$73,6:$72),5:#MAP($x)($20,4:$73,5:$72,
; 6:$73,8:$62,9:$63,10:$62,11:$75,12:$76,14:$75),6:#MAP($x)($20,0:$64,1:$65,
; 2:$65,3:$66,4:$67,5:$67,6:$68,7:$3B,8:$3B,9:$3B,10:$3B,11:$77,12:$78,14:$77,
; 15:$68,16:$68,17:$67,18:$67,19:$66),7:$20))
; #LET(at=#MAP($y)($00,0:#MAP($x)($00,0:$22,1:$22,2:$22,3:$22,4:$22,5:$22,6:$22,
; 7:$22,8:$22,9:$22,10:$22,11:$27,12:$27,13:$27,14:$22,15:$22,16:$22,17:$22,
; 18:$22,19:$22),1:#MAP($x)($00,0:$10,1:$10,2:$10,3:$10,4:$10,5:$10,6:$10,7:$10,
; 8:$10,9:$10,10:$10,11:$17,12:$17,13:$17,14:$10,15:$10,16:$10,17:$10,18:$10,
; 19:$10),2:$10,3:#MAP($x)($00,0:$10,1:$10,2:$10,3:$10,4:$01,5:$01,6:$01,7:$10,
; 8:$10,9:$10,10:$10,11:$10,12:$10,13:$10,14:$10,15:$10,16:$10,17:$10,18:$10,
; 19:$10),4:#MAP($x)($00,0:$10,1:$10,2:$10,3:$10,4:$0D,5:$0D,6:$0D,7:$10,8:$10,
; 9:$10,10:$10,11:$10,12:$10,13:$10,14:$10,15:$10,16:$10,17:$10,18:$10,19:$10),
; 5:#MAP($x)($00,0:$10,1:$10,2:$10,3:$10,4:$0D,5:$0D,6:$0D,7:$10,8:$14,9:$14,
; 10:$14,11:$17,12:$17,13:$17,14:$17,15:$10,16:$10,17:$10,18:$10,19:$10),
; 6:#MAP($x)($00,0:$14,1:$14,2:$14,3:$14,4:$0C,5:$0C,6:$0C,7:$0C,8:$0C,9:$0C,
; 10:$0C,11:$27,12:$27,13:$27,14:$27,15:$14,16:$14,17:$14,18:$14,19:$14),7:$20))
; #UDG($F128+$08*{ch},{at},$02)(*g)
; g
; ) }
; UDGTABLE#
@label=LocationGraphicScript_HighPlatform
b$F168 DEFB $1C,$08,$10,$00,$18,$22,$00,$06
 $F170 DEFB $63,$63,$62,$62,$62,$4B,$1B,$05
 $F178 DEFB $18,$27,$6E,$70,$6E,$18,$22,$62
 $F180 DEFB $62,$63,$63,$64,$64,$01,$11,$18
 $F188 DEFB $17,$6F,$71,$6F,$02,$0A,$18,$10
 $F190 DEFB $5E,$3B,$5F,$1D,$18,$01,$74,$74
 $F198 DEFB $74,$1D,$18,$0D,$72,$73,$72,$1D
 $F1A0 DEFB $73,$72,$73,$18,$14,$06,$06,$64
 $F1A8 DEFB $65,$65,$66,$18,$0C,$67,$67,$68
