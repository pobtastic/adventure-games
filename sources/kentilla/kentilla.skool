; ROM Return Stub
;
; #HTML(Two <code>DEC SP</code> instructions and a jump to ROM
; #SKOOLKID$1B7D(STMT_RET). The Mastertronic reissue POKEs the same five bytes
; before its ROM loads; on this Micromega image they arrive with the final
; support block.)
@label=RomReturnStub
c$FFFB DEC SP        ; {Decrease #REGsp by two.
 $FFFC DEC SP        ; }
 $FFFD JP $1B7D      ; Jump to #SKOOLKID$1B7D(STMT_RET).
