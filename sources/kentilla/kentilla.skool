; Print Attribute
;
; Attribute byte written by #R$EA8D unless bit 1 of #R$5BF6 is
; set.
@label=PrintState
g$5BF5 DEFB $00

; Print Flags
;
; #HTML(Bit 0 selects <code>XOR</code> vs copy, bit 1 skips
; attributes, bit 2 selects <code>OR</code> vs <code>XOR</code>.)
@label=PrintState_Flags
g$5BF6 DEFB $00

; Print Column
;
; Print column (#N$00-#N$1F), paired with #R$5BF8 as #REGbc.
@label=PrintState_Column
g$5BF7 DEFB $00

; Print Row
;
; Print row (#N$00-#N$17), paired with #R$5BF7 as #REGbc.
@label=PrintState_Row
g$5BF8 DEFB $00

; Print Character
;
; Character code plotted by #R$EA8D.
@label=PrintState_Character
g$5BF9 DEFB $00

; Input Cursor Index
;
; Index of the cursor in #R$5BAE.
@label=InputLineState
g$5BFA DEFB $00

; Input Line Length
;
; Length of the current input line.
@label=InputLineState_Length
g$5BFB DEFB $00

; Input Previous Key
;
; Last #SKOOLKID$5C00(KSTATE) value, for edge detection.
@label=InputLineState_LastKey
g$5BFC DEFB $00

; Input Dirty Flag
;
; Set when the line has changed since the last redraw.
@label=InputLineState_Dirty
g$5BFD DEFB $00

; Input Saved Length
;
; Length saved by Caps Shift + 1.
@label=InputLineState_SavedLength
g$5BFE DEFB $00

