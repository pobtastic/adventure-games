; Scroll Adjust
;
; Used by the routines at #R$EA60 and #R$F0E6.
; .
; Jump-table target #R$EA8A: bumps the line byte of
; #SKOOLKID$5C88(S_POSN). Body left for a later PR.
@label=ScrollAdjust
c$F0D3 LD A,($5C89)  ; Fetch the line byte of #SKOOLKID$5C88(S_POSN).

; Bytes After Scroll Adjust
;
; Remainder of #R$F0D3; left for a later PR.
@label=RemainderAfterScrollAdjust
b$F0D6 DEFB $FE,$05,$D0,$3C,$32,$89,$5C,$06
 $F0DE DEFB $0F,$CD,$00,$0E,$10,$FB,$18,$ED

; Submit Input Line
;
; Used by the routine at #R$EB51.
; .
; #HTML(Reached from #R$EBD9 when Enter is pressed. Clears the input
; rows, adjusts the lower screen via #R$F0D3, prints a <code>></code>
; prompt, echoes #R$5BAE through #R$EA8D, then returns via #R$F0D3. Token
; walks and vocabulary lookup are separate jump-table entries (#R$EDAF,
; #R$ED7E and neighbours).)
@label=SubmitInputLine
c$F0E6 LD A,$20      ; {Clear both input rows to spaces with blank attributes.
 $F0E8 LD ($5BF9),A  ;
 $F0EB LD B,$40      ;
 $F0ED SUB A         ;
 $F0EE LD ($5BF6),A  ;
 $F0F1 LD ($5BF5),A  ;
 $F0F4 LD ($5BF7),A  ;
 $F0F7 LD A,$16      ;
 $F0F9 LD ($5BF8),A  ; }
@label=SubmitInputLine_ClearLoop
*$F0FC CALL $EA8D    ; {Print spaces until the clear count is done.
 $F0FF DJNZ $F0FC    ; }
 $F101 SUB A         ; {Reset the column and call #R$F0D3.
 $F102 LD ($5BF7),A  ;
 $F105 CALL $F0D3    ; }
 $F108 LD A,($5C89)  ; {Print a ">" prompt on the lower screen.
 $F10B LD B,A        ;
 $F10C LD A,$18      ;
 $F10E SUB B         ;
 $F10F LD ($5BF8),A  ;
 $F112 LD A,$07      ;
 $F114 LD ($5BF5),A  ;
 $F117 LD A,$3E      ;
 $F119 LD ($5BF9),A  ;
 $F11C CALL $EA8D    ; }
 $F11F LD A,$05      ; {Restore the echo attribute and point at #R$5BAE.
 $F121 LD ($5BF5),A  ;
 $F124 LD HL,$5BAE   ; }
@label=SubmitInputLine_Echo
*$F127 LD A,(HL)     ; {Jump to #R$F135 at end-of-line.
 $F128 CP $0D        ;
 $F12A JR Z,$F135    ; }
 $F12C INC HL        ; {Echo this character through #R$EA8D and continue.
 $F12D LD ($5BF9),A  ;
 $F130 CALL $EA8D    ;
 $F133 JR $F127      ; }
@label=SubmitInputLine_ScrollBack
*$F135 LD A,($5C89)  ; {Scroll the lower screen back two rows via #R$F0D3.
 $F138 SUB $02       ;
 $F13A LD ($5C89),A  ;
 $F13D JP $F0D3      ; }

; Copy Work Buffer
;
; Used by the routine at #R$EA60.
; .
; Jump-table target #R$EA84: copies #N($0096,$04,$04) bytes from
; near the start of #R$E9B6 into a work buffer.
@label=CopyWorkBuffer
c$F140 LD HL,$E9B7   ; {Copy #N($0096,$04,$04) bytes into the work buffer at
@keep
 $F143 LD DE,$FA01   ; #N$FA01.
 $F146 LD BC,$0096   ;
 $F149 LDIR          ; }
 $F14B RET           ; Return.

; Scan Input Spaces
;
; Used by the routine at #R$EA60.
; .
; Jump-table target #R$EA81: walk #R$5BAE until a quote or a
; character below space. On quote, seed #R$5BA7 / #R$5BA9, call #R$EDAF,
; then set #REGbc=#N($0000,$04,$04). The early return for a character below
; #N$20 leaves #REGbc unchanged.
@label=ScanInputSpaces
c$F14C LD DE,$5BAE   ; {Point #REGde at #R$5BAE.
 $F14F LD B,D        ; }
@label=ScanInputSpaces_Loop
*$F150 LD A,(DE)     ; {Fetch the next character and compare it with space.
 $F151 INC DE        ;
 $F152 CP $20        ; }
 $F154 RET C         ; Return if the next character is below space.
 $F155 CP $22        ; {Keep scanning until a quote.
 $F157 JR NZ,$F150   ; }
 $F159 LD ($5BA7),DE ; {Seed both token pointers, call #R$EDAF, and set
 $F15D LD ($5BA9),DE ; #REGbc=#N($0000,$04,$04).
 $F161 CALL $EDAF    ;
 $F164 LD BC,$0000   ; }
 $F167 RET           ; Return.

; Location Graphic Script: High Platform
