;
; SkoolKit ref file for Kentilla
;
; To build the HTML disassembly, run these commands:
;   tap2sna.py @kentilla.t2s
;   tap2sna.py @kentilla-bootstrap.t2s
;   tap2sna.py @kentilla-loader.t2s
;   sna2skool.py -H --ini ListRefs=2 -c sources/kentilla/kentilla.ctl Kentilla.z80 > sources/kentilla/kentilla.skool
;   sna2skool.py -H --ini ListRefs=2 -c sources/kentilla/loader.ctl Kentilla-loader.z80 > sources/kentilla/loader.skool
;   skool2html.py -H sources/kentilla/kentilla.skool -T dark -T wide -toOa
;
; To regenerate the skool from the ctl (byte-identical):
;   sna2skool.py -H --ini ListRefs=2 -c sources/kentilla/kentilla.ctl Kentilla.z80 > sources/kentilla/kentilla.skool
;   sna2skool.py -H --ini ListRefs=2 -c sources/kentilla/loader.ctl Kentilla-loader.z80 > sources/kentilla/loader.skool

[Config]
Expand=#INCLUDE(Expand)
RefFiles=../analytics.ref;../bases.ref;changelog.ref;facts.ref;pokes.ref
HtmlWriterClass=sources:linking.AdventureGamesHtmlWriter
GameDir=adventure-games/kentilla

[skool2ctl]
ListRefs=2

[Game]
Game=Kentilla
Logo=#SCR$02,$00,$00,$20,$18,$4000,$5800(/images/logo)
Copyright=&copy; 1984 Micromega<br />&copy; 2026 ArcadeGeek LTD.
Repository=https://github.com/pobtastic/adventure-games/tree/main/sources/kentilla/
Canonical=https://skoolkit.arcadegeek.co.uk/adventure-games/kentilla/
GameIndexUrl=https://skoolkit.arcadegeek.co.uk/adventure-games/kentilla/
OgImage=https://skoolkit.arcadegeek.co.uk/adventure-games/kentilla/images/logo.png
LinkInternalOperands=1
AddressAnchor={address#IF({base}==16)(:04x)}

[Titles]
loader-Index=Loading Code

[OtherCode:loader]

[PageHeaders]
GameIndex=The complete<>RAM disassembly (work in progress)

[Expand]
#DEF(#COLOUR(id)
  #LET(ink=$id&$07)#IF({ink}>=$00)(INK:
    #MAP({ink})(
      UNKNOWN,
      0:BLACK,
      1:BLUE,
      2:RED,
      3:MAGENTA,
      4:GREEN,
      5:CYAN,
      6:YELLOW,
      7:WHITE)),
  #LET(paper=$id>>$03&$07)#IF({paper}>=$00)(PAPER:
    #MAP({paper})(
      UNKNOWN,
      0:BLACK,
      1:BLUE,
      2:RED,
      3:MAGENTA,
      4:GREEN,
      5:CYAN,
      6:YELLOW,
      7:WHITE))
  #LET(bright=$id&$40)#IF({bright}>$00)((BRIGHT))
  #LET(flash=$id&$80)#IF({flash}>$00)(FLASH: ON))
