 $F186 DEFB $02,$87,$67,$FF         ; #SCRIPT($04)
 $F18A DEFB $02,$84,$67,$FF         ; #SCRIPT($04)
 $F18E DEFB $02,$80,$FB,$00         ; #SCRIPT($04)
