 $99F9 DEFB $00,$08,$FF

; Action: Print The Hurry And Catch Line
;
; Marks the action taken and prints the line that tells someone to hurry and catch
; them.
; Reached through the character state record at #R$99A9.
;
; .
;
; Mark action taken.
@label=ActionPrintHurryCatchLine
c$99FC CALL $9A74    ; Call #R$9A74 to mark the action taken.
 $99FF LD HL,$7079   ; {Jump ahead to #R$A59F to print this message.
 $9A02 JP $A59F      ; }

; Action: Set The State Mark And Say It Is Not Seen
;
; Sets the mark at the end of this character state, records that the action has
; been taken, and prints the line that begins "I do not see the".
; Reached through the character state record at #R$99E3.
@label=ActionSetStateMarkSayItIsNotSeen
c$9A05 LD HL,$99FA   ; {Set the character-state mark, then mark the action
 $9A08 SET 1,(HL)    ; taken.
 $9A0A CALL $9A74    ; }
 $9A0D LD HL,$70E3   ; {Jump ahead to #R$A59F to print this message.
 $9A10 JP $A59F      ; }

; Action: Print The Sale Remark
;
; Prints the sale remark when both character-state marks are set. Otherwise it
; clears the action marks and prints the other line.
;
; .
;
; Bit 1 of the state byte at #R$994D+#N$29 is clear?
@label=ActionPrintSaleRemark
c$9A13 LD A,($9976)   ; {Jump to #R$9A2F if bit 1 of the state byte at
 $9A16 AND $02        ; #R$994D+#N$29 is clear.
 $9A18 JR Z,$9A2F     ; }
; Bit 1 of the state byte at #R$994D+#N$37 is clear?
 $9A1A LD A,($9984)   ; {Jump to #R$9A2F if bit 1 of the state byte at
 $9A1D AND $02        ; #R$994D+#N$37 is clear.
 $9A1F JR Z,$9A2F     ; }
; Mark action taken.
 $9A21 CALL $9A74     ; Call #R$9A74 to mark the action taken.
 $9A24 LD HL,$99B2    ; {Set bit 1 of the character state at #R$99A9+#N$09 and
 $9A27 SET 1,(HL)     ; take the message at #R$6D9A+#N$02FF.
 $9A29 LD HL,$7099    ; }
 $9A2C JP $A59F       ; Jump ahead to #R$A59F to print this message.
; Clears bits 0 and 1 of the action flags and prints the token at #R$7265.
@label=ActionPrintSaleRemark_ResetActionBits
*$9A2F RES 1,(IX+$03) ; {Clear the action-taken flag and clear the
 $9A33 RES 0,(IX+$03) ; action-pending flag.}
 $9A37 LD HL,$7265    ; {Jump ahead to #R$A59F to print this message.
 $9A3A JP $A59F       ; }

; Action: Arm The Later Exit And Print Tomorrow
;
; Marks the action taken, changes the later check so that it returns at once, and
; prints the line about tomorrow.
; Reached through the character pairs table at #R$994D.
;
; .
;
; Mark action taken.
@label=ActionArmLaterExitPrintTomorrow
c$9A3D CALL $9A74    ; Call #R$9A74 to mark the action taken.
 $9A40 LD A,$01      ; {Change the later check so that it returns at once.
 $9A42 LD ($9E88),A  ;
 $9A45 LD HL,$70F0   ; }
 $9A48 JP $A59F      ; Jump ahead to #R$A59F to print this message.

; Action: Print The Conclusion
;
; Marks the action taken, sets the first character-state mark, and prints the
; conclusion.
; Reached through the character pairs table at #R$994D.
;
; .
;
; Mark action taken.
@label=ActionPrintConclusion
c$9A4B CALL $9A74    ; Call #R$9A74 to mark the action taken.
 $9A4E LD HL,$9976   ; {Mark bit 1 of this character-state byte and take the
 $9A51 SET 1,(HL)    ; police message.
 $9A53 LD HL,$6FAB   ; }
 $9A56 JP $A59F      ; Jump ahead to #R$A59F to print this message.

; Action: Move Mrs Jones
;
; Moves Mrs Jones out of the room and prints the remark about her distress.
; Reached through the character pairs table at #R$994D.
@label=ActionMoveMrsJones
c$9A59 CALL $9A74      ; {Look up Mrs Jones.
 $9A5C LD A,$5F        ;
 $9A5E CALL $D237      ; }
 $9A61 LD (IX+$01),$FF ; {Mark the object as moved and clear the character
 $9A65 LD (IX+$0F),$00 ; attribute.}
 $9A69 LD HL,$9984     ; {Mark bit 1 of this character-state byte and take the
 $9A6C SET 1,(HL)      ; police message.
 $9A6E LD HL,$6FCA     ; }
 $9A71 JP $A59F        ; Jump ahead to #R$A59F to print this message.

; Mark Action Taken
;
; Used by the routines at #R$99FC, #R$9A05, #R$9A13, #R$9A3D, #R$9A4B and
; #R$9A59.
; .
; Marks the current script action as already performed, so the character will not
; repeat it.
@label=MarkActionTaken
c$9A74 SET 1,(IX+$03) ; {Mark the action taken so the script will not repeat
 $9A78 RES 0,(IX+$03) ; it.}
 $9A7C RET            ; Return.

; Action Separator
;
; Terminator #N$FF, then the display record that runs the opening text.
; The terminator is read by #R$BD4B.
b$9A7D DEFB $FF      ; Terminator #N$FF.
 $9A7E DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Action: Print Opening Text
;
; Prints the token at #R$68E9+#N$2C or #R$68E9+#N$37 according to the current character.
; Run by #R$CA64 after the display record at #R$9A7E. A non-zero return means the script step succeeded.
@label=ActionPrintOpeningText
c$9A80 LD A,($A036)  ; {Compare the current character with #N$00 and take
 $9A83 CP $00        ; #N$01.
 $9A85 LD A,$01      ; }
 $9A87 LD HL,$6915   ; Take the message at #R$68E9+#N$2C.
 $9A8A JR Z,$9A90    ; Jump ahead to #R$9A90 if the current character is #N$00.
 $9A8C XOR A         ; {Clear #REGa and take the message at #R$68E9+#N$37.
 $9A8D LD HL,$6920   ; }
@label=ActionPrintOpeningText_Next
*$9A90 LD ($A027),A  ; {Store it in the print mode, then call #R$A59F to print
 $9A93 CALL $A59F    ; the message.}
 $9A96 OR %00000001  ; Reset the zero flag.
 $9A98 RET           ; Return.
; Attribute pair.
 $9A99 DEFB $04,$00  ; Display record read by #R$C9BF: flags #N$04, value
                     ; #N$00.
; Run by #R$CA64 after the display record at #R$9A99.
@label=ActionPrintOpeningText_MatchAttribute
 $9A9B CALL $9AA3    ; {Return zero through #R$DC15 if #R$9AA3 finds no display
 $9A9E JP Z,$DC15    ; parameter.}
 $9AA1 JR $9AD7      ; Jump ahead to #R$9AD7 to adjust attribute match.

; Read The Room Display Parameter
;
; Used by the routine at #R$9A80.
; .
; Accepts the picture when the character attribute is #N$67 and the room
; display parameter is #N$32, or when the character attribute is #N$32 and the
; room display parameter is #N$67 or #N$12.
@label=ReadRoomDisplayParameter
c$9AA3 LD A,($A00A)   ; {Jump ahead to #R$9AB5 if the current character
 $9AA6 CP $67         ; attribute is not #N$67.
 $9AA8 JR NZ,$9AB5    ; }
 $9AAA LD A,($A034)   ; {Jump to #R$9AC8 if the room display parameter is
 $9AAD CP $32         ; #N$32.
 $9AAF LD L,$70       ;
 $9AB1 JR Z,$9AC8     ; }
@label=ReadRoomDisplayParameter_Loop
*$9AB3 XOR A          ; Clear #REGa.
 $9AB4 RET            ; Return.
; The character attribute is #N$32. Accept the picture when the room display
; parameter is #N$67 or #N$12.
@label=ReadRoomDisplayParameter_TestRoomByte
*$9AB5 CP $32         ; {Jump to #R$9AB3 if the character attribute is not
 $9AB7 JR NZ,$9AB3    ; #N$32.}
 $9AB9 LD A,($A034)   ; {Jump to #R$9AC8 if the room display parameter is
 $9ABC CP $67         ; #N$67.
 $9ABE LD L,$72       ;
 $9AC0 JR Z,$9AC8     ; }
 $9AC2 CP $12         ; {Jump back to #R$9AB3 while the room display parameter
 $9AC4 JR NZ,$9AB3    ; is not #N$12.}
 $9AC6 LD L,$5E       ; The token is #N$5E.
@label=ReadRoomDisplayParameter_TestActionSucceeded
*$9AC8 OR %00000001   ; Reset the zero flag.
 $9ACA RET            ; Return.
; Script action: adjust attribute match.
 $9ACB DEFB $04,$00   ; Display record read by #R$C9BF: flags #N$04, value
                      ; #N$00.
; Run by #R$CA64 after the display record at #R$9ACB.
@label=ReadRoomDisplayParameter_AdjustMatch
 $9ACD CALL $9AA3     ; {Return zero through #R$DC15 if #R$9AA3 finds no
 $9AD0 JP Z,$DC15     ; display parameter.}
 $9AD3 LD A,L         ; {Take the low byte of the pointer, drop #N$14 from the attribute pair result
 $9AD4 SUB $14        ; and store that in the low byte.
 $9AD6 LD L,A         ; }
; This entry point is used by the routine at #R$9A80.
; .
; Leave #N$6D as the result, then record the result in the character just matched,
; then leave #N$69 as the result.
*$9AD7 LD A,$6D       ; #OBJECT($6D).
 $9AD9 LD ($E2C6),A   ; Store it in the character just matched.
 $9ADC LD A,$69       ; {Jump ahead to #R$9B04 to walk and place character.
 $9ADE JP $9B04       ; }
; Walks a character by six or two places and stores the result.
 $9AE1 DEFB $04,$00   ; Display record read by #R$C9BF: flags #N$04, value
                      ; #N$00.
; Place character beside match.
; .
; Run by #R$CA64 after the display record at #R$9AE1.
@label=ReadRoomDisplayParameter_PlaceCharacter
 $9AE3 CALL $9B50     ; Call #R$9B50 to place the character beside the match.
 $9AE6 LD DE,$0006    ; {Call #R$9B25 to measure character distance.
 $9AE9 CALL $9B25     ; }
 $9AEC LD A,(IX+$02)  ; {Subtract #N$02 from the location and jump to #R$9B02
 $9AEF SUB $02        ; to store the script cycle.
 $9AF1 LD L,A         ;
 $9AF2 JR $9B02       ; }
 $9AF4 DEFB $04,$00   ; Display record read by #R$C9BF: flags #N$04, value
                      ; #N$00.
; Place character beside match.
; .
; Run by #R$CA64 after the display record at #R$9AF4.
 $9AF6 CALL $9B50     ; Call #R$9B50 to place the character beside the match.
 $9AF9 LD DE,$0002    ; {Call #R$9B25 to measure character distance.
 $9AFC CALL $9B25     ; }
 $9AFF LD L,(IX+$02)  ; Read the location.
@label=ReadRoomDisplayParameter_Next
*$9B02 LD A,$01       ; Take #N$01.
; Clear the high byte of the pointer, then record the pointer in the script cycle
; counter, then read the character just matched.
*$9B04 PUSH AF        ; {Save #N$01 and store the location in the script cycle
 $9B05 LD H,$00       ; counter.
 $9B07 LD ($A01F),HL  ; }
 $9B0A LD A,($E2C6)   ; {Read the character just matched and call #R$9C60 to clear object attribute
 $9B0D CALL $9C60     ; bit 7.
 $9B10 POP BC         ; }
 $9B11 PUSH BC        ; {Read the character just matched and call #R$DD0E to compare current
 $9B12 LD A,($E2C6)   ; character.
 $9B15 CALL $DD0E     ;
 $9B18 POP AF         ; }
; Fetch location data pointer.
 $9B19 CALL $D224     ; Call #R$D224 to look this room up.
 $9B1C RES 6,(IX+$00) ; {Clear bit 6 of the room, point #REGhl at the command
 $9B20 LD HL,$F3AD    ; at #R$F3AD and set the carry.
 $9B23 SCF            ; }
 $9B24 RET            ; Return.

; Measure Character Distance
;
; Used by the routine at #R$9AA3.
; .
; Counts steps of five and records the room graphics parameter.
@label=MeasureCharacterDistance
c$9B25 LD A,(IX+$02) ; {Read the location.
 $9B28 PUSH IX       ;
 $9B2A LD HL,$0000   ; }
@label=MeasureCharacterDistance_Loop
*$9B2D ADD HL,DE     ; {Jump back to #R$9B2D while at least #N$05 is still
 $9B2E SUB $05       ; left.
 $9B30 JR NC,$9B2D   ; }
 $9B32 EX DE,HL      ; {Call #R$E619 to scan objects.
 $9B33 LD A,($A036)  ;
 $9B36 CALL $E619    ; }
 $9B39 JR Z,$9B44    ; Go to #R$9B44 if the object was not found.
 $9B3B CALL $E39C    ; Call #R$E39C to read the text pointer.
 $9B3E AND A         ; {Subtract #REGde from the text pointer, then call #R$E38F to store the shifted text
 $9B3F SBC HL,DE     ; pointer.
 $9B41 CALL $E38F    ; }
; Find character script entry.
@label=MeasureCharacterDistance_Next
*$9B44 CALL $CFB6    ; Call #R$CFB6 to find this character's script entry.
 $9B47 LD A,(IX+$03) ; {Record the room graphics parameter.
 $9B4A LD ($A035),A  ;
 $9B4D POP IX        ; }
 $9B4F RET           ; Return.

; Place Character Beside Match
;
; Used by the routine at #R$9AA3.
; .
; Copies the current character beside the matched object, or prints the token
; at #R$6929+#N$030B.
@label=PlaceCharacterBesideMatch
c$9B50 LD A,($A036)  ; {Read the current character, count down one and read the
 $9B53 DEC A         ; current character record.
 $9B54 LD IY,($A017) ; }
 $9B58 LD (IY+$01),A ; {Store this character in the record and at #R$E2C6, then call #R$D237 to look the
 $9B5B LD ($E2C6),A  ; object up.
 $9B5E CALL $D237    ; }
 $9B61 LD A,(IX+$0F) ; {Store the character attribute.
 $9B64 LD (IY+$0F),A ; }
 $9B67 LD ($A00A),A  ; Record the current character attribute.
 $9B6A LD A,($A034)  ; {Call #R$9C07 to search pair table.
 $9B6D LD C,A        ;
 $9B6E LD A,($A00A)  ;
 $9B71 CALL $9C07    ; }
 $9B74 RET Z         ; Return if #R$9C07 finds the pair.
 $9B75 POP HL        ; {Take the character busy message, then call #R$A59F to print the character busy
 $9B76 LD HL,$6C34   ; message.
 $9B79 CALL $A59F    ; }
 $9B7C OR %00000001  ; Reset the zero flag.
 $9B7E RET           ; Return.

; Table: Location Pairs
;
; Three-byte location pairs scanned by #R$9C07 and terminated by #N$FF.
b$9B7F DEFB $2D,$05,$03
 $9B82 DEFB $2D,$0A,$07
 $9B85 DEFB $2D,$0C,$14
 $9B88 DEFB $2D,$0E,$13
 $9B8B DEFB $2D,$12,$12
 $9B8E DEFB $2D,$18,$07
 $9B91 DEFB $2D,$1C,$0C
 $9B94 DEFB $2D,$20,$06
 $9B97 DEFB $2D,$28,$0D
 $9B9A DEFB $05,$0A,$14
 $9B9D DEFB $05,$0C,$19
 $9BA0 DEFB $05,$0E,$1A
 $9BA3 DEFB $05,$12,$0C
 $9BA6 DEFB $05,$18,$06
 $9BA9 DEFB $05,$1C,$0F
 $9BAC DEFB $05,$20,$18
 $9BAF DEFB $05,$28,$09
 $9BB2 DEFB $0A,$0C,$12
 $9BB5 DEFB $0A,$0E,$12
 $9BB8 DEFB $0A,$12,$0C
 $9BBB DEFB $0A,$18,$13
 $9BBE DEFB $0A,$1C,$02
 $9BC1 DEFB $0A,$20,$04
 $9BC4 DEFB $0A,$28,$0F
 $9BC7 DEFB $0C,$0E,$03
 $9BCA DEFB $0C,$12,$14
 $9BCD DEFB $0C,$18,$1E
 $9BD0 DEFB $0C,$1C,$14
 $9BD3 DEFB $0C,$20,$11
 $9BD6 DEFB $0C,$28,$19
 $9BD9 DEFB $0E,$12,$0D
 $9BDC DEFB $0E,$18,$1C
 $9BDF DEFB $0E,$1C,$11
 $9BE2 DEFB $0E,$20,$09
 $9BE5 DEFB $0E,$28,$0B
 $9BE8 DEFB $12,$18,$0B
 $9BEB DEFB $12,$1C,$10
 $9BEE DEFB $12,$20,$12
 $9BF1 DEFB $12,$28,$03
 $9BF4 DEFB $18,$1C,$0F
 $9BF7 DEFB $18,$20,$18
 $9BFA DEFB $18,$28,$0D
 $9BFD DEFB $1C,$20,$0C
 $9C00 DEFB $1C,$28,$13
 $9C03 DEFB $20,$28,$16
 $9C06 DEFB $FF         ; Terminator.

; Search Pair Table
;
; Used by the routines at #R$9B50 and #R$E28D.
; .
; Walks the character-id list at #R$9B7F and stops when the id matches either column, or when the
; list ends.
@label=SearchPairTable
c$9C07 LD IX,$9B7F   ; {Use the location pairs (#R$9B7F).
 $9C0B PUSH BC       ;
 $9C0C LD B,A        ; }
@label=SearchPairTable_Loop
*$9C0D LD A,(IX+$00) ; {Jump to #R$9C3D if this pair's first byte is the end
 $9C10 CP $FF        ; marker #N$FF.
 $9C12 JR Z,$9C3D    ; }
 $9C14 LD A,B        ; {Jump ahead to #R$9C2A if this id matches the first room
 $9C15 CP (IX+$00)   ; in this pair.
 $9C18 JR Z,$9C2A    ; }
 $9C1A CP (IX+$01)   ; {Jump ahead to #R$9C33 if this id does not match the second room in this
 $9C1D JR NZ,$9C33   ; pair.}
 $9C1F LD A,C        ; {Jump ahead to #R$9C3B if #REGc is zero.
 $9C20 AND A         ;
 $9C21 JR Z,$9C3B    ; }
 $9C23 CP (IX+$00)   ; {Jump ahead to #R$9C33 if #REGc does not match the first
 $9C26 JR NZ,$9C33   ; room in this pair.}
 $9C28 JR $9C3B      ; Both rooms in this pair match, so accept the pair at
                     ; #R$9C3B.
; A zero in #REGc, or a match in the second column, accepts the pair.
@label=SearchPairTable_Next
*$9C2A LD A,C        ; {Jump ahead to #R$9C3B if #REGc is zero.
 $9C2B AND A         ;
 $9C2C JR Z,$9C3B    ; }
 $9C2E CP (IX+$01)   ; {Jump ahead to #R$9C3B if #REGc matches the second room
 $9C31 JR Z,$9C3B    ; in this pair.}
@label=SearchPairTable_TestAdvanceCharacterPair
*$9C33 INC IX        ; {Advance to the next character pair and keep looking.
 $9C35 INC IX        ;
 $9C37 INC IX        ;
 $9C39 JR $9C0D      ; }
; The pair matched, so return the id the caller passed in.
@label=SearchPairTable_PairMatchedCaller
*$9C3B POP BC        ; Restore the id the caller passed in from the stack.
 $9C3C RET           ; Return.
@label=SearchPairTable_TestStepSucceedsScript
*$9C3D OR $01        ; Reset the zero flag.
 $9C3F POP BC        ; Restore #REGbc from the stack.
 $9C40 RET           ; Return.

; Display Record
;
; Display record read by #R$C9BF: flags #N$04, value #N$00.
b$9C41 DEFB $04,$00

; Mark Object And Jump
;
; Notes the object in this room, sets its held mark, and continues with the character being
; processed.
;
; .
;
; Run by #R$CA64 after the display record at #R$9C41, from the refresh-room
; command at #R$F3AD.
@label=MarkObjectAndJump
c$9C43 LD IX,($A017) ; {Read the current character record.
 $9C47 LD A,(IX+$01) ;
 $9C4A PUSH AF       ; }
; Set object attribute bit 7.
 $9C4B CALL $9C56    ; Call #R$9C56 to set the object's held mark.
 $9C4E LD A,($A034)  ; {Read the room display parameter, then join the next
 $9C51 LD B,A        ; step.
 $9C52 POP AF        ;
 $9C53 JP $DD0E      ; }

; Set The Object Held Mark
;
; Used by the routines at #R$9C43, #R$E0ED and #R$E0FF.
; .
; Looks the object up and sets the held mark on its attribute, then tells the script this step
; worked.
@label=SetObjectHeldMark
c$9C56 CALL $D237     ; Call #R$D237 to look that object up.
 $9C59 SET 7,(IX+$05) ; Mark the object-attribute flag.
 $9C5D OR %00000001   ; Reset the zero flag.
 $9C5F RET            ; Return.

; Clear The Object Held Mark
;
; Used by the routine at #R$9AA3.
; .
; Looks the object up and clears the held mark on its attribute, then tells the script this step
; worked.
@label=ClearObjectHeldMark
c$9C60 CALL $D237     ; Call #R$D237 to look that object up.
 $9C63 RES 7,(IX+$05) ; Clear the object-attribute flag.
 $9C67 OR %00000001   ; Reset the zero flag.
 $9C69 RET            ; Return.

; Handler: Find Character Action
;
; Used by the routine at #R$9C77.
; .
; Looks through the character-action table and reports whether this character has
; an action.
;
; O:IX Action entry
; O:A #N$FF is no action was found
; O:F Zero flag is set if no action was found
@label=Handler_FindCharacterAction
c$9C6A LD A,($A036)  ; {Call #R$D34E to search three-byte length table.
 $9C6D LD IX,$9C85   ;
 $9C71 CALL $D34E    ; }
 $9C74 CP $FF        ; Check if a character action was found.
 $9C76 RET           ; Return.

; Execute Character Action
;
; Used by the routine at #R$A064.
; .
; Runs the action looked up for this character and then returns at once when that character
; has no action.
;
; IY Character timetable pointer
@label=ExecuteCharacterAction
c$9C77 CALL $9C6A    ; {Return if #R$9C6A finds no character action.
 $9C7A RET Z         ; }
 $9C7B LD L,(IX+$01) ; {Read the action handler for this character.
 $9C7E LD H,(IX+$02) ; }
 $9C81 LD A,L        ; {See whether the pointer is empty.
 $9C82 OR H          ; }
 $9C83 RET Z         ; Return if the action handler address is empty.
 $9C84 JP (HL)       ; Jump to the action handler.

; Table: Character Actions
;
; Character Actions read by #R$9C6A.
;
; .
;
; #OBJECT(#PEEK(#PC)):
@label=Table_CharacterActions
g$9C85 DEFB $02      ; Character: "#OBJECT(#PEEK(#PC))".
 $9C86 DEFW $9DFF    ; Action routine: #R(#PEEK(#PC+$01)*$0100+#PEEK(#PC)),
                     ; read by #R$9DFF.
; #OBJECT(#PEEK(#PC)):
 $9C88 DEFB $03      ; Character: "#OBJECT(#PEEK(#PC))".
 $9C89 DEFW $9D13    ; Action routine: #R(#PEEK(#PC+$01)*$0100+#PEEK(#PC)),
                     ; read by #R$9DFF.
; #OBJECT(#PEEK(#PC)):
 $9C8B DEFB $04      ; Character: "#OBJECT(#PEEK(#PC))".
 $9C8C DEFW $9D30    ; Action routine: #R(#PEEK(#PC+$01)*$0100+#PEEK(#PC)),
                     ; read by #R$9DFF.
; #OBJECT(#PEEK(#PC)):
 $9C8E DEFB $0B      ; Character: "#OBJECT(#PEEK(#PC))".
 $9C8F DEFW $9D48    ; Action routine: #R(#PEEK(#PC+$01)*$0100+#PEEK(#PC)),
                     ; read by #R$9DFF.
; #OBJECT(#PEEK(#PC)):
 $9C91 DEFB $0C      ; Character: "#OBJECT(#PEEK(#PC))".
 $9C92 DEFW $9D73    ; Action routine: #R(#PEEK(#PC+$01)*$0100+#PEEK(#PC)),
                     ; read by #R$9DFF.
; #OBJECT(#PEEK(#PC)):
 $9C94 DEFB $08      ; Character: "#OBJECT(#PEEK(#PC))".
 $9C95 DEFW $9ED1    ; Action routine: #R(#PEEK(#PC+$01)*$0100+#PEEK(#PC)),
                     ; read by #R$9DFF.
; #OBJECT(#PEEK(#PC)):
 $9C97 DEFB $09      ; Character: "#OBJECT(#PEEK(#PC))".
 $9C98 DEFW $9ECB    ; Action routine: #R(#PEEK(#PC+$01)*$0100+#PEEK(#PC)),
                     ; read by #R$9DFF.
; #OBJECT(#PEEK(#PC)):
 $9C9A DEFB $05      ; Character: "#OBJECT(#PEEK(#PC))".
 $9C9B DEFW $9EC1    ; Action routine: #R(#PEEK(#PC+$01)*$0100+#PEEK(#PC)),
                     ; read by #R$9DFF.
; #OBJECT(#PEEK(#PC)):
 $9C9D DEFB $06      ; Character: "#OBJECT(#PEEK(#PC))".
 $9C9E DEFW $9CA2    ; Action routine: #R(#PEEK(#PC+$01)*$0100+#PEEK(#PC)),
                     ; read by #R$9DFF.
; End of table data:
 $9CA0 DEFB $FF      ; Terminator.

; Character State: Basil Phipps
;
; Character State: Basil Phipps read by #R$9CA2 and #R$DF5B.
@label=CharacterState_BasilPhipps
g$9CA1 DEFB $0F

; Character Action: Basil Phipps
;
; Scheduled behaviour for Basil Phipps.
; Reached through the character-action table at #R$9C85, dispatched by #R$9C84.
@label=CharacterAction_BasilPhipps
c$9CA2 LD A,$55       ; {Call #R$D237 to look up the #OBJECT($55).
 $9CA4 CALL $D237     ; }
 $9CA7 BIT 7,(IX+$05) ; {Return if the object-attribute flag is clear.
 $9CAB RET Z          ; }
 $9CAC LD HL,$9CA1    ; {Return if Basil Phipps's state is already #N$FF.
 $9CAF LD A,(HL)      ;
 $9CB0 CP $FF         ;
 $9CB2 RET Z          ; }
 $9CB3 DEC (HL)       ; Count down the entry.
 $9CB4 RET NZ         ; Return while this character's countdown still has time
                      ; left.
 $9CB5 LD HL,$015B    ; {Store the low byte of the text pointer.
 $9CB8 LD (IX+$09),L  ; }
 $9CBB LD (IX+$0A),H  ; Store the high byte of the text pointer.
 $9CBE XOR A          ; {Write #N$00 to #LIST { *#REGix+#N$0D } { *#REGix+#N$0E
 $9CBF LD (IX+$0D),A  ; } LIST#.
 $9CC2 LD (IX+$0E),A  ; }
 $9CC5 LD IX,$99B7    ; {Clear the action-taken flag.
 $9CC9 RES 1,(IX+$03) ; }
 $9CCD RET            ; Return.

; Check Object In Character Location
;
; Used by the routines at #R$9CF2 and #R$9DFF.
; .
; Sets the zero flag when the object in #REGc is in the current character's
; location. A non-zero return means it is not.
;
;   C Object ID to check
; O:F Zero flag set if object is in character's location
@label=CheckObjectInCharacterLocation
c$9CCE LD IX,($A017) ; {Read the current character record.
 $9CD2 LD B,(IX+$0F) ; }
 $9CD5 LD A,C        ; {Call #R$D237 to look up that object.
 $9CD6 CALL $D237    ; }
 $9CD9 LD A,(IX+$0F) ; Read offset #N$0F of the object.
 $9CDC CP B          ; See whether the two values match.
 $9CDD RET NZ        ; Return if they differ.
 $9CDE LD A,C        ; {Go to #R$9CE6 if the object is not in this location.
 $9CDF CALL $C821    ;
 $9CE2 JR Z,$9CE6    ; }
 $9CE4 XOR A         ; Clear #REGa.
 $9CE5 RET           ; Return.
@label=CheckObjectInCharacterLocation_Next
*$9CE6 OR %00000001  ; Reset the zero flag.
 $9CE8 RET           ; Return.

; Process Character Action With Text
;
; Used by the routines at #R$9D13, #R$9D30 and #R$9D95.
; .
; Runs this character's action and prints the message that follows.
;
; HL Pointer to text token
; C Room display parameter
;
; Process character action parameter.
@label=ProcessCharacterActionWithText
c$9CE9 CALL $9CF2    ; Call #R$9CF2 to run this character's action.
; This entry point is used by the routine at #R$9DC6.
; .
; Take the character-busy line, then print the message.
*$9CEC LD HL,$6929   ; {Jump ahead to #R$A59F to print this message.
 $9CEF JP $A59F      ; }

; Process Character Action Parameter
;
; Used by the routines at #R$9CE9, #R$9D65, #R$9DC6 and #R$9DD8.
; .
; Stores the room picture, and counts down while the object is not in the character's
; room. When the character holds it, stores a fresh delay once the counter has run out.
;
; HL Pointer to counter/state variable
; C Room display parameter
; DE (preserved on stack)
@label=ProcessCharacterActionParameter
c$9CF2 LD A,C        ; {Call #R$9CCE to check object in character location.
 $9CF3 LD ($A034),A  ;
 $9CF6 CALL $9CCE    ; }
 $9CF9 JR Z,$9D02    ; Jump ahead to #R$9D02 when this character holds the
                     ; object.
 $9CFB DEC (HL)      ; {Jump to #R$9D00 if the count does not become negative.
 $9CFC JP P,$9D00    ; }
 $9CFF INC (HL)      ; Count one more in the pointer.
*$9D00 POP DE        ; Restore #REGde from the stack.
 $9D01 RET           ; Return.
; When the counter has run out, stores this character's attribute plus thirty.
@label=ProcessCharacterActionParameter_Next
*$9D02 LD A,(HL)     ; {Jump back to #R$9D00 while this byte is not zero.
 $9D03 AND A         ;
 $9D04 JR NZ,$9D00   ; }
 $9D06 LD A,$0F      ; {#OBJECT($0F), then call #R$D2A4 to take a random
 $9D08 CALL $D2A4    ; number.}
 $9D0B ADD A,$1E     ; Advance the result by #N$1E.
 $9D0D LD (HL),A     ; Store the result at the pointer.
 $9D0E XOR A         ; Clear #REGa.
 $9D0F RET           ; Return.

