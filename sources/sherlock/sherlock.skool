; Read The Character Being Processed
;
; Used by the routine at #R$9ECB.
; .
; Starts the gardener's walk with an empty step count.
@label=ReadCharacterBeingProcessed
c$9ED4 LD BC,$0000   ; Move through the record for gardener.

; Read The Character Being Processed
;
; Used by the routine at #R$9EC1.
; .
; Reads the gardener's state and moves him on when he has already left.
@label=AdvanceGardenerAfterMove
c$9ED7 LD A,(HL)      ; {Jump ahead to #R$9EF2 if this byte is zero.
 $9ED8 AND A          ;
 $9ED9 JR Z,$9EF2     ; }
; Handle gardener's morning state (has already moved).
 $9EDB LD B,A         ; {Save the state in #REGb and clear #REGa and #REGde for
 $9EDC XOR A          ; the update.
 $9EDD LD DE,$0000    ; }
 $9EE0 CALL $9F1E     ; Call #R$9F1E to update the gardener's state and
                      ; location.
 $9EE3 LD A,($A036)   ; {Read the current character.
 $9EE6 LD B,C         ;
 $9EE7 LD DE,$0000    ; }
 $9EEA CALL $F1C1     ; Call #R$F1C1 to move the object to the character's
                      ; location.
 $9EED SET 6,(IX+$05) ; Set the special-description flag.
 $9EF1 RET            ; Return.
; Read the morning or afternoon marker, then check for the letter a, and return
; if they match.
@label=AdvanceGardenerAfterMove_CheckTime
*$9EF2 LD A,($9FE2)   ; {Return if the AM/PM marker is #N$61.
 $9EF5 CP $61         ;
 $9EF7 RET Z          ; }
; Handle gardener's afternoon state (at 9am).
 $9EF8 LD A,($9FE0)   ; {Return if the hour is not #N$09.
 $9EFB CP $09         ;
 $9EFD RET NZ         ; }
 $9EFE LD DE,$01F8    ; {Take #N$01F8 for the character and take the
 $9F01 LD A,$1E       ; #OBJECT($1E).}
 $9F03 CALL $D2A4     ; Call #R$D2A4 to take a random number.
 $9F06 ADD A,E        ; {Read the current character attribute.
 $9F07 LD E,A         ;
 $9F08 LD A,($A00A)   ; }
 $9F0B CALL $9F1E     ; Call #R$9F1E to update the gardener's state and
                      ; location.
 $9F0E LD A,($A036)   ; {Read the current character.
 $9F11 LD B,$10       ;
 $9F13 LD DE,$07F0    ; }
 $9F16 CALL $F1C1     ; Call #R$F1C1 to move the object to the new location.
 $9F19 RES 6,(IX+$05) ; Clear the special-description flag.
 $9F1D RET            ; Return.

; Update Character State And Location
;
; Used by the routine at #R$9ED7.
; .
; Stores the character's new state, marks the object moved, and writes the location offset
; back into the timetable.
;
; A New state value
; B Character attribute value
; DE Location offset
; HL Pointer to character state
; IY Pointer to character timetable data
@label=UpdateCharacterStateAndLocation
c$9F1E LD (HL),A       ; {Store the new state, point #REGix at the current character at #R$A017, and write
 $9F1F LD IX,($A017)   ; #REGb at offset #N$0F.
 $9F23 LD (IX+$0F),B   ; }
 $9F26 LD (IX+$01),$FF ; Mark the object as moved.
; Update character's location in timetable.
 $9F2A LD L,(IY+$06)   ; {Add the offset in the source to the word at offset
 $9F2D LD H,(IY+$07)   ; #N$06 of this record.
 $9F30 ADD HL,DE       ; }
 $9F31 LD (IY+$06),L   ; Store the low byte of the schedule time.
 $9F34 LD (IY+$07),H   ; Store the high byte of the schedule time.
 $9F37 RET             ; Return.

; Table: Display Records
;
; One id byte and a pointer to a display record, ended by #N$FF.
; A record is two bytes, plus two when bit 6 is set and five when bit 4 is set.
