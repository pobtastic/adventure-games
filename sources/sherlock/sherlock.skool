 $9EB5 BIT 1,(IX+$03) ; {Jump to #R$9E74 if the action-taken flag is clear.
 $9EB9 JR Z,$9E74     ; }
 $9EBB LD HL,$6ABD    ; {Jump back to #R$9E74 with the message at
 $9EBE JR $9E74       ; #R$6929+#N$0194.}

