 $F339 DEFB $83,$54,$E6,$A2,$F3         ; #SCRIPT($05)
 $F33E DEFB $83,$6F,$E6,$66,$F3         ; #SCRIPT($05)
 $F343 DEFB $82,$82,$FD,$FF,$FC,$F2     ; #SCRIPT($06)
