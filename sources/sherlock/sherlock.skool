; Set Bit Six Of The Current Object
;
; Sets bit 6 of the current object's flags.
;
; .
;
; Run by #R$CA64 after the display record at #R$ED39, from the show-message
; command at #R$ECBB.
@label=SetCurrentObjectBitSix
c$ED3B LD DE,$050B                      ; Take #N$050B as the source address.
 $ED3E LD HL,$6D6A                      ; Take #R$6929+#N$0441 as the message.
 $ED41 LD B,$10                         ; Take a count of #N$10.
 $ED43 CALL $F1B2                       ; Call #R$F1B2 to update object #N$0B.
 $ED46 SET 6,(IX+$05)                   ; Set bit 6 of the current object's
                                        ; flags.
 $ED4A RET                              ; Return.
