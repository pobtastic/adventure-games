 $F359 DEFB $03,$88,$E5                 ; #SCRIPT($03)
 $F35C DEFB $03,$0E,$E7                 ; #SCRIPT($03)
 $F35F DEFB $93,$E6,$E6,$FC,$F2,$76,$F3 ; #SCRIPT($07)
