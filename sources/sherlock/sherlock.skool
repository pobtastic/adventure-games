@label=TestBusyFlag
c$9E87 LD A,$00      ; {Return if the busy flag (the operand of #R$9E87, set by
 $9E89 AND A         ; #R$9A42) is non-zero.
 $9E8A RET NZ        ; }
 $9E8B LD HL,$6975   ; {Take the character busy message, then call #R$A59F to print the character busy
 $9E8E CALL $A59F    ; message.}
 $9E91 LD A,($A009)  ; {Use the current character attribute at #R$A00A.
 $9E94 LD HL,$A00A   ;
 $9E97 CP (HL)       ; }
 $9E98 LD HL,$69BF   ; Take the character busy message.
 $9E9B JR Z,$9E74    ; Go to #R$9E74 if Sherlock's disguise matches the
                     ; character attribute.
 $9E9D LD HL,$6A26   ; {Jump back to #R$9E74 with the message at #R$6929+#N$FD.
 $9EA0 JR $9E74      ; }

; Display Record
;
; Display record read by #R$C9BF. The show-message command at #R$EAB3 passes this word to
; #R$C591.
;
; .
;
; Named from the script command at #R$EAB3.
b$9EA2 DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Test The Action-Taken Flag
;
; Prints the character-busy message unless the action-taken flag is set.
;
; .
;
; Run by #R$CA64 after the display record at #R$9EA2, from the show-message
; command at #R$EAB3.
@label=TestActionTakenFlag
c$9EA4 LD HL,$6A33    ; {Take the character busy message.
 $9EA7 LD IX,$9973    ; }
