; Object Attribute Flag
;
; Stores bit 0 of the object attribute value (from #R$A01D).
; Read by #R$B4C1, #R$B568, #R$BDC2, #R$D36A and #R$D39B.
@label=ObjectAttributeFlag
g$A038 DEFB $00
 $A039 DEFB $00,$00,$00,$00,$04,$40,$58

; Game Entry Point
;
; Used by the routines at #R$5B1B and #R$A0EB.
; .
; Starts a game: clears the parser, asks whether pictures are wanted, then runs each
; character from the timetable.
@label=GameEntryPoint
c$A040 XOR A         ; {Clear the parser workspace and the initialised flag.
 $A041 LD ($D6B8),A  ;
 $A044 LD ($A01B),A  ;
 $A047 DI            ; }
; Draw decorative line.
 $A048 CALL $C14A    ; Call #R$C14A to draw the decorative line.
 $A04B LD SP,$5D80   ; Point the stack at #R$5D80.
 $A04E CALL $C415    ; Call #R$C415 to wait for keypress.
 $A051 CP $6E        ; {Jump to #R$A05B if the player pressed "n".
 $A053 JR Z,$A05B    ; }
 $A055 CP $4E        ; See whether the key is N.
; The player didn't press N, so pictures stay enabled.
 $A057 LD A,$01      ; {Go to #R$A05C with #N$01 (pictures on) unless the key
 $A059 JR NZ,$A05C   ; was N.}
; The player pressed either "N" or "n".
@label=GameEntryPoint_ClearFlags
*$A05B XOR A         ; Clear the pictures-enabled flag. The player pressed n.
@label=GameEntryPoint_Next
*$A05C LD ($A011),A  ; Record the pictures-enabled flag.
 $A05F LD A,R        ; {Write the contents of the Memory Refresh Register to
 $A061 LD ($A037),A  ; *#R$A037.}

; Run The Game Loop
;
; Used by the routine at #R$A0F1.
; .
; Clears the startup flag, updates the date bar, and walks each character until play
; begins.
@label=Game_Initialisation
c$A064 XOR A         ; {Clear the startup flag.
 $A065 LD ($A0DA),A  ; }
@label=Game_Loop
*$A068 LD A,($A0DA)  ; {Jump to #R$A0E7 if the startup flag is set.
 $A06B AND A         ;
 $A06C JR NZ,$A0E7   ; }
 $A06E CALL $BFD9    ; {Call #R$BFD9 to show the game clock, then call #R$BF79
 $A071 CALL $BF79    ; to show the date bar.}
; Handler for Sherlock (as he's the first character).
 $A074 LD IY,$9860   ; Use the timetable at #R$9860.
 $A078 LD A,(IY+$03) ; Fetch Sherlocks location.
 $A07B CP $32        ; {Jump ahead to #R$A093 if the schedule entry is not
 $A07D JR NZ,$A093   ; #N$32.}
 $A07F CALL $C41F    ; {Call #R$C41F to read the keyboard, and go to #R$A093 if
 $A082 BIT 7,A       ; no key was pressed.
 $A084 JR Z,$A093    ; }
 $A086 CP $8D        ; {Jump to #R$A093 if the player did not press "ENTER".
 $A088 JR NZ,$A093   ; }
 $A08A LD HL,($9FDD) ; {Write *#R$9FDD to *#REGiy+#N$06/ *#REGiy+#N$07.
 $A08D LD (IY+$06),L ;
 $A090 LD (IY+$07),H ; }
; Cycle through the character timetable and run through each characters
; script according to their schedule and current game time.
@label=Handler_ProcessCharacters
*$A093 LD IY,$9860   ; Use the timetable at #R$9860.
@label=CharacterProcessing_Loop
*$A097 LD A,(IY+$00) ; {Jump to #R$A068 if the character id is #N$FF.
 $A09A INC A         ;
 $A09B JR Z,$A068    ; }
; This is a valid character so begin processing them.
 $A09D LD HL,($9FDD) ; {Call #R$A0DB to check character schedule.
 $A0A0 CALL $A0DB    ; }
 $A0A3 JR C,$A0D1    ; Go to #R$A0D1 if the current time is below this
                     ; character's schedule time.
; The currently processed character has an active schedule so process it.
 $A0A5 LD A,(IY+$00) ; Fetch the character ID and store it in #REGa.
 $A0A8 PUSH IY       ; {Call #R$CC37 to run this character's action.
 $A0AA PUSH AF       ;
 $A0AB CALL $CC37    ; }
; Repeatedly execute the characters script until it completes or
; encounters a wait condition.
@label=CharacterScript_Loop
*$A0AE POP AF        ; {Restore the character ID from the stack, keeping a copy
 $A0AF PUSH AF       ; there.}
; Script interpreter.
 $A0B0 CALL $CC78    ; Call #R$CC78 to run this character's script.
; Keep looping until the script for this character is finished.
 $A0B3 LD HL,($A01F) ; {Jump back to #R$A0AE if #R$A01F is zero.
 $A0B6 LD A,L        ;
 $A0B7 OR H          ;
 $A0B8 JR Z,$A0AE    ; }
 $A0BA POP AF        ; {Restore the saved character ID and the schedule entry
 $A0BB POP IY        ; from the stack.}
; Set up the next schedule time for this character.
 $A0BD LD E,(IY+$06) ; {Add the characters schedule time to the current time.
 $A0C0 LD D,(IY+$07) ;
 $A0C3 ADD HL,DE     ; }
 $A0C4 LD (IY+$06),L ; {And write it back to the characters schedule.
 $A0C7 LD (IY+$07),H ; }
 $A0CA PUSH IY       ; {Call #R$9C77 to execute character action.
 $A0CC CALL $9C77    ;
 $A0CF POP IY        ; }
; Move to the next character in the timetable.
@label=Character_Next
*$A0D1 LD DE,$0008   ; {Jump back to #R$A097, the character processing loop.
 $A0D4 ADD IY,DE     ;
 $A0D6 JR $A097      ; }

; Word: Location Graphics
;
; Pointer to #R$F60C. #R$A0DA is cleared at the start of the game.
; Read by #R$A25D.
b$A0D8 DEFW $F60C
 $A0DA DEFB $00      ; Read by #R$A064, #R$B0AC and #R$B0C6.

; Check Character Schedule
;
; Used by the routine at #R$A064.
; .
; Compares #REGhl with the schedule time at #REGiy+#N$06-#N$07.
;
;   HL Current game time
; O:F Carry flag is set if the character should be skipped
@label=CheckCharacterSchedule
c$A0DB LD E,(IY+$06) ; {Read this character's place in the schedule.
 $A0DE LD D,(IY+$07) ; }
 $A0E1 LD A,H        ; Read the high byte of the pointer.
 $A0E2 CP D          ; See whether the two values match.
 $A0E3 RET NZ        ; Return if they differ.
 $A0E4 LD A,L        ; Read the low byte of the pointer.
 $A0E5 CP E          ; See whether the two values match.
 $A0E6 RET           ; Return.

; Load Or Save The Game
;
; Used by the routine at #R$A064.
; .
; Loads the game unless the parameter is #N$02, which saves it instead.
;
; A #N$02 saves the game. Any other value loads it
@label=LoadOrSaveGame
c$A0E7 CP $02        ; {Go to #R$A0F1 if it is #N$02.
 $A0E9 JR Z,$A0F1    ; }

; Load The Game
;
; Used by the routine at #R$C1D8.
; .
; Loads the saved game and starts it from #R$A040.
c$A0EB CALL $B0D7    ; {Jump back to #R$A040 to start the game.
 $A0EE JP $A040      ; }

; Save The Game
;
; Used by the routine at #R$A0E7.
; .
; Saves the game and continues at #R$A064.
@label=LoadOrSaveGame_Save
c$A0F1 CALL $B0E4    ; {Jump back to #R$A064, the game initialisation.
 $A0F4 JP $A064      ; }

; Fetch Object Pointer From Stack
;
; Used by the routines at #R$B86A, #R$B91F, #R$BA3E, #R$BD06, #R$CC82, #R$CFB9,
; #R$E560 and #R$E691.
; .
; Takes the record linked just before this one, or reports that the link is
; empty.
;
;   IX Object pointer (on stack)
; O:IX Object pointer
; O:HL Zero if object pointer was zero, otherwise preserved
;
; This will be restored back into #REGhl by the end of the routine.
@label=FetchObjectPointerFromStack
c$A0F7 PUSH HL       ; {Read the pointer saved ahead of this record.
 $A0F8 LD L,(IX-$02) ;
 $A0FB LD H,(IX-$01) ; }
 $A0FE LD A,L        ; {Is #REGhl zero?.
 $A0FF OR H          ; }
; Pretty clever way of using the stack here.
 $A100 EX (SP),HL    ; Swap the *#REGsp with the object pointer, restoring #REGhl to the original
                     ; value.
 $A101 POP IX        ; Restore the saved character record from the stack.
 $A103 RET           ; Return.

; Increment Pointer And Compare
;
; Used by the routines at #R$AEC6, #R$B049, #R$B9FA, #R$BA3E, #R$CC82, #R$CFCF
; and #R$E58C.
; .
; Step pointer and compare.
@label=IncrementPointerAndCompare
c$A104 INC IY        ; {Step on two places.
 $A106 INC IY        ; }
@label=IncrementPointerAndCompare_Loop
*$A108 LD L,(IY-$02) ; {Read the previous pointer, clear the carry and save
 $A10B LD H,(IY-$01) ; #REGhl on the stack.
 $A10E AND A         ;
 $A10F PUSH HL       ; }
 $A110 SBC HL,DE     ; {Jump ahead to #R$A118 if the two pointers meet.
 $A112 JR Z,$A118    ;
 $A114 POP IY        ; }
 $A116 JR $A108      ; Jump back to #R$A108 to read the next schedule entry.
; Return.
@label=IncrementPointerAndCompare_Next
*$A118 POP HL        ; Restore the matching pointer from the stack.
 $A119 RET           ; Return.

; Workspace
;
; Workspace between the pointer routines.
; Read by #R$A11C.
g$A11A DEFW $0000

; Allocate Memory
;
; Used by the routines at #R$AE6A, #R$B049, #R$B77F, #R$B8AA, #R$BA3E, #R$CC82,
; #R$CDBF, #R$CF80 and #R$E510.
; .
; Grows the workspace at #R$9FE3 by the size asked for, plus a three-byte header, and returns the
; new block.
@label=AllocateMemory
c$A11C PUSH IY       ; {Add #N$03 to the total.
 $A11E PUSH HL       ;
 $A11F PUSH DE       ;
 $A120 PUSH BC       ;
 $A121 ADD A,$03     ;
 $A123 LD C,A        ; }
 $A124 LD B,$00      ; {Start the free-space search and read the list at
 $A126 LD HL,($9FE3) ; #R$9FE3.}
 $A129 LD IY,$9FE3   ; Point #REGiy at the free-space list (#R$9FE3).
@label=AllocateMemory_Loop
*$A12D LD A,L        ; {Jump ahead to #R$A160 if the pointer is
 $A12E OR H          ; #N($0000,$04,$04).
 $A12F JR Z,$A160    ; }
 $A131 LD E,(HL)     ; {Jump ahead to #R$A13D when the high byte of this free
 $A132 INC HL        ; block is set.
 $A133 LD D,(HL)     ;
 $A134 INC HL        ;
 $A135 LD A,D        ;
 $A136 AND A         ;
 $A137 JR NZ,$A13D   ; }
 $A139 LD A,E        ; {Jump ahead to #R$A157 if the first value is below the
 $A13A CP C          ; second.
 $A13B JR C,$A157    ; }
@label=AllocateMemory_Next
*$A13D BIT 0,B       ; {Jump ahead to #R$A14E if bit 0 is clear.
 $A13F JR Z,$A14E    ; }
 $A141 PUSH HL       ; {Read the pointer saved ahead of this record.
 $A142 LD L,(IX-$02) ;
 $A145 LD H,(IX-$01) ; }
 $A148 AND A         ; {Compare #REGhl with #REGde.
 $A149 SBC HL,DE     ; }
 $A14B POP HL        ; Restore #REGhl from the stack.
 $A14C JR C,$A157    ; Jump ahead to #R$A157 if #REGhl was below #REGde.
@label=AllocateMemory_KeepAllocationRemember
*$A14E PUSH HL       ; {Copy the allocation into #REGix and remember the
 $A14F POP IX        ; caller's index.
 $A151 LD ($A11A),IY ; }
 $A155 SET 0,B       ; Set the mark on this character.
@label=AllocateMemory_NextBlock
*$A157 PUSH HL       ; {Follow the next free block and repeat from #R$A12D.
 $A158 POP IY        ;
 $A15A LD E,(HL)     ;
 $A15B INC HL        ;
 $A15C LD D,(HL)     ;
 $A15D EX DE,HL      ;
 $A15E JR $A12D      ; }
; See whether bit 0 of the count is set, then read the link stored ahead of this
; record, then clear the high byte of the count.
@label=AllocateMemory_TestBitCountLink
*$A160 BIT 0,B       ; {Jump ahead to #R$A1AC if bit 0 is clear.
 $A162 JR Z,$A1AC    ; }
 $A164 LD L,(IX-$02) ; {Read the pointer saved ahead of this record and count
 $A167 LD H,(IX-$01) ; #N$00.
 $A16A LD B,$00      ; }
 $A16C AND A         ; Clear the carry before subtracting the block length from
                     ; the free space.
 $A16D SBC HL,BC     ; Measure the pointer against the count.
 $A16F LD A,H        ; Read the high byte of the pointer.
 $A170 AND A         ; Clear the carry so a zero high byte means only a few
                     ; bytes of free space remain.
 $A171 JR NZ,$A18A   ; Jump to #R$A18A when the free space still has a high
                     ; byte.
 $A173 LD A,L        ; {Go to #R$A18A if at least four bytes of free space
 $A174 CP $04        ; remain.
 $A176 JR NC,$A18A   ; }
 $A178 LD IY,($A11A) ; {Bring the saved index back from #R$A11A and read the
 $A17C LD A,(IX+$00) ; character id.}
 $A17F LD (IY+$00),A ; Store the character id.
 $A182 LD A,(IX+$01) ; {Jump ahead to #R$A193 to step to the next character
 $A185 LD (IY+$01),A ; record.
 $A188 JR $A193      ; }

; Store That Byte In The Link Ahead
;
; Used by the routine at #R$A11C.
; .
; Store that byte in the link ahead of this record, then exchange the source with the
; pointer.
@label=StoreThatByteLinkAhead
c$A18A LD (IX-$02),L ; {Store the pointer in the previous memory entry.
 $A18D LD (IX-$01),H ;
 $A190 EX DE,HL      ; }
 $A191 ADD IX,DE     ; Step to the next memory entry.
; This entry point is used by the routine at #R$A11C.
@label=StoreThatByteLinkAhead_TestBytePreviousMemory
*$A193 INC IX        ; {Store this byte in the previous memory entry and take
 $A195 LD (IX-$03),C ; its address.
 $A198 PUSH IX       ;
 $A19A POP HL        ; }
 $A19B DEC HL        ; {Point #REGhl at the two bytes before this record.
 $A19C DEC HL        ; }
 $A19D LD B,C        ; Copy the count into #REGb.
 $A19E DEC B         ; Drop one from that count.
 $A19F XOR A         ; Clear #REGa so the following loop writes zeros.
@label=StoreThatByteLinkAhead_CountEntryRepeat
*$A1A0 LD (HL),A     ; {Count the next entry and repeat from #R$A1A0.
 $A1A1 INC HL        ;
 $A1A2 DJNZ $A1A0    ; }
 $A1A4 OR $01        ; Reset the zero flag.
 $A1A6 POP BC        ; {Restore the saved registers from the stack.
 $A1A7 POP DE        ;
 $A1A8 POP HL        ;
 $A1A9 POP IY        ; }
 $A1AB RET           ; Return.
; This entry point is used by the routine at #R$A11C.
; .
; Join the next step.
@label=StoreThatByteLinkAhead_JoinStep
*$A1AC JP $C1D8      ; Jump to #R$C1D8, the out of memory.

; Follow Record Pointer
;
; Used by the routines at #R$ACFB, #R$B6FD, #R$BA3E, #R$D87D and #R$D88A.
; .
; Copies the character-record pointer and jumps to the routine that pointer
; holds.
;
; IX Pointer to jump to
; HL (preserved on stack)
@label=FollowRecordPointer
c$A1AF PUSH HL       ; {Keep the pointer, copy the record into it, and go to
 $A1B0 PUSH IX       ; #R$A1C1.
 $A1B2 POP HL        ;
 $A1B3 JR $A1C1      ; }
; Walks the linked character records from the link stored just ahead of the
; current record, running each one until the link is empty.
@label=FollowRecordPointer_ReadLink
*$A1B5 LD L,(IX-$02) ; {Read the pointer saved ahead of this record, then call
 $A1B8 LD H,(IX-$01) ; #R$A1C7 to run memory entry.
 $A1BB CALL $A1C7    ; }
 $A1BE PUSH HL       ; {Use the saved pointer as the character record.
 $A1BF POP IX        ; }
; Loop while the link just read is not zero.
*$A1C1 LD A,L        ; {Jump back to #R$A1B5 while the pointer is not zero.
 $A1C2 OR H          ;
 $A1C3 JR NZ,$A1B5   ; }
 $A1C5 POP HL        ; Restore the saved pointer from the stack.
 $A1C6 RET           ; Return.

; Process Memory Entry
;
; Used by the routines at #R$A1AF, #R$AD57, #R$B77F, #R$B86A, #R$B9CA, #R$B9FA,
; #R$CC82, #R$CFCF, #R$D835 and #R$E58C.
; .
; Follows one linked record, stores its link, and clears the marker after that
; link.
@label=ProcessMemoryEntry
c$A1C7 PUSH HL       ; {Save the pointer, the source and the character record.
 $A1C8 PUSH DE       ;
 $A1C9 PUSH IX       ; }
 $A1CB POP HL        ; {Step back over the block header and point #REGix at the
 $A1CC DEC HL        ; free-space list (#R$9FE3).
 $A1CD DEC HL        ;
 $A1CE DEC HL        ;
 $A1CF LD IX,$9FE3   ; }
@label=ProcessMemoryEntry_Loop
*$A1D3 LD E,(IX+$00) ; {Read the record's flag byte and read the moved marker.
 $A1D6 LD D,(IX+$01) ; }
 $A1D9 LD A,D        ; {Jump ahead to #R$A1EB if the pointer is zero.
 $A1DA OR E          ;
 $A1DB JR Z,$A1EB    ; }
 $A1DD PUSH HL       ; {Compare #REGhl with #REGde, keeping a copy of #REGhl.
 $A1DE AND A         ;
 $A1DF SBC HL,DE     ; }
 $A1E1 POP HL        ; Restore #REGhl from the stack.
 $A1E2 JR C,$A1EB    ; Jump ahead to #R$A1EB if #REGhl was below #REGde.
 $A1E4 INC DE        ; {Step the source on two bytes, copy it into the record,
 $A1E5 INC DE        ; and go to #R$A1D3.
 $A1E6 PUSH DE       ;
 $A1E7 POP IX        ;
 $A1E9 JR $A1D3      ; }
; Stores the link in the record flag, clears the marker after that link, and
; stores the source address.
@label=ProcessMemoryEntry_Next
*$A1EB LD (IX+$00),L ; {Store the record's flag byte and store the moved
 $A1EE LD (IX+$01),H ; marker.
 $A1F1 INC HL        ; }
 $A1F2 LD (HL),$00   ; Clear the marker after the link.
 $A1F4 INC HL        ; {Call #R$A20C to calculate pointer offset.
 $A1F5 LD (HL),E     ;
 $A1F6 INC HL        ;
 $A1F7 LD (HL),D     ;
 $A1F8 CALL $A20C    ; }
 $A1FB JR Z,$A206    ; Go to #R$A206 if the offset meets this pointer.
 $A1FD LD L,(IX+$00) ; {Read the link word.
 $A200 LD H,(IX+$01) ; }
 $A203 PUSH HL       ; {Copy the link word from #REGhl into #REGix.
 $A204 POP IX        ; }
@label=ProcessMemoryEntry_Call
*$A206 CALL $A20C    ; {Call #R$A20C to calculate pointer offset.
 $A209 POP DE        ;
 $A20A POP HL        ; }
 $A20B RET           ; Return.

; Calculate Pointer Offset
;
; Used by the routine at #R$A1C7.
; .
; Adds the link word to its own address so the pointer reaches the linked
; record.
@label=CalculatePointerOffset
c$A20C PUSH IX       ; {Copy the record into the pointer, step back two bytes,
 $A20E POP HL        ; and read the link.
 $A20F DEC HL        ;
 $A210 DEC HL        ;
 $A211 LD E,(IX-$02) ; }
 $A214 LD D,(IX-$01) ; {Add the link to its own address to reach the linked
 $A217 ADD HL,DE     ; record, and read the record's flag byte.
 $A218 LD E,(IX+$00) ; }
 $A21B LD D,(IX+$01) ; Read the moved marker.
 $A21E LD A,D        ; {Jump ahead to #R$A225 if the pointer is not zero.
 $A21F OR E          ;
 $A220 JR NZ,$A225   ; }
 $A222 OR %00000001  ; Reset the zero flag.
 $A224 RET           ; Return.
; Return unless the two pointers are the same distance apart.
@label=CalculatePointerOffset_Next
*$A225 AND A         ; {Return if the adjusted pointer does not match the link.
 $A226 SBC HL,DE     ;
 $A228 RET NZ        ; }
 $A229 LD L,(IX+$00) ; {Read the link in this record and the field it points
 $A22C LD H,(IX+$01) ; at.
 $A22F PUSH BC       ;
 $A230 LD E,(HL)     ; }
 $A231 INC HL        ; {Read the high byte of the link into #REGd.
 $A232 LD D,(HL)     ;
 $A233 INC HL        ; }
 $A234 LD C,(HL)     ; {Read the following word into #REGbc.
 $A235 INC HL        ;
 $A236 LD B,(HL)     ; }
 $A237 LD L,(IX-$02) ; Read the low byte saved ahead of this record.
 $A23A LD H,(IX-$01) ; {Add #REGde to the saved pointer and store the low byte.
 $A23D ADD HL,DE     ;
 $A23E LD (IX-$02),L ; }
 $A241 LD (IX-$01),H ; Store the high byte of the pointer in the previous
                     ; record.
 $A244 LD (IX+$00),C ; {Store the record's flag byte and store the moved
 $A247 LD (IX+$01),B ; marker.
 $A24A POP BC        ; }
 $A24B XOR A         ; Clear #REGa.
 $A24C RET           ; Return.

; Token Word Table
;
; Eight token words. #R$A7EB indexes them from the token parameter, and uses the half at #R$A255 when the print mode or the object display flag is set.
; Used by #R$A7EB.
g$A24D DEFW $089D    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $A24F DEFW $0001    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $A251 DEFW $005A    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $A253 DEFW $080A    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $A255 DEFW $089D    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $A257 DEFW $089D    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $A259 DEFW $089D    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $A25B DEFW $080A    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".

; Check Text Token Match
;
; Used by the routine at #R$A277.
; .
; Sets the zero flag when pictures are off, the token pointer is zero, or
; #R$D34E returns #N$FF.
;
;   A Token ID to check
; O:F Zero flag set if token matches or end reached
@label=CheckTextTokenMatch
c$A25D PUSH BC       ; {Jump to #R$A275 if the pictures-enabled flag is zero.
 $A25E LD B,A        ;
 $A25F LD A,($A011)  ;
 $A262 AND A         ;
 $A263 JR Z,$A275    ; }
 $A265 LD HL,($A0D8) ; {Jump ahead to #R$A275 if the pointer is zero.
 $A268 LD A,H        ;
 $A269 OR L          ;
 $A26A JR Z,$A275    ; }
 $A26C PUSH HL       ; {Copy the pointer into the record and call #R$D34E with the count in #REGb to search
 $A26D POP IX        ; the three-byte table.
 $A26F LD A,B        ;
 $A270 CALL $D34E    ; }
 $A273 CP $FF        ; See whether the entry is the end marker.
*$A275 POP BC        ; Restore #REGbc from the stack.
 $A276 RET           ; Return.

; Process Text Token
;
; Used by the routine at #R$D113.
; .
; If this token is not already on screen, clears the picture lines and draws
; the room again.
;
; A Token ID
@label=ProcessTextToken
c$A277 PUSH IX       ; {Call #R$A25D to check text token match.
 $A279 PUSH HL       ;
 $A27A PUSH BC       ;
 $A27B PUSH AF       ;
 $A27C CALL $A25D    ; }
 $A27F JR Z,$A290    ; Go to #R$A290 if there is no text token.
 $A281 CALL $A296    ; {Call #R$A296 and then #R$C129 to initialise the screen
 $A284 CALL $C129    ; display.}
 $A287 LD L,(IX+$01) ; {Call #R$F3C2 to draw.
 $A28A LD H,(IX+$02) ;
 $A28D CALL $F3C2    ; }
@label=ProcessTextToken_Next
*$A290 POP AF        ; {Restore the saved result, the saved count, the saved
 $A291 POP BC        ; pointer and the saved character record from the stack.
 $A292 POP HL        ;
 $A293 POP IX        ; }
 $A295 RET           ; Return.

; Clear Display Lines
;
; Used by the routines at #R$9E74, #R$A277 and #R$B00B.
; .
; Blanks the lines used for the room picture.
@label=ClearDisplayLines
c$A296 LD B,$12      ; Count #N$12.
; Print newline.
@label=ClearDisplayLines_Loop
*$A298 CALL $A2A2    ; Call #R$A2A2 to print a new line.
 $A29B XOR A         ; {Clear the parser flag at #R$A019 and repeat from
 $A29C LD ($A019),A  ; #R$A298.
 $A29F DJNZ $A298    ; }
 $A2A1 RET           ; Return.

; Print Newline
;
; Used by the routines at #R$A296, #R$A2E4, #R$A64A, #R$CB7B, #R$D178, #R$D6C1,
; #R$DC6C, #R$DE60, #R$DEE4, #R$E0FF, #R$E2EE and #R$E691.
; .
; Prints a carriage return and puts the flags back afterwards.
@label=PrintNewline
c$A2A2 PUSH AF       ; {Keep #REGa, print a carriage return through #R$A9B7.
 $A2A3 LD A,$0D      ;
 $A2A5 CALL $A9B7    ; }
 $A2A8 POP AF        ; Restore #REGa from the stack.
 $A2A9 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$8583 }
; LIST#

; Object Display Flag
;
; Object Display Flag read by #R$A2E4, #R$A7EB, #R$D187 and #R$D590.
@label=ObjectDisplayFlag
g$A2AA DEFB $00

; Clear Buffer
;
; Used by the routines at #R$AC24, #R$B191, #R$B39D, #R$B6FD and #R$D6C1.
; .
; Blanks the buffer before the next step uses it.
@label=ClearBuffer
c$A2AB XOR A         ; Start from zero.
*$A2AC LD (HL),A     ; {Count down and repeat from #R$A2AC until the count runs
 $A2AD INC HL        ; out.
 $A2AE DJNZ $A2AC    ; }
 $A2B0 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$70E2 }
; LIST#

; Calculate Object Table Offset
;
; Used by the routines at #R$A2E4, #R$A37D and #R$C4D1.
; .
; Turns an object index into the address of its eight-byte runtime record at
; #R$8259.
;
;   A Object index (0-based)
; O:HL Pointer to object entry in table
@label=CalculateObjectTableOffset
c$A2B1 DEC A         ; {Count down one, store that in the low byte and clear
 $A2B2 LD L,A        ; the high byte.
 $A2B3 LD H,$00      ; }
 $A2B5 ADD HL,HL     ; {Multiply #REGhl by #N$08.
 $A2B6 ADD HL,HL     ;
 $A2B7 ADD HL,HL     ; }
 $A2B8 LD DE,$8259   ; Use the object runtime table as the source.
 $A2BB ADD HL,DE     ; Advance the pointer by the source length.
 $A2BC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$70E8 }
; LIST#

; Extract Object Attributes
;
; Used by the routines at #R$A2E4, #R$A37D, #R$B405 and #R$C4D1.
; .
; Packs two attribute nibbles from the object record into #R$A01E and #R$A01D.
;
; IX Pointer to object data
;
; Extract the first attribute value from bit-packed object data.
@label=ExtractObjectAttributes
c$A2BD LD A,(IX+$05) ; {Read the object attribute.
 $A2C0 RRCA          ;
 $A2C1 RRCA          ;
 $A2C2 RRCA          ;
 $A2C3 RRCA          ; }
 $A2C4 AND %00001111 ; Keep the high nibble of the object attribute (now in
                     ; bits 0-3) as the low half of the display flag.
 $A2C6 LD C,A        ; {Read the character record.
 $A2C7 LD A,(IX+$07) ; }
 $A2CA AND %11110000 ; Take the high nibble of byte #N$07 of the object data as
                     ; the high half of the display flag.
 $A2CC ADD A,C       ; Join the two halves into one byte.
 $A2CD LD ($A01E),A  ; Record the result in the display flag at #R$A01E.
; Extract the second attribute value from bit-packed object data.
 $A2D0 LD A,(IX+$01) ; {Read the moved marker.
 $A2D3 RRCA          ;
 $A2D4 RRCA          ;
 $A2D5 RRCA          ;
 $A2D6 RRCA          ; }
 $A2D7 AND %00001111 ; Keep the high nibble of the moved marker (now in bits
                     ; 0-3) as the low half of the object attribute value.
 $A2D9 LD C,A        ; {Read the action flags.
 $A2DA LD A,(IX+$03) ; }
 $A2DD AND %11110000 ; Take the high nibble of the action flags (byte #N$03) as
                     ; the high half of the object attribute value.
 $A2DF ADD A,C       ; Join the two halves into one byte.
 $A2E0 LD ($A01D),A  ; Record the result in the object attribute value at
                     ; #R$A01D.
 $A2E3 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$70F3 }
; LIST#

; Process Object Display
;
; Used by the routine at #R$CA76.
; .
; Sets the object display flag and prints the object when the player can see
; it.
@label=ProcessObjectDisplay
c$A2E4 LD A,$01      ; {Write #N$01 to the object display flag.
 $A2E6 LD ($A2AA),A  ;
 $A2E9 PUSH IY       ;
 $A2EB PUSH BC       ; }
 $A2EC PUSH IX       ; {Save the character record, the pointer and the source.
 $A2EE PUSH HL       ;
 $A2EF PUSH DE       ; }
 $A2F0 LD A,($A033)  ; {Write *#R$A033 to *#R$A35D.
 $A2F3 LD ($A35D),A  ; }
 $A2F6 LD HL,($A034) ; {Write *#R$A034 to *#R$A35E.
 $A2F9 LD ($A35E),HL ; }
; Are the parser flags clear?
 $A2FC LD A,($A00C)  ; {Jump to #R$A306 if the parser flags are clear.
 $A2FF LD B,A        ;
 $A300 AND A         ;
 $A301 LD A,$01      ;
 $A303 JR Z,$A306    ; }
 $A305 XOR A         ; Start the object from zero.
*$A306 LD ($A027),A  ; {Store it in the print mode, then call #R$D078 to test
 $A309 CALL $D078    ; object visibility.}
 $A30C JR NC,$A31A   ; Jump ahead to #R$A31A if #R$D078 finds the object is not
                     ; visible.
 $A30E LD A,B        ; {Jump ahead to #R$A31A if the count is not zero.
 $A30F AND A         ;
 $A310 JR NZ,$A31A   ; }
 $A312 LD HL,$68D1   ; {Take the cannot see message, then call #R$A59F to print the cannot see
 $A315 CALL $A59F    ; message.}
 $A318 JR $A34E      ; Jump ahead to #R$A34E to finish this object.
; Read the saved object fields at #R$A35D, then use the saved pointer as the character
; record, then read the object attribute value at #R$A01D.
@label=ProcessObjectDisplay_Next
*$A31A LD A,($A35D)  ; {Call #R$A2B1 to calculate object table offset.
 $A31D CALL $A2B1    ; }
 $A320 PUSH HL       ; {Call #R$A2BD to extract object attributes.
 $A321 POP IX        ;
 $A323 CALL $A2BD    ; }
 $A326 LD A,($A01D)  ; Read the object attribute value.
 $A329 AND %00010000 ; {Go to #R$A34E to finish this object if bit 4 of its
 $A32B JR NZ,$A34E   ; attribute value is set.}
 $A32D CP B          ; {Go to #R$A336 if #REGb is zero.
 $A32E JR Z,$A336    ; }
 $A330 CALL $DC6C    ; {Print a newline at #R$A2A2 if the character is #N$00,
 $A333 CALL Z,$A2A2  ; #N$01 or Sherlock at #R$DC6C.}
@label=ProcessObjectDisplay_CharacterBeingProcessed
*$A336 CALL $A724    ; Call #R$A724 to read which character is being processed.
 $A339 LD DE,$017F   ; {Go to #R$A348 if #REGb is not zero.
 $A33C XOR A         ;
 $A33D CP B          ;
 $A33E JR NZ,$A348   ; }
 $A340 CALL $A887    ; {Print the token at #R$A887, call #R$A360, then go to
 $A343 CALL $A360    ; #R$A34B.
 $A346 JR $A34B      ; }
; Prints a new line, then clears the object-display flag and the print mode.
@label=ProcessObjectDisplay_PrintsNewLine
*$A348 CALL $A37D    ; Call #R$A37D to process the object display.
*$A34B CALL $A2A2    ; Call #R$A2A2 to print a new line.
@label=ProcessObjectDisplay_WriteList
*$A34E XOR A         ; {Write #N$00 to #LIST { *#R$A2AA } { *#R$A027 } LIST#.
 $A34F LD ($A2AA),A  ;
 $A352 LD ($A027),A  ; }
 $A355 POP DE        ; {Restore the saved source, the saved pointer, the saved
 $A356 POP HL        ; character record, the saved count and the saved schedule
 $A357 POP IX        ; entry from the stack.
 $A359 POP BC        ;
 $A35A POP IY        ; }
 $A35C RET           ; Return.

; Saved Object Fields
;
; Scratch copy of an object id and two room bytes. #R$A2E4 stores the id from #R$A033 and the room word from #R$A034. #R$CDBF stores three record bytes here and copies them back.
; Used by #R$A2E4, #R$A37D and #R$CDBF.
g$A35D DEFB $00      ; Object id.
 $A35E DEFB $00      ; Room byte, or the low byte of the room word from
                     ; #R$A034.
 $A35F DEFB $00      ; Second room byte, or the high byte of that word.

; Check And Reset Character State
;
; Used by the routines at #R$A2E4 and #R$A5C3.
; .
; Clears #R$A35E if it holds the current character, then runs #R$A37D with the current character set to zero, and restores the character.
; .
; Control code #N$18 in the table at #R$A55D.
@refs=$A5C3
@label=CheckAndResetCharacterState
c$A360 LD A,($A036)  ; {Read the character being processed and take the saved
 $A363 PUSH AF       ; object field at #R$A35E.
 $A364 LD HL,$A35E   ; }
 $A367 CP (HL)       ; {Clear #REGa and jump ahead to #R$A36D unless #R$A35E
 $A368 LD A,$00      ; holds this character.
 $A36A JR NZ,$A36D   ; }
 $A36C LD (HL),A     ; Store the cleared character state back in the record.
@label=CheckAndResetCharacterState_Next
*$A36D LD ($A036),A  ; Set the current character to zero.
 $A370 PUSH IX       ; {Keep the character record, call #R$A37D to print this
 $A372 CALL $A37D    ; object's tokens.}
 $A375 POP IX        ; {Restore the saved character from the stack.
 $A377 POP AF        ; }
 $A378 LD ($A036),A  ; Store the character id at #R$A036.
 $A37B XOR A         ; Clear #REGa.
 $A37C RET           ; Return.

; Process Object Display
;
; Used by the routines at #R$A2E4 and #R$A360.
; .
; Clears the object-processing flag, reads this object's attributes, and prints
; the tokens the display bits select.
@label=ProcessObject_Display
c$A37D XOR A         ; {Clear the object processing source flag.
 $A37E LD ($A028),A  ; }
 $A381 LD A,($A35D)  ; {Call #R$A2B1 to calculate object table offset.
 $A384 CALL $A2B1    ; }
 $A387 PUSH HL       ; {Call #R$A2BD to extract object attributes.
 $A388 POP IX        ;
 $A38A PUSH HL       ;
 $A38B CALL $A2BD    ; }
 $A38E CALL $C493    ; Call #R$C493 to test bits 3 and 7 of the object
                     ; attribute.
 $A391 CALL $C4B2    ; Call #R$C4B2 to test bits 2 and 6 of the object
                     ; attribute.
 $A394 POP HL        ; Restore #REGhl from the stack.
 $A395 LD A,($A01D)  ; {Read the byte at #R$A01D into #REGc, save #REGhl and
 $A398 LD C,A        ; take an offset of #N($0006,$04,$04).
 $A399 PUSH HL       ;
 $A39A LD DE,$0006   ; }
 $A39D ADD HL,DE     ; {Call #R$A880 to print the token.
 $A39E CALL $A880    ;
 $A3A1 POP HL        ; }
 $A3A2 CALL $A880    ; {Call #R$A880, then jump ahead to #R$A3E2 if bit 3 of
 $A3A5 BIT 3,C       ; #REGc is clear.
 $A3A7 JR Z,$A3E2    ; }
 $A3A9 BIT 5,C       ; {If bit 5 of the token is set, call #R$A880 to extract
 $A3AB CALL NZ,$A880 ; the token.}
 $A3AE LD A,($A01E)  ; {If bit 7 of the saved token is set, call #R$A880 to
 $A3B1 BIT 7,A       ; extract the token.
 $A3B3 CALL NZ,$A880 ; }
 $A3B6 LD A,($A35E)  ; {Jump to #R$A3C7 if the saved object field at #R$A35E is
 $A3B9 CP $FE        ; not #N$FE.
 $A3BB JR NZ,$A3C7   ; }
 $A3BD PUSH HL       ; {Point #REGhl at #R$A02F and call #R$A419, keeping the
 $A3BE LD HL,($A02F) ; saved pointer.
 $A3C1 CALL $A419    ;
 $A3C4 POP HL        ; }
 $A3C5 JR $A3E2      ; The picture marker has been handled and the saved
                     ; pointer is already back in #REGhl, so carry on at
                     ; #R$A3E2.
; Compare this object with the character being processed, and take the token at
; #N$055B when they match.
@label=ProcessObject_Display_Next
*$A3C7 PUSH HL       ; {Jump ahead to #R$A3D6 if this object is not the
 $A3C8 LD HL,$A036   ; character being processed.
 $A3CB CP (HL)       ;
 $A3CC JR NZ,$A3D6   ; }
 $A3CE LD DE,$055B   ; {Take #N$055B for the object, then call #R$A887 to print
 $A3D1 CALL $A887    ; token #N$055B.}
 $A3D4 JR $A3E1      ; The token for the character being processed has been
                     ; printed, so skip the location data and carry on at
                     ; #R$A3E1.
; When the display mode is the picture marker, run the location data in the
; saved object fields.
@label=ProcessObject_Display_DisplayModePicture
*$A3D6 LD A,($A00F)  ; Read the display mode.
 $A3D9 CP $05        ; {See whether the display mode is #N$05 and read the saved object field at #R$A35E, then call #R$A745 to
 $A3DB LD A,($A35E)  ; run location data if valid.
 $A3DE CALL $A745    ; }
@label=ProcessObject_Display_WorkspaceBringingSaved
*$A3E1 POP HL        ; Restore the saved pointer from the stack.
*$A3E2 LD A,($A35F)  ; {Jump ahead to #R$A414 if the saved object field at
 $A3E5 CP $FF        ; #R$A35F is #N$FF.
 $A3E7 JR Z,$A414    ; }
 $A3E9 BIT 2,C       ; {Jump ahead to #R$A414 if bit 2 is clear.
 $A3EB JR Z,$A414    ; }
 $A3ED BIT 5,C       ; {If bit 5 of the token is clear, call #R$A880 to extract
 $A3EF CALL Z,$A880  ; the token.}
 $A3F2 LD A,($A01E)  ; {If bit 7 of the display flag at #R$A01E is clear, call
 $A3F5 BIT 7,A       ; #R$A880 to extract the token.
 $A3F7 CALL Z,$A880  ; }
 $A3FA LD A,($A35F)  ; {Jump to #R$A409 if the saved object field at #R$A35F is
 $A3FD CP $FE        ; not #N$FE.
 $A3FF JR NZ,$A409   ; }
 $A401 LD HL,($A031) ; {Read the display pointer, then call #R$A419 to handle the picture for this
 $A404 CALL $A419    ; message.}
 $A407 JR $A414      ; Jump ahead to #R$A414 to take #N$2E and jump to #R$A9B7.
; When the other display mode is the picture marker, run the location data in
; the saved object fields.
@label=ProcessObject_Display_OtherDisplayMode
*$A409 LD A,($A010)  ; Read the display mode.
 $A40C CP $05        ; {See whether the display mode is #N$05 and read the saved object field at #R$A35F, then call #R$A745 to
 $A40E LD A,($A35F)  ; run location data if valid.
 $A411 CALL $A745    ; }

; Print A Full Stop
;
; Used by the routines at #R$A37D, #R$BBE5, #R$D113, #R$D526, #R$D60B and
; #R$D68C.
; .
; Adds a full stop to the message and goes back to the token walk.
@label=PrintFullStop
c$A414 LD A,$2E      ; {Go to #R$A9B7 to print a full stop.
 $A416 JP $A9B7      ; }

; Shift The Text Pointer And Print A Space
;
; Used by the routines at #R$A37D, #R$E2EE and #R$E691.
; .
; Clear the top bit of the pointer, then scale the pointer down to the next bit
@label=ShiftTextPointer
c$A419 PUSH BC       ; {Save #REGbc and rescale the text pointer.
 $A41A RES 7,H       ;
 $A41C SLA L         ;
 $A41E SRL H         ; }
 $A420 RR L          ; Rotate the bit from #REGh into #REGl, finishing the
                     ; shift of #REGhl.
 $A422 LD A,$20      ; {Print a space.
 $A424 CALL $A9B7    ; }
 $A427 LD DE,$00F0   ; {Take #N($00F0,$04,$04) as the unit #R$A476 subtracts
 $A42A CALL $A476    ; from #REGhl.}
 $A42D AND A         ; {Jump ahead to #R$A442 if #REGhl was below
 $A42E JR Z,$A442    ; #N($00F0,$04,$04).}
 $A430 LD B,A        ; {Keep the count in #REGb and print character #N$60
 $A431 LD A,$60      ; through #R$A9B7.
 $A433 CALL $A9B7    ; }
 $A436 CALL $A490    ; {Call #R$A490 to print the count, then jump ahead to
 $A439 LD A,L        ; #R$A467 if the remainder in #REGhl is zero.
 $A43A OR H          ;
 $A43B JR Z,$A467    ; }
 $A43D LD A,$20      ; {Print a space.
 $A43F CALL $A9B7    ; }
@label=ShiftTextPointer_PrintObjects
*$A442 LD DE,$000C   ; {Take #N($000C,$04,$04) as the unit for #R$A476.
 $A445 CALL $A476    ; }
 $A448 AND A         ; {Jump ahead to #R$A469 if #R$A476 counted no groups of
 $A449 JR Z,$A469    ; #N$0C.}
 $A44B LD B,A        ; {Use the count, then call #R$A490 to print it.
 $A44C CALL $A490    ; }
 $A44F LD A,$2F      ; {Print '/'.
 $A451 CALL $A9B7    ; }
 $A454 LD A,L        ; {Jump ahead to #R$A45E if the remainder in #REGl is
 $A455 AND A         ; zero.
 $A456 LD B,A        ;
 $A457 JR Z,$A45E    ; }
 $A459 CALL $A490    ; {Call #R$A490 to print the units and return through
 $A45C JR $A467      ; #R$A467.}

; Print A Hyphen
;
; Used by the routine at #R$A419.
; .
; Prints a hyphen and clears the marker that forces a capital letter.
@label=PrintHyphen
c$A45E LD A,$2D      ; Take a hyphen.
; This entry point is used by the routine at #R$A469.
*$A460 CALL $A9B7    ; Call #R$A9B7 to print the character.
 $A463 XOR A         ; {Clear the token format flag.
 $A464 LD ($A026),A  ; }
; This entry point is used by the routine at #R$A419.
@label=PrintHyphen_Return
*$A467 POP BC        ; Restore #REGbc from the stack.
 $A468 RET           ; Return.

; Print The Letter D
;
; Used by the routine at #R$A419.
; .
; Prints the units, then the letter D and a full stop.
@label=PrintLetterD
c$A469 LD B,L        ; {Put the units in the count and call #R$A490 to print
 $A46A CALL $A490    ; them.}
 $A46D LD A,$44      ; {Print the letter D.
 $A46F CALL $A9B7    ; }
 $A472 LD A,$2E      ; {Print a full stop and continue at #R$A460.
 $A474 JR $A460      ; }

; Divide By Repeated Subtraction
;
; Used by the routines at #R$A419 and #R$A480.
; .
; Counts how many times #REGde can be subtracted from #REGhl. Returns the count
; in #REGa and the remainder in #REGhl.
@label=DivideBySubtraction
c$A476 LD A,$FF      ; Start the count at #N$FF so the first pass makes it
                     ; zero.
*$A478 INC A         ; {Count in #REGa how many times #REGde can be subtracted
 $A479 AND A         ; from #REGhl, and repeat until #REGhl goes below #REGde.
 $A47A SBC HL,DE     ;
 $A47C JR NC,$A478   ; }
 $A47E ADD HL,DE     ; Add #REGde back to leave the remainder in #REGhl.
 $A47F RET           ; Return.

; Print One Decimal Digit
;
; Used by the routine at #R$A490.
; .
; Prints one decimal digit, suppressing leading zeros.
@label=PrintOneDecimalDigit
c$A480 CALL $A476    ; Call #R$A476 to divide #REGhl by #REGde (quotient in
                     ; #REGa, remainder in #REGhl).
 $A483 ADD A,$30     ; Turn the number into a character.
 $A485 DEC C         ; {Print the digit at once if an earlier digit was
 $A486 INC C         ; printed.
 $A487 JR NZ,$A48D   ; }
 $A489 CP $30        ; {Return when the character is the digit zero.
 $A48B RET Z         ; }
 $A48C INC C         ; Note that a digit has been printed.
*$A48D JP $A9B7      ; Jump to #R$A9B7 to print the digit.

; Print Hundreds, Tens And Units
;
; Used by the routines at #R$A419 and #R$A469.
; .
; Prints #REGb as up to three decimal digits.
@label=PrintHundredsTensAndUnits
c$A490 PUSH HL       ; {Clear the high byte.
 $A491 PUSH DE       ;
 $A492 LD L,B        ;
 $A493 LD H,$00      ;
 $A495 LD C,H        ; }
 $A496 LD DE,$0064   ; Take #N($0064,$04,$04), one hundred, as the next unit.
 $A499 CALL $A480    ; Call #R$A480 to print this digit.
 $A49C LD DE,$000A   ; {Take #N($000A,$04,$04), ten, as the unit for #R$A480.
 $A49F CALL $A480    ; }
 $A4A2 LD A,L        ; {Add #N$30 to the units left in #REGl, call #R$A9B7 to
 $A4A3 ADD A,$30     ; print the digit, and restore the registers.
 $A4A5 CALL $A9B7    ;
 $A4A8 POP DE        ;
 $A4A9 POP HL        ; }
 $A4AA RET           ; Return.

; Point To Location Data Plus One
;
; Used by the routine at #R$A745.
; .
; Points one byte past the room record for the id just looked up.
;
;   A Room ID
; O:HL Pointer to location data + 1
@label=PointToLocationDataPlusOne
c$A4AB PUSH DE       ; {Keep the character record, then call #R$D224 to look up
 $A4AC PUSH IX       ; this room.
 $A4AE CALL $D224    ; }
 $A4B1 PUSH IX       ; {Copy the record into the pointer and add
 $A4B3 POP HL        ; #N($0001,$04,$04).
 $A4B4 LD DE,$0001   ;
 $A4B7 ADD HL,DE     ; }
 $A4B8 POP IX        ; {Restore the saved character record and the saved source
 $A4BA POP DE        ; from the stack.}
 $A4BB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$71D5 }
; LIST#

; Point To Object Attribute Byte
;
; Used by the routines at #R$A751, #R$BA3E, #R$BF1C and #R$CBC2.
; .
; Points at the flag byte seven bytes into the object's record.
;
;   A Object ID
; O:HL Pointer to the object attribute byte
@label=PointToObjectAttributeByte
c$A4BC PUSH DE       ; {Call #R$D237 to look up that object.
 $A4BD PUSH IX       ;
 $A4BF CALL $D237    ; }
 $A4C2 PUSH IX       ; {Copy the record into the pointer and add
 $A4C4 POP HL        ; #N($0007,$04,$04).
 $A4C5 LD DE,$0007   ;
 $A4C8 ADD HL,DE     ; }
 $A4C9 POP IX        ; {Restore the saved character record and the saved source
 $A4CB POP DE        ; from the stack.}
 $A4CC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$71E2 }
; LIST#

; Compare Location Data
;
; Used by the routine at #R$B39D.
; .
; Compares the two room records from the exit field onward and reports whether
; they match.
@label=CompareLocationData
c$A4CD PUSH DE       ; {Save #REGde, #REGhl and #REGiy, then point #REGhl six bytes further on
 $A4CE PUSH HL       ; (#N($0006,$04,$04)).
 $A4CF PUSH IY       ;
 $A4D1 LD DE,$0006   ;
 $A4D4 ADD HL,DE     ; }
 $A4D5 ADD IY,DE     ; {Call #R$A51B to read the script position.
 $A4D7 CALL $A51B    ; }
 $A4DA JR NZ,$A516   ; {Jump to #R$A516 when the script position does not
 $A4DC POP IY        ; match, and otherwise restore the records this test used.
 $A4DE POP HL        ;
 $A4DF POP DE        ; }

; Leave Success For The Script
;
; Used by the routines at #R$B6FD, #R$D36A and #R$D39B.
; .
; Compares the following fields and records a match when they agree.
@label=CompareFollowingFields
c$A4E0 PUSH DE       ; {Keep the schedule entry, then call #R$A51B to compare
 $A4E1 PUSH HL       ; location data.
 $A4E2 PUSH IY       ;
 $A4E4 CALL $A51B    ; }
 $A4E7 JR NZ,$A516   ; Go to #R$A516 if the script position does not match.
 $A4E9 LD A,$01      ; {Take #N$01, store it at #R$A02E and call #R$A51B to
 $A4EB LD ($A02E),A  ; compare location data.
 $A4EE CALL $A51B    ; }
 $A4F1 JR NZ,$A4FA   ; Go to #R$A4FA if the script position does not match.
 $A4F3 CALL $A51B    ; {Go to #R$A516 if this field matches.
 $A4F6 LD A,$00      ;
 $A4F8 JR Z,$A516    ; }
@label=CompareFollowingFields_Next
*$A4FA POP IY        ; {Restore the schedule entry and the pointer from the
 $A4FC POP HL        ; stack, keeping a copy of each there.
 $A4FD PUSH HL       ;
 $A4FE PUSH IY       ; }
 $A500 LD DE,$0004   ; Take an offset of #N($0004,$04,$04).
 $A503 ADD IY,DE     ; {Step to the next schedule entry and step on two places, then call #R$A51B to compare
 $A505 INC HL        ; location data.
 $A506 INC HL        ;
 $A507 CALL $A51B    ; }
 $A50A JR NZ,$A516   ; Go to #R$A516 if the script position does not match.
 $A50C LD DE,$FFFC   ; {Step the schedule entry back by #N$04 and call #R$A51B
 $A50F ADD IY,DE     ; to compare the location data.
 $A511 CALL $A51B    ; }
 $A514 LD A,$01      ; Take #N$01.
; This entry point is used by the routine at #R$A4CD.
*$A516 POP IY        ; {Restore the saved schedule entry, the saved pointer and
 $A518 POP HL        ; the saved source from the stack.
 $A519 POP DE        ; }
 $A51A RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$71F3 }
; LIST#

; Read The Script Position
;
; Used by the routines at #R$A4CD and #R$A4E0.
; .
; Reads a pair of bytes and reports whether the low digit matches the script.
@label=ReadScriptPosition
c$A51B PUSH HL       ; {Go to #R$A52E if both bytes of this word are zero.
 $A51C LD A,(HL)     ;
 $A51D INC HL        ;
 $A51E OR (HL)       ;
 $A51F JR Z,$A52E    ; }
; Does the low nibble of #REGiy+#N$01 differ from the script byte at #REGhl?
 $A521 LD A,(IY+$01) ; {Jump to #R$A52E when the low nibble of #REGiy+#N$01
 $A524 XOR (HL)      ; differs from the script byte at #REGhl.
 $A525 AND $0F       ;
 $A527 JR NZ,$A52E   ; }
 $A529 DEC HL        ; {Step back one script byte and compare it with this
 $A52A LD A,(HL)     ; schedule field.
 $A52B CP (IY+$00)   ; }
@label=ReadScriptPosition_MoveOneByte
*$A52E POP HL        ; {Move one byte onward and restore the pointer saved for
 $A52F INC HL        ; this step.}
 $A530 INC HL        ; Advance through the script.
 $A531 INC IY        ; Step to the next field of the schedule entry.
 $A533 INC IY        ; Step to the next field of the schedule entry.
 $A535 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$722E }
; LIST#

; Wait For A Key With Timeout
;
; Used by the routine at #R$D8AD.
; .
; Waits for a key until the timer at #R$A039+#N$02 runs out. #R$C41F sets bit 7
; when a key is pressed. When the timer expires, #R$D9B7 runs. Either way the
; timer is reset to #N$0BB8.
@label=WaitForKeyWithTimeout
c$A536 PUSH HL       ; {Save the pointer and read the timeout at #R$A039+#N$02.
 $A537 LD HL,($A03B) ; }
@label=WaitForKeyWithTimeout_Loop
*$A53A CALL $C41F    ; {Jump ahead to #R$A553 if #R$C41F reports a key.
 $A53D BIT 7,A       ;
 $A53F JR NZ,$A553   ; }
 $A541 LD A,$00      ; Start the delay at zero.
*$A543 DEC A         ; {Spin until the delay runs out.
 $A544 PUSH HL       ;
 $A545 POP HL        ;
 $A546 JR NZ,$A543   ; }
 $A548 DEC HL        ; {Count the timeout down.
 $A549 LD A,H        ;
 $A54A OR L          ;
 $A54B JR NZ,$A53A   ; }
 $A54D POP HL        ; Restore the pointer from the stack.
 $A54E PUSH HL       ; {Call #R$D9B7, keeping the pointer.
 $A54F CALL $D9B7    ; }
 $A552 XOR A         ; Clear the key code.
@label=WaitForKeyWithTimeout_KeyPressed
*$A553 AND $7F       ; {Clear bit 7 and reset the timeout to #N$0BB8.
 $A555 LD HL,$0BB8   ;
 $A558 LD ($A03B),HL ; }
 $A55B POP HL        ; Restore the saved pointer from the stack.
 $A55C RET           ; Return.

; Control Character Jump Table
;
; Control Character Jump Table read by #R$A5F2.
@label=JumpTable_ControlCharacters
g$A55D DEFW $A65D    ; ID: #N((#PC-$A55D)/$02).
 $A55F DEFW $A66C    ; ID: #N((#PC-$A55D)/$02).
 $A561 DEFW $A679    ; ID: #N((#PC-$A55D)/$02).
 $A563 DEFW $A702    ; ID: #N((#PC-$A55D)/$02).
 $A565 DEFW $A709    ; ID: #N((#PC-$A55D)/$02).
 $A567 DEFW $A711    ; ID: #N((#PC-$A55D)/$02).
 $A569 DEFW $A720    ; ID: #N((#PC-$A55D)/$02).
 $A56B DEFW $A72C    ; ID: #N((#PC-$A55D)/$02).
 $A56D DEFW $A736    ; ID: #N((#PC-$A55D)/$02).
 $A56F DEFW $A73B    ; ID: #N((#PC-$A55D)/$02).
 $A571 DEFW $A6D3    ; ID: #N((#PC-$A55D)/$02).
 $A573 DEFW $A75B    ; ID: #N((#PC-$A55D)/$02).
 $A575 DEFW $A780    ; ID: #N((#PC-$A55D)/$02).
 $A577 DEFW $A63A    ; ID: #N((#PC-$A55D)/$02).
 $A579 DEFW $A78E    ; ID: #N((#PC-$A55D)/$02).
 $A57B DEFW $A68C    ; ID: #N((#PC-$A55D)/$02).
 $A57D DEFW $A793    ; ID: #N((#PC-$A55D)/$02).
 $A57F DEFW $A7AC    ; ID: #N((#PC-$A55D)/$02).
 $A581 DEFW $A65C    ; ID: #N((#PC-$A55D)/$02).
 $A583 DEFW $A7B4    ; ID: #N((#PC-$A55D)/$02).
 $A585 DEFW $A694    ; ID: #N((#PC-$A55D)/$02).
 $A587 DEFW $A69C    ; ID: #N((#PC-$A55D)/$02).
 $A589 DEFW $A6A4    ; ID: #N((#PC-$A55D)/$02).
 $A58B DEFW $A6AC    ; ID: #N((#PC-$A55D)/$02).
 $A58D DEFW $A360    ; ID: #N((#PC-$A55D)/$02).
 $A58F DEFW $A771    ; ID: #N((#PC-$A55D)/$02).
 $A591 DEFW $A684    ; ID: #N((#PC-$A55D)/$02).
 $A593 DEFW $A852    ; ID: #N((#PC-$A55D)/$02).
 $A595 DEFW $A682    ; ID: #N((#PC-$A55D)/$02).
 $A597 DEFW $A63F    ; ID: #N((#PC-$A55D)/$02).
 $A599 DEFW $A643    ; ID: #N((#PC-$A55D)/$02).
 $A59B DEFW $A65A    ; ID: #N((#PC-$A55D)/$02).

; Text Pointer
;
; Word #R$A66C reads the next text token through, stepping it on two bytes. #R$A59F also keeps the caller's stack pointer here while a message is printed.
; Used by #R$A59F and #R$A66C.
g$A59D DEFW $0000

; Print Text And Handle Control Characters
;
; Used by the routines at #R$99FC, #R$9A05, #R$9A13, #R$9A3D, #R$9A4B, #R$9A59,
; #R$9A80, #R$9B50, #R$9CE9, #R$9D65, #R$9DC6, #R$9DD8, #R$9DFF, #R$9E74,
; #R$9E87, #R$9FC9, #R$A2E4, #R$B5B6, #R$B633, #R$B6E5, #R$B83C, #R$BA3E,
; #R$BB5C, #R$BBE5, #R$CB7B, #R$CBA7, #R$CBC2, #R$CD95, #R$CDA1, #R$CDBF,
; #R$D113, #R$D182, #R$D187, #R$D1B2, #R$D4A7, #R$D590, #R$D60B, #R$D68C,
; #R$D6C1, #R$DCA7, #R$DE60, #R$DF5B, #R$E03A, #R$E0FF, #R$E151, #R$E17B,
; #R$E2EE, #R$E34F, #R$E3F5, #R$E691, #R$E710, #R$EF9E and #R$F1AA.
; .
; Prints the message at the pointer, carrying out the control characters inside
; it and then returns to the instruction after the call.
;
; HL Pointer to text data
@label=PrintTextAndHandleControlCharacters
c$A59F PUSH BC       ; {Save the count, the source, the character record, the
 $A5A0 PUSH DE       ; result and the pointer.
 $A5A1 PUSH IX       ;
 $A5A3 PUSH AF       ;
 $A5A4 PUSH HL       ; }
 $A5A5 LD HL,$000C   ; Point twelve bytes up the stack, just past the saved
                     ; return address.
 $A5A8 ADD HL,SP     ; {Add the stack pointer, store that address in the text
 $A5A9 LD ($A59D),HL ; pointer at #R$A59D.}
 $A5AC POP HL        ; Restore the message pointer from the stack.
 $A5AD LD A,($A00B)  ; {Jump to #R$A5B6 if the parser is set.
 $A5B0 AND A         ;
 $A5B1 JR NZ,$A5B6   ; }
 $A5B3 LD ($A00C),A  ; Record the parser.
@label=PrintTextAndHandleControlCharacters_Next
*$A5B6 CALL $A5C4    ; {Call #R$A5C4 to run text stream.
 $A5B9 POP AF        ;
 $A5BA POP IX        ;
 $A5BC POP DE        ;
 $A5BD POP BC        ; }
 $A5BE POP HL        ; Restore the return address from the stack.
 $A5BF LD SP,($A59D) ; And switch to the stack saved in the text pointer at
                     ; #R$A59D.
; View the equivalent code in;
; #LIST
; { #HOBBIT$72DD }
; LIST#

; Dispatch Looked-Up Handler
;
; Used by the routine at #R$A5F2.
; .
; Jumps to the handler the caller looked up.
@label=DispatchTextControlHandler
c$A5C3 JP (HL)       ; Jump to the handler address in #REGhl.

; Process Text Stream
;
; Used by the routines at #R$A59F, #R$A75B and #R$A771.
; .
; Prints every byte of the message, and stops when the printer says the text
; has ended.
;
; HL Pointer to text data
@label=ProcessTextStream
c$A5C4 PUSH HL       ; {Use the saved pointer as the character record.
 $A5C5 POP IX        ; }
; Keep on looping through until all of the text has been printed.
@label=TextProcessing_Loop
*$A5C7 CALL $A5CD    ; Call #R$A5CD to carry out this text command.
 $A5CA JR NZ,$A5C7   ; Jump back to #R$A5C7 until all the text has been
                     ; processed.
 $A5CC RET           ; Return.

; Process Text Command
;
; Used by the routines at #R$A5C4 and #R$A6D3.
; .
; Reads the next text byte. A command keeps its parameter, and any other byte is printed
; as text.
;
; IX Pointer to text data
@label=ProcessTextCommand
c$A5CD LD A,(IX+$00) ; {Jump ahead to #R$A5F2 if bit 7 of the record's flag
 $A5D0 BIT 7,A       ; byte is clear.
 $A5D2 JR Z,$A5F2    ; }
 $A5D4 AND %01111111 ; Strip the command marker (bit 7) to leave the token
                     ; code.
 $A5D6 LD D,A        ; {Keep the token code in #REGd and its parameter in #REGe, and step #REGix onto
 $A5D7 LD E,(IX+$01) ; that parameter.
 $A5DA INC IX        ; }
 $A5DC AND %11110000 ; Keep the token type (the high nibble) for the checks
                     ; below.
 $A5DE CP $30        ; {Go to #R$A647 when the token type is #N$30.
 $A5E0 JR Z,$A647    ; }
 $A5E2 CP $20        ; {Go to #R$A647 when the token type is #N$20.
 $A5E4 JR Z,$A647    ; }
 $A5E6 CP $60        ; {Go to #R$A647 when the token type is #N$60.
 $A5E8 JR Z,$A647    ; }

; Mark Success For The Script
;
; Used by the routines at #R$A5F2 and #R$A83A.
; .
; Prints the dictionary word, steps past it, and leaves a non-zero result so
; the caller continues.
;
; .
;
; Print text token.
@label=MarkSuccessScript
c$A5EA CALL $A887    ; Call #R$A887 to print the dictionary word.
; This entry point is used by the routine at #R$A5F2.
@label=MarkSuccessScript_MarkSuccess
*$A5ED INC IX        ; Step past the dictionary word.
 $A5EF OR $01        ; Force a non-zero result so the caller continues.
 $A5F1 RET           ; Return.

; Test For A Space
;
; Used by the routine at #R$A5CD.
; .
; Sorts a text byte into a blank, a vocabulary code, or a packed letter.
@label=TestSpace
c$A5F2 CP $20        ; {Jump ahead to #R$A621 if this text byte is below #N$20.
 $A5F4 JR C,$A621    ; }
 $A5F6 CP $60        ; {Jump ahead to #R$A83A if it is at least #N$60.
 $A5F8 JP NC,$A83A   ; }
 $A5FB CP $40        ; {Jump ahead to #R$A61C if it is below #N$40.
 $A5FD JR C,$A61C    ; }
 $A5FF AND %00011111 ; Take the letter count of this packed word from bits 0-4.
 $A601 INC A         ; {Set #REGb to the length plus one, point #REGhl at the byte after #REGix,
 $A602 LD B,A        ; and clear #REGc.
 $A603 PUSH IX       ;
 $A605 POP HL        ;
 $A606 INC HL        ;
 $A607 LD C,$00      ; }
*$A609 CALL $A990    ; {Call #R$A990 to rotate and extract character code, then call #R$A9B7 to
 $A60C CALL $A9B7    ; print character.}
 $A60F DJNZ $A609    ; Count the next character of the message and repeat from
                     ; #R$A609.
 $A611 PUSH HL       ; {Copy the pointer into the record, and go to #R$A5ED if the count in #REGc is not
 $A612 POP IX        ; zero.
 $A614 LD A,C        ;
 $A615 AND A         ;
 $A616 JR NZ,$A5ED   ; }
 $A618 DEC IX        ; {Step the pointer back one byte and go back to #R$A5ED.
 $A61A JR $A5ED      ; }
; Call #R$A9B7 to print this character.
@label=TestSpace_PrintSpace
*$A61C CALL $A9B7    ; {Print this character and go back to #R$A5ED for the
 $A61F JR $A5ED      ; next letter.}
; Store the result in the low byte of the source, then clear the high byte of the
; source, then use the control character jump table at #R$A55D as the pointer.
@label=TestSpace_IndexByCode
*$A621 PUSH DE       ; {Use the control character jump table at #R$A55D.
 $A622 LD E,A        ;
 $A623 LD D,$00      ;
 $A625 LD HL,$A55D   ;
 $A628 ADD HL,DE     ; }
 $A629 ADD HL,DE     ; {Move the pointer on by the length, step to the next character of the message
 $A62A LD E,(HL)     ; and swap the two pointers.
 $A62B INC HL        ;
 $A62C LD D,(HL)     ;
 $A62D EX DE,HL      ;
 $A62E POP DE        ; }
 $A62F CP $1D        ; {Jump back to #R$A5C3 if the token is at least #N$1D.
 $A631 JR NC,$A5C3   ; }
 $A633 CALL $A5C3    ; {Go to #R$A5ED if the looked-up handler returns zero.
 $A636 JR Z,$A5ED    ; }
 $A638 JR $A5EA      ; Carry on from #R$A5EA once the handler has returned.

; Print This Character
;
; Sends the character in #REGa to #R$A9B7 and returns zero. The same three
; instructions as #R$A736.
; .
; Control code #N$0D in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=PrintThisCharacter
c$A63A CALL $A9B7    ; Call #R$A9B7 to print this character.
 $A63D XOR A         ; Clear #REGa.
 $A63E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$72C3 }
; LIST#

; Choose The Line Break
;
; Puts #N$60 in #REGd and jumps to #R$A64A, which skips the full stop but still
; prints a new line. #R$A643 puts #N$30 in #REGd, which makes #R$A64A print a full stop
; and a new line.
; .
; Control code #N$1D in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=ChooseTheLineBreak
c$A63F LD D,$60      ; {Put #N$60 in #REGd and jump to #R$A64A.
 $A641 JR $A64A      ; }
; Puts #N$30 in #REGd so #R$A64A prints a full stop and a new line.
@label=ChooseTheLineBreak_PrintStop
 $A643 LD D,$30      ; {Put #N$30 in #REGd and jump to #R$A64A.
 $A645 JR $A64A      ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$7340 }
; LIST#

; Print Character With Time Period
;
; Used by the routine at #R$A5CD.
; .
; Prints the dictionary word for the character.
;
;   D Time period value (#N$30 or #N$60)
; O:A Character code
;
; Print text token.
@label=PrintCharacterWithTimePeriod
c$A647 CALL $A887    ; Call #R$A887 to print the dictionary word.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7348 }
; LIST#

; Leave A Full Stop As The Result
;
; Used by the routine at #R$A63F.
; .
; Prints a break when bit 6 or bit 4 of the character asks for one.
@label=LeaveFullStop
c$A64A LD A,$2E      ; {Jump ahead to #R$A657 if bit 6 is present.
 $A64C BIT 6,D       ;
 $A64E JR NZ,$A657   ; }
 $A650 BIT 4,D       ; {Call #R$A9B7 to print the full stop if bit 4 of #REGd
 $A652 CALL NZ,$A9B7 ; is set.}
 $A655 BIT 4,D       ; See whether bit 4 of the character is set.
*$A657 CALL NZ,$A2A2 ; Call #R$A2A2 if bit 4 of this byte is set.
 $A65A XOR A         ; Clear #REGa.
 $A65B RET           ; Return.
; Returns to the caller without changing the result. Commands use it when there is
; nothing to do.
; .
; Control code #N$12 in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=LeaveFullStop_Return
 $A65C RET           ; Return.

; Process Text Token And Call Handler
;
; Fetches the next token and calls #R$A7BA when that pointer is not zero.
; .
; Control code #N$00 in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=ProcessTextTokenAndCallHandler
c$A65D XOR A         ; {Call #R$A66C to fetch next text token.
 $A65E LD ($A028),A  ;
 $A661 CALL $A66C    ; }
 $A664 EX DE,HL      ; {Call #R$A7BA if the pointer is not zero.
 $A665 LD A,H        ;
 $A666 OR L          ;
 $A667 CALL NZ,$A7BA ; }
 $A66A XOR A         ; Clear #REGa.
 $A66B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7367 }
; LIST#

; Fetch Next Text Token
;
; Used by the routines at #R$A65D, #R$A5C3, #R$A684, #R$A709, #R$A711, #R$A771
; and #R$A7B4.
; .
; Reads the next word from the pointer at #R$A59D into #REGde and steps that pointer on two bytes.
; .
; Control code #N$01 in the table at #R$A55D.
;
; O:DE Token value (word)
; O:F Zero flag always reset
@refs=$A5C3
@label=FetchNextTextToken
c$A66C LD HL,($A59D) ; {Read the next word from the pointer at #R$A59D into
 $A66F LD E,(HL)     ; #REGde and step it on two bytes.
 $A670 INC HL        ;
 $A671 LD D,(HL)     ;
 $A672 INC HL        ; }
 $A673 LD ($A59D),HL ; Store the pointer back at #R$A59D.
 $A676 OR %00000001  ; Reset the zero flag, with the next text token in #REGde.
 $A678 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7376 }
; LIST#

; Step The Record By Its Length
;
; Adds the word at offset #N$01, minus one, to the record pointer and returns zero.
; .
; Control code #N$02 in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
;
;   IX Record pointer
; O:IX Record pointer plus the length word, minus one
@label=StepRecordByItsLength
c$A679 LD E,(IX+$01) ; {Read the length word and subtract one.
 $A67C LD D,(IX+$02) ;
 $A67F DEC DE        ; }
 $A680 ADD IX,DE     ; Add that length to the record pointer.
; Returns zero. Control code #N$1C enters here.
@label=StepRecordByItsLength_ReturnZero
 $A682 XOR A         ; Clear #REGa.
 $A683 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$737E }
; LIST#

; Continue At The Next Token
;
; Reads the next word from the text pointer at #R$A59D and uses that address as the record
; pointer, then returns zero. The time-of-day entries from #R$A68C return when the
; period matches, and otherwise skip one token from #R$A6B2.
; .
; Control code #N$1A in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
;
; O:IX Address of the next word
@label=ContinueAtTheNextToken
c$A684 CALL $A66C    ; Call #R$A66C to fetch the next word.
 $A687 PUSH DE       ; {Use that word as the record pointer.
 $A688 POP IX        ; }
 $A68A XOR A         ; Clear #REGa.
 $A68B RET           ; Return.
; Returns when the time period is 6 AM. Any other period skips a token from
; #R$A6B2.
@label=ContinueAtTheNextToken_SixInTheMorning
 $A68C CALL $C00C    ; {Return when the time period is 6 AM (#N$05).
 $A68F CP $05        ;
 $A691 RET Z         ; }
 $A692 JR $A6B2      ; Jump to #R$A6B2 for any other period.
; Returns when the time period is morning or midday. Any other period skips a
; token.
@label=ContinueAtTheNextToken_Morning
 $A694 CALL $C00C    ; {Return when the time period is morning or midday
 $A697 CP $04        ; (#N$04).
 $A699 RET Z         ; }
 $A69A JR $A6B2      ; Jump to #R$A6B2 for any other period.
; Returns when the time period is afternoon. Any other period skips a token.
@label=ContinueAtTheNextToken_Afternoon
 $A69C CALL $C00C    ; {Return when the time period is afternoon (#N$03).
 $A69F CP $03        ;
 $A6A1 RET Z         ; }
 $A6A2 JR $A6B2      ; Jump to #R$A6B2 for any other period.
; Returns when the time period is 7 PM. Any other period skips a token.
@label=ContinueAtTheNextToken_SevenInTheEvening
 $A6A4 CALL $C00C    ; {Return when the time period is 7 PM (#N$02).
 $A6A7 CP $02        ;
 $A6A9 RET Z         ; }
 $A6AA JR $A6B2      ; Jump to #R$A6B2 for any other period.
; Returns when the time period is late at night. Any other period falls through into
; #R$A6B2.
@label=ContinueAtTheNextToken_LateAtNight
 $A6AC CALL $C00C    ; {Return when the time period is late at night (#N$01).
 $A6AF CP $01        ;
 $A6B1 RET Z         ; }
; Skips one text token and returns zero.
*$A6B2 INC IX        ; {Step on one byte and call #R$A6BB to skip the token.
 $A6B4 CALL $A6BB    ; }
 $A6B7 DEC IX        ; Step back one byte.
 $A6B9 XOR A         ; Clear #REGa.
 $A6BA RET           ; Return.

; Skip Text Token Based On Type
;
; Used by the routines at #R$A684 and #R$A6D3.
; .
; Skips a text token whose record flag says this token type is not printed.
;
;   IX Pointer to text token
; O:IX Updated pointer (skips token data)
@label=SkipTextTokenBasedOnType
c$A6BB LD A,(IX+$00) ; {Jump ahead to #R$A6CC if bit 7 of the record's flag
 $A6BE BIT 7,A       ; byte is present.
 $A6C0 JR NZ,$A6CC   ; }
 $A6C2 CP $02        ; {Go to #R$A6CA if it is #N$02.
 $A6C4 JR Z,$A6CA    ; }
 $A6C6 CP $0B        ; {Go to #R$A6CE if it is not #N$0B.
 $A6C8 JR NZ,$A6CE   ; }
@label=SkipTextTokenBasedOnType_Next
*$A6CA INC IX        ; Step to the next byte of this text token.
@label=SkipTextTokenBasedOnType_SkipPair
*$A6CC INC IX        ; Step to the next byte of this text token.
*$A6CE INC IX        ; Step to the next byte of this text token.
 $A6D0 RET           ; Return.

; Alternatives Left
;
; Count of alternatives still to print or skip.
; Used by #R$A6D3.
g$A6D1 DEFB $00

; Chosen Alternative
;
; The alternative #R$A6D3 picked at random, counted from #N$01.
; Used by #R$A6D3.
g$A6D2 DEFB $00

; Print A Random Alternative
;
; Reads how many alternatives follow, picks one at random with #R$D2A4, prints that one through #R$A5CD and skips the rest.
; .
; Control code #N$0A in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
;
; IX Pointer to text token data
@label=PrintRandomAlternative
c$A6D3 INC IX        ; {Read how many alternatives follow and keep that count.
 $A6D5 LD A,(IX+$00) ;
 $A6D8 LD ($A6D1),A  ; }
 $A6DB DEC A         ; {Pick one of them at random with #R$D2A4.
 $A6DC CALL $D2A4    ; }
 $A6DF INC A         ; {Put that choice back in the range and remember it.
 $A6E0 LD ($A6D2),A  ; }
 $A6E3 INC IX        ; Step on to the first alternative.
*$A6E5 LD A,($A6D2)  ; {Read the choice and point #REGhl at the count still
 $A6E8 LD HL,$A6D1   ; left.}
 $A6EB CP (HL)       ; {Jump ahead to #R$A6F5 if the choice differs from the
 $A6EC JR NZ,$A6F5   ; alternatives left.}
 $A6EE PUSH IX       ; {Call #R$A5CD to print this alternative.
 $A6F0 CALL $A5CD    ;
 $A6F3 POP IX        ; }
; Skip this alternative.
@label=PrintRandomAlternative_Next
*$A6F5 CALL $A6BB    ; Call #R$A6BB to skip this alternative.
 $A6F8 LD HL,$A6D1   ; {Count one fewer alternative.
 $A6FB DEC (HL)      ; }
 $A6FC JR NZ,$A6E5   ; Jump back to #R$A6E5 until none remain.
 $A6FE DEC IX        ; Step the record back one byte.
 $A700 XOR A         ; Clear #REGa.
 $A701 RET           ; Return.

; Read The Parser Workspace
;
; Loads the words the player typed and leaves a non-zero result so parsing continues.
; .
; Control code #N$03 in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=ReadParserWorkspace
c$A702 LD DE,($A00D) ; Read the parser.
 $A706 OR %00000001  ; Reset the zero flag, with the parser workspace in
                     ; #REGde.
 $A708 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$738D }
; LIST#

; Print The Next Token
;
; Fetches the next token, hands it to #R$A80E, and returns zero.
; .
; Control code #N$04 in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=PrintTheNextToken
c$A709 CALL $A66C    ; Call #R$A66C to fetch the next token.
 $A70C CALL $A80E    ; Call #R$A80E to print the token.
 $A70F XOR A         ; Clear #REGa.
 $A710 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7394 }
; LIST#

; Run A Text Token Entry
;
; Fetches the next token and calls #R$BF1C with that token as the record, then
; restores the caller's record and returns zero.
; .
; Control code #N$05 in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=RunTextTokenEntry
c$A711 PUSH IX       ; {Keep the record and call #R$A66C to fetch the next
 $A713 CALL $A66C    ; token.}
 $A716 PUSH DE       ; {Move the token into #REGix.
 $A717 POP IX        ; }
 $A719 CALL $BF1C    ; Call #R$BF1C with the token as the record.
 $A71C POP IX        ; Restore the caller's record from the stack.
 $A71E XOR A         ; Clear #REGa.
 $A71F RET           ; Return.

; Clear The Object Source
;
; Clears the object processing source flag at #R$A028 and falls through into #R$A724.
; .
; Control code #N$06 in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=ClearTheObjectSource
c$A720 XOR A         ; {Clear the object processing source flag at #R$A028.
 $A721 LD ($A028),A  ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$73A3 }
; LIST#

; Read The Character Being Processed
;
; Used by the routine at #R$A2E4.
; .
; Reads the character being processed, prints its token, and reports that this
; step failed.
@label=ReadCharacter
c$A724 LD A,($A036)  ; Read the character being processed.
 $A727 CALL $A82F    ; Call #R$A82F to process object or print token.
 $A72A XOR A         ; Clear #REGa.
 $A72B RET           ; Return.

; Check The Room Display Parameter
;
; Sets the object source flag to #N$01 and jumps to #R$A751 with the room display
; parameter in #REGa.
; .
; Control code #N$07 in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=CheckTheRoomDisplayParameter
c$A72C LD A,$01      ; {Set the object processing source flag to #N$01.
 $A72E LD ($A028),A  ; }
 $A731 LD A,($A034)  ; {Jump to #R$A751 with the room display parameter in
 $A734 JR $A751      ; #REGa.}
; View the equivalent code in;
; #LIST
; { #HOBBIT$73AF }
; LIST#

; Print The Control Character
;
; Sends the character in #REGa to #R$A9B7 and returns zero. The same three
; instructions as #R$A63A.
; .
; Control code #N$08 in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=PrintTheControlCharacter
c$A736 CALL $A9B7    ; Call #R$A9B7 to print this character.
 $A739 XOR A         ; Clear #REGa.
 $A73A RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$73BD }
; LIST#

; Check The Room Graphics Parameter
;
; Sets the object source flag to #N$01 and jumps to #R$A751 with the room graphics
; parameter in #REGa.
; .
; Control code #N$09 in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=CheckTheRoomGraphicsParameter
c$A73B LD A,$01      ; {Set the object processing source flag to #N$01.
 $A73D LD ($A028),A  ; }
 $A740 LD A,($A035)  ; {Jump to #R$A751 with the room graphics parameter in
 $A743 JR $A751      ; #REGa.}
; View the equivalent code in;
; #LIST
; { #HOBBIT$73C2 }
; LIST#

; Process Location Data If Valid
;
; Used by the routine at #R$A37D.
; .
; When the token names a room, checks that room and tells the script the test
; did not pass.
@label=ProcessLocationDataIfValid
c$A745 JR NC,$A751   ; Go to #R$A751 to check the object if the display mode is
                     ; at least #N$05.
 $A747 PUSH HL       ; {Call #R$A4AB to point at to location data plus one.
 $A748 CALL $A4AB    ; }
 $A74B CALL $A7BA    ; {Call #R$A7BA to test object attribute with flag.
 $A74E POP HL        ; }
 $A74F XOR A         ; Clear #REGa.
 $A750 RET           ; Return.

; Process Object Attribute
;
; Used by the routines at #R$A72C, #R$A73B, #R$A745 and #R$A82F.
; .
; Checks the object's flag byte and tells the script the test did not pass.
@label=ProcessObjectAttribute
c$A751 PUSH HL       ; {Call #R$A4BC to point to object attribute byte, saving
 $A752 CALL $A4BC    ; pointer.}
 $A755 CALL $A7C5    ; {Call #R$A7C5 to check object has special description.
 $A758 POP HL        ; }
 $A759 XOR A         ; Clear #REGa.
 $A75A RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$73D6 }
; LIST#

; Print Text At An Offset
;
; Adds the word at offset #N$01 to the record address, prints the text there through
; #R$A5C4, steps the record on two bytes, and returns zero.
; .
; Control code #N$0B in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=PrintTextAtAnOffset
c$A75B PUSH IX       ; {Point #REGhl at this record and read the low byte of
 $A75D POP HL        ; the offset.
 $A75E PUSH HL       ;
 $A75F LD E,(IX+$01) ; }
 $A762 LD D,(IX+$02) ; Read the high byte of the offset.
 $A765 ADD HL,DE     ; {Add the offset and call #R$A5C4 to print the text.
 $A766 CALL $A5C4    ; }
 $A769 POP IX        ; Restore the record from the stack.
 $A76B INC IX        ; Step to the next byte of the record.
 $A76D INC IX        ; Step to the next byte of the record.
 $A76F XOR A         ; Clear #REGa.
 $A770 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$73E0 }
; LIST#

; Print The Token Text
;
; Fetches the next word and, when it is not zero, prints the text it points at through
; #R$A5C4. Returns zero.
; .
; Control code #N$19 in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=PrintTheTokenText
c$A771 PUSH IX       ; {Keep the record and call #R$A66C to fetch the next
 $A773 CALL $A66C    ; word.}
 $A776 EX DE,HL      ; {Call #R$A5C4 when the word is not zero.
 $A777 LD A,L        ;
 $A778 OR H          ;
 $A779 CALL NZ,$A5C4 ; }
 $A77C POP IX        ; Restore the record from the stack.
 $A77E XOR A         ; Clear #REGa.
 $A77F RET           ; Return.

; Pronoun For This Character
;
; Reads the current character and continues at #R$A783. A zero id returns token
; #N$09F2. Any other id returns token #N$0414. Either result is non-zero, so the caller
; prints the token.
; .
; Control code #N$0C in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
;
; O:DE Pronoun token
@label=PronounForThisCharacter
c$A780 LD A,($A036)  ; Read the current character.
; This entry point is used by the routine at #R$A78E.
; .
; Returns token #N$0414 for any other character id, and token #N$09F2 for zero.
@label=PronounForThisCharacter_OtherId
*$A783 LD DE,$0414   ; {Return token #N$0414 when the id is not zero.
 $A786 AND A         ;
 $A787 RET NZ        ; }
 $A788 LD DE,$09F2   ; Take token #N$09F2.
 $A78B OR $01        ; Mark the result non-zero.
 $A78D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$73F9 }
; LIST#

; Pronoun For The Room
;
; Reads the room display parameter and joins the pronoun test at #R$A783.
; .
; Control code #N$0E in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=PronounForTheRoom
c$A78E LD A,($A034)  ; {Read the room display parameter and jump to #R$A783.
 $A791 JR $A783      ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$7407 }
; LIST#

; Describe This Character
;
; Saves the current character, clears the object source flag, and continues at
; #R$A798. That entry runs #R$A82F, then returns token #N$0485, or token #N($007A,$04,$04)
; when the character id is zero.
; .
; Control code #N$10 in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=DescribeThisCharacter
c$A793 LD A,($A036)  ; {Save the current character and clear #REGa.
 $A796 EX AF,AF'     ;
 $A797 XOR A         ; }
; This entry point is used by the routine at #R$A7AC.
; .
; Stores the object source flag, runs #R$A82F, and returns the description
; token.
@label=DescribeThisCharacter_StoredFlag
*$A798 LD ($A028),A  ; Store #REGa in the object processing source flag.
 $A79B EX AF,AF'     ; {Keep the character id aside.
 $A79C PUSH AF       ; }
 $A79D CALL $A82F    ; Call #R$A82F.
 $A7A0 POP AF        ; Restore the saved character from the stack.
 $A7A1 AND A         ; {Return token #N$0485 when the character id is not zero.
 $A7A2 LD DE,$0485   ;
 $A7A5 RET NZ        ; }
 $A7A6 LD DE,$007A   ; Take token #N($007A,$04,$04).
 $A7A9 OR $01        ; Mark the result non-zero.
 $A7AB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$740C }
; LIST#

; Describe The Displayed Room
;
; Reads the room display parameter and continues at #R$A7AF, which sets the object
; source flag to #N$01 and joins #R$A798, the same description #R$A793 prints.
; .
; Control code #N$11 in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=DescribeTheDisplayedRoom
c$A7AC LD A,($A034)  ; Read the room display parameter.
; This entry point is used by the routine at #R$A7B4.
; .
; Saves the value, sets the object source flag, and joins #R$A798.
@label=DescribeTheDisplayedRoom_SetFlag
*$A7AF EX AF,AF'     ; {Save the value, set the object source flag to #N$01,
 $A7B0 LD A,$01      ; and jump to #R$A798.
 $A7B2 JR $A798      ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$7425 }
; LIST#

; Describe The Next Token
;
; Fetches the next token and joins #R$A7AF with the token's high byte in #REGa.
; #R$A798 then describes that value the same way #R$A793 describes the character.
; .
; Control code #N$13 in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
;
; O:A High byte of the token
@label=DescribeTheNextToken
c$A7B4 CALL $A66C    ; Call #R$A66C to fetch the next token.
 $A7B7 LD A,D        ; {Take the high byte of the token and jump to #R$A7AF.
 $A7B8 JR $A7AF      ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$742D }
; LIST#

; Check Object Attribute With Flag
;
; Used by the routines at #R$A65D and #R$A745.
; .
; The same sequence as #R$A7C5. Keeps the schedule entry, points #REGiy at the
; object, and calls #R$D405 to test the object's attribute flag.
;
; HL Object pointer
@label=CheckObjectAttributeWithFlag_Wrapper
c$A7BA PUSH IY       ; Save the schedule entry.
 $A7BC PUSH HL       ; {Copy the object pointer from #REGhl into #REGiy.
 $A7BD POP IY        ; }
 $A7BF CALL $D405    ; Call #R$D405 to check the object attribute.
 $A7C2 POP IY        ; Restore the saved schedule entry from the stack.
 $A7C4 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7434 }
; LIST#

; Check Object Has Special Description
;
; Used by the routine at #R$A751.
; .
; The same sequence as #R$A7BA. Keeps the schedule entry, points #REGiy at the
; object, and calls #R$D3E8 to test the special-description flag.
;
; HL Object pointer
@label=CheckObjectHasSpecialDescription_Wrapper
c$A7C5 PUSH IY       ; Save the schedule entry.
 $A7C7 PUSH HL       ; {Copy the object pointer from #REGhl into #REGiy.
 $A7C8 POP IY        ; }
 $A7CA CALL $D3E8    ; Call #R$D3E8 to check if the object has a special
                     ; description (bit 6).
 $A7CD POP IY        ; Restore the saved schedule entry from the stack.
 $A7CF RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7434 }
; LIST#

; Check Token Match And Set Flag
;
; Used by the routines at #R$A80E, #R$D3E8 and #R$D405.
; .
; Compares the token with the text and sets the match flag.
;
; DE Token value to check
@label=CheckTokenMatchAndSetFlag
c$A7D0 XOR A         ; {Clear the token match flag at #R$A7EA.
 $A7D1 LD ($A7EA),A  ; }
 $A7D4 BIT 7,D       ; {Jump ahead to #R$A7EB if bit 7 of #REGd is clear.
 $A7D6 JR Z,$A7EB    ; }
 $A7D8 LD A,E        ; {Load #N$09EE and go to #R$A7E4 if the low byte of the
 $A7D9 LD HL,$09EE   ; token is not #N$EE.
 $A7DC CP L          ;
 $A7DD JR NZ,$A7E4   ; }
 $A7DF LD A,D        ; Read the high byte of the token.
 $A7E0 AND %00001111 ; Take the dictionary page (the low nibble of the token's
                     ; high byte) to compare with the #N$09 of token #N$09EE.
 $A7E2 CP H          ; See whether the two values match.
 $A7E3 RET Z         ; Return if they match.
@label=CheckTokenMatchAndSetFlag_Next
*$A7E4 LD A,$01      ; {Write #N$01 to the token match flag at #R$A7EA.
 $A7E6 LD ($A7EA),A  ; }
 $A7E9 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$743F }
; LIST#

; Token Match Flag
;
; Cleared by #R$A7D0, then set when the token is not the special match. #R$D3E8 clears it again unless bit 6 of the record is set, and #R$A815 folds it into the token format flag.
; Used by #R$A7D0, #R$A815 and #R$D3E8.
g$A7EA DEFB $00

; Print Token Based On Parameters
;
; Used by the routine at #R$A7D0.
; .
; Picks the token word table from the print mode and shifts the token parameter
; into place.
;
; D Token parameter
@label=PrintTokenBasedOnParameters
c$A7EB LD HL,$A24D   ; {Point #REGhl at the token table and read the print mode
 $A7EE LD A,($A027)  ; into #REGe.
 $A7F1 LD E,A        ; }
 $A7F2 LD A,($A2AA)  ; Read the object display flag.
 $A7F5 OR E          ; Merge in the print mode, so both can be tested for zero
                     ; at once.
 $A7F6 JR Z,$A7FB    ; Jump ahead to #R$A7FB if the object display flag and the
                     ; print mode are both zero.
 $A7F8 LD HL,$A255   ; Point #REGhl at the other half of the token table.
*$A7FB LD A,D        ; {Shift the token parameter in #REGd down by three bits.
 $A7FC RRCA          ;
 $A7FD RRCA          ;
 $A7FE RRCA          ; }
 $A7FF AND %00011110 ; Turn the shifted parameter into an even offset into the
                     ; token word table.
 $A801 PUSH DE       ; {Save #REGde, index the token table by the shifted
 $A802 LD E,A        ; parameter and read that word into #REGde.
 $A803 LD D,$00      ;
 $A805 ADD HL,DE     ;
 $A806 LD E,(HL)     ;
 $A807 INC HL        ;
 $A808 LD D,(HL)     ; }
 $A809 CALL $A887    ; Call #R$A887 to print the token.
 $A80C POP DE        ; Restore #REGde from the stack.
 $A80D RET           ; Return.

; Process Text Token With Attributes
;
; Used by the routine at #R$A709.
; .
; Checks whether this token matches, then keeps the dictionary page of the
; following word.
;
; DE Token value
@label=ProcessTextTokenWithAttributes
c$A80E PUSH DE       ; {Call #R$A7D0 to compare the token and set the match
 $A80F CALL $A7D0    ; flag.
 $A812 POP DE        ; }
 $A813 LD A,$50      ; Use #N$50 for the attribute.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7478 }
; LIST#

; Read The High Byte Of The Token
;
; Used by the routines at #R$D416 and #R$D427.
; .
; Keeps the low digit of the token and folds it into the dictionary page.
c$A815 PUSH AF       ; {Keep the token and take its high byte.
 $A816 LD A,D        ; }
 $A817 AND %00001111 ; Keep the dictionary page (the low nibble of the token's
                     ; high byte).
 $A819 LD D,A        ; Keep the low digit of the token in #REGd.
 $A81A POP AF        ; Restore the saved result from the stack.
 $A81B OR D          ; Set the bits from #REGd.
 $A81C LD D,A        ; Fold the saved token bits back into #REGd.
 $A81D AND %00001111 ; Keep the dictionary page of the folded token, ready to
                     ; test the whole token.
 $A81F OR E          ; Fold in the low byte of the token, so the zero flag
                     ; shows an empty token.
 $A820 RET Z         ; Return if the folded token is zero.
; Print text token.
 $A821 CALL $A887    ; Call #R$A887 to print the dictionary word.
 $A824 LD A,($A7EA)  ; {Read the token match flag at #R$A7EA and point #REGhl
 $A827 PUSH HL       ; at the token format flag at #R$A026.
 $A828 LD HL,$A026   ; }
 $A82B OR (HL)       ; Set the bits from *#REGhl.
 $A82C LD (HL),A     ; Store the result at the pointer.
 $A82D POP HL        ; Restore the text pointer from the stack.
 $A82E RET           ; Return.

; Process Object Or Print Token
;
; Used by the routines at #R$A724 and #R$A793.
; .
; See whether the text byte is the end marker, then print the dictionary word.
;
; A Object ID (FF = print token)
@label=ProcessObjectOrPrintToken
c$A82F CP $FF        ; {Jump back to #R$A751 while the object is not the end
 $A831 JP NZ,$A751   ; marker.}
 $A834 LD DE,$080E   ; {Take token #N$080E and print it from #R$A887.
 $A837 JP $A887      ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$7488 }
; LIST#

; Get Common Word And Process
;
; Used by the routine at #R$A5F2.
; .
; Looks the common word up and prints it.
@label=GetCommonWordAndProcess
c$A83A CALL $A840    ; {Look the word up at #R$A840 and continue from #R$A5EA.
 $A83D JP $A5EA      ; }

; Get Common Word
;
; Used by the routines at #R$A83A and #R$B77F.
; .
; Turns a vocabulary code into the dictionary address of that word.
;
; A Letter reference
; DE Common word address
@label=GetCommonWord
c$A840 SUB $60       ; {Use the common words at #R$67B7.
 $A842 LD E,A        ;
 $A843 LD D,$00      ;
 $A845 LD HL,$67B7   ; }
 $A848 ADD HL,DE     ; {Point at word #REGde of the common-word table at
 $A849 ADD HL,DE     ; #R$67B7.}
 $A84A LD E,(HL)     ; Fetch the LSB of the dictionary address and store it in
                     ; #REGe.
 $A84B INC HL        ; {Fetch the MSB of the dictionary address, add #N$50 and
 $A84C LD A,(HL)     ; store it in #REGd.
 $A84D ADD A,$50     ;
 $A84F LD D,A        ; }
 $A850 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7493 }
; LIST#

; Lowercase Handling Flag
;
; Lowercase Handling Flag read by #R$A852 and #R$AA14.
@label=LowercaseHandlingFlag
g$A851 DEFB $00

; Toggle Lowercase Handling
;
; Toggles whether the next word is printed in capitals.
; .
; Control code #N$1B in the table at #R$A55D.
; .
; Used by the routine at #R$A5C3.
@label=ToggleLowercaseHandling
c$A852 LD A,($A851)  ; {Read the lowercase handling flag and store it in the lowercase handling
 $A855 XOR $01       ; flag.
 $A857 LD ($A851),A  ; }
 $A85A XOR A         ; Clear #REGa.
 $A85B RET           ; Return.

; Table: Format Data
;
; Format data entries indexed by format type (#N$00-#N$08).
; Each entry is #N$04 bytes that are copied to the format buffer.
; Read by #R$A92F.
;
; .
;
; Format type #N((#PC-$A85C)/$04):
@label=Table_FormatData
g$A85C DEFB $53      ; {Format data bytes:
 $A85D DEFB $00      ; #TABLE(default,centre,centre,centre,centre)
 $A85E DEFB $00      ; { =h Position | =h Command or Data | =h Command Type | =h Parameter/ Data }
 $A85F DEFB $00      ; { =h Byte | =h Bit 7 | =h Bits 4-6 | =h Bits 0-3 }
                     ; #FOR$00,$03(x,{ #N((#PC+x-$A85C)%$04) | #IF(#PEEK(#PC+x)&$80)(Command,Data) | #N((#PEEK(#PC+x)&$70)>>$04) | #N(#PEEK(#PC+x)&$0F) })
                     ; TABLE#}
; Format type #N((#PC-$A85C)/$04):
 $A860 DEFB $45      ; {Format data bytes:
 $A861 DEFB $53      ; #TABLE(default,centre,centre,centre,centre)
 $A862 DEFB $00      ; { =h Position | =h Command or Data | =h Command Type | =h Parameter/ Data }
 $A863 DEFB $00      ; { =h Byte | =h Bit 7 | =h Bits 4-6 | =h Bits 0-3 }
                     ; #FOR$00,$03(x,{ #N((#PC+x-$A85C)%$04) | #IF(#PEEK(#PC+x)&$80)(Command,Data) | #N((#PEEK(#PC+x)&$70)>>$04) | #N(#PEEK(#PC+x)&$0F) })
                     ; TABLE#}
; Format type #N((#PC-$A85C)/$04):
 $A864 DEFB $49      ; {Format data bytes:
 $A865 DEFB $45      ; #TABLE(default,centre,centre,centre,centre)
 $A866 DEFB $53      ; { =h Position | =h Command or Data | =h Command Type | =h Parameter/ Data }
 $A867 DEFB $00      ; { =h Byte | =h Bit 7 | =h Bits 4-6 | =h Bits 0-3 }
                     ; #FOR$00,$03(x,{ #N((#PC+x-$A85C)%$04) | #IF(#PEEK(#PC+x)&$80)(Command,Data) | #N((#PEEK(#PC+x)&$70)>>$04) | #N(#PEEK(#PC+x)&$0F) })
                     ; TABLE#}
; Format type #N((#PC-$A85C)/$04):
 $A868 DEFB $08      ; {Format data bytes:
 $A869 DEFB $49      ; #TABLE(default,centre,centre,centre,centre)
 $A86A DEFB $45      ; { =h Position | =h Command or Data | =h Command Type | =h Parameter/ Data }
 $A86B DEFB $53      ; { =h Byte | =h Bit 7 | =h Bits 4-6 | =h Bits 0-3 }
                     ; #FOR$00,$03(x,{ #N((#PC+x-$A85C)%$04) | #IF(#PEEK(#PC+x)&$80)(Command,Data) | #N((#PEEK(#PC+x)&$70)>>$04) | #N(#PEEK(#PC+x)&$0F) })
                     ; TABLE#}
; Format type #N((#PC-$A85C)/$04):
 $A86C DEFB $44      ; {Format data bytes:
 $A86D DEFB $00      ; #TABLE(default,centre,centre,centre,centre)
 $A86E DEFB $00      ; { =h Position | =h Command or Data | =h Command Type | =h Parameter/ Data }
 $A86F DEFB $00      ; { =h Byte | =h Bit 7 | =h Bits 4-6 | =h Bits 0-3 }
                     ; #FOR$00,$03(x,{ #N((#PC+x-$A85C)%$04) | #IF(#PEEK(#PC+x)&$80)(Command,Data) | #N((#PEEK(#PC+x)&$70)>>$04) | #N(#PEEK(#PC+x)&$0F) })
                     ; TABLE#}
; Format type #N((#PC-$A85C)/$04):
 $A870 DEFB $49      ; {Format data bytes:
 $A871 DEFB $4E      ; #TABLE(default,centre,centre,centre,centre)
 $A872 DEFB $47      ; { =h Position | =h Command or Data | =h Command Type | =h Parameter/ Data }
 $A873 DEFB $00      ; { =h Byte | =h Bit 7 | =h Bits 4-6 | =h Bits 0-3 }
                     ; #FOR$00,$03(x,{ #N((#PC+x-$A85C)%$04) | #IF(#PEEK(#PC+x)&$80)(Command,Data) | #N((#PEEK(#PC+x)&$70)>>$04) | #N(#PEEK(#PC+x)&$0F) })
                     ; TABLE#}
; Format type #N((#PC-$A85C)/$04):
 $A874 DEFB $45      ; {Format data bytes:
 $A875 DEFB $44      ; #TABLE(default,centre,centre,centre,centre)
 $A876 DEFB $00      ; { =h Position | =h Command or Data | =h Command Type | =h Parameter/ Data }
 $A877 DEFB $00      ; { =h Byte | =h Bit 7 | =h Bits 4-6 | =h Bits 0-3 }
                     ; #FOR$00,$03(x,{ #N((#PC+x-$A85C)%$04) | #IF(#PEEK(#PC+x)&$80)(Command,Data) | #N((#PEEK(#PC+x)&$70)>>$04) | #N(#PEEK(#PC+x)&$0F) })
                     ; TABLE#}
; Format type #N((#PC-$A85C)/$04):
 $A878 DEFB $08      ; {Format data bytes:
 $A879 DEFB $49      ; #TABLE(default,centre,centre,centre,centre)
 $A87A DEFB $4E      ; { =h Position | =h Command or Data | =h Command Type | =h Parameter/ Data }
 $A87B DEFB $47      ; { =h Byte | =h Bit 7 | =h Bits 4-6 | =h Bits 0-3 }
                     ; #FOR$00,$03(x,{ #N((#PC+x-$A85C)%$04) | #IF(#PEEK(#PC+x)&$80)(Command,Data) | #N((#PEEK(#PC+x)&$70)>>$04) | #N(#PEEK(#PC+x)&$0F) })
                     ; TABLE#}
; Format type #N((#PC-$A85C)/$04):
 $A87C DEFB $4C      ; {Format data bytes:
 $A87D DEFB $59      ; #TABLE(default,centre,centre,centre,centre)
 $A87E DEFB $00      ; { =h Position | =h Command or Data | =h Command Type | =h Parameter/ Data }
 $A87F DEFB $00      ; { =h Byte | =h Bit 7 | =h Bits 4-6 | =h Bits 0-3 }
                     ; #FOR$00,$03(x,{ #N((#PC+x-$A85C)%$04) | #IF(#PEEK(#PC+x)&$80)(Command,Data) | #N((#PEEK(#PC+x)&$70)>>$04) | #N(#PEEK(#PC+x)&$0F) })
                     ; TABLE#}

; Extract Token From Text
;
; Used by the routines at #R$A37D and #R$D5D3.
; .
; Reads the next dictionary token from the message and keeps its low digit as
; the page.
;
;   HL Pointer to text data
; O:DE Token value (word)
; O:HL Updated pointer
;
; Read the token value from the text data.
@label=ExtractTokenFromText
c$A880 LD E,(HL)     ; {Read this message byte and the one after it.
 $A881 INC HL        ;
 $A882 LD A,(HL)     ;
 $A883 INC HL        ; }
 $A884 AND %00001111 ; Keep only bits 0-3 (extract the low nibble from the
                     ; second byte).
 $A886 LD D,A        ; Keep the low digit as the dictionary page.
; View the equivalent code in;
; #LIST
; { #HOBBIT$74BA }
; LIST#

; Print A Dictionary Word
;
; Used by the routines at #R$A2E4, #R$A37D, #R$A5EA, #R$A647, #R$A7EB, #R$A815,
; #R$A82F, #R$BF1C, #R$CB7B, #R$D113, #R$D526, #R$D5D3, #R$D60B and #R$D68C.
; .
; Prints a space and the dictionary word when the dictionary flag is set, and returns at once
; when that flag is clear.
@label=PrintTextToken
c$A887 LD A,($5C3C)  ; {Return if *#SKOOLKID$5C3C(TV_FLAG) is not set.
 $A88A AND A         ;
 $A88B RET Z         ; }
 $A88C LD ($A022),DE ; Write #REGde (the token value) to *#R$A022.
 $A890 LD A,D        ; Read the high byte of the token.
 $A891 AND %00001111 ; Keep only bits 0-3 (ensure we have just the low nibble).
 $A893 OR E          ; Set the bits from #REGe (merge with the first byte).
 $A894 RET Z         ; Return if both token digits are zero.
 $A895 PUSH IX       ; {Save the character record, the pointer, the count and
 $A897 PUSH HL       ; the source.
 $A898 PUSH BC       ;
 $A899 PUSH DE       ; }
; Process the token format and prepare for dictionary lookup.
 $A89A LD A,$20      ; Use #N$20 for the character code.
 $A89C CALL $A9B7    ; Print the character in #REGa through #R$A9B7.
 $A89F LD A,D        ; Read the high byte of the token.
 $A8A0 AND %11110000 ; Keep only bits 4-7 (extract the high nibble).
 $A8A2 LD C,A        ; Store the result in the low byte of the count.
 $A8A3 CP $70        ; See whether this byte is a dictionary word.
; Prepare to set a flag if the token format is #N$70.
 $A8A5 LD A,$01      ; {Load #N$01 and jump ahead to #R$A8AC unless the high
 $A8A7 JR NZ,$A8AC   ; nibble is #N$70.}
 $A8A9 LD ($A026),A  ; Record the token format flag.
@label=PrintTextToken_ProcessToken
*$A8AC LD A,D        ; Read the high byte of the token.
 $A8AD AND %00001111 ; Keep only bits 0-3 (extract the low nibble).
 $A8AF LD D,A        ; Store the result in the high byte of the source.
 $A8B0 EX DE,HL      ; Move the token into #REGhl so its high byte can be
                     ; merged with the format bits.
 $A8B1 PUSH HL       ; {Read the high byte of the pointer, saving pointer.
 $A8B2 LD A,H        ; }
 $A8B3 OR C          ; Set the bits from #REGc (merge with the format bits).
 $A8B4 LD H,A        ; Keep the high byte of this token.
 $A8B5 LD ($A022),HL ; Write #REGhl (the modified token) to *#R$A022.
 $A8B8 POP HL        ; Restore the saved pointer from the stack.
 $A8B9 PUSH BC       ; Use the dictionary index at #R$5D80, saving count and.
; Search the dictionary index table for the token value.
 $A8BA LD IX,$5D80   ;
 $A8BE LD B,$5F      ;
@label=PrintTextToken_SearchLoop
*$A8C0 INC B         ; {Count this dictionary entry and keep searching when it
 $A8C1 LD A,(IX+$01) ; is still below the token.
 $A8C4 CP H          ;
 $A8C5 JR C,$A8CF    ; }
 $A8C7 JR NZ,$A8D9   ; Jump to #R$A8D9 when this entry is past the token.
 $A8C9 LD A,(IX+$00) ; {Compare the low byte and jump to #R$A8D9 when the entry
 $A8CC CP L          ; has reached the token.
 $A8CD JR NC,$A8D9   ; }
@label=PrintTextToken_ContinueSearch
*$A8CF INC IX        ; {Step to the next dictionary entry and keep searching
 $A8D1 INC IX        ; until #N$7B entries have been tried.
 $A8D3 LD A,B        ;
 $A8D4 CP $7B        ;
 $A8D6 JR NZ,$A8C0   ; }
 $A8D8 INC B         ; Count another dictionary entry.
@label=PrintTextToken_FoundEntry
*$A8D9 JR Z,$A8E0    ; Go to #R$A8E0 if the count wrapped to zero.
@label=PrintTextToken_BackupEntry
*$A8DB DEC IX        ; {Step back one dictionary entry.
 $A8DD DEC IX        ;
 $A8DF DEC B         ; }
@label=PrintTextToken_GetWordAddress
*$A8E0 LD E,(IX+$00) ; {Read the word address at the start of the record.
 $A8E3 LD D,(IX+$01) ; }
 $A8E6 LD A,D        ; {Jump back to #R$A8DB when the word address is still
 $A8E7 OR E          ; zero.
 $A8E8 JR Z,$A8DB    ; }
; Print the next letter of this dictionary word.
 $A8EA LD A,B        ; Take the count.
 $A8EB CALL $A9B7    ; Print the character in #REGa through #R$A9B7.
 $A8EE LD BC,$5DBF   ; {Take the dictionary index and swap the two pointers.
 $A8F1 ADD HL,BC     ;
 $A8F2 PUSH HL       ;
 $A8F3 EX DE,HL      ;
 $A8F4 ADD HL,BC     ; }
@label=PrintTextToken_PrintWordContinue
*$A8F5 PUSH HL       ; {Compare #REGhl with #REGde, keeping #REGhl, and save
@label=PrintTextToken_PrintWordLoop
 $A8F6 AND A         ; the result flags.
 $A8F7 SBC HL,DE     ;
 $A8F9 POP HL        ;
 $A8FA PUSH AF       ; }
 $A8FB CALL $A95B    ; Call #R$A95B to read the next format byte.
 $A8FE POP AF        ; Restore the comparison flags from the stack.
 $A8FF JR NZ,$A8F5   ; {. Jump back to #R$A8F5 while the two pointers differ,
 $A901 POP HL        ; and drop the saved pointers when they match.
 $A902 POP BC        ; }
; Handle special token format cases.
 $A903 LD A,C        ; {Jump to #R$A91C when the format byte is #N$50.
 $A904 CP $50        ;
 $A906 JR Z,$A91C    ; }
 $A908 CP $40        ; {Jump to #R$A919 when the format byte is #N$40.
 $A90A JR Z,$A919    ; }
 $A90C CP $10        ; {Load the room display parameter and jump ahead to
 $A90E LD A,($A034)  ; #R$A916 if the format byte is #N$10.
 $A911 JR Z,$A916    ; }
 $A913 LD A,($A036)  ; Load #REGa with *#R$A036.
@label=PrintTextToken_Format_TestCharacterBeingProcessed
*$A916 AND A         ; {Jump ahead to #R$A91C if the character being processed
 $A917 JR Z,$A91C    ; is zero.}
@label=PrintTextToken_ProcessFormat
*$A919 CALL $A92F    ; Call #R$A92F to handle the token format.
@label=PrintTextToken_PrintRemainingText
*$A91C LD HL,$5C42   ; #REGhl=#SKOOLKID$5C42(NEWPPC).
@label=PrintTextToken_PrintLoop
*$A91F LD A,(HL)     ; Load a byte from *#SKOOLKID$5C42(NEWPPC).
 $A920 AND A         ; {Jump ahead to #R$A929 if this byte is zero.
 $A921 JR Z,$A929    ; }
 $A923 CALL $A9B7    ; Print the character in #REGa through #R$A9B7.
 $A926 INC HL        ; {Step to the next letter and go back to #R$A91F.
 $A927 JR $A91F      ; }
; Return.
; .
; All text printed - restore registers and return.
@label=PrintTextToken_End
*$A929 POP DE        ; {Restore the saved source, the saved count, the saved
 $A92A POP BC        ; pointer and the saved character record from the stack.
 $A92B POP HL        ;
 $A92C POP IX        ; }
 $A92E RET           ; Return.

; Process Text Token Format
;
; Used by the routines at #R$A887 and #R$A94D.
; .
; Reads the format byte and copies its four data bytes into the buffer,
; stopping when the type is #N$0F.
;
; IX Buffer pointer (where to write format data)
; HL Pointer to token format byte
;
; Extract the format type and copy format data to the buffer.
@label=ProcessTextTokenFormat
c$A92F LD A,(HL)     ; Read the format byte.
 $A930 AND %00001111 ; Extract the format type.
 $A932 CP $0F        ; {Return when the format type is #N$0F.
 $A934 RET Z         ; }
; Calculate the table offset for this format type (multiply by 4).
 $A935 RLCA          ; {Multiply by #N$04 to get the table offset.
 $A936 RLCA          ; }
 $A937 LD L,A        ; {Set #REGhl to the offset value (#REGl=#REGa,
 $A938 LD H,$00      ; #REGh=#N$00).}
 $A93A LD BC,$A85C   ; {Use the format data at #R$A85C.
 $A93D ADD HL,BC     ;
 $A93E LD B,$04      ; }
@label=ProcessTextTokenFormat_CopyLoop
*$A940 LD A,(HL)     ; {Store the record's flag byte.
 $A941 INC HL        ;
 $A942 LD (IX+$00),A ;
 $A945 INC IX        ; }
 $A947 DJNZ $A940    ; Count the next character of the message and repeat from
                     ; #R$A940.
 $A949 LD (IX+$00),B ; Write #REGb (#N$04, the terminator) to *#REGix+#N$00.
 $A94C RET           ; Return.

; Handle Nested Format Processing Recursive Call
;
; Used by the routine at #R$D9C5.
; .
; Handles one nested format byte, then continues with the format that enclosed
; it.
;
; .
;
; Handle nested format processing (recursive call).
c$A94D PUSH IX       ; {Save the character record and the pointer.
 $A94F PUSH HL       ; }
 $A950 CALL $A95B    ; Call #R$A95B to read the next format byte.
 $A953 EX (SP),HL    ; Swap in the saved pointer.
 $A954 CALL $A92F    ; Call #R$A92F to handle the token format.
 $A957 POP HL        ; {Restore the saved pointer and the saved character
 $A958 POP IX        ; record from the stack.}
 $A95A RET           ; Return.

; Process Format Data Byte
;
; Used by the routines at #R$A887 and #R$A94D.
; .
; Reads the next format byte and skips the extra bytes when its top bit is set.
;
;   HL Pointer to format data byte
; O:A Result value
; O:F Zero flag set if end of format reached
@label=ProcessFormatDataByte
c$A95B PUSH BC         ; {#REGix=#SKOOLKID$5C42(NEWPPC), saving the count.
 $A95C LD IX,$5C42     ; }
; Read and process the format data byte.
 $A960 INC HL          ; {Step to the format byte and go to #R$A969 if bit 7 is
 $A961 LD A,(HL)       ; clear.
 $A962 BIT 7,A         ;
 $A964 INC HL          ;
 $A965 JR Z,$A969      ; }
 $A967 INC HL          ; {Step on two places.
 $A968 INC HL          ; }
@label=ProcessFormatDataByte_ProcessBits
*$A969 PUSH AF         ; Keep the format byte.
 $A96A AND %01110000   ; Keep bits 4-6, which name the format command.
 $A96C JR Z,$A974      ; Jump ahead to #R$A974 when the format command is
                       ; empty.
; Adjust the buffer pointer based on the command type.
@label=ProcessFormatDataByte_AdjustBuffer
*$A96E INC IX          ; {Jump back to #R$A96E while at least #N$10 is still
 $A970 SUB $10         ; left.
 $A972 JR NZ,$A96E     ; }
@label=ProcessFormatDataByte_ProcessLowNibble
*$A974 LD C,$00        ; Reset the count in #REGc.
 $A976 POP AF          ; Restore the format byte from the stack.
 $A977 AND %00001111   ; Keep only bits 0-3 (extract the low nibble).
 $A979 JR Z,$A986      ; Go to #R$A986 if the low four bits are clear.
@label=ProcessFormatDataByte_ProcessLoop
 $A97B LD B,A          ; Use the low digit as the repeat count.
@label=ProcessFormatDataByte_ProcessCommand
*$A97C CALL $A990      ; Call #R$A990 to unpack the next letter.
 $A97F LD (IX+$00),A   ; Write #REGa (the processed value) to *#REGix+#N$00.
 $A982 INC IX          ; Step the text pointer on one byte.
 $A984 DJNZ $A97C      ; Count the next entry and repeat from #R$A97C.
@label=ProcessFormatDataByte_End
*$A986 LD (IX+$00),$00 ; Write #N$00 (terminator) to *#REGix+#N$00.
 $A98A LD A,C          ; Take the bit offset from #REGc.
 $A98B POP BC          ; Restore #REGbc from the stack.
 $A98C AND A           ; {Return if the bit offset is zero.
 $A98D RET Z           ; }
 $A98E INC HL          ; Step to the next byte of the format data.
 $A98F RET             ; Return.

; Rotate And Extract Character Code
;
; Used by the routines at #R$A5F2, #R$A95B and #R$B77F.
; .
; Unpacks the next character code from the bit-packed dictionary word.
;
;   HL Pointer to bit-packed character data
;   C Rotation count (bit offset within the data)
; O:A Character code (#N$60-#N$7F)
; O:C Updated rotation count
@label=RotateAndExtractCharacterCode
c$A990 PUSH DE       ; Read the word at #REGhl into #REGde with the bytes
                     ; swapped, and jump to #R$A9A0 if #REGc is zero.
; Read two bytes from the bit-packed data.
 $A991 LD D,(HL)     ;
 $A992 INC HL        ;
 $A993 LD E,(HL)     ;
 $A994 DEC HL        ;
 $A995 LD A,C        ;
 $A996 AND A         ;
 $A997 JR Z,$A9A0    ;
; Rotate the two bytes left by the rotation count.
@label=RotateAndExtractCharacterCode_RotateLoop
*$A999 SLA E         ; {Move the packed character one bit and repeat from #R$A999 until the bit
 $A99B RL D          ; offset is used up.
 $A99D DEC A         ;
 $A99E JR NZ,$A999   ; }
; Update the rotation count for the next character extraction.
@label=RotateAndExtractCharacterCode_UpdateRotation
*$A9A0 LD A,C        ; {Jump ahead to #R$A9AA if the rotation count plus #N$05
 $A9A1 ADD A,$05     ; is still below #N$08.
 $A9A3 CP $08        ;
 $A9A5 JR C,$A9AA    ; }
 $A9A7 SUB $08       ; {Drop #N$08 from the count and step to the next
 $A9A9 INC HL        ; character.}
@label=RotateAndExtractCharacterCode_Extract
*$A9AA LD C,A        ; Store the result in the low byte of the count.
 $A9AB LD A,D        ; Read the high byte of the token.
 $A9AC POP DE        ; Restore the saved source from the stack.
; Extract the 5-bit character code from the rotated byte.
 $A9AD RRCA          ; Move the bottom bit of the result up to the top.
 $A9AE RRCA          ; Move the bottom bit of the result up to the top.
 $A9AF RRCA          ; Move the bottom bit of the result up to the top.
 $A9B0 AND %00011111 ; Keep only bits 0-4 (extract the 5-bit character code).
 $A9B2 ADD A,$60     ; Advance the result by #N$60.
 $A9B4 RET           ; Return.

; Word Buffer Pointer
;
; Pointer into the word buffer at #R$5C0B. Read and written by #R$A9B7; reset to
; #R$5C0B by #R$A9F6 after the buffered word is printed.
@label=BufferPointer
g$A9B5 DEFW $5C0B

; Print Character
;
; Used by the routines at #R$A2A2, #R$A414, #R$A419, #R$A45E, #R$A469, #R$A480,
; #R$A490, #R$A5F2, #R$A63A, #R$A64A, #R$A736, #R$A887, #R$BBE5, #R$D187,
; #R$D526, #R$D6C1, #R$D8AD, #R$D95C, #R$D968, #R$D978, #R$D99E, #R$D9B7,
; #R$DF5B and #R$E691.
; .
; In word-wrap mode, stores each letter at *#R$A9B5 in the word buffer at #R$5C0B
; until a space, newline or quote, then prints the buffered word. When the print mode
; flag at #R$A027 is set, uses the alternate printer instead.
;
; A Character code to print
@label=Print_Character
c$A9B7 PUSH AF       ; {Jump ahead to #R$AA10 if the print mode flag at #R$A027
 $A9B8 LD A,($A027)  ; is not zero.
 $A9BB AND A         ;
 $A9BC JR NZ,$AA10   ; }
; Handle word-wrap mode - write the character into the word buffer.
 $A9BE POP AF        ; {Read the word buffer pointer from *#R$A9B5.
 $A9BF PUSH AF       ;
 $A9C0 PUSH HL       ;
 $A9C1 LD HL,($A9B5) ; }
 $A9C4 CP $20        ; {Jump ahead to #R$A9DF if the character is a space.
 $A9C6 JR Z,$A9DF    ; }
 $A9C8 CP $0D        ; {Jump ahead to #R$A9DF if the character is a new line.
 $A9CA JR Z,$A9DF    ; }
 $A9CC CP $22        ; {Jump ahead to #R$A9DF if the character is a quotation
 $A9CE JR Z,$A9DF    ; mark.}
 $A9D0 CP $08        ; {Jump ahead to #R$A9D7 if the character is not a
 $A9D2 JR NZ,$A9D7   ; backspace.}
; The character IS a backspace, so handle this.
 $A9D4 DEC HL        ; {Step the word buffer pointer back and join #R$A9D9 to
 $A9D5 JR $A9D9      ; store it.}
; Write the character into the word buffer and move the pointer on.
; .
; Write the character to the word buffer.
@label=Print_Character_WriteToBuffer
*$A9D7 LD (HL),A     ; Write the character to the word buffer.
 $A9D8 INC HL        ; Increment the word buffer pointer by one.
@label=Print_Character_UpdateBufferPointer
*$A9D9 LD ($A9B5),HL ; Write the word buffer pointer back to *#R$A9B5.
 $A9DC POP HL        ; {Restore the saved pointer and the saved result from the
 $A9DD POP AF        ; stack.}
 $A9DE RET           ; Return.
; The character ends a word. If the word buffer holds letters, print them.
; .
; Flush the word buffer when it is not empty.
@label=Print_Character_ScreenPrintMode
*$A9DF PUSH DE       ; {Jump to #R$AA0B if the word buffer is empty.
 $A9E0 LD DE,$5C0B   ;
 $A9E3 AND A         ;
 $A9E4 SBC HL,DE     ;
 $A9E6 JR Z,$AA0B    ; }
 $A9E8 LD A,($C1F5)  ; Read the screen width.
 $A9EB CP L          ; Compare *#R$C1F5 with #REGl (the buffered word length).
 $A9EC PUSH AF       ; {Go to #R$A9F4 if the word fits on the line.
 $A9ED JR NC,$A9F4   ; }
 $A9EF LD A,$0D      ; Take a new line.
 $A9F1 CALL $AA14    ; Call #R$AA14 to print one character and remember the
                     ; line.
; Print the buffered letters from #R$5C0B and reset the word buffer pointer.
@label=Print_Character_ScrollScreen
*$A9F4 PUSH BC       ; {Keep the print column and use the buffered length as
 $A9F5 LD B,L        ; the glyph counter.}
 $A9F6 LD HL,$5C0B   ; #REGhl=#N$5C0B (the start of the word buffer, which
                     ; overwrites #SKOOLKID$5C0B(DEFADD) onwards).
 $A9F9 LD ($A9B5),HL ; Write #REGhl (the start of the word buffer) to *#R$A9B5.
@label=Print_Character_ScrollLoop
*$A9FC LD A,(HL)     ; Read the next character of the buffered word.
 $A9FD CALL $AA14    ; Call #R$AA14 to print one character and remember the
                     ; line.
 $AA00 INC HL        ; Move to the next character.
 $AA01 DJNZ $A9FC    ; Count the next character and repeat from #R$A9FC.
 $AA03 POP BC        ; {Restore #REGbc from the stack.
 $AA04 POP AF        ; }
 $AA05 JR NZ,$AA0B   ; And the saved flags, and go to #R$AA0B when the zero
                     ; flag is clear.
; Clear the print position flag after the buffered word is printed.
 $AA07 XOR A         ; {Reset *#R$A025.
 $AA08 LD ($A025),A  ; }
@label=Print_Character_RestoreCharacter
*$AA0B POP DE        ; {Restore the character from the stack.
 $AA0C POP HL        ;
 $AA0D POP AF        ; }
 $AA0E JR $AA14      ; And jump to #R$AA14 to print it.
; Print the character on the screen.
; .
; Use alternate print method (direct screen printing).
@label=Print_Character_AlternateMode
*$AA10 POP AF        ; {Jump to #R$C1E1 to check the television flag.
 $AA11 JP $C1E1      ; }

; Print One Character And Remember The Line
;
; Used by the routine at #R$A9B7.
; .
; Turns an upper-case letter into lower case, remembers that a character has been
; printed on this line, and starts a new line when the character is a carriage return.
;
; .
;
; Convert uppercase letters to lowercase if needed.
@label=Print_Character_ProcessCharacter
c$AA14 CP $41        ; {Jump ahead to #R$AA1E if the character is below A.
 $AA16 JR C,$AA1E    ; }
 $AA18 CP $5B        ; {Jump ahead to #R$AA1E if the character is past Z.
 $AA1A JR NC,$AA1E   ; }
 $AA1C OR $20        ; Set bit 5 to make the letter lower case.
@label=Print_Character_CheckSpace
*$AA1E PUSH AF       ; {Keep the character and jump to #R$AA2A when this line
 $AA1F LD A,($A025)  ; has already started.
 $AA22 AND A         ;
 $AA23 JR NZ,$AA2A   ;
 $AA25 POP AF        ; }
 $AA26 CP $20        ; {Return if the character is a space.
 $AA28 RET Z         ; }
 $AA29 PUSH AF       ; Keep the character and set the print position flag at
                     ; #R$A025.
; Mark that we've started printing on this line.
@label=Print_Character_MarkPrintStarted
*$AA2A LD A,$01      ;
 $AA2C LD ($A025),A  ;
 $AA2F POP AF        ; {Jump ahead to #R$AA3B if the character is not a new
 $AA30 PUSH AF       ; line.
 $AA31 CP $0D        ;
 $AA33 JR NZ,$AA3B   ; }
; Reset the print position flag for a carriage return.
 $AA35 XOR A         ; {Clear *#R$A025.
 $AA36 LD ($A025),A  ; }
 $AA39 JR $AA6D      ; Jump ahead to #R$AA6D to print the character.
; A quotation mark is printed as a blank, and the picture flag is consulted.
@label=Print_Character_CheckQuote
*$AA3B CP $22        ; {Jump ahead to #R$AA46 if the character is not a
 $AA3D JR NZ,$AA46   ; quotation mark.}
 $AA3F LD A,$20      ; Take a space.
 $AA41 CALL $C1E1    ; Call #R$C1E1 to honour the television flag.
 $AA44 JR $AA4A      ; As after a full stop, go to #R$AA4A to set the flag at
                     ; #R$A026 so the next letter is a capital.
; A sentence stop marks the token so the next letter can be printed in
; capitals.
@label=Print_Character_CheckPeriod
*$AA46 CP $2E        ; {Jump ahead to #R$AA51 if the character is not a full
 $AA48 JR NZ,$AA51   ; stop.}
@label=Print_Character_SetTokenFormatFlag
*$AA4A LD A,$01      ; {Set *#R$A026.
 $AA4C LD ($A026),A  ; }
 $AA4F JR $AA6D      ; Jump ahead to #R$AA6D to print the character.
; See whether the character byte is a lower-case letter, then see whether the
; character byte is past the lower-case letters, then read the lowercase Handling Flag.
; .
; Handle lowercase letters (dictionary word characters).
@label=Print_Character_CheckLowercase
*$AA51 CP $61        ; {Jump ahead to #R$AA6D if the character is below the
 $AA53 JR C,$AA6D    ; letter a.}
 $AA55 CP $7B        ; {Jump ahead to #R$AA6D if the character is at least
 $AA57 JR NC,$AA6D   ; #N$7B.}
 $AA59 LD A,($A851)  ; {Jump to #R$AA65 if the lowercase handling flag is set.
 $AA5C AND A         ;
 $AA5D JR NZ,$AA65   ; }
 $AA5F LD A,($A026)  ; {Jump to #R$AA6D if the token format flag is zero.
 $AA62 AND A         ;
 $AA63 JR Z,$AA6D    ; }
; Reset the token format flag before converting to uppercase.
@label=Print_Character_ResetTokenFormatFlag
*$AA65 XOR A         ; {Reset *#R$A026.
 $AA66 LD ($A026),A  ; }
 $AA69 POP AF        ; Restore the character from the stack.
; Clear bit 5 from the character code (convert to uppercase).
 $AA6A AND %01011111 ; Clear bit 5 so a lowercase letter becomes uppercase.
 $AA6C PUSH AF       ; Keep the character while it is printed.
@label=Print_Character_Print
*$AA6D POP AF        ; {Jump to #R$C1E1 to check the television flag.
 $AA6E JP $C1E1      ; }

; Lookup Table: Object Display Data
;
; Words indexed by the object attribute minus #N$01.
; Each word points at a display record. A record is two bytes, plus two when bit 6
; is set and five when bit 4 is set.
; Read by #R$C966.
@label=Table_ObjectDisplayData
g$AA71 DEFB $99,$9A
 $AA73 DEFB $CB,$9A
 $AA75 DEFB $A3,$E1
 $AA77 DEFB $22,$E0
 $AA79 DEFB $03,$E0
 $AA7B DEFB $9D,$DE
 $AA7D DEFB $AF,$DE
 $AA7F DEFB $32,$E4
 $AA81 DEFB $0A,$E4
 $AA83 DEFB $28,$E3
 $AA85 DEFB $C7,$E2
 $AA87 DEFB $EA,$E3
 $AA89 DEFB $8D,$E0
 $AA8B DEFB $F4,$9A
 $AA8D DEFB $E1,$9A
 $AA8F DEFB $A0,$E0
 $AA91 DEFB $F2,$E0
 $AA93 DEFB $04,$E1
 $AA95 DEFB $E0,$E0
 $AA97 DEFB $7E,$DF
 $AA99 DEFB $A7,$DF
 $AA9B DEFB $7B,$E1
 $AA9D DEFB $F0,$DF
 $AA9F DEFB $EA,$DF

; Display Bytes
;
; Bytes read while a picture is drawn.
; Read by #R$ACCC and #R$ACFB.
@label=DisplayBytes
b$AAA1 DEFB $00,$00  ; Two zero bytes read while a picture is drawn.
 $AAA3 DEFB $00      ; Display byte read with the one at #R$AAA6, read by
                     ; #R$ACCC and #R$ACFB.
 $AAA4 DEFB $00,$00  ; Word read as the display record, read by #R$ACCC and
                     ; #R$ACFB.
 $AAA6 DEFB $00      ; Display byte read with the one at #R$AAA3, read by
                     ; #R$ACCC and #R$ACFB.
 $AAA7 DEFB $00      ; Cleared state byte, read by #R$AAD1 and #R$AC24.

; Buffer: Co-ordinate Header
;
; Four bytes at the start of the co-ordinate buffer cleared by #R$AC24.
; Read by #R$AC24, #R$AC8F and #R$ACA6.
g$AAA8 DEFB $00,$00,$00,$00

; Buffer: Co-ordinate Data
;
; 6-byte buffer used for storing co-ordinate pairs and related display data.
; Read by #R$AAD1, #R$AC24 and #R$B6FD.
@label=Buffer_CoordinateData
g$AAAC DEFB $00,$00,$00,$00,$00,$00

; Prepare Character For Display
;
; Used by the routines at #R$B8AA and #R$D6C1.
; .
; Clears the parser and gets the character ready for the picture.
@label=PrepareCharacterForDisplay
c$AAB2 XOR A         ; {Clear the parser and clear the pictures-enabled byte at
 $AAB3 LD ($A01A),A  ; #R$A012.
 $AAB6 LD ($A012),A  ; }
 $AAB9 LD E,$FF      ; Mark this display column as unused.
 $AABB LD D,$C0      ; Point the display row at the top of the screen buffer.

; Force The Display Marker On
;
; Used by the routine at #R$AD57.
; .
; Forces the display marker on before the character record is built.
c$AABD LD A,E        ; Read the low byte of the source.
 $AABE OR $C7        ; Mark bits 0, 1, 2, 6, 7 on the result.
 $AAC0 LD E,A        ; Store the result in the low byte of the source.
 $AAC1 CALL $AE6A    ; Call #R$AE6A to build the character record.

; Choose The Display Path From The Initialised Flag
;
; Used by the routine at #R$B012.
; .
; Reads the initialised flag. When the game has been initialised it selects the
; alternate display path and clears the extra display marker.
c$AAC4 LD A,($A01B)  ; {Jump to #R$AAD1 if the initialised flag is zero.
 $AAC7 AND A         ;
 $AAC8 JR Z,$AAD1    ; }
 $AACA LD A,$01      ; {Write #N$01 to the command mode at #R$A024 and clear
 $AACC LD ($A024),A  ; bit 3 of the source.
 $AACF RES 3,E       ; }

; Start Picture Mode When The Screen Is Idle
;
; Used by the routines at #R$AAC4 and #R$B0FD.
; .
; When nothing is on screen, clears the picture buffer and selects picture
; mode.
@label=StartPictureModeScreenIdle
c$AAD1 PUSH DE       ; {Save #REGde and jump to #R$AB11 if the command mode at
 $AAD2 LD A,($A024)  ; #R$A024 is set.
 $AAD5 AND A         ;
 $AAD6 JR NZ,$AB11   ; }
 $AAD8 LD ($AAA7),A  ; Clear the state byte at #R$AAA7.
 $AADB LD HL,($A02B) ; {Read the word at #R$A02B, save it and call #R$AC24 to
 $AADE PUSH HL       ; clear the co-ordinate buffer.
 $AADF CALL $AC24    ; }
 $AAE2 JR NZ,$AB08   ; Go to #R$AB08 when #R$AC24 returns non-zero.
 $AAE4 LD A,($AAA7)  ; {Jump to #R$AB08 if the state byte at #R$AAA7 is set.
 $AAE7 AND A         ;
 $AAE8 JR NZ,$AB08   ; }
 $AAEA LD A,$02      ; {Write #N$02 to the command mode at #R$A024.
 $AAEC LD ($A024),A  ; }
 $AAEF POP HL        ; Restore the saved pointer from the stack.
 $AAF0 PUSH IY       ; {Copy the character record from #REGiy into #REGhl.
 $AAF2 POP HL        ; }
 $AAF3 LD DE,$0018   ; {Point #REGhl at the co-ordinates #N($0018,$04,$04)
 $AAF6 ADD HL,DE     ; bytes into the character record, and #REGde at the
 $AAF7 LD DE,$AAAC   ; buffer at #R$AAAC.}
 $AAFA EX DE,HL      ; {Swap the pointers, take #N$06 bytes and copy them.
 $AAFB LD BC,$0006   ;
 $AAFE LDIR          ; }
 $AB00 LD HL,($A029) ; Read the word at #R$A029.
 $AB03 LD ($A02B),HL ; {Store it in the word at #R$A02B and jump ahead to
 $AB06 JR $AB11      ; #R$AB11 to check display mode.}
@label=StartPictureModeScreenIdle_ClearBorrow
*$AB08 LD A,$01      ; {Write #N$01 to the command mode at #R$A024.
 $AB0A LD ($A024),A  ; }
 $AB0D POP HL        ; Restore the saved pointer from the stack.
 $AB0E LD ($A02B),HL ; Store the pointer in the word at #R$A02B.
@label=StartPictureModeScreenIdle_CheckDisplayMode
*$AB11 POP DE        ; Restore the source from the stack.
 $AB12 XOR A         ; {Clear the state byte at #R$AAA7 and call #R$AB91 to
 $AB13 LD ($AAA7),A  ; check display mode.
 $AB16 CALL $AB91    ; }
 $AB19 JR C,$AB8E    ; Jump ahead to #R$AB8E if #R$AB91 finds the marker bit
                     ; already clear.
 $AB1B JR Z,$AB47    ; Go to #R$AB47 if bit 1 of the source is clear.
 $AB1D CP $90        ; {Jump ahead to #R$AFB3 if it is #N$90.
 $AB1F JP Z,$AFB3    ; }
 $AB22 CP $A0        ; {Jump ahead to #R$ACCC if it is #N$A0.
 $AB24 JP Z,$ACCC    ; }
 $AB27 BIT 3,E       ; {Jump ahead to #R$AB4C if bit 3 is clear.
 $AB29 JR Z,$AB4C    ; }
 $AB2B LD A,($A012)  ; {Jump to #R$AB8E if the pictures-enabled byte at #R$A012
 $AB2E AND A         ; is set.
 $AB2F JR NZ,$AB8E   ; }
 $AB31 LD A,($A01B)  ; {Jump to #R$AB4C if the initialised flag is set.
 $AB34 AND A         ;
 $AB35 JR NZ,$AB4C   ; }
 $AB37 LD A,($A02D)  ; {Jump to #R$AB8E if the byte at #R$A02D is not #N$C0.
 $AB3A CP $C0        ;
 $AB3C JR NZ,$AB8E   ; }
 $AB3E LD A,$B0      ; {Jump ahead to #R$AB8E if #REGd is not #N$B0.
 $AB40 CP D          ;
 $AB41 JR NZ,$AB8E   ; }
 $AB43 LD A,$02      ; Leave #N$02 as the result.
 $AB45 AND A         ; Clear the borrow so the script reads the result as
                     ; success.
 $AB46 RET           ; Return.
; See whether bit 3 of the low byte of the source is set, then read the pointer at
; the object Processing Source Flag, then record the pointer in the object Processing Source Flag.
@label=StartPictureModeScreenIdle_TestBitLowByte
*$AB47 BIT 3,E       ; {Go to #R$ACFB if bit 3 of this byte is clear.
 $AB49 JP Z,$ACFB    ; }

; Read Object Processing Flag
;
; Used by the routines at #R$AAD1, #R$AB52 and #R$ACFB.
; .
; Copies the word at #R$A029 into the word at #R$A02B while the character is
; prepared for display.
@label=ReadObjectProcessingFlag
c$AB4C LD HL,($A029) ; {Copy the word at #R$A029 into the word at #R$A02B.
 $AB4F LD ($A02B),HL ; }

; Copy Display If Needed
;
; Used by the routines at #R$B01C, #R$B033 and #R$B049.
; .
; Copies display If Needed.
;
; .
;
; The display-marker scan has finished.
@label=CopyDisplayIfNeeded
c$AB52 CALL $AC24    ; {Jump to #R$AB8E if the display-marker scan has
 $AB55 JR C,$AB8E    ; finished.}
 $AB57 JR NZ,$AB60   ; Skip the copy when bit 5 of the source is set.
 $AB59 CALL $ACA6    ; {Go to #R$AB8E if neither bit 6 nor bit 7 of #REGe is
 $AB5C JR Z,$AB8E    ; set.}
 $AB5E JR $AB4C      ; The copy did not finish, so try the next object from
                     ; #R$AB4C.
; A sentence-stop marker rebuilds the picture once the game has started.
@label=CopyDisplayIfNeeded_Next
*$AB60 CP $B0        ; {Go to #R$AD57 if the token code is #N$B0.
 $AB62 JP Z,$AD57    ; }
 $AB65 CP $A0        ; {Go to #R$ACCC if the token code is #N$A0.
 $AB67 JP Z,$ACCC    ; }
 $AB6A CP $90        ; {Go to #R$AFB3 if it is #N$90.
 $AB6C JP Z,$AFB3    ; }
 $AB6F LD HL,($A029) ; {Copy the word at #R$A029 into the word at #R$A02B.
 $AB72 LD ($A02B),HL ; }
 $AB75 LD A,($A024)  ; {Jump to #R$AB8E if the command mode at #R$A024 is not
 $AB78 CP $02        ; #N$02.
 $AB7A JR NZ,$AB8E   ; }
; The character-pair search returned carry.
 $AB7C CALL $ABF3    ; {Jump to #R$AB8E if the character-pair search returns
 $AB7F JR C,$AB8E    ; carry.}
 $AB81 JR NZ,$AB8E   ; Jump ahead to #R$AB8E if #R$ABF3 returns non-zero.
 $AB83 LD HL,($A029) ; {Copy the word at #R$A029 into the word at #R$A02B and take
 $AB86 LD ($A02B),HL ; #N$A0.
 $AB89 LD D,$A0      ; }
 $AB8B JP $ACCC      ; Take token #N$A0 and continue at #R$ACCC.
; This entry point is used by the routine at #R$AAD1.
@label=CopyDisplayIfNeeded_ReportDone
*$AB8E JP $AF67      ; Jump to #R$AF67 to return non-zero.

; Check Display Mode
;
; Used by the routine at #R$AAD1.
; .
; Jumps to #R$ABF3 when the command mode at #R$A024 is #N$02. Otherwise walks
; the clause in #REGe and stores the words it accepts.
@label=CheckDisplayMode
c$AB91 LD A,($A024)  ; {Jump to #R$ABF3 if the command mode at #R$A024 is
 $AB94 CP $02        ; #N$02.
 $AB96 JR Z,$ABF3    ; }
 $AB98 LD A,E        ; Read the low byte of the source.
 $AB99 OR $07        ; Mark bits 0-2 on the result.
 $AB9B LD E,A        ; Store the result in the low byte of the source.
@label=CheckDisplayMode_Loop
*$AB9C CALL $AE7F    ; {Go to #R$AB9C if it is #N$E0.
 $AB9F CP $E0        ;
 $ABA1 JR Z,$AB9C    ; }
 $ABA3 CP $30        ; {Go to #R$ABB7 if it is not #N$30.
 $ABA5 JR NZ,$ABB7   ; }
@label=CheckDisplayMode_TestBitClear
*$ABA7 BIT 1,E       ; {Jump ahead to #R$ABB5 if bit 1 is clear.
 $ABA9 JR Z,$ABB5    ; }
@label=CheckDisplayMode_CharacterLowByte
*$ABAB RES 1,E       ; {Clear bit 1 of #REGe and store #REGbc at
 $ABAD LD (IY+$00),C ; #REGiy+#N$00-#N$01.
 $ABB0 LD (IY+$01),B ; }
 $ABB3 JR $AB9C      ; Go back and test the next display marker.
; The condition holds, so the caller continues.
@label=CheckDisplayMode_ConditionHoldsCaller
*$ABB5 SCF           ; Mark the condition as met.
 $ABB6 RET           ; Return.
; A zero code clears the third flag bit when that bit is set.
@label=CheckDisplayMode_Next
*$ABB7 CP $00        ; {Go to #R$ABC9 if it is not #N$00.
 $ABB9 JR NZ,$ABC9   ; }
@label=CheckDisplayMode_TestBitClearAgain
*$ABBB BIT 2,E       ; {Jump back to #R$ABB5 if bit 2 is clear.
 $ABBD JR Z,$ABB5    ; }
 $ABBF RES 2,E       ; {Clear bit 2 of #REGe and store #REGbc at
 $ABC1 LD (IY+$02),C ; #REGiy+#N$02-#N$03.
 $ABC4 LD (IY+$03),B ; }
 $ABC7 JR $AB9C      ; Go back and test the next display marker.
; A code of #N$40 clears the first flag bit.
@label=CheckDisplayMode_TestCodeClearsFirst
*$ABC9 CP $40        ; {Go to #R$ABD1 unless the code is #N$40.
 $ABCB JR NZ,$ABD1   ; }
 $ABCD RES 0,E       ; {Clear the mark on this character.
 $ABCF JR $ABA7      ; }
; A blank keeps the second flag bit, or the first when the second is clear.
@label=CheckDisplayMode_TestBlankKeepsSecond
*$ABD1 CP $20        ; {Go to #R$ABEF if it is not #N$20.
 $ABD3 JR NZ,$ABEF   ; }
 $ABD5 BIT 1,E       ; {Jump back to #R$ABA7 while bit 1 is present.
 $ABD7 JR NZ,$ABA7   ; }
 $ABD9 BIT 0,E       ; {Jump back to #R$ABBB while bit 0 is present.
 $ABDB JR NZ,$ABBB   ; }
 $ABDD RES 2,E       ; {Clear the mark on this character, then set the mark on
 $ABDF SET 0,E       ; this character.
 $ABE1 LD A,(IY+$00) ; }
 $ABE4 LD (IY+$02),A ; Store #REGa at #REGiy+#N$02.
 $ABE7 LD A,(IY+$01) ; {Copy the high byte beside the low byte and repeat the
 $ABEA LD (IY+$03),A ; store from #R$ABAB.
 $ABED JR $ABAB      ; }
; See whether the display mode is zero, then see whether bit 1 of the low byte of the
; source is set.
@label=CheckDisplayMode_TestDisplayModeZero
*$ABEF OR A          ; See whether the display mode is zero.
 $ABF0 BIT 1,E       ; See whether bit 1 of the low byte of the source is set.
 $ABF2 RET           ; Return.

; Match Character Pair
;
; Used by the routines at #R$AB52 and #R$AB91.
; .
; Scans the character-id pairs at #R$994D for the two characters being compared, and stops
; at the zero word that ends the table.
@label=MatchCharacterPair
c$ABF3 CALL $AE7F    ; {Call #R$AE7F, and call it again if it returns #N$80.
 $ABF6 CP $80        ;
 $ABF8 CALL Z,$AE7F  ; }
 $ABFB LD A,B        ; {Use the character pairs (#R$994D).
 $ABFC AND $0F       ;
 $ABFE LD B,A        ;
 $ABFF LD HL,$994D   ; }
@label=MatchCharacterPair_Loop
*$AC02 LD A,(HL)     ; {Go to #R$AC14 if this word is zero.
 $AC03 INC HL        ;
 $AC04 OR (HL)       ;
 $AC05 JR Z,$AC14    ; }
 $AC07 LD A,B        ; {Jump ahead to #R$AC11 if this pair's first id differs.
 $AC08 CP (HL)       ;
 $AC09 JR NZ,$AC11   ; }
 $AC0B DEC HL        ; {Jump ahead to #R$AC17 if this pair's second id matches.
 $AC0C LD A,C        ;
 $AC0D CP (HL)       ;
 $AC0E JR Z,$AC17    ; }
 $AC10 INC HL        ; Step to the next character.
*$AC11 INC HL        ; {Step to the next character pair and go back to #R$AC02.
 $AC12 JR $AC02      ; }
@label=MatchCharacterPair_Next
*$AC14 OR %00000001  ; Reset the zero flag.
 $AC16 RET           ; Return.
; Store this character's id and script position, then clear the link bit.
@label=MatchCharacterPair_CharacterScriptPosition
*$AC17 LD (IY+$00),C ; {Store #REGbc at #REGiy+#N$00-#N$01 and clear bit 1 of
 $AC1A LD (IY+$01),B ; #REGe.
 $AC1D RES 1,E       ; }
 $AC1F CALL $AE7F    ; Call #R$AE7F to save the text pointer.
 $AC22 XOR A         ; Clear #REGa.
 $AC23 RET           ; Return.

; Clear Co-ordinate Buffer
;
; Used by the routines at #R$AAD1 and #R$AB52.
; .
; Clears the co-ordinate buffer and marks bits 2, 4 and 5 of #REGe.
@label=ClearCoordinateBuffer
c$AC24 LD HL,$AAA8   ; {Call #R$A2AB to clear buffer.
 $AC27 LD B,$0A      ;
 $AC29 CALL $A2AB    ; }
 $AC2C LD A,E        ; Read the low byte of the source.
 $AC2D OR $34        ; Mark bits 2, 4, 5 on the result.
 $AC2F LD E,A        ; Store the result in the low byte of the source.
; Saves the text pointer, and a code of 128 clears the fourth flag bit.
@label=ClearCoordinateBuffer_Loop
*$AC30 CALL $AE7F    ; {Go to #R$AC41 if it is not #N$80.
 $AC33 CP $80        ;
 $AC35 JR NZ,$AC41   ; }
 $AC37 BIT 4,E       ; {Jump ahead to #R$AC3F if bit 4 is clear.
 $AC39 JR Z,$AC3F    ; }
 $AC3B RES 4,E       ; {Clear the mark on this character.
 $AC3D JR $AC30      ; }
; The condition holds, so the caller continues.
@label=ClearCoordinateBuffer_Next
*$AC3F SCF           ; Mark the condition as met.
 $AC40 RET           ; Return.
; Accepts token types #N$10 and #N$70 when their flag bits are set.
@label=ClearCoordinateBuffer_TestLowAndHighToken
*$AC41 CP $10        ; {Jump to #R$AC49 when the token type is #N$10.
 $AC43 JR Z,$AC49    ; }
 $AC45 CP $70        ; {Jump to #R$AC65 when the token type is not #N$70.
 $AC47 JR NZ,$AC65   ; }
@label=ClearCoordinateBuffer_AcceptFlaggedToken
*$AC49 BIT 4,E       ; {Jump back to #R$AC3F if bit 4 is clear.
 $AC4B JR Z,$AC3F    ; }
 $AC4D BIT 2,E       ; {Jump back to #R$AC3F if bit 2 is clear.
 $AC4F JR Z,$AC3F    ; }
 $AC51 LD A,($AAA7)  ; {Jump to #R$AC3F if the state byte at #R$AAA7 is at
 $AC54 CP $03        ; least #N$03.
 $AC56 JR NC,$AC3F   ; }
 $AC58 INC A         ; {Count one more at #R$AAA7, then call #R$AC8F.
 $AC59 LD ($AAA7),A  ;
 $AC5C CALL $AC8F    ; }
 $AC5F JR NZ,$AC3F   ; Jump back to #R$AC3F to return if #R$AC8F does not
                     ; return #N$00.
 $AC61 RES 5,E       ; {Jump back to #R$AC30 to check token #N$10 or #N$70.
 $AC63 JR $AC30      ; }
; A vocabulary code clears the upper flag bits when the second flag bit is set.
@label=ClearCoordinateBuffer_TestVocabularyCode
*$AC65 CP $60        ; {Jump to #R$AC78 when the token type is not #N$60.
 $AC67 JR NZ,$AC78   ; }
 $AC69 BIT 2,E       ; {Jump back to #R$AC3F if bit 2 is clear.
 $AC6B JR Z,$AC3F    ; }
 $AC6D RES 4,E       ; Clear the marker for check token #N$10 or #N$70.
 $AC6F RES 5,E       ; {Clear bit 5 and call #R$AC94 to read the next
 $AC71 CALL $AC94    ; co-ordinate pair.}
 $AC74 JR NZ,$AC3F   ; Jump back to #R$AC3F to return if #R$AC94 does not
                     ; return #N$00.
 $AC76 JR $AC30      ; Jump back to #R$AC30 to check token #N$10 or #N$70.
; A code of #N$F0 or #N$50 keeps the co-ordinate bits that this token uses.
@label=ClearCoordinateBuffer_TestCodeKeepsOrdinate
*$AC78 CP $F0        ; {Jump to #R$AC80 when the token type is #N$F0.
 $AC7A JR Z,$AC80    ; }
 $AC7C CP $50        ; {Jump to #R$AC8B when the token type is not #N$50.
 $AC7E JR NZ,$AC8B   ; }
@label=ClearCoordinateBuffer_RecordBufferOrdinate
*$AC80 LD A,E        ; {Record the buffer: co-ordinate data.
 $AC81 AND $CB       ;
 $AC83 LD E,A        ;
 $AC84 LD ($AAAC),BC ; }
 $AC88 CALL $AE7F    ; Call #R$AE7F to remember the text pointer.
*$AC8B AND A         ; Clear the carry before testing bit 5 of the source.
 $AC8C BIT 5,E       ; See whether bit 5 of the low byte of the source is set.
 $AC8E RET           ; Return.

; Point At The Picture Origin
;
; Used by the routine at #R$AC24.
; .
; Points at the four-byte picture origin and continues with the token check.
@label=PointPictureOrigin
c$AC8F LD HL,$AAA8   ; {Jump ahead to #R$AC97 to take buffer: Co-ordinate Header (#R$AAA8) to check token 10
 $AC92 JR $AC97      ; or 70.}

; Read The Next Coordinate Pair
;
; Used by the routine at #R$AC24.
; .
; Points at the co-ordinate data and skips the token check when the next pair
; is empty.
@label=ReadBytePointer
c$AC94 LD HL,$AAAE   ; Use the buffer: co-ordinate data (#R$AAAC+#N$02).
; This entry point is used by the routine at #R$AC8F.
@label=ReadBytePointer_CheckToken
*$AC97 LD A,(HL)     ; {Go to #R$ACA1 if this word is zero.
 $AC98 INC HL        ;
 $AC99 OR (HL)       ;
 $AC9A JR Z,$ACA1    ; }
 $AC9C INC HL        ; Advance through the text.
 $AC9D LD A,(HL)     ; Read the co-ordinate stored at the pointer.
 $AC9E INC HL        ; Advance through this record.
 $AC9F OR (HL)       ; Merge the next co-ordinate into the pair.
 $ACA0 RET NZ        ; Return when the co-ordinate pair is not empty.
*$ACA1 LD (HL),B     ; Store #REGb at the second byte of this word.
 $ACA2 DEC HL        ; Step back to the first byte.
 $ACA3 LD (HL),C     ; Store #REGc there.
 $ACA4 XOR A         ; Clear #REGa, as the pair was empty and has now been
                     ; filled from #REGbc.
 $ACA5 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7809 }
; LIST#

; Copy Display Data To Display Buffer
;
; Used by the routine at #R$AB52.
; .
; Copies display data from the character data structure to the display buffer
; at #R$AAA8. If bit 6 of #REGe is set, copies from offset #N$04; if bit 7 of
; #REGe is set, copies from offset #N$0E. Always sets bit 0 of the return
; value.
;
;   E Flags (bits 6 and 7 indicate which display data set to copy)
; O:A Bit 0 is set if data was copied
@label=CopyDisplayDataToDisplayBuffer
c$ACA6 BIT 6,E       ; {Jump ahead to #R$ACB2 if bit 6 is clear.
 $ACA8 JR Z,$ACB2    ; }
 $ACAA RES 6,E       ; Clear the marker.
 $ACAC PUSH DE       ; {Keep #REGde, take offset #N$04, and join the copy at
 $ACAD LD DE,$0004   ; #R$ACBB.
 $ACB0 JR $ACBB      ; }
; Bit 7 selects the second display block.
@label=CopyDisplayDataToDisplayBuffer_Next
*$ACB2 BIT 7,E       ; See whether bit 7 of the low byte of the source is set.
 $ACB4 RET Z         ; Return if that marker is clear.
 $ACB5 RES 7,E       ; {Clear bit 7 and take offset #N($000E,$04,$04), keeping
 $ACB7 PUSH DE       ; #REGde.
 $ACB8 LD DE,$000E   ; }
@label=CopyDisplayDataToDisplayBuffer_AddOffset
*$ACBB PUSH IY       ; {Use the buffer: co-ordinate header (#R$AAA8).
 $ACBD POP HL        ;
 $ACBE ADD HL,DE     ;
 $ACBF LD DE,$AAA8   ;
 $ACC2 EX DE,HL      ; }
 $ACC3 LD BC,$000A   ; {Take a length of #N$0A entries and copy these bytes
 $ACC6 LDIR          ; across.
 $ACC8 POP DE        ; }
 $ACC9 OR %00000001  ; Reset the zero flag.
 $ACCB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$782B }
; LIST#

; Handle A Class #N$A0 Word
;
; Used by the routines at #R$AAD1, #R$AB52 and #R$AFFA.
; .
; Skips class #N$A0 tokens, saves the word pointer and this clause record, and
; carries on at the class #N$B0 matcher (#R$AD57). When the parser count at
; #R$A019+#N$01 is #N$02, it sets bit 6 of the clause record first.
;
; E Flags (bit 3 is reset)
@label=HandleClassAWord
c$ACCC RES 3,E        ; {Run text token and save state.
 $ACCE PUSH DE        ; }
@label=HandleClassAWord_Loop
*$ACCF CALL $AE7F     ; {Jump back to #R$ACCF if the character code is #N$A0.
 $ACD2 CP $A0         ;
 $ACD4 JR Z,$ACCF     ; }
 $ACD6 LD HL,($A029)  ; {Copy the word at #R$A029 into #R$AAA1.
 $ACD9 LD ($AAA1),HL  ; }
 $ACDC LD ($A02B),HL  ; Store #REGhl in the word at #R$A02B.
 $ACDF POP DE         ; {Store the low byte in the display byte at #R$AAA3.
 $ACE0 LD A,E         ;
 $ACE1 LD ($AAA3),A   ; }
 $ACE4 LD ($AAA4),IY  ; Store the record pointer at #R$AAA4.
 $ACE8 LD A,($A012)   ; {Remember whether pictures are enabled, in the display
 $ACEB LD ($AAA6),A   ; byte at #R$AAA6.}
 $ACEE LD A,($A01A)   ; {Jump to #R$AD57 if the parser is not #N$02.
 $ACF1 CP $02         ;
 $ACF3 JR NZ,$AD57    ; }
 $ACF5 SET 6,(IY+$01) ; {Set bit 6 of the clause record and jump to #R$AD57.
 $ACF9 JR $AD57       ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$770B }
; LIST#

; Apply The Saved Clause
;
; Used by the routine at #R$AAD1.
; .
; When the command mode at #R$A024 is #N$02 and bit 6 of #REGe is clear, copies
; six bytes from offset #N$08 of the clause record to offset #N$18 and returns
; to the scan at #R$AB4C. Once the game has started, any other case sets bit 3
; of #REGe and returns to that scan. Before the game has started it restores
; the saved word as class #N$B0, unlinks the clause record, and falls into
; #R$AD57.
@label=ApplySavedClause
c$ACFB LD A,($A024)  ; {Jump to #R$AD23 if the command mode at #R$A024 is not
 $ACFE CP $02        ; #N$02.
 $AD00 JR NZ,$AD23   ; }
 $AD02 BIT 6,E       ; {Jump back to #R$AB4C while bit 6 is present.
 $AD04 JP NZ,$AB4C   ; }
 $AD07 SET 6,E       ; {Set the mark on this character
 $AD09 SET 3,E       ;
 $AD0B PUSH IY       ;
 $AD0D EXX           ;
 $AD0E POP HL        ; }
 $AD0F LD DE,$0008   ; {Point #REGhl at byte #N$08 of the record (#REGiy+#N$08), save it and take
 $AD12 ADD HL,DE     ; #N($0010,$04,$04).
 $AD13 PUSH HL       ;
 $AD14 LD DE,$0010   ; }
 $AD17 ADD HL,DE     ; {Add #N($0010,$04,$04), so #REGhl points at byte #N$18, and copy #N$06 bytes from byte
 $AD18 POP DE        ; #N$08.
 $AD19 EX DE,HL      ;
 $AD1A LD BC,$0006   ;
 $AD1D LDIR          ; }
 $AD1F EXX           ; {Switch back to the saved registers and resume the
 $AD20 JP $AB4C      ; object scan at #R$AB4C.}
; Once the game has started, sets bit 3 of #REGe and returns to #R$AB4C.
@label=ApplySavedClause_GameStarted
*$AD23 LD A,($A01B)  ; {Jump to #R$AD2E if the initialised flag is zero.
 $AD26 AND A         ;
 $AD27 JR Z,$AD2E    ; }
 $AD29 SET 3,E       ; {Set bit 3 of the flag in #REGe and resume the object
 $AD2B JP $AB4C      ; scan at #R$AB4C.}
; Restores the saved word as class #N$B0, unlinks the clause record, and falls
; into #R$AD57.
@label=ApplySavedClause_RestoreWord
*$AD2E LD HL,($AAA1) ; {Copy the saved word to #R$A02B and take class #N$B0.
 $AD31 LD ($A02B),HL ;
 $AD34 LD D,$B0      ; }
 $AD36 LD A,($AAA3)  ; {Read the saved flag bytes at #R$AAA3 and #R$AAA6.
 $AD39 LD E,A        ;
 $AD3A LD A,($AAA6)  ; }
 $AD3D LD ($A012),A  ; Put the saved flag back at #R$A012.
 $AD40 LD IY,($AAA4) ; {Point #REGiy at the saved clause record and read the
 $AD44 LD L,(IY-$02) ; low byte of its link.}
 $AD47 LD H,(IY-$01) ; Read the high byte of the link.
 $AD4A PUSH HL       ; {Call #R$A1AF to follow the record pointer.
 $AD4B POP IX        ;
 $AD4D CALL $A1AF    ; }
 $AD50 XOR A         ; {Clear the clause record's link.
 $AD51 LD (IY-$02),A ;
 $AD54 LD (IY-$01),A ; }

; Match A Class #N$B0 Word
;
; Used by the routines at #R$AB52 and #R$ACCC.
; .
; Grammar handler for word class #N$B0. It matches the word in #REGd against
; the earlier clause records, which are kept in a linked list.
@label=MatchWordAgainstEarlierClause
c$AD57 LD A,($A01A)  ; {Read the parser count, count down one and point #REGhl
 $AD5A DEC A         ; at #R$A012.
 $AD5B LD HL,$A012   ; }
 $AD5E DEC A         ; {Jump ahead to #R$AD66 unless the parser count was
 $AD5F LD A,D        ; #N$02.
 $AD60 JR NZ,$AD66   ; }
 $AD62 CP $A0        ; {Jump to #R$AD67 when the token is #N$A0.
 $AD64 JR Z,$AD67    ; }
@label=MatchWordAgainstEarlierClause_AdvanceCount
*$AD66 INC (HL)      ; Count one more at #R$A012.
*$AD67 CP $A0        ; {Jump back to #R$AABD if the token is #N$A0.
 $AD69 JP Z,$AABD    ; }
 $AD6C LD A,($A01B)  ; {Jump to #R$ADD4 if the initialised flag is zero.
 $AD6F AND A         ;
 $AD70 JR Z,$ADD4    ; }
 $AD72 LD IY,($9FF0) ; Point #REGiy at the clause list at #R$9FF0.
 $AD76 CALL $AEA9    ; Call #R$AEA9 to follow the clause link.
 $AD79 LD A,(IY+$01) ; Read the clause marker.
 $AD7C AND $7F       ; {Go to #R$ADB8 if this clause word is not zero.
 $AD7E OR (IY+$00)   ;
 $AD81 JR NZ,$ADB8   ; }
 $AD83 LD A,($A01B)  ; {Read the initialised flag into #REGde.
 $AD86 LD E,A        ;
 $AD87 LD D,$00      ; }
 $AD89 LD HL,($9FF0) ; Point #REGhl at the clause list at #R$9FF0.
 $AD8C LD A,(IY+$01) ; {Keep bit 7 of the clause marker and merge it into the
 $AD8F AND $80       ; second byte of the record at the pointer in #R$9FF0.
 $AD91 INC HL        ;
 $AD92 OR (HL)       ;
 $AD93 LD (HL),A     ; }
 $AD94 DEC HL        ; {Step #REGhl back, add the offset, and move #REGiy on
 $AD95 ADD HL,DE     ; eight bytes.
 $AD96 LD DE,$0008   ;
 $AD99 ADD IY,DE     ; }
 $AD9B PUSH IY       ; {Call #R$AE59 to copy this pair when it is still clear.
 $AD9D POP DE        ;
 $AD9E CALL $AE59    ; }
 $ADA1 CALL $AE59    ; {Call #R$AE59 again and go to #R$ADAF when the source
 $ADA4 JR Z,$ADAF    ; low byte is zero.}
 $ADA6 PUSH DE       ; {Call #R$AE59 to copy the pair two bytes back.
 $ADA7 PUSH HL       ;
 $ADA8 DEC DE        ;
 $ADA9 DEC DE        ;
 $ADAA CALL $AE59    ;
 $ADAD POP HL        ; }
 $ADAE POP DE        ; Restore the saved source from the stack.
*$ADAF CALL $AE59    ; Call #R$AE59.
 $ADB2 LD IY,($9FF0) ; {Point #REGiy at the clause list at #R$9FF0 and jump to
 $ADB6 JR $ADBC      ; #R$ADBC.}
; Starts this walk at the saved clause list.
@label=MatchWordAgainstEarlierClause_LaterList
*$ADB8 LD IY,$9FF2   ; Point #REGiy at #R$9FF0+#N$02.
@label=MatchWordAgainstEarlierClause_Next
*$ADBC LD L,(IY-$02) ; {Read this clause record's link.
 $ADBF LD H,(IY-$01) ; }
 $ADC2 PUSH HL       ; {Copy the clause link from #REGhl into #REGix.
 $ADC3 POP IX        ; }
 $ADC5 LD L,(IX-$02) ; {Read the link of the previous record.
 $ADC8 LD H,(IX-$01) ; }
 $ADCB LD (IY-$02),L ; Store the low byte of that link.
 $ADCE LD (IY-$01),H ; {Store the high byte and call #R$A1C7.
 $ADD1 CALL $A1C7    ; }
@label=MatchWordAgainstEarlierClause_CountClauses
*$ADD4 LD IY,$9FF2   ; {Point #REGiy at #R$9FF0+#N$02 and take the count at
 $ADD8 LD A,($A012)  ; #R$A012.
 $ADDB LD B,A        ; }
 $ADDC PUSH BC       ; {Call #R$AEB6 to step to the next clause record.
 $ADDD CALL $AEB6    ; }
@label=MatchWordAgainstEarlierClause_Loop
*$ADE0 LD A,B        ; {Jump ahead to #R$AE1E if the count is zero.
 $ADE1 AND A         ;
 $ADE2 JR Z,$AE1E    ; }
; Steps to the next clause record.
 $ADE4 CALL $AEB6    ; Call #R$AEB6 to step to the next clause record.
 $ADE7 LD A,($A024)  ; {Jump to #R$AE11 if the command mode at #R$A024 is not
 $ADEA CP $02        ; #N$02.
 $ADEC JR NZ,$AE11   ; }
 $ADEE PUSH IY       ; {Point #REGhl at byte #N$18 of the record (#REGiy+#N$18)
 $ADF0 POP HL        ; and save it.
 $ADF1 LD DE,$0018   ;
 $ADF4 ADD HL,DE     ;
 $ADF5 PUSH HL       ; }
 $ADF6 LD D,$06      ; {Take a length of #N$06 and clear the merge.
 $ADF8 XOR A         ; }
@label=MatchWordAgainstEarlierClause_TestCountFinished
*$ADF9 OR (HL)       ; {Jump back to #R$ADF9 while the count is not finished.
 $ADFA INC HL        ;
 $ADFB DEC D         ;
 $ADFC JR NZ,$ADF9   ; }
 $ADFE POP HL        ; Restore the saved pointer from the stack.
 $ADFF AND A         ; {Go to #R$AE11 when any of the six bytes just merged is
 $AE00 JR NZ,$AE11   ; set.}
 $AE02 EX DE,HL      ; {Swap the pointers and point #REGhl at #REGix, with
 $AE03 PUSH IX       ; #N($0018,$04,$04) ready to add.
 $AE05 POP HL        ;
 $AE06 PUSH BC       ;
 $AE07 LD BC,$0018   ; }
 $AE0A ADD HL,BC     ; {Point #REGhl at byte #N$18 of the record (#REGix+#N$18)
 $AE0B LD BC,$0006   ; and copy #N$06 bytes.
 $AE0E LDIR          ;
 $AE10 POP BC        ; }
@label=MatchWordAgainstEarlierClause_ClauseMarker
*$AE11 LD A,(IY+$01) ; Read the byte at #REGiy+#N$01.
 $AE14 AND $7F       ; {Call #R$AEF1 if the link word is zero.
 $AE16 OR (IY+$00)   ;
 $AE19 CALL Z,$AEF1  ; }
 $AE1C JR $ADE0      ; Jump back to #R$ADE0 for the next clause record.
; Matches the word against the saved clause list, and returns zero when none
; match.
@label=MatchWordAgainstEarlierClause_MatchClause
*$AE1E POP BC        ; {Call #R$AEEA to initialise character search.
 $AE1F CALL $AEEA    ; }
 $AE22 CALL $AEC5    ; Call #R$AEC5 to step through the saved clause list.
*$AE25 LD A,B        ; {Jump ahead to #R$AE57 if the count is zero.
 $AE26 AND A         ;
 $AE27 JP Z,$AE57    ; }
; Steps to the next saved clause record.
 $AE2A CALL $AEC5    ; Call #R$AEC5 to step through the saved clause list.
 $AE2D LD A,(IY+$12) ; {Go back to #R$AE25 if the next link is set.
 $AE30 OR (IY+$13)   ;
 $AE33 JR NZ,$AE25   ; }
 $AE35 LD A,(IY+$00) ; {Jump back to #R$AE25 while this id does not match the
 $AE38 CP (IX+$00)   ; record's flag byte.
 $AE3B JR NZ,$AE25   ; }
 $AE3D LD A,(IY+$01) ; {Jump back to #R$AE25 while this id does not match the
 $AE40 CP (IX+$01)   ; moved marker.
 $AE43 JR NZ,$AE25   ; }
 $AE45 LD A,(IX+$0E) ; {Go back to #R$AE25 if the attribute word is zero.
 $AE48 OR (IX+$0F)   ;
 $AE4B JR Z,$AE25    ; }
 $AE4D EXX           ; {Call #R$AF27 to read the schedule field.
 $AE4E LD DE,$000E   ;
 $AE51 CALL $AF27    ; }
 $AE54 JP $AE25      ; Jump back to #R$AE25 for the next clause record.
@label=MatchWordAgainstEarlierClause_SignalStepFailed
*$AE57 XOR A         ; Clear #REGa.
 $AE58 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$75FA }
; LIST#

; Copy Display Data If Zero
;
; Used by the routine at #R$AD57.
; .
; Copies a display pair only when both of its bytes are still clear.
;
; HL Destination pointer (2-byte display data)
; DE Source pointer (2-byte display data)
@label=CopyDisplayDataIfZero
c$AE59 LD A,(HL)     ; {Leave this pair unchanged when either byte is already
 $AE5A INC HL        ; set.
 $AE5B OR (HL)       ;
 $AE5C DEC HL        ;
 $AE5D JR NZ,$AE61   ; }
 $AE5F LD A,(DE)     ; {Copy the first byte of this display pair into the
 $AE60 LD (HL),A     ; picture.}
@label=CopyDisplayDataIfZero_Next
*$AE61 INC HL        ; {Jump to #R$AE67 if either byte of this display pair is
 $AE62 INC DE        ; already set.
 $AE63 JR NZ,$AE67   ; }
 $AE65 LD A,(DE)     ; {Copy the second byte of this display pair into the
 $AE66 LD (HL),A     ; picture.}
@label=CopyDisplayDataIfZero_AdvancePointers
*$AE67 INC HL        ; Advance through the display entry.
 $AE68 INC DE        ; Step to the next source byte.
 $AE69 RET           ; Return.

; Initialise Character Data Structure
;
; Used by the routines at #R$AABD, #R$B01C, #R$B0FD, #R$B13F and #R$B15B.
; .
; Starts a character search, asks for #N$1E bytes, and stores the new record as the
; previous character on the list.
;
;   E Flags
; O:IY Pointer to the initialised character data structure
@label=InitialiseCharacterDataStructure
c$AE6A CALL $AEEA    ; {Call #R$AEEA to start the character search, then ask
 $AE6D LD A,$1E      ; for #N$1E bytes and call #R$A11C to allocate them.
 $AE6F CALL $A11C    ; }
 $AE72 PUSH IX       ; {Store the low byte of the pointer in the previous
 $AE74 POP HL        ; character record.
 $AE75 LD (IY-$02),L ; }
 $AE78 LD (IY-$01),H ; Store the high byte of the pointer in the previous
                     ; character record.
 $AE7B PUSH HL       ; {Point #REGiy at the new character record.
 $AE7C POP IY        ; }
 $AE7E RET           ; Return.

; Save Text Pointer
;
; Used by the routines at #R$AB91, #R$ABF3, #R$AC24, #R$ACCC, #R$B049 and
; #R$B86A.
; .
; Remembers the text pointer so the message can be continued afterwards.
@label=SaveTextPointer
c$AE7F LD HL,($A02B) ; {Copy the word at #R$A02B into the word at #R$A029 and
 $AE82 LD ($A029),HL ; keep #REGd.
 $AE85 LD A,D        ; }
 $AE86 LD ($A02D),A  ; Store #REGa at #R$A02D.
 $AE89 LD A,(HL)     ; {Take the saved text pointer and start its length at
 $AE8A LD D,A        ; zero.
 $AE8B LD BC,$0000   ; }
 $AE8E INC HL        ; {Move past this byte and go to #R$AE9F if it is #N$E0.
 $AE8F CP $E0        ;
 $AE91 JR Z,$AE9F    ; }
 $AE93 CP $F0        ; {Go to #R$AE9F if the token code is #N$F0.
 $AE95 JR Z,$AE9F    ; }
 $AE97 CP $90        ; {Go to #R$AE9F if it is #N$90.
 $AE99 JR Z,$AE9F    ; }
 $AE9B CP $80        ; {Go to #R$AEA4 if the token code is at least #N$80.
 $AE9D JR NC,$AEA4   ; }
@label=SaveTextPointer_Next
*$AE9F LD A,(HL)     ; {Read the next text pair and step past it.
 $AEA0 LD B,A        ;
 $AEA1 INC HL        ;
 $AEA2 LD C,(HL)     ;
 $AEA3 INC HL        ; }
@label=SaveTextPointer_RecordObjectProcessing
*$AEA4 LD ($A02B),HL ; Store #REGhl in the word at #R$A02B.
 $AEA7 LD A,D        ; Read the high byte of the source.
 $AEA8 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7873 }
; LIST#

; Follow Character Link
;
; Used by the routines at #R$AD57, #R$AEB6, #R$B0FD, #R$B13F, #R$B15B, #R$B517,
; #R$BA3E and #R$BB5C.
; .
; Reads the link stored ahead of the current character and hands that record back to the
; caller. It is empty when the list ends.
@label=FollowCharacterLink
c$AEA9 PUSH HL       ; {Read the link stored ahead of this character.
 $AEAA LD L,(IY-$02) ;
 $AEAD LD H,(IY-$01) ; }
 $AEB0 LD A,H        ; {See whether the pointer is empty.
 $AEB1 OR L          ; }
 $AEB2 EX (SP),HL    ; {Point #REGiy at the link that was in #REGhl.
 $AEB3 POP IY        ; }
 $AEB5 RET           ; Return.

; Step To The Next Clause Record
;
; Used by the routine at #R$AD57.
; .
; Counts down #REGb and follows the clause list, skipping records whose bit 6
; is set. It returns the first record without that bit, leaving the previous
; record in #REGix.
@label=StepToNextClauseRecord
c$AEB6 DEC B          ; Count down one.
*$AEB7 PUSH IY        ; {Keep the previous clause record in #REGix.
 $AEB9 POP IX         ; }
 $AEBB CALL $AEA9     ; Call #R$AEA9 to follow the clause link.
 $AEBE BIT 6,(IY+$01) ; {Jump back to #R$AEB7 if bit 6 of the clause marker is
 $AEC2 JR NZ,$AEB7    ; set.}
 $AEC4 RET            ; Return.

; Step Through The Saved Clause List
;
; Used by the routine at #R$AD57.
; .
; Counts down #REGb and continues at #R$AEC6, which walks the saved clause list
; until the pointer meets #R$9FF0+#N$02 or bit 6 is clear.
@label=StepThroughSavedClauseList
c$AEC5 DEC B         ; Count down one.

; Walk The Saved Clause List
;
; Used by the routines at #R$AEEA and #R$B0FD.
; .
; Follows the clause list from #R$9FF0 until the pointer meets #R$9FF0+#N$02 or bit 6
; of the clause marker is clear.
@label=WalkSavedClauseList
c$AEC6 PUSH IY        ; {Keep the previous clause record in #REGix.
 $AEC8 POP IX         ; }
 $AECA PUSH HL        ; {Call #R$A104 to step pointer and compare, saving
 $AECB PUSH DE        ; pointer and the source.
@label=WalkSavedClauseList_Loop
*$AECC PUSH IY        ;
 $AECE POP DE         ;
 $AECF LD IY,$9FF0    ;
 $AED3 CALL $A104     ; }
 $AED6 PUSH IY        ; {Point #REGhl at this clause record and #REGde at
 $AED8 POP HL         ; #R$9FF0+#N$02, and clear the carry.
 $AED9 LD DE,$9FF2    ;
 $AEDC AND A          ; }
 $AEDD SBC HL,DE      ; See whether this pointer matches #R$9FF0+#N$02.
 $AEDF JR Z,$AEE7     ; Jump ahead to #R$AEE7 if the two pointers meet.
 $AEE1 BIT 6,(IY+$01) ; {Jump to #R$AECC if bit 6 of #REGiy+#N$01 is set.
 $AEE5 JR NZ,$AECC    ; }
@label=WalkSavedClauseList_Next
*$AEE7 POP DE         ; {Restore the saved source and the saved pointer from
 $AEE8 POP HL         ; the stack.}
 $AEE9 RET            ; Return.

; Initialise Character Search
;
; Used by the routines at #R$AD57 and #R$AE6A.
; .
; Starts a character search with no current record, then joins the list walk at
; #R$AEC6.
@label=InitialiseCharacterSearch
c$AEEA LD IY,$0000   ; Start with no current character.
 $AEEE JP $AEC6      ; Jump to the character search routine.

; Merge Character Flags
;
; Used by the routine at #R$AD57.
; .
; Copies the id, script marker and attribute bytes from the character record onto the
; schedule entry so the two stay in step.
@label=MergeCharacterFlags
c$AEF1 EXX           ; {Read the moved marker.
 $AEF2 LD A,(IX+$01) ; }
 $AEF5 AND $7F       ; {Merge #REGa into the byte at #REGiy+#N$01, keeping that
 $AEF7 OR (IY+$01)   ; byte's top bit.
 $AEFA LD (IY+$01),A ; }
 $AEFD LD A,(IX+$00) ; {Store the character id.
 $AF00 LD (IY+$00),A ;
 $AF03 EXX           ; }
 $AF04 LD A,(IX+$04) ; Read the attribute type.
 $AF07 OR (IX+$05)   ; Merge the object attribute into the result.
 $AF0A RET Z         ; Return when this character has no attribute.
 $AF0B LD A,$0E      ; {Return if copying this display entry did not match.
 $AF0D CALL $AF38    ;
 $AF10 RET NZ        ; }
 $AF11 EXX           ; {Switch register sets and point #REGhl at byte #N$12 of
 $AF12 PUSH IY       ; the record at #REGiy.
 $AF14 POP HL        ;
 $AF15 LD DE,$0012   ;
 $AF18 ADD HL,DE     ; }
 $AF19 PUSH HL       ; {Take the graphics: baker street and move the pointer on
 $AF1A LD DE,$FFF6   ; by the length.
 $AF1D ADD HL,DE     ;
 $AF1E POP DE        ; }
 $AF1F LD BC,$0006   ; Take a length of #N$06 bytes.
 $AF22 LDIR          ; {Copy the bytes and take an offset of #N$04.
 $AF24 LD DE,$0004   ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$78B7 }
; LIST#

; Read The Schedule Field
;
; Used by the routine at #R$AD57.
; .
; Sets the copy length from the script position, using two bytes when that
; position is empty.
c$AF27 CALL $AF52    ; Call #R$AF52 to set the copy length to #N$0A.
 $AF2A LD A,(IY+$02) ; {Test whether the word at #REGiy+#N$02-#N$03 is zero.
 $AF2D OR (IY+$03)   ; }
 $AF30 LD DE,$0002   ; Take a length of #N$02 bytes.
; Set copy length 2.
 $AF33 CALL Z,$AF56  ; Call #R$AF56 to set the copy length to #N$02 if the link
                     ; word is zero.
 $AF36 EXX           ; Switch back to the values saved for the caller.
 $AF37 RET           ; Return.

; Copy Schedule Entry
;
; Used by the routine at #R$AEF1.
; .
; Copies the ten-byte schedule entry into the character record the caller is
; building.
@label=CopyScheduleEntry
c$AF38 PUSH DE       ; {Save the source, the count and the pointer.
 $AF39 PUSH BC       ;
 $AF3A PUSH HL       ; }
 $AF3B LD B,$0A      ; Take a count of #N$0A.
 $AF3D PUSH IY       ; {Point #REGhl at the schedule entry and keep #REGa as
 $AF3F POP HL        ; the low byte of the offset.
 $AF40 LD E,A        ; }
 $AF41 LD D,$00      ; Clear the high byte of the source.
 $AF43 ADD HL,DE     ; Advance the pointer by the source length.
 $AF44 XOR A         ; #HTML(Clear #REGa, ready to <code>OR</code> the #N$0A
                     ; bytes together.)
@label=CopyScheduleEntry_Loop
*$AF45 OR (HL)       ; {Or each entry into #REGa and repeat from #R$AF45 until
 $AF46 INC HL        ; #REGb runs out.
 $AF47 DJNZ $AF45    ; }
 $AF49 POP HL        ; {Restore the pointer, the count and the source from the
 $AF4A POP BC        ; stack.
 $AF4B POP DE        ; }
 $AF4C AND A         ; Clear the borrow so an empty entry returns as a failed
                     ; match.
 $AF4D RET           ; Return.
; Sets copy length #N$06.
@label=CopyScheduleEntry_SixBytes
 $AF4E LD C,$06      ; {Jump ahead to #R$AF58 to set copy length #N$06.
 $AF50 JR $AF58      ; }

; Set Copy Length #N$0A
;
; Used by the routine at #R$AF27.
; .
; Chooses a length of #N$0A bytes and copies them from the character record into the
; schedule entry.
@label=SetCopyLengthTen
c$AF52 LD C,$0A      ; {Copy the bytes for the chosen length.
 $AF54 JR $AF58      ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$78FF }
; LIST#

; Set Copy Length #N$02
;
; Used by the routine at #R$AF27.
; .
; Chooses a length of #N$02 bytes and copies them from the character record into the
; schedule entry.
@label=SetCopyLengthTwo
c$AF56 LD C,$02      ; Count #N$02.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7903 }
; LIST#

; Copy Bytes For The Given Length
;
; Used by the routines at #R$AF38 and #R$AF52.
; .
; Advances the destination by the length already chosen, then copies that many bytes from
; the source and returns.
@label=CopyBytes
c$AF58 PUSH IY       ; {Move the pointer on by the length.
 $AF5A POP HL        ;
 $AF5B ADD HL,DE     ;
 $AF5C PUSH HL       ; }
 $AF5D PUSH IX       ; {Copy the destination into the pointer and add the
 $AF5F POP HL        ; length.
 $AF60 ADD HL,DE     ; }
 $AF61 POP DE        ; Restore the saved source from the stack.
 $AF62 LD B,$00      ; Clear the high byte of the count.
 $AF64 LDIR          ; Copy the counted bytes.
 $AF66 RET           ; Return.
; This entry point is used by the routines at #R$AB52, #R$AFB3, #R$AFE1,
; #R$AFE8, #R$B01C and #R$B033.
; .
; Tells the script the command succeeded, leaving #N$01 with the borrow clear. The
; command search and the display steps share this exit.
@label=CopyBytes_ReportSuccess
*$AF67 LD A,$01      ; {Set a non-zero result.
 $AF69 AND A         ; }
 $AF6A RET           ; Return.

; Table: Command Handler Lookup (Standard)
;
; Lookup table for command handlers when *#R$A024 is not equal to #N$02. Each entry consists of a 1-byte first value, a 1-byte second value, and a 2-byte handler pointer.
; Read by #R$AFB3.
@label=Table_CommandHandlerLookup_Standard
g$AF6B DEFB $00      ; First value
 $AF6C DEFB $00      ; Second value
 $AF6D DEFW $B049    ; Handler pointer
 $AF6F DEFB $40      ; First value
 $AF70 DEFB $00      ; Second value
 $AF71 DEFW $B033    ; Handler pointer
 $AF73 DEFB $5E      ; First value
 $AF74 DEFB $01      ; Second value
 $AF75 DEFW $B01C    ; Handler pointer
 $AF77 DEFB $D5      ; First value
 $AF78 DEFB $06      ; Second value
 $AF79 DEFW $AFFF    ; Handler pointer
 $AF7B DEFB $BD      ; First value
 $AF7C DEFB $05      ; Second value
 $AF7D DEFW $B00B    ; Handler pointer
 $AF7F DEFB $07      ; First value
 $AF80 DEFB $05      ; Second value
 $AF81 DEFW $B0A3    ; Handler pointer
 $AF83 DEFB $75      ; First value
 $AF84 DEFB $07      ; Second value
 $AF85 DEFW $B0C6    ; Handler pointer
 $AF87 DEFB $60      ; First value
 $AF88 DEFB $06      ; Second value
 $AF89 DEFW $B09A    ; Handler pointer
 $AF8B DEFB $E3      ; First value
 $AF8C DEFB $03      ; Second value
 $AF8D DEFW $B135    ; Handler pointer
 $AF8F DEFB $88      ; First value
 $AF90 DEFB $04      ; Second value
 $AF91 DEFW $B151    ; Handler pointer
 $AF93 DEFB $F6      ; First value
 $AF94 DEFB $06      ; Second value
 $AF95 DEFW $B0A3    ; Handler pointer
 $AF97 DEFB $B3      ; First value
 $AF98 DEFB $08      ; Second value
 $AF99 DEFW $B151    ; Handler pointer

; Table: Command Handler Lookup (Alternate)
;
; Lookup table for command handlers when *#R$A024 is equal to #N$02. Each entry consists of a 1-byte first value, a 1-byte second value, and a 2-byte handler pointer.
; Read by #R$AFB3.
@label=Table_CommandHandlerLookup_Alternate
g$AF9B DEFB $99      ; First value
 $AF9C DEFB $08      ; Second value
 $AF9D DEFW $B0FD    ; Handler pointer
 $AF9F DEFB $E3      ; First value
 $AFA0 DEFB $03      ; Second value
 $AFA1 DEFW $B13F    ; Handler pointer
 $AFA3 DEFB $88      ; First value
 $AFA4 DEFB $04      ; Second value
 $AFA5 DEFW $B15B    ; Handler pointer
 $AFA7 DEFB $B3      ; First value
 $AFA8 DEFB $08      ; Second value
 $AFA9 DEFW $B15B    ; Handler pointer
 $AFAB DEFB $C5      ; First value
 $AFAC DEFB $00      ; Second value
 $AFAD DEFW $AFFA    ; Handler pointer
 $AFAF DEFB $AE      ; First value
 $AFB0 DEFB $08      ; Second value
 $AFB1 DEFW $AFFA    ; Handler pointer

; Search Command Handler Table
;
; Used by the routines at #R$AAD1 and #R$AB52.
; .
; Searches through a command handler lookup table for a matching value pair and
; jumps to the associated handler routine if found.
;
; B Second value to match
; C First value to match
@label=SearchCommandHandlerTable
c$AFB3 LD HL,$AF6B   ; Set the table pointer to #R$AF6B.
 $AFB6 LD A,($A024)  ; {Check which lookup table to use based on the current
 $AFB9 CP $02        ; mode.}
 $AFBB JR NZ,$AFC0   ; Jump ahead to #R$AFC0 if the mode is not #N$02.
 $AFBD LD HL,$AF9B   ; Point #REGhl at the alternate table at #R$AF9B.
@label=SearchCommandHandlerTable_StartSearch
*$AFC0 PUSH DE       ; {Count #N$0C entries, or #N$06 when the mode is #N$02,
 $AFC1 LD E,$0C      ; keeping the source.
 $AFC3 JR NZ,$AFC7   ;
 $AFC5 LD E,$06      ; }
@label=SearchCommandHandlerTable_Loop
*$AFC7 LD A,(HL)     ; {Check if the first value in the current table entry matches the search
 $AFC8 INC HL        ; value.
 $AFC9 CP C          ; }
 $AFCA JR NZ,$AFD0   ; Skip to the next entry if it doesn't match.
 $AFCC LD A,(HL)     ; {Check if the second value in the current table entry matches the search
 $AFCD CP B          ; value.}
 $AFCE JR Z,$AFDA    ; Jump to the handler if both values match.
@label=SearchCommandHandlerTable_NextEntry
*$AFD0 INC HL        ; {Move to the next table entry.
 $AFD1 INC HL        ;
 $AFD2 INC HL        ; }
 $AFD3 DEC E         ; {Decrease the entry counter and continue searching if
 $AFD4 JR NZ,$AFC7   ; there are more entries.}
@label=SearchCommandHandlerTable_NotFound
 $AFD6 POP DE        ; {Jump back to #R$AF67 to return non-zero.
 $AFD7 JP $AF67      ; }
; Reads the handler address that follows and jumps to it.
; .
; A handler was found, use it!
@label=SearchCommandHandlerTable_Found
*$AFDA INC HL        ; {Load the handler pointer from the table entry.
 $AFDB LD E,(HL)     ;
 $AFDC INC HL        ;
 $AFDD LD D,(HL)     ;
 $AFDE EX DE,HL      ;
 $AFDF POP DE        ; }
 $AFE0 JP (HL)       ; Jump to the handler.
; View the equivalent code in;
; #LIST
; { #HOBBIT$8251 }
; LIST#

; Check Bit And Jump
;
; Used by the routines at #R$AFFF, #R$B00B, #R$B09A, #R$B0A3, #R$B0C6, #R$B135
; and #R$B151.
; .
; Returns when bit 1 of #REGe is set. Otherwise drops the return address and
; jumps to #R$AF67.
@label=CheckBitAndJump
c$AFE1 BIT 1,E       ; See whether bit 1 of the low byte of the source is set.
 $AFE3 RET NZ        ; Return if that marker is set.
 $AFE4 POP HL        ; {Jump back to #R$AF67 to return non-zero.
 $AFE5 JP $AF67      ; }

; Test Bit 1 Of The Source
;
; Used by the routine at #R$B033.
; .
; Returns to the caller when bit 1 of #REGe is clear, and also when the game
; has started and pictures are disabled. Otherwise it drops the return address
; and leaves through #R$AF67.
@label=TestSourceBitOne
c$AFE8 BIT 1,E       ; See whether bit 1 of the source is set.
 $AFEA RET Z         ; Return if that marker is clear.
 $AFEB LD A,($A012)  ; {Jump to #R$AFF6 if the pictures-enabled byte at #R$A012
 $AFEE AND A         ; is set.
 $AFEF JR NZ,$AFF6   ; }
 $AFF1 LD A,($A01B)  ; {Return if the initialised flag is set.
 $AFF4 AND A         ;
 $AFF5 RET NZ        ; }
@label=TestSourceBitOne_DropReturn
*$AFF6 POP HL        ; {Jump back to #R$AF67 to return non-zero.
 $AFF7 JP $AF67      ; }

; Remember The Display Page
;
; Remembers display page #N$A0 and joins the routine that saves the display state.
; Reached through the alternate command table at #R$AF9B, dispatched by #R$AFE0.
@label=RememberDisplayPage
c$AFFA LD D,$A0      ; {Take token #N$A0 and continue at #R$ACCC.
 $AFFC JP $ACCC      ; }

; Save Display State
;
; Tests bit 6 of port #N$FB, and stores #N$01 in the input flag when that bit is clear.
; Reached through the standard command table at #R$AF6B, dispatched by #R$AFE0.
@label=SaveDisplayState
c$AFFF CALL $AFE1    ; {Go to #R$B015 if bit 6 of port #N$FB is set.
 $B002 CALL $C03B    ;
 $B005 JR NZ,$B015   ; }
 $B007 LD A,$01      ; {Take #N$01 and continue at #R$B012.
 $B009 JR $B012      ; }

; Clear The Display Lines
;
; Clears the display lines when the flag test passes, then returns zero.
; Reached through the standard command table at #R$AF6B, dispatched by #R$AFE0.
@label=ClearTheDisplayLines
c$B00B CALL $AFE1    ; {Call #R$AFE1 to test the flag bit, then call #R$A296 to
 $B00E CALL $A296    ; clear the display lines.}
 $B011 XOR A         ; Start from zero.

; Record The Result In The Input Flag
;
; Used by the routine at #R$AFFF.
; .
; Stores the result in the input flag and returns to the game state at #R$B015.
@label=RecordInputFlag
c$B012 LD ($A008),A  ; Store it in the input.
; This entry point is used by the routines at #R$AFFF, #R$B09A, #R$B0A3 and
; #R$B0C6.
; .
; Handles game State.
@label=RecordInputFlag_UseGameState
*$B015 LD A,($A02D)  ; {Jump back to #R$AAC4 with the source byte at #R$A02D in
 $B018 LD D,A        ; #REGd.
 $B019 JP $AAC4      ; }

; Step Display State
;
; Advances the room-display state when the parser flag at #R$A019+#N$01 is #N$01, builds the
; character record, and copies the display.
; Reached through the standard command table at #R$AF6B, dispatched by #R$AFE0.
@label=StepDisplayState
c$B01C LD A,($A01A)   ; {Jump to #R$AF67 if the parser is not #N$01.
 $B01F CP $01         ;
 $B021 JP NZ,$AF67    ; }
 $B024 LD A,$02       ; {Store #N$02 at #R$A019+#N$01 and call #R$AE6A to
 $B026 LD ($A01A),A   ; initialise the character.
 $B029 CALL $AE6A     ; }
 $B02C SET 6,(IY+$01) ; {Jump back to #R$AB52 to copy display if needed.
 $B030 JP $AB52       ; }

; Step Display State When Parser Clear
;
; Takes the next display-state step when the parser flag is clear, sets that flag, and
; copies the display.
; Reached through the standard command table at #R$AF6B, dispatched by #R$AFE0.
@label=StepDisplayStateWhenParserClear
c$B033 CALL $AFE8     ; Call #R$AFE8 to test the low flag bit.
 $B036 LD A,($A01A)   ; {Jump to #R$AF67 if the parser is set.
 $B039 AND A          ;
 $B03A JP NZ,$AF67    ; }
 $B03D LD A,$01       ; {Write #N$01 to the parser.
 $B03F LD ($A01A),A   ; }
 $B042 SET 7,(IY+$01) ; Set bit 7 of #REGiy+#N$01.
 $B046 JP $AB52       ; Jump back to #R$AB52 to copy display if needed.

; Link Character When Flagged
;
; When the action flag is set, stores this character on the display list and allocates a
; record for the next one.
; Reached through the standard command table at #R$AF6B, dispatched by #R$AFE0.
@label=LinkCharacterWhenFlagged
c$B049 BIT 1,E       ; {Jump ahead to #R$B058 if bit 1 is clear.
 $B04B JR Z,$B058    ; }
 $B04D LD HL,$088B   ; {Point #REGhl at #N($088B,$04) and store its low byte at
 $B050 LD (IY+$00),L ; #REGiy+#N$00.}
 $B053 LD (IY+$01),H ; Store #REGh at #REGiy+#N$01.
 $B056 RES 1,E       ; Clear the link bit on this character.
*$B058 PUSH HL       ; {Keep the character record.
 $B059 PUSH DE       ;
 $B05A PUSH IY       ;
 $B05C PUSH IX       ; }
 $B05E LD IY,$9FEC   ; Use the character script entry list (#R$9FEB+#N$01).
 $B062 LD DE,$0000   ; {Call #R$A104 to step pointer and compare.
 $B065 CALL $A104    ; }
 $B068 LD A,$02      ; {Call #R$A11C to allocate #N$02 bytes.
 $B06A CALL $A11C    ; }
 $B06D LD HL,($A02B) ; {Store the low byte of the word at #R$A02B as the
 $B070 LD (IX+$00),L ; record's flag byte.}
 $B073 LD (IX+$01),H ; Store the moved marker.
 $B076 PUSH IX       ; {Store the low byte of the pointer in the previous
 $B078 POP HL        ; record.
 $B079 LD (IY-$02),L ; }
 $B07C LD (IY-$01),H ; Store the high byte of the pointer in the previous
                     ; record.
 $B07F POP IX        ; {Restore the saved character record, the saved schedule
 $B081 POP IY        ; entry, the saved source and the saved pointer from the
 $B083 POP DE        ; stack.
 $B084 POP HL        ; }
@label=LinkCharacterWhenFlagged_Loop
*$B085 CALL $AE7F    ; Call #R$AE7F to save the text pointer.
 $B088 CP $90        ; See whether the text byte is the link marker.
 $B08A JR NZ,$B085   ; Go back to #R$B085 until the text byte is the link
                     ; marker.
 $B08C LD A,B        ; {Jump back to #R$B085 while the low nibble of #REGb or
 $B08D AND $0F       ; #REGc is not zero.
 $B08F OR C          ;
 $B090 JR NZ,$B085   ; }
 $B092 LD HL,($A029) ; {Write #N$C0 through the pointer at #R$A029 and jump
 $B095 LD (HL),$C0   ; back to #R$AB52 to copy display if needed.
 $B097 JP $AB52      ; }

; Wait For A Key
;
; Waits until a key is pressed, then returns to the command state.
; Reached through the standard command table at #R$AF6B, dispatched by #R$AFE0.
@label=WaitForAKey
c$B09A CALL $AFE1    ; {Call #R$AFE1 to test the flag bit, then call #R$C415 to
 $B09D CALL $C415    ; wait for a key.}
 $B0A0 JP $B015      ; Jump back to #R$B015 to handle game state.

; Reset Clock
;
; Puts the clock back to the time a picture starts from, then returns to the game.
; Reached through the standard command table at #R$AF6B, dispatched by #R$AFE0.
@label=ResetClock
c$B0A3 CALL $AFE1    ; {Call #R$AFE1 to test the flag bit, then call #R$B0AC to
 $B0A6 CALL $B0AC    ; initialise the character timer.}
 $B0A9 JP $B015      ; Jump back to #R$B015 to handle game state.

; Initialise Character Timer
;
; Used by the routines at #R$9E74 and #R$B0A3.
; .
; Initialises character timing data by resetting the time ticker, setting the
; character's timer in the character table to zero, and initialising the
; character script cycles counter.
@label=InitialiseCharacterTimer
c$B0AC LD HL,$0000   ; {Reset #R$9FDD to zero.
 $B0AF LD ($9FDD),HL ; }
 $B0B2 LD IX,$9860   ; Point to #R$9860.
 $B0B6 LD (IX+$06),L ; {Set the character's timer to zero.
 $B0B9 LD (IX+$07),H ; }
 $B0BC INC HL        ; {Write #N($0001,$04,$04) to *#R$A01F.
 $B0BD LD ($A01F),HL ; }
 $B0C0 LD A,L        ; {Record the startup flag.
 $B0C1 LD ($A0DA),A  ; }
 $B0C4 AND A         ; Clear the carry so an idle character timer returns as
                     ; not yet running.
 $B0C5 RET           ; Return.

; Start A Fresh Script Cycle
;
; Starts a fresh script cycle and returns to the command state.
; Reached through the standard command table at #R$AF6B, dispatched by #R$AFE0.
@label=StartFreshScriptCycle
c$B0C6 CALL $AFE1    ; Call #R$AFE1 to test the flag bit.
 $B0C9 LD HL,$0001   ; {Write #N($0001,$04,$04) to *#R$A01F.
 $B0CC LD ($A01F),HL ; }
 $B0CF LD A,$02      ; {Write #N$02 to the startup flag at #R$A0DA and jump
 $B0D1 LD ($A0DA),A  ; back to #R$B015.
 $B0D4 JP $B015      ; }

; Load Game State
;
; Used by the routine at #R$A0EB.
; .
; Reads a stored game back into the working state.
;
; O:IY Restored game state pointer
@label=LoadGameState
c$B0D7 CALL $B0EE    ; {Call #R$B0EE to calculate the location offset, then
 $B0DA CALL $C0DF    ; call #R$C0DF to load the game.}
 $B0DD JR NC,$B0D7   ; Jump back to #R$B0D7 if there was a tape loading error to try
                     ; again.
 $B0DF LD IY,($9FD4) ; Read the saved character pointer.
 $B0E3 RET           ; Return.

; Save Game State
;
; Used by the routine at #R$A0F1.
; .
; Writes the working state out so the game can be restored.
;
; IY Game state pointer to save
@label=SaveGameState
c$B0E4 LD ($9FD4),IY ; {Call #R$B0EE to calculate location offset.
 $B0E8 CALL $B0EE    ; }
 $B0EB JP $C040      ; Jump to #R$C040 to save game.

; Calculate Location Offset
;
; Used by the routines at #R$B0D7 and #R$B0E4.
; .
; Subtracts the location table at #R$840B from the room pointer and returns
; that distance.
;
; O:DE Offset from base location address
@label=CalculateLocationOffset
c$B0EE LD IX,$840B   ; {Use the locations at #R$840B and the character script
 $B0F2 LD HL,$A01F   ; cycle at #R$A01F.}
 $B0F5 LD DE,$840B   ; Use the locations at #R$840B.
 $B0F8 AND A         ; Clear the carry before subtracting the two room
                     ; pointers.
 $B0F9 SBC HL,DE     ; Measure the gap between the two pointers.
 $B0FB EX DE,HL      ; Hand the offset back in #REGde.
 $B0FC RET           ; Return.

; Process Character Data
;
; Follows the character link, and calls #R$AEC6 when bit 3 of the flag is clear.
; Reached through the alternate command table at #R$AF9B, dispatched by #R$AFE0.
@label=ProcessCharacterData
c$B0FD LD BC,$0008   ; {Jump ahead to #R$B107 if bit 3 is present.
 $B100 BIT 3,E       ;
 $B102 JR NZ,$B107   ; }
 $B104 CALL $AEC6    ; Call #R$AEC6 to walk the saved clause list.
@label=ProcessCharacterData_Next
*$B107 PUSH IY       ; {Run character data.
 $B109 POP HL        ;
 $B10A ADD HL,BC     ;
 $B10B PUSH DE       ;
 $B10C PUSH HL       ; }
 $B10D BIT 3,E       ; {Jump ahead to #R$B118 if bit 3 is present.
 $B10F JR NZ,$B118   ; }
 $B111 SET 3,E       ; Mark this character as already linked.
 $B113 CALL $AEA9    ; Call #R$AEA9 to follow the character link.
 $B116 JR $B11F      ; Jump ahead to #R$B11F to step on #N$18 bytes.
; Mark another picture enabled and initialise the character.
@label=ProcessCharacterData_PicturesEnabledPointer
*$B118 LD HL,$A012   ; {Call #R$AE6A to initialise character data structure.
 $B11B INC (HL)      ;
 $B11C CALL $AE6A    ; }
@label=ProcessCharacterData_LengthCharacters
*$B11F PUSH IY       ; {Point #REGhl #N$18 bytes past #REGiy and restore
 $B121 POP HL        ; #REGde.
 $B122 LD BC,$0018   ;
 $B125 ADD HL,BC     ;
 $B126 POP DE        ; }
 $B127 EX DE,HL      ; {Swap the pointers, copy #N$06 bytes.
 $B128 LD BC,$0006   ;
 $B12B LDIR          ; }
 $B12D POP DE        ; Restore #REGde from the stack.
; This entry point is used by the routines at #R$B13F and #R$B15B.
; .
; Read the low byte of the source, then mark bits 0, 1, 2, 6, 7 on the result,
; then store the result in the low byte of the source.
*$B12E LD A,E        ; {Jump back to #R$AAD1 to prepare character for display.
 $B12F OR $C7        ;
 $B131 LD E,A        ;
 $B132 JP $AAD1      ; }

; Set Display Mode #N$02
;
; Selects picture mode and marks the primary picture bit.
; Reached through the standard command table at #R$AF6B, dispatched by #R$AFE0.
@label=SetDisplayMode_SelectsPictureMode
c$B135 CALL $AFE1    ; Call #R$AFE1 to test the flag bit.
 $B138 LD A,$02      ; {Set the command mode at #R$A024 to #N$02 and continue
 $B13A LD ($A024),A  ; at #R$B14B.
 $B13D JR $B14B      ; }

; Follow Link When Flagged
;
; Follows the link when bit 3 of the display flags is present.
; Reached through the alternate command table at #R$AF9B, dispatched by #R$AFE0.
@label=FollowLinkWhenFlagged
c$B13F BIT 3,E        ; {Jump ahead to #R$B14B if bit 3 is clear.
 $B141 JR Z,$B14B     ; }
 $B143 PUSH DE        ; {Call #R$AEA9 to follow the character link, saving
 $B144 CALL $AEA9     ; source.}
 $B147 CALL $AE6A     ; {Call #R$AE6A to initialise character data structure.
 $B14A POP DE         ; }
; This entry point is used by the routine at #R$B135.
; .
; Set the mark on this character.
@label=FollowLinkWhenFlagged_MarkTopBit
*$B14B SET 7,(IY+$19) ; {Set bit 7 of #REGiy+#N$19 and jump back to #R$B12E.
 $B14F JR $B12E       ; }

; Select Picture Mode Alternate
;
; Selects picture mode and marks the secondary picture bit.
; Reached through the standard command table at #R$AF6B, dispatched by #R$AFE0.
@label=SelectPictureModeAlternate
c$B151 CALL $AFE1    ; Call #R$AFE1 to test the flag bit.
 $B154 LD A,$02      ; {Set the command mode at #R$A024 to #N$02 and continue
 $B156 LD ($A024),A  ; at #R$B167.
 $B159 JR $B167      ; }

; Initialise When Flagged
;
; Initialises the character when bit 3 of the display flags is present.
; Reached through the alternate command table at #R$AF9B, dispatched by #R$AFE0.
@label=InitialiseWhenFlagged
c$B15B BIT 3,E        ; {Jump ahead to #R$B167 if bit 3 is clear.
 $B15D JR Z,$B167     ; }
 $B15F PUSH DE        ; {Call #R$AEA9 to follow the character link, saving
 $B160 CALL $AEA9     ; source.}
 $B163 CALL $AE6A     ; {Call #R$AE6A to initialise character data structure.
 $B166 POP DE         ; }
; This entry point is used by the routine at #R$B151.
; .
; Set the mark on this character.
@label=InitialiseWhenFlagged_MarkBitSix
*$B167 SET 6,(IY+$19) ; {Set bit 6 of #REGiy+#N$19 and jump back to #R$B12E.
 $B16B JR $B12E       ; }

; Display Flag
;
; Flag byte for display processing (bit 1 indicates objects have been processed).
; Read by #R$B191, #R$B405, #R$B4FD, #R$B5B6 and #R$B633.
@label=DisplayFlag
g$B16D DEFB $00
 $B16E DEFB $00,$00  ; Display flag word.
 $B170 DEFB $00      ; Count of passes through the primary display flag.
 $B171 DEFB $00      ; Count of passes through the secondary display flag.

; Display Data Pointer
;
; Pointer to display data used for processing room displays.
; Read by #R$B191, #R$B405, #R$B4A3, #R$B4FD, #R$B5B6, #R$B633, #R$BD7E and #R$BE3C.
@label=DisplayDataPointer
g$B172 DEFB $00

; Display Mode Flag
;
; Flag controlling display mode (bit 7 indicates special display mode).
; Read by #R$B4A3, #R$B4C1 and #R$B633.
@label=DisplayModeFlag
g$B173 DEFB $00
 $B174 DEFW $0000           ; Saved display pointer, read by #R$B191.
 $B176 DEFW $0000           ; Saved display pointer, read by #R$B191.
 $B178 DEFB $00             ; Low byte of the display mode word, read by
                            ; #R$B405, #R$B54A, #R$B5A4, #R$B5B6, #R$B633,
                            ; #R$BD7E and #R$BE4B.
 $B179 DEFB $00             ; High byte of the display mode flag, read by
                            ; #R$B54A, #R$B568 and #R$B633.
 $B17A DEFB $00,$00,$00,$00 ; Bytes beside the display mode word.

; Object Table Pointer
;
; Pointer to the current position in the object table being processed.
; Read by #R$B308, #R$B34F, #R$B4C1, #R$B936 and #R$D6C1.
@label=ObjectTablePointer
g$B17E DEFW $0000
 $B180 DEFB $00,$00,$00,$00
 $B184 DEFB $00                 ; Saved room display parameter. Written by
                                ; #R$B22E and #R$B2A1, and read by #R$B244 and
                                ; #R$B2B7.
 $B185 DEFB $00,$00,$00
 $B188 DEFB $00,$00             ; Saved display pointer, read by #R$B405.
 $B18A DEFB $00,$00             ; Saved display pointer, read by #R$B405.
 $B18C DEFB $00,$00,$00,$00,$00

; Initialise Display Buffer
;
; Used by the routines at #R$B936 and #R$D6C1.
; .
; Clears the room parameters and the display buffer, then looks for a room
; record.
@label=InitialiseDisplayBuffer
c$B191 LD A,$FF      ; {Write #N$FF to the room graphics parameter and write #N$FF to the room
 $B193 LD ($A035),A  ; display parameter.
 $B196 LD ($A034),A  ; }
 $B199 LD HL,$B16D   ; {Call #R$A2AB to clear buffer.
 $B19C LD B,$11      ;
 $B19E CALL $A2AB    ; }
 $B1A1 CALL $B39D    ; {Go to #R$B1AB if a room record matches.
 $B1A4 JR NZ,$B1AB   ; }
 $B1A6 LD HL,$B84C   ; Leave the object-table handler at #R$B84C.
 $B1A9 XOR A         ; Clear #REGa.
 $B1AA RET           ; Return.
@label=InitialiseDisplayBuffer_Next
*$B1AB LD A,$01      ; {Use the object runtime table (#R$8259).
 $B1AD PUSH IX       ;
 $B1AF POP HL        ;
 $B1B0 LD DE,$8259   ; }
 $B1B3 SBC HL,DE     ; {Jump ahead to #R$B1BF if the two pointers meet.
 $B1B5 JR Z,$B1BF    ; }
 $B1B7 LD DE,$0008   ; Take a length of #N$08 entries.
@label=InitialiseDisplayBuffer_Loop
*$B1BA INC A         ; {Count one more record and go back to #R$B1BA until the
 $B1BB SBC HL,DE     ; pointer reaches the base.
 $B1BD JR NZ,$B1BA   ; }
@label=InitialiseDisplayBuffer_RecordSavedCharacter
*$B1BF LD ($A033),A  ; {Store this record count as the saved character and keep
 $B1C2 LD ($B18E),IX ; the object pointer at #R$B18C+#N$02.}
 $B1C6 CP $2E        ; {Go to #R$B1DD if it is not #N$2E.
 $B1C8 JR NZ,$B1DD   ; }
 $B1CA LD HL,$B16D   ; {Test bit 0 of the display flag at #R$B16D and take
 $B1CD BIT 0,(HL)    ; #R$9FEE+#N$14.
 $B1CF LD HL,$A002   ; }
 $B1D2 LD DE,$B172   ; {Point #REGde at the display data pointer at #R$B172 and
 $B1D5 LD BC,$0006   ; take #N$06 bytes. Skip the swap when bit 0 of the
 $B1D8 JR Z,$B1DB    ; display flag is clear.}
 $B1DA EX DE,HL      ; Swap the two pointers.
@label=InitialiseDisplayBuffer_CopyTheseBytes
*$B1DB LDIR          ; Copy these bytes across.
@label=InitialiseDisplayBuffer_CheckDisplayFlag
*$B1DD CALL $C493    ; {Call #R$C493 to test bits 3 and 7 of the object
 $B1E0 CALL $C4B2    ; attribute, then call #R$C4B2 to test bits 2 and 6.}
 $B1E3 LD A,($A01C)  ; {Jump to #R$B1F2 if the display flag at #R$A01C is set.
 $B1E6 AND A         ;
 $B1E7 JR NZ,$B1F2   ; }
 $B1E9 LD A,($B39C)  ; {Copy the display flag at #R$B39C into #R$A01C and call
 $B1EC LD ($A01C),A  ; #R$B34F to report that this display step found nothing.
 $B1EF CALL $B34F    ; }
@label=InitialiseDisplayBuffer_RecordObjectTable
*$B1F2 LD A,($A01E)  ; {Keep bit 4 of the display flag at #R$A01E in the saved
 $B1F5 AND $10       ; flag at #R$B17E+#N$12.
 $B1F7 LD ($B190),A  ; }
 $B1FA JR Z,$B200    ; Go to #R$B200 if bit 4 of the saved flag is clear.
 $B1FC XOR A         ; {Clear the display flag at #R$A01C.
 $B1FD LD ($A01C),A  ; }
@label=InitialiseDisplayBuffer_ClearParser
*$B200 XOR A         ; {Clear the parser flag at #R$A00B.
 $B201 LD ($A00B),A  ; }
; A bit from #N$0C is set in the object attribute value?
 $B204 LD A,($A01D)  ; {Go to #R$B213 if bit 2 or bit 3 of the object attribute
 $B207 AND $0C       ; is set.
 $B209 JR NZ,$B213   ; }
@label=InitialiseDisplayBuffer_BytesDiffer
*$B20B CALL $C929    ; {Return if drawing the object did not match.
 $B20E RET NZ        ; }
 $B20F LD HL,$B863   ; Leave the object-display handler at #R$B863.
 $B212 RET           ; Return.
; Reads the object attribute, and refreshes the room when the display flag is
; clear.
@label=InitialiseDisplayBuffer_ReadsObjectAttribute
*$B213 CALL $B387    ; {Call #R$B387 to read the object attribute, and go to
 $B216 JR NZ,$B280   ; #R$B280 if it returns non-zero.}
 $B218 LD A,($A01C)  ; {Jump to #R$B224 if the display flag at #R$A01C is set.
 $B21B AND A         ;
 $B21C JR NZ,$B224   ; }
 $B21E CALL $B308    ; {Jump ahead to #R$B259 if the pass count at #R$B170 is
 $B221 AND A         ; zero.
 $B222 JR Z,$B259    ; }
@label=InitialiseDisplayBuffer_TestFlagDisplay
*$B224 CALL $B4C1    ; {Go to #R$B244 if #R$B4C1 returns zero.
 $B227 JR Z,$B244    ; }
 $B229 CALL $C929    ; {Jump back to #R$B224 while the object has nothing to
 $B22C JR Z,$B224    ; display.}
 $B22E LD A,($A034)  ; {Save the room display parameter at #R$B184.
 $B231 LD ($B184),A  ; }
 $B234 LD HL,$B170   ; Point #REGhl at the pass count at #R$B170.
 $B237 INC (HL)      ; {Count one more pass at #R$B170, and jump to #R$B244 if
 $B238 LD A,($B190)  ; the saved flag is set.
 $B23B AND A         ;
 $B23C JR NZ,$B244   ; }
 $B23E LD A,($A01C)  ; {Jump to #R$B224 if the display flag at #R$A01C is zero.
 $B241 AND A         ;
 $B242 JR Z,$B224    ; }
@label=InitialiseDisplayBuffer_RecordRoomDisplay
*$B244 LD A,($B184)  ; {Record the room display parameter.
 $B247 LD ($A034),A  ; }
 $B24A LD A,($B170)  ; {Jump to #R$B259 if the pass count at #R$B170 is zero.
 $B24D AND A         ;
 $B24E JR Z,$B259    ; }
 $B250 CP $01        ; {Go to #R$B20B if it is #N$01.
 $B252 JR Z,$B20B    ; }
 $B254 LD HL,$B5E2   ; Leave the display handler at #R$B5E2.
 $B257 XOR A         ; Clear #REGa.
 $B258 RET           ; Return.
; Carry on only when the saved character is a full stop and the display flags
; are clear.
@label=InitialiseDisplayBuffer_SavedCharacterCheck
*$B259 LD A,($A033)  ; {Jump to #R$B27B if the saved character is not #N$2E.
 $B25C CP $2E        ;
 $B25E JR NZ,$B27B   ; }
 $B260 LD A,($A01C)  ; {Jump to #R$B27B if the display is set.
 $B263 AND A         ;
 $B264 JR NZ,$B27B   ; }
 $B266 LD HL,$B16D   ; {Go to #R$B27B if bit 0 of this byte is set.
 $B269 BIT 0,(HL)    ;
 $B26B JR NZ,$B27B   ; }
 $B26D LD HL,$0000   ; {Clear the display data pointer at #R$B172.
 $B270 LD ($B172),HL ; }
 $B273 LD ($B174),HL ; Clear the saved display pointer at #R$B173+#N$01.
 $B276 LD ($B176),HL ; {Clear the saved display pointer at #R$B176 and jump
 $B279 JR $B213      ; back to #R$B213 for the next object attribute.}
; Leave the display handler at #R$B65F and return zero.
@label=InitialiseDisplayBuffer_LeaveDisplayHandler
*$B27B LD HL,$B65F   ; Leave the display handler at #R$B65F.
 $B27E XOR A         ; Clear #REGa.
 $B27F RET           ; Return.
; Reads the display flag, and follows the secondary flag when the first one is
; clear.
@label=InitialiseDisplayBuffer_ReadsDisplayFlag
*$B280 LD A,($A01C)  ; {Jump to #R$B292 if the display is set.
 $B283 AND A         ;
 $B284 JR NZ,$B292   ; }
 $B286 CALL $B308    ; {Jump back to #R$B259 if the display is zero.
 $B289 AND A         ;
 $B28A JR Z,$B259    ; }
 $B28C CALL $B32D    ; {Go to #R$B303 if #R$B32D returns zero.
 $B28F AND A         ;
 $B290 JR Z,$B303    ; }
@label=InitialiseDisplayBuffer_TestFlagDisplayAgain
*$B292 CALL $B4C1    ; {Go to #R$B2B7 if #R$B4C1 returns zero.
 $B295 JR Z,$B2B7    ; }
 $B297 CALL $B2DF    ; Call #R$B2DF to read the room graphics parameter.
 $B29A LD A,($B171)  ; {Jump to #R$B292 if the pass count at #R$B171 is not
 $B29D CP $01        ; #N$01.
 $B29F JR NZ,$B292   ; }
 $B2A1 LD A,($A034)  ; {Save the room display parameter at #R$B184.
 $B2A4 LD ($B184),A  ; }
 $B2A7 LD HL,$B170   ; Point #REGhl at the pass count at #R$B170.
 $B2AA INC (HL)      ; {Count one more pass at #R$B170, and jump to #R$B2B7 if
 $B2AB LD A,($B190)  ; the saved flag is set.
 $B2AE AND A         ;
 $B2AF JR NZ,$B2B7   ; }
 $B2B1 LD A,($A01C)  ; {Jump to #R$B292 if the display is zero.
 $B2B4 AND A         ;
 $B2B5 JR Z,$B292    ; }
@label=InitialiseDisplayBuffer_RecordRoomDisplayAgain
*$B2B7 LD A,($B184)  ; {Record the room display parameter.
 $B2BA LD ($A034),A  ; }
 $B2BD LD A,($B170)  ; {Jump to #R$B259 if the pass count at #R$B170 is zero.
 $B2C0 AND A         ;
 $B2C1 JR Z,$B259    ; }
 $B2C3 CP $01        ; {Go to #R$B2DA if it is not #N$01.
 $B2C5 JR NZ,$B2DA   ; }
 $B2C7 CALL $B2DF    ; Call #R$B2DF to read the room graphics parameter.
 $B2CA LD A,($B171)  ; {Jump to #R$B303 if the pass count at #R$B171 is zero.
 $B2CD AND A         ;
 $B2CE JR Z,$B303    ; }
 $B2D0 CP $01        ; {Go to #R$B20B if it is #N$01.
 $B2D2 JP Z,$B20B    ; }
 $B2D5 LD HL,$B5D3   ; Leave the display handler at #R$B5D3.
 $B2D8 XOR A         ; Clear #REGa.
 $B2D9 RET           ; Return.
; Leave the display handler at #R$B5E2 and return zero.
@label=InitialiseDisplayBuffer_LeaveDisplayHandlerAgain
*$B2DA LD HL,$B5E2   ; Leave the display handler at #R$B5E2.
 $B2DD XOR A         ; Clear #REGa.
 $B2DE RET           ; Return.

; Read The Room Graphics Parameter
;
; Used by the routine at #R$B191.
; .
; Asks the picture handler whether this object has anything to draw.
@label=ReadRoomGraphicsParameter
c$B2DF CALL $B36B    ; Call #R$B36B to report that this display step found
                     ; nothing.
*$B2E2 CALL $B568    ; {Go to #R$B2FC if bit 7 of the display mode flag at
 $B2E5 JR Z,$B2FC    ; #R$B179 is set or the handler returns #N$FF.}
 $B2E7 CALL $C929    ; {Jump back to #R$B2E2 while the object has nothing to
 $B2EA JR Z,$B2E2    ; display.}
 $B2EC LD A,($A035)  ; {Save the room graphics parameter at #R$B185.
 $B2EF LD ($B185),A  ; }
 $B2F2 LD HL,$B171   ; Point #REGhl at the pass count at #R$B171.
 $B2F5 INC (HL)      ; {Count one more pass at #R$B171 and jump back to #R$B2E2
 $B2F6 LD A,($B190)  ; if the saved flag at #R$B17E+#N$12 is zero.
 $B2F9 AND A         ;
 $B2FA JR Z,$B2E2    ; }
@label=ReadRoomGraphicsParameter_RecordRoomGraphics
*$B2FC LD A,($B185)  ; {Record the room graphics parameter.
 $B2FF LD ($A035),A  ; }
 $B302 RET           ; Return.
; This entry point is used by the routine at #R$B191.
; .
; Leave the room-graphics handler at #R$B6AE and return zero.
@label=ReadRoomGraphicsParameter_LeaveRoomGraphics
*$B303 LD HL,$B6AE   ; Leave the room-graphics handler at #R$B6AE.
 $B306 XOR A         ; Clear #REGa.
 $B307 RET           ; Return.

; Read The Display Setup Flag
;
; Used by the routine at #R$B191.
; .
; Reads the object table pointer, calls #R$B34F, and tests bit 7 of the display
; flag.
@label=ReadDisplaySetupFlag
c$B308 LD HL,($B17E) ; {Read the object table pointer and keep it with the flag
 $B30B PUSH HL       ; at #R$B4A2.
 $B30C LD A,($B4A2)  ;
 $B30F PUSH AF       ; }
 $B310 CALL $B34F    ; Call #R$B34F to report that this display step found
                     ; nothing.
*$B313 CALL $B4C1    ; {Go to #R$B31E if #R$B4C1 returns zero.
 $B316 JR Z,$B31E    ; }
 $B318 LD HL,$B170   ; {Count one more in #R$B170 and try the next entry from
 $B31B INC (HL)      ; #R$B313.
 $B31C JR $B313      ; }
; Store the result in the display setup flag before returning.
@label=ReadDisplaySetupFlag_ResultDisplaySetup
*$B31E POP AF        ; {Record the display setup flag.
 $B31F LD ($B4A2),A  ;
 $B322 LD HL,$B170   ; }
 $B325 LD A,(HL)     ; {Clear the display-setup flag and keep the object-table
 $B326 LD (HL),$00   ; pointer.
 $B328 POP HL        ;
 $B329 LD ($B17E),HL ; }
 $B32C RET           ; Return.

; Read The Secondary Display Flag
;
; Used by the routine at #R$B191.
; .
; Reads the secondary display pointer, calls #R$B36B, and tests bit 7 of the
; display mode flag at #R$B179.
@label=ReadSecondaryDisplayFlag
c$B32D LD HL,($B180) ; {Call #R$B36B to report that this display step found
 $B330 PUSH HL       ; nothing.
 $B331 CALL $B36B    ; }
 $B334 LD A,($B549)  ; {Read the display.
 $B337 PUSH AF       ; }
@label=ReadSecondaryDisplayFlag_TestFlagDisplay
*$B338 CALL $B568    ; {Go to #R$B343 if bit 7 of the display mode flag at
 $B33B JR Z,$B343    ; #R$B179 is set or the handler returns #N$FF.}
 $B33D LD HL,$B171   ; {Count one more in #R$B171 and try the next entry from
 $B340 INC (HL)      ; #R$B338.
 $B341 JR $B338      ; }
; Store the result in the display flag, then read the working value before
; returning.
@label=ReadSecondaryDisplayFlag_ResultDisplayFlag
*$B343 POP AF        ; Restore the saved result from the stack.
 $B344 LD ($B549),A  ; Record the result in the display flag at #R$B549.
 $B347 LD A,($B171)  ; Read the pass count at #R$B171.
 $B34A POP HL        ; Restore the saved pointer from the stack.
 $B34B LD ($B180),HL ; Store it at #R$B180.
 $B34E RET           ; Return.

; Report An Empty Display Step
;
; Used by the routines at #R$B191 and #R$B308.
; .
; Tells the caller this display step found nothing.
@label=ReportEmptyDisplayStep
c$B34F XOR A         ; {Clear the pass count at #R$B170 and take #N$FF.
 $B350 LD ($B170),A  ;
 $B353 LD A,$FF      ; }
 $B355 LD ($B4A2),A  ; Record the display setup flag.
; Adjust object table for sum.
 $B358 CALL $D04F    ; Call #R$D04F to point the object list at this room.
 $B35B LD A,($A00F)  ; {Jump to #R$B366 if the display mode is at least #N$07.
 $B35E CP $07        ;
 $B360 JR NC,$B366   ; }
 $B362 LD IX,$0000   ; Move through the record.
@label=ReportEmptyDisplayStep_RecordCharacter
*$B366 LD ($B17E),IX ; Record the character record in the object table pointer
                     ; at #R$B17E.
 $B36A RET           ; Return.

; Report The Next Empty Display Step
;
; Used by the routines at #R$B2DF and #R$B32D.
; .
; Tells the caller this display step found nothing.
@label=ReportNextEmptyDisplayStep
c$B36B XOR A         ; {Clear the display flag.
 $B36C LD ($B171),A  ;
 $B36F LD A,$FF      ; }
 $B371 LD ($B549),A  ; Record the result in the display flag at #R$B549.
; Adjust object table for sum.
 $B374 CALL $D04F    ; Call #R$D04F to point the object list at this room.
 $B377 LD A,($A010)  ; {Jump to #R$B382 if the display mode is at least #N$07.
 $B37A CP $07        ;
 $B37C JR NC,$B382   ; }
 $B37E LD IX,$0000   ; Move through the record.
@label=ReportNextEmptyDisplayStep_RecordCharacter
*$B382 LD ($B180),IX ; Store the character record at #R$B180.
 $B386 RET           ; Return.

; Read The Object Attribute
;
; Used by the routine at #R$B191.
; .
; Returns the object attribute when its bit 2 is clear, or when bit 0 of
; #R$B16E is set. Returns zero when bit 1 of the attribute is set.
@label=ReadObjectAttribute
c$B387 LD A,($A01D)  ; Read the object attribute.
 $B38A BIT 2,A       ; See whether bit 2 of it is set.
 $B38C RET Z         ; Return if that marker is clear.
 $B38D LD HL,$B16E   ; Point at the display flag.
 $B390 BIT 0,(HL)    ; See whether the display flag is set.
 $B392 RET NZ        ; Return if that marker is set.
 $B393 BIT 1,A       ; {Jump ahead to #R$B39A if bit 1 of the attribute is set.
 $B395 JR NZ,$B39A   ; }
 $B397 OR %00000001  ; Reset the zero flag.
 $B399 RET           ; Return.
@label=ReadObjectAttribute_SignalStepFailed
*$B39A XOR A         ; Clear #REGa.
 $B39B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7AD8 }
; LIST#

; Flags: Display
;
; Display flag beside #R$B39D.
; Read by #R$B191 and #R$B39D.
g$B39C DEFB $00

; Process Display Pointer
;
; Used by the routine at #R$B191.
; .
; Stores the result in the display, then clears the mark on this character.
@label=ProcessDisplayPointer
c$B39D PUSH IY       ; {Read the word at #REGiy+#N$00-#N$01 into #REGhl,
 $B39F LD L,(IY+$00) ; keeping #REGiy.
 $B3A2 LD H,(IY+$01) ; }
 $B3A5 LD A,H        ; Read the high byte of the pointer.
 $B3A6 AND $80       ; Keep bit 7.
 $B3A8 LD ($B39C),A  ; Record the result in the display flag at #R$B39C.
 $B3AB RES 7,H       ; Clear the top bit of the pointer.
 $B3AD LD ($B186),HL ; {Store the pointer at #R$B185+#N$01 and read the low
 $B3B0 LD L,(IY+$02) ; byte at #REGiy+#N$02.}
 $B3B3 LD H,(IY+$03) ; Read the high byte at #REGiy+#N$03.
 $B3B6 LD ($B18C),HL ; {Store that word at #R$B18C and push the pointer at
 $B3B9 LD HL,$B188   ; #R$B188.
 $B3BC PUSH HL       ; }
 $B3BD LD B,$04      ; Take #N$04 bytes for #R$A2AB to clear.
 $B3BF CALL $A2AB    ; {Call #R$A2AB to clear buffer.
 $B3C2 POP HL        ; }
 $B3C3 LD B,$02      ; {Take #N$02 bytes and call #R$B483 to copy the character
 $B3C5 LD E,$04      ; into the display.
 $B3C7 CALL $B483    ; }
 $B3CA LD E,$0E      ; {Take #N$0E and call #R$B483 to copy the character into
 $B3CC CALL $B483    ; the display.}
 $B3CF LD E,$06      ; {Take #N$06 and call #R$B483 to copy the character into
 $B3D1 CALL $B483    ; the display.}
 $B3D4 LD E,$10      ; {Take #N$10 and call #R$B483 to copy the character into
 $B3D6 CALL $B483    ; the display.}
 $B3D9 XOR A         ; {Clear the byte at #R$A02E and point #REGhl at
 $B3DA LD ($A02E),A  ; #R$B17E+#N$08.
 $B3DD LD HL,$B186   ; }
 $B3E0 LD DE,$0008   ; Take a length of #N$08 entries.
 $B3E3 LD IX,$8259   ; Use the object runtime table (#R$8259).
@label=ProcessDisplayPointer_Loop
*$B3E7 PUSH IX       ; {Use the character record as the schedule entry.
 $B3E9 POP IY        ; }
 $B3EB CALL $A4CD    ; Call #R$A4CD to compare location data.
 $B3EE JR Z,$B3FD    ; Go to #R$B3FD if the room fields match.
 $B3F0 ADD IX,DE     ; Step to the next display entry.
 $B3F2 LD A,(IX+$01) ; {Go back to #R$B3E7 if this object word is not zero.
 $B3F5 OR (IX+$00)   ;
 $B3F8 JR NZ,$B3E7   ; }
 $B3FA POP IY        ; Restore the saved schedule entry from the stack.
 $B3FC RET           ; Return.
; Restores the character, swaps the display pointers, and leaves a non-zero
; result.
@label=ProcessDisplayPointer_Next
*$B3FD POP IY        ; Restore the saved schedule entry from the stack.
 $B3FF CALL $B405    ; Call #R$B405.
 $B402 OR %00000001  ; Reset the zero flag.
 $B404 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7B9E }
; LIST#

; Swap The Object Display Pointers
;
; Used by the routine at #R$B39D.
; .
; When the count is still set, swaps the two display pointers and reads the
; object flags.
@label=SwapObjectDisplayPointers
c$B405 AND A         ; {Jump ahead to #R$B416 if the count is zero.
 $B406 JR Z,$B416    ; }
 $B408 LD HL,($B188) ; {Read the two pointers at #R$B188 and #R$B17E+#N$0C.
 $B40B LD DE,($B18A) ; }
 $B40F LD ($B188),DE ; Store the pointer from #REGde at #R$B188.
 $B413 LD ($B18A),HL ; Store the pointer from #REGhl at #R$B18A.
; Extract object attributes.
@label=SwapObjectDisplayPointers_ExtractObjectAttributes
*$B416 CALL $A2BD    ; Call #R$A2BD to read the object's flags.
 $B419 LD HL,$B188   ; {Jump ahead to #R$B426 when the saved display pointer at
 $B41C LD A,(HL)     ; #R$B188 is set.
 $B41D INC HL        ;
 $B41E OR (HL)       ;
 $B41F JR NZ,$B426   ; }
 $B421 LD A,($A01E)  ; {Take the display flag and continue at #R$B445.
 $B424 JR $B445      ; }
; Step back to the object id and see whether it matches the schedule.
@label=SwapObjectDisplayPointers_TestStepObjectMatches
*$B426 DEC HL        ; {Jump ahead to #R$B435 if this id does not match the
 $B427 LD A,(HL)     ; schedule entry.
 $B428 CP (IY+$0E)   ;
 $B42B JR NZ,$B435   ; }
 $B42D INC HL        ; {Jump ahead to #R$B440 if this id matches the schedule
 $B42E LD A,(HL)     ; entry.
 $B42F CP (IY+$0F)   ;
 $B432 JR Z,$B440    ; }
 $B434 DEC HL        ; Step back one entry.
*$B435 LD A,(HL)     ; {Go to #R$B440 if this display byte does not match the
 $B436 CP (IY+$10)   ; schedule.
 $B439 JR NZ,$B440   ; }
 $B43B INC HL        ; {Read the next display byte and compare it with
 $B43C LD A,(HL)     ; #REGiy+#N$11.
 $B43D CP (IY+$11)   ; }
@label=SwapObjectDisplayPointers_ObjectAttributeContinue
*$B440 LD A,($A01D)  ; {Take the object attribute and continue at #R$B447 when
 $B443 JR NZ,$B447   ; the display byte does not match #REGiy+#N$11.}
@label=SwapObjectDisplayPointers_RunDisplayPointer
*$B445 XOR $20       ; Flip bit 5 of the value.
@label=SwapObjectDisplayPointers_TestBitClear
*$B447 BIT 5,A       ; {Jump ahead to #R$B451 if bit 5 is clear.
 $B449 LD BC,$1208   ;
 $B44C JR Z,$B451    ; }
 $B44E LD BC,$0812   ; Take #N$0812 for the display.
@label=SwapObjectDisplayPointers_ObjectTablePointer
*$B451 LD HL,$B182   ; {Use the object table pointer (#R$B17E+#N$04).
 $B454 LD (HL),B     ;
 $B455 INC HL        ;
 $B456 LD (HL),C     ;
 $B457 LD A,B        ; }
 $B458 LD DE,$B172   ; Take the display data pointer.
 $B45B LD HL,$B16D   ; {Point #REGhl at the display flag at #R$B16D and call
 $B45E CALL $B468    ; #R$B468 to copy six bytes.}
 $B461 LD A,C        ; {Take the attribute count and point at the second
 $B462 LD DE,$B178   ; display flag.
 $B465 LD HL,$B16E   ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$7C23 }
; LIST#

; Copy Six Display Bytes
;
; Used by the routine at #R$B405.
; .
; Copies six display bytes and reports failure when every copied byte is zero.
@label=CopySixDisplayBytes
c$B468 PUSH BC       ; {Save the count, take #N$00 as its high byte, and point
 $B469 LD C,A        ; #REGhl at the record.
 $B46A LD B,$00      ;
 $B46C PUSH HL       ;
 $B46D PUSH IY       ;
 $B46F POP HL        ; }
 $B470 ADD HL,BC     ; {Add the offset, copy #N$06 bytes and clear #REGa.
 $B471 LD BC,$0006   ;
 $B474 LDIR          ;
 $B476 XOR A         ; }
 $B477 LD B,$06      ; Count the #N$06 copied bytes.
@label=CopySixDisplayBytes_TestCopied
*$B479 DEC HL        ; {Step back one byte, or that byte into #REGa, and repeat from #R$B479 for all
 $B47A OR (HL)       ; six.
 $B47B DJNZ $B479    ; }
 $B47D POP HL        ; {Restore the pointer and the count from the stack.
 $B47E POP BC        ; }
 $B47F RET Z         ; Return if the six copied bytes are all zero.
 $B480 SET 0,(HL)    ; Mark this display flag as set.
 $B482 RET           ; Return.

; Copy The Character Into The Display
;
; Used by the routine at #R$B39D.
; .
; Returns at once when the count is zero. Otherwise copies this character's id and script
; position into the display.
@label=CopyCharacterDisplay
c$B483 XOR A         ; {Return at once if the count in #REGb is zero.
 $B484 CP B          ;
 $B485 RET Z         ; }
 $B486 LD D,$00      ; {Step to the next schedule entry.
 $B488 PUSH IY       ;
 $B48A ADD IY,DE     ; }
 $B48C LD A,(IY+$00) ; {Copy this character's id to the byte at #REGhl.
 $B48F LD (HL),A     ; }
 $B490 INC HL        ; {Step to the next entry, read the script position and store it at the display
 $B491 LD A,(IY+$01) ; flag.
 $B494 LD (HL),A     ; }
 $B495 DEC HL        ; Step back one byte.
 $B496 OR (IY+$00)   ; Merge this character's id into the result.
 $B499 POP IY        ; Restore the schedule entry from the stack.
 $B49B RET Z         ; Return when the character id and the script position are
                     ; both clear.
 $B49C DEC B         ; {Count down one and step past this entry.
 $B49D INC HL        ;
 $B49E INC HL        ; }
 $B49F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7CAC }
; LIST#

; Dispatch Looked-Up Handler
;
; Used by the routines at #R$B4FD and #R$B5A4.
; .
; Jumps to the handler the caller looked up.
c$B4A0 JP (IY)       ; Jump to the handler address in #REGiy.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7CC9 }
; LIST#

; Display Setup Flag
;
; Flag indicating whether the display has been set up (FF = not set up, 00 = set up).
; Read by #R$B308, #R$B34F and #R$B4A3.
@label=DisplaySetupFlag
g$B4A2 DEFB $00

; Check Flag And Set Display
;
; Used by the routine at #R$B4C1.
; .
; Sets up which room to display based on display flags and processes objects
; for that room.
@label=CheckFlagAndSetDisplay
c$B4A3 LD A,($B4A2)  ; {Jump to #R$B4CF if the display setup flag is not #N$FF.
 $B4A6 INC A         ;
 $B4A7 JR NZ,$B4CF   ; }
 $B4A9 LD ($B4A2),A  ; {Record the display setup flag.
 $B4AC LD A,($B173)  ; }
 $B4AF BIT 7,A       ; {Go to #R$B4CF if bit 7 of the display flag is clear.
 $B4B1 JR Z,$B4CF    ; }
; Set up special display mode.
 $B4B3 LD A,$FE      ; {Write #N$FE to the room display parameter.
 $B4B5 LD ($A034),A  ; }
 $B4B8 LD HL,($B172) ; {Write *#R$B172 to *#R$A02F.
 $B4BB LD ($A02F),HL ; }
 $B4BE OR %00000001  ; Reset the zero flag.
 $B4C0 RET           ; Return.

; Find The First Noun
;
; Used by the routines at #R$B191 and #R$B308.
; .
; Finds the first noun. A value of #N$05 at #R$A00F takes the noun already
; prepared in the flag bytes. Otherwise, when bit 7 of #R$B173 is clear, it
; scans objects from #R$B17E with the handler at #R$D39B or #R$D36A.
@label=FindFirstNoun
c$B4C1 LD A,($A00F)  ; {Jump to #R$B4A3 if the display mode is #N$05.
 $B4C4 CP $05        ;
 $B4C6 JR Z,$B4A3    ; }
 $B4C8 LD A,($B173)  ; Read the display mode flag.
 $B4CB BIT 7,A       ; {Go to #R$B4D4 if bit 7 of the display mode flag is
 $B4CD JR Z,$B4D4    ; clear.}
; This entry point is used by the routine at #R$B4A3.
@label=FindFirstNoun_NoAction
*$B4CF LD A,$FF      ; {Set the zero flag.
 $B4D1 CP $FF        ; }
 $B4D3 RET           ; Return.
@label=FindFirstNoun_ProcessObjects
*$B4D4 PUSH IY       ; {Keep the schedule entry and read the object table
 $B4D6 LD IX,($B17E) ; pointer.}
 $B4DA LD A,($A01D)  ; Read the object attribute value.
 $B4DD AND %00000001 ; Keep only bit 0.
 $B4DF LD ($A038),A  ; Store it in the object attribute flag.
 $B4E2 LD A,($A00F)  ; {Compare *#R$A00F with #N$05.
 $B4E5 CP $05        ; }
 $B4E7 LD IY,$D39B   ; {Go to #R$B4F1, keeping the picture record at #R$D39B, if the display mode is below
 $B4EB JR C,$B4F1    ; #N$05.}
 $B4ED LD IY,$D36A   ; Point at the routine at #R$D36A.
@label=FindFirstNoun_ProcessLoop
*$B4F1 CALL $B4FD    ; Call #R$B4FD to follow the display pointer.
 $B4F4 CP $FF        ; See whether the entry is the end marker.
 $B4F6 LD ($B17E),IX ; Store the object pointer at #R$B17E.
 $B4FA POP IY        ; Restore the saved schedule entry from the stack.
 $B4FC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7CCB }
; LIST#

; Process Display Pointer
;
; Used by the routine at #R$B4C1.
; .
; Runs the looked-up handler for each object that belongs in this picture.
@label=CheckFlagAndSetDisplay_ProcessPointer
c$B4FD LD HL,$B172   ; Take the display data pointer.
 $B500 CALL $B4A0    ; Call #R$B4A0 to run the handler that was looked up.
 $B503 CP $FF        ; {Return if the entry is the end marker.
 $B505 RET Z         ; }
 $B506 LD ($A034),A  ; Record the room display parameter.
 $B509 CALL $B517    ; Call #R$B517 to check the objects.
 $B50C JR NZ,$B4FD   ; Jump back to #R$B4FD while an object matches this
                     ; picture.
 $B50E LD A,($A034)  ; {Read the room display parameter and take the display
 $B511 LD HL,$B16D   ; flag.}
 $B514 SET 1,(HL)    ; Set bit 1 of the display flag.
 $B516 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7CFC }
; LIST#

; Check And Process Objects
;
; Used by the routine at #R$B4FD.
; .
; Returns when the display flag at #R$A01C is zero. Otherwise walks the
; character's objects and returns non-zero when one matches the room display
; parameter.
@label=CheckFlagAndSetDisplay_CheckObjects
c$B517 LD A,($A01C)   ; {Return if the display flag (#R$A01C) is zero.
 $B51A AND A          ;
 $B51B RET Z          ; }
 $B51C PUSH IY        ; {Keep the character record.
 $B51E PUSH DE        ;
 $B51F PUSH IX        ; }
@label=CheckFlagAndSetDisplay_ObjectLoop
*$B521 CALL $AEA9     ; Call #R$AEA9 to follow the character link.
 $B524 BIT 6,(IY+$01) ; See whether bit 6 of the schedule entry is clear.
 $B528 JR Z,$B543     ; Jump ahead to #R$B543 if bit 6 of the schedule entry is
                      ; clear.
 $B52A CALL $D04F     ; Call #R$D04F to adjust the object table for this room.
@label=CheckFlagAndSetDisplay_ProcessObject
*$B52D PUSH IY        ; {Point #REGhl at byte #N$08 of the record
 $B52F POP HL         ; (#REGiy+#N$08).
 $B530 LD DE,$0008    ;
 $B533 ADD HL,DE      ; }
 $B534 CALL $D36A     ; Call #R$D36A to check the next object.
 $B537 CP $FF         ; {Jump back to #R$B521 if the entry is the end marker.
 $B539 JR Z,$B521     ; }
 $B53B LD HL,$A034    ; {Jump back to #R$B52D while the object is not in the
 $B53E CP (HL)        ; room on screen.
 $B53F JR NZ,$B52D    ; }
 $B541 OR $01         ; Clear the zero flag to report that an object in the
                      ; room on screen was found.
@label=CheckFlagAndSetDisplay_RestoreAndReturn
*$B543 POP IX         ; {Restore the saved character record, the saved source
 $B545 POP DE         ; and the saved schedule entry from the stack.
 $B546 POP IY         ; }
 $B548 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7A73 }
; LIST#

; Flags: Display
;
; Display flag beside #R$B54A.
; Read by #R$B32D, #R$B36B and #R$B54A.
g$B549 DEFB $00

; Check Flag And Set Display Parameter
;
; Used by the routine at #R$B568.
; .
; Sets the room graphics parameter to #N$FE and returns non-zero when the count
; at #R$B549 has reached #N$FF and bit 7 of #R$B179 is set. Otherwise returns
; with the zero flag set.
@label=CheckFlagAndSetDisplayParameter
c$B54A LD A,($B549)  ; {Jump to #R$B576 if the byte at #R$B549 is not #N$FF.
 $B54D INC A         ;
 $B54E JR NZ,$B576   ; }
 $B550 LD ($B549),A  ; Record the result in the display flag at #R$B549.
 $B553 LD A,($B179)  ; {Go to #R$B576 if bit 7 of the display mode flag at
 $B556 BIT 7,A       ; #R$B179 is clear.
 $B558 JR Z,$B576    ; }
 $B55A LD A,$FE      ; {Write #N$FE to the room graphics parameter and read the
 $B55C LD ($A035),A  ; display mode word.
 $B55F LD HL,($B178) ; }
 $B562 LD ($A031),HL ; Record the display pointer.
 $B565 OR %00000001  ; Reset the zero flag.
 $B567 RET           ; Return.

; Match The Second Noun
;
; Used by the routines at #R$B2DF and #R$B32D.
; .
; Matches the second noun, using the second set of variables: #R$A010, #R$B179,
; #R$B549, #R$B180, #R$A035 and #R$B178. The tests are the same shape as
; #R$B4C1.
@label=MatchSecondNoun
c$B568 LD A,($A010)  ; {Jump to #R$B54A if the display mode is #N$05.
 $B56B CP $05        ;
 $B56D JR Z,$B54A    ; }
 $B56F LD A,($B179)  ; {Jump ahead to #R$B57B if bit 7 of display mode flag
 $B572 BIT 7,A       ; (#R$B179) is clear.
 $B574 JR Z,$B57B    ; }
; This entry point is used by the routine at #R$B54A.
@label=MatchSecondNoun_Next
*$B576 LD A,$FF      ; Mark the entry as finished.
 $B578 CP $FF        ; See whether this byte is the end marker.
 $B57A RET           ; Return.
; Read the pointer at #R$B180, then read the object attribute at #R$A01D.
@label=MatchSecondNoun_SaveFrame
*$B57B PUSH IY       ; {Keep the schedule entry and read the pointer at
 $B57D LD IX,($B180) ; #R$B180.}
 $B581 LD A,($A01D)  ; {Read the object attribute value, keep the selected bits of #N$FF and store
 $B584 AND $01       ; it in the object attribute flag.
 $B586 LD ($A038),A  ; }
 $B589 LD A,($A010)  ; {Read the display mode.
 $B58C CP $05        ; }
 $B58E LD IY,$D39B   ; Point at the routine at #R$D39B.
 $B592 JR C,$B598    ; Jump ahead to #R$B598 if display mode (#R$A010) is below
                     ; #N$05.
 $B594 LD IY,$D36A   ; Point at the routine at #R$D36A.
@label=MatchSecondNoun_CheckEnd
*$B598 CALL $B5A4    ; Call #R$B5A4 to test for the end marker.
 $B59B CP $FF        ; {See whether the entry is the end marker.
 $B59D LD ($B180),IX ;
 $B5A1 POP IY        ; }
 $B5A3 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7D17 }
; LIST#

; Test For The End Marker
;
; Used by the routine at #R$B568.
; .
; Returns when the display byte is the end marker.
@label=TestEndMarker
c$B5A4 LD HL,$B178   ; {Call #R$B4A0 to run the handler that was looked up.
 $B5A7 CALL $B4A0    ; }
 $B5AA CP $FF        ; {Return when the handler reports the end marker.
 $B5AC RET Z         ; }
 $B5AD LD ($A035),A  ; {Record the room graphics parameter and set bit 1 of the
 $B5B0 LD HL,$B16E   ; display flag at #R$B16E.
 $B5B3 SET 1,(HL)    ; }
 $B5B5 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7D54 }
; LIST#

; Unlink The Next Display Record
;
; Unlinks the next display record and clears the pointer left in the previous
; entry.
@label=UnlinkNextDisplayRecord
c$B5B6 LD ($A01B),A    ; {Store it in the initialised flag and read the next
 $B5B9 LD IX,($9FF2)   ; display link.}
 $B5BD LD ($9FF0),IX   ; Store that pointer in the first display link.
 $B5C1 LD L,(IX-$02)   ; {Read the pointer saved ahead of this record.
 $B5C4 LD H,(IX-$01)   ; }
 $B5C7 LD ($9FF2),HL   ; Store the pointer in the next display link.
 $B5CA LD (IX-$02),$00 ; {Clear the pointer in the previous display entry.
 $B5CE LD (IX-$01),$00 ; }
 $B5D2 RET             ; Return.
 $B5D3 LD A,($B16E)    ; {Jump ahead to #R$B610 if bit 0 of display flag
 $B5D6 BIT 0,A         ; (#R$B16E) is clear.
 $B5D8 JR Z,$B610      ; }
 $B5DA LD A,($B183)    ; {Jump ahead to #R$B5EF to check flag and set display
 $B5DD LD HL,$B178     ; parameter.
 $B5E0 JR $B5EF        ; }
 $B5E2 LD A,($B16D)    ; {Jump ahead to #R$B5FC if bit 0 of display flag at
 $B5E5 BIT 0,A         ; #R$B16D is clear.
 $B5E7 JR Z,$B5FC      ; }
 $B5E9 LD A,($B182)    ; {Read the byte at #R$B180+#N$02 and take the display
 $B5EC LD HL,$B172     ; data pointer.}
@label=UnlinkNextDisplayRecord_ReadNext
*$B5EF CALL $B83C      ; {Call #R$B83C to restore the saved character record,
 $B5F2 CALL $B5B6      ; then call #R$B5B6 to read the next display link.}
 $B5F5 LD HL,$6888     ; {Take the message, then call #R$A59F to print the
 $B5F8 CALL $A59F      ; message.}
 $B5FB RET             ; Return.
; Calls the display-parameter check, using the pointer saved at #R$B17E+#N$08.
@label=UnlinkNextDisplayRecord_CallsDisplayParameter
*$B5FC CALL $B633      ; #HTML(Call #R$B633 to plant the <code>JR NZ</code>
                       ; opcode and test the character record.)
 $B5FF LD HL,($B186)   ; {Call #R$B5B6 to read the next character record.
 $B602 PUSH HL         ;
 $B603 LD A,($B182)    ;
 $B606 CALL $B5B6      ; }
 $B609 LD HL,$6880     ; {Take the message, then call #R$A59F to print the
 $B60C CALL $A59F      ; message.}
 $B60F RET             ; Return.
; #HTML(Plant the <code>JR Z</code> test, push a zero pointer and #R$B172, test
; the character record through #R$B633, read the next record through #R$B5B6
; and print the message at #R$687C.)
@label=UnlinkNextDisplayRecord_ClearPointer
*$B610 CALL $B62F      ; #HTML(Call #R$B62F to plant the <code>JR Z</code>
                       ; opcode.)
 $B613 LD HL,$0000     ; {Clear the pointer and take the display data pointer.
 $B616 PUSH HL         ;
 $B617 LD HL,$B172     ;
 $B61A PUSH HL         ; }
 $B61B CALL $B633      ; #HTML(Call #R$B633 to plant the <code>JR NZ</code>
                       ; opcode and test the character record.)
 $B61E LD HL,($B186)   ; {Call #R$B5B6 to read the next character record.
 $B621 PUSH HL         ;
 $B622 LD A,($B183)    ;
 $B625 CALL $B5B6      ; }
 $B628 LD HL,$687C     ; {Take the message, then call #R$A59F to print the
 $B62B CALL $A59F      ; message.}
 $B62E RET             ; Return.

; Select Jump If Zero
;
; Used by the routines at #R$B5B6, #R$B633 and #R$B6F0.
; .
; #HTML(Plants the <code>JR Z</code> opcode for the two tests at #R$B645 and
; #R$B656.)
@label=SelectJumpIfZero
c$B62F LD A,$28      ; {#HTML(Use the <code>JR Z</code> opcode (#N$28) and go
 $B631 JR $B635      ; to #R$B635.)}
; View the equivalent code in;
; #LIST
; { #HOBBIT$7E78 }
; LIST#

; Select Jump If Not Zero
;
; Used by the routines at #R$B5B6 and #R$B6DA.
; .
; #HTML(Plants the <code>JR NZ</code> opcode for the two tests at #R$B645 and
; #R$B656, then reads the character record.)
@label=SelectJumpIfNotZero
c$B633 LD A,$20       ; #HTML(Use the <code>JR NZ</code> opcode (#N$20).)
; This entry point is used by the routine at #R$B62F.
@label=SelectJumpIfNotZero_WriteOpcode
*$B635 LD ($B649),A   ; {Write the opcode into the jumps at #R$B649 and
 $B638 LD ($B658),A   ; #R$B658.}
 $B63B LD IX,($B18E)  ; Read the pointer at #R$B18C+#N$02.
 $B63F LD L,(IX+$04)  ; {Read the handler address from bytes #N$04-#N$05 of the
 $B642 LD H,(IX+$05)  ; record.}
 $B645 BIT 7,(IX+$07) ; {Jump to #R$B64E if a marker on the character record is set. The opcode at
 $B649 JR NZ,$B64E    ; #R$B649 is modified by #R$B635.}
 $B64B LD HL,$0000    ; Clear the pointer.
@label=SelectJumpIfNotZero_LocationActionFlags
*$B64E EX (SP),HL     ; Swap #REGhl with the return address.
 $B64F PUSH HL        ; {Save that address, and read the location and the
 $B650 LD L,(IX+$02)  ; action flags.
 $B653 LD H,(IX+$03)  ; }
 $B656 BIT 5,H        ; {Jump ahead to #R$B65D if bit 5 is present. The opcode at #R$B658 is
 $B658 JR NZ,$B65D    ; modified by #R$B635.}
 $B65A LD HL,$0000    ; Clear the pointer.
@label=SelectJumpIfNotZero_ReturnWithPointers
*$B65D EX (SP),HL     ; Leave the location pointer (or #N($0000,$04,$04) when
                      ; bit 5 is clear) on the stack in place of the address
                      ; saved there.
 $B65E JP (HL)        ; Return to the caller (its address is now in #REGhl),
                      ; leaving the location pointer and the handler address on
                      ; the stack.
 $B65F LD A,($A00F)   ; {Jump to #R$B671 if the display mode is #N$05.
 $B662 CP $05         ;
 $B664 JR Z,$B671     ; }
 $B666 CP $06         ; {Jump to #R$B671 when the display mode is #N$06.
 $B668 JR Z,$B671     ; }
 $B66A LD A,($B173)   ; {Jump ahead to #R$B678 if bit 7 of display mode flag at
 $B66D BIT 7,A        ; #R$B173 is clear.
 $B66F JR Z,$B678     ; }
@label=SelectJumpIfNotZero_MessagePrintMessage
*$B671 LD HL,$6855    ; {Take the message, then call #R$A59F to print the
 $B674 CALL $A59F     ; message.}
 $B677 RET            ; Return.
; Test the display flag, and use the display data pointer when that flag is
; set.
@label=SelectJumpIfNotZero_TestDisplayFlag
*$B678 LD HL,$B16D    ; {Test bit 0 of the display flag and point #REGhl at the
 $B67B BIT 0,(HL)     ; display data pointer.
 $B67D LD HL,$B172    ; }
; Build this display entry when the flag is clear.
 $B680 CALL NZ,$B6DA  ; Call #R$B6DA if bit 0 of this byte is set.
 $B683 CALL $B633     ; #HTML(Call #R$B633 to plant the <code>JR NZ</code>
                      ; opcode and test the character record.)
 $B686 LD A,($B16D)   ; {Read the display flag and take the display data
 $B689 LD HL,$B172    ; pointer.}
@label=SelectJumpIfNotZero_BitDisplayFlag
*$B68C LD DE,($B186)  ; {Jump ahead to #R$B69D if bit 0 of display flag at
 $B690 PUSH DE        ; #R$B16D is clear.
 $B691 BIT 0,A        ;
 $B693 JR Z,$B69D     ; }
 $B695 CALL $B83C     ; {Call #R$B83C to restore the saved character record,
 $B698 LD HL,$05B3    ; then jump to #R$B6A6 with the message at #N$05B3.
 $B69B JR $B6A6       ; }
; Clear the stacked pointers, then print the message at #N$05DB.
@label=SelectJumpIfNotZero_ClearStackedPointers
*$B69D LD HL,$0000    ; {Push three zero words for the message.
 $B6A0 PUSH HL        ;
 $B6A1 PUSH HL        ;
 $B6A2 PUSH HL        ; }
 $B6A3 LD HL,$05DB    ; Take the message at #N$05DB.
@label=SelectJumpIfNotZero_MessagePrintMessageAgain
*$B6A6 PUSH HL        ; {Take the message, then call #R$A59F to print the
 $B6A7 LD HL,$6894    ; message.
 $B6AA CALL $A59F     ; }
 $B6AD RET            ; Return.
 $B6AE LD A,($A010)   ; {Jump to #R$B671 if the display mode is #N$05.
 $B6B1 CP $05         ;
 $B6B3 JR Z,$B671     ; }
 $B6B5 CP $06         ; {Jump to #R$B671 when the display mode is #N$06.
 $B6B7 JR Z,$B671     ; }
 $B6B9 LD A,($B179)   ; {Jump back to #R$B671 while bit 7 of display mode flag
 $B6BC BIT 7,A        ; (#R$B179) is present.
 $B6BE JR NZ,$B671    ; }
 $B6C0 LD HL,$B16E    ; {Take the display flag and take the display mode flag.
 $B6C3 BIT 0,(HL)     ;
 $B6C5 LD HL,$B178    ; }
; Build the alternate display entry.
 $B6C8 CALL NZ,$B6F0  ; Call #R$B6F0 if bit 0 of this byte is set.
 $B6CB CALL $B62F     ; #HTML(Call #R$B62F to plant the <code>JR Z</code>
                      ; opcode.)
 $B6CE LD A,($B16E)   ; {Jump back to #R$B68C to check flag and set display
 $B6D1 LD HL,$B178    ; parameter.
 $B6D4 JR $B68C       ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$7E7C }
; LIST#

; Word: Display Pointers
;
; Two display pointers. #R$B768 reads the character record from the first, and #R$B760
; reads the saved display pointer from the second.
; Read by #R$B6FD and #R$B77F.
g$B6D6 DEFW $0000
 $B6D8 DEFW $0000    ; Read by #R$B6FD.

; Process Display Entry
;
; Used by the routine at #R$B633.
; .
; Builds the display entry, and returns at once when that entry is empty.
@label=ProcessDisplayEntry
c$B6DA CALL $B6FD    ; {Return if there is no location display text.
 $B6DD RET Z         ; }
 $B6DE POP DE        ; Restore the saved source from the stack.
 $B6DF CALL $B83C    ; Call #R$B83C.
 $B6E2 CALL $B633    ; #HTML(Call #R$B633 to plant the <code>JR NZ</code>
                     ; opcode and test the character record.)

; Print Object Message
;
; Used by the routine at #R$B6F0.
; .
; Prints the message at #R$689C+#N$06, then returns into the handler whose
; address is held at #R$B185+#N$01.
c$B6E5 LD HL,($B186) ; {Push the handler address at #R$B185+#N$01, print the
 $B6E8 PUSH HL       ; message at #R$689C+#N$06 and return into that handler.
 $B6E9 LD HL,$68A2   ;
 $B6EC CALL $A59F    ; }
 $B6EF RET           ; Return.

; Process Display Entry Alternate
;
; Used by the routine at #R$B633.
; .
; Builds the display entry, and prints the object line when the entry is
; present.
@label=ProcessDisplayEntryAlternate
c$B6F0 CALL $B6FD    ; {Return if there is no location display text.
 $B6F3 RET Z         ; }
 $B6F4 POP DE        ; Restore the saved source from the stack.
 $B6F5 CALL $B83C    ; Call #R$B83C.
 $B6F8 CALL $B62F    ; {Call #R$B62F and jump back to #R$B6E5 to run the
 $B6FB JR $B6E5      ; display entry.}

; Process Location Display
;
; Used by the routines at #R$B6DA and #R$B6F0.
; .
; Clears the display mark, saves the location pointer, and reads the
; character's room.
;
; HL Location pointer
@label=ProcessLocationDisplay
c$B6FD XOR A         ; {Clear the display.
 $B6FE LD ($B77E),A  ; }
 $B701 LD ($B6D8),HL ; {Call #R$D33C to fetch current character location.
 $B704 CALL $D33C    ; }
 $B707 LD L,(IX+$07) ; {Read the word at offset #N$07 of this character record.
 $B70A LD H,(IX+$08) ; }
 $B70D LD A,H        ; {See whether the pointer is empty.
 $B70E OR L          ; }
 $B70F RET Z         ; Return when this character has no script pointer.
 $B710 PUSH HL       ; {Point #REGix at the script.
 $B711 POP IX        ; }
 $B713 LD HL,$0000   ; {Write #N($0000,$04,$04) to *#R$B6D6.
 $B716 LD ($B6D6),HL ; }
 $B719 LD IY,$AAAC   ; Use the buffer: co-ordinate data at #R$AAAC.
@label=ProcessLocationDisplay_Loop
*$B71D LD HL,$AAAC   ; {Call #R$A2AB to clear buffer.
 $B720 LD B,$06      ;
 $B722 CALL $A2AB    ; }
@label=ProcessLocationDisplay_RunTextToken
*$B725 CALL $B77F    ; {Return if there is no further text token.
 $B728 RET Z         ; }
 $B729 CALL $B772    ; {Jump ahead to #R$B75A if it is #N$50.
 $B72C CP $50        ;
 $B72E JR Z,$B75A    ; }
 $B730 CP $60        ; {Jump back to #R$B725 while it is not #N$60.
 $B732 JR NZ,$B725   ; }
 $B734 LD (IY+$02),E ; {Store the word pointer at offset #N$02 and call #R$B77F
 $B737 LD (IY+$03),D ; to read the text.
 $B73A CALL $B77F    ; }
 $B73D RET Z         ; Return if there is no further text token.
 $B73E CALL $B772    ; {Jump ahead to #R$B75A if it is #N$50.
 $B741 CP $50        ;
 $B743 JR Z,$B75A    ; }
 $B745 CP $60        ; {Jump back to #R$B71D while it is not #N$60.
 $B747 JR NZ,$B71D   ; }
 $B749 LD (IY+$04),E ; {Store the word pointer at offset #N$04 and call #R$B77F
 $B74C LD (IY+$05),D ; to read the text.
 $B74F CALL $B77F    ; }
 $B752 RET Z         ; Return if there is no further text token.
 $B753 CALL $B772    ; {Jump back to #R$B71D while it is not #N$50.
 $B756 CP $50        ;
 $B758 JR NZ,$B71D   ; }
@label=ProcessLocationDisplay_Next
*$B75A LD (IY+$00),E ; {Store #REGde at #REGiy+#N$00-#N$01.
 $B75D LD (IY+$01),D ; }
 $B760 LD HL,($B6D8) ; Read the display pointers.
 $B763 CALL $A4E0    ; {Jump back to #R$B71D while the room fields do not
 $B766 JR NZ,$B71D   ; match.}
 $B768 LD IX,($B6D6) ; {Call #R$A1AF to follow the record pointer.
 $B76C CALL $A1AF    ; }
 $B76F OR %00000001  ; Reset the zero flag.
 $B771 RET           ; Return.

; Read Dictionary High Nibble
;
; Used by the routine at #R$B6FD.
; .
; Reads the high nibble of the dictionary byte at the token's index.
;
;   D Character code
; O:A Attribute value (bits 4-7)
@label=ReadDictionaryHighNibble
c$B772 LD HL,$5DBF   ; {Take the dictionary index.
 $B775 LD A,D        ; }
 $B776 AND %00001111 ; Keep the dictionary page (the low nibble of the token's
                     ; high byte) as the high byte of the index.
 $B778 LD D,A        ; Store the result in the high byte of the source.
 $B779 ADD HL,DE     ; Add the token offset in #REGde to the dictionary base.
 $B77A LD A,(HL)     ; Read the dictionary byte this index points at.
 $B77B AND %11110000 ; Keep the high nibble of the dictionary byte, which is
                     ; the attribute value.
 $B77D RET           ; Return.

; Flags: Display
;
; Display flag beside the character-attribute routine.
; Read by #R$B6FD and #R$B77F.
g$B77E DEFB $00

; Process Text Token Stream
;
; Used by the routine at #R$B6FD.
; .
; Walks the text tokens while the display flag is not the end marker.
;
; O:F Zero flag set if end of stream reached
@label=ProcessTextTokenStream
c$B77F LD A,($B77E)  ; {Jump to #R$B7AA if the display is not #N$FF.
 $B782 CP $FF        ;
 $B784 JR NZ,$B7AA   ; }
@label=ProcessTextTokenStream_Loop
*$B786 LD HL,($B6D6) ; {Return if the pointer at #R$B6D6 is zero.
 $B789 LD A,L        ;
 $B78A OR H          ;
 $B78B RET Z         ; }
 $B78C XOR A         ; {Clear the display.
 $B78D LD ($B77E),A  ;
 $B790 PUSH HL       ;
 $B791 POP IX        ; }
 $B793 LD L,(IX-$02) ; Read the low byte saved ahead of this record.
 $B796 LD H,(IX-$01) ; {Record the display pointers.
 $B799 LD ($B6D6),HL ; }
 $B79C LD L,(IX+$00) ; Read the record's flag byte.
 $B79F LD H,(IX+$01) ; {Call #R$A1C7 to run memory entry.
 $B7A2 CALL $A1C7    ; }
 $B7A5 INC HL        ; {Step on two bytes and point #REGix at that address.
 $B7A6 INC HL        ;
 $B7A7 PUSH HL       ;
 $B7A8 POP IX        ; }
@label=ProcessTextTokenStream_BitRecordFlag
*$B7AA LD A,(IX+$00) ; {Jump ahead to #R$B7CD if bit 7 of the record's flag byte is clear, and step
 $B7AD INC IX        ; through the text token.
 $B7AF BIT 7,A       ;
 $B7B1 JR Z,$B7CD    ; }
 $B7B3 LD D,A        ; {Keep this token and read the next byte as its
 $B7B4 LD E,(IX+$00) ; parameter.
 $B7B7 INC IX        ; }
 $B7B9 AND %01110000 ; Keep the token type (bits 4-6) for the checks below.
 $B7BB CP $60        ; {Jump ahead to #R$B7C6 if the record flag is #N$60.
 $B7BD JR Z,$B7C6    ; }
 $B7BF CP $30        ; {Jump ahead to #R$B7C6 if the record flag is #N$30.
 $B7C1 JR Z,$B7C6    ; }
 $B7C3 CP $20        ; {Return if the record flag is not #N$20.
 $B7C5 RET NZ        ; }
@label=ProcessTextTokenStream_Next
*$B7C6 LD A,$FF      ; {Write #N$FF to the display.
 $B7C8 LD ($B77E),A  ; }
 $B7CB AND A         ; Clear the carry so a blank character ends this token.
 $B7CC RET           ; Return.
; Treats a blank as a break and a vocabulary code as a common word.
@label=ProcessTextTokenStream_TestCharacterClass
*$B7CD CP $20        ; {Jump ahead to #R$B7F7 if the character code is below
 $B7CF JR C,$B7F7    ; #N$20.}
 $B7D1 CP $60        ; {Jump ahead to #R$B7DD if the character code is below
 $B7D3 JR C,$B7DD    ; #N$60.}
; Get common word.
 $B7D5 CALL $A840    ; Call #R$A840 to look up this common word.
 $B7D8 OR $01        ; Set the found marker.
 $B7DA LD A,$00      ; Leave #REGa clear. The flags still show that the word
                     ; was found.
 $B7DC RET           ; Return.
; Keep the token's low five bits and add one for the letter count.
@label=ProcessTextTokenStream_TestKeepBitsCount
*$B7DD AND %00011111 ; Take the letter count of this packed word from bits 0-4.
 $B7DF INC A         ; {Set #REGb to the token length plus one, point #REGhl at
 $B7E0 LD B,A        ; the byte after #REGix, and clear #REGc.
 $B7E1 PUSH IX       ;
 $B7E3 POP HL        ;
 $B7E4 INC HL        ;
 $B7E5 LD C,$00      ; }
; Rotate and extract character code.
*$B7E7 CALL $A990    ; Call #R$A990 to unpack the next letter.
 $B7EA DJNZ $B7E7    ; Count the next character of the message and repeat from
                     ; #R$B7E7.
 $B7EC PUSH HL       ; {Jump back to #R$B7AA while the count is not zero.
 $B7ED POP IX        ;
 $B7EF LD A,C        ;
 $B7F0 AND A         ;
 $B7F1 JR NZ,$B7AA   ; }
 $B7F3 DEC IX        ; {Step back one byte and continue at #R$B7AA.
 $B7F5 JR $B7AA      ; }
; Command 2 adds the following offset to the text pointer.
@label=ProcessTextTokenStream_CommandTwo
*$B7F7 CP $02        ; {Jump ahead to #R$B807 if the command is not #N$02.
 $B7F9 JR NZ,$B807   ; }
 $B7FB LD E,(IX+$00) ; {Read the flag word and add it to the record pointer.
 $B7FE LD D,(IX+$01) ;
 $B801 ADD IX,DE     ; }
@label=ProcessTextTokenStream_TestRecordFlagStep
*$B803 DEC IX        ; {Step back one byte and read the next token from
 $B805 JR $B7AA      ; #R$B7AA.}
; Command 11 saves the text pointer and adds the following offset.
@label=ProcessTextTokenStream_CommandEleven
*$B807 CP $0B        ; {Go to #R$B834 when the text command is not #N$0B.
 $B809 JR NZ,$B834   ; }
 $B80B LD E,(IX+$00) ; {Read the record's flag byte and read the moved marker.
 $B80E LD D,(IX+$01) ;
 $B811 PUSH IX       ; }
 $B813 POP HL        ; {Call #R$A11C to allocate #N$02 bytes.
 $B814 LD A,$02      ;
 $B816 CALL $A11C    ; }
 $B819 LD (IX+$00),L ; {Store the link word at the start of the record and keep
 $B81C LD (IX+$01),H ; it.
 $B81F PUSH HL       ; }
 $B820 LD HL,($B6D6) ; Read the display pointers.
 $B823 LD ($B6D6),IX ; {Remember this record at #R$B6D6 and store the previous
 $B827 LD (IX-$02),L ; pointer's low byte just ahead of it.}
 $B82A LD (IX-$01),H ; Store the high byte of the previous pointer just ahead
                     ; of this record.
 $B82D POP HL        ; Restore the pointer from the stack.
 $B82E ADD HL,DE     ; {Add the offset, copy it into the record, and go to
 $B82F PUSH HL       ; #R$B803.
 $B830 POP IX        ;
 $B832 JR $B803      ; }
; A control below 29 goes back to the main text walk.
@label=ProcessTextTokenStream_TestControlBelowGoes
*$B834 CP $1D        ; {Jump back to #R$B7AA if the character is below #N$1D.
 $B836 JP C,$B7AA    ; }
 $B839 JP $B786      ; Jump back to #R$B786 to read the display pointers and take the low byte of
                     ; the display pointers.

; Restore The Saved Character Record
;
; Used by the routines at #R$B5B6, #R$B633, #R$B6DA and #R$B6F0.
; .
; Restores the saved character record for the caller.
@label=RestoreSavedCharacterRecord
c$B83C POP IX        ; Restore #REGix from the stack.
 $B83E LD B,$03      ; Count #N$03 words.
@label=RestoreSavedCharacterRecord_ReadWords
*$B840 LD E,(HL)     ; {Read each counted word onto the stack, then take the
 $B841 INC HL        ; last one as the pointer.
 $B842 LD D,(HL)     ;
 $B843 INC HL        ;
 $B844 PUSH DE       ;
 $B845 DJNZ $B840    ;
 $B847 POP HL        ; }
 $B848 EX (SP),HL    ; {Exchange #REGhl with the return address and push
 $B849 PUSH HL       ; #REGhl.}
 $B84A JP (IX)       ; Jump to the handler address in #REGix.
 $B84C LD HL,($B18A) ; {Push the pointers at #R$B18A and #R$B188.
 $B84F PUSH HL       ;
 $B850 LD HL,($B188) ;
 $B853 PUSH HL       ; }
 $B854 LD HL,($B186) ; {Push the pointers at #R$B185+#N$01 and #R$B18C.
 $B857 PUSH HL       ;
 $B858 LD HL,($B18C) ;
 $B85B PUSH HL       ; }
 $B85C LD HL,$686A   ; {Take the message, then call #R$A59F to print the
 $B85F CALL $A59F    ; message.}
 $B862 RET           ; Return.
 $B863 JP $C929      ; Jump ahead to #R$C929 to draw this object.

; Word: Saved Character Record
;
; Character record pointer kept while its object attribute is read.
; Written by #R$B911 and read by #R$B96B, #R$B9BA and #R$B9CA.
g$B866 DEFW $0000

; Word: Saved Record Flag
;
; Flag word copied from the character record while its link is followed.
; Written by #R$B87A and read by #R$B894 and #R$B8AA.
g$B868 DEFW $0000

; Follow The Link Pointer
;
; Used by the routine at #R$DD35.
; .
; Reads the link pointer beside the character lists and follows it.
@label=FollowLinkPointer
c$B86A PUSH AF       ; {Point at the link pointer, then call #R$A0F7 to fetch object pointer from
 $B86B LD IX,$9FEE   ; stack.
 $B86F CALL $A0F7    ; }
 $B872 JR Z,$B8A8    ; Go to #R$B8A8 if the object pointer is zero.
 $B874 LD C,(IX+$00) ; {Read the record's flag byte and read the moved marker.
 $B877 LD B,(IX+$01) ; }
 $B87A LD ($B868),BC ; Store that flag word at #R$B868.
 $B87E LD L,(IX-$02) ; {Read the pointer saved ahead of this record.
 $B881 LD H,(IX-$01) ; }
 $B884 LD ($9FEC),HL ; Record the character script entry list.
 $B887 CALL $A1C7    ; {Call #R$A1C7 to run memory entry.
 $B88A POP AF        ; }
 $B88B PUSH AF       ; {Jump ahead to #R$B894 if the saved result is zero.
 $B88C AND A         ;
 $B88D JR Z,$B894    ; }
 $B88F CALL $B8AA    ; {Go to #R$B8A8 if the display list was rebuilt.
 $B892 JR Z,$B8A8    ; }
@label=FollowLinkPointer_CopyLink
*$B894 LD BC,($B868) ; {Read the word at #R$B868 and store it in the word at
 $B898 LD ($A02B),BC ; #R$A02B.}
@label=FollowLinkPointer_Call
*$B89C CALL $AE7F    ; {Jump back to #R$B89C while it is not #N$C0.
 $B89F CP $C0        ;
 $B8A1 JR NZ,$B89C   ; }
 $B8A3 LD HL,($A029) ; {Write #N$90 through the pointer at #R$A029.
 $B8A6 LD (HL),$90   ; }
@label=FollowLinkPointer_HandResultCaller
*$B8A8 POP AF        ; Restore #REGaf from the stack.
 $B8A9 RET           ; Return.

; Read The Pointer At The First Display
;
; Used by the routine at #R$B86A.
; .
; Reads the word at #R$B868 and stores it in the word at #R$A02B.
@label=ReadPointerFirstDisplay
c$B8AA LD HL,($B868) ; {Read the word at #R$B868, store it in the word at
 $B8AD LD ($A02B),HL ; #R$A02B and clear #REGa.
 $B8B0 XOR A         ; }
 $B8B1 LD ($A024),A  ; Clear the command mode at #R$A024.
 $B8B4 LD HL,($9FF0) ; {Read the first display link and clear the pointer.
 $B8B7 PUSH HL       ;
 $B8B8 LD HL,$0000   ; }
 $B8BB LD ($9FF0),HL ; Store the pointer in the first display link.
@label=ReadPointerFirstDisplay_PrepareCharacterDisplay
*$B8BE CALL $AAB2    ; {Go to #R$B8C7 if #R$AAB2 returns zero.
 $B8C1 JR Z,$B8C7    ; }
 $B8C3 CP $02        ; {Jump ahead to #R$B904 if it is not #N$02.
 $B8C5 JR NZ,$B904   ; }
@label=ReadPointerFirstDisplay_ObjectProcessingSource
*$B8C7 LD HL,($A02B) ; Read the word at #R$A02B.
 $B8CA LD A,(HL)     ; {Jump back to #R$B8BE while the high nibble is not
 $B8CB AND $F0       ; #N$C0.
 $B8CD CP $C0        ;
 $B8CF JR NZ,$B8BE   ; }
 $B8D1 LD (HL),$90   ; {Use #N$08 for the character code, then call #R$A11C to
 $B8D3 LD A,$08      ; allocate memory.
 $B8D5 CALL $A11C    ; }
 $B8D8 LD HL,($9FEE) ; {Read the list head and make this record the new head.
 $B8DB LD ($9FEE),IX ; }
 $B8DF LD (IX-$02),L ; Store the low byte of the old list head in the link word
                     ; ahead of this record.
 $B8E2 LD (IX-$01),H ; {Store the high byte of the old list head in the link
 $B8E5 LD HL,($9FF0) ; word ahead of this record, and read the word at
                     ; #R$9FEE+#N$02.}
 $B8E8 LD (IX+$05),L ; Store the low byte of the first display link at offset
                     ; #N$05.
 $B8EB LD (IX+$06),H ; {Store the high byte of that link at offset #N$06 and
 $B8EE POP HL        ; keep the stacked pointer as the first display link.
 $B8EF LD ($9FF0),HL ; }
 $B8F2 XOR A         ; {Clear the moved marker and read the room display
 $B8F3 LD (IX+$01),A ; parameter.
 $B8F6 LD A,($A034)  ; }
 $B8F9 LD (IX+$00),A ; Store the record's flag byte.
 $B8FC LD A,($A024)  ; {Copy #R$A024 to offset 7.
 $B8FF LD (IX+$07),A ;
 $B902 XOR A         ; }
 $B903 RET           ; Return.
; Reads the first display link, then stores the saved pointer back into that
; link.
@label=ReadPointerFirstDisplay_ReadsFirstDisplay
*$B904 PUSH AF       ; {Call #R$D87D to read the first display link.
 $B905 CALL $D87D    ;
 $B908 POP AF        ;
 $B909 POP HL        ; }
 $B90A LD ($9FF0),HL ; Store the pointer in the first display link.
 $B90D RET           ; Return.

; Read The Object Attribute
;
; Used by the routine at #R$B936.
; .
; Finds the character being processed and remembers that record while it reads
; the object attribute.
c$B90E CALL $B91F    ; Call #R$B91F to check the character being processed.
 $B911 LD ($B866),IX ; {Save this character record at #R$B866 and read offset
 $B915 LD E,(IX+$05) ; #N$05.}
 $B918 LD D,(IX+$06) ; Read offset #N$06 of that record.
 $B91B PUSH DE       ; {Point #REGiy at that word.
 $B91C POP IY        ; }
 $B91E RET           ; Return.

; Check The Character Being Processed
;
; Used by the routines at #R$B90E and #R$CC37.
; .
; Compares the character being processed with each display link. The zero flag
; is set when one matches.
;
; O:F Zero flag set if object found, bit 0 set if not found
@label=CheckCharacterBeingProcessed
c$B91F LD IX,$9FF0   ; Point at the first display link.
@label=CheckCharacterBeingProcessed_FetchObjectPointer
*$B923 CALL $A0F7    ; {Go to #R$B931 if the object pointer is zero.
 $B926 JR Z,$B931    ; }
 $B928 LD A,($A036)  ; Read the character being processed.
 $B92B CP (IX+$00)   ; See whether it matches the record flag.
 $B92E RET Z         ; Return if they match.
 $B92F JR $B923      ; Jump back to #R$B923 to check object in a036.
@label=CheckCharacterBeingProcessed_Succeed
*$B931 OR %00000001  ; Reset the zero flag.
 $B933 RET           ; Return.

; Flags: Display
;
; Display flag beside the script display.
; Read by #R$B936, #R$CBA7 and #R$CC82.
g$B934 DEFB $00
 $B935 DEFB $00      ; Read by #R$B936.

; Process Script Display
;
; Used by the routine at #R$CC82.
; .
; Saves the character record and reads the object attribute for this script
; display.
@label=ProcessScriptDisplay
c$B936 PUSH IX         ; {Save the character record, the schedule entry and the
 $B938 PUSH IY         ; pointer.
 $B93A PUSH HL         ; }
 $B93B LD ($B935),A    ; Record the result in the display.
@label=ProcessScriptDisplay_Loop
*$B93E CALL $B90E      ; Call #R$B90E to read the object attribute.
 $B941 LD A,(IX+$07)   ; {Jump to #R$BA20 if byte #N$07 of the character record
 $B944 CP $02          ; is #N$02.
 $B946 JP Z,$BA20      ; }
 $B949 LD A,(IX+$01)   ; {Jump to #R$B98C if the moved marker is #N$FF.
 $B94C CP $FF          ;
 $B94E JR Z,$B98C      ; }
 $B950 LD A,($B935)    ; Read the display.
 $B953 LD ($B934),A    ; Record the result in the display flag at #R$B934.
 $B956 LD A,(IX+$02)   ; Read the character's room.
 $B959 LD ($A01C),A    ; Record the result in the display flag at #R$A01C.
 $B95C LD C,(IX+$03)   ; Read the action flags.
 $B95F LD B,(IX+$04)   ; {Call #R$B191 to initialise display buffer.
 $B962 LD ($B17E),BC   ;
 $B966 CALL $B191      ; }
 $B969 JR Z,$B9B4      ; Go to #R$B9B4 if no room record matches.
 $B96B LD IX,($B866)   ; {Read the saved character record and the object-table
 $B96F LD BC,($B17E)   ; pointer.}
 $B973 LD (IX+$03),C   ; {Store it in the action flags and store it in the
 $B976 LD (IX+$04),B   ; attribute type.}
 $B979 LD A,($A01C)    ; {Store the display flag (#R$A01C) and call #R$B9CA if
 $B97C LD (IX+$02),A   ; that flag is zero.
 $B97F AND A           ;
 $B980 CALL Z,$B9CA    ; }
@label=ProcessScriptDisplay_Store
*$B983 LD A,$01        ; Take #N$01.
@label=ProcessScriptDisplay_BringSavedPointer
*$B985 POP HL          ; {Restore the saved pointer, the saved schedule entry
 $B986 POP IY          ; and the saved character record from the stack.
 $B988 POP IX          ; }
 $B98A AND A           ; Clear the borrow so an empty entry returns as a failed
                       ; match.
 $B98B RET             ; Return.
; Read the character's room, then record the result in the saved character, then
; read the action flags.
@label=ProcessScriptDisplay_Next
*$B98C LD A,(IX+$02)   ; {Read the character's room, then call #R$CEDE to
 $B98F CALL $CEDE      ; resolve the room display parameter.}
 $B992 LD ($A033),A    ; Record the saved character.
 $B995 LD A,(IX+$03)   ; {Read the action flags, then call #R$CEDE to resolve
 $B998 CALL $CEDE      ; the room display parameter.}
 $B99B LD ($A034),A    ; Record the room display parameter.
 $B99E LD A,(IX+$04)   ; {Read the next parameter and call #R$CEDE to resolve
 $B9A1 CALL $CEDE      ; it.}
 $B9A4 LD ($A035),A    ; {Store the room graphics parameter at #R$A035 and call
 $B9A7 CALL $B9FA      ; #R$B9FA.}
 $B9AA JR $B983        ; Jump back to #R$B983 to take #N$01.
; Follows the link until it runs out, then clears the result.
@label=ProcessScriptDisplay_FollowsLinkRuns
*$B9AC CALL $B9CA      ; {Call #R$B9CA and jump back to #R$B9AC while it
 $B9AF JR NZ,$B9AC     ; returns non-zero.}
@label=ProcessScriptDisplay_Zero
*$B9B1 XOR A           ; {Jump back to #R$B985 to see whether it is zero.
 $B9B2 JR $B985        ; }
; Read the display flag, then take the saved character record.
@label=ProcessScriptDisplay_DisplayFlagSaved
*$B9B4 LD A,($A01C)    ; {Jump to #R$B9AC if the display is zero.
 $B9B7 AND A           ;
 $B9B8 JR Z,$B9AC      ; }
 $B9BA LD IX,($B866)   ; {Read the saved character record and clear its
 $B9BE LD (IX+$02),$00 ; location.}
 $B9C2 CALL $B9CA      ; {Go to #R$B9B1 if the link pointer is zero.
 $B9C5 JR Z,$B9B1      ; }
 $B9C7 JP $B93E        ; Go back to #R$B93E for the next character.

; Copy The Link Ahead Of This Record
;
; Used by the routine at #R$B936.
; .
; Reads the saved character record and copies the link ahead of it into the
; object attribute.
@label=CopyLinkAhead
c$B9CA LD IX,($B866)  ; Read the saved character record.
@label=CopyLinkAhead_StoreLink
*$B9CE LD L,(IY-$02)  ; {Read the link word stored before the record at #REGiy.
 $B9D1 LD H,(IY-$01)  ; }
 $B9D4 LD (IX+$05),L  ; Store the low byte of the link at offset #N$05.
 $B9D7 LD (IX+$06),H  ; {Store the high byte of the link at offset #N$06 and
 $B9DA PUSH IX        ; keep #REGix.}
 $B9DC PUSH IY        ; {Copy the memory-link record from #REGiy into #REGix.
 $B9DE POP IX         ; }
 $B9E0 CALL $A1C7     ; {Call #R$A1C7 to follow this memory link.
 $B9E3 POP IX         ; }
 $B9E5 LD A,L         ; {Jump ahead to #R$B9F5 if the pointer is
 $B9E6 OR H           ; #N($0000,$04,$04).
 $B9E7 JR Z,$B9F5     ; }
 $B9E9 PUSH HL        ; {Point #REGiy at #REGhl and jump to #R$B9CE if bit 6 of
 $B9EA POP IY         ; #REGiy+#N$01 is set.
 $B9EC BIT 6,(IY+$01) ;
 $B9F0 JR NZ,$B9CE    ; }
 $B9F2 OR %00000001   ; Reset the zero flag.
 $B9F4 RET            ; Return.
; Copies the pointer and clears the result.
@label=CopyLinkAhead_ClearAndReturn
*$B9F5 CALL $B9FA     ; Call #R$B9FA to copy pointer to stack.
 $B9F8 XOR A          ; Clear #REGa.
 $B9F9 RET            ; Return.

; Copy Pointer To Stack
;
; Used by the routines at #R$B936, #R$B9CA and #R$BA3E.
; .
; Copies pointer To Stack.
@label=CopyPointerToStack
c$B9FA LD IY,$9FEE   ; {Call #R$A104 to step pointer and compare.
 $B9FE PUSH IX       ;
 $BA00 POP DE        ;
 $BA01 CALL $A104    ; }
 $BA04 LD L,(IX-$02) ; {Read the pointer saved ahead of this record.
 $BA07 LD H,(IX-$01) ; }
 $BA0A LD (IY-$02),L ; Store the low byte of the pointer in the previous
                     ; record.
 $BA0D LD (IY-$01),H ; {Jump back to #R$A1C7 to run memory entry.
 $BA10 JP $A1C7      ; }

; Word: Display Pointer
;
; Pointer used while copying a character display.
; Read by #R$BDC2 and #R$BE3C.
g$BA13 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $BA1B DEFB $00,$00,$00,$00,$00

; Process Character Display
;
; Used by the routine at #R$B936.
; .
; Reads the character being processed and clears its script list for ids #N$02
; and #N$03.
@label=ProcessCharacterDisplay
c$BA20 LD A,($A036)  ; {Read the character being processed and take the
 $BA23 LD HL,$BA67   ; workspace byte at #R$BA67.}
 $BA26 CP $03        ; {Jump ahead to #R$BA31 if the character being processed
 $BA28 JR Z,$BA31    ; is #N$03.}
 $BA2A LD HL,$BB67   ; {Jump ahead to #R$BA34 if the character being processed
 $BA2D CP $02        ; is not #N$02.
 $BA2F JR NZ,$BA34   ; }
@label=ProcessCharacterDisplay_Next
*$BA31 CALL $BA3E    ; Call #R$BA3E to clear the character-script list.
@label=ProcessCharacterDisplay_Store
*$BA34 LD A,$01      ; Take #N$01.
 $BA36 POP HL        ; {Restore #REGhl, #REGiy and #REGix from the stack.
 $BA37 POP IY        ;
 $BA39 POP IX        ; }
 $BA3B AND A         ; Clear the carry before marking this character display as
                     ; finished.
 $BA3C SCF           ; Mark the condition as met.
 $BA3D RET           ; Return.

; Record The Result In The Character Script
;
; Used by the routine at #R$BA20.
; .
; Clears the character-script list, then reads the script address stored on
; this character.
@label=RecordResultCharacterScript
c$BA3E PUSH IX        ; {Clear the character script entry list.
 $BA40 XOR A          ;
 $BA41 LD ($9FEB),A   ; }
 $BA44 LD E,(IX+$05)  ; Read the object attribute.
 $BA47 LD D,(IX+$06)  ; {Call #R$D1DB to jump to handler.
 $BA4A PUSH DE        ;
 $BA4B PUSH DE        ;
 $BA4C POP IY         ;
 $BA4E CALL $D1DB     ; }
 $BA51 POP IX         ; {Call #R$A1AF to follow the record pointer.
 $BA53 PUSH AF        ;
 $BA54 CALL $A1AF     ;
 $BA57 POP AF         ; }
 $BA58 POP IX         ; {Call #R$B9FA to copy pointer to stack.
 $BA5A PUSH AF        ;
 $BA5B CALL $B9FA     ;
 $BA5E POP AF         ; }
 $BA5F RET            ; Return.
 $BA60 DEFB $00       ; State byte for this character display. Written by #R$BA67 and #R$BB4D.
                      ; Read by #R$BAAB and #R$BB16.
 $BA61 DEFB $00       ; Second state byte, written beside #R$BA60 by #R$BA67 and #R$BB46.
                      ; Read by #R$BAB2.
 $BA62 DEFB $00       ; First byte of the object id kept while the display is built.
                      ; Read by #R$BAC1 and #R$BAFA.
 $BA63 DEFB $00       ; Second byte of that object id. With #R$BA64 it is also read as a word.
                      ; Read by #R$BAC9.
 $BA64 DEFB $00       ; Third byte of that object id. #R$BAD1 compares it with
                      ; the record.
 $BA65 DEFB $00       ; Low byte of the saved character record. Written by #R$BA7F and read by
                      ; #R$BB5C.
 $BA66 DEFB $00       ; High byte of the saved character record, stored with
                      ; #R$BA65.
 $BA67 LD ($BA60),A   ; {Clear both state bytes at #R$BA60 and #R$BA61.
 $BA6A LD ($BA61),A   ; }
; A following display value is not #N$FF.
@label=RecordResultCharacterScript_FollowingDisplay
*$BA6D CALL $BD7E     ; {Call #R$BD7E and jump to #R$BBBE if a following
 $BA70 JP C,$BBBE     ; display value is not #N$FF.}
 $BA73 JR Z,$BAA6     ; Go to #R$BAA6 if the room's object list is empty.
 $BA75 CALL $BD4B     ; {Go to #R$BA85 if the object table ends before the
 $BA78 JR NZ,$BA85    ; moved marker.}
 $BA7A LD A,$01       ; Take #N$01.
*$BA7C CALL $BB46     ; Call #R$BB46 to save the object state.
 $BA7F LD ($BA65),IX  ; {Save the character record at #R$BA65 and jump ahead to
 $BA83 JR $BAAB       ; #R$BAAB.}
; Leave #N$02 as the result, then see whether bit 5 of the action flags is set,
; then check for character id 50.
@label=RecordResultCharacterScript_LeaveResultBit
*$BA85 CALL $BD51     ; {Go to #R$BA9D if the object table ends before the
 $BA88 JR NZ,$BA9D    ; moved marker.}
 $BA8A LD A,$02       ; {Take #N$02 and jump to #R$BA7C if bit 5 of the action
 $BA8C BIT 5,(IX+$03) ; flags is set.
 $BA90 JR NZ,$BA7C    ; }
; Get character attribute.
 $BA92 CALL $D29D     ; Call #R$D29D to read the character's attribute.
; Is the attribute below #N$32?
 $BA95 CP $32         ; {Go to #R$BA7C with #REGa=#N$03 if the value from
 $BA97 LD A,$03       ; #R$D29D is below #N$32.
 $BA99 JR C,$BA7C     ; }
 $BA9B JR $BAA6       ; The attribute is #N$32 or more, so skip the next test
                      ; and follow the character link at #R$BAA6.
; Reads the character's attribute. A value below #N$46 selects picture #N$04; otherwise the character
; link is followed.
; .
; Get character attribute.
@label=RecordResultCharacterScript_ReadAttribute
*$BA9D CALL $D29D     ; Call #R$D29D to read the character's attribute.
; Is the attribute below #N$46?
 $BAA0 CP $46         ; {Go to #R$BA7C with #REGa=#N$04 if the value from
 $BAA2 LD A,$04       ; #R$D29D is below #N$46.
 $BAA4 JR C,$BA7C     ; }
@label=RecordResultCharacterScript_FollowCharacterLink
*$BAA6 CALL $AEA9     ; Call #R$AEA9 to follow the character link.
 $BAA9 JR NZ,$BA6D    ; Go back to #R$BA6D when the character link is still
                      ; set.
@label=RecordResultCharacterScript_StateByteZero
*$BAAB LD A,($BA60)   ; {Jump to #R$BB3F if the state byte at #R$BA60 is zero.
 $BAAE AND A          ;
 $BAAF JP Z,$BB3F     ; }
 $BAB2 LD A,($BA61)   ; {Jump to #R$BB16 if the state byte at #R$BA61 is zero.
 $BAB5 AND A          ;
 $BAB6 JR Z,$BB16     ; }
 $BAB8 LD IX,$9FF6    ; Point at the object display link.
@label=RecordResultCharacterScript_Loop
*$BABC CALL $A0F7     ; {Go to #R$BAF5 if the object pointer is zero.
 $BABF JR Z,$BAF5     ; }
 $BAC1 LD A,($BA62)   ; {Jump back to #R$BABC while this id does not match the
 $BAC4 CP (IX+$00)    ; record's flag byte.
 $BAC7 JR NZ,$BABC    ; }
 $BAC9 LD A,($BA63)   ; {Jump back to #R$BABC while this id does not match the
 $BACC CP (IX+$01)    ; moved marker.
 $BACF JR NZ,$BABC    ; }
 $BAD1 LD A,($BA64)   ; {Jump back to #R$BABC while this id does not match the
 $BAD4 CP (IX+$02)    ; location.
 $BAD7 JR NZ,$BABC    ; }
 $BAD9 PUSH IY        ; {Save the schedule entry and the character record.
 $BADB PUSH IX        ; }
 $BADD POP DE         ; {Use the saved record as the source and point #REGiy at
 $BADE LD IY,$9FF4    ; #R$9FF0+#N$04.}
; Step pointer and compare.
 $BAE2 CALL $A104     ; Call #R$A104 to compare the pointer with the next
                      ; record.
 $BAE5 LD A,(IX-$02)  ; {Copy the pointer into the previous character record.
 $BAE8 LD (IY-$02),A  ; }
 $BAEB LD A,(IX-$01)  ; {Store the high byte of the pointer in the previous
 $BAEE LD (IY-$01),A  ; character record.
 $BAF1 POP IY         ; }
 $BAF3 JR $BAFA       ; Jump ahead to #R$BAFA to read the saved display
                      ; pointer.
; Ask for five bytes, then read the saved display pointer.
@label=RecordResultCharacterScript_AskFiveBytes
*$BAF5 LD A,$05       ; {Take #N$05, then call #R$A11C to allocate memory.
 $BAF7 CALL $A11C     ; }
@label=RecordResultCharacterScript_SavedDisplayDisplay
*$BAFA LD A,($BA62)   ; {Read the object id saved at #R$BA62.
 $BAFD LD HL,($BA63)  ; }
 $BB00 LD (IX+$00),A  ; Store the record's flag byte.
 $BB03 LD (IX+$01),L  ; {Store the moved marker and store the location.
 $BB06 LD (IX+$02),H  ; }
 $BB09 LD HL,($9FF4)  ; Read the saved display link.
 $BB0C LD ($9FF4),IX  ; {Store the low byte of the pointer in the previous
 $BB10 LD (IX-$02),L  ; character record.}
 $BB13 LD (IX-$01),H  ; Store the high byte of the pointer in the previous
                      ; character record.
@label=RecordResultCharacterScript_StateByte
*$BB16 LD A,($BA60)   ; {Jump to #R$BB5C if the state byte at #R$BA60 is #N$01.
 $BB19 CP $01         ;
 $BB1B JR Z,$BB5C     ; }
 $BB1D CALL $D29D     ; {Call #R$D29D to read the character attribute and jump
 $BB20 CP $19         ; to #R$BB3F when it is below #N$19.
 $BB22 JR C,$BB3F     ; }
 $BB24 LD IX,$BA62    ; {Point at the workspace byte at #R$BA62, then call #R$BD06 to run object
 $BB28 CALL $BD06     ; pointer.}
 $BB2B JR NZ,$BB3F    ; Go to #R$BB3F if no differing object pointer remains.
 $BB2D LD A,C         ; {Take the count and call #R$A4BC to point to object
 $BB2E PUSH BC        ; attribute byte.
 $BB2F CALL $A4BC     ;
 $BB32 POP AF         ; }
 $BB33 PUSH HL        ; {Call #R$A4BC to point to object attribute byte, saving
 $BB34 CALL $A4BC     ; pointer.}
 $BB37 PUSH HL        ; {Take the police message, then call #R$A59F to print
 $BB38 LD HL,$6F62    ; the police message.
 $BB3B CALL $A59F     ; }
 $BB3E RET            ; Return.
; Use the police as the pointer.
@label=RecordResultCharacterScript_PolicePointer
*$BB3F LD HL,$6F54    ; {Take the police message, then call #R$A59F to print
 $BB42 CALL $A59F     ; the police message.}
 $BB45 RET            ; Return.

; Save The Object State
;
; Used by the routine at #R$BA3E.
; .
; Records the result in #R$BA60, sets the byte at #R$BA61, and copies three
; object bytes from #R$BA13+#N$06 to #R$BA62.
@label=SaveObjectState
c$BB46 PUSH AF       ; {Set the byte at #R$BA61, keeping #REGa.
 $BB47 LD A,$01      ;
 $BB49 LD ($BA61),A  ;
 $BB4C POP AF        ; }
 $BB4D LD ($BA60),A  ; Store it in the workspace byte at #R$BA60.
 $BB50 LD HL,$BA19   ; {Point #REGhl at #R$BA13+#N$06 and #REGde at #R$BA62.
 $BB53 LD DE,$BA62   ; }
 $BB56 LD BC,$0003   ; Take a length of #N$03 bytes.
 $BB59 LDIR          ; Copy the counted bytes.
 $BB5B RET           ; Return.

; Read The Action Flags
;
; Used by the routine at #R$BA3E.
; .
; Reads the saved character record and dispatches through its action handler.
@label=ReadActionFlags
c$BB5C LD IX,($BA65)  ; {Read the saved character record and the handler stored
 $BB60 LD L,(IX+$03)  ; in it.
 $BB63 LD H,(IX+$04)  ; }
 $BB66 JP (HL)        ; Jump to the handler address in #REGhl.
 $BB67 LD ($BA1D),A   ; {Store #REGa in the flag at #R$BA13+#N$0A and the count
 $BB6A LD ($BA1C),A   ; at #R$BA13+#N$09.}
; A following display value is not #N$FF.
@label=ReadActionFlags_CalculateObjectPointer
*$BB6D CALL $BD7E     ; {Call #R$BD7E and jump to #R$BBBE if a following
 $BB70 JP C,$BBBE     ; display value is not #N$FF.}
 $BB73 CALL $BC21     ; {Go to #R$BB7C if the object is not a moving marker.
 $BB76 JR Z,$BB7C     ; }
 $BB78 LD HL,$BA1C    ; {Count one more at #R$BA13+#N$09.
 $BB7B INC (HL)       ; }
@label=ReadActionFlags_FollowCharacterLink
*$BB7C CALL $AEA9     ; Call #R$AEA9 to follow the character link.
 $BB7F JR NZ,$BB6D    ; Go back to #R$BB6D when the character link is still
                      ; set.
 $BB81 LD A,($BA1C)   ; {Jump to #R$BB8E if the count at #R$BA13+#N$09 is set.
 $BB84 AND A          ;
 $BB85 JR NZ,$BB8E    ; }
 $BB87 LD HL,$725F    ; {Take the message, then call #R$A59F to print the
 $BB8A CALL $A59F     ; message.}
 $BB8D RET            ; Return.
; Tests the flag at #R$BA13+#N$0A.
@label=ReadActionFlags_SavedFlag
*$BB8E LD A,($BA1D)   ; {Jump to #R$BBC9 if the flag at #R$BA13+#N$0A is zero.
 $BB91 AND A          ;
 $BB92 JR Z,$BBC9     ; }
 $BB94 LD IX,($BA1E)  ; {Point #REGix at the record at #R$BA13+#N$0B and call
 $BB98 PUSH IX        ; #R$BE5A.
 $BB9A CALL $BE5A     ; }
@label=ReadActionFlags_ActionFlags
*$BB9D LD A,(IX+$03)  ; {Jump to #R$BBB1 if the top two bits of the action
 $BBA0 AND $C0        ; flags are #N$80.
 $BBA2 CP $80         ;
 $BBA4 JR Z,$BBB1     ; }
 $BBA6 BIT 3,(IX+$03) ; {Jump to #R$BBB1 if bit 3 of the action flags is set.
 $BBAA JR NZ,$BBB1    ; }
 $BBAC CALL $BE72     ; {Call #R$BE72 to count down this repeating entry.
 $BBAF JR $BB9D       ; }
; Print the message before returning.
@label=ReadActionFlags_PrintMessageBefore
*$BBB1 POP IX         ; {Restore the record from the stack and go to #R$BBC4 if
 $BBB3 JR NZ,$BBC4    ; bit 3 of the action flags is set.}
 $BBB5 LD HL,$7295    ; Point #REGhl at the message at #R$722D+#N$68.
@label=ReadActionFlags_KeepCharacterRecord
*$BBB8 PUSH IX        ; {Keep the character record, then call #R$A59F to print
 $BBBA CALL $A59F     ; the message.}
 $BBBD RET            ; Return.
; This entry point is used by the routine at #R$BA3E.
; .
; Use the message as the pointer.
@label=ReadActionFlags_MessagePointer
*$BBBE LD HL,$7243    ; {Jump back to #R$A59F to print this message.
 $BBC1 JP $A59F       ; }
; Use the message as the pointer.
@label=ReadActionFlags_Next
*$BBC4 LD HL,$72A6    ; {Point at this message and print it from #R$BBB8.
 $BBC7 JR $BBB8       ; }
; Read the count, then clear the outstanding
; borrow.
@label=ReadActionFlags_CountClearOutstanding
*$BBC9 CALL $BC46     ; {Call #R$BC46 to run game status entries, then call #R$BC9C to run game
 $BBCC CALL $BC9C     ; status entries alternate.}
 $BBCF LD A,B         ; {Jump ahead to #R$BBE5 if the count is not zero.
 $BBD0 AND A          ;
 $BBD1 JR NZ,$BBE5    ; }
 $BBD3 CALL $BC74     ; {Jump ahead to #R$BBDE if the count is zero.
 $BBD6 AND A          ;
 $BBD7 JR Z,$BBDE     ; }
 $BBD9 LD HL,$72BD    ; {Point at this message and print it from #R$BBB8.
 $BBDC JR $BBB8       ; }
; Use the message as the pointer.
@label=ReadActionFlags_MessagePointerAgain
*$BBDE LD HL,$727E    ; {Take the message, then call #R$A59F to print the
 $BBE1 CALL $A59F     ; message.}
 $BBE4 RET            ; Return.

; Print Text Based On Flag
;
; Used by the routines at #R$9DD8 and #R$BB5C.
; .
; Prints the common-word lead-in, and a second message when the flag is not
; #N$01.
@label=PrintTextBasedOnFlag
c$BBE5 PUSH AF        ; {Take the common words and call #R$A59F to print this
 $BBE6 LD HL,$67FF    ; message.
 $BBE9 CALL $A59F     ;
 $BBEC POP AF         ; }
 $BBED CP $01         ; {Call #R$A59F if the character is not #N$01.
 $BBEF LD HL,$72D6    ;
 $BBF2 CALL NZ,$A59F  ; }
 $BBF5 BIT 4,(IX+$03) ; {Jump to #R$BC1A if the action state flag is clear.
 $BBF9 JR Z,$BC1A     ; }
 $BBFB RES 1,(IX+$03) ; {Clear the action-taken flag.
 $BBFF PUSH IX        ; }
 $BC01 LD HL,$72E1    ; Point #REGhl at the message at #R$722D+#N$B4.
; Print text and handle control characters.
 $BC04 CALL $A59F     ; Call #R$A59F to print this message.
 $BC07 LD L,(IX+$04)  ; {Read the message address from bytes #N$04-#N$05 of the
 $BC0A LD H,(IX+$05)  ; record.}
 $BC0D LD A,L         ; {Jump to #R$A59F to print this text when #REGhl is not
 $BC0E OR H           ; zero.
 $BC0F JP NZ,$A59F    ; }
 $BC12 LD A,$22       ; {Print a quotation mark and a full stop.
 $BC14 CALL $A9B7     ;
 $BC17 JP $A414       ; }
; Read the handler address and jump to it.
@label=PrintTextBasedOnFlag_Next
*$BC1A LD L,(IX+$04)  ; {Read the handler address into #REGhl.
 $BC1D LD H,(IX+$05)  ; }
 $BC20 JP (HL)        ; Jump to the handler address in #REGhl.

; Check Object Attribute
;
; Used by the routine at #R$BB5C.
; .
; Returns zero unless #R$BD51 passes and the top two bits of the action flags
; are #N$80. A match is stored at #R$BA1B+#N$03 and passed to #R$BCC9.
@label=CheckObjectAttribute
c$BC21 CALL $BD51     ; {Go to #R$BC2F if the object table ends before the
 $BC24 JR NZ,$BC2F    ; moved marker.}
 $BC26 LD A,(IX+$03)  ; {Jump to #R$BC31 if the top two bits of the action
 $BC29 AND $C0        ; flags are #N$80.
 $BC2B CP $80         ;
 $BC2D JR Z,$BC31     ; }
@label=CheckObjectAttribute_Next
*$BC2F XOR A          ; Clear #REGa.
 $BC30 RET            ; Return.
; Stores this record and tests it.
@label=CheckObjectAttribute_StoreRecord
*$BC31 LD ($BA1E),IX  ; {Store this record at #R$BA13+#N$0B and call #R$BCC9.
 $BC35 CALL $BCC9     ; }
 $BC38 JR Z,$BC43     ; Go to #R$BC43 if the attribute needs no extra bit
                      ; handling.
 $BC3A LD A,$01       ; {Write #N$01 to the flag at #R$BA13+#N$0A.
 $BC3C LD ($BA1D),A   ; }
 $BC3F SET 0,(IX+$03) ; Set the action-pending flag.
@label=CheckObjectAttribute_TestActionSucceeded
*$BC43 OR %00000001   ; Reset the zero flag.
 $BC45 RET            ; Return.

; Process Game Status Entries
;
; Used by the routines at #R$9DD8 and #R$BB5C.
; .
; See whether this byte is the end marker, then test the mark on this byte
@label=ProcessGameStatusEntries
c$BC46 LD IX,$9965    ; {Use the character pairs (#R$994D+#N$18).
 $BC4A LD HL,$0000    ;
 $BC4D PUSH HL        ; }
@label=ProcessGameStatusEntries_Loop
*$BC4E LD A,(IX+$00)  ; {Jump to #R$BC68 if the record's flag byte is #N$FF.
 $BC51 CP $FF         ;
 $BC53 JR Z,$BC68     ; }
 $BC55 BIT 0,(IX+$03) ; {Jump to #R$BC63 if the action-pending flag is clear.
 $BC59 JR Z,$BC63     ; }
 $BC5B BIT 5,(IX+$03) ; {Jump to #R$BC63 if a marker on the action flags is
 $BC5F JR NZ,$BC63    ; set.}
 $BC61 PUSH IX        ; {Call #R$BE5A, keeping character record.
*$BC63 CALL $BE5A     ; }
 $BC66 JR $BC4E       ; Jump back to #R$BC4E to read the record flag, see whether it is the end marker and
                      ; jump to #R$BC68.
; Keep the match flags before returning.
@label=ProcessGameStatusEntries_KeepMatchFlags
*$BC68 POP HL         ; Restore the saved pointer from the stack.
 $BC69 LD A,H         ; {See whether the pointer is empty.
 $BC6A OR L           ; }
 $BC6B RET Z          ; Return when the status pointer is empty.
 $BC6C PUSH HL        ; {Call #R$BCC9 to check bit and process.
 $BC6D POP IX         ;
 $BC6F CALL $BCC9     ; }
 $BC72 JR $BC68       ; Go back to #R$BC68 for the next status entry.

; Process Game Status Entries With Counter
;
; Used by the routines at #R$9DD8 and #R$BB5C.
; .
; Walks the character pairs at #R$994D+#N$18 and counts the entries that still
; have an action pending.
@label=ProcessGameStatusEntriesWithCounter
c$BC74 LD IX,$9965    ; {Use the character pairs (#R$994D+#N$18).
 $BC78 LD B,$00       ; }
@label=ProcessGameStatusEntriesWithCounter_Loop
*$BC7A LD A,(IX+$00)  ; {Jump to #R$BC96 if the record's flag byte is #N$FF.
 $BC7D CP $FF         ;
 $BC7F JR Z,$BC96     ; }
 $BC81 BIT 0,(IX+$03) ; {Jump to #R$BC91 if the action-pending flag is clear.
 $BC85 JR Z,$BC91     ; }
 $BC87 CALL $BCC9     ; {Go to #R$BC91 if the attribute needs no extra bit
 $BC8A JR Z,$BC91     ; handling.}
 $BC8C LD ($BA1E),IX  ; {Remember this record at #R$BA13+#N$0B and count one
 $BC90 INC B          ; more.}
@label=ProcessGameStatusEntriesWithCounter_Next
*$BC91 CALL $BE5A     ; {Jump back to #R$BC7A to read the record flag, see whether it is the end marker and
 $BC94 JR $BC7A       ; jump to #R$BC96.}
; Returns the count and the record saved for this pass.
@label=ProcessGameStatusEntriesWithCounter_ReturnCount
*$BC96 LD A,B         ; {Take the count in #REGa and the record at
 $BC97 LD IX,($BA1E)  ; #R$BA13+#N$0B.}
 $BC9B RET            ; Return.

; Process Game Status Entries Alternate
;
; Used by the routines at #R$9DD8 and #R$BB5C.
; .
; Walks those character pairs and skips an entry whose action is still pending.
@label=ProcessGameStatusEntriesAlternate
c$BC9C LD IX,$9965    ; {Use the character pairs (#R$994D+#N$18).
 $BCA0 LD B,$00       ; }
@label=ProcessGameStatusEntriesAlternate_Loop
*$BCA2 LD A,(IX+$00)  ; {Jump to #R$BCC4 if the record's flag byte is #N$FF.
 $BCA5 CP $FF         ;
 $BCA7 JR Z,$BCC4     ; }
 $BCA9 BIT 0,(IX+$03) ; {Jump to #R$BCBD if the action-pending flag is clear.
 $BCAD JR Z,$BCBD     ; }
 $BCAF CALL $BCC9     ; {Go to #R$BCBD if bit 2 is set and the entry check
 $BCB2 JR NZ,$BCBD    ; succeeds.}
 $BCB4 LD A,B         ; {Jump ahead to #R$BCBD if the count is not zero.
 $BCB5 INC B          ;
 $BCB6 AND A          ;
 $BCB7 JR NZ,$BCBD    ; }
 $BCB9 LD ($BA1E),IX  ; Store this record at #R$BA13+#N$0B.
@label=ProcessGameStatusEntriesAlternate_Next
*$BCBD PUSH BC        ; {Call #R$BE72 to run entry with counter.
 $BCBE CALL $BE72     ;
 $BCC1 POP BC         ; }
 $BCC2 JR $BCA2       ; Jump back to #R$BCA2 for the next entry.
; Read the working value before returning.
@label=ProcessGameStatusEntriesAlternate_SavedRecord
*$BCC4 LD IX,($BA1E)  ; Point #REGix at the record saved at #R$BA13+#N$0B.
 $BCC8 RET            ; Return.

; Check Bit And Process
;
; Used by the routines at #R$BC21, #R$BC46, #R$BC74 and #R$BC9C.
; .
; Tests the action flags and runs #R$BF08 when bit 2 is set. Returns non-zero
; when that entry is accepted, and zero when it is not.
@label=CheckBitAndProcess
c$BCC9 BIT 2,(IX+$03) ; {Jump to #R$BCDA if a marker on the action flags is
 $BCCD JR Z,$BCDA     ; clear.}
 $BCCF PUSH IX        ; {Call #R$BF08 to test bit and process entry.
 $BCD1 PUSH BC        ;
 $BCD2 CALL $BF08     ;
 $BCD5 POP BC         ; }
 $BCD6 POP IX         ; {Go to #R$BD03 if the entry check returns zero.
 $BCD8 JR Z,$BD03     ; }
@label=CheckBitAndProcess_Next
*$BCDA BIT 5,(IX+$03) ; {Jump to #R$BCE6 if a marker on the action flags is
 $BCDE JR Z,$BCE6     ; clear.}
 $BCE0 SET 0,(IX+$03) ; {Set the action-pending flag and jump ahead to #R$BD01.
 $BCE4 JR $BD01       ; }
; Mark the action taken and clear the bit that would repeat it.
@label=CheckBitAndProcess_MarkActionTaken
*$BCE6 SET 1,(IX+$03) ; {Mark the action taken so the script will not repeat
 $BCEA RES 0,(IX+$03) ; it.}
 $BCEE BIT 4,(IX+$03) ; {Jump to #R$BD01 if the action state flag is clear.
 $BCF2 JR Z,$BD01     ; }
 $BCF4 LD L,(IX+$04)  ; {Read the handler address from bytes #N$04-#N$05 of the
 $BCF7 LD H,(IX+$05)  ; record and keep the record.
 $BCFA PUSH IX        ; }
 $BCFC CALL $D1DB     ; {Call #R$D1DB to jump to handler.
 $BCFF POP IX         ; }
@label=CheckBitAndProcess_ClearResult
*$BD01 XOR A          ; Clear #REGa.
 $BD02 RET            ; Return.
@label=CheckBitAndProcess_TestStepSucceedsScript
*$BD03 OR %00000001   ; Reset the zero flag.
 $BD05 RET            ; Return.

; Process Object Pointer
;
; Used by the routine at #R$BA3E.
; .
; Follows the object link and compares it with the character on screen.
@label=ProcessObjectPointer
c$BD06 PUSH IY       ; Save the schedule entry.
 $BD08 PUSH IX       ; {Copy the character record from #REGix into #REGiy.
 $BD0A POP IY        ; }
 $BD0C LD IX,$9FF6   ; Point at the object display link.
@label=ProcessObjectPointer_Loop
*$BD10 CALL $A0F7    ; {Go to #R$BD46 if the object pointer is zero.
 $BD13 JR Z,$BD46    ; }
 $BD15 LD B,(IX+$02) ; {Take the byte at #REGix+#N$02 into #REGb and the byte
 $BD18 LD C,(IY+$02) ; at #REGiy+#N$02 into #REGc.}
 $BD1B LD A,(IX+$00) ; {Jump ahead to #R$BD3E if this id matches the character
 $BD1E CP (IY+$00)   ; id.
 $BD21 JR Z,$BD3E    ; }
 $BD23 LD C,(IY+$00) ; {Store #REGiy+#N$00 in #REGc and jump ahead to #R$BD3E
 $BD26 CP (IY+$02)   ; if the id in #REGa matches #REGiy+#N$02.
 $BD29 JR Z,$BD3E    ; }
 $BD2B LD B,(IX+$00) ; Read the record's flag byte.
 $BD2E LD A,(IX+$02) ; {Jump ahead to #R$BD3E if the byte at #REGix+#N$02
 $BD31 CP (IY+$02)   ; matches the byte at #REGiy+#N$02.
 $BD34 JR Z,$BD3E    ; }
 $BD36 LD C,(IY+$02) ; {Jump back to #R$BD10 while this id does not match the
 $BD39 CP (IY+$00)   ; character id.
 $BD3C JR NZ,$BD10   ; }
@label=ProcessObjectPointer_Next
*$BD3E LD A,B        ; {Go to #R$BD10 if the object id matches the character.
 $BD3F CP C          ;
 $BD40 JR Z,$BD10    ;
 $BD42 POP IY        ; }
 $BD44 XOR A         ; Clear #REGa.
 $BD45 RET           ; Return.
@label=ProcessObjectPointer_TestStepSucceedsScript
*$BD46 OR $01        ; Reset the zero flag.
 $BD48 POP IY        ; Restore #REGiy from the stack.
 $BD4A RET           ; Return.

; Set Object Table Pointer
;
; Used by the routine at #R$BA3E.
; .
; Starts the object scan at the action separator.
@label=SetObjectTablePointer
c$BD4B LD IX,$9A7D   ; {Start the object scan at the action separator.
 $BD4F JR $BD55      ; }

; Search Object Table
;
; Used by the routines at #R$BA3E and #R$BC21.
; .
; Starts the object scan at the character table.
@label=SearchObjectTable
c$BD51 LD IX,$9965   ; Use the character pairs (#R$994D+#N$18).

; Read The Record Flag
;
; Used by the routine at #R$BD4B.
; .
; Scans the objects until the flag byte is #N$FF, checking each one against the
; moved marker.
@label=ScanObjectsUntilEndMarker
c$BD55 LD A,(IX+$00) ; {Jump to #R$BD66 if the record's flag byte is #N$FF.
 $BD58 CP $FF        ;
 $BD5A JR Z,$BD66    ; }
 $BD5C CALL $BD69    ; {Go to #R$BD68 if the object matches the moved marker.
 $BD5F JR Z,$BD68    ; }
 $BD61 CALL $BE5A    ; {Read the next object and try again from #R$BD55.
 $BD64 JR $BD55      ; }
@label=ScanObjectsUntilEndMarker_Next
*$BD66 OR %00000001  ; Reset the zero flag.
*$BD68 RET           ; Return.

; See Whether It Matches The Moved Marker
;
; Used by the routine at #R$BD55.
; .
; Compares the saved object's moved marker, flag byte and room with this
; record.
@label=SeeWhetherItMatchesMovedMarker
c$BD69 LD A,($BA1A)  ; Read the saved object's moved marker.
 $BD6C CP (IX+$01)   ; See whether this object is the one that was moved.
 $BD6F RET NZ        ; Return if they differ.
 $BD70 LD A,($BA19)  ; Read the saved object's flag byte.
 $BD73 CP (IX+$00)   ; See whether it matches the record flag.
 $BD76 RET NZ        ; Return if they differ.
 $BD77 LD A,($BA1B)  ; Read the saved object's room.
 $BD7A CP (IX+$02)   ; See whether it matches the character's room.
 $BD7D RET           ; Return.

; Calculate Object Pointer Offset
;
; Used by the routines at #R$BA3E and #R$BB5C.
; .
; Points #REGhl at byte #N$18 of the record, or at the object display link when
; bit 7 is set.
@label=CalculateObjectPointerOffset
c$BD7E PUSH IY        ; {Point #REGhl at byte #N$18 of the record
 $BD80 POP HL         ; (#REGiy+#N$18).
 $BD81 LD DE,$0018    ;
 $BD84 ADD HL,DE      ; }
 $BD85 BIT 7,(IY+$19) ; {Jump to #R$BD8E if a marker on the schedule entry is
 $BD89 JR Z,$BD8E     ; clear.}
 $BD8B LD HL,$9FF6    ; Take the object display link.
@label=CalculateObjectPointerOffset_Next
*$BD8E BIT 6,(IY+$19) ; {Jump to #R$BD97 if a marker on the schedule entry is
 $BD92 JR Z,$BD97     ; clear.}
 $BD94 LD HL,$9FFC    ; Take the alternate display link.
@label=CalculateObjectPointerOffset_DisplayDataPointer
*$BD97 LD DE,$B172    ; {Copy #N$06 bytes from the display data at #R$B172.
 $BD9A LD BC,$0006    ;
 $BD9D LDIR           ; }
 $BD9F PUSH IY        ; {Point #REGhl at byte #N$08 of the record
 $BDA1 POP HL         ; (#REGiy+#N$08).
 $BDA2 LD DE,$0008    ;
 $BDA5 ADD HL,DE      ; }
 $BDA6 LD DE,$B178    ; Take the display mode flag.
 $BDA9 LD BC,$0006    ; {Copy #N$06 bytes and read #REGiy+#N$00 into #REGl.
 $BDAC LDIR           ;
 $BDAE LD L,(IY+$00)  ; }
 $BDB1 LD A,(IY+$01)  ; {Keep the low nibble of #REGiy+#N$01 in #REGh.
 $BDB4 AND $0F        ;
 $BDB6 LD H,A         ; }
 $BDB7 LD ($BA17),HL  ; Record the display pointer.
 $BDBA PUSH IY        ; {Call #R$BDC2 to store the character record.
 $BDBC CALL $BDC2     ;
 $BDBF POP IY         ; }
 $BDC1 RET            ; Return.

; Point The Object List At This Room
;
; Used by the routine at #R$BD7E.
; .
; Points the object list at this room and remembers the character record in the
; display pointer.
;
; .
;
; Adjust object table for sum.
@label=PointObjectListRoom
c$BDC2 CALL $D04F    ; Call #R$D04F to point the object list at this room.
 $BDC5 LD ($BA13),IX ; {Store this object pointer at #R$BA13 and at
 $BDC9 LD ($BA15),IX ; #R$BA13+#N$02.}
 $BDCD LD DE,($BA17) ; {Read the display pointer and point #REGhl at the
 $BDD1 LD HL,$994D   ; character pairs at #R$994D.}
 $BDD4 LD B,$01      ; Count #N$01.
@label=PointObjectListRoom_Loop
*$BDD6 LD A,(HL)     ; Read the next object-list byte.
 $BDD7 INC HL        ; Advance through the object list.
 $BDD8 OR (HL)       ; Merge the following object-list byte.
 $BDD9 DEC HL        ; Step back one byte.
 $BDDA RET Z         ; Return when this object-list pair is empty.
 $BDDB LD A,E        ; {Jump ahead to #R$BDE5 if the low byte differs from this
 $BDDC CP (HL)       ; object pair.
 $BDDD JR NZ,$BDE5   ; }
 $BDDF INC HL        ; {Jump ahead to #R$BDEA if the high byte matches this
 $BDE0 LD A,D        ; object pair.
 $BDE1 CP (HL)       ;
 $BDE2 DEC HL        ;
 $BDE3 JR Z,$BDEA    ; }
@label=PointObjectListRoom_Next
*$BDE5 INC HL        ; {Step to the next object pair and go back to #R$BDD6.
 $BDE6 INC HL        ;
 $BDE7 INC B         ;
 $BDE8 JR $BDD6      ; }
; Remember how many objects were listed and read the next one.
@label=PointObjectListRoom_CountRecordResult
*$BDEA LD A,B        ; {Record the display pointer.
 $BDEB LD ($BA1A),A  ;
 $BDEE LD A,$02      ; }
 $BDF0 LD ($A038),A  ; Store it in the object attribute flag.
 $BDF3 CALL $BE3C    ; {Call #R$BE3C to read the next display object and return
 $BDF6 CP $FF        ; when the list has ended.
 $BDF8 RET Z         ; }
 $BDF9 LD ($BA19),A  ; {Call #R$BE3C to read the character record from the
 $BDFC CALL $BE3C    ; display link.}
 $BDFF CP $FF        ; {Jump to #R$BE3A when another display object follows.
 $BE01 JR NZ,$BE3A   ; }
 $BE03 LD A,($BA19)  ; {Call #R$BE22 to copy the object's picture link.
 $BE06 CALL $BE22    ; }
 $BE09 CALL $BE4B    ; {Call #R$BE4B to read the next saved object and return
 $BE0C CP $FF        ; when that list has ended.
 $BE0E RET Z         ; }
 $BE0F LD ($BA1B),A  ; {Call #R$BE4B to read the character record from the
 $BE12 CALL $BE4B    ; saved value.}
 $BE15 CP $FF        ; {Jump to #R$BE3A when another saved object follows.
 $BE17 JR NZ,$BE3A   ; }
 $BE19 LD A,($BA1B)  ; {Call #R$BE22 to copy the object's picture link.
 $BE1C CALL $BE22    ; }
 $BE1F OR %00000001  ; Reset the zero flag.
 $BE21 RET           ; Return.

; Copy The Object Picture Link
;
; Used by the routine at #R$BDC2.
; .
; Looks the object up and copies either its picture link or the alternate link.
@label=UseObjectDisplayLink
c$BE22 CALL $D237     ; Call #R$D237 to look that object up.
 $BE25 PUSH IX        ; {See whether bit 6 of it is set.
 $BE27 POP HL         ;
 $BE28 BIT 6,(IX+$05) ; }
 $BE2C LD DE,$9FF6    ; Take the object display link.
 $BE2F JR NZ,$BE34    ; Jump ahead to #R$BE34 if the special-description flag
                      ; is present.
 $BE31 LD DE,$9FFC    ; Take the alternate display link.
@label=UseObjectDisplayLink_Length
*$BE34 LD BC,$0006    ; Take a length of #N$06.
 $BE37 LDIR           ; Copy the counted bytes.
 $BE39 RET            ; Return.
; This entry point is used by the routine at #R$BDC2.
; .
; The condition holds, so the caller continues.
@label=UseObjectDisplayLink_ConditionHoldsCaller
*$BE3A SCF            ; Mark the condition as met.
 $BE3B RET            ; Return.

; Read The Next Object On The Display List
;
; Used by the routine at #R$BDC2.
; .
; Reads the character remembered in the display pointer and stores the next one
; back.
@label=ReadCharacterRecordWord
c$BE3C LD IX,($BA13) ; {Read the display pointer and take the display data pointer, then call #R$D36A to run
 $BE40 LD HL,$B172   ; object entry.
 $BE43 CALL $D36A    ; }
 $BE46 LD ($BA13),IX ; Remember this character record in the display pointer.
 $BE4A RET           ; Return.

; Read The Next Object On The Saved List
;
; Used by the routine at #R$BDC2.
; .
; Reads the next object on the saved list through the display mode flag.
@label=ReadCharacterRecordValue
c$BE4B LD IX,($BA15) ; {Read the display pointer and take the display mode flag, then call #R$D36A to run
 $BE4F LD HL,$B178   ; object entry.
 $BE52 CALL $D36A    ; }
 $BE55 LD ($BA15),IX ; Store the record pointer at #R$BA13+#N$02.
 $BE59 RET           ; Return.

; Advance Pointer And Check Bit
;
; Used by the routines at #R$BB5C, #R$BC46, #R$BC74, #R$BD55, #R$BE72 and
; #R$BF08.
; .
; Steps to the next record and tests its flag bits.
@label=AdvancePointerAndCheckBit
c$BE5A PUSH AF        ; {Step to the next record
 $BE5B LD DE,$0002    ;
 $BE5E ADD IX,DE      ;
 $BE60 ADD IX,DE      ; }
 $BE62 BIT 5,(IX-$01) ; {Go to #R$BE6E if bit 5 of this byte is set.
 $BE66 JR NZ,$BE6E    ; }
 $BE68 BIT 4,(IX-$01) ; {Go to #R$BE70 if bit 4 of this byte is clear.
 $BE6C JR Z,$BE70     ; }
@label=AdvancePointerAndCheckBit_Next
*$BE6E ADD IX,DE      ; Step to the next record.
@label=AdvancePointerAndCheckBit_ReturnSaved
*$BE70 POP AF         ; Restore #REGaf from the stack.
 $BE71 RET            ; Return.

; Process Entry With Counter
;
; Used by the routines at #R$BB5C, #R$BC9C and #R$BE91.
; .
; Counts the entry down when its repeat mark is set, after measuring the field.
@label=ProcessEntryWithCounter
c$BE72 PUSH AF       ; {Save the flags and start the count at zero.
 $BE73 LD B,$00      ; }
@label=ProcessEntryWithCounter_Loop
*$BE75 LD C,(IX+$03) ; {Call #R$BE5A to advance pointer and check bit.
 $BE78 CALL $BE5A    ; }
 $BE7B BIT 3,C       ; {Jump ahead to #R$BE84 if bit 3 is clear.
 $BE7D JR Z,$BE84    ; }
 $BE7F LD A,B        ; {Jump ahead to #R$BE84 if the count is zero.
 $BE80 AND A         ;
 $BE81 JR Z,$BE84    ; }
 $BE83 DEC B         ; Count down one.
*$BE84 BIT 2,C       ; {Jump ahead to #R$BE8B if bit 2 of #REGc is clear.
 $BE86 JR Z,$BE8B    ; }
 $BE88 INC B         ; {Count one more and test the next bit from #R$BE75.
 $BE89 JR $BE75      ; }
; Read the count.
@label=ProcessEntryWithCounter_Next
*$BE8B LD A,B        ; {Go back to #R$BE75 if the count is not zero.
 $BE8C AND A         ;
 $BE8D JR NZ,$BE75   ; }
 $BE8F POP AF        ; Restore the saved flags from the stack.
 $BE90 RET           ; Return.

; Test The Action Taken Flag
;
; Used by the routine at #R$BF08.
; .
; Tests the action-taken flag and the top bits of the action flags before
; looking the object up.
@label=InspectActionTakenFlag
c$BE91 BIT 1,(IX+$03) ; {Jump to #R$BE72 if the action-taken flag is set.
 $BE95 JR NZ,$BE72    ; }
 $BE97 LD A,(IX+$03)  ; {Jump to #R$BECD if either bit 6 or bit 7 of the action
 $BE9A AND $C0        ; flags is set.
 $BE9C CP $00         ;
 $BE9E JR NZ,$BECD    ; }
 $BEA0 LD A,(IX+$00)  ; {Call #R$D237 to look up the current object.
 $BEA3 PUSH IX        ;
 $BEA5 CALL $D237     ; }
 $BEA8 BIT 7,(IX+$06) ; {Jump to #R$BE72 if bit 7 of the looked-up object's
 $BEAC POP IX         ; byte at offset #N$06 is clear.
 $BEAE JR Z,$BE72     ; }
 $BEB0 LD A,(IX+$02)  ; {Take the object id at offset #N$02 and call #R$D237 to
 $BEB3 PUSH IX        ; look it up.
 $BEB5 CALL $D237     ; }
 $BEB8 BIT 7,(IX+$06) ; {Jump to #R$BE72 if bit 7 of the looked-up object's
 $BEBC POP IX         ; byte at offset #N$06 is clear.
 $BEBE JR Z,$BE72     ; }
@label=InspectActionTakenFlag_SetTaken
*$BEC0 SET 1,(IX+$03) ; {Mark the action taken so the script will not repeat
 $BEC4 RES 0,(IX+$03) ; it.}
 $BEC8 OR $01         ; {Set #REGa non-zero and jump back to #R$BE72.
 $BECA JP $BE72       ; }
; The top bit counts the entry down. The bit under it reads the record itself.
@label=InspectActionTakenFlag_TestHighBit
*$BECD CP $80         ; {Jump back to #R$BE72 if it is #N$80.
 $BECF JR Z,$BE72     ; }
 $BED1 CP $40         ; {Jump ahead to #R$BEF6 if it is not #N$40.
 $BED3 JR NZ,$BEF6    ; }
 $BED5 LD A,(IX+$00)  ; {Call #R$D237 to look up the current object.
 $BED8 PUSH IX        ;
 $BEDA CALL $D237     ; }
 $BEDD BIT 6,(IX+$06) ; {Jump to #R$BE72 if bit 6 of the looked-up object's
 $BEE1 POP IX         ; byte at offset #N$06 is clear.
 $BEE3 JR Z,$BE72     ; }
 $BEE5 LD A,(IX+$02)  ; {Call #R$D237 to look up the current object.
 $BEE8 PUSH IX        ;
 $BEEA CALL $D237     ; }
 $BEED BIT 6,(IX+$06) ; {Jump to #R$BE72 if bit 6 of the looked-up object's
 $BEF1 POP IX         ; byte at offset #N$06 is clear.
 $BEF3 JP Z,$BE72     ; }
@label=InspectActionTakenFlag_TestMarker
*$BEF6 BIT 2,(IX+$03) ; {Jump to #R$BEC0 if a marker on the action flags is
 $BEFA JR Z,$BEC0     ; clear.}
 $BEFC PUSH IX        ; {Call #R$BF08 to test bit and process entry.
 $BEFE CALL $BF08     ;
 $BF01 POP IX         ; }
 $BF03 JR NZ,$BEC0    ; Jump back to #R$BEC0 when #R$BF08 returns non-zero.
 $BF05 JP $BE72       ; The check at #R$BF08 passed, so count the entry again
                      ; from #R$BE72.

; Check Bit And Process Entry
;
; Used by the routines at #R$BCC9 and #R$BE91.
; .
; Advances the entry with #R$BE5A and returns zero when #R$BE91 rejects it.
; Keeps going while bit 3 of the action flags is clear.
;
; .
;
; Advance pointer and check bit.
@label=CheckBitAndProcessEntry
c$BF08 CALL $BE5A     ; Call #R$BE5A to advance the pointer and test the bit.
@label=CheckBitAndProcessEntry_Loop
*$BF0B BIT 3,(IX+$03) ; {See whether bit 3 of it is set, then call #R$BE91 to
 $BF0F PUSH AF        ; run entry with counter.
 $BF10 CALL $BE91     ; }
 $BF13 JR NZ,$BF18    ; {Jump ahead to #R$BF18 when the entry counter is still
 $BF15 POP AF         ; running.}
 $BF16 XOR A          ; Clear #REGa.
 $BF17 RET            ; Return.
; Return.
@label=CheckBitAndProcessEntry_Next
*$BF18 POP AF         ; Restore the bit test from the stack.
 $BF19 JR Z,$BF0B     ; Go back to #R$BF0B if bit 3 is clear.
 $BF1B RET            ; Return.

; Process Text Token Entry
;
; Used by the routine at #R$A711.
; .
; Checks the object's flag byte, expands its text, and prints the dictionary word when the check
; passes.
@label=ProcessTextTokenEntry
c$BF1C LD A,(IX+$00) ; {Read the record flag, then call #R$A4BC to point to
 $BF1F CALL $A4BC    ; object attribute byte.}
 $BF22 PUSH HL       ; {Call #R$D3E8 to check object has special description.
 $BF23 POP IY        ;
 $BF25 CALL $D3E8    ; }
 $BF28 CALL $BF45    ; {Go to #R$BF3D if this token has no text.
 $BF2B JR Z,$BF3D    ; }
; Print text token.
 $BF2D CALL $A887    ; Call #R$A887 to print the dictionary word.
@label=ProcessTextTokenEntry_Loop
*$BF30 LD A,(IX+$02) ; {Read the character's room, then call #R$A4BC to point
 $BF33 CALL $A4BC    ; to object attribute byte.}
 $BF36 PUSH HL       ; {Call #R$D3E8 to check object has special description.
 $BF37 POP IY        ;
 $BF39 CALL $D3E8    ; }
 $BF3C RET           ; Return.
; Expand token #N($005D,$04,$04).
@label=ProcessTextTokenEntry_Next
*$BF3D LD DE,$005D   ; {Take token #N($005D,$04,$04) and call #R$A887 to expand
 $BF40 CALL $A887    ; it.}
 $BF43 JR $BF30      ; Jump back to #R$BF30 for the next character.

; Process Text Token Data
;
; Used by the routine at #R$BF1C.
; .
; Returns with the carry clear when this token has no more data.
@label=ProcessTextTokenData
c$BF45 LD A,(IX+$01) ; {Return if the moved marker is zero.
 $BF48 AND A         ;
 $BF49 RET Z         ; }
 $BF4A DEC A         ; {Use the character pairs (#R$994D).
 $BF4B LD E,A        ;
 $BF4C LD D,$00      ;
 $BF4E LD HL,$994D   ;
 $BF51 ADD HL,DE     ; }
 $BF52 ADD HL,DE     ; {Read the word at #REGhl into #REGde.
 $BF53 LD E,(HL)     ;
 $BF54 INC HL        ;
 $BF55 LD D,(HL)     ;
 $BF56 OR $01        ; }
 $BF58 RET           ; Return.

; Table: Days Of The Week Strings
;
; Days Of The Week Strings read by #R$BF79.
@label=Table_DaysOfWeekStrings
t$BF59 DEFM "Mon"
 $BF5C DEFM "Tue"
 $BF5F DEFM "Wed"
 $BF62 DEFM "Thu"
 $BF65 DEFM "Fri"
 $BF68 DEFM "Sat"
 $BF6B DEFM "Sun"

; Messaging: Current Date
;
; Messaging: Current Date read by #R$BF79.
@label=Messaging_CurrentDate
g$BF6E DEFM "MON 00:00am" ; "#STR$BF6E,$08,$0B".

; Handler: Date Bar
;
; Used by the routine at #R$A064.
; .
; Carries out this step while the game is running.
;
; .
;
; #PUSHS #SIM(start=$BF79,stop=$C1BF)
; #UDGTABLE
; { #SCR$02{$00,$0120,$0200,$10}(date-bar) }
; UDGTABLE# #POPS
@label=Handler_DateBar
c$BF79 LD IX,$BF6E   ; {Point #REGix at the current date at #R$BF6E and read
 $BF7D LD A,($9FE1)  ; the day of the week at #R$9FE1.}
 $BF80 LD HL,$BF59   ; Use the days of the week strings at #R$BF59.
; Populate day of the week.
 $BF83 CALL $BFC6    ; Call #R$BFC6 to write the day of the week.
 $BF86 INC IX        ; {Call #R$BFB0 to convert number to string.
 $BF88 LD A,($9FE0)  ;
 $BF8B CALL $BFB0    ; }
 $BF8E INC IX        ; {Call #R$BFB0 to convert number to string.
 $BF90 LD A,($9FDF)  ;
 $BF93 CALL $BFB0    ; }
 $BF96 LD A,($9FE2)  ; {Write *#R$9FE2 to *#REGix+#N$00.
 $BF99 LD (IX+$00),A ; }
; Now the date bar has been updated, set up printing it to the screen.
 $BF9C LD HL,$BF6E   ; Load #REGhl with a pointer to #R$BF6E.
 $BF9F LD B,$0B      ; Set the length of the date bar in #REGb (#N$0B bytes).
 $BFA1 JP $C1A8      ; Jump ahead to #R$C1A8 to print date bar.

; Convert Number To ASCII
;
; Used by the routine at #R$BFB0.
; .
; Turns the number into digits the print routine can use.
@label=ConvertNumberToASCII
c$BFA4 CALL $BFAA    ; Call #R$BFAA to store the record flag.
 $BFA7 LD A,L        ; {Turn the number into a character.
 $BFA8 ADD A,$30     ; }

; Store It In The Record Flag
;
; Used by the routine at #R$BFA4.
; .
; Store it in the record flag, then step to the next field of the character
; record.
@label=StoreRecordFlag
c$BFAA LD (IX+$00),A ; {Store the record's flag byte.
 $BFAD INC IX        ; }
 $BFAF RET           ; Return.

; Convert Number To String
;
; Used by the routine at #R$BF79.
; .
; Turns the number into a string of digits.
;
; A Number to convert (0-99)
; IX Pointer to output buffer
@label=ConvertNumberToString
c$BFB0 LD L,A        ; {Call #R$BFBB to start the count.
 $BFB1 LD H,$00      ;
 $BFB3 LD DE,$000A   ;
 $BFB6 CALL $BFBB    ; }
 $BFB9 JR $BFA4      ; Jump back to #R$BFA4 to convert number to ascii.

; Make One Decimal Digit
;
; Used by the routine at #R$BFB0.
; .
; Subtracts one power of ten until the number goes below zero, then adds
; that power back and returns the ASCII digit.
@label=MakeOneDecimalDigit
c$BFBB LD C,$2F      ; Start at one below the ASCII code for 0.
@label=MakeOneDecimalDigit_Loop
*$BFBD INC C         ; {Keep subtracting this power of ten, counting the digit up in #REGc, until #REGhl
 $BFBE AND A         ; goes below zero.
 $BFBF SBC HL,DE     ;
 $BFC1 JR NC,$BFBD   ; }
 $BFC3 ADD HL,DE     ; Add back the last power of ten to leave the remainder.
 $BFC4 LD A,C        ; Put the digit in #REGa.
 $BFC5 RET           ; Return.

; Populate Day Of The Week
;
; Used by the routine at #R$BF79.
; .
; Writes the three-letter day name for the day number in hand into the date
; line.
;
; A Number representing the current day of the week
; HL Pointer to the table containing the days of the week strings
; IX Pointer to the current date messaging
@label=PopulateDayOfWeek
c$BFC6 LD C,A        ; {Multiply the day of the week by #N$03 and store the result in
 $BFC7 ADD A,A       ; #REGbc.
 $BFC8 ADD A,C       ;
 $BFC9 LD C,A        ;
 $BFCA LD B,$00      ; }
 $BFCC ADD HL,BC     ; Add this to the base address of the table containing the days of
                     ; the week strings.
; Each day string is three characters long (e.g. "Mon" for Monday).
 $BFCD LD B,$03      ; Set a counter in #REGb for three characters.
@label=PopulateDayOfWeek_Loop
*$BFCF LD A,(HL)     ; Fetch a character from the table containing the days of the week
                     ; strings.
 $BFD0 LD (IX+$00),A ; Write the character to the current date messaging.
 $BFD3 INC IX        ; Move to the next character in the current date
                     ; messaging.
 $BFD5 INC HL        ; Move to the next character in the days of the week
                     ; string table.
 $BFD6 DJNZ $BFCF    ; Count the next entry and repeat from #R$BFCF.
 $BFD8 RET           ; Return.

; Handler: Game Clock
;
; Used by the routine at #R$A064.
; .
; Carries out this step while the game is running.
;
; .
;
; Handle the game ticker.
@label=Handler_GameClock
c$BFD9 LD HL,($9FDD) ; {Increment *#R$9FDD by one.
 $BFDC INC HL        ;
 $BFDD LD ($9FDD),HL ; }
; Handle the clock minutes.
 $BFE0 LD HL,$9FDF   ; {Increment *#R$9FDF by one.
 $BFE3 INC (HL)      ; }
 $BFE4 LD A,(HL)     ; {Return unless the minute count has reached #N$3C.
 $BFE5 CP $3C        ;
 $BFE7 RET NZ        ; }
; The minutes is at 60, which is invalid - so handle rolling the clock
; hour digits.
 $BFE8 LD (HL),$00   ; Reset the minutes back to #N$00 at *#REGhl.
; Handle the clock hours.
 $BFEA LD HL,$9FE0   ; {Increment *#R$9FE0 by one.
 $BFED INC (HL)      ; }
 $BFEE LD A,(HL)     ; {Jump to #R$BFF6 unless the hour has reached #N$0D.
 $BFEF CP $0D        ;
 $BFF1 JR NZ,$BFF6   ; }
; The hours is at 13. which is invalid - so handle rolling the clock.
 $BFF3 LD (HL),$01   ; Reset the hours back to #N$01 at *#REGhl.
 $BFF5 RET           ; Return.
; Noon or midnight flips the AM/PM marker.
@label=Handler_GameClock_AM_PM
*$BFF6 CP $0C        ; {Return unless the hour is #N$0C.
 $BFF8 RET NZ        ; }
; It's either midday or midnight, so flip between AM and PM.
 $BFF9 LD A,($9FE2)  ; Read the AM/PM marker.
; Smart way of altering the letter from "a" to "p" and back again.
; #TABLE(default,centre,centre)
; { =h Letter | =h Bits }
; { "a" | #EVAL($61,$02,$08) }
; { "p" | #EVAL($70,$02,$08) }
; TABLE#
 $BFFC XOR %00010001 ; Flip bits 0, 4.
 $BFFE LD ($9FE2),A  ; Write this back to *#R$9FE2.
; If the clock went from PM to AM, handle rolling the day of the week.
 $C001 CP $61        ; {Return unless the AM/PM marker is the letter a.
 $C003 RET NZ        ; }
 $C004 LD A,($9FE1)  ; {Increment *#R$9FE1 by one.
 $C007 INC A         ;
 $C008 LD ($9FE1),A  ; }
 $C00B RET           ; Return.

; Get Time Period
;
; Used by the routines at #R$A684 and #R$D078.
; .
; Handles calculating a time-period code for scheduling events.
; #TABLE(default,centre)
; { =h Time Period Code | =h Meaning }
; { #N$01 | Late night/ evening (8 PM - 5 AM) }
; { #N$02 | 7 PM }
; { #N$03 | Afternoon (1 PM - 6 PM) }
; { #N$04 | Morning/ Midday (7 AM - 12 PM) }
; { #N$05 | 6 AM }
; TABLE#
;
; O:A Time period code
@label=GetTimePeriod
c$C00C LD A,($9FE2)  ; Fetch *#R$9FE2.
 $C00F CP $61        ; Check if its "A" for AM.
 $C011 LD A,($9FE0)  ; Read the hour.
 $C014 JR Z,$C02B    ; Go to #R$C02B if the period letter is #N$61 (morning).
; It's the afternoon (as in, "PM").
 $C016 CP $0C        ; {Go to #R$C035 if the hour is twelve (noon).
 $C018 JR Z,$C035    ; }
 $C01A CP $08        ; {Go to #R$C021 if the hour is before eight.
 $C01C JR C,$C021    ; }
; It's late PM/ evening; 8 PM - 11 PM.
@label=TimePeriod_LateEvening
*$C01E LD A,$01      ; Leave #N$01 as the result.
 $C020 RET           ; Return.
; Seven in the evening leaves time-of-day code 2.
; .
; It's before 8 PM, but break this down further.
@label=TimePeriod_BeforeEightPM
*$C021 CP $07        ; {Go to #R$C028 unless the hour is seven.
 $C023 JR NZ,$C028   ; }
; It's 7 PM.
 $C025 LD A,$02      ; Leave #N$02 as the result.
 $C027 RET           ; Return.
; The afternoon, from one until six, leaves time-of-day code 3.
; .
; It's afternoon/ early PM; 1 PM - 6 PM.
@label=TimePeriod_Afternoon
*$C028 LD A,$03      ; Leave #N$03 as the result.
 $C02A RET           ; Return.
; The morning checks leave time-of-day code 4, or continue into early morning.
; .
; It's morning, but break this down further.
@label=TimePeriod_AM
*$C02B CP $0C        ; {Go to #R$C01E if the hour is twelve.
 $C02D JR Z,$C01E    ; }
 $C02F CP $06        ; {Go to #R$C01E if the hour is before six.
 $C031 JR C,$C01E    ; }
 $C033 JR Z,$C038    ; Go to #R$C038 if the hour is six.
; It's morning; 7 AM - noon (12 PM).
@label=TimePeriod_Morning
*$C035 LD A,$04      ; Leave #N$04 as the result.
 $C037 RET           ; Return.
; Six in the morning leaves time-of-day code 5.
; .
; It's early morning; 6 AM.
@label=TimePeriod_EarlyMorning
*$C038 LD A,$05      ; Leave #N$05 as the result.
 $C03A RET           ; Return.

; Check Input Port
;
; Used by the routine at #R$AFFF.
; .
; Reads port #N$FB, keeps bit 6 and returns.
@label=CheckInputPort
c$C03B DEFB $DB,$FB,$E6,$40 ; Read port #N$FB, keep bit 6.
 $C03F DEFB $C9             ; Return.

; Save Game
;
; Used by the routine at #R$B0E4.
; .
; Stores the current game so it can be restored later.
@label=SaveGame
c$C040 LD HL,$09A2   ; {Print the message at #N$09A2 and wait for a key.
 $C043 CALL $C1C0    ; }
 $C046 LD ($C109),DE ; {Record the tape header: saved game.
 $C04A LD ($C10B),IX ; }
 $C04E LD IX,$C0FE   ; {Use the tape header: saved game (#R$C0FE).
 $C052 LD DE,$0011   ; }
 $C055 XOR A         ; Set #REGa to #N$00 to indicate this is a header block.
 $C056 CALL $04C2    ; Call #SKOOLKID$04C2(SA_BYTES).
 $C059 LD B,$32      ; Count #N$32.
@label=SaveGame_PauseLoop
*$C05B HALT          ; {Wait for #N$32 frames (one second) between the header
 $C05C DJNZ $C05B    ; and the data block.}
 $C05E DI            ; {Read the tape header: saved game.
 $C05F LD DE,($C109) ; }
 $C063 LD IX,($C10B) ; Read the tape header: saved game.
 $C067 LD A,$FF      ; Set #REGa to #N$FF to indicate this is a data block.
 $C069 CALL $04C2    ; Call #SKOOLKID$04C2(SA_BYTES).
 $C06C DI            ; Turn interrupts off again, as #SKOOLKID$04C2(SA_BYTES)
                     ; leaves them on.
 $C06D LD HL,$C0A5   ; {Take the messaging: rewind tape, then call #R$C1CB to
 $C070 CALL $C1CB    ; print string.}
 $C073 LD HL,$09AC   ; {Print the message at #N$09AC and wait for a key.
 $C076 CALL $C1C0    ; }
 $C079 LD IX,$C0FE   ; {Use the tape header: saved game (#R$C0FE).
 $C07D LD DE,$0011   ; }
 $C080 LD A,$00      ; Set #REGa to #N$00 to indicate this is a header block.
 $C082 AND A         ; Clear the carry so the ROM verifies this block.
 $C083 CALL $0556    ; Call #SKOOLKID$0556(LD_BYTES).
 $C086 JR NC,$C098   ; Jump to #R$C098 if the header did not load.
 $C088 AND A         ; Clear the carry before the next tape block.

; Load The Saved Game Block
;
; Used by the routine at #R$C0DF.
; .
; Loads the saved game from the tape header and returns when the load fails.
@label=LoadGameData
c$C089 LD DE,($C109) ; {Read the tape header: saved game.
 $C08D LD IX,($C10B) ; }
 $C091 LD A,$FF      ; Set #REGa to #N$FF to indicate this is a data block.
 $C093 CALL $0556    ; Call #SKOOLKID$0556(LD_BYTES).
 $C096 DI            ; Turn interrupts off again, as #SKOOLKID$0556(LD_BYTES)
                     ; leaves them on.
 $C097 RET C         ; Return when the saved game loaded.
; This entry point is used by the routine at #R$C040.
; .
; There were errors ... so alert the player.
@label=LoadGameData_Error
*$C098 DI            ; Make sure interrupts are off before reporting the tape
                     ; error.
 $C099 LD HL,$C0B1   ; {Take the messaging: tape error, then call #R$C1CB to
 $C09C CALL $C1CB    ; print string.}
 $C09F LD HL,$09B2   ; {Jump ahead to #R$C1C0 to print string and wait for
 $C0A2 JP $C1C0      ; keypress.}

; Messaging: Rewind Tape
;
; Messaging: Rewind Tape read by #R$C040.
@label=Messaging_RewindTape
t$C0A5 DEFM "REWIND TAPE",$AE ; "#STR$C0A5".

; Messaging: Tape Error
;
; Messaging: Tape Error read by #R$C089.
@label=Messaging_TapeError
t$C0B1 DEFM "TAPE ERROR",$AE ; "#STR$C0B1".

; Messaging: Play Saved Game Tape
;
; Messaging: Play Saved Game Tape read by #R$C0DF.
@label=Messaging_PlaySavedGameTape
t$C0BC DEFM "PLAY SAVED GAME TAPE TO BE LOADED",$0D,$AE ; "#STR$C0BC".

; Load Game
;
; Used by the routine at #R$B0D7.
; .
; Reads a stored game back into play.
@label=LoadGame
c$C0DF LD ($C109),DE ; {Record the tape header: saved game.
 $C0E3 LD ($C10B),IX ; }
; "#STR$C0BC".
 $C0E7 LD HL,$C0BC   ; {Take the messaging: play saved game tape, then call
 $C0EA CALL $C1CB    ; #R$C1CB to print string.}
@label=LoadGame_TryTape
*$C0ED LD IX,$C0FE   ; {Use the tape header: saved game (#R$C0FE).
 $C0F1 LD DE,$0011   ; }
 $C0F4 LD A,$00      ; Set #REGa to #N$00 to indicate this is a header block.
 $C0F6 AND A         ; Clear the carry flag so #SKOOLKID$0556(LD_BYTES)
                     ; verifies the header against #R$C0FE instead of loading
                     ; it.
 $C0F7 CALL $0556    ; Call #SKOOLKID$0556(LD_BYTES).
 $C0FA JR NC,$C0ED   ; Jump back to #R$C0ED if there was a tape loading error
                     ; to try again.
 $C0FC JR $C089      ; Jump back to #R$C089 once the game block has loaded.

; Tape Header: Saved Game
;
; Header for the save and load blocks. The name begins SHD V2.
; Read by #R$C040 and #R$C0DF.
b$C0FE DEFB $03          ; Type.
 $C0FF DEFM "SHD V2.0  " ; Name.
 $C109 DEFW $0000        ; Saved-game length, read by #R$C040, #R$C089 and
                         ; #R$C0DF.
 $C10B DEFW $0000        ; Address the saved game loads to, read by #R$C040,
                         ; #R$C089 and #R$C0DF.
 $C10D DEFW $8000        ; Parameter.

; Clear Screen
;
; Used by the routine at #R$C14A.
; .
; Blanks the screen before a new picture is drawn.
@label=ClearScreen
c$C10F LD A,$07      ; {Set border colour to #INK$07.
 $C111 OUT ($FE),A   ; }
 $C113 LD HL,$4000   ; {Point at the start of the screen and the byte after it,
 $C116 LD DE,$4001   ; ready to fill the pixels with zero.}
 $C119 LD BC,$1800   ; Take the length of the screen bitmap.
 $C11C LD (HL),$00   ; Plant a zero at the start of the screen, ready for the
                     ; fill.
 $C11E LDIR          ; Copy the #N$00 across the rest of the screen buffer
                     ; bytes.
 $C120 LD BC,$02FF   ; Take the length of the attributes still to paint.
 $C123 LD (HL),$38   ; Paint this square black ink on white paper, ready to
                     ; fill the rest of the screen.
 $C125 LDIR          ; Copy these bytes across.
 $C127 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$6FD3 }
; LIST#

; Flags: Screen
;
; Screen mode. #R$C142 clears it and the surrounding code stores #N$01 or #N$02.
; Read by #R$C129, #R$C142, #R$C2BA and #R$C316.
g$C128 DEFB $00

; Initialise Screen Display
;
; Used by the routine at #R$A277.
; .
; Clears the parser flag, marks the screen in use, and sets the width and the
; print position.
@label=InitialiseScreenDisplay
c$C129 XOR A         ; {Clear the parser flag (#R$A019) and set the screen flag
 $C12A LD ($A019),A  ; (#R$C128) to #N$01.
 $C12D INC A         ;
 $C12E LD ($C128),A  ; }
 $C131 LD A,$12      ; Use #N$12 for the display.
; This entry point is used by the routine at #R$C142.
; .
; Record the result in the screen width at #R$C1F5, then use the screen as the
; pointer, then record the pointer in the storage Decorative Line Screen Position.
*$C133 LD ($C1F5),A  ; Store it in the screen width.
 $C136 LD HL,$5020   ; {Write #N$5020 (screen buffer location) to *#R$C1F8.
 $C139 LD ($C1F8),HL ; }
 $C13C LD A,$02      ; {Write #N$02 to the decorative line.
 $C13E LD ($C1FA),A  ; }
 $C141 RET           ; Return.

; Reset Screen Display
;
; Used by the routines at #R$C14A, #R$C306 and #R$D6C1.
; .
; Clears the screen flags and redraws the picture frame.
@label=ResetScreenDisplay
c$C142 XOR A         ; {Clear the screen flags.
 $C143 LD ($C128),A  ; }
 $C146 LD A,$24      ; {Take a width of #N$24 and continue at #R$C133.
 $C148 JR $C133      ; }

; Draw Decorative Line
;
; Used by the routine at #R$A040.
; .
; Draws a decorative horizontal pattern on screen as a separator.
; .
; #PUSHS #SIM(start=$C14A,stop=$C18F)
; #UDGTABLE
; { #SCR$02{$00,$0120,$0200,$10}(decorative-line) }
; UDGTABLE# #POPS
;
; .
;
; Clear screen.
@label=DrawDecorativeLine
c$C14A CALL $C10F    ; Call #R$C10F to clear the screen.
 $C14D LD A,$24      ; {Store the width value (#N$24) at *#R$C1F4.
 $C14F LD ($C1F4),A  ; }
 $C152 LD HL,$50E0   ; {Initialise the screen buffer starting point (#N$50E0)
 $C155 LD ($C1F6),HL ; at *#R$C1F6.}
 $C158 LD A,$02      ; Use #N$02 for the picture.
@label=DrawDecorativeLine_Custom
 $C15A LD ($C1FB),A  ; Store the height value in *#R$C1FB.
; Reset screen display.
 $C15D CALL $C142    ; Call #R$C142 to reset the screen.
 $C160 LD HL,$5140   ; {Point #REGhl at the screen address #N$5140 and #REGde
 $C163 LD DE,$C190   ; at the decorative line data at #R$C190.}
 $C166 LD B,$06      ; Set a counter in #REGb for #N$06 rows.
@label=DrawDecorativeLine_RowLoop
*$C168 LD C,$08      ; Set a counter in #REGc for #N$08 repetitions.
 $C16A PUSH BC       ; {Count #N$04, saving count and the pointer.
 $C16B PUSH HL       ;
@label=DrawDecorativeLine_SegmentLoop
*$C16C LD B,$04      ;
 $C16E PUSH DE       ; }
@label=DrawDecorativeLine_CopyPatternLoop
*$C16F LD A,(DE)     ; {Copy the pattern byte to the current screen position.
 $C170 LD (HL),A     ; }
 $C171 INC DE        ; Increment the pattern pointer by one.
 $C172 INC L         ; Increment the screen position column by one.
 $C173 DJNZ $C16F    ; Count the next attribute and repeat from #R$C16F.
 $C175 POP DE        ; Restore the caller's registers from the stack.
 $C176 DEC C         ; Decrease the segment counter by one.
 $C177 JR NZ,$C16C   ; Jump back to #R$C16C until all segments have been drawn.
; Skip to the next pattern.
 $C179 INC DE        ; {Increment the pattern pointer by four.
 $C17A INC DE        ;
 $C17B INC DE        ;
 $C17C INC DE        ; }
 $C17D POP HL        ; {Restore the screen address from the stack.
 $C17E POP BC        ; }
 $C17F INC H         ; The count, and step to the next row.
 $C180 DJNZ $C168    ; Count the next attribute and repeat from #R$C168.
; Now colour the line BRIGHT WHITE.
 $C182 LD HL,$5A40   ; {Take the attributes, take a length of #N$1F attributes and copy these bytes
 $C185 LD DE,$5A41   ; across.
 $C188 LD BC,$001F   ;
 $C18B LD (HL),$78   ;
 $C18D LDIR          ; }
 $C18F RET           ; Return.

; Data: Decorative Line
;
; Data: Decorative Line read by #R$C14A.
@label=Data_DecorativeLine
b$C190 DEFB $00,$3F,$C1,$C0,$20,$FE,$01,$C4
 $C198 DEFB $81,$E8,$0D,$81,$41,$B0,$17,$82
 $C1A0 DEFB $83,$80,$7F,$01,$23,$83,$FC,$04

; Print Date Bar
;
; Used by the routine at #R$BF79.
; .
; Prints the date string at screen position #N$5041, with a space in front of
; it.
;
; HL Date messaging string
; B Length of messaging string
@label=PrintDateBar
c$C1A8 LD DE,$5041   ; Start the date text at screen position #N$5041.
 $C1AB EX DE,HL      ; {Swap the two pointers and count #N$00.
 $C1AC LD C,$00      ; }
; Print a "SPACE" before the date string.
 $C1AE LD A,$20      ; {Take a space and print it through #R$C388.
 $C1B0 CALL $C388    ; }
; Loop through the date messaging string and output it to the screen.
@label=PrintDateBar_Loop
*$C1B3 LD A,(DE)     ; Fetch a character from *#REGde and store it in #REGa.
; Print character.
 $C1B4 CALL $C388    ; Call #R$C388 to print this character.
 $C1B7 INC DE        ; Move to the next character of the message.
 $C1B8 DJNZ $C1B3    ; Count the next character of the message and repeat from
                     ; #R$C1B3.
; Print a "SPACE" after the date string.
 $C1BA LD A,$20      ; Leave #N$20 as the result.
 $C1BC CALL $C388    ; Call #R$C388 to print this character.
 $C1BF RET           ; Return.

; Print String And Wait For Keypress
;
; Used by the routines at #R$C040, #R$C089 and #R$C1D8.
; .
; Prints a string and waits for a key.
@label=PrintStringAndWaitForKeypress
c$C1C0 CALL $C1CB    ; {Print the string at #REGhl and wait for a key at
 $C1C3 CALL $C415    ; #R$C415.}
 $C1C6 LD A,$0D      ; {Feed a carriage return into the character input at
 $C1C8 JP $C1FD      ; #R$C1FD.}

; Print String
;
; Used by the routines at #R$C040, #R$C089, #R$C0DF and #R$C1C0.
; .
; Prints each character of a bit-7 terminated string.
;
; HL Pointer to the string data
@label=PrintString
c$C1CB LD A,(HL)     ; Read the next character of the string.
; Strip off the termination bit to leave only the ASCII value.
 $C1CC AND %01111111 ; Strip the end-of-string marker (bit 7).
 $C1CE CALL $C1FD    ; Call #R$C1FD to print this character.
; The string is terminated by bit 7 being set, so check if this is the
; final character or not.
 $C1D1 BIT 7,(HL)    ; See whether this character ends the string.
 $C1D3 RET NZ        ; Return if that marker is set.
 $C1D4 INC HL        ; Move to the next byte in the string.
 $C1D5 JR $C1CB      ; Jump back to #R$C1CB to print the next character of the
                     ; string.

; Unused
;
; Single #N$C9 byte between the string printer and the out-of-memory handler.
u$C1D7 DEFB $C9      ; Byte #N$C9.

; Error: Out Of Memory
;
; Used by the routine at #R$A18A.
; .
; Out of memory.
@label=Error_OutOfMemory
c$C1D8 LD HL,$13C5   ; {Print the out-of-memory message at #N$13C5 and wait for
 $C1DB CALL $C1C0    ; a key.}
 $C1DE JP $A0EB      ; Jump back to #R$A0EB to handle game state based on
                     ; parameter.

; Check TV Flag And Process
;
; Used by the routines at #R$A9B7 and #R$AA14.
; .
; Checks the television flag and prints the character when the print mode is
; on.
@label=CheckTVFlagAndProcess
c$C1E1 PUSH AF       ; Keep it.
 $C1E2 LD A,($5C3C)  ; {Jump to #R$C1EA if *#SKOOLKID$5C3C(TV_FLAG) is not
 $C1E5 AND A         ; zero.
 $C1E6 JR NZ,$C1EA   ; }
 $C1E8 POP AF        ; Restore #REGaf from the stack.
 $C1E9 RET           ; Return.
; Read the print mode.
*$C1EA LD A,($A027)  ; {Go to #R$C1FC if print mode is on.
 $C1ED AND A         ;
 $C1EE JR NZ,$C1FC   ; }
 $C1F0 POP AF        ; Restore the saved result from the stack.
 $C1F1 JP $C2BA      ; Jump ahead to #R$C2BA to run screen character.

; Storage Decorative Line Width
;
; Storage Decorative Line Width read by #R$C14A, #R$C1FD, #R$C22D and #R$C249.
@label=DecorativeLine_Width
g$C1F4 DEFB $00

; Screen Width
;
; Screen Width read by #R$A9B7, #R$C129 and #R$C2BA.
@label=ScreenWidth
g$C1F5 DEFB $00

; Storage Decorative Line Screen Position
;
; Storage Decorative Line Screen Position read by #R$C14A, #R$C1FD and #R$C22D.
@label=DecorativeLine_ScreenPosition
g$C1F6 DEFW $0000
 $C1F8 DEFB $00,$00

; Flags: Decorative Line
;
; Initialised with the decorative-line position.
; Read by #R$C129 and #R$C2BA.
g$C1FA DEFB $00

; Print Column
;
; Column read by #R$C200 while printing.
; Read by #R$C14A, #R$C1FD and #R$C22D.
g$C1FB DEFB $00

; Process Character Input
;
; Used by the routine at #R$C1E1.
; .
; Restores the character code the caller had saved.
;
; A Character code
@label=ProcessCharacterInput
c$C1FC POP AF        ; Restore saved character id for the caller.

; Read The Pointer At The Storage Decorative
;
; Used by the routines at #R$C1C0 and #R$C1CB.
; .
; Prints one character at the current column, and starts a new line on ENTER.
@label=PrintScreenCharacter
c$C1FD PUSH HL       ; {Keep the character.
 $C1FE PUSH BC       ;
 $C1FF PUSH AF       ; }
 $C200 LD A,($C1FB)  ; {Read the print column.
 $C203 LD C,A        ; }
 $C204 POP AF        ; {Read the screen position at #R$C1F6 and jump to #R$C214
 $C205 PUSH AF       ; if the character is not a new line.
 $C206 LD HL,($C1F6) ;
 $C209 CP $0D        ;
 $C20B JR NZ,$C214   ; }
 $C20D LD A,$20      ; {Print a space and carry on from #R$C224.
 $C20F CALL $C388    ;
 $C212 JR $C224      ; }
; A code of 8 starts the decorative line. Any other code counts the width down.
@label=PrintScreenCharacter_Next
*$C214 CP $08        ; {Jump ahead to #R$C249 if it is #N$08.
 $C216 JR Z,$C249    ; }
 $C218 CALL $C240    ; {Call #R$C240 to check the key, then print the character
 $C21B CALL $C388    ; through #R$C388.}
 $C21E LD A,($C1F4)  ; {Jump ahead to #R$C22D if the count is not finished.
 $C221 DEC A         ;
 $C222 JR NZ,$C22D   ; }
@label=PrintScreenCharacter_SetDecorative
*$C224 LD L,$E0      ; {Call #R$C271 to scroll screen up.
 $C226 LD C,$02      ;
 $C228 CALL $C271    ; }
 $C22B LD A,$24      ; Take a width of #N$24 for the decorative line.

; Record The Result In The Storage Decorative
;
; Used by the routines at #R$C1FD and #R$C249.
; .
; Stores the decorative-line width and updates the print column.
@label=RecordResultStorageDecorative
c$C22D LD ($C1F4),A  ; {Store it in the storage decorative line width, take the count and store it in the
 $C230 LD A,C        ; print column.
 $C231 LD ($C1FB),A  ; }
 $C234 LD ($C1F6),HL ; Record the storage decorative line screen position.
 $C237 LD A,$2B      ; Load #REGa with ASCII code #N$2B ("#CHR$2B").
 $C239 CALL $C388    ; Print the character through #R$C388.
 $C23C POP AF        ; {Restore the saved character, the saved count and the
 $C23D POP BC        ; saved pointer from the stack.
 $C23E POP HL        ; }
 $C23F RET           ; Return.

; Validate Keypress
;
; Used by the routines at #R$C1FD and #R$C41F.
; .
; Checks the keypress and rejects a key the game does not use.
@label=ValidateKeypress
c$C240 CP $61        ; {Return if it is below #N$61.
 $C242 RET C         ; }
 $C243 CP $7B        ; {Return if it is at least #N$7B.
 $C245 RET NC        ; }
 $C246 AND %01011111 ; Convert the lower-case letter to upper case.
 $C248 RET           ; Return.

; Handle Backspace Key
;
; Used by the routine at #R$C1FD.
; .
; Deletes the character before the cursor, and scrolls the line when the width
; is #N$24.
@label=HandleBackspaceKey
c$C249 LD A,$20      ; {Print a space at #R$C388, then call #R$C267.
 $C24B CALL $C388    ;
 $C24E CALL $C267    ; }
 $C251 CALL $C267    ; Call #R$C267 to subtract seven.
 $C254 LD A,($C1F4)  ; {Go to #R$C22D unless the line width is #N$24.
 $C257 INC A         ;
 $C258 CP $25        ;
 $C25A JR NZ,$C22D   ; }
 $C25C LD L,$FE      ; {Call #R$C29C to scroll screen down.
 $C25E LD C,$07      ;
 $C260 CALL $C29C    ; }
 $C263 LD A,$01      ; {Jump back to #R$C22D to run character input.
 $C265 JR $C22D      ; }

; Subtract Seven
;
; Used by the routine at #R$C249.
; .
; Steps the print column back by one cell and wraps when the column underflows.
@label=SubtractSeven
c$C267 LD A,C        ; Read the low byte of the count.
 $C268 SUB $07       ; Step back one character cell, wrapping to the previous
                     ; row when the column underflows.
 $C26A LD C,A        ; Store the result in the low byte of the count.
 $C26B RET NC        ; Return when the column still fits on this row.
 $C26C DEC L         ; Count down the low byte of the pointer.
 $C26D ADD A,$08     ; Advance the result by #N$08.
 $C26F LD C,A        ; Store the column.
 $C270 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$8761 }
; LIST#

; Scroll Screen Up
;
; Used by the routine at #R$C1FD.
; .
; Scrolls the screen up one character row.
@label=ScrollScreenUp
c$C271 PUSH HL       ; {Keep the caller's registers and point #REGhl at the
 $C272 PUSH DE       ; screen address #N$5080.
 $C273 PUSH BC       ;
 $C274 LD HL,$5080   ; }
 $C277 LD DE,$5060   ; Take the screen.
 $C27A LD A,$08      ; Use #N$08.
@label=ScrollScreenUp_Loop
*$C27C PUSH HL       ; {Take a length of #N$80 entries.
 $C27D PUSH DE       ;
 $C27E LD BC,$0080   ; }
 $C281 LDIR          ; Scroll #N$80 bytes of this screen third down one
                     ; character row.
 $C283 POP DE        ; {Jump back to #R$C27C while the count is not finished.
 $C284 POP HL        ;
 $C285 INC H         ;
 $C286 INC D         ;
 $C287 DEC A         ;
 $C288 JR NZ,$C27C   ; }
 $C28A LD HL,$50E0   ; Point #REGhl at the screen address #N$50E0.

; Print A Row Of Spaces
;
; Used by the routine at #R$C29C.
; .
; Fills the scrolled line with #N$24 spaces.
@label=PrintARowOfSpaces
c$C28D LD B,$24      ; {Count #N$24 and count #N$01 for scroll screen up.
 $C28F LD C,$01      ; }
 $C291 LD A,$20      ; Take a space.
*$C293 CALL $C388    ; Call #R$C388 to print a space.
 $C296 DJNZ $C293    ; Count the next entry and repeat from #R$C293.
 $C298 POP BC        ; {Restore the saved count, the saved source and the saved
 $C299 POP DE        ; pointer from the stack.
 $C29A POP HL        ; }
 $C29B RET           ; Return.

; Scroll Screen Down
;
; Used by the routine at #R$C249.
; .
; Scrolls the screen down one character row.
@label=ScrollScreenDown
c$C29C PUSH HL       ; {Keep the caller's registers and point #REGhl at the
 $C29D PUSH DE       ; screen address #N$50DF.
 $C29E PUSH BC       ;
 $C29F LD HL,$50DF   ; }
 $C2A2 LD DE,$50FF   ; Take the screen.
 $C2A5 LD A,$08      ; Use #N$08.
@label=ScrollScreenDown_Loop
*$C2A7 PUSH HL       ; {Take a length of #N$80 entries.
 $C2A8 PUSH DE       ;
 $C2A9 LD BC,$0080   ; }
 $C2AC LDDR          ; Scroll #N$80 bytes of this screen third up one character
                     ; row.
 $C2AE POP DE        ; {Jump back to #R$C2A7 while the count is not finished.
 $C2AF POP HL        ;
 $C2B0 INC H         ;
 $C2B1 INC D         ;
 $C2B2 DEC A         ;
 $C2B3 JR NZ,$C2A7   ; }
 $C2B5 LD HL,$5060   ; {Jump back to #R$C28D to scroll screen up.
 $C2B8 JR $C28D      ; }

; Process Screen Character
;
; Used by the routine at #R$C1E1.
; .
; On a new line, resets the parser row. Any other character is printed.
;
; A Character code
@label=ProcessScreenCharacter
c$C2BA PUSH HL       ; {Read the storage decorative line screen position.
 $C2BB PUSH BC       ;
 $C2BC PUSH AF       ;
 $C2BD LD HL,($C1F8) ; }
 $C2C0 LD A,($C1FA)  ; {Read the decorative line into #REGc.
 $C2C3 LD C,A        ; }
 $C2C4 POP AF        ; Restore the character from the stack.
 $C2C5 PUSH AF       ; Keep a copy of the character on the stack.
 $C2C6 CP $0D        ; {Jump ahead to #R$C2EE if this character is not a new
 $C2C8 JR NZ,$C2EE   ; line (#N$0D).}
@label=ProcessScreenCharacter_Loop
*$C2CA LD A,($A019)  ; {Jump to #R$C2D6 if the parser is not #N$0F.
 $C2CD CP $0F        ;
 $C2CF JR NZ,$C2D6   ; }
; Scroll screen and reset display.
 $C2D1 CALL $C306    ; Call #R$C306 to scroll the screen and reset the display.
 $C2D4 LD A,$FF      ; Start the count at #N$FF so the next step makes it zero.
@label=ProcessScreenCharacter_Next
*$C2D6 INC A         ; {Add one to the count at #R$A019 and point #REGhl at
 $C2D7 LD ($A019),A  ; #N$5020.
 $C2DA LD HL,$5020   ; }
 $C2DD LD C,$02      ; Use a length of #N$02.
; Update screen display.
 $C2DF CALL $C316    ; Call #R$C316 to update the screen.
; Screen flag selects the width.
 $C2E2 LD A,($C128)  ; {Take #N$24 and go to #R$C2F8 if the byte at #R$C128 is
 $C2E5 AND A         ; zero.
 $C2E6 LD A,$24      ;
 $C2E8 JR Z,$C2F8    ; }
 $C2EA LD A,$12      ; {Take a width of #N$12 and store it from #R$C2F8.
 $C2EC JR $C2F8      ; }
; Print this character and leave the row once the width runs out.
; .
; Print character.
@label=ProcessScreenCharacter_ScreenWidthCount
*$C2EE CALL $C388    ; Call #R$C388 to print this character.
 $C2F1 LD A,($C1F5)  ; {Jump back to #R$C2CA if the count is finished.
 $C2F4 DEC A         ;
 $C2F5 JP Z,$C2CA    ; }
@label=ProcessScreenCharacter_RecordScreenWidth
*$C2F8 LD ($C1F5),A  ; {Record the screen width and record the storage
 $C2FB LD ($C1F8),HL ; decorative line screen position.
 $C2FE LD A,C        ; }
 $C2FF LD ($C1FA),A  ; Record the decorative line.
 $C302 POP AF        ; {Restore the saved result, the saved count and the saved
 $C303 POP BC        ; pointer from the stack.
 $C304 POP HL        ; }
 $C305 RET           ; Return.

; Scroll Screen And Reset Display
;
; Used by the routines at #R$9E74 and #R$C2BA.
; .
; Waits for a key, then resets the screen display.
@label=ScrollScreenAndResetDisplay
c$C306 PUSH HL       ; {Call #R$C415 to wait for keypress.
 $C307 LD HL,$5A5F   ;
 $C30A SET 7,(HL)    ;
 $C30C CALL $C415    ; }
 $C30F RES 7,(HL)    ; {Clear bit 7, call #R$C142 to reset the screen.
 $C311 CALL $C142    ; }
 $C314 POP HL        ; Restore #REGhl from the stack.
 $C315 RET           ; Return.

; Update Screen Display
;
; Used by the routine at #R$C2BA.
; .
; Copies the picture up one character row when the screen is being updated.
;
; HL Screen position
; C Column count
@label=UpdateScreenDisplay
c$C316 LD A,($C128)  ; {Call #R$C3E4 if the screen flags is zero.
 $C319 AND A         ;
 $C31A CALL Z,$C3E4  ; }
 $C31D PUSH BC       ; {Save the registers and point #REGhl at the second character row of the screen
 $C31E PUSH HL       ; (#N$4020).
 $C31F PUSH DE       ;
 $C320 LD HL,$4020   ; }
 $C323 LD DE,$4000   ; Point the row copy at the top of the screen.
 $C326 LD BC,$0011   ; Take a length of #N$11 entries.
 $C329 LD A,($C128)  ; {Go to #R$C333 with #REGa=#N$20 if the flag at #R$C128
 $C32C AND A         ; is zero (otherwise use #N$10).
 $C32D LD A,$20      ;
 $C32F JR Z,$C333    ; }
 $C331 LD A,$10      ; Use #N$10 for the display.
@label=UpdateScreenDisplay_Loop
*$C333 PUSH HL       ; {Save #REGhl, #REGde and #REGbc, and take a count of
 $C334 PUSH DE       ; #N$08.
 $C335 PUSH BC       ;
 $C336 LD C,$08      ; }
@label=UpdateScreenDisplay_KeepRowDestination
*$C338 PUSH HL       ; {Keep the row, the destination and the count while this
 $C339 PUSH DE       ; pixel line is copied.
 $C33A PUSH BC       ;
 $C33B LD C,A        ; }
 $C33C LDIR          ; Copy one row of the character being drawn onto the
                     ; screen.
 $C33E POP BC        ; {Jump back to #R$C338 while the count is not finished.
 $C33F POP DE        ;
 $C340 POP HL        ;
 $C341 INC H         ;
 $C342 INC D         ;
 $C343 DEC C         ;
 $C344 JR NZ,$C338   ; }
 $C346 POP BC        ; {Restore the screen registers from the stack.
 $C347 POP DE        ;
 $C348 POP HL        ; }
 $C349 PUSH AF       ; {And call #R$C37D to advance the screen position.
 $C34A CALL $C37D    ; }
 $C34D CALL $C37D    ; {Call #R$C37D to advance screen position.
 $C350 POP AF        ; }
 $C351 DEC C         ; {Jump back to #R$C333 while the count is not finished.
 $C352 JR NZ,$C333   ; }
 $C354 CP $10        ; {Go to #R$C363 if it is #N$10.
 $C356 JR Z,$C363    ; }
 $C358 LD HL,$5820   ; {Point at the second and first attribute rows, ready to scroll the attributes up one
 $C35B LD DE,$5800   ; row.}
 $C35E LD BC,$0220   ; Take #N$0220 bytes, seventeen attribute rows.
 $C361 LDIR          ; Scroll the attributes up one row.
@label=UpdateScreenDisplay_Next
*$C363 LD A,($C128)  ; {Set #REGb to #N$24 and jump to #R$C36D if the screen
 $C366 AND A         ; flag at #R$C128 is zero.
 $C367 LD B,$24      ;
 $C369 JR Z,$C36D    ; }
 $C36B LD B,$12      ; Count #N$12.
@label=UpdateScreenDisplay_FillSpaces
*$C36D LD HL,$5020   ; {Point #REGhl at the screen address #N$5020, set #REGc
 $C370 LD C,$02      ; to #N$02 and take a space.
 $C372 LD A,$20      ; }
*$C374 CALL $C388    ; Call #R$C388 to print a space.
 $C377 DJNZ $C374    ; Count the next entry and repeat from #R$C374.
 $C379 POP DE        ; {Restore the saved source, the saved pointer and the
 $C37A POP HL        ; saved count from the stack.
 $C37B POP BC        ; }
 $C37C RET           ; Return.

; Advance Screen Position
;
; Used by the routine at #R$C316.
; .
; Moves the screen address on by one character row (#N$20, and #N$08 in the
; high byte).
;
;   HL Screen position
; O:HL Updated screen position
@label=AdvanceScreenPosition
c$C37D EX DE,HL      ; Swap in the other screen pointer, so calling this twice
                     ; moves both #REGhl and #REGde on by one character row.
 $C37E LD A,L        ; Read the low byte of the pointer.
 $C37F ADD A,$20     ; Advance the result by #N$20.
 $C381 LD L,A        ; Store the result in the low byte of the pointer.
 $C382 RET NC        ; Return when the row still fits on the screen.
 $C383 LD A,H        ; Read the high byte of the pointer.
 $C384 ADD A,$08     ; Advance the result by #N$08.
 $C386 LD H,A        ; Store the result in the high byte of the pointer.
 $C387 RET           ; Return.

; Print Character
;
; Used by the routines at #R$C1A8, #R$C1FD, #R$C22D, #R$C249, #R$C28D, #R$C2BA
; and #R$C316.
; .
; Looks the character up in the font and draws it at the screen address.
;
; A Character to print
; HL Screen buffer address
@label=PrintCharacter
c$C388 PUSH AF       ; {Store that in the low byte and clear the high byte.
 $C389 PUSH BC       ;
 $C38A PUSH DE       ;
 $C38B PUSH HL       ;
 $C38C LD L,A        ;
 $C38D LD H,$00      ; }
 $C38F ADD HL,HL     ; {Multiply by #N$08 (each font character is #N$08 bytes
 $C390 ADD HL,HL     ; of data).
 $C391 ADD HL,HL     ; }
 $C392 LD DE,$3C00   ; {Point #REGde at #SKOOLKID$3D00(CHARSET) minus #N$0100,
 $C395 ADD HL,DE     ; plus this character's offset.
 $C396 EX DE,HL      ; }
 $C397 POP HL        ; Restore the screen address from the stack.
 $C398 PUSH HL       ; Keep a copy of it.
 $C399 LD B,$08      ; Set a counter in #REGb for #N$08 bytes of the font data.
*$C39B LD A,(DE)     ; {Read the next byte of this character's bitmap and keep
 $C39C PUSH BC       ; the counters.
 $C39D PUSH AF       ; }
; Does this character need shifting?
 $C39E DEC C         ; {See whether this character needs shifting.
 $C39F INC C         ; }
 $C3A0 LD B,$FF      ; {Go to #R$C3AB if the count reaches zero.
 $C3A2 JR Z,$C3AB    ; }
@label=PrintCharacter_Loop
*$C3A4 SRL A         ; {Jump back to #R$C3A4 while the count is not finished.
 $C3A6 SRL B         ;
 $C3A8 DEC C         ;
 $C3A9 JR NZ,$C3A4   ; }
@label=PrintCharacter_Next
*$C3AB LD C,A        ; {Take the count.
 $C3AC LD A,B        ; }
 $C3AD CPL           ; Invert the shifted mask so it covers the screen pixels
                     ; to keep.
 $C3AE AND (HL)      ; Keep the screen pixels outside the character.
 $C3AF OR C          ; Add the pixels of the character.
 $C3B0 LD (HL),A     ; {Store it at the pointer.
 $C3B1 POP AF        ;
 $C3B2 POP BC        ; }
; Is the character byte-aligned?
 $C3B3 DEC C         ; {See whether the shift count is zero without changing it, so the character is
 $C3B4 INC C         ; byte-aligned.}
 $C3B5 JR Z,$C3D0    ; Go to #R$C3D0 when the shift count is zero, so the
                     ; character is byte-aligned.
 $C3B7 PUSH BC       ; {Work out how many bit positions are left in this row.
 $C3B8 PUSH AF       ;
 $C3B9 LD A,$08      ;
 $C3BB SUB C         ;
 $C3BC LD C,A        ;
 $C3BD POP AF        ; }
 $C3BE LD B,$FF      ; Start a mask of all ones, shifted with the character
                     ; data.
@label=PrintCharacter_CountFinished
*$C3C0 SLA A         ; {Jump back to #R$C3C0 while the count is not finished.
 $C3C2 SLA B         ;
 $C3C4 DEC C         ;
 $C3C5 JR NZ,$C3C0   ; }
 $C3C7 LD C,A        ; {Take the count.
 $C3C8 LD A,B        ; }
 $C3C9 CPL           ; Invert the shifted mask so it covers the screen pixels
                     ; to keep in the next cell.
 $C3CA INC HL        ; Step to the next character.
 $C3CB AND (HL)      ; Keep the screen pixels in that cell outside the
                     ; character.
 $C3CC OR C          ; Add the part of the character that spills into that
                     ; cell.
 $C3CD LD (HL),A     ; {Store it at the pointer and step back one character.
 $C3CE DEC HL        ;
 $C3CF POP BC        ; }
@label=PrintCharacter_NextBitmapByte
*$C3D0 INC DE        ; {Step to the next bitmap byte and the next pixel row.
 $C3D1 INC H         ; }
 $C3D2 DJNZ $C39B    ; Draw the next pixel row and repeat from #R$C39B until
                     ; the character is finished.
 $C3D4 POP HL        ; {Add #N$07 to the total.
 $C3D5 POP DE        ;
 $C3D6 POP BC        ;
 $C3D7 LD A,C        ;
 $C3D8 ADD A,$07     ; }
 $C3DA CP $08        ; {Jump ahead to #R$C3E1 if the total is below #N$08.
 $C3DC JR C,$C3E1    ; }
 $C3DE SUB $08       ; {Drop #N$08 from the count.
 $C3E0 INC L         ; }
*$C3E1 LD C,A        ; Store the result in the low byte of the count.
 $C3E2 POP AF        ; Restore #REGaf from the stack.
 $C3E3 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$87C9 }
; LIST#

; Redraw The Screen When Input Is Waiting
;
; Used by the routine at #R$C316.
; .
; Returns at once when the input flag is clear. Otherwise it redraws the screen
; before the next key is taken.
c$C3E4 LD A,($A008)  ; {Return if the input is zero.
 $C3E7 AND A         ;
 $C3E8 RET Z         ; }
 $C3E9 PUSH HL       ; {Keep the text position and point at the top row, with
 $C3EA PUSH DE       ; eight pixel lines to redraw.
 $C3EB PUSH BC       ;
 $C3EC LD HL,$4000   ;
 $C3EF LD B,$08      ; }
*$C3F1 PUSH BC       ; {Keep the count and the row, call #R$C403, then step
 $C3F2 PUSH HL       ; #REGh to the next pixel row.
 $C3F3 CALL $C403    ;
 $C3F6 POP HL        ;
 $C3F7 INC H         ;
 $C3F8 POP BC        ; }
 $C3F9 DJNZ $C3F1    ; Count the next pixel row and repeat from #R$C3F1.
 $C3FB LD A,$04      ; Take #N$04.
 $C3FD OUT ($FB),A   ; Stop the ZX Printer motor (port #N$FB).
 $C3FF POP BC        ; {Restore the saved count, the saved source and the saved
 $C400 POP DE        ; pointer from the stack.
 $C401 POP HL        ; }
 $C402 RET           ; Return.

; Set The Printer Motor Speed Via Port #N$FB
;
; Used by the routine at #R$C3E4.
; .
; The game's copy of the ROM #SKOOLKID$0EF4(COPY_LINE) code: writes #N$02 to port
; #N$FB when the count in #REGb is below three (slowing the printer motor for the last two
; pixel lines), and #N$00 otherwise, then waits until a read from that port comes back negative.
@label=SetPrinterMotorSpeed
c$C403 LD A,B        ; {Compare #REGb with #N$03 and leave #N$FF in #REGa when
 $C404 CP $03        ; the count is below.
 $C406 SBC A,A       ; }
 $C407 AND %00000010 ; Keep just bit 1, giving #N$02 (slow the printer motor)
                     ; when the count is below three and #N$00 otherwise.
 $C409 OUT ($FB),A   ; Send that strobe to the ZX Printer on port #N$FB.
 $C40B LD D,A        ; Keep the motor value just sent in #REGd.
*$C40C IN A,($FB)    ; {Read port #N$FB and return if the ZX Printer is busy.
 $C40E ADD A,A       ;
 $C40F RET M         ; }
 $C410 JR NC,$C40C   ; Go back to #R$C40C while the ZX Printer is not ready.
 $C412 JP $0F12      ; Jump to #SKOOLKID$0EF4(COPY_LINE) at #N$0F12.

; Wait For Keypress
;
; Used by the routines at #R$A040, #R$B09A, #R$C1C0 and #R$C306.
; .
; Waits until a key is held, then returns that key without the press bit.
;
; O:A The ASCII code keypress value
;
; Bit 7 is only set after a key has been pressed.
@label=WaitForKeypress_Loop
c$C415 CALL $C41F    ; Call #R$C41F to read the keyboard.
 $C418 BIT 7,A       ; {Jump back to #R$C415 while bit 7 of #REGa is clear.
 $C41A JR Z,$C415    ; }
; Strip off the set bit for the response.
 $C41C AND %01111111 ; Strip the key-pressed marker (bit 7) to leave the ASCII
                     ; code.
 $C41E RET           ; Return.

; Get Keypress
;
; Used by the routines at #R$A064, #R$A536 and #R$C415.
; .
; Waits for the next frame and reads the key the Spectrum last reported.
;
; O:A Keypress value, or #N$00 for no keypress
@label=GetKeypress
c$C41F PUSH IY       ; {Save the schedule entry, the character record, the pointer, the source and
 $C421 PUSH IX       ; the count.
 $C423 PUSH HL       ;
 $C424 PUSH DE       ;
 $C425 PUSH BC       ; }
 $C426 LD IY,$5C3A   ; #REGiy=#SKOOLKID$5C3A(ERR_NR).
 $C42A EI            ; {Let one frame interrupt through so the ROM can scan the
 $C42B HALT          ; keyboard, then turn interrupts off again.
 $C42C DI            ; }
 $C42D LD A,($5C3B)  ; {Jump to #R$C437 if bit 5 of *#SKOOLKID$5C3B(FLAGS) is
 $C430 BIT 5,A       ; set, indicating that a key has been pressed.
 $C432 JR NZ,$C437   ; }
; No key has been pressed.
 $C434 XOR A         ; Load #REGa with #N$00 (no keypress).
 $C435 JR $C456      ; Carry on and wait for a key once the mode flags are
                     ; stored.
; Clear the mark on this character, then store the result in the working byte,
; then read the working value.
; .
; A key has been pressed, so process it.
@label=GetKeypress_Process
*$C437 RES 5,A       ; {Store it in the system variables.
 $C439 LD ($5C3B),A  ; }
 $C43C LD A,($5C08)  ; {Jump to #R$C445 if *#SKOOLKID$5C08(LAST_K) (last key
 $C43F CP $5F        ; pressed) is not ASCII #N$5F ("#CHR$5F").
 $C441 JR NZ,$C445   ; }
 $C443 LD A,$18      ; Use #N$18 for the key.
; Did the player press "DELETE"?
@label=GetKeypress_CheckDelete
*$C445 CP $0C        ; {Jump to #R$C44B if *#SKOOLKID$5C08(LAST_K) (last key
 $C447 JR NZ,$C44B   ; pressed) is not ASCII #N$0C ("DELETE").}
 $C449 LD A,$08      ; Load #REGa with #N$08 (delete was pressed).
; Did the player press "UP"?
@label=GetKeypress_CheckUp
*$C44B CP $0B        ; {Jump to #R$C451 if *#SKOOLKID$5C08(LAST_K) (last key
 $C44D JR NZ,$C451   ; pressed) is not ASCII #N$0B ("UP").}
 $C44F LD A,$5B      ; Load #REGa with #N$5B (up was pressed).
; Validate keypress.
@label=GetKeypress_Validate
*$C451 CALL $C240    ; Call #R$C240 to accept the key if it is in range.
 $C454 SET 7,A       ; Set the mark on this character.
@label=GetKeypress_Return
*$C456 POP BC        ; {Restore the saved count, the saved source, the saved
 $C457 POP DE        ; pointer, the saved character record and the saved
 $C458 POP HL        ; schedule entry from the stack.
 $C459 POP IX        ;
 $C45B POP IY        ; }
 $C45D RET           ; Return.

; Check Display Parameter
;
; Used by the routines at #R$C560 and #R$C613.
; .
; Compares the working value at #R$A010 with #N$05, then compares #REGb with
; #N$6E or #N$6A.
@label=CheckDisplayParameter
c$C45E LD A,($A010)  ; {Read the working value.
 $C461 JR $C466      ; }

; Read The Display Mode
;
; Used by the routines at #R$C4D1 and #R$C591.
; .
; Reads the display mode and checks the picture marker.
@label=ReadDisplayModeForPicture
c$C463 LD A,($A00F)                         ; Read the display mode.
; This entry point is used by the routine at #R$C45E.
*$C466 CP $05                               ; {Jump ahead to #R$C46E if the
 $C468 LD A,B                               ; display mode is below #N$05.
 $C469 JR C,$C46E                           ; }
 $C46B CP $6E                               ; See whether the count has reached
                                            ; #N$6E.
 $C46D RET                                  ; Return.
; Return when the character is the letter j.
@label=ReadDisplayModeForPicture_Next
*$C46E CP $6A                               ; See whether the count has reached
                                            ; #N$6A.
 $C470 RET                                  ; Return.
 $C471 DEFB $30,$09,$00,$00,$88,$02,$00,$00 ; {Token numbers for a clear
 $C479 DEFB $EF,$05,$BB,$01,$25,$02,$00,$00 ; graphics flag. A zero word is an
                                            ; empty slot, read by #R$CB7B.}
 $C481 DEFB $17,$05,$00,$00,$5F,$03,$00,$00 ; {Token numbers for a set graphics
 $C489 DEFB $FF,$05,$0B,$06,$00,$00,$00,$00 ; flag, read by #R$CB7B.}
 $C491 DEFB $00                             ; Character attribute saved by
                                            ; #R$CA22 and read by #R$CB7B.
 $C492 DEFB $00                             ; Object attribute saved by #R$CA2C
                                            ; and read by #R$CB7B.

; Check Display Flag Bits 3 And 7
;
; Used by the routines at #R$A37D, #R$B191 and #R$C4D1.
; .
; Tests bits 3 and 7 of the object attribute at #R$A01D. When both allow it,
; the display flag chooses the mode.
@label=CheckDisplayBitsThreeAndSeven
c$C493 XOR A         ; {Point #REGhl at the object attribute and go to #R$C4AE
 $C494 LD HL,$A01D   ; if bit 3 is clear.
 $C497 BIT 3,(HL)    ;
 $C499 JR Z,$C4AE    ; }
 $C49B LD A,$04      ; {Go to #R$C4AE if bit 7 of the object attribute is set.
 $C49D BIT 7,(HL)    ;
 $C49F JR NZ,$C4AE   ; }
 $C4A1 LD A,($A01E)  ; Read the display.
; Bits 2 and 3 of the display flag choose the mode.
 $C4A4 AND $0C       ; {Jump to #R$C4AE with #N$05 if bits 2 and 3 of the
 $C4A6 CP $0C        ; display flag are both set.
 $C4A8 LD A,$05      ;
 $C4AA JR Z,$C4AE    ; }
 $C4AC LD A,$07      ; Use #N$07 for the display.
*$C4AE LD ($A00F),A  ; Store it in the display mode.
 $C4B1 RET           ; Return.

; Check Display Flag Bits 2 And 6
;
; Used by the routines at #R$A37D, #R$B191 and #R$C4D1.
; .
; Tests bits 2 and 6 of the object attribute at #R$A01D. When both allow it,
; the display flag chooses the mode.
@label=CheckDisplayBitsTwoAndSix
c$C4B2 XOR A         ; {Point #REGhl at the object attribute and go to #R$C4CD
 $C4B3 LD HL,$A01D   ; if bit 2 is clear.
 $C4B6 BIT 2,(HL)    ;
 $C4B8 JR Z,$C4CD    ; }
 $C4BA LD A,$04      ; {Go to #R$C4CD if bit 6 of the object attribute is set.
 $C4BC BIT 6,(HL)    ;
 $C4BE JR NZ,$C4CD   ; }
 $C4C0 LD A,($A01E)  ; Read the display.
; Bits 0 and 1 of the display flag choose the mode.
 $C4C3 AND $03       ; {Jump to #R$C4CD with #N$05 if bits 0 and 1 of the
 $C4C5 CP $03        ; display flag are both set.
 $C4C7 LD A,$05      ;
 $C4C9 JR Z,$C4CD    ; }
 $C4CB LD A,$07      ; Use #N$07 for the display.
*$C4CD LD ($A010),A  ; Store it in the display mode.
 $C4D0 RET           ; Return.

; Process Display Action
;
; Used by the routines at #R$CC82, #R$CE18 and #R$CE6A.
; .
; Jumps ahead when bit 7 of the saved character is set, otherwise finds the
; object's place in the table and checks the display flag.
@label=ProcessDisplayAction
c$C4D1 LD A,($A033)  ; {Jump ahead to #R$C583 if bit 7 of flags: Saved
 $C4D4 BIT 7,A       ; Character (#R$A033) is present.
 $C4D6 JP NZ,$C583   ; }
; Calculate object table offset.
 $C4D9 CALL $A2B1    ; Call #R$A2B1 to find the object's place in the table.
 $C4DC PUSH HL       ; {Call #R$A2BD to extract object attributes.
 $C4DD POP IX        ;
 $C4DF CALL $A2BD    ; }
 $C4E2 CALL $C493    ; {Call #R$C493 to test bits 3 and 7 of the object
 $C4E5 CALL $C4B2    ; attribute, then call #R$C4B2 to test bits 2 and 6.}
 $C4E8 XOR A         ; {Clear the parser.
 $C4E9 LD ($A00B),A  ; }
; None of the bits #N$0C are set in the object attribute value?
 $C4EC LD A,($A01D)  ; {Go to #R$C53A if bit 2 and bit 3 of the object
 $C4EF AND $0C       ; attribute are clear.
 $C4F1 JR Z,$C53A    ; }
 $C4F3 LD A,($A00F)  ; {Jump to #R$C502 if the display mode is not #N$05.
 $C4F6 CP $05        ;
 $C4F8 JR NZ,$C502   ; }
 $C4FA LD A,($A034)  ; {Jump to #R$CB41 if the room display parameter is not
 $C4FD CP $FE        ; #N$FE.
 $C4FF JP NZ,$CB41   ; }
@label=ProcessDisplayAction_Next
*$C502 LD A,($A010)  ; {Jump to #R$C511 if the display mode is not #N$05.
 $C505 CP $05        ;
 $C507 JR NZ,$C511   ; }
 $C509 LD A,($A035)  ; {Jump to #R$CB41 if the room graphics parameter is not
 $C50C CP $FE        ; #N$FE.
 $C50E JP NZ,$CB41   ; }
@label=ProcessDisplayAction_DisplayModeZero
*$C511 LD A,($A00F)  ; {Jump to #R$C531 if the display mode is zero.
 $C514 AND A         ;
 $C515 JR Z,$C531    ; }
 $C517 LD A,($A034)  ; {Jump to #R$C531 if the room display parameter is not
 $C51A CP $FF        ; #N$FF.
 $C51C JR NZ,$C531   ; }
 $C51E LD B,$FF      ; Start the count at #N$FF so the first step is #N$00.
@label=ProcessDisplayAction_Loop
*$C520 INC B         ; {Count one more and return if #R$C463 finds the last
 $C521 CALL $C463    ; room for this display mode.
 $C524 RET Z         ; }
 $C525 LD ($A034),A  ; Record the room display parameter.
 $C528 PUSH BC       ; {Call #R$C55A to run display action.
 $C529 CALL $C55A    ;
 $C52C POP BC        ; }
 $C52D JR NZ,$C53A   ; Go to #R$C53A if #R$C55A found a picture.
 $C52F JR $C520      ; This picture did not match, so try the next one from
                     ; #R$C520.
; Accept the graphics parameter, and return when it is empty.
@label=ProcessDisplayAction_AcceptGraphicsParameter
*$C531 CALL $C542    ; {Go to #R$C53A if the graphics parameter is not
 $C534 JR Z,$C53A    ; accepted.}
 $C536 CALL $C560    ; {Return if the graphics count has reached its limit.
 $C539 RET Z         ; }
@label=ProcessDisplayAction_RunObjectDisplay
*$C53A LD A,$01      ; {Set the parser flag to #N$01 and draw the object from
 $C53C LD ($A00B),A  ; #R$C929.
 $C53F JP $C929      ; }

; Accept The Graphics Parameter
;
; Used by the routines at #R$C4D1 and #R$C55A.
; .
; Returns if the saved marker is clear. Otherwise accepts the graphics parameter unless
; the object is already marked.
@label=AcceptGraphicsParameter
c$C542 LD A,($A010)  ; {Return if the display mode is zero.
 $C545 AND A         ;
 $C546 RET Z         ; }
 $C547 LD A,($A035)  ; {Jump to #R$C558 if the room graphics parameter is not
 $C54A CP $FF        ; #N$FF.
 $C54C JR NZ,$C558   ; }
; Bit 1 of the object attribute value is set?
 $C54E LD A,($A01D)  ; {Go to #R$C558 if bit 1 of the object attribute is set.
 $C551 AND $02       ;
 $C553 JR NZ,$C558   ; }
 $C555 OR %00000001  ; Reset the zero flag.
 $C557 RET           ; Return.
@label=AcceptGraphicsParameter_SignalStepFailed
*$C558 XOR A         ; Clear #REGa.
 $C559 RET           ; Return.

; Record The Result In The Room Graphics
;
; Used by the routine at #R$C4D1.
; .
; Goes to #R$C929 when the graphics parameter is not accepted.
@label=RecordResultRoomGraphics
c$C55A CALL $C542    ; {Go to #R$C929 if the graphics parameter is not
 $C55D JP Z,$C929    ; accepted.}

; Record The Result In The Room Graphics
;
; Used by the routine at #R$C4D1.
; .
; Counts from #N$FF and stores each step in the room graphics parameter until
; the count runs out.
@label=RecordResultRoomGraphics_CountCountRemaining
c$C560 LD B,$FF      ; Start the count at #N$FF so the first step is #N$00.
@label=RecordResultRoomGraphics_TestCountHasReached
*$C562 INC B         ; {Jump to #R$C570 if the count has reached zero.
 $C563 CALL $C45E    ;
 $C566 JR Z,$C570    ; }
 $C568 LD ($A035),A  ; {Store the room graphics parameter and call #R$C929.
 $C56B CALL $C929    ; }
 $C56E JR Z,$C562    ; Jump back to #R$C562 while the object has nothing to
                     ; display.
@label=RecordResultRoomGraphics_Return
*$C570 RET           ; Return.

; Copy The Record Flag Nibble
;
; Used by the routine at #R$C591.
; .
; Copies the low nibble of the record flags to #R$A00F.
@label=CopyRecordFlagNibble
c$C571 LD A,(IX+$00) ; {Copy the low nibble of the record flags to #R$A00F.
 $C574 AND $0F       ;
 $C576 LD ($A00F),A  ; }
 $C579 RET           ; Return.

; Copy The Record's Value Nibble
;
; Used by the routine at #R$C591.
; .
; Copies the low nibble of the record's value byte to #R$A010.
@label=CopyRecordValueNibble
c$C57A LD A,(IX+$01) ; {Copy the low nibble of the record's value byte to
 $C57D AND $0F       ; #R$A010.
 $C57F LD ($A010),A  ; }
 $C582 RET           ; Return.

; Look Up The Display Record For The Moved Marker
;
; Used by the routine at #R$C4D1.
; .
; Turns the moved marker into an index and reads the display record address
; from #R$9FAB.
@label=LookUpDisplayRecordForMovedMarker
c$C583 AND $7F       ; {Keep bits 0-6 of the marker as the index and point
 $C585 LD E,A        ; #REGhl at #R$9FAB.
 $C586 LD D,$00      ;
 $C588 LD HL,$9FAB   ; }
 $C58B ADD HL,DE     ; {Add twice the index and read the display record address
 $C58C ADD HL,DE     ; into #REGhl.
 $C58D LD E,(HL)     ;
 $C58E INC HL        ;
 $C58F LD D,(HL)     ;
 $C590 EX DE,HL      ; }

; Process Display Record From Script
;
; Used by the routine at #R$CE57.
; .
; #REGhl points at a display record. Copies the low nibbles of its flags and
; value byte to #R$A00F/#R$A010, clears #R$A00B and checks the record against the
; current room before drawing it.
@label=ProcessDisplayRecordFromScript
c$C591 PUSH HL       ; {Point #REGix at the record and copy the low nibble of its flags to #R$A00F
 $C592 POP IX        ; via #R$C571.
 $C594 CALL $C571    ; }
 $C597 CALL $C57A    ; Copy the low nibble of the value byte via #R$C57A.
 $C59A XOR A         ; {Clear the parser.
 $C59B LD ($A00B),A  ;
 $C59E LD A,($A00F)  ; }
 $C5A1 LD HL,$A010   ; Take the display mode.
 $C5A4 OR (HL)       ; {Merge the flag at #R$A010, and go to #R$C5F4 when both
 $C5A5 JR Z,$C5F4    ; flags are clear.}
 $C5A7 LD A,($A00F)  ; {Jump to #R$C5B2 if the display mode is #N$05.
 $C5AA CP $05        ;
 $C5AC JR Z,$C5B2    ; }
 $C5AE CP $06        ; {Jump ahead to #R$C5BA if the display mode is not #N$06.
 $C5B0 JR NZ,$C5BA   ; }
@label=ProcessDisplayRecordFromScript_CompareRoom
*$C5B2 LD A,($A034)  ; {Jump to #R$CB41 if the room display parameter is not
 $C5B5 CP $FE        ; #N$FE.
 $C5B7 JP NZ,$CB41   ; }
@label=ProcessDisplayRecordFromScript_DisplayMode
*$C5BA LD A,($A010)  ; {Jump to #R$C5C5 if the display mode is #N$05.
 $C5BD CP $05        ;
 $C5BF JR Z,$C5C5    ; }
 $C5C1 CP $06        ; {Jump ahead to #R$C5CD if the display mode is not #N$06.
 $C5C3 JR NZ,$C5CD   ; }
@label=ProcessDisplayRecordFromScript_TestGraphics
*$C5C5 LD A,($A035)  ; {Jump to #R$CB41 if the room graphics parameter is not
 $C5C8 CP $FE        ; #N$FE.
 $C5CA JP NZ,$CB41   ; }
@label=ProcessDisplayRecordFromScript_DisplayModeZero
*$C5CD LD A,($A00F)  ; {Jump to #R$C5EB if the display mode is zero.
 $C5D0 AND A         ;
 $C5D1 JR Z,$C5EB    ; }
 $C5D3 LD A,($A034)  ; {Jump to #R$C5EB if the room display parameter is not
 $C5D6 CP $FF        ; #N$FF.
 $C5D8 JR NZ,$C5EB   ; }
 $C5DA LD B,$00      ; Start the picture count at zero.
@label=ProcessDisplayRecordFromScript_TestDisplay
*$C5DC CALL $C463    ; {Return if the count has reached the graphics limit.
 $C5DF RET Z         ; }
 $C5E0 LD ($A034),A  ; {Store it in the room display parameter, then call #R$C60D to run display
 $C5E3 CALL $C60D    ; action.}
 $C5E6 JR NZ,$C5F4   ; Go to #R$C5F4 if #R$C60D found a picture.
 $C5E8 INC B         ; {Try the next display value from #R$C5DC.
 $C5E9 JR $C5DC      ; }
; Accept a set graphics parameter, and return when it is empty.
@label=ProcessDisplayRecordFromScript_AcceptGraphics
*$C5EB CALL $C5FC    ; {Go to #R$C5F4 if the set graphics parameter is not
 $C5EE JR Z,$C5F4    ; accepted.}
 $C5F0 CALL $C613    ; {Return if the graphics count has reached its limit.
 $C5F3 RET Z         ; }
@label=ProcessDisplayRecordFromScript_RunObjectDisplay
*$C5F4 LD A,$01      ; {Set the parser flag at #R$A00B to #N$01 and continue at
 $C5F6 LD ($A00B),A  ; #R$C989.
 $C5F9 JP $C989      ; }

; Accept A Set Graphics Parameter
;
; Used by the routines at #R$C591 and #R$C60D.
; .
; Returns if the saved marker is clear. Otherwise accepts a graphics parameter that is
; still set.
@label=AcceptSetGraphicsParameter
c$C5FC LD A,($A010)  ; {Return if the display mode is zero.
 $C5FF AND A         ;
 $C600 RET Z         ; }
 $C601 LD A,($A035)  ; {Jump to #R$C60B if the room graphics parameter is not
 $C604 CP $FF        ; #N$FF.
 $C606 JR NZ,$C60B   ; }
 $C608 OR %00000001  ; Reset the zero flag.
 $C60A RET           ; Return.
@label=AcceptSetGraphicsParameter_SignalStepFailedAgain
*$C60B XOR A         ; Clear #REGa.
 $C60C RET           ; Return.

; Record The Result In The Room Graphics
;
; Used by the routine at #R$C591.
; .
; Goes to #R$C989 when the set graphics parameter is not accepted.
@label=RecordResultRoomGraphics_ClearHighByte
c$C60D CALL $C5FC    ; {Go to #R$C989 if the set graphics parameter is not
 $C610 JP Z,$C989    ; accepted.}

; Record The Result In The Room Graphics
;
; Used by the routine at #R$C591.
; .
; Counts from zero and stores the room graphics parameter until the graphics
; limit.
@label=RecordResultRoomGraphics_CountGraphicsSteps
c$C613 PUSH BC       ; {Save #REGbc and start the graphics count at zero.
 $C614 LD B,$00      ; }
@label=RecordResultRoomGraphics_TestDisplayParameter
*$C616 CALL $C45E    ; {Go to #R$C626 if the count has reached the graphics
 $C619 JR Z,$C626    ; limit.}
 $C61B LD ($A035),A  ; {Store it in the room graphics parameter, then call #R$C989 to run object
 $C61E CALL $C989    ; display with pointer.}
 $C621 JR NZ,$C626   ; Jump ahead to #R$C626 to return if #R$C989 does not
                     ; return #N$00.
 $C623 INC B         ; {Try the next graphics value from #R$C616.
 $C624 JR $C616      ; }
; Return.
@label=RecordResultRoomGraphics_Save
*$C626 POP BC        ; Restore #REGbc from the stack.
 $C627 RET           ; Return.

; Test The Character Field Of The Display Record
;
; Used by the routine at #R$C9BF.
; .
; Tests the low nibble of the record flags against the room and the object.
;
; .
;
; Low nibble of the record flags is clear?
@label=TestLowBitsOfCharacter
c$C628 LD A,(IY+$00)  ; {Read the low nibble of the record flags and jump ahead
 $C62B AND $0F        ; to #R$C635 when it is not zero.
 $C62D JR NZ,$C635    ; }
; This entry point is used by the routines at #R$C6BE, #R$C763 and #R$C7A6.
@label=TestLowBitsOfCharacter_ReportMatch
*$C62F OR %00000001   ; Reset the zero flag.
 $C631 RET            ; Return.
; This entry point is used by the routine at #R$C7A6.
; .
; The character field did not match.
@label=TestLowBitsOfCharacter_GiveUp
*$C632 JP $DC15       ; Return zero through #R$DC15.
; For a picture code from 5 up to but not including 7, reads the room chosen
; for the picture.
@label=TestLowBitsOfCharacter_CodeFromFive
*$C635 CP $05         ; {Jump ahead to #R$C660 if the low nibble of the record
 $C637 JR C,$C660     ; flags is below #N$05.}
 $C639 CP $07         ; {Jump ahead to #R$C682 if the low nibble of the record
 $C63B JR NC,$C682    ; flags is at least #N$07.}
 $C63D LD A,($A034)   ; {Jump to #R$C654 if the room display parameter is not
 $C640 CP $FE         ; #N$FE.
 $C642 JR NZ,$C654    ; }
 $C644 LD HL,($A02F)  ; Read the display pointer.
 $C647 LD A,(IY+$00)  ; {Jump to #R$C65A unless the low nibble of the record
 $C64A AND $0F        ; flags is #N$05.
 $C64C CP $05         ;
 $C64E JR NZ,$C65A    ; }
 $C650 BIT 7,L        ; {Jump back to #R$C62F if bit 7 is clear.
 $C652 JR Z,$C62F     ; }
; This entry point is used by the routine at #R$C6BE.
@label=TestLowBitsOfCharacter_ClearFlag
*$C654 XOR A          ; {Clear the byte at #R$A021 and return zero through
 $C655 LD ($A021),A   ; #R$C632.
 $C658 JR $C632       ; }
; Bit 7 of the room pointer selects the next picture.
@label=TestLowBitsOfCharacter_TestTopBit
*$C65A BIT 7,L        ; {Jump back to #R$C62F while bit 7 is present.
 $C65C JR NZ,$C62F    ; }
 $C65E JR $C654       ; Bit 7 of the room pointer is clear, so give up from
                      ; #R$C654.
; For a code below 3, looks the room up and accepts it when the top flag is
; set.
@label=TestLowBitsOfCharacter_CodeBelowThree
*$C660 CP $03         ; {Jump ahead to #R$C670 if the low nibble of the record
 $C662 JR NC,$C670    ; flags is at least #N$03.}
 $C664 LD A,($A034)   ; {Read the room display parameter, then call #R$D224 to
 $C667 CALL $D224     ; look up this room.}
 $C66A BIT 7,(IX+$00) ; {Jump to #R$C654 if a marker on the record's flag byte
 $C66E JR Z,$C654     ; is clear.}
@label=TestLowBitsOfCharacter_TestMarker
*$C670 BIT 0,(IY+$00) ; {Jump to #R$C62F if bit 0 of the record flags is clear.
 $C674 JR Z,$C62F     ; }
 $C676 LD A,($A034)   ; {Read the room display parameter and call #R$D471 to
 $C679 CALL $D471     ; find an object by field two.}
 $C67C CP $FF         ; {Jump back to #R$C654 if the entry is the end marker.
 $C67E JR Z,$C654     ; }
 $C680 JR $C62F       ; The entry is not the end marker, so return non-zero
                      ; from #R$C62F.
; Read the room display parameter, record it in the room parameter at #R$CB7A
; and keep it in #REGc.
@label=TestLowBitsOfCharacter_UseRoom
*$C682 LD A,($A034)   ; {Read the room display parameter, store it in the room
 $C685 LD ($CB7A),A   ; parameter at #R$CB7A and keep it in #REGc.
 $C688 LD C,A         ; }
 $C689 LD A,(IY+$00)  ; {Test the record flags through #R$C7A6 and go to
 $C68C CALL $C7A6     ; #R$C654 if it returns zero.
 $C68F JR Z,$C654     ; }
 $C691 BIT 4,(IY+$00) ; {Jump to #R$C62F if bit 4 of the record flags is clear.
 $C695 JR Z,$C62F     ; }
 $C697 LD A,(IY+$02)  ; {Read record bytes #N$02 and #N$03.
 $C69A LD L,(IY+$03)  ; }
 $C69D LD H,(IY+$04)  ; Read record byte #N$04 as the high byte.
 $C6A0 BIT 6,(IY+$00) ; {Jump to #R$C6AF unless bit 6 of the record flags is
 $C6A4 JR Z,$C6AF     ; set.}
 $C6A6 LD A,(IY+$04)  ; {With a handler word present, read record bytes
 $C6A9 LD L,(IY+$05)  ; #N$04-#N$06 instead.}
 $C6AC LD H,(IY+$06)  ; Read record byte #N$06 as the high byte.
@label=TestLowBitsOfCharacter_ShiftNibble
*$C6AF RRCA           ; {Shift the parameter down by four bits and call #R$C74E to test the object
 $C6B0 RRCA           ; attribute.
 $C6B1 RRCA           ;
 $C6B2 RRCA           ;
 $C6B3 LD B,A         ;
 $C6B4 CALL $C74E     ; }
 $C6B7 RET NZ         ; Return if #R$C74E does not match the attribute.
; This entry point is used by the routine at #R$C6BE.
@label=TestLowBitsOfCharacter_MarkMatched
*$C6B8 LD A,$01       ; {Write #N$01 to the byte at #R$A021.
 $C6BA LD ($A021),A   ; }
 $C6BD RET            ; Return.

; Test The Graphics Field Of The Display Record
;
; Used by the routine at #R$C9BF.
; .
; Tests the low nibble of the record's value byte against the room graphics.
;
; .
;
; Low nibble of the record's value byte is clear?
@label=TestLowBitsOfGraphics
c$C6BE LD A,(IY+$01)  ; {Read the low nibble of the record's value byte and
 $C6C1 AND $0F        ; jump ahead to #R$C6CB when it is not zero.
 $C6C3 JR NZ,$C6CB    ; }
@label=TestLowBitsOfGraphics_ReportMatch
*$C6C5 OR %00000001   ; Reset the zero flag.
 $C6C7 RET            ; Return.
 $C6C8 JP $DC15       ; Return zero through #R$DC15.
; For a graphics code from 5 up to but not including 7, reads the room chosen
; for the graphics.
@label=TestLowBitsOfGraphics_CodeFromFive
*$C6CB CP $05         ; {Jump ahead to #R$C6F5 if the low nibble of the value
 $C6CD JR C,$C6F5     ; byte is below #N$05.}
 $C6CF CP $07         ; {Jump ahead to #R$C719 if the low nibble of the value
 $C6D1 JR NC,$C719    ; byte is at least #N$07.}
 $C6D3 LD A,($A035)   ; {Jump to #R$C654 if the room graphics parameter is not
 $C6D6 CP $FE         ; #N$FE.
 $C6D8 JP NZ,$C654    ; }
 $C6DB LD HL,($A031)  ; Read the display pointer.
 $C6DE LD A,(IY+$01)  ; {Jump to #R$C6EE unless the low nibble of the value
 $C6E1 AND $0F        ; byte is #N$05.
 $C6E3 CP $05         ;
 $C6E5 JR NZ,$C6EE    ; }
 $C6E7 BIT 7,L        ; {Jump back to #R$C6C5 if bit 7 is clear.
 $C6E9 JR Z,$C6C5     ; }
 $C6EB JP $C654       ; This picture does not match, so give up from #R$C654.
; Bit 7 of the graphics pointer selects the next picture.
@label=TestLowBitsOfGraphics_TestTopBit
*$C6EE BIT 7,L        ; {Jump back to #R$C6C5 while bit 7 is present.
 $C6F0 JR NZ,$C6C5    ; }
 $C6F2 JP $C654       ; Bit 7 of the graphics pointer is clear, so give up from
                      ; #R$C654.
; For a graphics code below 3, looks the room up and accepts it when the top
; flag is set.
@label=TestLowBitsOfGraphics_CodeBelowThree
*$C6F5 CP $03         ; {Jump ahead to #R$C706 if the low nibble of the value
 $C6F7 JR NC,$C706    ; byte is at least #N$03.}
 $C6F9 LD A,($A035)   ; {Read the room graphics parameter, then call #R$D224 to
 $C6FC CALL $D224     ; look up this room.}
 $C6FF BIT 7,(IX+$00) ; {Jump to #R$C654 if a marker on the record's flag byte
 $C703 JP Z,$C654     ; is clear.}
@label=TestLowBitsOfGraphics_TestMarker
*$C706 BIT 0,(IY+$01) ; {Jump to #R$C6C5 if bit 0 of the value byte is clear.
 $C70A JR Z,$C6C5     ; }
 $C70C LD A,($A035)   ; {Read the room graphics parameter and call #R$D471 to
 $C70F CALL $D471     ; find an object by field two.}
 $C712 CP $FF         ; {Jump back to #R$C654 if the entry is the end marker.
 $C714 JP Z,$C654     ; }
 $C717 JR $C6C5       ; The entry is not the end marker, so return non-zero
                      ; from #R$C6C5.
; Read the room graphics parameter and keep it for the picture.
@label=TestLowBitsOfGraphics_UseGraphics
*$C719 LD A,($A035)   ; {Read the room graphics parameter, store it in the room
 $C71C LD ($CB7A),A   ; parameter at #R$CB7A and keep it in #REGc.
 $C71F LD C,A         ; }
 $C720 LD A,(IY+$01)  ; {Return if #R$C7A6 returns zero.
 $C723 CALL $C7A6     ;
 $C726 RET Z          ; }
 $C727 BIT 4,(IY+$00) ; {Jump to #R$C62F if bit 4 of the record flags is clear.
 $C72B JP Z,$C62F     ; }
 $C72E LD A,(IY+$02)  ; {Read record bytes #N$02 and #N$05.
 $C731 LD L,(IY+$05)  ; }
 $C734 LD H,(IY+$06)  ; Read record byte #N$06.
 $C737 BIT 6,(IY+$00) ; {Jump to #R$C746 unless bit 6 of the record flags is
 $C73B JR Z,$C746     ; set.}
 $C73D LD A,(IY+$04)  ; {With a handler word present, read record bytes #N$04
 $C740 LD L,(IY+$07)  ; and #N$07 instead.}
 $C743 LD H,(IY+$08)  ; Read record byte #N$08.
@label=TestLowBitsOfGraphics_TestAttribute
*$C746 LD B,A         ; {Use that byte as the count and call #R$C74E to test
 $C747 CALL $C74E     ; the object attribute.}
 $C74A RET NZ         ; Return if #R$C74E does not match the attribute.
 $C74B JP $C6B8       ; The attribute matched, so record it from #R$C6B8.

; Read The Object Attribute
;
; Used by the routines at #R$C628 and #R$C6BE.
; .
; Looks the object up and folds its attribute into the two-bit count.
@label=ReadObjectAttribute_LooksObjectFolds
c$C74E LD A,C        ; {Call #R$D237 to look up that object.
 $C74F CALL $D237    ; }
 $C752 LD C,(IX+$05) ; Read the object's attribute into #REGc.
 $C755 LD A,B        ; {Shift #REGb down by two bits, keep the low two, put
 $C756 RRCA          ; #REGl in #REGd and call #R$C763.
 $C757 RRCA          ;
 $C758 AND $03       ;
 $C75A LD D,L        ;
 $C75B CALL $C763    ; }
 $C75E RET Z         ; Return if the source test returns zero.
 $C75F LD A,B        ; {Keep the bits in #N$03.
 $C760 AND $03       ;
 $C762 LD D,H        ; }

; Read The High Byte Of The Source
;
; Used by the routine at #R$C74E.
; .
; Compares the high byte of the source with the bits set in the count.
@label=ReadHighByteSource
c$C763 JR NZ,$C76D   ; Jump to #R$C76D when the folded attribute is not zero.
 $C765 LD A,D        ; Take the byte in #REGd.
 $C766 AND C         ; Keep only the bits that are set in the count.
 $C767 CP D          ; See whether the two values match.
; This entry point is used by the routine at #R$C7A6.
*$C768 JP Z,$C62F    ; Go to #R$C62F if the masked attribute matches.
 $C76B JR $C792      ; The masked attribute does not match, so go to #R$C792 to
                     ; keep only the bits of #REGd outside the mask.
; For command 1, keeps the matching bits of the high byte.
@label=ReadHighByteSource_CommandOne
*$C76D CP $01        ; See whether the attribute is #N$01.
 $C76F JR NZ,$C77B   ; Jump to #R$C77B when the attribute is not one.
 $C771 LD A,D        ; See whether any attribute bits are still set.
 $C772 AND A         ; Clear the carry before testing the attribute mask.
 $C773 JR Z,$C768    ; Jump to #R$C768 when the attribute mask is clear.
 $C775 AND C         ; {Go to #R$C795 if the attribute mask matches nothing.
 $C776 JR Z,$C795    ; }
 $C778 JP $C62F      ; Jump back to #R$C62F to return non-zero.
; For command 2, gives up when none of the selected bits are set.
@label=ReadHighByteSource_CommandTwo
*$C77B CP $02        ; See whether the attribute is #N$02.
 $C77D JR NZ,$C788   ; Jump to #R$C788 when the attribute is not two.
 $C77F LD A,D        ; {Go to #R$C62F to return zero if the attribute mask
 $C780 AND C         ; matches nothing.
 $C781 JP Z,$C62F    ; }
 $C784 OR $80        ; {Jump ahead to #R$C797 to store it in the token select
 $C786 JR $C797      ; flag and read the parser.}
; Read the high byte of the source, then keep only the bits that are set in the
; count, then see whether the two values match.
@label=ReadHighByteSource_HighByteSource
*$C788 LD A,D        ; {Go to #R$C62F if the mask does not cover the attribute.
 $C789 AND C         ;
 $C78A CP D          ;
 $C78B JP NZ,$C62F   ; }
 $C78E OR $80        ; {Jump ahead to #R$C797 to store it in the token select
 $C790 JR $C797      ; flag and read the parser.}
@label=ReadHighByteSource_FlipBitsResult
*$C792 XOR $FF       ; {Invert the mask and keep the bits that are also set in
 $C794 AND D         ; #REGd.}
@label=ReadHighByteSource_TestWorkspaceKeepingBits
*$C795 AND $7F       ; {Store it in the token select flag at #R$CB79, keeping
@label=ReadHighByteSource_Store
*$C797 LD ($CB79),A  ; bits in #N$7F.}
 $C79A LD A,($A00B)  ; {Jump to #R$C62F if the parser is zero.
 $C79D AND A         ;
 $C79E JP Z,$C62F    ; }
 $C7A1 LD HL,$CB7B   ; Use #R$CB7B as the pointer.
 $C7A4 XOR A         ; Clear #REGa.
 $C7A5 RET           ; Return.

; Test For The Seventh Marker
;
; Used by the routines at #R$C628 and #R$C6BE.
; .
; Keeps bits 0-3 and tests the seventh and eighth markers.
@label=TestSeventhMarker
c$C7A6 AND $0F       ; {Jump back to #R$C62F if the low nibble is command
 $C7A8 CP $07        ; #N$07.
 $C7AA JP Z,$C62F    ; }
 $C7AD CP $08        ; {Go to #R$C7BB when the command is not #N$08.
 $C7AF JR NZ,$C7BB   ; }
 $C7B1 LD A,C        ; {Take the count, then call #R$C821 to test object
 $C7B2 CALL $C821    ; location match.}
*$C7B5 JP Z,$C632    ; Go to #R$C632 if the object is not in this location.
 $C7B8 JP $C62F      ; Jump back to #R$C62F to return non-zero.
; For command 9, checks the low count and gives up when that check fails.
@label=TestSeventhMarker_CommandNine
*$C7BB CP $09        ; {Jump ahead to #R$C7E4 if the command is not #N$09.
 $C7BD JR NZ,$C7E4   ; }
 $C7BF LD A,C        ; {Go to #R$C632 if the object is not in this location.
 $C7C0 CALL $C821    ;
 $C7C3 JP Z,$C632    ; }
 $C7C6 LD A,C        ; {Go to #R$C632 if the record's first byte is not #N$01.
 $C7C7 CALL $C8A7    ;
 $C7CA JP NZ,$C632   ; }
 $C7CD LD A,C        ; {Go to #R$C632 if the object has a special description.
 $C7CE CALL $C8BE    ;
 $C7D1 JP NZ,$C632   ; }
 $C7D4 LD B,C        ; {Read the character being processed, then call #R$C8C6
 $C7D5 LD A,($A036)  ; to run object attribute.
 $C7D8 CALL $C8C6    ; }
 $C7DB JP Z,$C632    ; Go to #R$C632 if the attribute comparison borrows.
 $C7DE LD A,C        ; {Jump back to #R$C768 to run display action.
 $C7DF CALL $C8AF    ;
 $C7E2 JR $C768      ; }
; For command 10, checks the low count and gives up when that check fails.
@label=TestSeventhMarker_CommandTen
*$C7E4 CP $0A        ; {Jump ahead to #R$C7F9 if the command is not #N$0A.
 $C7E6 JR NZ,$C7F9   ; }
 $C7E8 LD A,C        ; {Go to #R$C632 if the object is not in this location.
 $C7E9 CALL $C821    ;
 $C7EC JP Z,$C632    ; }
 $C7EF LD A,C        ; {Jump to #R$C632 if #R$D275 does not match this
 $C7F0 CALL $D275    ; character.
 $C7F3 JP NC,$C632   ; }
 $C7F6 JP $C62F      ; Jump back to #R$C62F to return non-zero.
; For command 11, checks the low count and gives up when that check fails.
@label=TestSeventhMarker_CommandEleven
*$C7F9 CP $0B        ; {Jump ahead to #R$C80A if the command is not #N$0B.
 $C7FB JR NZ,$C80A   ; }
 $C7FD LD A,C        ; {Go to #R$C632 if the object is not in this location.
 $C7FE CALL $C821    ;
 $C801 JP Z,$C632    ; }
 $C804 LD A,C        ; {Call #R$C8A7 for the object in #REGc and jump to
 $C805 CALL $C8A7    ; #R$C7B5.
 $C808 JR $C7B5      ; }
; For command 12, follows the object that contains this one.
@label=TestSeventhMarker_CommandTwelve
*$C80A CP $0C        ; {Jump ahead to #R$C814 if the command is not #N$0C.
 $C80C JR NZ,$C814   ; }
 $C80E LD A,C        ; {Call #R$C8BE and jump back to #R$C7B5, which gives up
 $C80F CALL $C8BE    ; when the special description is clear.
 $C812 JR $C7B5      ; }
; The object is in the room, so follow whatever contains it.
@label=TestSeventhMarker_MatchObjectThenRoom
*$C814 LD A,C        ; {Give up on this object when it is not in the room, otherwise follow the object that
 $C815 CALL $C821    ; contains it.
 $C818 JP Z,$C632    ; }
 $C81B LD A,C        ; {Call #R$C8BE and jump back to #R$C7B5, which gives up
 $C81C CALL $C8BE    ; when the special description is clear.
 $C81F JR $C7B5      ; }

; Check Object Location Match
;
; Used by the routines at #R$9CCE, #R$C7A6, #R$CBC2, #R$CC5A, #R$D078, #R$D36A,
; #R$D4EF and #R$E17B.
; .
; Looks the object up and clears the zero flag when its location matches the
; current character.
;
;   A Object ID
; O:F Zero flag clear when the location matches
@label=CheckObjectLocationMatch
c$C821 PUSH IX        ; {Call #R$D237 to look up that object.
 $C823 PUSH BC        ;
 $C824 CALL $D237     ; }
 $C827 LD B,A         ; {Keep #REGa in #REGb and call #R$C863 to read the
 $C828 LD A,($A036)   ; current character's room.
 $C82B CALL $C863     ; }
 $C82E CP B           ; {Go to #R$C85D if the character's room is this object.
 $C82F JR Z,$C85D     ; }
 $C831 BIT 7,(IX+$05) ; {Jump ahead to #R$C85A if the object-attribute flag is
 $C835 JR Z,$C85A     ; clear.}
 $C837 LD C,A         ; {Exchange #REGa with #REGb and call #R$C863 to read
 $C838 LD A,B         ; that object's room.
 $C839 LD B,C         ;
 $C83A CALL $C863     ; }
 $C83D LD C,A         ; {Go to #R$C85D if this object's room is the character
 $C83E LD A,($A036)   ; being processed.
 $C841 CP C           ;
 $C842 JR Z,$C85D     ; }
 $C844 LD A,C         ; {Go to #R$C85A if the two locations differ.
 $C845 CP B           ;
 $C846 JR NZ,$C85A    ; }
 $C848 INC A          ; {Report a match at #R$C85D unless both locations are
 $C849 JR NZ,$C85D    ; #N$FF.}
 $C84B LD B,(IX+$00)  ; Read the record's flag byte.
 $C84E LD A,($A00A)   ; Read the character attribute.
*$C851 CP (IX+$0F)    ; {Jump ahead to #R$C85D if it matches the character
 $C854 JR Z,$C85D     ; attribute.}
 $C856 INC IX         ; Step to the next byte of the object.
 $C858 DJNZ $C851     ; Count the next object and repeat from #R$C851.
@label=CheckObjectLocationMatch_Next
*$C85A XOR A          ; {Set the zero flag and jump ahead to #R$C85F.
 $C85B JR $C85F       ; }
@label=CheckObjectLocationMatch_TestStepSucceedsScript
*$C85D OR $01         ; Clear the zero flag to report that the character
                      ; attribute was found.
@label=CheckObjectLocationMatch_BringSavedCount
*$C85F POP BC         ; {Restore the saved count and the saved character record
 $C860 POP IX         ; from the stack.}
 $C862 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9E40 }
; LIST#

; Get Object Location
;
; Used by the routines at #R$C821, #R$D113, #R$D187 and #R$E5C3.
; .
; Looks the object up and returns the room it is in.
;
;   A Object ID
; O:A Location ID
@label=GetObjectLocation
c$C863 PUSH IX       ; {Call #R$D237 to look up that object.
 $C865 CALL $D237    ; }
 $C868 CALL $C86E    ; {Call #R$C86E to check object mother.
 $C86B POP IX        ; }
 $C86D RET           ; Return.

; Check Object Mother
;
; Used by the routines at #R$C863 and #R$D078.
; .
; Follows the moved marker until #N$FF and leaves the id it stopped on in the
; alternate accumulator.
@label=CheckObjectMother
c$C86E PUSH IX        ; {Switch to the saved result and take the end marker.
 $C870 EX AF,AF'      ;
 $C871 LD A,$FF       ; }
@label=CheckObjectMother_Loop
*$C873 EX AF,AF'      ; {Jump to #R$C895 if the moved marker is #N$FF.
 $C874 LD A,(IX+$01)  ;
 $C877 CP $FF         ;
 $C879 JR Z,$C895     ; }
 $C87B EX AF,AF'      ; {Call #R$D237 to look up the current object.
 $C87C LD A,(IX+$01)  ;
 $C87F CALL $D237     ; }
 $C882 BIT 7,(IX+$05) ; {Jump ahead to #R$C894 if the object-attribute flag is
 $C886 JR Z,$C894     ; clear.}
; An object flag is set?
 $C888 BIT 5,(IX+$05) ; {Jump to #R$C873 if an object flag is set.
 $C88C JR NZ,$C873    ; }
 $C88E BIT 3,(IX+$05) ; See whether bit 3 of the object attribute is set.
 $C892 JR NZ,$C873    ; Jump to #R$C873 when this object's attribute bit is
                      ; set.
@label=CheckObjectMother_Next
*$C894 EX AF,AF'      ; Switch to the saved result.
*$C895 POP IX         ; Restore the saved character record from the stack.
 $C897 RET            ; Return.
 $C898 CALL $C89E     ; {Run #R$C89E, then run #R$C86E.
 $C89B CALL $C86E     ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$9E7A }
; LIST#

; Exchange The Character Record With The Schedule
;
; Used by the routine at #R$C86E.
; .
; Return.
@label=ExchangeCharacterRecordSchedule
c$C89E PUSH IX       ; {Swap the room record with the object record.
 $C8A0 PUSH IY       ;
 $C8A2 POP IX        ;
 $C8A4 POP IY        ; }
 $C8A6 RET           ; Return.

; Get Object Attribute
;
; Used by the routine at #R$C7A6.
; .
; Looks the object up and returns one less than its first flag.
;
;   A Object ID
; O:A One less than the record's first byte
@label=GetObjectAttribute
c$C8A7 CALL $D237    ; Call #R$D237 to look up that object.
 $C8AA LD A,(IX+$00) ; Read the record flag.
 $C8AD DEC A         ; Count down one.
 $C8AE RET           ; Return.

; Get Object Mother ID
;
; Used by the routines at #R$C7A6 and #R$DEE4.
; .
; Looks the object up and follows the object that contains it until the chain
; ends.
;
;   A Object ID
; O:A Mother object ID (or #N$FF if none)
@label=GetObjectMotherID
c$C8AF CALL $D237    ; Call #R$D237 to look that object up.
@label=GetObjectMotherID_Loop
*$C8B2 LD A,(IX+$01) ; {Return if the moved marker is #N$FF.
 $C8B5 CP $FF        ;
 $C8B7 RET Z         ; }
 $C8B8 CALL $C8BE    ; {Return if the object has a special description.
 $C8BB RET NZ        ; }
 $C8BC JR $C8B2      ; The bit test returned zero, so read the next entry from
                     ; #R$C8B2.

; Test Object Has Special Description
;
; Used by the routines at #R$C7A6 and #R$C8AF.
; .
; Looks up the object and reports whether its attribute byte has the special-description
; marker.
;
;   A Object ID
; O:F Zero flag clear when bit 6 of the attribute is set
@label=TestObjectHasSpecialDescription
c$C8BE CALL $D237     ; Call #R$D237 to load the object data pointer.
 $C8C1 BIT 6,(IX+$05) ; See whether the special-description flag is set.
 $C8C5 RET            ; Return.

; Process Object Attribute
;
; Used by the routines at #R$C7A6 and #R$DEE4.
; .
; Looks the object up, then reads its attribute through #R$D2F2.
@label=ProcessObjectAttribute_LookObjectRun
c$C8C6 PUSH BC        ; {Call #R$D237 to look up that object.
 $C8C7 PUSH AF        ;
 $C8C8 LD A,B         ;
 $C8C9 CALL $D237     ; }
 $C8CC LD A,B         ; {Take the count, then call #R$D2F2 to get object
 $C8CD CALL $D2F2     ; attribute value.}
 $C8D0 ADD A,(IX+$03) ; {Add the object's third parameter, and go to #R$C8D7
 $C8D3 JR NC,$C8D7    ; when the sum does not carry.}
 $C8D5 LD A,$FF       ; Use #N$FF when the sum overflowed.
*$C8D7 LD B,A         ; {Call #R$D237 to look up that object.
 $C8D8 POP AF         ;
 $C8D9 LD C,A         ;
 $C8DA CALL $D237     ; }
 $C8DD LD A,C         ; {Take the count, then call #R$D2F2 to get object
 $C8DE CALL $D2F2     ; attribute value.}
 $C8E1 SUB (IX+$03)   ; {Subtract the object's third parameter, negate #REGa
 $C8E4 NEG            ; and subtract #REGb.
 $C8E6 SUB B          ; }
 $C8E7 POP BC         ; Restore #REGbc from the stack.
 $C8E8 JR C,$C8ED     ; Go to #R$C8ED if that subtraction borrows.
 $C8EA OR %00000001   ; Reset the zero flag.
 $C8EC RET            ; Return.
@label=ProcessObjectAttribute_SignalStepFailed
*$C8ED XOR A          ; Clear #REGa.
 $C8EE RET            ; Return.

; Set Object Pointers
;
; Used by the routines at #R$C929 and #R$C989.
; .
; Chooses a room record or an object record from the picture parameter.
@label=SetObjectPointers
c$C8EF LD A,($A034)  ; {Jump to #R$C90C if the room display parameter is at
 $C8F2 CP $FE        ; least #N$FE.
 $C8F4 JR NC,$C90C   ; }
 $C8F6 LD A,($A00F)  ; {Compare *#R$A00F with #N$05.
 $C8F9 CP $05        ; }
 $C8FB LD A,($A034)  ; {Read the room display parameter and jump ahead to
 $C8FE JR NC,$C905   ; #R$C905 if the display mode is at least #N$05.}
 $C900 CALL $D224    ; {Call #R$D224 to look up this room.
 $C903 JR $C908      ; }
; Record the character record in the current object, then read the room graphics
; parameter, then check for the other end marker, and return if it reaches the limit.
@label=SetObjectPointers_Next
*$C905 CALL $D237    ; Call #R$D237 to look that object up.
@label=SetObjectPointers_RememberRoomRecord
*$C908 LD ($A013),IX ; Remember the room record and read the room graphics
                     ; parameter.
@label=SetObjectPointers_RoomGraphicsParameter
*$C90C LD A,($A035)  ; {Return if the room graphics parameter is at least
 $C90F CP $FE        ; #N$FE.
 $C911 RET NC        ; }
 $C912 LD A,($A010)  ; {Compare *#R$A010 with #N$05.
 $C915 CP $05        ; }
 $C917 LD A,($A035)  ; {Load the room graphics parameter at #R$A035 and jump to #R$C921 if the display
 $C91A JR NC,$C921   ; mode is at least #N$05.}
 $C91C CALL $D224    ; {Call #R$D224 to look up this room.
 $C91F JR $C924      ; }
; Look the object up before returning.
@label=SetObjectPointers_LookObjectBefore
*$C921 CALL $D237    ; Call #R$D237 to look up that object.
*$C924 LD ($A015),IX ; Remember this character record in the secondary pointer.
 $C928 RET           ; Return.

; Process Object Display Logic
;
; Used by the routines at #R$B191, #R$B2DF, #R$B83C, #R$C4D1, #R$C55A and
; #R$C560.
; .
; Prepares the room or object named for the picture, and skips it when the record is not marked
; for display.
;
; .
;
; Set object pointers.
@label=ProcessObjectDisplayLogic
c$C929 CALL $C8EF     ; Call #R$C8EF to point at this object's records.
 $C92C LD A,($A034)   ; {Jump to #R$C972 if the room display parameter is at
 $C92F CP $FE         ; least #N$FE.
 $C931 JR NC,$C972    ; }
 $C933 LD IX,($A017)  ; Read the current character record.
 $C937 BIT 6,(IX+$05) ; {Jump to #R$C94D if the special-description flag is
 $C93B JR Z,$C94D     ; clear.}
; No matching handler?
 $C93D XOR A          ; {Jump ahead to #R$C94D if #R$D1DC finds no handler.
 $C93E CALL $D1DC     ;
 $C941 JR NC,$C94D    ; }
 $C943 LD A,($A033)   ; {Read the saved character and call #R$D349 to search
 $C946 CALL $D349     ; the two-byte table.}
 $C949 CP $FF         ; {Jump ahead to #R$C960 if the entry is not the end
 $C94B JR NZ,$C960    ; marker.}
@label=ProcessObjectDisplayLogic_Next
*$C94D LD A,($A00F)   ; {Jump to #R$C972 if the display mode is below #N$07.
 $C950 CP $07         ;
 $C952 JR C,$C972     ; }
 $C954 LD IX,($A013)  ; {Call #R$D1DC to calculate handler offset.
 $C958 LD A,($A033)   ;
 $C95B CALL $D1DC     ; }
 $C95E JR NC,$C972    ; Jump ahead to #R$C972 if #R$D1DC finds no handler.
@label=ProcessObjectDisplayLogic_MovedMarker
*$C960 LD A,(IX+$01)  ; {Read the moved marker.
 $C963 LD E,A         ;
 $C964 LD D,$00       ; }
 $C966 LD HL,$AA71    ; Use the lookup table: object display data at #R$AA71.
 $C969 DEC DE         ; {Index the word table at #R$AA71 and draw that record
 $C96A ADD HL,DE      ; from #R$C996.
 $C96B ADD HL,DE      ;
 $C96C LD E,(HL)      ;
 $C96D INC HL         ;
 $C96E LD D,(HL)      ;
 $C96F EX DE,HL       ;
 $C970 JR $C996       ; }
; Read the saved character, then use the display records at #R$9F38 as the character
; record, then check for the end marker.
@label=ProcessObjectDisplayLogic_SavedCharacterMove
*$C972 LD A,($A033)   ; {Call #R$D34E to search three-byte length table.
 $C975 LD IX,$9F38    ;
 $C979 CALL $D34E     ; }
 $C97C CP $FF         ; {Return zero through #R$DC15 if the entry is the end
 $C97E JP Z,$DC15     ; marker.}
 $C981 LD L,(IX+$01)  ; {Read the display-record pointer and draw it from
 $C984 LD H,(IX+$02)  ; #R$C996.
 $C987 JR $C996       ; }

; Process Object Display With Pointer
;
; Used by the routines at #R$C591, #R$C60D and #R$C613.
; .
; Prepares the record and draws it, then restores the character that was on
; screen.
;
; IX Object pointer
@label=ProcessObjectDisplayWithPointer
c$C989 PUSH IX       ; {Call #R$C8EF to set object pointers.
 $C98B POP HL        ;
 $C98C PUSH HL       ;
 $C98D CALL $C8EF    ; }
 $C990 CALL $C996    ; {Call #R$C996 to draw the record.
 $C993 POP IX        ; }
 $C995 RET           ; Return.

; Process Object Display Entry
;
; Used by the routines at #R$C929 and #R$C989.
; .
; Draws the record, and tells the script to continue when the draw works. A
; non-zero return means the script step succeeded.
@label=ProcessObjectDisplayEntry
c$C996 PUSH IY       ; {Call #R$C9BF to draw this record.
 $C998 PUSH BC       ;
 $C999 CALL $C9BF    ;
 $C99C POP BC        ; }
 $C99D POP IY        ; {Jump ahead to #R$C9A7 if bit 7 of the display record is
 $C99F JR C,$C9A7    ; set.}
 $C9A1 JP Z,$CB43    ; Go to #R$CB43 if drawing the object display matched.
 $C9A4 OR %00000001  ; Reset the zero flag.
 $C9A6 RET           ; Return.
; Read the pointer at the currently processed character command position at
; #R$9FD9, then take a count of #N$01, then read the character record from the currently
; processed character timetable pointer at #R$9FDB.
@label=ProcessObjectDisplayEntry_Next
*$C9A7 PUSH HL       ; {Read the currently processed character command position and count #N$01 for run
 $C9A8 PUSH BC       ; object display entry, then call #R$CF80 to allocate memory and store character.
 $C9A9 LD HL,($9FD9) ;
 $C9AC LD B,$01      ;
 $C9AE CALL $CF80    ; }
 $C9B1 POP BC        ; {Read the current character timetable pointer.
 $C9B2 POP HL        ;
 $C9B3 LD IX,($9FDB) ; }
 $C9B7 LD (IX+$01),L ; Store the moved marker.
 $C9BA LD (IX+$02),H ; {Store #REGh as the location, set the carry.
 $C9BD SCF           ; }
 $C9BE RET           ; Return.

; Process Display Record
;
; Used by the routine at #R$C996.
; .
; #REGhl points at a display record (flags, value, optional handler word,
; optional five extra bytes). Checks the record against the current object,
; character and graphics, runs its handler if bit 6 is set, and then either
; returns the address after the record (bit 7 set) or runs the code that follows
; it via #R$CA64. A non-zero return means the script step succeeded.
@label=ProcessDisplayRecord
c$C9BF PUSH HL        ; {Point #REGiy at the display record and call #R$D078 to check whether
 $C9C0 POP IY         ; the object is visible.
 $C9C2 CALL $D078     ; }
 $C9C5 JR NC,$C9D3    ; Go to #R$C9D3 if #R$D078 finds the object is not
                      ; visible.
; Bit 5 of the record flags is clear?
 $C9C7 LD A,(IY+$00)  ; {Jump to #R$C9D3 if bit 5 of the record flags is clear.
 $C9CA AND $20        ;
 $C9CC JR Z,$C9D3     ; }
 $C9CE LD HL,$CBBB    ; Point #REGhl at the failure step at #R$CBBB.
@label=ProcessDisplayRecord_Fail
*$C9D1 XOR A          ; Clear #REGa.
 $C9D2 RET            ; Return.
; Test the character field, the graphics field and the handler bit.
@label=ProcessDisplayRecord_TestHandler
*$C9D3 CALL $C628     ; {Go to #R$C9D1 if the character test on this record
 $C9D6 JR Z,$C9D1     ; fails.}
 $C9D8 CALL $C6BE     ; {Go to #R$C9D1 if the graphics test on this record
 $C9DB JR Z,$C9D1     ; fails.}
 $C9DD BIT 6,(IY+$00) ; {Skip ahead to #R$C9F2 unless bit 6 of the record flags
 $C9E1 JR Z,$C9F2     ; is set.}
 $C9E3 LD L,(IY+$02)  ; {Read the handler word at bytes #N$02/#N$03 of the record and save
 $C9E6 LD H,(IY+$03)  ; #REGiy.
 $C9E9 PUSH IY        ; }
 $C9EB CALL $CB34     ; Run the handler via #R$CB34.
 $C9EE POP IY         ; Restore #REGiy from the stack.
 $C9F0 JR Z,$C9D1     ; Go to #R$C9D1 if the handler returns zero.
@label=ProcessDisplayRecord_TestParser
*$C9F2 LD A,($A00B)   ; {Jump to #R$C9FB if the parser flag at #R$A00B is set.
 $C9F5 AND A          ;
 $C9F6 JR NZ,$C9FB    ; }
 $C9F8 OR %00000001   ; Reset the zero flag.
 $C9FA RET            ; Return.
; Take the high nibble of the record's value byte (#N$01) as the count and
; store it at #R$A01F.
@label=ProcessDisplayRecord_StoreCount
*$C9FB PUSH IY        ; {Save the record pointer and read the value byte
 $C9FD LD A,(IY+$01)  ; (#N$01).}
 $CA00 RRCA           ; {Shift that byte down by four bits.
 $CA01 RRCA           ;
 $CA02 RRCA           ;
 $CA03 RRCA           ; }
 $CA04 AND $0F        ; Keep the high nibble.
 $CA06 LD L,A         ; Use that nibble as the low byte of the count.
 $CA07 LD H,$00       ; Clear the high byte.
 $CA09 LD ($A01F),HL  ; Store the count at #R$A01F.
@label=ProcessDisplayRecord_ComputeLength
 $CA0C POP HL         ; Restore the record address from the stack.
 $CA0D LD DE,$0002    ; {Step over the two-byte header.
 $CA10 ADD HL,DE      ; }
 $CA11 BIT 6,(IY+$00) ; {Skip ahead to #R$CA18 unless bit 6 of the record flags
 $CA15 JR Z,$CA18     ; is set.}
 $CA17 ADD HL,DE      ; Step over the handler word.
@label=ProcessDisplayRecord_TestFiveExtraBytes
*$CA18 LD DE,$0005    ; {Skip ahead to #R$CA22 unless bit 4 of the record flags
 $CA1B BIT 4,(IY+$00) ; is set.
 $CA1F JR Z,$CA22     ; }
 $CA21 ADD HL,DE      ; Step over the five extra bytes.
@label=ProcessDisplayRecord_SaveAttributes
*$CA22 LD A,($A00A)   ; {Read the character attribute and store it in the
 $CA25 LD ($C491),A   ; workspace byte at #R$C491.}
 $CA28 LD IX,($A013)  ; Point #REGix at the current object.
 $CA2C LD A,(IX+$0F)  ; {Read the object's attribute and store it in the workspace byte at #R$C492,
 $CA2F LD ($C492),A   ; then save the address after the record.
 $CA32 PUSH HL        ; }
 $CA33 PUSH IY        ; {Save the record, store #N$01 in the parser flag at #R$A00C, and call
 $CA35 LD A,$01       ; #R$CA76.
 $CA37 LD ($A00C),A   ;
 $CA3A CALL $CA76     ; }
 $CA3D POP IY         ; {Restore the pointers from the stack.
 $CA3F POP HL         ; }
 $CA40 BIT 7,(IY+$00) ; {And skip ahead to #R$CA48 unless bit 7 of the record
 $CA44 JR Z,$CA48     ; flags is set.}
 $CA46 SCF            ; Set the carry.
 $CA47 RET            ; Return with #REGhl pointing past the record, so the
                      ; script resumes there.
; Fill a location byte that is still #N$FF from the room parameters.
@label=ProcessDisplayRecord_FillLocationLow
*$CA48 LD A,($9FD7)   ; {Go to #R$CA54 unless the low byte of #R$9FD7 is #N$FF.
 $CA4B INC A          ;
 $CA4C JR NZ,$CA54    ; }
 $CA4E LD A,($A034)   ; {Copy the room display parameter into #R$9FD7.
 $CA51 LD ($9FD7),A   ; }
@label=ProcessDisplayRecord_FillLocationHigh
*$CA54 LD A,($9FD8)   ; {Go to #R$CA60 unless the high byte of #R$9FD7 is
 $CA57 INC A          ; #N$FF.
 $CA58 JR NZ,$CA60    ; }
 $CA5A LD A,($A035)   ; {Copy the room graphics parameter into the high byte of
 $CA5D LD ($9FD8),A   ; #R$9FD7.}
@label=ProcessDisplayRecord_RunFollowingCode
*$CA60 XOR A          ; {Clear the flag at #R$CAAE and run the code that follows the record
 $CA61 LD ($CAAE),A   ; (at #REGhl) via #R$CB2C.
 $CA64 CALL $CB2C     ; }
 $CA67 PUSH AF        ; {Call #R$CA7F, saving result and the pointer.
 $CA68 PUSH HL        ;
 $CA69 CALL $CA7F     ; }
 $CA6C LD A,($CAAE)   ; {Call #R$CAAF if the room flag at #R$CAAE is clear.
 $CA6F AND A          ;
 $CA70 CALL Z,$CAAF   ; }
 $CA73 POP HL         ; Restore the pointer from the stack.
 $CA74 POP AF         ; Restore #REGaf from the stack.
 $CA75 RET            ; Return.

; Read The Saved Character
;
; Used by the routines at #R$C9BF, #R$CAAF and #R$CB58.
; .
; Call #R$A2E4 if bit 7 of the saved character is clear.
@label=ReadSavedCharacter
c$CA76 LD A,($A033)  ; {Call #R$A2E4 if bit 7 of the saved character is clear.
 $CA79 AND $80       ;
 $CA7B CALL Z,$A2E4  ; }
 $CA7E RET           ; Return.

; Read The Character Timetable
;
; Used by the routine at #R$C9BF.
; .
; Reads the character timetable and returns when Sherlock's disguise matches
; the character attribute.
@label=ReadCharacterTimetable
c$CA7F LD A,($9860)  ; {Call #R$D237 to look up the character at #R$9860.
 $CA82 CALL $D237    ; }
 $CA85 LD A,($A009)  ; Read Sherlock's disguise.
 $CA88 CP (IX+$0F)   ; See whether it matches the character attribute.
 $CA8B RET Z         ; Return if they match.
 $CA8C LD A,($A036)  ; {Save the current character and read the character at
 $CA8F PUSH AF       ; #R$9860.
 $CA90 LD A,($9860)  ; }
 $CA93 LD ($A036),A  ; Record the current character.
 $CA96 CALL $CA9E    ; {Call #R$CA9E to dispatch on the schedule marker.
 $CA99 POP AF        ; }
 $CA9A LD ($A036),A  ; Record the current character.
 $CA9D RET           ; Return.

; Dispatch On The Schedule Marker
;
; Used by the routine at #R$CA7F.
; .
; Reads the schedule entry and runs the object display when its marker is set.
@label=DispatchScheduleMarker
c$CA9E LD A,($DD01)  ; {Read the room at #R$DD01 and the record at #R$DCFF.
 $CAA1 LD HL,($DCFF) ; }
 $CAA4 BIT 6,(HL)    ; {Go to #R$D1B2 if bit 6 of this byte is set.
 $CAA6 JP NZ,$D1B2   ; }
 $CAA9 SET 6,(HL)    ; {Jump ahead to #R$D102 to run location token display.
 $CAAB JP $D102      ; }

; Room Flag
;
; Set by a display record's code to skip the disguise check at #R$CAAF.
; Cleared by #R$CA60, tested by #R$CA6C, and set by #R$DF4B, #R$E108 and #R$E140.
g$CAAE DEFB $00

; Process Object Display Entry
;
; Used by the routine at #R$C9BF.
; .
; Checks this character against Sherlock's disguise and returns when the
; disguise already matches.
@label=CheckCharacterDisguise
c$CAAF CALL $DC6C    ; Call #R$DC6C to check the character id.
 $CAB2 RET Z         ; Return if the character is #N$00, #N$01 or Sherlock.
 $CAB3 LD A,($C491)  ; Read the character id saved for the disguise check.
 $CAB6 LD HL,$A009   ; Use Sherlock's disguise as the pointer.
 $CAB9 CP (HL)       ; See whether it matches Sherlock's disguise.
 $CABA RET Z         ; Return if they match.
 $CABB LD A,($A036)  ; {Call #R$D495 to read the object's first location.
 $CABE CALL $D495    ; }
 $CAC1 LD HL,$A009   ; {Jump ahead to #R$CAD0 if this is not Sherlock's
 $CAC4 CP (HL)       ; disguise.
 $CAC5 JR NZ,$CAD0   ; }
 $CAC7 LD A,($A036)  ; {Read the character being processed and take the exits message, then call #R$CBC2 to
 $CACA LD DE,$68ED   ; run character display.
 $CACD CALL $CBC2    ; }
@label=CheckCharacterDisguise_DisplayModeBelow
*$CAD0 LD A,($A00F)  ; {Return if the display mode is below #N$07.
 $CAD3 CP $07        ;
 $CAD5 RET C         ; }
 $CAD6 LD A,($A034)  ; {Call #R$D495 to read the object's first location.
 $CAD9 CALL $D495    ; }
 $CADC CP $FF        ; {Go to #R$CB12 when this is not the #N$FF end marker.
 $CADE JR NZ,$CB12   ; }
 $CAE0 LD B,(IX+$00) ; {Read the record's first byte into #REGb and read
 $CAE3 LD A,($A009)  ; Sherlock's disguise.}
@label=CheckCharacterDisguise_TestAttributeMatch
*$CAE6 CP (IX+$0F)   ; {Jump ahead to #R$CAF0 if this id matches the character
 $CAE9 JR Z,$CAF0    ; attribute.}
 $CAEB INC IX        ; {Count the next object and repeat from #R$CAE6.
 $CAED DJNZ $CAE6    ; }
 $CAEF RET           ; Return.
; Read the character being processed, then store the result in the count, then
; mark the entry as finished.
@label=CheckCharacterDisguise_CharacterBeingProcessed
*$CAF0 LD A,($A036)  ; {Read the current character.
 $CAF3 LD B,A        ;
 $CAF4 LD A,$FF      ; }
 $CAF6 LD ($A036),A  ; Record the current character.
 $CAF9 LD A,$01      ; {Set the television flag to #N$01.
 $CAFB LD ($5C3C),A  ; }
 $CAFE LD A,($A009)  ; {Read Sherlock's disguise and call #R$D471 to find an
 $CB01 CALL $D471    ; object by field two.}
 $CB04 CP $FF        ; {Call #R$CA76 if the entry is not the end marker.
 $CB06 CALL NZ,$CA76 ; }
 $CB09 SUB A         ; {Store it in the system variables and store it in the
 $CB0A LD ($5C3C),A  ; character being processed.
 $CB0D LD A,B        ;
 $CB0E LD ($A036),A  ; }
 $CB11 RET           ; Return.
; Read the other character id, compare it with Sherlock's disguise, and return
; when they match.
@label=CheckCharacterDisguise_OtherCharacterCompare
*$CB12 LD A,($C492)  ; Read the other character id saved for the disguise
                     ; check.
 $CB15 LD HL,$A009   ; Use Sherlock's disguise as the pointer.
 $CB18 CP (HL)       ; See whether it matches Sherlock's disguise.
 $CB19 RET Z         ; Return if they match.
 $CB1A LD A,($A034)  ; Read the room display parameter.
 $CB1D LD HL,$A036   ; Use the character being processed as the pointer.
 $CB20 CP (HL)       ; See whether it matches the character being processed.
 $CB21 RET Z         ; Return if they match.
 $CB22 LD DE,$68ED   ; {Point #REGde at the message at #R$68E9+#N$04 and jump
 $CB25 JP $CBC2      ; to #R$CBC2.}

; Saved Index Registers
;
; #R$CB34 saves #REGix here and #REGiy at #R$CB2A. #R$CB2C brings both back before the next display record runs.
; Used by #R$CB2C and #R$CB34.
g$CB28 DEFW $0000
 $CB2A DEFW $0000    ; Read by #R$CB2C and #R$CB34.

; Run Display Record Code
;
; Used by the routine at #R$C9BF.
; .
; Restores #REGix/#REGiy from #R$CB28/#R$CB2A, runs the code at #REGhl via
; #R$CB40, then saves #REGix/#REGiy again (falls through to #R$CB34).
@label=RunDisplayRecordCode
c$CB2C LD IX,($CB28) ; {Bring #REGix and #REGiy back from #R$CB28 and #R$CB2A.
 $CB30 LD IY,($CB2A) ; }

; Run Handler Keeping Pointers
;
; Used by the routine at #R$C9BF.
; .
; Runs the code at #REGhl, then saves #REGix and #REGiy for the next record.
c$CB34 CALL $CB40    ; Run the code at #REGhl via #R$CB40.
 $CB37 LD ($CB28),IX ; {Save #REGix and #REGiy for the next record.
 $CB3B LD ($CB2A),IY ; }
 $CB3F RET           ; Return.

; Dispatch Looked-Up Handler
;
; Used by the routines at #R$CB34 and #R$CB67.
; .
; Jumps to the handler the caller looked up.
@label=DispatchLookedUpHandlerThird
c$CB40 JP (HL)       ; Jump to the handler address in #REGhl.
; This entry point is used by the routines at #R$C4D1 and #R$C591.
*$CB41 XOR A         ; Clear #REGa.
 $CB42 RET           ; Return.

; Process Display With Location Check
;
; Used by the routine at #R$C996.
; .
; Asks whether the character is here, and clears the character being processed when the answer is
; no.
@label=ProcessDisplayWithLocationCheck
c$CB43 PUSH HL       ; {Call #R$DC6C to check character id.
 $CB44 CALL $DC6C    ;
 $CB47 POP HL        ; }
 $CB48 JR NZ,$CB65   ; Jump ahead to #R$CB65 to return if the character is not
                     ; zero, one, or Sherlock.
 $CB4A XOR A         ; {Clear the current character.
 $CB4B LD ($A036),A  ; }
 $CB4E LD A,($A00B)  ; {Jump to #R$CB5F if the parser is zero.
 $CB51 AND A         ;
 $CB52 JR Z,$CB5F    ; }
 $CB54 LD A,L        ; {Jump ahead to #R$CB67 if the pointer is not
 $CB55 OR H          ; #N($0000,$04,$04).
 $CB56 JR NZ,$CB67   ; }

; Select Sherlock After Clearing The Parser
;
; Used by the routine at #R$CB7B.
; .
; Clears the room stored for the parser, checks the character on screen, and then makes
; Sherlock the character being processed.
@label=SelectSherlock
c$CB58 XOR A         ; {Clear the parser flag at #R$A00C and call #R$CA76.
 $CB59 LD ($A00C),A  ;
 $CB5C CALL $CA76    ; }
; This entry point is used by the routines at #R$CB43 and #R$CB67.
@label=SelectSherlock_Loop
*$CB5F LD A,($9860)  ; {Record the current character.
 $CB62 LD ($A036),A  ; }
; This entry point is used by the routine at #R$CB43.
@label=SelectSherlock_Next
*$CB65 XOR A         ; Clear #REGa.
 $CB66 RET           ; Return.

; Report Success
;
; Used by the routine at #R$CB43.
; .
; Tells the script this step succeeded.
@label=ReportSuccess
c$CB67 LD A,$01      ; {Take #N$01 and store it in the print mode.
 $CB69 LD ($A027),A  ; }
 $CB6C PUSH IY       ; {Call #R$CB40 to save and restore pointers.
 $CB6E CALL $CB40    ;
 $CB71 POP IY        ; }
 $CB73 XOR A         ; {Clear the flag at #R$A027 and finish from #R$CB5F.
 $CB74 LD ($A027),A  ;
 $CB77 JR $CB5F      ; }

; Token Select Flag
;
; Bit mask #R$CB7B rotates to pick a token word. Bit 7 selects the table at #R$C481. #R$CB7A keeps the room parameter copied back to #R$A034.
; Used by #R$C763 and #R$CB7B.
g$CB79 DEFB $00
 $CB7A DEFB $00      ; Room parameter. Written by #R$C628 and #R$C6BE, and read
                     ; by #R$CB7B.

; Get Display Address Based On Flag
;
; Picks a token number from the graphics flag.
; Pointed at by #R$C7A1.
@label=GetDisplayAddressBasedOnFlag
c$CB7B LD A,($CB79)  ; {Read the token select flag at #R$CB79 and take the
 $CB7E BIT 7,A       ; token table at #R$C471.
 $CB80 LD HL,$C471   ; }
 $CB83 JR Z,$CB88    ; Jump ahead to #R$CB88 if bit 7 of the token select flag
                     ; is clear.
 $CB85 LD HL,$C481   ; Take the token table at #R$C481.
@label=GetDisplayAddressBasedOnFlag_Next
*$CB88 OR $80        ; Force a non-zero result so the caller continues.
@label=GetDisplayAddressBasedOnFlag_Loop
*$CB8A LD E,(HL)     ; {Read the next token number and repeat from #R$CB8A while this bit of the flag is
 $CB8B INC HL        ; clear.
 $CB8C LD D,(HL)     ;
 $CB8D INC HL        ;
 $CB8E RRCA          ;
 $CB8F JR NC,$CB8A   ; }
 $CB91 LD A,D        ; {Jump back to #R$CB58 if this token word is zero.
 $CB92 OR E          ;
 $CB93 JR Z,$CB58    ; }
 $CB95 LD A,($CB7A)  ; {Record the room display parameter.
 $CB98 LD ($A034),A  ; }
 $CB9B LD HL,$6817   ; Use the introduction (#R$680B+#N$0C).
 $CB9E CALL $A59F    ; {Call #R$A59F to print this message, then call #R$A887 to extract token from
 $CBA1 CALL $A887    ; text.}
 $CBA4 JP $A2A2      ; Jump back to #R$A2A2 to print newline.

; Check Flag And Jump To Newline
;
; Used by the routines at #R$DCDD, #R$DD35 and #R$E3F5.
; .
; Returns when bit 6 of #R$B934 is clear. Otherwise clears the print mode,
; prints the introduction at #R$6813+#N$07 and jumps to #R$DC15.
@label=CheckFlagAndJumpToNewline
c$CBA7 LD A,($B934)  ; Read the display flag at #R$B934.
 $CBAA BIT 6,A       ; See whether bit 6 of it is set.
 $CBAC RET Z         ; Return if that marker is clear.
 $CBAD POP HL        ; {Start from zero, store it in the print mode and take
 $CBAE XOR A         ; the introduction message.
 $CBAF LD ($A027),A  ;
 $CBB2 LD HL,$681A   ; }
 $CBB5 CALL $A59F    ; {Print the message, then return zero through #R$DC15.
 $CBB8 JP $DC15      ; }
 $CBBB LD HL,$68D1   ; {Take the cannot see message, then call #R$A59F to print
 $CBBE CALL $A59F    ; the cannot see message.}
 $CBC1 RET           ; Return.

; Process Character Display
;
; Used by the routine at #R$CAAF.
; .
; See whether the display flag is the end marker before returning.
@label=ProcessCharacterDisplay_TestDisplayFlagEnd
c$CBC2 CP $FF        ; {Return if the character is the end marker.
 $CBC4 RET Z         ; }
 $CBC5 AND A         ; {Return if the character is zero.
 $CBC6 RET Z         ; }
 $CBC7 LD B,A        ; {Call #R$D495 to read the object's first location.
 $CBC8 CALL $D495    ; }
 $CBCB LD C,A        ; Store the result in the low byte of the count.
 $CBCC LD A,($A009)  ; Read Sherlock's disguise.
 $CBCF CP C          ; See whether the two values match.
 $CBD0 RET NZ        ; Return if they differ.
 $CBD1 LD A,$01      ; {Write #N$01 to the system Variables.
 $CBD3 LD ($5C3C),A  ;
 $CBD6 PUSH DE       ; }
@label=ProcessCharacterDisplay_LookObject
*$CBD7 LD A,B        ; {Call #R$D237 to look up that object.
 $CBD8 CALL $D237    ; }
 $CBDB LD A,(IX+$01) ; {Jump to #R$CBE5 if the moved marker is #N$FF.
 $CBDE CP $FF        ;
 $CBE0 JR Z,$CBE5    ; }
 $CBE2 LD B,A        ; {Jump back to #R$CBD7 to take the count, call #R$D237 to fetch object data pointer
 $CBE3 JR $CBD7      ; and read the moved marker.}
; Point at the object attribute, remember the character, and switch to the one
; at #R$9860.
@label=ProcessCharacterDisplay_CountExchangeAddress
*$CBE5 LD A,B        ; {Take the count, then call #R$A4BC to point to object
 $CBE6 CALL $A4BC    ; attribute byte.}
 $CBE9 EX (SP),HL    ; {Read the current character.
 $CBEA LD A,($A036)  ;
 $CBED PUSH AF       ; }
 $CBEE LD A,($9860)  ; {Call #R$CC29 to set character pointer and id.
 $CBF1 LD ($A036),A  ;
 $CBF4 CALL $CC29    ; }
 $CBF7 LD A,B        ; {Call #R$C821 to check object location match.
 $CBF8 CALL $C821    ; }
 $CBFB JR NZ,$CC00   ; {Jump ahead to #R$CC00 to set character pointer and id if #R$C821 does not return
 $CBFD POP AF        ; #N$00.
 $CBFE POP HL        ; }
 $CBFF RET           ; Return.
; Put the saved character back and print the message.
@label=ProcessCharacterDisplay_ResultCharacterBeing
*$CC00 POP AF        ; {Call #R$CC29 to set character pointer and id.
 $CC01 LD ($A036),A  ;
 $CC04 CALL $CC29    ; }
 $CC07 CALL $A59F    ; Call #R$A59F to print the message.
 $CC0A RET           ; Return.

; Script Command Counter
;
; Count of script commands #R$CEB8 has run. #R$CC37 clears it, and #R$CC82 stops the script when it reaches #N$0A. #R$CC0D records whether the character was found in the display list.
; Used by #R$CC37, #R$CC82 and #R$CEB8.
g$CC0B DEFB $00
 $CC0C DEFB $00
 $CC0D DEFB $00      ; Set by #R$CC37 and tested by #R$CC82.

; Find Character
;
; Used by the routines at #R$CC37, #R$DD35, #R$E03A and #R$E2EE.
; .
; Searches the timetable at #R$9860 for the character id in #REGa.
;
;   A Character ID
; O:A The character ID or #N$FF if it wasn't found
; O:IY Pointer to character data
; O:F The zero flag will be set if the character wasn't found
;
; Stash some registers so they don't get corrupted.
@label=FindCharacter
c$CC0E PUSH DE       ; {Store the character ID in #REGc, saving source and the
 $CC0F PUSH BC       ; count.
 $CC10 LD C,A        ; }
 $CC11 LD DE,$0008   ; {Use the timetable at #R$9860.
 $CC14 LD IY,$9860   ; }
@label=FindCharacter_Loop
*$CC18 LD A,(IY+$00) ; Fetch the current characters ID from the timetable
                     ; pointer.
 $CC1B CP C          ; {Go to #R$CC26 if this timetable entry is the wanted
 $CC1C JR Z,$CC26    ; character.}
 $CC1E CP $FF        ; {Go to #R$CC26 if it is #N$FF.
 $CC20 JR Z,$CC26    ; }
 $CC22 ADD IY,DE     ; Add #N$08 bytes to the timetable pointer to move to the next set
                     ; of character data.
 $CC24 JR $CC18      ; Go back for the next character pair.
; Return.
; .
; Return with some housekeeping.
@label=FindCharacter_Return
*$CC26 POP BC        ; {Restore the saved count and the saved source from the
 $CC27 POP DE        ; stack.}
 $CC28 RET           ; Return.

; Set Character Pointer And ID
;
; Used by the routines at #R$CBC2 and #R$CC5A.
; .
; Finds the character being processed, and stores that record together with its
; room.
@label=SetCharacterPointerAndID
c$CC29 LD A,($A036)  ; {Call #R$D495 to read the object's first location.
 $CC2C CALL $D495    ; }
 $CC2F LD ($A017),IX ; Remember the character record at #R$A017.
 $CC33 LD ($A00A),A  ; Record the current character attribute.
 $CC36 RET           ; Return.

; Process Character Action
;
; Used by the routine at #R$A064.
; .
; Clears the script command counter at #R$CC0B, then runs #R$CC0E.
;
; A Character ID
@label=ProcessCharacterAction
c$CC37 PUSH AF       ; {Save the character id and clear the script command
 $CC38 XOR A         ; counter at #R$CC0B.
 $CC39 LD ($CC0B),A  ; }
 $CC3C POP AF        ; {Call #R$CC0E to find character.
 $CC3D CALL $CC0E    ; }
 $CC40 CP $FF        ; Was the character ID found?.
 $CC42 LD HL,$0001   ; {Take #N($0001,$04,$04) in #REGhl and jump ahead to
 $CC45 JP Z,$CC74    ; #R$CC74 if #R$CC0E did not find the character.}
; The character is active in the timetable.
 $CC48 LD ($9FDB),IY ; Write the characters timetable pointer to *#R$9FDB.
 $CC4C LD ($A036),A  ; Write the character ID to *#R$A036.
 $CC4F CALL $B91F    ; {Go to #R$CC57 if this character is not in the display
 $CC52 LD A,$00      ; list.
 $CC54 JR NZ,$CC57   ; }
 $CC56 INC A         ; Count one more.
*$CC57 LD ($CC0D),A  ; Store it in the display-list flag at #R$CC0D.

; Read The Character Timetable
;
; Used by the routine at #R$CC78.
; .
; Clears the previous result, notes whether Sherlock is using a disguise, and then reads the
; timetable.
@label=NoteDisguiseAndReadTimetable
c$CC5A CALL $CC29    ; Call #R$CC29 to point at this character and store its
                     ; id.
 $CC5D CALL $D045    ; Call #R$D045 to see whether Sherlock is wearing the
                     ; China Man disguise.
 $CC60 SUB A         ; {Clear *#SKOOLKID$5C3C(TV_FLAG) so that printing goes to
 $CC61 LD ($5C3C),A  ; the upper screen.}
 $CC64 LD A,($9860)  ; {Go to #R$CC71 if the object is not in this location.
 $CC67 CALL $C821    ;
 $CC6A JR Z,$CC71    ; }
 $CC6C LD A,$01      ; {Write #N$01 to *#SKOOLKID$5C3C(TV_FLAG).
 $CC6E LD ($5C3C),A  ; }
@label=NoteDisguiseAndReadTimetable_Next
*$CC71 LD HL,$0000   ; Clear the pointer.
; This entry point is used by the routine at #R$CC37.
@label=NoteDisguiseAndReadTimetable_RecordCharacterScript
*$CC74 LD ($A01F),HL ; Record the character script cycle.
 $CC77 RET           ; Return.

; Script Interpreter
;
; Used by the routine at #R$A064.
; .
; Runs the current character's script from the timetable entry at #R$9FDB, one command at
; a time, until the script ends or yields.
;
; A Character ID
@label=ScriptInterpreter
c$CC78 CALL $CC5A    ; Call #R$CC5A to read this character's timetable.
 $CC7B LD IY,($9FDB) ; {Read the currently processed character timetable pointer, then call #R$D008 to get
 $CC7F CALL $D008    ; script pointer from timetable.}

; Dispatch The Character Script
;
; Used by the routine at #R$CEB8.
; .
; Gets the character's script position and dispatches the next command.
@label=DispatchCharacterScript
c$CC82 LD L,(IY+$01)   ; {Get the character's script position.
 $CC85 LD H,(IY+$02)   ; }
 $CC88 XOR A           ; {Clear the display.
 $CC89 LD ($B934),A    ; }
 $CC8C LD A,($CC0B)    ; {Jump to #R$CD8B if the script command counter at
 $CC8F CP $0A          ; #R$CC0B is #N$0A.
 $CC91 JP Z,$CD8B      ; }
@label=DispatchCharacterScript_NextByte
*$CC94 LD A,(HL)       ; {Jump ahead to #R$CC9B if this byte is not zero.
 $CC95 AND A           ;
 $CC96 JR NZ,$CC9B     ; }
 $CC98 INC HL          ; {Jump back to #R$CC94 to find next command.
 $CC99 JR $CC94        ; }
; Use the saved pointer as the character record, then record the pointer in the currently
; processed character command position at #R$9FD9, then keep bits 0-3.
; .
; Process the current script command.
@label=DispatchCharacterScript_UseCommand
*$CC9B PUSH HL         ; {Record the current character command position.
 $CC9C POP IX          ;
 $CC9E LD ($9FD9),HL   ; }
 $CCA1 AND %00001111   ; Keep the script command number (the low nibble).
 $CCA3 CP $0A          ; {Jump to #R$CCF3 when the command is at least #N$0A.
 $CCA5 JR NC,$CCF3     ; }
 $CCA7 LD A,($CC0D)    ; {Go to #R$CCC7 unless the display-list flag at #R$CC0D
 $CCAA CP $01          ; is #N$01.
 $CCAC JR NZ,$CCC7     ; }
 $CCAE SUB A           ; {Clear the display-list flag at #R$CC0D.
 $CCAF LD ($CC0D),A    ; }
; The room display asked to skip?
 $CCB2 LD A,(HL)       ; {Read this script byte, call #R$B936, and jump to
 $CCB3 CALL $B936      ; #R$CD91 if it returns carry.
 $CCB6 JP C,$CD91      ; }
 $CCB9 JR Z,$CCC7      ; Go to #R$CCC7 if #R$B936 returns zero.
; Did #R$C4D1 accept this display?
 $CCBB CALL $C4D1      ; {Return if #R$C4D1 does not accept this display.
 $CCBE RET NC          ; }
 $CCBF CALL $CFB6      ; {Call #R$CFB6 to find the character script, then write
 $CCC2 LD (IX+$05),$02 ; #N$02 into the object attribute.}
 $CCC6 RET             ; Return.
; Reads one command byte from the character script and dispatches it. Command
; #N$07 refreshes the room display.
@label=DispatchCharacterScript_DispatchOpcode
*$CCC7 LD A,(HL)       ; Get the command byte.
 $CCC8 AND %00001111   ; Extract the command type.
 $CCCA CP $07          ; {Jump ahead to #R$CE3B when the command is #N$07.
 $CCCC JP Z,$CE3B      ; }
 $CCCF CP $06          ; {Jump ahead to #R$CD95 when the command is #N$06.
 $CCD1 JP Z,$CD95      ; }
 $CCD4 CP $05          ; {Jump ahead to #R$CDA1 when the command is #N$05.
 $CCD6 JP Z,$CDA1      ; }
 $CCD9 CP $04          ; {Jump ahead to #R$CDBF when the command is #N$04.
 $CCDB JP Z,$CDBF      ; }
 $CCDE CP $01          ; {Jump ahead to #R$CE6A when the command is #N$01.
 $CCE0 JP Z,$CE6A      ; }
 $CCE3 CP $03          ; {Jump ahead to #R$CE4F when the command is #N$03.
 $CCE5 JP Z,$CE4F      ; }
 $CCE8 CP $08          ; {Jump ahead to #R$CD24 when the command is #N$08.
 $CCEA JR Z,$CD24      ; }
 $CCEC CP $09          ; {Jump ahead to #R$CD47 when the command is #N$09.
 $CCEE JR Z,$CD47      ; }
 $CCF0 JP $CE18        ; Jump ahead to #R$CE18 to handle display room
                       ; description.
; Handles command Type #N$0E/#N$0C/#N$0B/#N$0A.
@label=DispatchCharacterScript_TestGoto
*$CCF3 CP $0E          ; {Jump to #R$CD06 when the command is not #N$0E.
 $CCF5 JR NZ,$CD06     ; }
 $CCF7 LD A,(IX+$01)   ; {Copy #REGix+#N$01 into #REGiy+#N$01.
 $CCFA LD (IY+$01),A   ; }
 $CCFD LD A,(IX+$02)   ; {Copy the script position into the character record
 $CD00 LD (IY+$02),A   ; and parse again from #R$CC82.
 $CD03 JP $CC82        ; }
; Command #N$0C repeats, and command #N$0B copies the script pointer, returning
; when it is #N$02.
@label=DispatchCharacterScript_TestStop
*$CD06 CP $0C          ; See whether the command is #N$0C.
*$CD08 JR Z,$CD08      ; Jump back to #R$CD08 if the command is #N$0C.
 $CD0A CP $0B          ; {Jump to #R$CD17 when the command is not #N$0B.
 $CD0C JR NZ,$CD17     ; }
 $CD0E CALL $CFCF      ; {Call #R$CFCF and return when it reports #N$02.
 $CD11 CP $02          ;
 $CD13 RET Z           ; }
 $CD14 JP $CE8F        ; Jump ahead to #R$CE8F to resume script execution.
; Command 10 copies it is 2.
@label=DispatchCharacterScript_TestNested
*$CD17 CP $0A          ; {Jump to #R$CD82 when the command is not #N$0A.
 $CD19 JR NZ,$CD82     ; }
 $CD1B CALL $CFCF      ; {Call #R$CFCF and return when it reports #N$02.
 $CD1E CP $02          ;
 $CD20 RET Z           ; }
 $CD21 JP $CEB8        ; Jump ahead to #R$CEB8 to run script command with
                       ; counter.
; Handles push Stack.
@label=DispatchCharacterScript_Push
*$CD24 LD A,(IX+$01)   ; {Read the moved marker and use #N$02 for the record, then call #R$A11C to allocate
 $CD27 PUSH AF         ; memory.
 $CD28 LD A,$02        ;
 $CD2A CALL $A11C      ; }
 $CD2D LD HL,($9FE7)   ; {Read the saved pointer.
 $CD30 LD ($9FE7),IX   ; }
 $CD34 LD (IX-$02),L   ; Store the low byte of the pointer in the previous
                       ; record.
 $CD37 LD (IX-$01),H   ; Store the high byte of the pointer in the previous
                       ; record.
 $CD3A LD A,($A036)    ; {Write *#R$A036 to *#REGix+#N$00.
 $CD3D LD (IX+$00),A   ; }
 $CD40 POP AF          ; Restore #REGaf from the stack.
 $CD41 LD (IX+$01),A   ; {Store #REGa at offset #N$01 and jump to #R$CE8F.
 $CD44 JP $CE8F        ; }
; Handles pop Stack.
@label=DispatchCharacterScript_Pop
*$CD47 LD B,(IX+$01)   ; {Use the character list pointer at #R$9FE9.
 $CD4A LD IX,$9FE9     ; }
@label=DispatchCharacterScript_Loop
*$CD4E CALL $A0F7      ; {Go to #R$CEB8 if the object pointer is zero.
 $CD51 JP Z,$CEB8      ; }
 $CD54 LD A,($A036)    ; {Jump back to #R$CD4E while this id does not match the
 $CD57 CP (IX+$01)     ; moved marker.
 $CD5A JR NZ,$CD4E     ; }
 $CD5C LD A,B          ; {Jump back to #R$CD4E while this id does not match the
 $CD5D CP (IX+$00)     ; record's flag byte.
 $CD60 JR NZ,$CD4E     ; }
 $CD62 PUSH IY         ; Save the schedule entry.
 $CD64 PUSH IX         ; {Copy the character record from #REGix into #REGde.
 $CD66 POP DE          ; }
 $CD67 LD IY,$9FE7     ; Use the saved pointer (#R$9FE7).
; Step pointer and compare.
 $CD6B CALL $A104      ; Call #R$A104 to compare the pointer with the next
                       ; record.
 $CD6E LD L,(IX-$02)   ; {Read the pointer saved ahead of this record.
 $CD71 LD H,(IX-$01)   ; }
 $CD74 LD (IY-$02),L   ; Store the low byte of the pointer in the previous
                       ; record.
 $CD77 LD (IY-$01),H   ; {Store the high byte of the link and call #R$A1C7.
 $CD7A CALL $A1C7      ;
 $CD7D POP IY          ; }
 $CD7F JP $CE8F        ; Jump ahead to #R$CE8F to resume script execution.
; Sets character Script Error.
; .
; Set script completion flag.
@label=DispatchCharacterScript_MarkError
*$CD82 LD HL,$0001     ; {Write #N($0001,$04,$04) to *#R$A01F.
 $CD85 LD ($A01F),HL   ; }
 $CD88 JP $CE8F        ; Jump ahead to #R$CE8F to resume script execution.

; Terminate Character Script
;
; Used by the routines at #R$CC82 and #R$CEB8.
; .
; Ends this character's script by storing a one-cycle delay at #R$A01F and clearing the
; script state.
;
; .
;
; Set script completion flag.
@label=TerminateCharacterScript
c$CD8B LD HL,$0001   ; {Write #N($0001,$04,$04) to *#R$A01F.
 $CD8E LD ($A01F),HL ; }

; Terminate Character Script
;
; Used by the routines at #R$CC82 and #R$CE8F.
; .
; Call #R$D026 to update script pointer, and return.
c$CD91 CALL $D026    ; Call #R$D026 to update script pointer.
 $CD94 RET           ; Return.

; Print The Command Message
;
; Used by the routine at #R$CC82.
; .
; Prints the message the command names and resumes the script at #R$CE8F.
@label=PrintCommandMessage
c$CD95 LD L,(IX+$01) ; {Read the moved marker, then call #R$A59F to print the
 $CD98 LD H,(IX+$02) ; message.
 $CD9B CALL $A59F    ; }
 $CD9E JP $CE8F      ; Jump ahead to #R$CE8F to resume script execution.

; Show The Room Description
;
; Used by the routine at #R$CC82.
; .
; Resolves the room the command names, prints its description, and resumes the
; script.
;
; IX Script pointer
@label=ShowRoomDescription
c$CDA1 LD L,(IX+$02) ; {Read the location and read the action flags.
 $CDA4 LD H,(IX+$03) ;
 $CDA7 PUSH HL       ; }
 $CDA8 LD A,(IX+$01) ; {Read the moved marker, then call #R$CEDE to resolve the
 $CDAB CALL $CEDE    ; room display parameter.}
 $CDAE LD ($A034),A  ; {Record the room display parameter and write #N$07 to
 $CDB1 LD A,$07      ; the display mode.
 $CDB3 LD ($A00F),A  ; }
 $CDB6 LD HL,$6830   ; {Take the message, then call #R$A59F to print the
 $CDB9 CALL $A59F    ; message.}
 $CDBC JP $CE8F      ; Jump ahead to #R$CE8F to resume script execution.

; Record The Result In The Room Display
;
; Used by the routine at #R$CC82.
; .
; Writes #N$2E to the saved character and resolves the room display parameters.
c$CDBF LD A,$2E        ; {Write #N$2E to the saved character.
 $CDC1 LD ($A033),A    ; }
 $CDC4 LD A,(IX+$01)   ; {Read the moved marker, then call #R$CEDE to resolve
 $CDC7 CALL $CEDE      ; the room display parameter.}
 $CDCA LD ($A034),A    ; {Record the room display parameter.
 $CDCD LD A,(IX+$02)   ; }
 $CDD0 LD ($A35D),A    ; Store it in the saved object field at #R$A35D.
 $CDD3 LD A,(IX+$03)   ; {Read the action flags, then call #R$CEDE to resolve
 $CDD6 CALL $CEDE      ; the room display parameter.}
 $CDD9 LD ($A35E),A    ; Store it in the saved object field at #R$A35E.
 $CDDC LD A,(IX+$04)   ; {Read the attribute type, then call #R$CEDE to resolve
 $CDDF CALL $CEDE      ; the room display parameter.}
 $CDE2 LD ($A35F),A    ; Store it in the saved object field at #R$A35F.
 $CDE5 LD A,$08        ; {Take #N$08, then call #R$A11C to allocate memory.
 $CDE7 CALL $A11C      ; }
 $CDEA LD A,($A034)    ; {Store the record's flag byte.
 $CDED LD (IX+$00),A   ; }
 $CDF0 LD (IX+$01),$FF ; Mark the object as moved.
 $CDF4 LD A,($A35D)    ; {Store the location.
 $CDF7 LD (IX+$02),A   ; }
 $CDFA LD HL,($A35E)   ; Read the saved object fields at #R$A35E.
 $CDFD LD (IX+$03),L   ; {Store it in the action flags and store it in the
 $CE00 LD (IX+$04),H   ; attribute type.}
 $CE03 LD HL,($9FEE)   ; Read the link pointer.
 $CE06 LD ($9FEE),IX   ; {Store the low byte of the pointer in the previous
 $CE0A LD (IX-$02),L   ; display entry.}
 $CE0D LD (IX-$01),H   ; Store the high byte of the pointer in the previous
                       ; display entry.
 $CE10 LD HL,$682A     ; {Take the prompt message, then call #R$A59F to print
 $CE13 CALL $A59F      ; the prompt message.}
 $CE16 JR $CE8F        ; Jump ahead to #R$CE8F to resume script execution.

; Read The Character's Room
;
; Used by the routine at #R$CC82.
; .
; Copies this character's room display into the saved parameters.
c$CE18 LD A,(IX+$01) ; {Read the moved marker, then call #R$CEDE to resolve the
 $CE1B CALL $CEDE    ; room display parameter.}
 $CE1E LD ($A033),A  ; Record the saved character.
 $CE21 LD A,(IX+$02) ; {Call #R$CEDE to resolve the room-display parameter.
 $CE24 CALL $CEDE    ; }
 $CE27 LD ($A034),A  ; Record the room display parameter.
 $CE2A LD A,(IX+$03) ; {Read the action flags, then call #R$CEDE to resolve the
 $CE2D CALL $CEDE    ; room display parameter.}
 $CE30 LD ($A035),A  ; {Store it in the room graphics parameter, then call #R$C4D1 to run display
 $CE33 CALL $C4D1    ; action.}
 $CE36 RET C         ; Return if the display record has bit 7 set, so the
                     ; script resumes.
 $CE37 JR Z,$CEB8    ; Go to #R$CEB8 if the display action matched.
 $CE39 JR $CE8F      ; Jump ahead to #R$CE8F to resume script execution.

; Handle Room Display
;
; Used by the routine at #R$CC82.
; .
; Reads the room display parameter and the room graphics parameter from the character
; record and stores them for the room refresh.
@label=HandleRoomDisplay
c$CE3B LD A,(IX+$03) ; Get the room display parameter.
; Process room display parameter.
 $CE3E CALL $CEDE    ; Call #R$CEDE to turn the room-display parameter into a
                     ; room or a character.
 $CE41 LD ($A034),A  ; Write the room display parameter to *#R$A034.
 $CE44 LD A,(IX+$04) ; Get the room graphics parameter.
; Process room display parameter.
 $CE47 CALL $CEDE    ; Call #R$CEDE to turn the room-graphics parameter into a
                     ; room or a character.
 $CE4A LD ($A035),A  ; Write the room graphics parameter to *#R$A035.
 $CE4D JR $CE57      ; Jump to #R$CE57, the show room description.

; Clear Room Display Parameters
;
; Used by the routine at #R$CC82.
; .
; Writes #N$FF over the room display parameters.
@label=ClearRoomDisplayParameters
c$CE4F LD A,$FF      ; {Write #N$FF to #LIST { *#R$A034 } { *#R$A035 } LIST#.
 $CE51 LD ($A034),A  ;
 $CE54 LD ($A035),A  ; }

; Read The Character's Room
;
; Used by the routine at #R$CE3B.
; .
; Marks the saved character as finished and returns when the room description
; does not fit.
;
; .
;
; Set the room description marker.
@label=ReadCharactersRoom
c$CE57 LD A,$FF      ; {Write #N$FF to the saved character.
 $CE59 LD ($A033),A  ; }
 $CE5C LD L,(IX+$01) ; {Read the room description address.
 $CE5F LD H,(IX+$02) ; }
 $CE62 CALL $C591    ; {Return if the display record has bit 7 set, so the
 $CE65 RET C         ; script resumes.}
 $CE66 JR Z,$CEB8    ; Go to #R$CEB8 if the room description matched.
 $CE68 JR $CE8F      ; Jump ahead to #R$CE8F to resume script execution.

; Run A Simple Action
;
; Used by the routine at #R$CC82.
; .
; Turns the command's parameter into a character, clears both room parameters,
; and runs the display action.
@label=RunSimpleAction
c$CE6A LD A,(IX+$01) ; {Read the command's parameter and call #R$CEDE to turn a special value into a room or
 $CE6D CALL $CEDE    ; a character.}
 $CE70 LD ($A033),A  ; Record the saved character.
 $CE73 LD A,$FF      ; {Write #N$FF to #LIST { *#R$A034 } { *#R$A035 } LIST#.
 $CE75 LD ($A034),A  ;
 $CE78 LD ($A035),A  ; }
; The display record has bit 7 set, so the script resumes.
 $CE7B CALL $C4D1    ; {Return if the display record has bit 7 set, so the
 $CE7E RET C         ; script resumes.}
 $CE7F JR Z,$CEB8    ; Go to #R$CEB8 if the display action matched.
 $CE81 JR $CE8F      ; Jump ahead to #R$CE8F to resume script execution.

; Get Current Script State
;
; Used by the routines at #R$CE8F and #R$CEB8.
; .
; Points at the script step now running and returns its first byte.
@label=GetCurrentScriptState
c$CE83 LD IY,($9FDB) ; {Read the current character timetable pointer and the
 $CE87 LD HL,($9FD9) ; current character command position.}
 $CE8A PUSH HL       ; {Copy the command position from #REGhl into #REGix.
 $CE8B POP IX        ; }
 $CE8D LD A,(HL)     ; Get the current command byte.
 $CE8E RET           ; Return.

; Continue Script Execution
;
; Used by the routines at #R$CC82, #R$CD95, #R$CDA1, #R$CDBF, #R$CE18, #R$CE57
; and #R$CE6A.
; .
; Resumes the character script after a command returns, and follows the script pointer
; when the record flag says to.
@label=ContinueScriptExecution
c$CE8F CALL $CE83     ; {Call #R$CE83 to get current script state, then call #R$CF03 to advance script
 $CE92 CALL $CF03     ; pointer by command size.}
 $CE95 BIT 7,(IX+$00) ; {Jump to #R$CEA1 if a marker on the record's flag byte
 $CE99 JR Z,$CEA1     ; is clear.}
 $CE9B LD E,(HL)      ; {Read the word at #REGhl and join the flag test at
 $CE9C INC HL         ; #R$CEA8.
 $CE9D LD D,(HL)      ;
 $CE9E EX DE,HL       ;
 $CE9F JR $CEA8       ; }
; See whether bit 4 of the record flag is set, then see whether bit 5 of the
; record flag is set, then store that byte in the script position.
@label=ContinueScriptExecution_Next
*$CEA1 BIT 4,(IX+$00) ; {If bit 4 of the command byte is set, call #R$CF40 to
 $CEA5 CALL NZ,$CF40  ; skip its two-byte address.}
@label=ContinueScriptExecution_TestClearScriptCommand
*$CEA8 BIT 5,(IX+$00) ; {Call #R$CF43 to clear script command flags if a marker on the record's flag byte
 $CEAC CALL NZ,$CF43  ; is set.}
 $CEAF LD (IY+$01),L  ; {Store #REGhl at #REGiy+#N$01 and jump back to #R$CD91
 $CEB2 LD (IY+$02),H  ; to finish the character script.
 $CEB5 JP $CD91       ; }

; Process Script Command With Counter
;
; Used by the routines at #R$CC82, #R$CE18, #R$CE57 and #R$CE6A.
; .
; Processes a character script command, tracking how many commands have been
; executed. If the counter limit is reached, the script is terminated.
;
; A Counter value (maximum number of commands to process)
@label=ProcessScriptCommandWithCounter
c$CEB8 LD HL,$CC0B    ; {Increment the script command counter.
 $CEBB INC (HL)       ; }
 $CEBC CALL $CE83     ; Get the current script state (command byte and
                      ; position).
 $CEBF CALL $CEFE     ; Call #R$CEFE to advance past this script command.
 $CEC2 BIT 4,(IX+$00) ; {Jump to #R$CECC if a marker on the record's flag byte
 $CEC6 JR Z,$CECC     ; is clear.}
 $CEC8 LD E,(HL)      ; {Read the command's address into #REGhl.
 $CEC9 INC HL         ;
 $CECA LD D,(HL)      ;
 $CECB EX DE,HL       ; }
@label=ProcessScriptCommandWithCounter_UpdatePosition
*$CECC LD (IY+$01),L  ; Update the character's script position pointer
                      ; (#REGiy+#N$01/#N$02).
 $CECF LD (IY+$02),H  ; Store #REGh at #REGiy+#N$02.
 $CED2 PUSH IX        ; {Calculate how many bytes have been processed in the
 $CED4 POP DE         ; script (#REGhl-#REGix).
 $CED5 AND A          ;
 $CED6 SBC HL,DE      ; }
 $CED8 JP Z,$CD8B     ; Go to #R$CD8B if the subtraction comes out at zero.
 $CEDB JP $CC82       ; Another command remains, so parse it from #R$CC82.

; Process Room Display Parameter
;
; Used by the routines at #R$B936, #R$CDA1, #R$CDBF, #R$CE18, #R$CE3B and
; #R$CE6A.
; .
; Resolves special parameter values used in room display scripts to actual game
; values (current room, character ID, location value).
;
;   A Parameter value (#N$F5-#N$FD are special values)
; O:A Resolved parameter value
@label=ProcessRoomDisplayParameter
c$CEDE CP $F5        ; {Return unchanged if the parameter is not a special
 $CEE0 RET C         ; value (less than #N$F5).}
 $CEE1 CP $FE        ; {Return unchanged when the parameter is at least #N$FE.
 $CEE3 RET NC        ; }
 $CEE4 CP $FA        ; {Jump ahead to #R$CEEC if the room is not #N$FA.
 $CEE6 JR NZ,$CEEC   ; }
 $CEE8 LD A,($9FD6)  ; Read the room id at #R$9FD6 into #REGa.
 $CEEB RET           ; Return.
; A parameter of #N$FB is the character being processed.
@label=ProcessRoomDisplayParameter_CheckCharacterID
*$CEEC CP $FB        ; {Go to #R$CEF4 when the parameter is not the current
 $CEEE JR NZ,$CEF4   ; character (#N$FB).}
 $CEF0 LD A,($A036)  ; Load the character being processed.
 $CEF3 RET           ; Return.
; A parameter of #N$FC is the high byte of the location value.
@label=ProcessRoomDisplayParameter_GetLocationValue
*$CEF4 CP $FC        ; {Compare the parameter with #N$FC and load the high byte
 $CEF6 LD A,($9FD8)  ; of the location value at #R$9FD7.}
 $CEF9 RET Z         ; Return if it is #N$FC.
 $CEFA LD A,($9FD7)  ; Read the location value at #R$9FD7.
 $CEFD RET           ; Return.

; Advance Script Pointer By Command Size
;
; Used by the routine at #R$CEB8.
; .
; Advances the script pointer past a command byte by the appropriate number of
; bytes based on the command type. Different command types have different data
; sizes, so the pointer must be advanced accordingly.
;
;   A Command byte
; O:HL Updated script pointer
;
; Extended commands (bit 7 set) require an extra 2-byte advance before the
; normal command type advance.
@label=AdvanceScriptPointerByCommandSize
c$CEFE BIT 7,A       ; {If bit 7 of the command is set, call #R$CF40 to step
 $CF00 CALL NZ,$CF40 ; past its two-byte address.}

; Advance By Command Type
;
; Used by the routine at #R$CE8F.
; .
; Advances the script pointer by the size of this command type.
@label=AdvanceByCommandType
c$CF03 AND %00001111 ; Extract the command type (bits 0-3).
; Route to the appropriate handler based on command type to advance the script
; pointer by the correct number of bytes.
 $CF05 CP $0F        ; {Jump ahead to #R$CF41 if the command is #N$0F.
 $CF07 JR Z,$CF41    ; }
 $CF09 CP $08        ; {Jump ahead to #R$CF40 if the command is #N$08.
 $CF0B JR Z,$CF40    ; }
 $CF0D CP $09        ; {Jump ahead to #R$CF40 if the command is #N$09.
 $CF0F JR Z,$CF40    ; }
 $CF11 CP $01        ; {Jump ahead to #R$CF40 if the command is #N$01.
 $CF13 JR Z,$CF40    ; }
 $CF15 CP $02        ; {Jump ahead to #R$CF3E if the command is #N$02.
 $CF17 JR Z,$CF3E    ; }
 $CF19 CP $03        ; {Jump ahead to #R$CF3F if the command is #N$03.
 $CF1B JR Z,$CF3F    ; }
 $CF1D CP $0D        ; {Jump ahead to #R$CF40 if the command is #N$0D.
 $CF1F JR Z,$CF40    ; }
 $CF21 CP $0E        ; {Jump ahead to #R$CF3F if the command is #N$0E.
 $CF23 JR Z,$CF3F    ; }
 $CF25 CP $07        ; {Jump ahead to #R$CF3D if the command is #N$07.
 $CF27 JR Z,$CF3D    ; }
 $CF29 CP $0C        ; {Jump ahead to #R$CF3D if the command is #N$0C.
 $CF2B JR Z,$CF3D    ; }
 $CF2D CP $0B        ; {Jump ahead to #R$CF41 if the command is #N$0B.
 $CF2F JR Z,$CF41    ; }
 $CF31 CP $0A        ; {Jump ahead to #R$CF41 if the command is #N$0A.
 $CF33 JR Z,$CF41    ; }
 $CF35 CP $05        ; {Jump ahead to #R$CF3E if the command is #N$05.
 $CF37 JR Z,$CF3E    ; }
 $CF39 CP $04        ; {Jump ahead to #R$CF3F if the command is not #N$04.
 $CF3B JR NZ,$CF3F   ; }
@label=AdvanceByCommandType_AdvanceFive
*$CF3D INC HL        ; Step to the next entry.
@label=AdvanceByCommandType_AdvanceFour
*$CF3E INC HL        ; Step to the next entry.
@label=AdvanceByCommandType_AdvanceThree
*$CF3F INC HL        ; Step to the next entry.

; Step To The Next Byte
;
; Used by the routines at #R$CE8F, #R$CEFE and #R$CF03.
; .
; Moves the script pointer on by one byte of the current command.
@label=StepNextByte
c$CF40 INC HL        ; Step to the next entry.
; This entry point is used by the routine at #R$CF03.
@label=StepNextByte_AdvanceOne
*$CF41 INC HL        ; Step one byte further along the script command.
 $CF42 RET           ; Return.

; Clear Script Command Flags
;
; Used by the routine at #R$CE8F.
; .
; Clears flag bytes in a script command based on the command type and flag
; bits. Different command types require clearing different numbers of flag
; bytes to mark them as processed.
;
; IX Pointer to script command data
@label=ClearScriptCommandFlags
c$CF43 LD A,(IX+$00) ; Read the command flag byte.
; Clear the first flag byte if certain flag bits are set, indicating those
; conditions have been processed.
 $CF46 BIT 7,A       ; {If bit 7 of the command is set, call #R$CF73 to clear
 $CF48 CALL NZ,$CF73 ; one flag byte.}
 $CF4B BIT 4,A       ; {If bit 4 of the command is set, call #R$CF73 to clear
 $CF4D CALL NZ,$CF73 ; one flag byte.}
 $CF50 AND %00001111 ; Extract the command type (bits 0-3).
; Route to the appropriate handler based on command type to clear the required
; number of flag bytes.
 $CF52 CP $01        ; {Go to #R$CF73 when the command is #N$01.
 $CF54 JR Z,$CF73    ; }
 $CF56 CP $02        ; {Go to #R$CF6B when the command is #N$02.
 $CF58 JR Z,$CF6B    ; }
 $CF5A CP $05        ; {Go to #R$CF6B when the command is #N$05.
 $CF5C JR Z,$CF6B    ; }
 $CF5E CP $07        ; {Go to #R$CF68 when the command is #N$07.
 $CF60 JR Z,$CF68    ; }
 $CF62 CP $06        ; {Go to #R$CF70 when the command is #N$06.
 $CF64 JR Z,$CF70    ; }
 $CF66 CP $04        ; Compare the command with #N$04.
@label=ClearScriptCommandFlags_ClearOne
*$CF68 CALL Z,$CF79  ; Call #R$CF79 if the command is #N$04 or #N$07.
@label=ClearScriptCommandFlags_ClearTwo
*$CF6B CALL Z,$CF73  ; Call #R$CF73 if the command is #N$02, #N$04, #N$05 or
                     ; #N$07.
 $CF6E CP $03        ; See whether the command type is #N$03.
@label=ClearScriptCommandFlags_ClearOneAlt
*$CF70 CALL Z,$CF79  ; Call #R$CF79 if the command is #N$03 or #N$06.

; Clear The Record Flag
;
; Used by the routine at #R$CF43.
; .
; Clear the record flag, then step to the next field of the character record
@label=ClearScriptCommandFlags_ClearFirst
c$CF73 LD (IX+$00),$00 ; Clear the first flag byte.
 $CF77 INC IX          ; Step to the next flag byte of the script command.

; Clear The Record Flag
;
; Used by the routine at #R$CF43.
; .
; Clear the record flag, then step to the next field of the character record.
@label=ClearScriptCommandFlags_ClearSecond
c$CF79 LD (IX+$00),$00 ; Clear the second flag byte.
 $CF7D INC IX          ; Step to the next field of the character record.
 $CF7F RET             ; Return.

; Allocate Memory And Store Character
;
; Used by the routines at #R$C996 and #R$E2EE.
; .
; Creates a new character entry in the character tracking system and adds it to
; the active character list, storing the character's current state for game
; logic purposes.
;
; HL Character location co-ordinates
; B Character attribute value
@label=AllocateMemoryAndStoreCharacter
c$CF80 PUSH IX       ; {Allocate #N$07 bytes of memory for the character entry, keeping character
 $CF82 LD A,$07      ; record.}
; Allocate memory.
 $CF84 CALL $A11C    ; Call #R$A11C to allocate the character entry.
 $CF87 LD A,($A036)  ; {Store *#R$A036 in the entry.
 $CF8A LD (IX+$00),A ; }
 $CF8D LD (IX+$01),L ; {Store the character's location co-ordinates in the
 $CF90 LD (IX+$02),H ; entry.}
 $CF93 LD DE,($A034) ; {Store *#R$A034 in the entry.
 $CF97 LD (IX+$03),E ;
 $CF9A LD (IX+$04),D ; }
@label=AllocateMemoryAndStoreCharacter_StoreAttribute
 $CF9D LD (IX+$05),B ; Store it in the object attribute.
 $CFA0 LD A,($9FD6)  ; {Store *#R$9FD6 in the entry.
 $CFA3 LD (IX+$06),A ; }
 $CFA6 LD HL,($9FE9) ; Get the current head of *#R$9FE9.
 $CFA9 LD ($9FE9),IX ; Add this character entry to the front of the active
                     ; character list.
 $CFAD LD (IX-$02),L ; {Set up the backward link to maintain the list
 $CFB0 LD (IX-$01),H ; structure.}
 $CFB3 POP IX        ; Restore the saved character record from the stack.
 $CFB5 RET           ; Return.

; Find Character Script Entry
;
; Used by the routines at #R$9B25, #R$CC82, #R$CFCF, #R$D008, #R$D026, #R$E03A,
; #R$E3A9, #R$E6EA and #R$E710.
; .
; Searches through the character script entry list to find an entry matching
; the current character ID. Returns the entry pointer if found, otherwise
; returns #N$00.
;
; O:IX Character script entry pointer (if found)
; O:A #N$00 if not found, bit 0 set if found
@label=FindCharacterScriptEntry
c$CFB6 LD A,($A036)  ; Read the current character.

; Walk The Character Script Entries
;
; Used by the routine at #R$E28D.
; .
; Starts at the first character-script entry and follows each link until this
; character is found.
@label=FindCharacterScriptEntry_StartSearch
c$CFB9 LD IX,$9FEB   ; Use the character script entry list at #R$9FEB.
@label=FindCharacterScriptEntry_Loop
*$CFBD PUSH AF       ; {Keep the character being processed, then call #R$A0F7 to fetch object
 $CFBE CALL $A0F7    ; pointer from stack.}
 $CFC1 JR Z,$CFCC    ; {Go to #R$CFCC if the object pointer is zero.
 $CFC3 POP AF        ; }
 $CFC4 CP (IX+$00)   ; {Go to #R$CFBD if this entry is not the character being
 $CFC7 JR NZ,$CFBD   ; processed.}
 $CFC9 OR %00000001  ; Mark that the entry was found.
 $CFCB RET           ; Return with the entry pointer.
; No matching entry was found in the list.
@label=FindCharacterScriptEntry_NotFound
*$CFCC POP AF        ; Restore the caller's registers from the stack.
 $CFCD XOR A         ; Set #N$00 (entry not found).
 $CFCE RET           ; Return.

; Get Script Pointer
;
; Used by the routine at #R$CC82.
; .
; Copies the next script address into the current step and into the timetable
; link.
;
; .
;
; Find character script entry.
@label=GetScriptPointer
c$CFCF CALL $CFB6    ; Call #R$CFB6 to find this character's script entry.
 $CFD2 LD E,(IX+$01) ; {Read the script address from the entry.
 $CFD5 LD D,(IX+$02) ; }
 $CFD8 LD ($9FD9),DE ; Record the current character command position.
 $CFDC LD (IY+$01),E ; {Store #REGde at #REGiy+#N$01-#N$02 and keep the record.
 $CFDF LD (IY+$02),D ;
 $CFE2 PUSH IX       ; }
 $CFE4 POP DE        ; {Call #R$A104 to step pointer and compare.
 $CFE5 PUSH IY       ;
 $CFE7 LD IY,$9FE9   ;
 $CFEB CALL $A104    ; }
 $CFEE LD L,(IX-$02) ; {Read the pointer saved ahead of this record.
 $CFF1 LD H,(IX-$01) ; }
 $CFF4 LD (IY-$02),L ; Store the low byte of the pointer in the previous
                     ; record.
 $CFF7 LD (IY-$01),H ; {Store it in the schedule entry and read the object attribute, then call
 $CFFA LD A,(IX+$05) ; #R$A1C7 to run memory entry.
 $CFFD PUSH AF       ;
 $CFFE CALL $A1C7    ; }
 $D001 CALL $D008    ; {Call #R$D008 to take the next script from the
 $D004 POP AF        ; timetable.
 $D005 POP IY        ; }
 $D007 RET           ; Return.

; Get Script Pointer From Timetable
;
; Used by the routines at #R$CC78 and #R$CFCF.
; .
; Takes the script address from the timetable, or from the matching entry when
; one exists.
@label=GetScriptPointerFromTimetable
c$D008 LD L,(IY+$04) ; {Call #R$CFB6 to find character script entry.
 $D00B LD H,(IY+$05) ;
 $D00E CALL $CFB6    ; }
 $D011 LD A,(IY+$03) ; {Load the byte at #REGiy+#N$03 and jump to #R$D01F if
 $D014 JR Z,$D01F    ; #R$CFB6 found no script entry.}
 $D016 LD L,(IX+$03) ; {Read the action flags.
 $D019 LD H,(IX+$04) ; }
 $D01C LD A,(IX+$06) ; Read the room at #REGix+#N$06.
@label=GetScriptPointerFromTimetable_Next
*$D01F LD ($9FD6),A  ; Record the current room.
 $D022 LD ($9FD7),HL ; Record the location value.
 $D025 RET           ; Return.

; Update Script Pointer
;
; Used by the routine at #R$CD91.
; .
; Finds the script entry for the current character and stores it in the
; timetable.
@label=UpdateScriptPointer
c$D026 LD HL,($9FD7) ; {Call #R$CFB6 to find character script entry.
 $D029 CALL $CFB6    ; }
 $D02C LD A,($9FD6)  ; {Read the current room, and go to #R$D03B if #R$CFB6
 $D02F JR Z,$D03B    ; found no matching entry.}
 $D031 LD (IX+$03),L ; {Store the script pointer in the timetable entry
 $D034 LD (IX+$04),H ; (+#N$03/+#N$04).}
 $D037 LD (IX+$06),A ; Store the current room at offset #N$06.
 $D03A RET           ; Return.
; Store it in the schedule field, then store that byte in the schedule field
@label=UpdateScriptPointer_Next
*$D03B LD (IY+$03),A ; {Store the schedule entry.
 $D03E LD (IY+$04),L ; }
 $D041 LD (IY+$05),H ; Store the schedule entry.
 $D044 RET           ; Return.

; Is Sherlock Wearing The China Man Disguise?
;
; Used by the routine at #R$CC5A.
; .
; Looks up the object recorded for Sherlock and stores the room that object
; reports.
;
; .
;
; Sherlocks character ID can vary depending on whether he is wearing a
; disguise or not.
@label=IsSherlockTheChinaMan
c$D045 LD A,($9860)  ; Fetch Sherlocks current character ID from *#R$9860.
 $D048 CALL $D495    ; {Record Sherlock's disguise.
 $D04B LD ($A009),A  ; }
 $D04E RET           ; Return.

; Adjust Object Table For Sum
;
; Used by the routines at #R$B34F, #R$B36B, #R$B517, #R$BDC2, #R$D249, #R$D4CC
; and #R$D526.
; .
; Points the object walk at the object index at #R$8B6F, one record before the first
; entry.
@label=AdjustObjectTableForSum
c$D04F LD IX,$8B6F   ; Use the objects at #R$8B6F.
 $D053 DEC IX        ; Step back one field of the character record.
 $D055 DEC IX        ; Step back one field of the character record.
 $D057 DEC IX        ; Step back one field of the character record.
 $D059 RET           ; Return.

; Table: Tokens
;
; Tokens read by #R$D0DD.
@label=Table_Tokens
g$D05A DEFW $0624    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $D05C DEFW $0466    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $D05E DEFW $0450    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $D060 DEFW $05FF    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $D062 DEFW $009A    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".

; Table: Direction Tokens
;
; Direction Tokens read by #R$D5FB.
@label=Table_DirectionTokens
g$D064 DEFW $05C3    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $D066 DEFW $081A    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $D068 DEFW $0284    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $D06A DEFW $0992    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $D06C DEFW $05C7    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $D06E DEFW $05D0    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $D070 DEFW $081E    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $D072 DEFW $0827    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $D074 DEFW $093C    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".
 $D076 DEFW $0272    ; "#R($5DBF+(#PEEK(#PC+$01)*$0100+#PEEK(#PC)))(#TOKENPTR)".

; Check Object Visibility
;
; Used by the routines at #R$A2E4, #R$C9BF and #R$D1B2.
; .
; Sets the carry when the current character is visible and a matching object is
; found. Returns with the carry clear when the character is not visible.
;
; O:F Carry flag set if object is visible
@label=CheckObjectVisibility
c$D078 PUSH IX        ; {Save the character record, the schedule entry and the
 $D07A PUSH IY        ; count.
 $D07C PUSH BC        ; }
 $D07D LD IX,($A017)  ; Read the current character record.
 $D081 LD A,(IX+$04)  ; Read the attribute type.
 $D084 AND %10000000  ; Keep only bit 7.
 $D086 JR Z,$D0C6     ; Skip the object when bit 7 is clear, so it is not
                      ; visible.
 $D088 CALL $C86E     ; {Go to #R$D09E unless #R$C86E returned #N$FF.
 $D08B INC A          ;
 $D08C JR NZ,$D09E    ; }
; Fetch current character location.
 $D08E CALL $D33C     ; Call #R$D33C to read where the current character is.
 $D091 BIT 7,(IX+$00) ; {Jump to #R$D0C6 if a marker on the record's flag byte
 $D095 JR NZ,$D0C6    ; is set.}
 $D097 CALL $C00C     ; {Go to #R$D0C6 if it is not #N$01.
 $D09A CP $01         ;
 $D09C JR NZ,$D0C6    ; }
; It's late night/ evening (8 PM - 5 AM).
@label=CheckObjectVisibility_Next
*$D09E LD IX,$8B6F    ; Use the objects at #R$8B6F.
@label=CheckObjectVisibility_Loop
*$D0A2 CALL $D206     ; {Go to #R$D0C9 if the next object id is #N$FF.
 $D0A5 JR Z,$D0C9     ; }
 $D0A7 LD A,(IY+$00)  ; {Jump to #R$D0A2 if the character id is not #N$01.
 $D0AA CP $01         ;
 $D0AC JR NZ,$D0A2    ; }
 $D0AE LD A,(IY+$05)  ; Read the schedule entry.
 $D0B1 XOR %10110111  ; {Jump back to #R$D0A2 unless bits 2 and 4 of the
 $D0B3 AND %01011100  ; schedule entry are set and bits 3 and 6 are clear.
 $D0B5 JR NZ,$D0A2    ; }
 $D0B7 LD A,(IY+$04)  ; Read the schedule entry.
 $D0BA AND %10000000  ; Keep only bit 7.
 $D0BC JR Z,$D0A2     ; Go back and test the next object when bit 7 is clear.
 $D0BE LD A,(IX+$00)  ; {Jump back to #R$D0A2 while the object is not in this
 $D0C1 CALL $C821     ; location.
 $D0C4 JR Z,$D0A2     ; }
@label=CheckObjectVisibility_TestObjectVisibility
*$D0C6 AND A          ; {Clear the carry and jump ahead to #R$D0CA.
 $D0C7 JR $D0CA       ; }
; The condition holds, so the caller continues.
@label=CheckObjectVisibility_ConditionHoldsCaller
*$D0C9 SCF            ; Set the carry.
@label=CheckObjectVisibility_BringSavedCount
*$D0CA POP BC         ; {Restore the saved count, the saved schedule entry and
 $D0CB POP IY         ; the saved character record from the stack.
 $D0CD POP IX         ; }
 $D0CF RET            ; Return.

; Write Token To Buffer
;
; Used by the routines at #R$D0DD and #R$D113.
; .
; Writes the current text token into the message pointer at #R$68DE, with the top bit set
; so the printer treats it as a token.
;
; HL Pointer to output buffer
; DE Token value (word)
@label=WriteTokenToBuffer
c$D0D0 PUSH DE       ; {Use the text pointer (#R$68DE).
 $D0D1 LD DE,$68DE   ;
 $D0D4 EX DE,HL      ;
 $D0D5 SET 7,D       ;
 $D0D7 LD (HL),D     ; }
 $D0D8 INC HL        ; Advance through the text.
 $D0D9 LD (HL),E     ; Store that byte at the pointer.
 $D0DA POP DE        ; Restore #REGde from the stack.
 $D0DB RET           ; Return.

; Location Token Processing Flag
;
; Flag that enables location token processing in ProcessLocationToken.
; When set to #N$01, location token data is processed and when #N$00, processing is skipped.
; Read by #R$D0DD and #R$DBF7.
@label=LocationTokenProcessingFlag
g$D0DC DEFB $00

; Process Location Token
;
; Used by the routines at #R$D102 and #R$D1B2.
; .
; Looks the room up and, unless an exit line is already being printed, chooses the exit text from
; the room's direction bits.
;
; A Room ID
@label=ProcessLocationToken
c$D0DD PUSH AF       ; {Keep the room, then call #R$D224 to look up this room.
 $D0DE CALL $D224    ; }
 $D0E1 LD A,($D0DC)  ; {Read the location-token flag at #R$D0DC.
 $D0E4 AND A         ; }
 $D0E5 LD HL,$68E4   ; {Take the exit text and go to #R$D100 if location token
 $D0E8 JR NZ,$D100   ; processing is on.}
 $D0EA LD A,(IX+$00) ; Read the record's flag byte.
 $D0ED AND %00001110 ; Take bits 1-3 of the flag byte as an even offset into
                     ; the tokens at #R$D05A.
 $D0EF LD E,A        ; {Use the tokens at #R$D05A.
 $D0F0 LD D,$00      ;
 $D0F2 LD HL,$D05A   ;
 $D0F5 ADD HL,DE     ;
 $D0F6 LD E,(HL)     ; }
 $D0F7 INC HL        ; {Call #R$D0D0 to write token to buffer.
 $D0F8 LD D,(HL)     ;
 $D0F9 EX DE,HL      ;
 $D0FA CALL $D0D0    ; }
 $D0FD LD HL,$68DD   ; Use the message (#R$68DD).
@label=ProcessLocationToken_Next
*$D100 POP AF        ; Restore #REGaf from the stack.
 $D101 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9630 }
; LIST#

; Process Location Token Display
;
; Used by the routines at #R$CA9E and #R$DC6C.
; .
; Prints the room's exit line and restores the records it used.
;
; .
;
; Process location token.
@label=ProcessLocationTokenDisplay
c$D102 CALL $D0DD    ; Call #R$D0DD to choose the room's exit text.
 $D105 PUSH IX       ; {Save the character record, the schedule entry and the
 $D107 PUSH IY       ; count.
 $D109 PUSH BC       ; }
 $D10A CALL $D113    ; Call #R$D113 to describe the current room.
 $D10D POP BC        ; {Restore the saved count, the saved schedule entry and
 $D10E POP IY        ; the saved character record from the stack.
 $D110 POP IX        ; }
 $D112 RET           ; Return.

; Describe The Current Room
;
; Used by the routine at #R$D102.
; .
; Looks the current room up, prints its name and lists the objects that are
; here.
@label=DescribeCurrentRoom
c$D113 LD B,A        ; {Use the room as the count, then call #R$D224 to look up
 $D114 CALL $D224    ; this room.}
 $D117 LD A,B        ; {Call #R$A277 with the room in #REGa.
 $D118 CALL $A277    ; }
 $D11B PUSH IX       ; {Keep the registers, read the current character and call
 $D11D PUSH BC       ; #R$C863 to read that character's room.
 $D11E PUSH HL       ;
 $D11F LD A,($A036)  ;
 $D122 CALL $C863    ; }
 $D125 EX AF,AF'     ; {Jump ahead to #R$D167 if the room is the end marker.
 $D126 CP $FF        ;
 $D128 JR Z,$D167    ; }
 $D12A PUSH AF       ; {Save the flags, read the text pointer at #R$68DE, save
 $D12B LD HL,($68DE) ; it and point #REGhl at #N$8000.
 $D12E PUSH HL       ;
 $D12F LD HL,$8000   ; }
; Write token to buffer.
 $D132 CALL $D0D0    ; Call #R$D0D0 to write the token into the buffer.
 $D135 LD HL,$68DD   ; {Take the message, then call #R$A59F to print the
 $D138 CALL $A59F    ; message.}
 $D13B POP HL        ; {Record the text pointer.
 $D13C LD ($68DE),HL ; }
 $D13F POP AF        ; {Call #R$D237 to look up that object.
 $D140 PUSH AF       ;
 $D141 CALL $D237    ; }
; Print object attribute description.
 $D144 CALL $D5D3    ; Call #R$D5D3 to print the object's attribute text.
 $D147 CALL $D3D5    ; {Call #R$D3D5 to run object entry alternate.
 $D14A POP AF        ; }
 $D14B PUSH AF       ; {Call #R$D4CC to count objects in location.
 $D14C CALL $D4CC    ; }
 $D14F AND A         ; {Jump ahead to #R$D163 if no objects are in this room.
 $D150 JR Z,$D163    ; }
 $D152 LD C,A        ; {Store the object count and call #R$A887 to print token
 $D153 LD DE,$09BF   ; #N$09BF.
 $D156 CALL $A887    ; }
 $D159 LD A,($A00A)  ; {Pass the character attribute in #REGb.
 $D15C LD B,A        ; }
 $D15D POP AF        ; Restore the saved room from the stack.
 $D15E CALL $D51A    ; Call #R$D51A.
 $D161 JR $D167      ; The name was printed, so restore the registers from
                     ; #R$D167.
; Read the character field, then read the count.
@label=DescribeCurrentRoom_ReadCharacter
*$D163 CALL $A414    ; Call #R$A414 to print a full stop.
 $D166 POP AF        ; Restore the saved result from the stack.
@label=DescribeCurrentRoom_CharacterRecord
*$D167 POP DE        ; {Restore #REGde, #REGbc and #REGix from the stack.
 $D168 POP BC        ;
 $D169 POP IX        ; }
 $D16B LD L,(IX+$07) ; Read the character record.
 $D16E LD H,(IX+$08) ; Read the character record.
 $D171 CALL $D182    ; {Call #R$D182 to print the message and take the count,
 $D174 LD A,B        ; then call #R$D60B to list the exits.
 $D175 CALL $D60B    ; }

; Read The Count
;
; Used by the routine at #R$D1B2.
; .
; Turns the count into a direction name and prints it.
c$D178 LD A,B        ; {Take the count and call #R$D68C to print location exits with formatting, then call
 $D179 CALL $D68C    ; #R$D4A7 to list the objects here.
 $D17C CALL $D4A7    ; }
 $D17F JP $A2A2      ; Jump back to #R$A2A2 to print newline.

; Print The Set Message
;
; Used by the routine at #R$D113.
; .
; Prints the message when an address is set.
@label=PrintSetMessage
c$D182 LD A,H        ; {If a message address is set, go to #R$A59F to print it.
 $D183 OR L          ;
 $D184 JP NZ,$A59F   ; }

; Print The Location Text
;
; Used by the routine at #R$D1B2.
; .
; Prints the location message for this character and records the object
; display.
@label=PrintLocationText
c$D187 EX DE,HL      ; {Read the current character.
 $D188 LD A,($A036)  ;
 $D18B PUSH AF       ; }
 $D18C LD A,($A036)  ; {Read the current character and call #R$C863 to read
 $D18F CALL $C863    ; that character's room.}
 $D192 EX AF,AF'     ; {Jump to #R$D19F if the location from #R$C863 is #N$FF.
 $D193 INC A         ;
 $D194 JR Z,$D19F    ; }
 $D196 DEC A         ; {Record the current character.
 $D197 LD ($A036),A  ;
 $D19A LD A,$01      ; }
 $D19C LD ($A2AA),A  ; Record the object display flag.
@label=PrintLocationText_SaveResult
*$D19F CALL $A59F    ; {Call #R$A59F to print this message.
 $D1A2 POP AF        ; }
 $D1A3 LD ($A036),A  ; {Record the current character.
 $D1A6 XOR A         ; }
 $D1A7 LD ($A2AA),A  ; {Store the flag at #R$A2AA and call #R$D1C6.
 $D1AA CALL $D1C6    ; }
 $D1AD LD A,$2E      ; {Take a full stop and print it through #R$A9B7.
 $D1AF JP $A9B7      ; }

; Process Object Display With Check
;
; Used by the routines at #R$CA9E and #R$DBF7.
; .
; Prints the exit line when the direction is open, and prints the closed-way
; line otherwise.
@label=ProcessObjectDisplayWithCheck
c$D1B2 LD B,A        ; {Call #R$D0DD to expand the location token.
 $D1B3 CALL $D0DD    ; }
 $D1B6 EX DE,HL      ; {Swap the two pointers, then call #R$D187 to print the
 $D1B7 CALL $D187    ; location text.}
 $D1BA CALL $D078    ; {Jump back to #R$D178 while #R$D078 finds the object
 $D1BD JR NC,$D178   ; hidden.}
 $D1BF LD HL,$68C1   ; {Take the message, then call #R$A59F to print the
 $D1C2 CALL $A59F    ; message.}
 $D1C5 RET           ; Return.

; Record The Result In The Object Processing
;
; Used by the routine at #R$D187.
; .
; Steps to the next schedule entry and clears the object-processing flag.
c$D1C6 LD DE,$0001   ; {Take an offset of #N($0001,$04,$04) and keep #REGiy.
 $D1C9 PUSH IY       ; }
 $D1CB PUSH IX       ; {Copy the character record from #REGix into #REGiy.
 $D1CD POP IY        ; }
 $D1CF ADD IY,DE     ; {Step to the next schedule entry, start the object from
 $D1D1 XOR A         ; zero and store it in the object-processing flag, then
 $D1D2 LD ($A028),A  ; call #R$D405 to test object attribute with flag.
 $D1D5 CALL $D405    ; }
 $D1D8 POP IY        ; Restore the saved schedule entry from the stack.
 $D1DA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9686 }
; LIST#

; Jump To Handler
;
; Used by the routines at #R$BA3E and #R$BCC9.
; .
; Jumps to the handler address just looked up. Callers leave that address in
; the pointer.
@label=JumpToHandler
c$D1DB JP (HL)       ; Jump to the handler whose address the caller left in
                     ; #REGhl.

; Calculate Handler Offset
;
; Used by the routine at #R$C929.
; .
; Adds #N$0F to the record's flag byte and steps #REGix on by that many bytes.
@label=CalculateHandlerOffset
c$D1DC PUSH DE       ; {Read the record's flag byte and add #N$0F to the total.
 $D1DD LD D,A        ;
 $D1DE LD A,(IX+$00) ;
 $D1E1 ADD A,$0F     ;
 $D1E3 LD E,A        ; }
 $D1E4 LD A,D        ; {Step to the next record.
 $D1E5 LD D,$00      ;
 $D1E7 ADD IX,DE     ;
 $D1E9 POP DE        ; }
@label=CalculateHandlerOffset_Loop
*$D1EA CP (IX+$00)   ; {Jump ahead to #R$D1FF if this id matches the record's
 $D1ED JR Z,$D1FF    ; flag byte.}
 $D1EF INC (IX+$00)  ; {Jump to #R$D201 if this byte was the #N$FF end marker.
 $D1F2 JR Z,$D201    ; }
 $D1F4 DEC (IX+$00)  ; {Go to #R$D204 if stepping this byte down leaves zero.
 $D1F7 JR Z,$D204    ; }
 $D1F9 INC IX        ; {Skip this handler and try the next one.
 $D1FB INC IX        ;
 $D1FD JR $D1EA      ; }
; The condition holds, so the caller continues.
@label=CalculateHandlerOffset_Next
*$D1FF SCF           ; Mark the condition as met.
 $D200 RET           ; Return.
@label=CalculateHandlerOffset_TestSignalStepFailed
*$D201 DEC (IX+$00)  ; Restore the end marker.
*$D204 XOR A         ; Clear #REGa.
 $D205 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9B81 }
; LIST#

; Fetch Next Object
;
; Used by the routines at #R$D078, #R$D21C, #R$D36A, #R$D448, #R$D474 and
; #R$D4CC.
; .
; Steps to the next object in the list and reports whether the list has ended.
;
;   IX Pointer to objects table
; O:IX Pointer to object table
; O:IY Pointer to object data
; O:F The zero flag is set if the end of the table is reached
@label=FetchNextObject
c$D206 EXX           ; Switch to the shadow registers.
 $D207 LD DE,$0003   ; {Step to the next object record.
 $D20A ADD IX,DE     ; }
 $D20C LD D,(IX+$02) ; {Read the next object's data pointer.
 $D20F LD E,(IX+$01) ;
 $D212 PUSH DE       ;
 $D213 POP IY        ; }
 $D215 LD A,(IX+$00) ; {Stop at the end of the object table (#N$FF).
 $D218 CP $FF        ; }
 $D21A EXX           ; Switch back to the normal registers.
 $D21B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9B93 }
; LIST#

; Fetch Next Object With ID
;
; Used by the routines at #R$D249, #R$D305 and #R$D57D.
; .
; Keeps the id and steps to the next object.
;
;   A Object ID to search for
; O:A Object ID that was searched for
; O:F Zero flag set when there is no further object
@label=FetchNextObjectWithID
c$D21C PUSH BC       ; {Call #R$D206 to fetch next object.
 $D21D LD B,A        ;
 $D21E CALL $D206    ; }
 $D221 LD A,B        ; Read the count.
 $D222 POP BC        ; Restore #REGbc from the stack.
 $D223 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9BA9 }
; LIST#

; Fetch Location Data Pointer
;
; Used by the routines at #R$9AA3, #R$9DFF, #R$A4AB, #R$C628, #R$C6BE, #R$C8EF,
; #R$D0DD, #R$D113, #R$D33C, #R$D39B, #R$D5EF, #R$DD0E and #R$E3F5.
; .
; Turns a room id into the address of that room's data.
;
;   A Room ID
; O:IX Pointer to location data
@label=FetchLocationDataPointer
c$D224 PUSH DE       ; {Use the locations at #R$840B.
 $D225 LD DE,$840B   ;
 $D228 PUSH HL       ;
 $D229 LD L,A        ;
 $D22A LD H,$00      ; }
 $D22C ADD HL,HL     ; Double the room id, because each location entry is a
                     ; word.
 $D22D ADD HL,DE     ; Add the base table address to the offset to point to the requested room
                     ; address.
 $D22E LD E,(HL)     ; {Read the location address for this room.
 $D22F INC HL        ;
 $D230 LD D,(HL)     ;
 $D231 PUSH DE       ;
 $D232 POP IX        ; }
 $D234 POP HL        ; {Restore the saved pointer and the saved source from the
 $D235 POP DE        ; stack.}
 $D236 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9BB1 }
; LIST#

; Fetch Object Data Pointer
;
; Used by the routines at #R$9A59, #R$9B50, #R$9C56, #R$9C60, #R$9CA2, #R$9CCE,
; #R$9E60, #R$A4BC, #R$BE22, #R$BE91, #R$C74E, #R$C821, #R$C863, #R$C86E,
; #R$C8A7, #R$C8AF, #R$C8BE, #R$C8C6, #R$C8EF, #R$CA7F, #R$CBC2, #R$D113,
; #R$D288, #R$D495, #R$D590, #R$D60B, #R$DD0E, #R$DD35, #R$DF5B, #R$DFCC,
; #R$E03A, #R$E3A9, #R$E5C3, #R$E619 and #R$F1C1.
; .
; Looks up an object in the objects table and returns a pointer to it's
; data structure.
;
;   A Object ID
; O:IX Pointer to object data
@label=FetchObjectDataPointer
c$D237 LD IX,$8B6F   ; {Call #R$D34E to search three-byte length table.
 $D23B CALL $D34E    ; }
; This will be restored back into #REGhl by the end of the routine.
 $D23E PUSH HL       ; Read the moved marker and read the location, saving
                     ; pointer.
; Pretty clever way of using the stack here.
 $D23F LD L,(IX+$01) ;
 $D242 LD H,(IX+$02) ;
 $D245 EX (SP),HL    ; Swap the *#REGsp with the object pointer, restoring #REGhl to the original
                     ; value.
 $D246 POP IX        ; Restore the saved character record from the stack.
 $D248 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9BCA }
; LIST#

; Process Object Location Recursively
;
; Used by the routines at #R$DD0E and #R$DEE4.
; .
; Walks the objects inside the current one and records the room of each.
;
; A Object ID
; B Location ID
@label=ProcessObjectLocationRecursively
c$D249 PUSH IY       ; {Call #R$D04F to adjust object table for sum.
 $D24B PUSH IX       ;
 $D24D CALL $D04F    ; }
@label=ProcessObjectLocationRecursively_Loop
*$D250 CALL $D21C    ; {Go to #R$D267 if there is no further object.
 $D253 JR Z,$D267    ; }
 $D255 CP (IY+$01)   ; {Jump back to #R$D250 while this id does not match the
 $D258 JR NZ,$D250   ; schedule entry.}
 $D25A LD (IY+$0F),B ; {Store it in the character attribute and read the record flag, then call #R$D249 to
 $D25D PUSH AF       ; run object location recursively.
 $D25E LD A,(IX+$00) ;
 $D261 CALL $D249    ; }
 $D264 POP AF        ; {Fetch the next object from #R$D250.
 $D265 JR $D250      ; }
; Return.
@label=ProcessObjectLocationRecursively_Next
*$D267 POP IX        ; {Restore the saved character record and the saved
 $D269 POP IY        ; schedule entry from the stack.}
 $D26B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9C17 }
; LIST#

; Look Up The Room Display Parameter
;
; Used by the routine at #R$DC8D.
; .
; Looks up the object named by the room display parameter and restores the pointer
; it saved.
@label=LookUpRoomDisplayParameter
c$D26C PUSH HL       ; {Call #R$D275 to check character id range.
 $D26D LD A,($A034)  ;
 $D270 CALL $D275    ;
 $D273 POP HL        ; }
 $D274 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9C78 }
; LIST#

; Check Character ID Range
;
; Used by the routines at #R$C7A6 and #R$D26C.
; .
; Points #REGhl at the character being processed and falls through into
; #R$D278, which sets the carry for #N$FF, #N$FE or a matched id.
@label=CheckCharacterIDRange
c$D275 LD HL,$A036   ; Take the character being processed.

; Test For The End Marker
;
; Used by the routines at #R$D4EF, #R$DCA7 and #R$E3F5.
; .
; Treats either end marker as the end of the list.
c$D278 CP $FF        ; {Return, with the carry set, if the character is the end
 $D27A SCF           ; marker.
 $D27B RET Z         ; }
 $D27C CP $FE        ; {Return, with the carry set, when the id is the other
 $D27E SCF           ; end marker (#N$FE).
 $D27F RET Z         ; }
 $D280 PUSH IX       ; {Call #R$D288 to test for the end marker.
 $D282 CALL $D288    ;
 $D285 POP IX        ; }
 $D287 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9C78 }
; LIST#

; Look Up Object And Test Moved Marker
;
; Used by the routine at #R$D278.
; .
; Looks the object up and keeps searching while the moved marker is not the
; end.
@label=LookUpObjectAndTestMovedMarker
c$D288 CALL $D237    ; Call #R$D237 to look that object up.
 $D28B PUSH AF       ; {Jump to #R$D29A if the moved marker is #N$FF.
 $D28C LD A,(IX+$01) ;
 $D28F CP $FF        ;
 $D291 JR Z,$D29A    ; }
 $D293 POP IX        ; {Drop the saved value and jump back to #R$D288 while the
 $D295 CP (HL)       ; moved marker does not match the character.
 $D296 JR NZ,$D288   ; }
 $D298 SCF           ; Mark the condition as met.
 $D299 RET           ; Return.
; Clear the carry so a character id outside the range returns as no match.
@label=LookUpObjectAndTestMovedMarker_Next
*$D29A POP AF        ; Restore the saved flags from the stack.
 $D29B AND A         ; Report that the id was not found.
 $D29C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9C8A }
; LIST#

; Get Character Attribute
;
; Used by the routines at #R$BA3E, #R$E686, #R$E691 and #R$F105.
; .
; Reads the character's last attribute and returns one more than its signed
; value.
@label=GetCharacterAttribute
c$D29D LD A,$63      ; Leave #N$63 as the result.
 $D29F CALL $D2A4    ; Read the character attribute.
 $D2A2 INC A         ; Count up one.
 $D2A3 RET           ; Return.

; Random Number
;
; Used by the routines at #R$9CF2, #R$9ED7, #R$A6D3, #R$D29D and #R$E510.
; .
; Calls #R$D2AD to scale the roll, and makes the result negative when bit 7 is
; set.
@label=GetRandomNumber
c$D2A4 CALL $D2AD    ; {Call #R$D2AD to scale the roll, and return if bit 7 is
 $D2A7 BIT 7,A       ; clear.
 $D2A9 RET Z         ; }
 $D2AA NEG           ; Make the result negative.
 $D2AC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9C9F }
; LIST#

; Scale The Roll
;
; Used by the routine at #R$D2A4.
; .
; Mixes the seed at #R$A037 with the counter at #R$A039 and scales #REGa down
; to the limit in #REGc.
@label=ScaleTheRoll
c$D2AD PUSH IX        ; {Keep the record and the count, copy the roll into
 $D2AF PUSH BC        ; #REGc, and go to #R$D2B7 if bit 7 is clear.
 $D2B0 LD C,A         ;
 $D2B1 SLA A          ;
 $D2B3 JR NC,$D2B7    ; }
 $D2B5 LD A,$FF       ; Take #N$FF for the count.
@label=ScaleTheRoll_Advance
*$D2B7 LD B,A         ; Use the value in #REGa as the count.
@label=ScaleTheRoll_Count
*$D2B8 LD IX,$A039    ; {Jump to #R$D2C4 if the count has not reached zero.
 $D2BC INC (IX+$01)   ;
 $D2BF JR NZ,$D2C4    ; }
 $D2C1 INC (IX+$00)   ; Add one to the high byte of the counter at #R$A039.
@label=ScaleTheRoll_ObjectAttributeFlag
*$D2C4 LD IX,($A039)  ; {Point #REGix at #R$A039 and read the random seed
 $D2C8 LD A,($A037)   ; (#R$A037).}
 $D2CB ADC A,(IX+$00) ; Add the seed byte.
 $D2CE ADD IX,DE      ; {Add the offset to the seed pointer, mix in the next
 $D2D0 XOR (IX+$01)   ; seed byte and keep the pointer.
 $D2D3 PUSH HL        ; }
 $D2D4 LD HL,$A037    ; Use the random seed (#R$A037).
 $D2D7 CP (HL)        ; {Jump back to #R$D2B8 if the mixed seed matches the
 $D2D8 POP HL         ; seed at #R$A037.
 $D2D9 JR Z,$D2B8     ; }
 $D2DB LD ($A037),A   ; Record the random seed.
@label=ScaleTheRoll_Loop
*$D2DE CP B           ; {Jump ahead to #R$D2E8 if the first value is below the
 $D2DF JR C,$D2E8     ; second.}
 $D2E1 JR Z,$D2E8     ; Go to #R$D2E8 if the first value equals the second.
 $D2E3 SRL A          ; {Shift the roll down and test it again from #R$D2DE.
 $D2E5 JP $D2DE       ; }
; Return.
@label=ScaleTheRoll_Continue
*$D2E8 SUB C          ; Take away the other byte.
 $D2E9 POP BC         ; {Restore the saved count and the saved character record
 $D2EA POP IX         ; from the stack.}
 $D2EC RET            ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9CA8 }
; LIST#

; Start The Attribute Count
;
; Used by the routine at #R$DEE4.
; .
; Starts the attribute count at one and joins #R$D2F5.
@label=StartTheAttributeCount
c$D2ED PUSH BC       ; {Save #REGbc, set the count to #N$01 and jump ahead to
 $D2EE LD B,$01      ; #R$D2F5.
 $D2F0 JR $D2F5      ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$9CE8 }
; LIST#

; Get Object Attribute Value
;
; Used by the routine at #R$C8C6.
; .
; Counts the matching object attributes and returns how many there were.
@label=GetObjectAttributeValue
c$D2F2 PUSH BC       ; {Save #REGbc and count #N$00.
 $D2F3 LD B,$00      ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$9CED }
; LIST#

; Count The Matching Attributes
;
; Used by the routine at #R$D2ED.
; .
; Counts how many objects match this id and returns that count.
@label=CountMatchingAttributes
c$D2F5 PUSH IX       ; {Keep the schedule entry.
 $D2F7 PUSH IY       ; }
 $D2F9 LD C,$00      ; Count #N$00.
 $D2FB CALL $D305    ; Call #R$D305 to scan the objects for this id.
 $D2FE LD A,C        ; Read the low byte of the count.
 $D2FF POP IY        ; {Restore the saved schedule entry, the saved character
 $D301 POP IX        ; record and the saved count from the stack.
 $D303 POP BC        ; }
 $D304 RET           ; Return.

; Scan Objects For This Id
;
; Used by the routine at #R$D2F5.
; .
; Walks the object list at #R$8B6F until the id matches.
@label=ScanObjectsId
c$D305 PUSH IX        ; {Use the objects at #R$8B6F.
 $D307 LD IX,$8B6F    ; }
@label=ScanObjectsId_UseCharacter
*$D30B CALL $D21C     ; {Go to #R$D334 if there is no further object.
 $D30E JR Z,$D334     ; }
 $D310 CP (IY+$01)    ; {Jump back to #R$D30B while this id does not match the
 $D313 JR NZ,$D30B    ; schedule entry.}
 $D315 PUSH AF        ; {Keep the low byte and go to #R$D324 if the count is
 $D316 SUB A          ; zero.
 $D317 CP B           ;
 $D318 LD A,C         ;
 $D319 JR Z,$D324     ; }
 $D31B ADD A,(IY+$02) ; {Add the attribute at offset #N$02, and go to #R$D337
 $D31E JP PE,$D337    ; when the sum overflows.}
 $D321 LD C,A         ; {Jump ahead to #R$D331 to fetch the next object.
 $D322 JR $D331       ; }
; Add the schedule field onto the result, then store the result in the low byte of
; the count, then read the record flag.
@label=ScanObjectsId_Next
*$D324 ADD A,(IY+$03) ; {Add the attribute at offset #N$03, and go to #R$D337
 $D327 JP PE,$D337    ; when the sum overflows.}
 $D32A LD C,A         ; {Store the sum as the count, read the record's flag
 $D32B LD A,(IX+$00)  ; byte and call #R$D305.
 $D32E CALL $D305     ; }
@label=ScanObjectsId_FetchObject
*$D331 POP AF         ; {Fetch the next object from #R$D30B.
 $D332 JR $D30B       ; }
; Return.
@label=ScanObjectsId_Save
*$D334 POP IX         ; Restore the saved character record from the stack.
 $D336 RET            ; Return.
; Bring back the object id and carry on with the scan.
@label=ScanObjectsId_BringObjectCarry
*$D337 POP AF         ; {Jump back to #R$D334 to count #N$FF.
 $D338 LD C,$FF       ;
 $D33A JR $D334       ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$9D00 }
; LIST#

; Fetch Current Character Location
;
; Used by the routines at #R$B6FD, #R$D078, #R$D448 and #R$D474.
; .
; Reads the room of the character on screen and points at that room's data.
;
; O:IX Pointer to location data
@label=FetchCurrentCharacterLocation
c$D33C PUSH AF       ; {Read the current character record, keeping character.
 $D33D LD IX,($A017) ; }
 $D341 LD A,(IX+$0F) ; {Read the character attribute and call #R$D224 to fetch location data
 $D344 CALL $D224    ; pointer.
 $D347 POP AF        ; }
 $D348 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9D37 }
; LIST#

; Search Two-Byte Length Table
;
; Used by the routine at #R$C929.
; .
; Walks a list of pairs until the end marker.
;
; A Table ID to match
; IX Table to search
@label=SearchTwoByteTable
c$D349 EXX           ; Switch to the shadow registers.
 $D34A LD E,$02      ; Set the length of the data in #REGe (#N$02 bytes).
 $D34C JR $D351      ; Jump to #R$D351 to search table start.

; Search Three-Byte Length Table
;
; Used by the routines at #R$9C6A, #R$A25D, #R$C929, #R$D237, #R$E151, #R$E201
; and #R$E207.
; .
; Walks a list of three-byte groups until the end marker.
;
;   A Table ID to match
;   IX Table to search
; O:A Entry ID or #N$FF for no entry found
; O:IX Pointer to found entry
; O:F The zero flag is set when no entry was found
@label=SearchThreeByteTable
c$D34E EXX           ; Switch to the shadow registers.
 $D34F LD E,$03      ; Set the length of the data in #REGe (#N$03 bytes).
; View the equivalent code in;
; #LIST
; { #HOBBIT$9DBD }
; LIST#

; Search The Table
;
; Used by the routine at #R$D349.
; .
; Searches the table for the id in hand.
@label=SearchTable
c$D351 PUSH IX       ; {Use the command as the count.
 $D353 POP HL        ;
 $D354 LD B,A        ; }
 $D355 LD D,$00      ; Reset #REGd to #N$00 for the length offset calculation.
@label=SearchTable_Loop
*$D357 LD A,(HL)     ; Fetch a byte from the table.
 $D358 CP B          ; {Go to #R$D363 if this entry is the wanted id.
 $D359 JR Z,$D363    ; }
 $D35B CP $FF        ; {Jump to #R$D363 if this table entry is the end marker.
 $D35D JR Z,$D363    ; }
 $D35F ADD HL,DE     ; Move to the next table entry.
 $D360 JP $D357      ; Jump back to #R$D357 to check the next table entry.
; See whether this byte is the end marker before returning.
; .
; Either the table ID was matched, or the terminator was reached.
@label=SearchTable_Return
*$D363 PUSH HL       ; {See whether this table entry is the end marker.
 $D364 POP IX        ;
 $D366 CP $FF        ; }
 $D368 EXX           ; Switch back to the normal registers.
 $D369 RET           ; Return.

; Process Object Entry
;
; Used by the routines at #R$B517, #R$BE3C and #R$BE4B.
; .
; Steps through the objects and marks each one that passes the attribute test.
@label=ProcessObjectEntry
c$D36A PUSH BC       ; {Keep the schedule entry.
 $D36B PUSH DE       ;
 $D36C PUSH IY       ; }
*$D36E CALL $D206    ; Call #R$D206 to fetch the next object.
 $D371 JR Z,$D393    ; Go to #R$D393 if the next object id is #N$FF.
 $D373 LD BC,$0007   ; {Point #REGiy seven bytes further on (#N($0007,$04,$04)) and call #R$A4E0 to compare the
 $D376 PUSH IY       ; location data.
 $D378 ADD IY,BC     ;
 $D37A CALL $A4E0    ; }
 $D37D POP IY        ; {Jump back to #R$D36E while the room fields do not
 $D37F JR NZ,$D36E   ; match.}
 $D381 LD A,($A038)  ; {Jump ahead to #R$D393 if the object attribute flag is
 $D384 AND A         ; not zero.
 $D385 JR NZ,$D393   ; }
 $D387 LD A,(IX+$00) ; {Call #R$C821 to check object location match.
 $D38A PUSH IX       ;
 $D38C CALL $C821    ; }
 $D38F POP IX        ; Restore the object pointer from the stack.
 $D391 JR Z,$D36E    ; Go back to #R$D36E for the next object if this one did
                     ; not match.
@label=ProcessObjectEntry_Next
*$D393 LD A,(IX+$00) ; Read the record flag.
 $D396 POP IY        ; {Restore the saved schedule entry, the saved source and
 $D398 POP DE        ; the saved count from the stack.
 $D399 POP BC        ; }
 $D39A RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9DD9 }
; LIST#

; Process Object Entry Alternate
;
; Walks the objects in this room and describes each one that is here.
; Pointed at by #R$B4E7 and #R$B58E.
@label=ProcessObjectEntryAlternate
c$D39B PUSH IY       ; {Save the schedule entry, the source, the count and the
 $D39D PUSH DE       ; character record.
 $D39E PUSH BC       ;
 $D39F PUSH IX       ; }
 $D3A1 POP BC        ; Copy the character record from #REGix into #REGbc.
 $D3A2 LD DE,$0001   ; Take an offset of #N($0001,$04,$04).
; Has the object count reached #N$6A?
@label=ProcessObjectEntryAlternate_Loop
*$D3A5 INC B         ; {Count one more, and go to #R$D3CD with #N$FF if the
 $D3A6 LD A,B        ; count has reached #N$6A.
 $D3A7 CP $6A        ;
 $D3A9 LD A,$FF      ;
 $D3AB JR Z,$D3CD    ; }
 $D3AD LD A,B        ; {Take the count, then call #R$D224 to look up this room.
 $D3AE CALL $D224    ; }
 $D3B1 PUSH IX       ; {Step to the next schedule entry, then call #R$A4E0 to
 $D3B3 POP IY        ; compare location data.
 $D3B5 ADD IY,DE     ;
 $D3B7 CALL $A4E0    ; }
 $D3BA JR NZ,$D3A5   ; Jump back to #R$D3A5 while the room fields do not match.
 $D3BC LD A,($A038)  ; {Jump ahead to #R$D3CC if the object attribute flag is
 $D3BF AND A         ; not zero.
 $D3C0 JR NZ,$D3CC   ; }
 $D3C2 PUSH BC       ; {Take the count and call #R$D471 to find an object by
 $D3C3 LD A,B        ; field two.
 $D3C4 CALL $D471    ;
 $D3C7 POP BC        ; }
 $D3C8 CP $FF        ; {Jump back to #R$D3A5 if the entry is the end marker.
 $D3CA JR Z,$D3A5    ; }
@label=ProcessObjectEntryAlternate_Next
*$D3CC LD A,B        ; Take the count.
@label=ProcessObjectEntryAlternate_BringSavedCharacter
*$D3CD PUSH BC       ; {Copy the object count from #REGbc into #REGix.
 $D3CE POP IX        ; }
 $D3D0 POP BC        ; {Restore the saved count, the saved source and the saved
 $D3D1 POP DE        ; schedule entry from the stack.
 $D3D2 POP IY        ; }
 $D3D4 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9EA0 }
; LIST#

; Take The Found Object
;
; Used by the routines at #R$D113, #R$D590, #R$D60B and #R$DF5B.
; .
; Points #REGiy at the object just found and continues at #R$D3D9. That entry steps
; seven bytes to the description flag and calls #R$D3E8.
@label=TakeTheFoundObject
c$D3D5 PUSH IX       ; {Copy the object record from #REGix into #REGiy.
 $D3D7 POP IY        ; }
; This entry point is used by the routine at #R$D526.
@label=TakeTheFoundObject_DescriptionFlag
*$D3D9 PUSH IY       ; {Keep the object and step seven bytes to its description
 $D3DB PUSH DE       ; flag.
 $D3DC LD DE,$0007   ;
 $D3DF ADD IY,DE     ; }
 $D3E1 CALL $D3E8    ; Call #R$D3E8 to see whether this object has a special
                     ; description.
 $D3E4 POP DE        ; {Restore the saved source and the saved schedule entry
 $D3E5 POP IY        ; from the stack.}
 $D3E7 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9EC7 }
; LIST#

; Check Object Has Special Description
;
; Used by the routines at #R$A7C5, #R$BF1C and #R$D3D5.
; .
; Reads the object's description word through #R$A7D0 and clears #R$A7EA unless
; bit 6 of #REGiy-#N$02 is set. Then prints the tokens at #REGiy+#N$02 and
; #REGiy+#N$04, or only the one at #REGiy+#N$04 when bit 5 of #REGiy-#N$01 is
; set.
@label=CheckObjectHasSpecialDescription
c$D3E8 PUSH AF        ; {Save the registers, then read the word at
 $D3E9 PUSH DE        ; #REGiy+#N$00-#N$01 into #REGde.
 $D3EA LD D,(IY+$01)  ;
 $D3ED LD E,(IY+$00)  ; }
 $D3F0 CALL $A7D0     ; Call #R$A7D0 to test the token and set the flag.
 $D3F3 BIT 6,(IY-$02) ; {Go to #R$D3FD if bit 6 of this byte is set.
 $D3F7 JR NZ,$D3FD    ; }
 $D3F9 XOR A          ; {Clear the token match flag at #R$A7EA.
 $D3FA LD ($A7EA),A   ; }
@label=CheckObjectHasSpecialDescription_Next
*$D3FD BIT 5,(IY-$01) ; {Go to #R$D427 if bit 5 of this byte is set.
 $D401 JR NZ,$D427    ; }
 $D403 JR $D416       ; Go on to read the high byte of the object's description
                      ; token.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9ED6 }
; LIST#

; Check Object Attribute With Flag
;
; Used by the routines at #R$A7BA and #R$D1C6.
; .
; Reads the object's attribute word and prints the attribute text selected by
; the object's flags.
@label=CheckObjectAttributeWithFlag
c$D405 PUSH AF       ; {Save the registers, then read the word at
 $D406 PUSH DE       ; #REGiy+#N$00-#N$01 into #REGde.
 $D407 LD D,(IY+$01) ;
 $D40A LD E,(IY+$00) ; }
 $D40D CALL $A7D0    ; Call #R$A7D0 to test the token and set the flag.
 $D410 LD A,($A028)  ; {Jump to #R$D438 if the object processing source flag is
 $D413 AND A         ; set.
 $D414 JR NZ,$D438   ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$9ED6 }
; LIST#

; Read The Schedule Field
;
; Used by the routine at #R$D3E8.
; .
; Reads the schedule pair and clears its top bit.
c$D416 LD E,(IY+$02)  ; {Read the schedule pair and clear its top bit.
 $D419 LD D,(IY+$03)  ;
 $D41C RES 7,D        ; }
 $D41E BIT 7,(IY+$03) ; {Call #R$A815 if bit 7 of the schedule entry is clear.
 $D422 LD A,$40       ;
 $D424 CALL Z,$A815   ; }

; Read The Schedule Field
;
; Used by the routine at #R$D3E8.
; .
; Reads the next schedule pair and clears its top bit.
@label=ReadScheduleField
c$D427 LD E,(IY+$04)  ; {Read the schedule pair at #REGiy+#N$04 and clear its
 $D42A LD D,(IY+$05)  ; top bit.
 $D42D RES 7,D        ; }
 $D42F BIT 7,(IY+$05) ; {Call #R$A815 if bit 7 of the schedule entry is clear.
 $D433 LD A,$40       ;
 $D435 CALL Z,$A815   ; }
; This entry point is used by the routine at #R$D405.
@label=ReadScheduleField_Next
*$D438 LD E,(IY+$00)  ; {Read the word at #REGiy+#N$00-#N$01 into #REGde.
 $D43B LD D,(IY+$01)  ; }
 $D43E LD A,D         ; {See whether the source word is empty.
 $D43F OR E           ; }
 $D440 LD A,$50       ; Leave #N$50 as the result.
 $D442 CALL NZ,$A815  ; Call #R$A815 if the source word is not empty.
 $D445 POP DE         ; {Restore the saved source and result from the stack.
 $D446 POP AF         ; }
 $D447 RET            ; Return.

; Read The Character's Room
;
; Used by the routine at #R$DCA7.
; .
; Fetches this character's location and steps on to the next record.
@label=ReadCharacterRoom
c$D448 PUSH DE       ; {Call #R$D33C to fetch current character location.
 $D449 PUSH BC       ;
 $D44A PUSH IY       ;
 $D44C LD B,A        ;
 $D44D CALL $D33C    ; }
 $D450 LD DE,$0006   ; {Step to the next record.
 $D453 ADD IX,DE     ; }
@label=ReadCharacterRoom_Loop
*$D455 CALL $D206    ; {Go to #R$D467 if the next object id is #N$FF.
 $D458 JR Z,$D467    ; }
 $D45A LD A,(IX+$02) ; {Jump back to #R$D455 if the high byte of this entry's
 $D45D AND A         ; data pointer is zero.
 $D45E JR Z,$D455    ; }
 $D460 LD A,(IX+$00) ; {Read this entry's id and keep searching while it is not
 $D463 CP B          ; the character asked for.
 $D464 JP NZ,$D455   ; }
@label=ReadCharacterRoom_Restore
*$D467 POP IY        ; {Restore the saved schedule entry, the saved count and
 $D469 POP BC        ; the saved source from the stack.
 $D46A POP DE        ; }
 $D46B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9F08 }
; LIST#

; Find Object By Field One
;
; Used by the routine at #R$DBF7.
; .
; Selects field 1 and searches for an object whose field matches #REGb.
@label=FindObjectByFieldOne
c$D46C PUSH AF       ; {Take #N$01 and continue at #R$D474.
 $D46D LD A,$01      ;
 $D46F JR $D474      ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$9F25 }
; LIST#

; Find Object By Field Two
;
; Used by the routines at #R$C628, #R$C6BE, #R$CAAF, #R$D39B and #R$DD35.
; .
; Selects field 2 and searches for an object whose field matches #REGb.
@label=FindObjectByFieldTwo
c$D471 PUSH AF       ; {Take #N$02.
 $D472 LD A,$02      ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$9F2D }
; LIST#

; Find Object By Field
;
; Used by the routine at #R$D46C.
; .
; Writes the field number into the search instruction, then walks the object
; records for a match.
@label=FindObjectByField
c$D474 LD ($D48D),A  ; {Write the field number into the displacement of the
 $D477 POP AF        ; instruction at #R$D48B.
 $D478 PUSH BC       ; }
 $D479 PUSH IY       ; {Call #R$D33C to fetch current character location.
 $D47B LD B,A        ;
 $D47C PUSH DE       ;
 $D47D CALL $D33C    ; }
 $D480 LD DE,$0006   ; {Step to the next record.
 $D483 ADD IX,DE     ;
 $D485 POP DE        ; }
@label=FindObjectByField_Loop
*$D486 CALL $D206    ; {Go to #R$D491 if the next object id is #N$FF.
 $D489 JR Z,$D491    ; }
; #R$D474 writes #N$01 or #N$02 into the displacement of this instruction.
 $D48B LD A,(IX+$02) ; {Compare field #N$02 (modified by #R$D474) of this
 $D48E CP B          ; object with the value wanted, and keep searching if it
 $D48F JR NZ,$D486   ; differs.}
@label=FindObjectByField_Next
*$D491 POP IY        ; {Restore the saved schedule entry and the saved count
 $D493 POP BC        ; from the stack.}
 $D494 RET           ; Return.

; Get Object First Location
;
; Used by the routines at #R$CAAF, #R$CBC2, #R$CC29 and #R$D045.
; .
; Returns at once when the id is #N$FF. Otherwise looks the object up. Returns
; #N$FF when the object appears more than once, and the first location at
; offset #N$0F when it appears once.
;
;   A Object ID
; O:A #N$FF when the id is empty or the object appears more than once, else its
; .   first location
@label=GetObjectFirstLocation
c$D495 CP $FF        ; {Return if the id is #N$FF.
 $D497 RET Z         ; }
 $D498 CALL $D237    ; Call #R$D237 to look that object up.
 $D49B LD A,$01      ; {See whether the object appears once.
 $D49D CP (IX+$00)   ; }
 $D4A0 LD A,$FF      ; Leave #N$FF when the object appears more than once.
 $D4A2 RET NZ        ; Return if the object appears more than once.
; The object appears once, so return its first location.
 $D4A3 LD A,(IX+$0F) ; Read the object's first location.
 $D4A6 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9F82 }
; LIST#

; Print Object List
;
; Used by the routine at #R$D178.
; .
; Counts the objects in this room and prints them when the room is not empty.
@label=PrintObjectList
c$D4A7 PUSH IY       ; {Save the schedule entry, the result and the count.
 $D4A9 PUSH AF       ;
 $D4AA PUSH BC       ; }
 $D4AB LD A,$FF      ; Set the location ID to #N$FF (current character
                     ; location).
; Count objects in location.
 $D4AD CALL $D4CC    ; Call #R$D4CC to count the objects in this location.
; Skip printing if no objects were found.
 $D4B0 JR Z,$D4C7    ; Stop the list when there are no more objects in this
                     ; room.
 $D4B2 PUSH AF       ; Keep the object count and take the message at #R$68E4.
; Print the introductory text for the object list.
 $D4B3 LD HL,$68E4   ;
 $D4B6 CALL $A59F    ; Call #R$A59F to print the message.
 $D4B9 POP BC        ; {Restore the object count into #REGc from the stack.
 $D4BA LD C,B        ; }
 $D4BB LD A,$FF      ; Set the location ID to #N$FF (current character
                     ; location) again.
 $D4BD LD IY,($A017) ; {Read the current character's record, then call #R$D51A to list the objects
 $D4C1 LD B,(IY+$0F) ; and describe them.
 $D4C4 CALL $D51A    ; }
@label=PrintObjectList_End
*$D4C7 POP BC        ; {Restore the saved count, the saved result and the saved
 $D4C8 POP AF        ; schedule entry from the stack.
 $D4C9 POP IY        ; }
 $D4CB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9F94 }
; LIST#

; Count Objects In Location
;
; Used by the routines at #R$D113, #R$D4A7, #R$D526 and #R$DE60.
; .
; Counts how many objects are inside the current room.
;
;   A Location ID (or #N$FF for current character location)
; O:A Count of visible objects found in the specified location
@label=CountObjectsInLocation
c$D4CC PUSH IX       ; {Save the character record, the schedule entry, the
 $D4CE PUSH IY       ; pointer and the count.
 $D4D0 PUSH HL       ;
 $D4D1 PUSH BC       ; }
 $D4D2 CALL $D04F    ; Call #R$D04F to set up the object table pointer.
 $D4D5 LD B,$00      ; Initialise the object counter in #REGb to zero.
 $D4D7 LD C,A        ; Store the location ID in #REGc for later use.
@label=CountObjectsInLocation_Loop
*$D4D8 CALL $D206    ; {Go to #R$D4E6 if the next object id is #N$FF.
 $D4DB JR Z,$D4E6    ; }
 $D4DD LD A,C        ; Take the count.
 $D4DE CALL $D4EF    ; Call #R$D4EF to check if this object matches the location and visibility
                     ; criteria.
; Skip this object if it does not match the location and visibility criteria.
 $D4E1 JR NC,$D4D8   ; Jump back to #R$D4D8 to continue checking objects if
                     ; this one doesn't match.
; This object matches the criteria, so count it.
 $D4E3 INC B         ; Increment the object counter in #REGb by one.
 $D4E4 JR $D4D8      ; Jump back to #R$D4D8 to check the next object.
; Read the count.
@label=CountObjectsInLocation_End
*$D4E6 LD A,B        ; Transfer the object count from #REGb to #REGa.
 $D4E7 AND A         ; Set the zero flag when the count is zero.
 $D4E8 POP BC        ; {Restore the saved count, the saved pointer, the saved
 $D4E9 POP HL        ; schedule entry and the saved character record from the
 $D4EA POP IY        ; stack.
 $D4EC POP IX        ; }
 $D4EE RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$9D97 }
; LIST#

; Check Object Match Criteria
;
; Used by the routines at #R$D4CC and #R$D57D.
; .
; Sets the carry when the object matches the id, the location and the remaining
; checks. Returns with the carry clear when any check fails.
;
;   A Object ID
;   B Location ID
; O:F Carry flag set if object matches all criteria (location, visibility,
; .   type, etc.)
@label=CheckObjectMatchCriteria
c$D4EF CP (IY+$01)   ; {Go to #R$D518 if the object id does not match.
 $D4F2 JR NZ,$D518   ; }
 $D4F4 LD A,($A036)  ; {Go to #R$D518 if the object is the character being
 $D4F7 CP (IX+$00)   ; processed.
 $D4FA JR Z,$D518    ; }
 $D4FC LD A,(IX+$00) ; {Go to #R$D518 if the object is not in this location.
 $D4FF CALL $C821    ;
 $D502 JR Z,$D518    ; }
 $D504 LD A,(IY+$00) ; {Jump to #R$D518 if the character id is at least #N$02.
 $D507 CP $02        ;
 $D509 JR NC,$D518   ; }
; Perform final validation check.
 $D50B LD A,($A036)  ; {Read the current character.
 $D50E PUSH IX       ;
 $D510 POP HL        ; }
 $D511 CALL $D278    ; Call #R$D278 to perform an additional validation check.
 $D514 JR C,$D518    ; Go to #R$D518 if #R$D278 sets the carry.
; All checks passed - object matches the criteria.
 $D516 SCF           ; Mark the condition as met.
 $D517 RET           ; Return.
; Clear the carry so an object that failed the checks returns as no match.
; .
; Object doesn't match any criteria.
@label=CheckObjectMatchCriteria_NoMatch
*$D518 AND A         ; Clear the carry before returning the failed object
                     ; match.
 $D519 RET           ; Return.

; Print Object List With Formatting
;
; Used by the routines at #R$D113, #R$D4A7 and #R$DE60.
; .
; Saves the caller's registers and prints the formatted object list.
;
; B Location ID
@label=PrintObjectListWithFormatting
c$D51A PUSH IY       ; {Call #R$D526 to print formatted object list.
 $D51C PUSH DE       ;
 $D51D PUSH BC       ;
 $D51E CALL $D526    ;
 $D521 POP BC        ; }
 $D522 POP DE        ; {Restore the saved source and the saved schedule entry
 $D523 POP IY        ; from the stack.}
 $D525 RET           ; Return.

; Print Formatted Object List
;
; Used by the routine at #R$D51A.
; .
; Sets up the object table and prints each matching object.
;
; IX Context pointer (preserved but not directly used)
; A Object ID (starting object ID for the list, or #N$FF for all objects)
@label=PrintFormattedObjectList
c$D526 PUSH IX        ; {Call #R$D04F to set up the object table pointer,
 $D528 CALL $D04F     ; keeping character record.}
@label=PrintFormattedObjectList_Loop
*$D52B PUSH AF        ; {Keep the object id and call #R$D57D to find the next
 $D52C CALL $D57D     ; matching object.}
 $D52F JR C,$D55A     ; Go to #R$D55A if there is no further object.
; Mark this object as processed and prepare to print its name.
 $D531 SET 7,(IY+$06) ; Set bit 7 of the object's byte at offset #N$06.
 $D535 SUB A          ; {Clear the object processing source flag at #R$A028.
 $D536 LD ($A028),A   ; }
 $D539 CALL $D3D9     ; Call #R$D3D9 to read this object's description flag.
 $D53C DEC C          ; {Jump ahead to #R$D546 if the count is not zero.
 $D53D LD A,C         ;
 $D53E AND A          ;
 $D53F JR NZ,$D546    ; }
; Print separator for the last object in the list.
 $D541 CALL $A414     ; Call #R$A414 to print a full stop.
 $D544 JR $D557       ; Carry on and print the next object in the list.
; See whether the text byte is set, then leave the result this step chose, then
; print the character.
; .
; Determine which separator to print based on how many objects remain.
@label=PrintFormattedObjectList_CheckSeparator
*$D546 CP $01         ; {Jump ahead to #R$D551 if one object remains.
 $D548 JR Z,$D551     ; }
; Print comma separator for multiple objects.
 $D54A LD A,$2C       ; Take a comma.
 $D54C CALL $A9B7     ; Print the character in #REGa through #R$A9B7.
 $D54F JR $D557       ; Carry on and print the next object in the list.
; Print the dictionary word.
; .
; Print "and" separator before the last object.
@label=PrintFormattedObjectList_PrintAnd
*$D551 LD DE,$005D    ; Take token #N($005D,$04,$04).
 $D554 CALL $A887     ; Call #R$A887 to print token #N$5D.
@label=PrintFormattedObjectList_LoopContinue
*$D557 POP AF         ; {Keep looking for a matching object from #R$D52B.
 $D558 JR $D52B       ; }
; Points the object list at the right room, finds the next matching object, and counts the objects
; there.
; .
; No more objects found in the main list - check for nested objects.
@label=PrintFormattedObjectList_CheckNested
*$D55A POP AF         ; Restore the saved result from the stack.
 $D55B CALL $D04F     ; Call #R$D04F to reset the object table pointer.
@label=PrintFormattedObjectList_NestedLoop
*$D55E PUSH AF        ; {Keep the result and call #R$D57D to find the next
 $D55F CALL $D57D     ; matching object.}
 $D562 JR C,$D578     ; Finish at #R$D578 when no more objects are found.
 $D564 PUSH AF        ; {Call #R$D4CC to count nested objects in the location, keeping find next
 $D565 CALL $D4CC     ; matching object result.}
 $D568 JR Z,$D574     ; Skip the nested list when nothing is inside this
                      ; object.
; Print description and recursively print nested objects.
 $D56A LD C,A         ; Store the object count in #REGc for later use.
 $D56B POP AF         ; Restore the saved result from the stack.
 $D56C CALL $D590     ; Call #R$D590 to print object description.
 $D56F CALL $D526     ; Call #R$D526 to print the formatted object list.
 $D572 JR $D575       ; Carry on after the separator.
; Drop the saved flags and carry on after the separator.
@label=PrintFormattedObjectList_SkipNested
*$D574 POP AF         ; {Restore the saved values from the stack.
@label=PrintFormattedObjectList_NestedDone
*$D575 POP AF         ; }
 $D576 JR $D55E       ; And jump to #R$D55E.
; Return.
; .
; No nested objects found - restore registers and return.
@label=PrintFormattedObjectList_End
*$D578 POP AF         ; {Restore the saved result and the saved character
 $D579 POP IX         ; record from the stack.}
 $D57B RET            ; Return.

; Find Next Matching Object
;
; Used by the routine at #R$D57D.
; .
; Hands the registers saved by the search back to the caller.
@label=FindNextMatchingObject
c$D57C POP AF        ; Restore the caller's registers.

; Find The Next Matching Object
;
; Used by the routine at #R$D526.
; .
; Finds the next object with this id, and gives up when the list ends or the
; object is not here.
@label=FindMatchingObject
c$D57D CALL $D21C    ; Call #R$D21C to fetch the next object with this id.
 $D580 JR NZ,$D584   ; Go to #R$D584 if another object remains.
; Object not found, so return that failure to the caller.
 $D582 SCF           ; Set the carry to report that no object was found.
 $D583 RET           ; Return.
; Read the record flag.
@label=FindMatchingObject_CheckCriteria
*$D584 PUSH AF       ; {Call #R$D4EF to check if the object matches the location and visibility
 $D585 CALL $D4EF    ; criteria, keeping fetch next object with id result.}
 $D588 JR NC,$D57C   ; Go to #R$D57C if #R$D4EF does not match this object.
; Object matches - return with object ID.
@label=FindMatchingObject_Found
 $D58A POP AF        ; Restore the saved result from the stack.
 $D58B LD A,(IX+$00) ; Read the record flag.
 $D58E AND A         ; Clear the carry to report that this object was found.
 $D58F RET           ; Return.

; Print Object Description
;
; Used by the routine at #R$D526.
; .
; Looks the object up and prints either its special text or the ordinary
; description.
;
; A Object ID
; C Description type (#N$00 or #N$01)
@label=PrintObjectDescription
c$D590 PUSH IX        ; {Call #R$D237 to look up that object.
 $D592 PUSH BC        ;
 $D593 PUSH AF        ;
 $D594 CALL $D237     ; }
 $D597 BIT 6,(IX+$05) ; {Jump to #R$D5A5 if the special-description flag is
 $D59B JR Z,$D5A5     ; clear.}
; Print the special description text for this object.
@label=PrintObjectDescription_Special
 $D59D POP AF         ; {Restore the saved flags from the stack, then save two
 $D59E PUSH AF        ; copies of them back.
 $D59F PUSH AF        ; }
 $D5A0 LD HL,$68B1    ; {Print the text at #R$68B1 from #R$D5C1.
 $D5A3 JR $D5C1       ; }
; Determine which standard description text to use based on the description
; type.
; .
; Determine which standard description text to use based on the description
; type.
@label=PrintObjectDescription_Standard
*$D5A5 LD HL,$0485    ; {Take #N($0485,$04) and jump ahead to #R$D5AE if the
 $D5A8 DEC C          ; count has run out.
 $D5A9 JR Z,$D5AE     ; }
 $D5AB LD HL,$007A    ; Take the object token at #N($007A,$04,$04).
@label=PrintObjectDescription_PrintAttributes
*$D5AE PUSH HL        ; {Call #R$D5D3 to describe the object's attribute,
 $D5AF CALL $D5D3     ; saving pointer.}
 $D5B2 LD A,$01       ; {Enable *#R$A2AA (write #N$01 to it).
 $D5B4 LD ($A2AA),A   ; }
 $D5B7 CALL $D3D5     ; Call #R$D3D5 to read this object's description flag.
 $D5BA XOR A          ; {Disable *#R$A2AA (write #N$00 to it).
 $D5BB LD ($A2AA),A   ; }
 $D5BE LD HL,$68D9    ; Take the cannot see message.
@label=PrintObjectDescription_PrintText
*$D5C1 CALL $A59F     ; Call #R$A59F to print the message.
 $D5C4 POP AF         ; {Restore the saved result, the saved count and the
 $D5C5 POP BC         ; saved character record from the stack.
 $D5C6 POP IX         ; }
 $D5C8 RET            ; Return.

; Table: Object Attribute Description Text Tokens
;
; Object Attribute Description Text Tokens read by #R$D5D3.
@label=Table_ObjectAttributeDescriptionTokens
g$D5C9 DEFB $50
 $D5CA DEFB $04
 $D5CB DEFB $FF
 $D5CC DEFB $05
 $D5CD DEFB $DC
 $D5CE DEFB $00
 $D5CF DEFB $19
 $D5D0 DEFB $09
 $D5D1 DEFB $D3
 $D5D2 DEFB $08

; Print Object Attribute Description
;
; Used by the routines at #R$D113 and #R$D590.
; .
; Reads the attribute type and prints the matching direction text.
;
; IX Object pointer
@label=PrintObjectAttributeDescription
c$D5D3 LD HL,$D5C9   ; Take the object attribute description text tokens.
; Extract the attribute type from the object data.
 $D5D6 LD A,(IX+$04) ; Read the attribute type.
 $D5D9 AND %00000111 ; Keep the direction of the attribute type.
 $D5DB CP $05        ; See whether the attribute type is #N$05.
 $D5DD PUSH AF       ; {Count down one, store the attribute type for the next step and move the
 $D5DE DEC A         ; pointer on by the length.
 $D5DF LD E,A        ;
 $D5E0 LD D,$00      ;
 $D5E2 ADD HL,DE     ;
 $D5E3 ADD HL,DE     ; }
 $D5E4 CALL $A880    ; Call #R$A880 to print the token.
 $D5E7 POP AF        ; Restore the comparison from the stack.
 $D5E8 RET NZ        ; Return unless the attribute type was #N$05.
; Print an additional text token for attribute type #N$06.
 $D5E9 LD DE,$08DB   ; {Jump back to #R$A887 to print token #N$08DB.
 $D5EC JP $A887      ; }

; Get Location Exit Data
;
; Used by the routines at #R$D60B and #R$D68C.
; .
; Points at the exit list for the room, three bytes for each direction.
;
;   A Room ID
; O:IX Pointer to exit data
; O:BC Exit data length (3 bytes)
;
; Fetch location data pointer.
@label=GetLocationExitData
c$D5EF CALL $D224    ; Call #R$D224 to look this room up.
 $D5F2 LD BC,$0006   ; {Step to the next record.
 $D5F5 ADD IX,BC     ;
 $D5F7 LD BC,$0003   ; }
 $D5FA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$A0AE }
; LIST#

; Get Direction Token
;
; Used by the routines at #R$D60B and #R$D68C.
; .
; This routine converts a direction value into the address of its
; corresponding token string.
;
;   A Direction value
; O:DE Address of token string
@label=GetDirectionToken
c$D5FB LD HL,$D064   ; Use the direction tokens at #R$D064.
 $D5FE DEC HL        ; {Step #REGhl back two bytes.
 $D5FF DEC HL        ; }
 $D600 LD E,A        ; {Clear bit 7 of the direction.
 $D601 RES 7,E       ; }
 $D603 LD D,$00      ; Clear the high byte in #REGd.
 $D605 ADD HL,DE     ; {Add #N$02 times the offset to the base table address.
 $D606 ADD HL,DE     ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$A0BA }
; LIST#

; Read The Room Graphics Link
;
; Reads the room-graphics link stored at the pointer.
; Reached from the script records at #R$E182 and #R$E1AC.
c$D607 LD E,(HL)     ; Read the low byte of the room-graphics link.
 $D608 INC HL        ; Advance through this record.
 $D609 LD D,(HL)     ; Read the high byte of the room-graphics link.
 $D60A RET           ; Return.

; Print Location Exits
;
; Used by the routine at #R$D113.
; .
; Reads this room's exits and prints them.
;
; A Room ID
@label=PrintLocationExits
c$D60B PUSH BC        ; {Call #R$D5EF to get location exit data.
 $D60C PUSH DE        ;
 $D60D PUSH IY        ;
 $D60F PUSH IX        ;
 $D611 CALL $D5EF     ; }
 $D614 PUSH IX        ; {Jump ahead to #R$D660 to step to the next schedule
 $D616 POP IY         ; entry and take the end marker.
 $D618 JR $D660       ; }
; Skip this exit when its door object is zero.
@label=PrintLocationExits_Loop
*$D61A LD A,(IY+$01)  ; {Jump to #R$D660 if the door object is zero.
 $D61D AND A          ;
 $D61E JR Z,$D660     ; }
 $D620 LD A,(IY+$00)  ; {Jump to #R$D660 if the direction is #N$0B or more.
 $D623 CP $0B         ;
 $D625 JR NC,$D660    ; }
 $D627 LD A,(IY+$01)  ; {Look up the door object.
 $D62A CALL $D237     ; }
 $D62D BIT 7,(IX+$05) ; {Jump ahead to #R$D660 if the object-attribute flag is
 $D631 JR Z,$D660     ; clear.}
 $D633 LD A,(IY+$00)  ; {Call #R$D5FB to get direction token.
 $D636 CALL $D5FB     ; }
 $D639 CP $09         ; {Jump ahead to #R$D647 if the direction is below a tab.
 $D63B JR C,$D647     ; }
 $D63D LD DE,$000A    ; {Take a step of #N($000A,$04,$04) and jump ahead to
 $D640 JR Z,$D64D     ; #R$D64D if the direction token is #N$09.}
 $D642 LD DE,$00E7    ; {Use a step of #N($00E7,$04,$04) and join #R$D64D.
 $D645 JR $D64D       ; }
; Use the text: message at #R$68BC as the pointer, then use the text: exits at
; #R$68E9 as the pointer, then advance the schedule entry by the count.
@label=PrintLocationExits_Next
*$D647 LD HL,$68BC    ; {Take the message, then call #R$A59F to print the
 $D64A CALL $A59F     ; message.}
; Print text token.
@label=PrintLocationExits_PrintTextToken
*$D64D CALL $A887     ; Call #R$A887 to print the dictionary word.
 $D650 LD HL,$68E9    ; {Take the exits message, then call #R$A59F to print the
 $D653 CALL $A59F     ; exits message.}
 $D656 PUSH IY        ; {Keep the schedule entry, then call #R$D3D5 to run
 $D658 CALL $D3D5     ; object entry alternate.}
 $D65B CALL $A414     ; Call #R$A414 to print a full stop.
 $D65E POP IY         ; Restore the schedule entry from the stack.
@label=PrintLocationExits_DoesMatchCharacter
*$D660 ADD IY,BC      ; {Jump back to #R$D61A unless the next entry is the end
 $D662 LD A,$FF       ; marker (#N$FF).
 $D664 CP (IY+$00)    ;
 $D667 JP NZ,$D61A    ; }
 $D66A POP IX         ; {Restore the saved character record, the saved schedule
 $D66C POP IY         ; entry, the saved source and the saved count from the
 $D66E POP DE         ; stack.
 $D66F POP BC         ; }
 $D670 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$A0C8 }
; LIST#

; Find Next Valid Exit
;
; Used by the routine at #R$D68C.
; .
; Steps through the exit list until it finds one whose door object is zero.
;
;   IX Pointer to exit data
;   BC Exit data length
; O:F Zero flag clear when a valid exit is found
@label=FindNextValidExit
c$D671 ADD IX,BC     ; Step to the next exit entry.
 $D673 LD A,$FF      ; Take the end marker.
 $D675 CP (IX+$00)   ; See whether this exit is the end marker.
 $D678 RET Z         ; Return if this exit is the end marker.
 $D679 XOR A         ; {Go to #R$D671 if the door object is not zero.
 $D67A CP (IX+$01)   ;
 $D67D JR NZ,$D671   ; }
 $D67F LD A,(IX+$00) ; {Jump to #R$D671 if this exit has no direction.
 $D682 AND A         ;
 $D683 JR Z,$D671    ; }
 $D685 CP $0B        ; {Go to #R$D671 if the direction is #N$0B or more.
 $D687 JR NC,$D671   ; }
 $D689 OR %00000001  ; Reset the zero flag.
 $D68B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$A124 }
; LIST#

; Print Location Exits With Formatting
;
; Used by the routine at #R$D178.
; .
; Prints the exit lead-in and then each valid way out of the room.
;
; A Room ID
@label=PrintLocationExitsWithFormatting
c$D68C PUSH IX       ; {Call #R$D5EF to get location exit data.
 $D68E PUSH IY       ;
 $D690 PUSH DE       ;
 $D691 PUSH BC       ;
 $D692 CALL $D5EF    ; }
 $D695 CALL $D671    ; {Go to #R$D6B1 if there is no further exit.
 $D698 JR Z,$D6B1    ; }
 $D69A LD HL,$68F1   ; {Take the exits message, then call #R$A59F to print the
 $D69D CALL $A59F    ; exits message.}
@label=PrintLocationExitsWithFormatting_Loop
*$D6A0 LD A,(IX+$00) ; {Call #R$D5FB to get direction token.
 $D6A3 CALL $D5FB    ; }
 $D6A6 CALL $A887    ; {Jump back to #R$D6A0 while another exit is valid.
 $D6A9 CALL $D671    ;
 $D6AC JR NZ,$D6A0   ; }
 $D6AE CALL $A414    ; Call #R$A414 to print a full stop.
@label=PrintLocationExitsWithFormatting_Next
*$D6B1 POP BC        ; {Restore the saved count, the saved source, the saved
 $D6B2 POP DE        ; schedule entry and the saved character record from the
 $D6B3 POP IY        ; stack.
 $D6B5 POP IX        ; }
 $D6B7 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$A138 }
; LIST#

; Flags: Parser Workspace
;
; #R$D6B8 is cleared at the game entry point. #R$D6B8+#N$05 holds the parser pointer for the routines below.
; Read by #R$A040, #R$D6C1, #R$D835 and #R$D85B.
g$D6B8 DEFB $00,$00,$00,$00,$00,$00,$00

; Display Record
;
; Display record read by #R$C9BF: flags #N$00, value #N$00.
;
; .
;
; Named from the script command at #R$9923.
b$D6BF DEFB $00,$00

; Parse Input
;
; Command parser. It reads the line buffer at #R$5B00, tokenises it, and
; handles backspace and quoting. A non-zero return means the script step
; succeeded.
;
; .
;
; Run by #R$CA64 after the display record at #R$D6BF.
@label=ParseInput
c$D6C1 CALL $D898           ; {Return zero through #R$DC15 if no command was
 $D6C4 JP Z,$DC15           ; entered.}
 $D6C7 XOR A                ; {Clear the parser state.
 $D6C8 LD ($D714),A         ; }
 $D6CB OR %00000001         ; Reset the zero flag.
 $D6CD RET                  ; Return.
 $D6CE LD HL,$5B00          ; Take the line buffer.
@label=ParseInput_Loop
*$D6D1 CALL $D9C5           ; {Call #R$D9C5 to read the next character and jump
 $D6D4 CP $D0               ; to #R$D6E0 when it is #N$D0.
 $D6D6 JP Z,$D6E0           ; }
 $D6D9 CP $C0               ; {Jump back to #R$D6D1 while the character is not
 $D6DB JR NZ,$D6D1          ; #N$C0.}
 $D6DD OR %00000001         ; Reset the zero flag.
 $D6DF RET                  ; Return.
; Hands the following step back to the caller and reports that the test failed.
@label=ParseInput_Next
*$D6E0 LD HL,$D6E5          ; Hand back the address of the following step.
 $D6E3 XOR A                ; Clear #REGa.
 $D6E4 RET                  ; Return.
 $D6E5 LD A,$01             ; {Set the print mode to #N$01 and point #REGhl at
 $D6E7 LD ($A027),A         ; the message at #R$6857+#N$02.
 $D6EA LD HL,$6859          ; }
; Print text and handle control characters.
 $D6ED CALL $A59F           ; Call #R$A59F to print this message.
 $D6F0 LD HL,($D6BD)        ; {Read the parser pointer, write #N$C0 there and
 $D6F3 LD (HL),$C0          ; read the word at #R$A029.
 $D6F5 LD HL,($A029)        ; }
@label=ParseInput_Byte
*$D6F8 LD A,(HL)            ; {Jump ahead to #R$D6FF if this byte is not #N$2E.
 $D6F9 CP $2E               ;
 $D6FB JR NZ,$D6FF          ; }
 $D6FD LD A,$20             ; Take a space.
*$D6FF CALL $A9B7           ; Call #R$A9B7 to print the character.
 $D702 INC HL               ; {Step on and jump back to #R$D6F8 until a space
 $D703 CP $20               ; has been printed.
 $D705 JR NZ,$D6F8          ; }
 $D707 LD A,$22             ; {Print character #N$22 through #R$A9B7, then call
 $D709 CALL $A9B7           ; #R$A2A2 to print a new line.
 $D70C CALL $A2A2           ; }
 $D70F XOR A                ; Clear #REGa so the print mode that follows starts
                            ; at zero.
 $D710 LD ($A027),A         ; Record the result in the print mode.
 $D713 RET                  ; Return.
 $D714 DEFB $00             ; Parser state byte, read by #R$D6C1 and #R$D99E.
; Named from the script command at #R$9928.
 $D715 DEFB $40,$00,$CE,$D6 ; Display record read by #R$C9BF: flags #N$40,
                            ; value #N$00, handler #R$D6CE.
; Run by #R$CA64 after the display record at #R$D715.
 $D719 XOR A                ; Clear the parser state.
 $D71A LD ($A019),A         ; Record the parser.
; Reset screen display.
 $D71D CALL $C142           ; Call #R$C142 to reset the screen.
 $D720 LD A,($D714)         ; {Jump to #R$D760 if the state byte at #R$D714 is
 $D723 AND A                ; set.
 $D724 JR NZ,$D760          ; }
 $D726 LD HL,$5B81          ; {Call #R$A2AB to clear buffer.
 $D729 LD B,$60             ;
 $D72B CALL $A2AB           ; }
 $D72E LD HL,$5B00          ; {Take the line buffer.
 $D731 LD IY,$5B81          ; }
@label=ParseInput_CharacterParseInput
*$D735 LD (IY+$00),$C0      ; {Store #N$C0 as this character's id, then call
 $D739 CALL $D9C5           ; #R$D9C5 to skip spaces.}
 $D73C LD (IY+$00),D        ; {Store #REGd, step on one byte and jump ahead to
 $D73F INC IY               ; #R$D751 if the character is #N$E0.
 $D741 CP $E0               ;
 $D743 JR Z,$D751           ; }
 $D745 CP $F0               ; {Jump ahead to #R$D751 if the character is #N$F0.
 $D747 JR Z,$D751           ; }
 $D749 CP $90               ; {Jump ahead to #R$D751 if the character is #N$90.
 $D74B JR Z,$D751           ; }
 $D74D CP $80               ; {Jump ahead to #R$D75B if the character is at
 $D74F JR NC,$D75B          ; least #N$80.}
@label=ParseInput_CharacterLowByte
*$D751 LD (IY+$00),B        ; {Store #REGb and #REGc as the word at
 $D754 LD (IY+$01),C        ; #REGiy+#N$00-#N$01.}
 $D757 INC IY               ; {Step on two places.
 $D759 INC IY               ; }
@label=ParseInput_Pointer
*$D75B LD A,D               ; {Jump back to #R$D735 while the result in #REGd
 $D75C CP $C0               ; is not #N$C0.
 $D75E JR NZ,$D735          ; }
@label=ParseInput_RecordParserPointer
*$D760 LD HL,$5B81          ; {Record the parser pointer.
 $D763 LD ($D6BD),HL        ; }
 $D766 OR %00000001         ; Reset the zero flag.
 $D768 RET                  ; Return.
; Named from the script command at #R$992D.
 $D769 DEFB $40,$00,$70,$D7 ; Display record read by #R$C9BF: flags #N$40,
                            ; value #N$00, handler #R$D770.
; Run by #R$CA64 after the display record at #R$D769.
 $D76D OR %00000001         ; Reset the zero flag.
 $D76F RET                  ; Return.
; Reached through the display record at #R$D769, dispatched by #R$CB40.
 $D770 LD HL,($D6BD)        ; Read the parser pointer.
 $D773 LD A,(HL)            ; Read the next input character.
 $D774 AND $F0              ; Keep bits 4-7.
 $D776 CP $C0               ; See whether the high nibble is #N$C0.
 $D778 JP Z,$DC15           ; Jump to #R$DC15 when the high nibble is #N$C0.
 $D77B OR %00000001         ; Reset the zero flag.
 $D77D RET                  ; Return.
; Named from the script command at #R$9932.
 $D77E DEFB $00,$00         ; Display record read by #R$C9BF: flags #N$00,
                            ; value #N$00.
; Run by #R$CA64 after the display record at #R$D77E.
 $D780 XOR A                ; {Clear the character script entry list and set
 $D781 LD ($9FEB),A         ; the command mode at #R$A024 to #N$01.
 $D784 INC A                ;
 $D785 LD ($A024),A         ; }
 $D788 LD HL,($D6BD)        ; {Read the parser pointer, store it in the word at
 $D78B LD ($A02B),HL        ; #R$A02B and call #R$AAB2.
 $D78E CALL $AAB2           ; }
 $D791 PUSH AF              ; {Clear the initialised flag.
 $D792 XOR A                ;
 $D793 LD ($A01B),A         ;
 $D796 POP AF               ; }
 $D797 LD HL,($A02B)        ; Read the word at #R$A02B.
 $D79A LD ($D6BD),HL        ; {Store the parser pointer and go to #R$D7B2 if
 $D79D JR NZ,$D7B2          ; preparing the character succeeded.}
 $D79F LD HL,($9FF0)        ; {Read the first display link and store the
 $D7A2 LD ($9FF2),HL        ; pointer in the next display link.}
 $D7A5 LD HL,$0000          ; Clear the pointer.
 $D7A8 LD ($9FF0),HL        ; {Store the zero pointer in the first display link
 $D7AB XOR A                ; and clear the parser workspace byte at #R$D6B8.
 $D7AC LD ($D6B8),A         ; }
 $D7AF OR %00000001         ; Reset the zero flag.
 $D7B1 RET                  ; Return.
; Reads both display links, and takes the special path when the code is 2.
@label=ParseInput_ReadsBothDisplay
*$D7B2 PUSH AF              ; {Call #R$D87D to read the first display link.
 $D7B3 CALL $D87D           ; }
 $D7B6 CALL $D88A           ; {Call #R$D88A to read the next display link.
 $D7B9 POP AF               ; }
 $D7BA CP $02               ; {Jump ahead to #R$D7D0 if the character is #N$02.
 $D7BC JR Z,$D7D0           ; }
 $D7BE LD A,$01             ; {Set the print mode to #N$01 and point #REGhl at
 $D7C0 LD ($A027),A         ; the message at #R$685F+#N$07.
 $D7C3 LD HL,$6866          ; }
; Print text and handle control characters.
 $D7C6 CALL $A59F           ; Call #R$A59F to print this message.
 $D7C9 XOR A                ; {Clear the print mode and return zero through
 $D7CA LD ($A027),A         ; #R$DC15.
 $D7CD JP $DC15             ; }
; Read the script-cycle pointer and return when it is still set.
@label=ParseInput_ScriptCyclePointer
*$D7D0 LD HL,($A01F)        ; {Return if the script-cycle pointer at #R$A01F is
 $D7D3 LD A,H               ; not zero.
 $D7D4 OR L                 ;
 $D7D5 RET NZ               ; }
 $D7D6 JP $DC15             ; Return zero through #R$DC15.
; Named from the script command at #R$9937.
 $D7D9 DEFB $40,$00,$E1,$D7 ; Display record read by #R$C9BF: flags #N$40,
                            ; value #N$00, handler #R$D7E1.
; Run by #R$CA64 after the display record at #R$D7D9.
 $D7DD OR %00000001         ; Reset the zero flag.
 $D7DF RET                  ; Return.
 $D7E0 DEFB $00             ; State byte for this input step. Read by #R$D7E1 and written by #R$D7E7 and
                            ; #R$D870.
; Reached through the display record at #R$D7D9, dispatched by #R$CB40.
 $D7E1 LD A,($D7E0)         ; {Jump to #R$D7F1 if the state byte at #R$D7E0 is
 $D7E4 AND A                ; zero.
 $D7E5 JR Z,$D7F1           ; }
 $D7E7 XOR A                ; {Clear the state byte at #R$D7E0 and call #R$D88A
 $D7E8 LD ($D7E0),A         ; to read the next display link.
 $D7EB CALL $D88A           ; }
 $D7EE JP $DC15             ; Return zero through #R$DC15.
; Read the next display link and return when it is still set.
@label=ParseInput_TestDisplayLinkSet
*$D7F1 LD HL,($9FF2)        ; {Return if the next display link at #R$9FEE+#N$04
 $D7F4 LD A,L               ; is set.
 $D7F5 OR H                 ;
 $D7F6 RET NZ               ; }
 $D7F7 JP $DC15             ; Return zero through #R$DC15.
; Named from the script command at #R$993C.
 $D7FA DEFB $00,$00         ; Display record read by #R$C9BF: flags #N$00,
                            ; value #N$00.
; Run by #R$CA64 after the display record at #R$D7FA.
 $D7FC XOR A                ; {Clear the display.
 $D7FD LD A,($D6B8)         ;
 $D800 LD ($A01C),A         ; }
 $D803 LD IY,($9FF2)        ; Read the next display link.
 $D807 LD HL,($D6BB)        ; {Call #R$B191 to initialise display buffer.
 $D80A LD ($B17E),HL        ;
 $D80D CALL $B191           ; }
; A command is being read.
 $D810 LD A,$01             ; {Remember that a command is being read, and leave the line when the display buffer
 $D812 LD ($A00B),A         ; came back empty.
 $D815 JP Z,$D85B           ; }
 $D818 LD A,($A01C)         ; {Store the display flag in the parser workspace
 $D81B LD ($D6B8),A         ; byte at #R$D6B8.}
 $D81E LD A,$01             ; {Write #N$01 to the token format flag.
 $D820 LD ($A026),A         ; }
 $D823 LD A,($A033)         ; {Record the current room.
 $D826 LD ($9FD6),A         ; }
 $D829 LD HL,($A034)        ; Read the room display parameter.
 $D82C LD ($9FD7),HL        ; {Record the location value and read the object
 $D82F LD HL,($B17E)        ; table pointer.}
 $D832 LD ($D6BB),HL        ; Record the parser workspace.

; Release The Next Display Record
;
; Used by the routine at #R$D85B.
; .
; Reads the parser workspace, then reads the character
; record from the next display link.
@label=ReleaseNextDisplayRecord
c$D835 LD A,($D6B8)   ; {Jump to #R$D858 if the parser workspace is set.
 $D838 AND A          ;
 $D839 JR NZ,$D858    ; }
 $D83B LD IX,($9FF2)  ; Read the next display link.
@label=ReleaseNextDisplayRecord_PointerSavedRecord
*$D83F LD L,(IX-$02)  ; {Read the pointer saved ahead of this record.
 $D842 LD H,(IX-$01)  ; }
 $D845 LD ($9FF2),HL  ; Store the pointer in the next display link.
 $D848 CALL $A1C7     ; {Jump ahead to #R$D858 if the pointer is zero.
 $D84B LD A,L         ;
 $D84C OR H           ;
 $D84D JR Z,$D858     ; }
 $D84F PUSH HL        ; {Jump to #R$D83F if a marker on the moved marker is
 $D850 POP IX         ; set.
 $D852 BIT 6,(IX+$01) ;
 $D856 JR NZ,$D83F    ; }
@label=ReleaseNextDisplayRecord_TestActionSucceeded
*$D858 OR %00000001   ; Reset the zero flag.
 $D85A RET            ; Return.

; Record A Parser Failure
;
; Used by the routine at #R$D6C1.
; .
; On failure, store the result in the parser workspace, then read the display
; flag.
@label=RecordParserFailure
c$D85B XOR A         ; {Clear the parser workspace.
 $D85C LD ($D6B8),A  ; }
 $D85F LD A,($A01C)  ; {Jump to #R$D870 if the display is zero.
 $D862 AND A         ;
 $D863 JR Z,$D870    ; }
 $D865 LD A,$FF      ; {Store #N$FF in the saved character and call #R$D835 to
 $D867 LD ($A033),A  ; release the next display record.
 $D86A CALL $D835    ; }
 $D86D JP $DC15      ; Return zero through #R$DC15.
@label=RecordParserFailure_StepSucceedsScript
*$D870 LD A,$01      ; {Store #N$01 in the state byte at #R$D7E0 and save
 $D872 LD ($D7E0),A  ; #REGhl.
 $D875 PUSH HL       ; }
 $D876 LD HL,($D6BD) ; Read the parser pointer.
 $D879 LD (HL),$C0   ; {Write #N$C0 at the parser pointer, restore #REGhl.
 $D87B POP HL        ; }
 $D87C RET           ; Return.

; Read First Display Link
;
; Used by the routines at #R$B8AA and #R$D6C1.
; .
; Reads the first display link at #R$9FF0, clears it, and follows the character record it
; held.
;
; .
;
; Follow the pointer at #R$9FF0.
@label=ReadFirstDisplayLink
c$D87D LD IX,($9FF0) ; {Read the first display link into #REGix and take a zero
 $D881 LD HL,$0000   ; pointer.}
 $D884 LD ($9FF0),HL ; Store the pointer in the first display link.
 $D887 JP $A1AF      ; Jump back to #R$A1AF to follow the record pointer.

; Read Next Display Link
;
; Used by the routine at #R$D6C1.
; .
; Reads the next display link at #R$9FEE+#N$04, clears it, and follows the character record it
; held.
;
; .
;
; Follow the pointer at #R$9FEE+#N$04.
@label=ReadNextDisplayLink
c$D88A LD IX,($9FF2) ; {Read the next display link into #REGix and take a zero
 $D88E LD HL,$0000   ; pointer.}
 $D891 LD ($9FF2),HL ; Store the pointer in the next display link.
 $D894 JP $A1AF      ; Jump back to #R$A1AF to follow the record pointer.

; Quotation Mark Flag
;
; Set while the command line is inside quotation marks.
; Set by #R$D8BC, toggled by #R$D8F6 and #R$D908, and read by #R$D949.
g$D897 DEFB $00

; Read Command Line
;
; Used by the routine at #R$D6C1.
; .
; Prints the input prompt and stores the typed command in the line buffer at
; #R$5B00.
@label=ReadCommandLine
c$D898 LD HL,$0BB8   ; {Point the object attribute at the prompt token #N$0BB8.
 $D89B LD ($A03B),HL ; }
 $D89E LD A,$01      ; {Set the print mode to #N$01 and call #R$D8AD.
 $D8A0 LD ($A027),A  ;
 $D8A3 CALL $D8AD    ; }
 $D8A6 PUSH AF       ; {Start the input from zero and store it in the print
 $D8A7 XOR A         ; mode.
 $D8A8 LD ($A027),A  ; }
 $D8AB POP AF        ; Restore #REGaf from the stack.
 $D8AC RET           ; Return.

; Read A Command Line
;
; Used by the routine at #R$D898.
; .
; Reads a command line. Prints a prompt and stores the text at #R$5B00.
@label=ReadCommandLine_CommandLinePrints
c$D8AD LD A,$3E      ; {Print character #N$3E through #R$A9B7.
 $D8AF CALL $A9B7    ; }
 $D8B2 LD A,$20      ; {Take a space and print it through #R$A9B7.
 $D8B4 CALL $A9B7    ; }
 $D8B7 LD HL,$5B00   ; {Take the line buffer.
 $D8BA LD B,$80      ; }
@label=ReadCommandLine_Loop
*$D8BC LD A,$01      ; {Mark the command line as started.
 $D8BE LD ($D897),A  ;
 $D8C1 LD C,$00      ; }
; This entry point is used by the routine at #R$D99E.
@label=ReadCommandLine_CompareLocationData
*$D8C3 CALL $A536    ; {Go to #R$D9AC if #R$A536 returns zero.
 $D8C6 JP Z,$D9AC    ; }
 $D8C9 BIT 7,B       ; {Jump ahead to #R$D8D2 if bit 7 is clear.
 $D8CB JR Z,$D8D2    ; }
 $D8CD CP $40        ; {Jump ahead to #R$D99E if the command is #N$40.
 $D8CF JP Z,$D99E    ; }
@label=ReadCommandLine_TestMarkerClear
*$D8D2 BIT 0,C       ; {Call #R$D978 if bit 0 of #REGc is clear.
 $D8D4 CALL Z,$D978  ; }
 $D8D7 LD C,$01      ; {Jump ahead to #R$D8E2 if the input is not #N$18.
 $D8D9 CP $18        ;
 $D8DB JR NZ,$D8E2   ; }
 $D8DD CALL $D9B7    ; {Delete the last input character and go back to #R$D8BC.
 $D8E0 JR $D8BC      ; }
; A backspace is printed as a backspace unless the top bit of the count is set.
@label=ReadCommandLine_TestBackspacePrintedBackspace
*$D8E2 CP $08        ; {Jump ahead to #R$D900 if the command is not #N$08.
 $D8E4 JR NZ,$D900   ; }
 $D8E6 BIT 7,B       ; {Jump back to #R$D8C3 while bit 7 is present.
 $D8E8 JR NZ,$D8C3   ; }
 $D8EA LD A,$08      ; {Print character #N$08 through #R$A9B7.
 $D8EC CALL $A9B7    ; }
 $D8EF INC B         ; {Jump back to #R$D8C3 while this byte is not #N$22.
 $D8F0 DEC HL        ;
 $D8F1 LD A,(HL)     ;
 $D8F2 CP $22        ;
 $D8F4 JR NZ,$D8C3   ; }
 $D8F6 LD A,($D897)  ; {Toggle the quotation-mark flag at #R$D897.
 $D8F9 XOR $01       ;
 $D8FB LD ($D897),A  ; }
 $D8FE JR $D8C3      ; Read the next key from #R$D8C3.
; A quotation mark toggles the typing marker. A key at or above #N$40 is stored
; as typed.
@label=ReadCommandLine_TestQuotationMarkToggles
*$D900 CP $40        ; {Jump ahead to #R$D93C if the key is at least #N$40.
 $D902 JR NC,$D93C   ; }
 $D904 CP $22        ; {Jump ahead to #R$D917 unless the key is a double quote
 $D906 JR NZ,$D917   ; (#N$22).}
 $D908 LD A,($D897)  ; {Toggle the quotation-mark flag at #R$D897.
 $D90B XOR $01       ;
 $D90D LD ($D897),A  ; }
 $D910 CALL NZ,$D968 ; Call #R$D968 to add a full stop when the quotation
                     ; marker turns on.
 $D913 LD A,$22      ; {Take a quotation mark and jump ahead to #R$D93C.
 $D915 JR $D93C      ; }
; A blank or a full stop ends this input, and a carriage return ends the line.
@label=ReadCommandLine_TestBlankFullStop
*$D917 CP $20        ; {Jump to #R$D93C if the player pressed "SPACE".
 $D919 JR Z,$D93C    ; }
 $D91B CP $0D        ; {Jump to #R$D949 if the player pressed "ENTER".
 $D91D JR Z,$D949    ; }
 $D91F CP $2E        ; {Jump ahead to #R$D93C if the input is #N$2E.
 $D921 JR Z,$D93C    ; }
 $D923 CP $2C        ; {Jump ahead to #R$D93C if the input is #N$2C.
 $D925 JR Z,$D93C    ; }
 $D927 CP $2F        ; {Jump ahead to #R$D93C if the input is #N$2F.
 $D929 JR Z,$D93C    ; }
 $D92B CP $60        ; {Jump ahead to #R$D93C if the input is #N$60.
 $D92D JR Z,$D93C    ; }
 $D92F CP $2D        ; {Jump ahead to #R$D93C if the input is #N$2D.
 $D931 JR Z,$D93C    ; }
 $D933 CP $3A        ; {Go to #R$D93C when the input is a colon.
 $D935 JR Z,$D93C    ; }
 $D937 CALL $DAE8    ; {Call #R$DAE8 and jump to #R$D8C3 if the character is
 $D93A JR C,$D8C3    ; not a digit.}
@label=ReadCommandLine_TestCountHasReached
*$D93C DEC B         ; {Jump to #R$D946 if the count has reached zero.
 $D93D INC B         ;
 $D93E JR Z,$D946    ; }
 $D940 LD (HL),A     ; {Store the character in the line buffer and print it
 $D941 CALL $A9B7    ; through #R$A9B7.}
 $D944 INC HL        ; {Step to the next entry and count down one.
 $D945 DEC B         ; }
*$D946 JP $D8C3      ; Return to #R$D8C3 for the next character of the command.
; Read the command marker, then leave a carriage return.
@label=ReadCommandLine_CommandMarkerLeave
*$D949 LD A,($D897)  ; {Call #R$D95C if the quotation mark flag at #R$D897 is
 $D94C AND A         ; zero.
 $D94D CALL Z,$D95C  ; }
 $D950 CALL $D968    ; Call #R$D968 to test for a sentence stop.
 $D953 LD A,$0D      ; {Take a new line and store it at the line buffer, then call #R$A9B7 to print
 $D955 LD (HL),A     ; character.
 $D956 CALL $A9B7    ; }
 $D959 OR %00000001  ; Reset the zero flag.
 $D95B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$6DD6 }
; LIST#

; Leave A Quote As The Result
;
; Used by the routine at #R$D8AD.
; .
; Prints a quote (#N$22) after the sentence-stop test.
@label=LeaveQuoteResult
c$D95C CALL $D968    ; Call #R$D968 to test for a sentence stop.
 $D95F LD A,$22      ; {Store #N$22 in the line and print it through #R$A9B7.
 $D961 LD (HL),A     ;
 $D962 CALL $A9B7    ; }
 $D965 INC HL        ; Advance through the text.
 $D966 DEC B         ; Count down the remaining steps.
 $D967 RET           ; Return.

; Test For A Full Stop
;
; Used by the routines at #R$D8AD and #R$D95C.
; .
; Prints a sentence stop when the previous character is not already one.
@label=TestFullStop
c$D968 DEC HL        ; {Jump ahead to #R$D976 if this byte is #N$2E.
 $D969 LD A,(HL)     ;
 $D96A CP $2E        ;
 $D96C JR Z,$D976    ; }
 $D96E INC HL        ; {Step on, count one fewer, store #N$2E and print it
 $D96F DEC B         ; through #R$A9B7.
 $D970 LD A,$2E      ;
 $D972 LD (HL),A     ;
 $D973 CALL $A9B7    ; }
@label=TestFullStop_TestAdvanceThroughText
*$D976 INC HL        ; Advance through the text.
 $D977 RET           ; Return.

; Map The Cursor Keys
;
; Used by the routine at #R$D8AD.
; .
; Turns a cursor key into a compass letter: right (#N$09) to E, left (#N$08) to
; W, down (#N$0A) to S and up (#N$5B) to N.
@label=MapCursorKeys
c$D978 CP $09        ; {Jump ahead to #R$D996 if the key is cursor right
 $D97A JR Z,$D996    ; (#N$09).}
 $D97C CP $08        ; {Jump ahead to #R$D99A if the key is cursor left
 $D97E JR Z,$D99A    ; (#N$08).}
 $D980 CP $0A        ; {Jump ahead to #R$D992 if the key is cursor down
 $D982 JR Z,$D992    ; (#N$0A).}
 $D984 CP $5B        ; {Return unless the key is cursor up (#N$5B).
 $D986 RET NZ        ; }
 $D987 LD A,$4E      ; Take N for cursor up.
*$D989 LD (HL),A     ; {Store it at the line buffer and step to the next entry, then call #R$A9B7 to print
 $D98A INC HL        ; character.
 $D98B CALL $A9B7    ; }
 $D98E DEC B         ; Count down the remaining steps.
 $D98F LD A,$0D      ; Leave #N$0D as the result.
 $D991 RET           ; Return.
; Cursor down selects the letter S.
@label=MapCursorKeys_South
*$D992 LD A,$53      ; {Take the direction letter S and go to #R$D989 to store it in the line buffer and
 $D994 JR $D989      ; print it.}
; Cursor right selects the letter E.
@label=MapCursorKeys_East
*$D996 LD A,$45      ; {Take the direction letter E and go to #R$D989 to store it in the line buffer and
 $D998 JR $D989      ; print it.}
; Cursor left selects the letter W.
@label=MapCursorKeys_West
*$D99A LD A,$57      ; {Take the direction letter W and go to #R$D989 to store it in the line buffer and
 $D99C JR $D989      ; print it.}
; View the equivalent code in;
; #LIST
; { #HOBBIT$6E4F }
; LIST#

; Ignore Input Until The Game Has Started
;
; Used by the routine at #R$D8AD.
; .
; Returns without deleting a character when the initialised flag is still
; clear.
@label=IgnoreInputUntilGameHasStarted
c$D99E LD A,($A01B)  ; {Jump to #R$D8C3 if the game has already been
 $D9A1 AND A         ; initialised.
 $D9A2 JP NZ,$D8C3   ; }
 $D9A5 LD A,$01      ; {Mark the parser state so input is ignored until the
 $D9A7 LD ($D714),A  ; game has started.
 $D9AA OR $01        ; }
; This entry point is used by the routine at #R$D8AD.
@label=IgnoreInputUntilGameHasStarted_InputPrintCharacter
*$D9AC PUSH AF       ; {Print character #N$08 through #R$A9B7, keeping the
 $D9AD LD A,$08      ; flags.
 $D9AF CALL $A9B7    ; }
 $D9B2 CALL $A9B7    ; Print the character through #R$A9B7.
 $D9B5 POP AF        ; Restore #REGa from the stack.
 $D9B6 RET           ; Return.

; Delete Input Character
;
; Used by the routines at #R$A536 and #R$D8AD.
; .
; Deletes the character before the cursor on the command line and prints the
; correction.
;
; .
;
; Delete the character before the cursor.
@label=DeleteInputCharacter
c$D9B7 BIT 7,B       ; See whether bit 7 of the count is set.
 $D9B9 RET NZ        ; Return if that marker is set.
 $D9BA LD A,$08      ; {Print character #N$08 through #R$A9B7.
 $D9BC CALL $A9B7    ; }
 $D9BF INC B         ; {Count one more, step back one byte and jump to #R$D9B7.
 $D9C0 DEC HL        ;
 $D9C1 JR $D9B7      ; }
; View the equivalent code in;
; #LIST
; { #HOBBIT$6E8B }
; LIST#

; Word: Saved Input Pointer
;
; Input pointer saved while the dictionary is measured.
; Written by #R$D9E4 and read by #R$DA21.
g$D9C3 DEFW $0000

; Skip Spaces In The Input
;
; Used by the routine at #R$D6C1.
; .
; Skips blanks in the typed command and classifies the next character.
@label=SkipSpaces
c$D9C5 PUSH DE       ; {Jump back to #R$D9C6 if this byte is #N$20, saving
*$D9C6 LD A,(HL)     ; source.
 $D9C7 INC HL        ;
 $D9C8 CP $20        ;
 $D9CA JR Z,$D9C6    ; }
 $D9CC DEC HL        ; {Step back to this character and store the pointer at
 $D9CD LD ($A029),HL ; #R$A029.}
 $D9D0 CP $0D        ; {Jump to #R$DA06 if the player pressed "ENTER".
 $D9D2 JR Z,$DA06    ; }
 $D9D4 CALL $DAC6    ; {Go to #R$DA2F if the character is a full stop, a comma
 $D9D7 JR Z,$DA2F    ; or a quote.}
 $D9D9 CALL $DA34    ; {Go to #R$DA0A if the token has no dictionary entry.
 $D9DC JR Z,$DA0A    ; }
 $D9DE PUSH IX       ; {Save #REGix and clear the match length at #R$DC14.
 $D9E0 XOR A         ;
 $D9E1 LD ($DC14),A  ; }
@label=SkipSpaces_SaveInputPointer
*$D9E4 LD ($D9C3),DE ; Remember the input pointer at #R$D9C3.
@label=SkipSpaces_MeasureDictionary
*$D9E8 LD DE,($DA32) ; {Read the dictionary address and measure the gap from
 $D9EC AND A         ; it.
 $D9ED PUSH HL       ;
 $D9EE SBC HL,DE     ; }
 $D9F0 POP HL        ; {Jump ahead to #R$DA12 if the two pointers meet.
 $D9F1 JR Z,$DA12    ; }
 $D9F3 PUSH HL       ; {Copy the pointer into #REGde and call #R$A94D to handle
 $D9F4 POP DE        ; the nested format.
 $D9F5 CALL $A94D    ; }
 $D9F8 LD A,(DE)     ; {Jump back to #R$D9E8 if the high nibble is #N$D0.
 $D9F9 AND $F0       ;
 $D9FB CP $D0        ;
 $D9FD JR Z,$D9E8    ; }
 $D9FF CALL $DA7D    ; {Go to #R$DA12 if the typed word does not match.
 $DA02 JR Z,$DA12    ; }
 $DA04 JR $D9E4      ; The word matched, so measure the next one from #R$D9E4.
; ENTER selects the result #N$C0.
@label=SkipSpaces_EnterResult
*$DA06 LD A,$C0      ; {ENTER uses the result #N$C0, stored from #R$DA0C.
 $DA08 JR $DA0C      ; }
; Use #N$D0 when the word is not in the dictionary.
@label=SkipSpaces_UnknownWord
*$DA0A LD A,$D0      ; Take #N$D0 as the result for an unknown word.
*$DA0C LD BC,$0000   ; Clear #REGbc (no time was given).
 $DA0F POP DE        ; Restore the saved source from the stack.
 $DA10 LD D,A        ; Store the result in the high byte of the source.
 $DA11 RET           ; Return.
; The saved length decides whether this character is kept.
@label=SkipSpaces_CheckSavedLength
*$DA12 POP HL        ; {Jump to #R$DA21 if the state byte at #R$DC14 is at
 $DA13 LD A,($DC14)  ; least #N$04.
 $DA16 CP $04        ;
 $DA18 JR NC,$DA21   ; }
 $DA1A LD B,A        ; {Go to #R$DA0A if the matched-word length does not equal
 $DA1B LD A,($DC13)  ; the saved count.
 $DA1E CP B          ;
 $DA1F JR NZ,$DA0A   ; }
@label=SkipSpaces_ReadInputPointer
*$DA21 PUSH HL       ; {Read the input pointer and keep the high digit of that
 $DA22 LD HL,($D9C3) ; character.
 $DA25 LD A,(HL)     ;
 $DA26 AND $F0       ; }
 $DA28 LD BC,$5DBF   ; Take the dictionary index.
 $DA2B SBC HL,BC     ; {Swap in the saved pointer.
 $DA2D EX (SP),HL    ;
 $DA2E POP BC        ; }
@label=SkipSpaces_ReturnWithHighByte
*$DA2F POP DE        ; Restore the saved source from the stack.
 $DA30 LD D,A        ; Store the result in the high byte of the source.
 $DA31 RET           ; Return.

; Word: Dictionary Address
;
; Address in the dictionary text, saved while a word is matched.
; Written by #R$DA50 and read by #R$D9E8.
g$DA32 DEFW $0000

; Find The Dictionary Entry For This Token
;
; Used by the routine at #R$D9C5.
; .
; Turns the low five bits of this character into the dictionary offset. The
; zero flag is set when the dictionary link is empty.
@label=FindTokenDictionaryEntry
c$DA34 LD A,(HL)     ; {Keep this character's dictionary length and turn it
 $DA35 INC HL        ; into an offset.
 $DA36 AND $1F       ;
 $DA38 RLCA          ;
 $DA39 LD E,A        ;
 $DA3A LD D,$00      ; }
 $DA3C PUSH HL       ; {Use the dictionary index at #R$5D80.
 $DA3D POP IX        ;
 $DA3F LD HL,$5D80   ;
 $DA42 ADD HL,DE     ;
 $DA43 LD E,(HL)     ; }
 $DA44 INC HL        ; {Read the next byte of the input byte.
 $DA45 LD D,(HL)     ;
 $DA46 INC HL        ;
 $DA47 PUSH DE       ; }
@label=FindTokenDictionaryEntry_DictionaryLinkEmpty
*$DA48 LD E,(HL)     ; {Go back to #R$DA48 while this dictionary link is empty.
 $DA49 INC HL        ;
 $DA4A LD D,(HL)     ;
 $DA4B INC HL        ;
 $DA4C LD A,D        ;
 $DA4D OR E          ;
 $DA4E JR Z,$DA48    ; }
 $DA50 LD HL,$5DBF   ; {Add the dictionary base and store the address at
 $DA53 ADD HL,DE     ; #R$DA32.
 $DA54 LD ($DA32),HL ;
 $DA57 POP DE        ; }
 $DA58 LD A,D        ; Read the high byte of the source.
 $DA59 OR E          ; Merge the low byte of the source into the result.
 $DA5A RET Z         ; Return when this dictionary link is empty.
 $DA5B LD HL,$5DBF   ; {Take the dictionary index and point #REGde at the word
 $DA5E ADD HL,DE     ; buffer (#R$5C0B).
 $DA5F LD DE,$5C0B   ; }
 $DA62 LD B,$01      ; Count #N$01.
@label=FindTokenDictionaryEntry_RecordFlagByte
*$DA64 LD A,(IX+$00) ; {Jump to #R$DA74 if this dictionary byte is below #N$40
 $DA67 CP $40        ; (the word has ended).
 $DA69 JR C,$DA74    ; }
 $DA6B OR $20        ; {Make the letter lower case, store it in the word
 $DA6D LD (DE),A     ; buffer, and repeat from #R$DA64.
 $DA6E INC DE        ;
 $DA6F INC IX        ;
 $DA71 INC B         ;
 $DA72 JR $DA64      ; }
; On failure, store the result in the working byte, then keep the match flags before
; returning.
@label=FindTokenDictionaryEntry_SignalStepFailed
*$DA74 XOR A         ; {Clear the character at the pointer and remember the
 $DA75 LD (DE),A     ; input length.
 $DA76 LD A,B        ;
 $DA77 LD ($DC13),A  ; }
 $DA7A OR %00000001  ; Reset the zero flag.
 $DA7C RET           ; Return.

; Match The Dictionary Word
;
; Used by the routine at #R$D9C5.
; .
; Compares the typed word with this dictionary entry and keeps the match when
; it is longer than the one already saved.
@label=MatchDictionaryWord
c$DA7D PUSH HL       ; {Read the input length.
 $DA7E PUSH DE       ;
 $DA7F LD A,($DC13)  ;
 $DA82 LD B,A        ; }
 $DA83 LD A,($DC14)  ; {Jump ahead to #R$DAA5 if the first value is at least
 $DA86 CP B          ; the second.
 $DA87 JR NC,$DAA5   ; }
 $DA89 LD B,$01      ; {Point #REGde at the word buffer (#R$5C0B) and #REGhl at
 $DA8B LD DE,$5C0B   ; #N$5C42.
 $DA8E LD HL,$5C42   ; }
@label=MatchDictionaryWord_CompareLetters
*$DA91 LD A,(DE)     ; {Jump ahead to #R$DA9D if this dictionary letter is
 $DA92 AND A         ; zero.
 $DA93 JR Z,$DA9D    ; }
 $DA95 CP (HL)       ; {Jump ahead to #R$DA9D if the dictionary letter differs.
 $DA96 JR NZ,$DA9D   ; }
 $DA98 INC HL        ; {Step to the next letter, count one more and jump back
 $DA99 INC DE        ; to #R$DA91.
 $DA9A INC B         ;
 $DA9B JR $DA91      ; }
; Accepts the saved index while it is still within the match length.
@label=MatchDictionaryWord_AcceptLength
*$DA9D LD A,($DC14)  ; {Go to #R$DAA9 if the match length equals the saved
 $DAA0 CP B          ; count.
 $DAA1 JR Z,$DAA9    ; }
 $DAA3 JR C,$DAA9    ; Jump ahead to #R$DAA9 if the first value is below the
                     ; second.
@label=MatchDictionaryWord_NoMatch
*$DAA5 POP DE        ; {Restore the text pointer from the stack.
 $DAA6 POP HL        ; }
 $DAA7 XOR A         ; Clear #REGa.
 $DAA8 RET           ; Return.
; Take the input length and remember it in the space marker.
@label=MatchDictionaryWord_RememberLength
*$DAA9 LD A,B        ; {Take the dictionary index and store it in the workspace
 $DAAA LD ($DC14),A  ; byte at #R$DC14.}
@label=MatchDictionaryWord_NextEntry
*$DAAD POP HL        ; {Go to #R$DAC1 if bit 7 of the next byte is clear.
 $DAAE PUSH HL       ;
 $DAAF INC HL        ;
 $DAB0 BIT 7,(HL)    ;
 $DAB2 DEC HL        ;
 $DAB3 JR Z,$DAC1    ; }
 $DAB5 INC HL        ; {Step on two places, step to the next entry and take the
 $DAB6 INC HL        ; dictionary index.
 $DAB7 LD E,(HL)     ;
 $DAB8 INC HL        ;
 $DAB9 LD D,(HL)     ;
 $DABA LD HL,$5DBF   ; }
 $DABD ADD HL,DE     ; {Jump back to #R$DAAD to step to the next entry and step
 $DABE EX (SP),HL    ; back one entry.
 $DABF JR $DAAD      ; }
; Keep the match flags before returning.
@label=MatchDictionaryWord_Matched
*$DAC1 POP DE        ; {Restore the saved pointers from the stack.
 $DAC2 POP HL        ; }
 $DAC3 OR %00000001  ; Reset the zero flag.
 $DAC5 RET           ; Return.

; Test For A Common Word
;
; Used by the routine at #R$D9C5.
; .
; Classifies a vocabulary code, a numeral, a sentence stop or a comma for the
; command parser.
@label=TestCommonWord
c$DAC6 CP $60        ; {Jump ahead to #R$DB67 if the dictionary index is #N$60.
 $DAC8 JP Z,$DB67    ; }
 $DACB CALL $DAE8    ; {Jump to #R$DAEF if the character is a digit.
 $DACE JP NC,$DAEF   ; }
 $DAD1 LD B,$B0      ; {Jump ahead to #R$DAE2 if it is #N$2E.
 $DAD3 CP $2E        ;
 $DAD5 JR Z,$DAE2    ; }
 $DAD7 LD B,$A0      ; {Jump ahead to #R$DAE2 if it is #N$2C.
 $DAD9 CP $2C        ;
 $DADB JR Z,$DAE2    ; }
 $DADD CP $22        ; {Return unless the character is a quotation mark
 $DADF RET NZ        ; (#N$22).}
 $DAE0 LD B,$90      ; Count #N$90.
@label=TestCommonWord_TestAdvanceThroughRecord
*$DAE2 INC HL        ; Advance through this record.
 $DAE3 LD A,B        ; Read the count.
 $DAE4 LD BC,$0000   ; Clear #REGbc (no time was given).
 $DAE7 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$6F30 }
; LIST#

; Test For A Digit
;
; Used by the routines at #R$D8AD, #R$DAC6, #R$DB59, #R$DB84 and #R$DBF7.
; .
; Sets the carry when #REGa is not a digit (#N$30 to #N$39).
@label=TestDigit
c$DAE8 CP $30        ; {Return if it is below #N$30.
 $DAEA RET C         ; }
 $DAEB CP $3A        ; See whether this byte is past the digits.
 $DAED CCF           ; Reverse the condition.
 $DAEE RET           ; Return.

; Parse A Time
;
; Used by the routine at #R$DAC6.
; .
; Reads hours, an optional ":" and minutes into #REGb/#REGc, then an "A" or "P"
; plus "M" suffix. "A" sets bit 6 of #REGb; "P" sets bit 6 of #REGc for PM.
@label=ParseATime
c$DAEF CALL $DBF7    ; Call #R$DBF7 to start from an empty length.
 $DAF2 LD B,A        ; {Jump ahead to #R$DB05 if this byte is #N$3A.
 $DAF3 LD A,(HL)     ;
 $DAF4 CP $3A        ;
 $DAF6 JR Z,$DB05    ; }
 $DAF8 CP $41        ; {Jump ahead to #R$DB05 when the input character is A.
 $DAFA JR Z,$DB05    ; }
 $DAFC CP $50        ; {Jump ahead to #R$DB05 when the input character is P.
 $DAFE JR Z,$DB05    ; }
 $DB00 CALL $DB56    ; {Jump ahead to #R$DB84 unless the character is a full
 $DB03 JR NZ,$DB84   ; stop, a comma or a space.}
@label=ParseATime_CheckHours
*$DB05 LD A,B        ; {Jump ahead to #R$DB4F if the count is at least #N$3C.
 $DB06 CP $3C        ;
 $DB08 JR NC,$DB4F   ; }
 $DB0A SET 7,B       ; Set bit 7 of the count.
 $DB0C LD C,$00      ; {Start the number at zero, read the input character, and
 $DB0E LD A,(HL)     ; parse it.
 $DB0F CALL $DB56    ; }
 $DB12 JR Z,$DB60    ; Go to #R$DB60 if the character is a full stop, a comma
                     ; or a space.
@label=ParseATime_ReadMinutes
 $DB14 CP $3A        ; {Jump ahead to #R$DB21 if the character is not #N$3A.
 $DB16 JR NZ,$DB21   ; }
 $DB18 INC HL        ; {Step to the next character and call #R$DBF7 to read a
 $DB19 CALL $DBF7    ; number.}
 $DB1C LD C,A        ; {Jump ahead to #R$DB4F if the number is at least #N$3C.
 $DB1D CP $3C        ;
 $DB1F JR NC,$DB4F   ; }
@label=ParseATime_CheckSuffix
*$DB21 LD A,(HL)     ; {Jump ahead to #R$DB60 if the character is a full stop,
 $DB22 CALL $DB56    ; a comma or a space.
 $DB25 JR Z,$DB60    ; }
 $DB27 CP $41        ; {Jump ahead to #R$DB30 if the character is not #N$41.
 $DB29 JR NZ,$DB30   ; }
 $DB2B SET 6,B       ; Set bit 6 of the count.
 $DB2D INC HL        ; {Step to the next input character and continue at
 $DB2E JR $DB37      ; #R$DB37.}
; Accept "AM" or "PM": "A" has already set bit 6 of #REGb, and "P" sets bit 6 of
; #REGc for PM; both then require "M".
@label=ParseATime_AMPM
*$DB30 CP $50        ; {Jump ahead to #R$DB4F if the character is not #N$50.
 $DB32 JR NZ,$DB4F   ; }
 $DB34 SET 6,C       ; {Set bit 6 of #REGc for PM and step to the next
 $DB36 INC HL        ; character.}
@label=ParseATime_CheckM
*$DB37 LD A,(HL)     ; {Jump ahead to #R$DB4F if this byte is not #N$4D.
 $DB38 CP $4D        ;
 $DB3A JR NZ,$DB4F   ; }
@label=ParseATime_TestStepEntry
*$DB3C INC HL        ; Step to the next entry.
; This entry point is used by the routine at #R$DB84.
*$DB3D LD A,(HL)     ; {Jump back to #R$DB3C if this byte is #N$2E.
 $DB3E CP $2E        ;
 $DB40 JR Z,$DB3C    ; }
 $DB42 CALL $DB59    ; {Jump ahead to #R$DB60 if the character is a comma or a
 $DB45 JR Z,$DB60    ; space.}
 $DB47 CP $0D        ; {Jump to #R$DB5F if the player pressed "ENTER".
 $DB49 JR Z,$DB5F    ; }
 $DB4B CP $22        ; {Jump ahead to #R$DB5F if the character is #N$22.
 $DB4D JR Z,$DB5F    ; }
; This entry point is used by the routine at #R$DB84.
@label=ParseATime_SignalNothingMatched
*$DB4F XOR A         ; Set the zero flag.
 $DB50 LD A,$D0      ; Leave #N$D0 as the result.
 $DB52 LD BC,$0000   ; Clear #REGbc (no time was given).
 $DB55 RET           ; Return.

; Test For A Full Stop
;
; Used by the routine at #R$DAEF.
; .
; Returns at once when the character is a sentence stop.
@label=TestFullStop_TestReturnsCharacterSentence
c$DB56 CP $2E        ; {Return if the input is #N$2E.
 $DB58 RET Z         ; }

; Test For A Comma
;
; Used by the routine at #R$DAEF.
; .
; Returns at once for a comma, and also accepts a blank as the end of a word.
@label=TestComma
c$DB59 CP $2C        ; {Return if the input is #N$2C.
 $DB5B RET Z         ; }
 $DB5C CP $20        ; See whether the character just read is a space.
 $DB5E RET           ; Return.
; This entry point is used by the routine at #R$DAEF.
; .
; Step back one character and return #N$F0.
@label=TestComma_TestStepOneByte
*$DB5F DEC HL        ; Step back one entry.
; This entry point is used by the routine at #R$DAEF.
*$DB60 XOR A         ; Set the zero flag.
 $DB61 LD A,$F0      ; Leave #N$F0 as the result.
 $DB63 RET           ; Return.
 $DB64 DEFB $00      ; First number. Written by #R$DB6B and #R$DB84, and read
                     ; by #R$DBC0.
 $DB65 DEFB $00      ; Second number. Written by #R$DB6B, #R$DB88, #R$DB94 and #R$DBA8.
                     ; Read by #R$DBCE.
 $DB66 DEFB $00      ; Third number. Written by #R$DB72, #R$DB88, #R$DB9E and #R$DBB7.
                     ; Read by #R$DBDB.
; This entry point is used by the routine at #R$DAC6.
*$DB67 INC HL        ; {Step to the next character and call #R$DBF7 to read a
 $DB68 CALL $DBF7    ; number.}
 $DB6B LD ($DB64),A  ; {Store this number as the first number and clear the
 $DB6E XOR A         ; second number.
 $DB6F LD ($DB65),A  ; }
 $DB72 LD ($DB66),A  ; Clear the third number.
 $DB75 INC HL        ; {Jump to #R$DBC0 if the next character is not a digit.
 $DB76 LD A,(HL)     ;
 $DB77 CALL $DAE8    ;
 $DB7A DEC HL        ;
 $DB7B JR C,$DBC0    ; }
 $DB7D INC HL        ; {Read the next number into #REGb and continue at
 $DB7E CALL $DBF7    ; #R$DB88.
 $DB81 LD B,A        ;
 $DB82 JR $DB88      ; }

; Start A Number
;
; Used by the routine at #R$DAEF.
; .
; Starts a number with the first number cleared, then reads the separator that
; follows.
@label=StartParsedNumber
c$DB84 XOR A         ; {Clear the first number.
 $DB85 LD ($DB64),A  ; }
; This entry point is used by the routine at #R$DB59.
@label=StartParsedNumber_ClearSecondThird
*$DB88 XOR A         ; {Clear the second number and the third number.
 $DB89 LD ($DB65),A  ;
 $DB8C LD ($DB66),A  ; }
 $DB8F LD A,(HL)     ; {Jump ahead to #R$DB9A if the character is not 'S'.
 $DB90 CP $53        ;
 $DB92 JR NZ,$DB9A   ; }
 $DB94 LD A,B        ; {Store the count as the second number.
 $DB95 LD ($DB65),A  ; }
@label=StartParsedNumber_Combine
*$DB98 JR $DBBF      ; Jump ahead to #R$DBBF to combine the number.
; The character 'D' stores the count as the third number.
@label=StartParsedNumber_TestLetterD
*$DB9A CP $44        ; {Jump ahead to #R$DBA4 if the character is not 'D'.
 $DB9C JR NZ,$DBA4   ; }
 $DB9E LD A,B        ; {Store the count as the third number and jump to
 $DB9F LD ($DB66),A  ; #R$DB98.
 $DBA2 JR $DB98      ; }
; A slash stores the count as the second number.
@label=StartParsedNumber_TestSlash
*$DBA4 CP $2F        ; {Jump to #R$DB4F if the character is not '/'.
 $DBA6 JR NZ,$DB4F   ; }
 $DBA8 LD A,B        ; {Store the count as the second number.
 $DBA9 LD ($DB65),A  ; }
 $DBAC INC HL        ; {Jump ahead to #R$DBBF if the next character is '-'.
 $DBAD LD A,(HL)     ;
 $DBAE CP $2D        ;
 $DBB0 JR Z,$DBBF    ; }
 $DBB2 CALL $DAE8    ; {Jump to #R$DB4F if this character is not a digit.
 $DBB5 JR C,$DB4F    ; }
 $DBB7 CALL $DBF7    ; {Read the next number, store it as the third number and
 $DBBA LD ($DB66),A  ; continue at #R$DBC0.
 $DBBD JR $DBC0      ; }
; Steps past this character before the three numbers are combined.
@label=StartParsedNumber_StepPastCharacter
*$DBBF INC HL        ; Step to the next character.
; This entry point is used by the routine at #R$DB59.
@label=StartParsedNumber_CombineNumbers
*$DBC0 PUSH HL       ; {Save the input pointer, load the first number into
 $DBC1 LD A,($DB64)  ; #REGhl and double it.
 $DBC4 LD L,A        ;
 $DBC5 LD H,$00      ;
 $DBC7 ADD HL,HL     ; }
 $DBC8 ADD HL,HL     ; {Multiply #REGhl by ten.
 $DBC9 LD E,L        ;
 $DBCA LD D,H        ;
 $DBCB ADD HL,HL     ;
 $DBCC ADD HL,HL     ;
 $DBCD ADD HL,DE     ; }
 $DBCE LD A,($DB65)  ; {Add the second number and double the total.
 $DBD1 LD E,A        ;
 $DBD2 LD D,$00      ;
 $DBD4 ADD HL,DE     ;
 $DBD5 ADD HL,HL     ; }
 $DBD6 ADD HL,HL     ; {Multiply #REGhl by six.
 $DBD7 LD E,L        ;
 $DBD8 LD D,H        ;
 $DBD9 ADD HL,HL     ;
 $DBDA ADD HL,DE     ; }
 $DBDB LD A,($DB66)  ; {Add the third number and swap it with the saved input
 $DBDE LD E,A        ; pointer.
 $DBDF LD D,$00      ;
 $DBE1 ADD HL,DE     ;
 $DBE2 EX (SP),HL    ; }
 $DBE3 POP BC        ; {Fail through #R$DB4F if the value is #N$4000 or more.
 $DBE4 LD A,B        ;
 $DBE5 CP $40        ;
 $DBE7 JP NC,$DB4F   ; }
 $DBEA SLA C         ; {Move bit 7 of #REGc into #REGb and set bit 7 of #REGc.
 $DBEC RL B          ;
 $DBEE SRL C         ;
 $DBF0 SET 7,C       ; }
 $DBF2 SET 7,B       ; {Set bit 7 of #REGb and continue at #R$DB3D.
 $DBF4 JP $DB3D      ; }

; Parse An Input Number
;
; Used by the routines at #R$DAEF, #R$DB59 and #R$DB84.
; .
; Reads decimal digits from the input and returns the number they make in
; #REGa.
@label=ParseInputNumber
c$DBF7 PUSH BC                          ; {Count #N$00.
 $DBF8 LD C,$00                         ; }
@label=ParseInputNumber_DigitLoop
*$DBFA LD A,(HL)                        ; {Jump to #R$DC10 if this character is
 $DBFB CALL $DAE8                       ; not a digit.
 $DBFE JR C,$DC10                       ; }
 $DC00 SUB $30                          ; {Reduce the total by #N$30.
 $DC02 LD B,A                           ;
 $DC03 RLC C                            ;
 $DC05 LD A,C                           ;
 $DC06 RLC C                            ; }
 $DC08 RLC C                            ; {Fold this digit into the number and
 $DC0A ADD A,C                          ; go back to #R$DBFA for the next one.
 $DC0B ADD A,B                          ;
 $DC0C LD C,A                           ;
 $DC0D INC HL                           ;
 $DC0E JR $DBFA                         ; }
; Return.
@label=ParseInputNumber_ReturnValue
*$DC10 LD A,C                           ; Read the low byte of the count.
 $DC11 POP BC                           ; Restore #REGbc from the stack.
 $DC12 RET                              ; Return.
 $DC13 DEFB $00                         ; Length of the dictionary word. Written by #R$DA74 and read by #R$DA1A and
                                        ; #R$DA7D.
 $DC14 DEFB $00                         ; Longest match accepted so far. Cleared by #R$D9DE, updated by #R$DAA9, and
                                        ; read by #R$DA12, #R$DA83 and #R$DA9D.
; This entry point is used by the routines at #R$9A80, #R$9AA3, #R$C628,
; #R$C6BE, #R$C929, #R$CBA7, #R$D6C1, #R$D85B, #R$DCA7, #R$DCDD, #R$DD35,
; #R$DEE4, #R$DFCC, #R$E17B, #R$E28D, #R$E2EE, #R$E3A9, #R$E3F5, #R$E4FB,
; #R$E560, #R$E58C, #R$E5C3, #R$E619, #R$E686, #R$E6F6, #R$F19D, #R$F1D6 and
; #R$F389.
; .
; Shared exit. Returns zero for both results so the caller treats the test as
; failed.
@label=ParseInputNumber_ReturnZero
*$DC15 XOR A                            ; {Clear #REGa and #REGhl.
 $DC16 LD L,A                           ;
 $DC17 LD H,A                           ; }
 $DC18 RET                              ; Return.
 $DC19 DEFB $1B,$20,$40,$28,$00,$00,$00 ; Display record read by #R$C9BF: flags #N$1B, value #N$20, parameters #N$40, #N$28,
                                        ; #N$00, #N$00, #N$00.
; Run by #R$CA64 after the display record at #R$DC19.
 $DC20 CALL $DC6C                       ; {Return if the character check did
 $DC23 RET NZ                           ; not match.}
 $DC24 LD A,($A034)                     ; {Call #R$D46C to find an object by
 $DC27 CALL $D46C                       ; field one.}
 $DC2A LD A,(IX+$02)                    ; {Jump to #R$DC4B if the location is
 $DC2D AND A                            ; zero.
 $DC2E JR Z,$DC4B                       ; }
 $DC30 LD B,A                           ; {Keep the location in #REGb, save the
 $DC31 LD A,($A00A)                     ; character attribute and take #N$01.
 $DC34 PUSH AF                          ;
 $DC35 LD A,$01                         ; }
 $DC37 LD ($D0DC),A                     ; Record the location token processing
                                        ; flag.
; Compare current character.
 $DC3A CALL $DD0B                       ; Call #R$DD0B to read the character
                                        ; the command is about.
 $DC3D LD A,($A00A)                     ; {Read the character attribute.
 $DC40 CALL $D1B2                       ;
 $DC43 POP BC                           ; }
; Compare current character.
 $DC44 CALL $DD0B                       ; Call #R$DD0B to read the character
                                        ; the command is about.
 $DC47 XOR A                            ; Start from zero.
; Record the result in the location token processing flag at #R$D0DC, then mark
; success for the script.
 $DC48 LD ($D0DC),A                     ; Store it in the location token
                                        ; processing flag.
@label=ParseInputNumber_ReportSuccess
*$DC4B OR %00000001                     ; Reset the zero flag.
 $DC4D RET                              ; Return.
; Reached through the display record at #R$DC57, dispatched by #R$CB40.
 $DC4E LD A,($A034)                     ; {Call #R$D46C to find an object by
 $DC51 CALL $D46C                       ; field one.}
 $DC54 JP $DCDD                         ; Go to #R$DCDD to read the schedule
                                        ; entry from the current character.
 $DC57 DEFB $4B,$20,$4E,$DC             ; Display record read by #R$C9BF: flags
                                        ; #N$4B, value #N$20, handler #R$DC4E.
; Run by #R$CA64 after the display record at #R$DC57.
 $DC5B LD A,(IX+$00)                    ; Read the character id from this
                                        ; record.
 $DC5E LD ($A033),A                     ; Store it as the saved character.
 $DC61 XOR A                            ; Start from zero.
 $DC62 LD ($A00F),A                     ; Clear the display mode.
 $DC65 DEC A                            ; Count down one.
 $DC66 LD ($A034),A                     ; Store #N$FF as the room display
                                        ; parameter.
 $DC69 JP $DD07                         ; Go to #R$DD07 to read the matched
                                        ; character's room.

; Check Character ID
;
; Used by the routines at #R$A2E4, #R$CAAF, #R$CB43, #R$DBF7 and #R$DEE4.
; .
; Sets the zero flag if the current character is #N$00, #N$01 or Sherlock
; (#N$64); otherwise returns non-zero.
@label=CheckCharacterID
c$DC6C LD A,($A036)  ; {Return if the character is zero.
 $DC6F CP $00        ;
 $DC71 RET Z         ; }
 $DC72 CP $01        ; {Return if it is #N$01.
 $DC74 RET Z         ; }
 $DC75 CP $64        ; {Return if the character is Sherlock (#N$64).
 $DC77 RET Z         ; }
 $DC78 OR %00000001  ; Reset the zero flag.
 $DC7A RET           ; Return.
 $DC7B DEFB $20,$10  ; Display record read by #R$C9BF: flags #N$20, value
                     ; #N$10.
; Run by #R$CA64 after the display record at #R$DC7B.
 $DC7D CALL $DC6C    ; Call #R$DC6C to see whether the character is zero, one,
                     ; or Sherlock.
 $DC80 RET NZ        ; Return unless the character is zero, one, or Sherlock.
; Print newline.
 $DC81 CALL $A2A2    ; Call #R$A2A2 to print a new line.
 $DC84 LD A,($A00A)  ; {Read the character attribute, then call #R$D102 to run location token
 $DC87 CALL $D102    ; display.}
 $DC8A OR %00000001  ; Reset the zero flag.
 $DC8C RET           ; Return.

; Copy The Saved Character Id
;
; Copies the saved character's id onto the current object.
; A non-zero return means the script step succeeded.
; Run through the table at #R$9F38 by #R$C972.
@label=CopySavedCharacterIdentifier
c$DC8D DEFB $6A,$10,$B8,$DD ; Display record read by #R$C9BF: flags #N$6A,
                            ; value #N$10, handler #R$DDB8.
; Run by #R$CA64 after the display record at #R$DC8D.
 $DC91 LD IX,($A013)        ; {Read the current object and read the current
 $DC95 LD IY,($A017)        ; character record.}
 $DC99 LD A,(IY+$01)        ; {Store the moved marker.
 $DC9C LD (IX+$01),A        ; }
 $DC9F OR %00000001         ; Reset the zero flag.
 $DCA1 RET                  ; Return.
; Reached through the display record at #R$DCC1, dispatched by #R$CB40.
; .
; The room display parameter is #N$FF or #N$FE, or the object's room matches
; the character.
 $DCA2 CALL $D26C           ; {Jump ahead to #R$DCB6 if the room display parameter is #N$FF or #N$FE, or the
 $DCA5 JR C,$DCB6           ; object's room byte matches the character being processed.
                            ; }

; Apply The Room Display Parameter
;
; Used by the routine at #R$E3F5.
; .
; Tests the room named for the picture, and returns the failure the script expects when the test
; does not pass.
@label=ApplyRoomDisplay
c$DCA7 LD A,($A036)         ; {Call #R$D278 to test for the end marker.
 $DCAA LD HL,$A034          ;
 $DCAD CALL $D278           ; }
 $DCB0 JP C,$DC15           ; Go to #R$DC15 to return zero when the carry is
                            ; set.
 $DCB3 OR %00000001         ; Reset the zero flag.
 $DCB5 RET                  ; Return.
; This entry point is used by the routine at #R$DC8D.
; .
; Hands the following step back to the caller and reports that the test failed.
@label=ApplyRoomDisplay_ReturnText
*$DCB6 LD HL,$DCBB          ; Hand back the address of the following step.
 $DCB9 XOR A                ; Clear #REGa.
 $DCBA RET                  ; Return.
 $DCBB LD HL,$68B7          ; {Jump back to #R$A59F to print this message.
 $DCBE JP $A59F             ; }
 $DCC1 DEFB $69,$10,$A2,$DC ; Display record read by #R$C9BF: flags #N$69,
                            ; value #N$10, handler #R$DCA2.
; Run by #R$CA64 after the display record at #R$DCC1.
 $DCC5 LD IX,($A013)        ; Read the current object.
 $DCC9 LD A,($A036)         ; Read the character being processed.
 $DCCC LD (IX+$01),A        ; Store it on the object.
 $DCCF OR %00000001         ; Reset the zero flag.
 $DCD1 RET                  ; Return.
; Reached through the display record at #R$DD03, dispatched by #R$CB40.
 $DCD2 LD A,($A033)         ; {Call #R$D448 to read the character's room.
 $DCD5 CALL $D448           ; }
@label=ApplyRoomDisplay_Loop
 $DCD8 CP $FF               ; {Return zero through #R$DC15 when the character
 $DCDA JP Z,$DC15           ; id is the end marker.}

; Read The Schedule Entry From The Current Character
;
; Used by the routine at #R$DBF7.
; .
; Fails the script unless the character's script position and location allow
; the object description. A non-zero return means the script step succeeded.
@label=ReadScheduleEntryFromCurrentCharacter
c$DCDD CALL $CBA7    ; Call #R$CBA7 to check the flag and start a new line.
 $DCE0 LD IY,($A017) ; Read the current character record.
 $DCE4 LD A,(IY+$01) ; {Jump to #R$DC15 unless #REGiy+#N$01 is #N$FF.
 $DCE7 CP $FF        ;
 $DCE9 JP NZ,$DC15   ; }
 $DCEC LD A,(IX+$02) ; {Return zero through #R$DC15 if the location is zero.
 $DCEF AND A         ;
 $DCF0 JP Z,$DC15    ; }
 $DCF3 LD A,(IX+$01) ; {Load the byte at #REGix+#N$01 and call #R$DD35.
 $DCF6 CALL $DD35    ; }
 $DCF9 JP NZ,$DC15   ; Return zero through #R$DC15 if #R$DD35 returns non-zero.
 $DCFC OR %00000001  ; Reset the zero flag.
 $DCFE RET           ; Return.

; Word: Looked-Up Room Record
;
; Room record #R$DD24 stores after the lookup.
; Read by #R$CA9E and #R$E4F3.
g$DCFF DEFW $0000

; Word: Room Saved For The Lookup
;
; The low byte is the room id #R$DD1E stores before the lookup, or zero when that
; room was #N$FF. #R$CA9E reads it. The high byte stays zero.
g$DD01 DEFW $0000

; Display Record
;
; Display record read by #R$C9BF: flags #N$60, value #N$20, handler #R$DCD2.
b$DD03 DEFB $60,$20,$D2,$DC

; Read Matched Character Room
;
; Used by the routine at #R$DBF7.
; .
; Reads the room stored on the character that matched the search.
; Run by #R$CA64 after the display record at #R$DD03.
@label=MatchedCharacterRoom
c$DD07 LD A,(IX+$02) ; Read the room stored on the matched character.
 $DD0A LD B,A        ; Keep that room beside the character id.

; Compare Current Character
;
; Used by the routine at #R$DBF7.
; .
; Reads the character the command is about.
@label=CompareCurrentCharacter
c$DD0B LD A,($A036)  ; Read the character being processed.

; Match The Character And Store Its Room
;
; Used by the routines at #R$9AA3, #R$9C43, #R$E28D and #R$E3F5.
; .
; When this is the character being processed, stores that character's room and
; looks the object up.
@label=StoreMatchedCharacterRoom
c$DD0E PUSH AF       ; {Take the character being processed.
 $DD0F LD HL,$A036   ; }
 $DD12 CP (HL)       ; {Jump ahead to #R$DD19 if this is not the character
 $DD13 LD A,B        ; being processed.
 $DD14 JR NZ,$DD19   ; }
 $DD16 LD ($A00A),A  ; Record the current character attribute.
@label=StoreMatchedCharacterRoom_Next
*$DD19 CP $FF        ; {Jump ahead to #R$DD1E unless #REGb is #N$FF.
 $DD1B JR NZ,$DD1E   ; }
 $DD1D XOR A         ; Start the character from zero.
*$DD1E LD ($DD01),A  ; {Store the room at #R$DD01 and call #R$D224 to look it
 $DD21 CALL $D224    ; up.}
 $DD24 LD ($DCFF),IX ; Store the current record at #R$DCFF.
 $DD28 POP AF        ; {Call #R$D237 to look up that object.
 $DD29 CALL $D237    ; }
 $DD2C LD (IX+$0F),B ; {Store it in the character attribute, then call #R$D249 to run object location
 $DD2F CALL $D249    ; recursively.}
 $DD32 OR %00000001  ; Reset the zero flag.
 $DD34 RET           ; Return.

; Describe Object If Present
;
; Used by the routine at #R$DCDD.
; .
; Returns zero when #REGa is zero, or when a bit of #N$28 is set in the
; object's attribute and its location is not below #REGiy+#N$02. Any other
; object returns non-zero.
@label=DescribeObjectIfPresent
c$DD35 AND A                            ; {Return if the object is zero.
 $DD36 RET Z                            ; }
 $DD37 PUSH IX                          ; {Call #R$D237 to look up that object.
 $DD39 CALL $D237                       ; }
 $DD3C LD A,(IX+$05)                    ; Read the object attribute.
; None of the bits #N$28 are set in the object attribute?
 $DD3F AND $28                          ; {Jump to #R$DD4F if none of the bits
 $DD41 LD A,(IX+$02)                    ; #N$28 are set in the object
 $DD44 POP IX                           ; attribute.
 $DD46 JR Z,$DD4F                       ; }
 $DD48 CP (IY+$02)                      ; {Go to #R$DD4F if the object's
 $DD4B JR C,$DD4F                       ; location is below the byte at
                                        ; #REGiy+#N$02.}
 $DD4D XOR A                            ; Clear #REGa.
 $DD4E RET                              ; Return.
@label=DescribeObjectIfPresent_Next
*$DD4F OR %00000001                     ; Reset the zero flag.
 $DD51 RET                              ; Return.
; Named from the script commands at #R$E460 and #R$E7BE.
 $DD52 DEFB $A4,$00                     ; Display record read by #R$C9BF: flags
                                        ; #N$A4, value #N$00.
 $DD54 DEFB $17,$61,$DD,$FD,$FF,$60,$DD ; #SCRIPT($07)
 $DD5B DEFB $11,$FD,$60,$DD             ; #SCRIPT($04)
 $DD5F DEFB $0B                         ; #SCRIPT($01)
 $DD60 DEFB $0A                         ; #SCRIPT($01)
 $DD61 DEFB $64,$00,$6E,$DD             ; Display record read by #R$C9BF: flags
                                        ; #N$64, value #N$00, handler #R$DD6E.
; Run by #R$CA64 after the display record at #R$DD61.
 $DD65 LD A,(IX+$00)                    ; {Read the object's first byte and
 $DD68 LD ($9FD7),A                     ; store it as the location value.}
 $DD6B OR %00000001                     ; Reset the zero flag.
 $DD6D RET                              ; Return.
; Reached through the display record at #R$DD61, dispatched by #R$CB40.
 $DD6E LD A,($A034)                     ; {Read the room display parameter and
 $DD71 CALL $D471                       ; call #R$D471 to find an object by
                                        ; field two.}
 $DD74 CP $FF                           ; {Go to #R$DC15 if it is #N$FF.
 $DD76 JP Z,$DC15                       ; }
 $DD79 LD A,(IX+$00)                    ; {Return zero through #R$DC15 if the
 $DD7C CP $0B                           ; record's flag byte is at least #N$0B.
 $DD7E JP NC,$DC15                      ; }
 $DD81 OR %00000001                     ; Reset the zero flag.
 $DD83 RET                              ; Return.
; Named from the script commands at #R$E476 and #R$E7CF.
 $DD84 DEFB $6D,$00,$91,$DD             ; Display record read by #R$C9BF: flags
                                        ; #N$6D, value #N$00, handler #R$DD91.
; Run by #R$CA64 after the display record at #R$DD84.
 $DD88 LD A,(IX+$01)                    ; {Record the current room.
 $DD8B LD ($9FD6),A                     ; }
 $DD8E OR %00000001                     ; Reset the zero flag.
 $DD90 RET                              ; Return.
 $DD91 LD IX,($A013)                    ; Read the current object.
 $DD95 LD A,(IX+$01)                    ; {Go to #R$DC15 if the moved marker is
 $DD98 AND A                            ; #N$FF.
 $DD99 INC A                            ;
 $DD9A JP Z,$DC15                       ; }
 $DD9D RET                              ; Return.
 $DD9E DEFB $0D,$10                     ; Display record read by #R$C9BF: flags
                                        ; #N$0D, value #N$10.
; Run by #R$CA64 after the display record at #R$DD9E.
 $DDA0 LD A,($A034)                     ; Read the room display parameter.
 $DDA3 CALL $CC0E                       ; Call #R$CC0E to find the character.
; Was this character #N$FF?
 $DDA6 CP $FF                           ; {Use zero and go to #R$DDAE if this
 $DDA8 LD A,$00                         ; character is #N$FF.
 $DDAA JR Z,$DDAE                       ; }
 $DDAC LD A,$01                         ; Take #N$01.
*$DDAE CALL $B86A                       ; {Call #R$B86A.
 $DDB1 OR $01                           ; }
 $DDB3 RET                              ; Return.
 $DDB4 DEFB $40,$50,$B8,$DD             ; Display record read by #R$C9BF: flags
                                        ; #N$40, value #N$50, handler #R$DDB8.
; Reached through the display record at #R$DC8D, #R$DDB4 and #R$DDD0,
; dispatched by #R$CB40.
; .
; Run by #R$CA64 after the display record at #R$DDB4.
 $DDB8 CALL $CBA7                       ; {Call #R$CBA7.
 $DDBB OR $01                           ; }
 $DDBD RET                              ; Return.
; Named from the script commands at #R$EEBE, #R$EEE4, #R$EF04, #R$EF54, #R$EF75, #R$F0E9,
; #R$F22D, #R$F246, #R$F25B, #R$F268, #R$F278, #R$F28D and #R$F2AC.
 $DDBE DEFB $40,$00,$B8,$DD             ; Display record read by #R$C9BF: flags
                                        ; #N$40, value #N$00, handler #R$DDB8.
; Run by #R$CA64 after the display record at #R$DDBE.
 $DDC2 LD A,($A034)                     ; {Store the room display parameter in
 $DDC5 LD ($A01F),A                     ; the character script cycle.}
 $DDC8 OR %00000001                     ; Reset the zero flag.
 $DDCA RET                              ; Return.
 $DDCB DEFW $0000                       ; The location text pointer, read by
                                        ; #R$DD35 and #R$DE60.
 $DDCD DEFW $0000                       ; The object's description pointer,
                                        ; read by #R$DD35 and #R$DE60.
 $DDCF DEFB $00                         ; Data bytes #N$00, read by #R$DD35.
 $DDD0 DEFB $45,$00,$B8,$DD             ; Display record read by #R$C9BF: flags
                                        ; #N$45, value #N$00, handler #R$DDB8.
; Run by #R$CA64 after the display record at #R$DDD0.
 $DDD4 LD HL,($A02F)                    ; Read the display pointer.
 $DDD7 RES 7,H                          ; {Clear the marker.
 $DDD9 PUSH HL                          ;
 $DDDA LD A,H                           ; }
@label=DescribeObjectIfPresent_MaskName
 $DDDB AND $3F                          ; {Keep the low six bits of the name,
 $DDDD LD H,A                           ; then call #R$DE48 to scale the high
 $DDDE LD A,L                           ; byte by sixty.
 $DDDF AND $3F                          ;
 $DDE1 LD L,A                           ;
 $DDE2 CALL $DE48                       ; }
 $DDE5 LD ($DDCD),HL                    ; Remember the object's description.
 $DDE8 LD HL,($9FDF)                    ; {Scale the word at #R$9FDF by sixty.
 $DDEB CALL $DE48                       ; }
 $DDEE LD ($DDCB),HL                    ; {Remember the location text.
 $DDF1 POP HL                           ;
 $DDF2 LD A,$61                         ; }
 $DDF4 LD ($DDCF),A                     ; Store it in the workspace byte at
                                        ; #R$DDCF.
 $DDF7 BIT 6,H                          ; {Jump ahead to #R$DE19 if bit 6 is
 $DDF9 JR NZ,$DE19                      ; present.}
 $DDFB LD A,$70                         ; {Write the letter p into the
 $DDFD LD ($DDCF),A                     ; description marker.}
 $DE00 BIT 6,L                          ; {Jump ahead to #R$DE19 if bit 6 is
 $DE02 JR NZ,$DE19                      ; present.}
 $DE04 CALL $DE60                       ; {Call #R$DE60, read the AM/PM letter
 $DE07 LD A,($9FE2)                     ; at #R$9FE2 and go to #R$DE0E if the
 $DE0A JR C,$DE0E                       ; description pointer is below the
                                        ; location text.}
 $DE0C JR NZ,$DE16                      ; Go to #R$DE16 if the description is
                                        ; past the location text.
; Is the marker the letter a?
@label=DescribeObjectIfPresent_Letter
*$DE0E CP $61                           ; {Use the letter p when the marker is
 $DE10 LD A,$70                         ; the letter a.
 $DE12 JR Z,$DE16                       ; }
 $DE14 LD A,$61                         ; Take the letter a.
@label=DescribeObjectIfPresent_WorkspaceByte
*$DE16 LD ($DDCF),A                     ; Store it in the workspace byte at
                                        ; #R$DDCF.
@label=DescribeObjectIfPresent_ObjectDescriptionLocation
*$DE19 LD HL,($DDCD)                    ; {Read the object's description and
 $DE1C LD DE,($DDCB)                    ; the location text.}
 $DE20 AND A                            ; {Subtract the value at #R$DDCB from
 $DE21 SBC HL,DE                        ; the one at #R$DDCD and take
 $DE23 LD DE,$02D0                      ; #N($02D0,$04), the half-day step
                                        ; added at #R$DE39.}
 $DE26 LD A,($9FE2)                     ; {Read the AM/PM marker into #REGc and
 $DE29 LD C,A                           ; the description marker at #R$DDCF
 $DE2A LD A,($DDCF)                     ; into #REGb.
 $DE2D LD B,A                           ; }
 $DE2E CALL $DE60                       ; {Jump to #R$DE3C if the object's description pointer is below the location text
 $DE31 JR C,$DE3C                       ; pointer.}
 $DE33 JR Z,$DE3C                       ; Go to #R$DE3C if the object's
                                        ; description pointer equals the
                                        ; location text pointer.
 $DE35 LD A,B                           ; {Go to #R$DE42 if the description
 $DE36 CP C                             ; marker matches AM/PM.
 $DE37 JR Z,$DE42                       ; }
 $DE39 ADD HL,DE                        ; {The hours differ, so add one step
 $DE3A JR $DE42                         ; and store the total from #R$DE42.}
; Add one step, and a second step when the description marker matches.
@label=DescribeObjectIfPresent_AdvancePointerSource
*$DE3C ADD HL,DE                        ; {Add one step, and go to #R$DE42 if
 $DE3D LD A,B                           ; the description marker does not match
 $DE3E CP C                             ; AM/PM.
 $DE3F JR NZ,$DE42                      ; }
 $DE41 ADD HL,DE                        ; Add one more step to the cycle count.
@label=DescribeObjectIfPresent_RecordCharacterScript
*$DE42 LD ($A01F),HL                    ; Record the character script cycle.
 $DE45 OR %00000001                     ; Reset the zero flag.
 $DE47 RET                              ; Return.

; Scale The High Byte By Sixty
;
; Used by the routine at #R$DD35.
; .
; Returns the low byte plus sixty times the high byte. When the high byte is #N$0C, only
; the low byte is kept.
@label=ScaleHighByteBySixty
c$DE48 PUSH DE       ; {Clear the pointer.
 $DE49 PUSH BC       ;
 $DE4A LD C,L        ;
 $DE4B LD B,H        ;
 $DE4C LD HL,$0000   ; }
 $DE4F LD DE,$003C   ; Take sixty (#N$3C), the scale for the high byte.
 $DE52 LD A,B        ; {Go to #R$DE5A when the high byte is #N$0C, so only the
 $DE53 CP $0C        ; low byte is kept.
 $DE55 JR Z,$DE5A    ; }
@label=ScaleHighByteBySixty_Hour
*$DE57 ADD HL,DE     ; {Add sixty to #REGhl once per hour in #REGb.
 $DE58 DJNZ $DE57    ; }
@label=ScaleHighByteBySixty_AddLowByte
*$DE5A LD B,$00      ; Clear the high byte of the count.
 $DE5C ADD HL,BC     ; Advance the pointer by the count.
 $DE5D POP BC        ; {Restore the saved count and the saved source from the
 $DE5E POP DE        ; stack.}
 $DE5F RET           ; Return.

; Measure The Gap Between The Two Pointers
;
; Used by the routine at #R$DD35.
; .
; Measures the gap between the object's description and the location text.
@label=MeasureGapBetweenTwoPointers_Next
c$DE60 PUSH HL                          ; {Read the object's description.
 $DE61 PUSH DE                          ;
 $DE62 LD HL,($DDCD)                    ; }
 $DE65 LD DE,($DDCB)                    ; Read the location text.
 $DE69 AND A                            ; Clear the carry before subtracting
                                        ; the two text pointers.
 $DE6A SBC HL,DE                        ; Subtract the two text pointers to
                                        ; measure the gap.
 $DE6C POP DE                           ; {Restore the saved source and the
 $DE6D POP HL                           ; saved pointer from the stack.}
 $DE6E RET                              ; Return.
 $DE6F DEFB $20,$10                     ; Display record read by #R$C9BF: flags
                                        ; #N$20, value #N$10.
; Run by #R$CA64 after the display record at #R$DE6F.
 $DE71 CALL $A2A2                       ; Call #R$A2A2 to print a new line.
 $DE74 LD HL,$68AD                      ; {Take the message, then call #R$A59F
 $DE77 CALL $A59F                       ; to print the message.}
 $DE7A LD A,($A036)                     ; {Call #R$D4CC to count objects in
 $DE7D CALL $D4CC                       ; location.}
 $DE80 AND A                            ; See whether it is zero.
 $DE81 LD HL,$6900                      ; {Point at the text at #R$68E9+#N$17, and go to #R$DE8C to list the objects when the count
 $DE84 JR NZ,$DE8C                      ; is not zero.}
 $DE86 CALL $A59F                       ; {Call #R$A59F to print the message.
 $DE89 OR $01                           ; }
 $DE8B RET                              ; Return.
; Store the result in the low byte of the count, then read the character
; attribute, then store the result in the count.
@label=MeasureGapBetweenTwoPointers_ResultLowByte
*$DE8C LD C,A                           ; {Read the current character
 $DE8D LD A,($A00A)                     ; attribute.
 $DE90 LD B,A                           ; }
 $DE91 LD A,($A036)                     ; {Read the character being processed, then call #R$D51A to list the objects
 $DE94 CALL $D51A                       ; and describe them.}
 $DE97 CALL $A2A2                       ; {Call #R$A2A2 to print a new line.
 $DE9A OR $01                           ; }
 $DE9C RET                              ; Return.
 $DE9D DEFB $38,$10,$80,$21,$00,$00,$00 ; Display record read by #R$C9BF: flags #N$38, value #N$10, parameters #N$80, #N$21,
                                        ; #N$00, #N$00, #N$00.

; Set Bit Five Of The Current Object
;
; Sets bit 5 of the current object's flags and marks success.
; Handler placed after the display record at #R$DE9D. #R$DEB6 clears the bit this handler sets.
; Run by #R$CA64 after the display record at #R$DE9D.
@label=SetCurrentObjectBitFive
c$DEA4 LD IX,($A013)                    ; Read the current object.
 $DEA8 SET 5,(IX+$05)                   ; Set bit 5 of its flags.
 $DEAC OR %00000001                     ; Reset the zero flag.
 $DEAE RET                              ; Return.
 $DEAF DEFB $38,$10,$00,$20,$00,$00,$00 ; Display record read by #R$C9BF: flags #N$38, value #N$10, parameters #N$00, #N$20,
                                        ; #N$00, #N$00, #N$00.

; Clear Bit Five Of The Current Object
;
; Clears bit 5 of the current object's record and marks success.
; Handler placed after the display record at #R$DEAF. #R$DEA4 sets the bit this handler clears.
; Run by #R$CA64 after the display record at #R$DEAF.
@label=ClearCurrentObjectBitFive
c$DEB6 LD IX,($A013)  ; {Read the current object and clear an object flag.
 $DEBA RES 5,(IX+$05) ; }
 $DEBE OR %00000001   ; Reset the zero flag.
 $DEC0 RET            ; Return.

; Store The Character Attribute
;
; Stores the saved character's attribute and the room graphics parameter
; on the current object. A non-zero return means the script step succeeded.
; Run through the table at #R$9F38 by #R$C972.
@label=StoreCharacterAttribute
c$DEC1 DEFB $7A,$18,$D9,$DE,$09,$00,$00,$40 ; {Display record read by #R$C9BF: flags #N$7A, value #N$18, handler #R$DED9,
 $DEC9 DEFB $28                             ; parameters #N$09, #N$00, #N$00, #N$40, #N$28.
                                            ; }
; Run by #R$CA64 after the display record at #R$DEC1.
 $DECA LD A,(IY+$0F)                        ; Read offset #N$0F of the record
                                            ; at #REGiy.
 $DECD LD (IX+$0F),A                        ; Store it at offset #N$0F of the
                                            ; current object.
 $DED0 LD A,($A035)                         ; Read the room graphics parameter.
 $DED3 LD (IX+$01),A                        ; Store it as the moved marker.
 $DED6 OR %00000001                         ; Reset the zero flag.
 $DED8 RET                                  ; Return.
; Reached through the display record at #R$DEC1, dispatched by #R$CB40.
 $DED9 LD IX,($A013)                        ; {Read the current object and read
 $DEDD LD IY,($A015)                        ; the secondary pointer.}
 $DEE1 LD A,($A035)                         ; Read the room graphics parameter.

; Combine The Result With The Character's Room
;
; Used by the routine at #R$E3F5.
; .
; Fails the script unless the low three bits of #REGiy+#N$04 are set and
; #REGiy+#N$02 is above #REGix+#N$02 by more than the object count of the value
; in #REGa. A non-zero return means the script step succeeded.
@label=CombineCharacterRoom
c$DEE4 LD B,A                               ; Keep the value in #REGa as the
                                            ; count.
; None of the bits #N$07 are set in #REGiy+#N$04?
 $DEE5 LD A,(IY+$04)                        ; {Return zero through #R$DC15 if none of the bits #N$07 are set in the
 $DEE8 AND $07                              ; byte at #REGiy+#N$04.
 $DEEA JP Z,$DC15                           ; }
 $DEED LD A,(IY+$02)                        ; {Go to #R$DF00 if the byte at #REGiy+#N$02 is below the byte at
 $DEF0 SUB (IX+$02)                         ; #REGix+#N$02.
 $DEF3 JR C,$DF00                           ; }
 $DEF5 PUSH AF                              ; {Save the difference, take the
 $DEF6 LD A,B                               ; value in #REGb and call #R$D2ED.
 $DEF7 CALL $D2ED                           ; }
 $DEFA LD B,A                               ; {Go to #R$DF00 if that difference
 $DEFB POP AF                               ; is below the object count from
 $DEFC SUB B                                ; #R$D2ED.
 $DEFD JR C,$DF00                           ; }
 $DEFF RET NZ                               ; Return if that difference is
                                            ; above the count from #R$D2ED.
@label=CombineCharacterRoom_ClearResult
*$DF00 XOR A                                ; Clear #REGa.
 $DF01 RET                                  ; Return.
 $DF02 DEFB $6A,$1D,$24,$DF                 ; Display record read by #R$C9BF:
                                            ; flags #N$6A, value #N$1D, handler
                                            ; #R$DF24.
; Run by #R$CA64 after the display record at #R$DF02.
 $DF06 LD IY,($A015)                        ; Read the secondary pointer at
                                            ; #R$A015.
 $DF0A LD IX,($A013)                        ; {Read the current object.
 $DF0E LD A,($A035)                         ; }
 $DF11 LD (IX+$01),A                        ; Store the moved marker.
 $DF14 LD A,(IY+$0F)                        ; {Store the character attribute.
 $DF17 LD (IX+$0F),A                        ;
 $DF1A LD B,A                               ; }
 $DF1B LD A,($A034)                         ; {Read the room display parameter, then call #R$D249 to run object location
 $DF1E CALL $D249                           ; recursively.}
 $DF21 OR %00000001                         ; Reset the zero flag.
 $DF23 RET                                  ; Return.
; Reached through the display record at #R$DF02, dispatched by #R$CB40.
 $DF24 LD A,($A034)                         ; {Pass the room display parameter
 $DF27 LD B,A                               ; in #REGb and the room graphics
 $DF28 LD A,($A035)                         ; parameter in #REGa, and carry on
 $DF2B JP $C8C6                             ; at #R$C8C6.}
; Reached through the display record at #R$DF40 and #R$E135, dispatched by
; #R$CB40.
 $DF2E LD A,($A034)                         ; {Go to #R$DF3D if the mother id
 $DF31 CALL $C8AF                           ; is #N$FF.
 $DF34 JR Z,$DF3D                           ; }
 $DF36 LD HL,$A036                          ; {Go to #R$DC15 if the containing
 $DF39 CP (HL)                              ; object is not this character.
 $DF3A JP NZ,$DC15                          ; }
@label=CombineCharacterRoom_TestActionSucceeded
*$DF3D OR %00000001                         ; Reset the zero flag.
 $DF3F RET                                  ; Return.
 $DF40 DEFB $78,$10,$2E,$DF,$80,$40,$00,$00 ; {Display record read by #R$C9BF: flags #N$78, value #N$10, handler #R$DF2E,
 $DF48 DEFB $00                             ; parameters #N$80, #N$40, #N$00, #N$00, #N$00.
                                            ; }
; Run by #R$CA64 after the display record at #R$DF40.
 $DF49 LD A,$01                             ; Take #N$01 as the room flag.
 $DF4B LD ($CAAE),A                         ; Store the room flag.
 $DF4E CALL $DC6C                           ; Call #R$DC6C to check the
                                            ; character id.
 $DF51 RET NZ                               ; Return unless the character is
                                            ; Sherlock, #N$01, or zero.
 $DF52 CALL $DF5B                           ; Call #R$DF5B to print the
                                            ; object's description.
 $DF55 CALL $A2A2                           ; Call #R$A2A2 to print a new line.
 $DF58 OR %00000001                         ; Reset the zero flag.
 $DF5A RET                                  ; Return.

; Print Object Description Text
;
; Used by the routines at #R$DEE4, #R$E0FF and #R$E151.
; .
; Prints the description text for an object specified by the room display parameter.
; If the object has custom description text, that is printed; otherwise a default description is used.
; Additional object information is then printed followed by a period.
@label=PrintObjectDescriptionText
c$DF5B LD A,($A034)             ; {Read the room display parameter and call
 $DF5E CALL $D237               ; #R$D237 to look up the object.}
 $DF61 SET 6,(IX+$06)           ; Set bit 6 of the object's byte at offset
                                ; #N$06.
 $DF65 LD L,(IX+$0D)            ; {Load the object's description text pointer
 $DF68 LD H,(IX+$0E)            ; from offsets #N$0D/#N$0E.}
 $DF6B LD A,H                   ; {Jump to #R$A59F if the description pointer
 $DF6C OR L                     ; is not zero.
 $DF6D JP NZ,$A59F              ; }
 $DF70 LD HL,$68E1              ; {Take the default object message, then call #R$A59F to print the default object
 $DF73 CALL $A59F               ; message.}
 $DF76 CALL $D3D5               ; {Call #R$D3D5, take a full stop and print it
 $DF79 LD A,$2E                 ; through #R$A9B7.
 $DF7B JP $A9B7                 ; }
 $DF7E DEFB $88,$00             ; Display record read by #R$C9BF: flags #N$88,
                                ; value #N$00.
 $DF80 DEFB $07,$C1,$DC,$FD,$FF ; #SCRIPT($05)
 $DF85 DEFB $07,$8B,$DF,$FD,$FF ; #SCRIPT($05)
 $DF8A DEFB $0B                 ; #SCRIPT($01)
 $DF8B DEFB $08,$00             ; Display record read by #R$C9BF: flags #N$08,
                                ; value #N$00.
; Run by #R$CA64 after the display record at #R$DF8B.
 $DF8D LD A,($9CA1)             ; {Jump to #R$E000 if Basil Phipps's state is
 $DF90 AND A                    ; clear.
 $DF91 JR Z,$E000               ; }
 $DF93 LD A,$FF                 ; {Mark Basil Phipps's state as finished.
 $DF95 LD ($9CA1),A             ; }
 $DF98 LD IX,($A013)            ; Read the current object.
 $DF9C LD HL,$07D5              ; {Store the low byte of the text pointer.
 $DF9F LD (IX+$09),L            ; }
 $DFA2 LD (IX+$0A),H            ; Store the high byte of the text pointer.
 $DFA5 JR $E000                 ; Jump ahead to #R$E000 to return non-zero.
 $DFA7 DEFB $C8,$00,$1C,$E0     ; Display record read by #R$C9BF: flags #N$C8,
                                ; value #N$00, handler #R$E01C.
 $DFAB DEFB $07,$B6,$DF,$FD,$FF ; #SCRIPT($05)
 $DFB0 DEFB $07,$9D,$DE,$FD,$FF ; #SCRIPT($05)
 $DFB5 DEFB $0B                 ; #SCRIPT($01)
 $DFB6 DEFB $07,$F0             ; Display record read by #R$C9BF: flags #N$07,
                                ; value #N$F0.
; Run by #R$CA64 after the display record at #R$DFB6.
 $DFB8 LD A,($A034)             ; {Jump to #R$E000 if the room display
 $DFBB CP $59                   ; parameter is not #N$59.
 $DFBD JP NZ,$E000              ; }
 $DFC0 LD A,($9FE1)             ; {Jump to #R$E000 if the day of the week is
 $DFC3 CP $00                   ; not zero.
 $DFC5 JP NZ,$E000              ; }
 $DFC8 JR $DFCC                 ; Jump to #R$DFCC, the special case object 6.

; Display Record
;
; Display record read by #R$C9BF. The show-message command at #R$EF99 passes this word to
; #R$C591.
;
; .
;
; Named from the script command at #R$EF99.
b$DFCA DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Special Case Object #N$06
;
; Used by the routines at #R$DF5B and #R$EFC9.
; .
; Looks up #OBJECT($06) and fails the match unless his attribute agrees
; with Sherlock's disguise.
; Run by #R$CA64 after the display record at #R$DFCA, from the show-message command at #R$EF99. A non-zero return means the script step succeeded.
@label=SpecialCaseObject_LooksBasilPhipps
c$DFCC LD HL,$759C          ; {Call #R$D237 to look up #N$06.
 $DFCF LD A,$06             ;
 $DFD1 CALL $D237           ; }
 $DFD4 LD A,($A009)         ; {Print the message via #R$9E74 if Sherlock's disguise does not match the
 $DFD7 CP (IX+$0F)          ; character's attribute.
 $DFDA JP NZ,$9E74          ; }
 $DFDD LD HL,$75D2          ; {Take the message at #R$75D2 and print it via
 $DFE0 JP $9E74             ; #R$9E74.}
; Reached through the display record at #R$DFEA, dispatched by #R$CB40.
 $DFE3 LD A,($A036)         ; {Read the character being processed, compare it with Sherlock (#N$64), and go to
 $DFE6 CP $64               ; #R$DFFD, which returns zero through #R$DC15 when they differ.
 $DFE8 JR $DFFD             ; }
 $DFEA DEFB $47,$10,$E3,$DF ; Display record read by #R$C9BF: flags #N$47,
                            ; value #N$10, handler #R$DFE3.
; Run by #R$CA64 after the display record at #R$DFEA.
 $DFEE JR $E007             ; Go to #R$E007.
 $DFF0 DEFB $48,$10,$1C,$E0 ; Display record read by #R$C9BF: flags #N$48,
                            ; value #N$10, handler #R$E01C.
; Run by #R$CA64 after the display record at #R$DFF0.
 $DFF4 LD A,$64             ; {Place character #N$64 from #R$E028.
 $DFF6 JR $E028             ; }
; Reached through the display record at #R$E003, dispatched by #R$CB40.
 $DFF8 LD A,($A036)         ; {Read the character being processed and compare
 $DFFB CP $01               ; it with #N$01.}
*$DFFD JP NZ,$DC15          ; Return zero through #R$DC15 if the character
                            ; being processed is not #N$01.
; This entry point is used by the routine at #R$DF5B.
*$E000 OR %00000001         ; Reset the zero flag.
 $E002 RET                  ; Return.
 $E003 DEFB $47,$10,$F8,$DF ; Display record read by #R$C9BF: flags #N$47,
                            ; value #N$10, handler #R$DFF8.
; Run by #R$CA64 after the display record at #R$E003.
@label=SpecialCaseObject_LooksBasilPhipps_Next
*$E007 XOR A                ; {Call #R$E03A to place character.
 $E008 CALL $E03A           ; }
 $E00B LD IX,($A013)        ; Read the current object.
@label=SpecialCaseObject_ClearMovedMarker
 $E00F LD (IX+$01),$00      ; {Clear the moved marker.
 $E013 LD A,($A00A)         ; }
 $E016 LD (IX+$0F),A        ; Store the character attribute.
 $E019 OR %00000001         ; Reset the zero flag.
 $E01B RET                  ; Return.
; Reached through the display record at #R$DFA7, #R$DFF0, #R$E022 and #R$E0AD,
; dispatched by #R$CB40.
 $E01C LD A,($A036)         ; {Read the character being processed, then clear the borrow so the caller can
 $E01F AND A                ; trust the result.
 $E020 JR $DFFD             ; }
 $E022 DEFB $48,$10,$1C,$E0 ; Display record read by #R$C9BF: flags #N$48,
                            ; value #N$10, handler #R$E01C.
; Run by #R$CA64 after the display record at #R$E022.
 $E026 LD A,$01             ; Take #N$01.
*$E028 CALL $E03A           ; Call #R$E03A to place the character.
 $E02B LD IX,($A013)        ; {Read the current object and clear the moved
 $E02F LD (IX+$01),$00      ; marker.}
 $E033 LD (IX+$0F),$00      ; {Clear the location at #REGix+#N$0F.
 $E037 OR $01               ; }
 $E039 RET                  ; Return.

; Place Character
;
; Used by the routines at #R$DFCC and #R$E17B.
; .
; Moves the character to the room the action names.
@label=PlaceCharacter
c$E03A LD C,A                           ; {Call #R$CC0E to find character.
 $E03B LD A,($A036)                     ;
 $E03E CALL $CC0E                       ; }
; Store that byte in this character's id, then read the schedule entry from the
; current character's record, then read the low byte of the count.
 $E041 LD (IY+$00),C                    ; {Store the character id and read the
 $E044 LD IY,($A017)                    ; current character record.}
 $E048 LD A,C                           ; {Call #R$D237 to look up that object.
 $E049 CALL $D237                       ; }
 $E04C LD ($A017),IX                    ; {Remember this object record and read
 $E050 LD A,(IY+$01)                    ; the marker at #REGiy+#N$01.}
 $E053 LD (IX+$01),A                    ; Store the moved marker.
 $E056 LD (IY+$01),$FF                  ; {Write #N$FF at #REGiy+#N$01 and read
 $E05A LD A,(IY+$0F)                    ; the location at #REGiy+#N$0F.}
 $E05D LD (IX+$0F),A                    ; Store the character attribute.
 $E060 LD (IY+$0F),$00                  ; {Clear the character attribute.
 $E064 LD B,$00                         ; }
@label=PlaceCharacter_Loop
*$E066 INC B                            ; {Go to #R$E07C if the object count
 $E067 LD A,B                           ; has reached #N$6E.
 $E068 CP $6E                           ;
 $E06A JR Z,$E07C                       ; }
 $E06C CALL $D237                       ; Call #R$D237 to look that object up.
 $E06F LD A,($A036)                     ; {Jump back to #R$E066 while the
 $E072 CP (IX+$01)                      ; current character does not match the
 $E075 JR NZ,$E066                      ; moved marker.}
 $E077 LD (IX+$01),C                    ; {Store the room in the character's
 $E07A JR $E066                         ; destination and go back to place
                                        ; them.}
; Writes this value into each matching script entry, then makes it the
; character being processed.
@label=PlaceCharacter_WritesValueEach
*$E07C CALL $CFB6                       ; {Go to #R$E086 if #R$CFB6 found no
 $E07F JR Z,$E086                       ; script entry for this character.}
 $E081 LD (IX+$00),C                    ; {Store the room in the character's
 $E084 JR $E07C                         ; location and go back to place them.}
; Read the low byte of the count, then record the result in the character being
; processed, then return non-zero.
@label=PlaceCharacter_Next
*$E086 LD A,C                           ; {Record the current character.
 $E087 LD ($A036),A                     ; }
 $E08A OR %00000001                     ; Reset the zero flag.
 $E08C RET                              ; Return.
 $E08D DEFB $8D,$04                     ; Display record read by #R$C9BF: flags
                                        ; #N$8D, value #N$04.
 $E08F DEFB $87,$FD,$E5,$FD,$FF,$9B,$E0 ; #SCRIPT($07)
 $E096 DEFB $05,$FD,$9E,$6B             ; #SCRIPT($04)
 $E09A DEFB $0B                         ; #SCRIPT($01)
 $E09B DEFB $02,$1D,$FC,$FF             ; #SCRIPT($04)
 $E09F DEFB $0B                         ; #SCRIPT($01)
 $E0A0 DEFB $88,$00                     ; Display record read by #R$C9BF: flags
                                        ; #N$88, value #N$00.
 $E0A2 DEFB $07,$AD,$E0,$02,$5D         ; #SCRIPT($05)
 $E0A7 DEFB $07,$35,$E1,$FD,$FF         ; #SCRIPT($05)
 $E0AC DEFB $0B                         ; #SCRIPT($01)
 $E0AD DEFB $4D,$07,$1C,$E0             ; Display record read by #R$C9BF: flags
                                        ; #N$4D, value #N$07, handler #R$E01C.
; Run by #R$CA64 after the display record at #R$E0AD.
 $E0B1 LD A,($A00A)                     ; {Jump ahead to #R$E0DD if the current
 $E0B4 CP $58                           ; character attribute is not #N$58.
 $E0B6 JR NZ,$E0DD                      ; }
 $E0B8 LD A,($9FE1)                     ; {Jump to #R$E0DD if the day of the
 $E0BB CP $01                           ; week is not #N$01.
 $E0BD JR NZ,$E0DD                      ; }
 $E0BF LD IX,($A015)                    ; {Read the secondary pointer and set
 $E0C3 SET 7,(IX+$06)                   ; bit 7 of its byte at offset #N$06.}
 $E0C7 SET 7,(IX+$05)                   ; {Mark the object-attribute flag and
 $E0CB LD A,($A00A)                     ; read the character attribute.}
 $E0CE LD (IX+$0F),A                    ; Store the character attribute.
 $E0D1 LD A,($A034)                     ; {Store the moved marker.
 $E0D4 LD (IX+$01),A                    ; }
 $E0D7 LD HL,$7B5A                      ; Point #REGhl at the message at
                                        ; #R$761D+#N$053D.
 $E0DA CALL $A59F                       ; Call #R$A59F to print the message.
*$E0DD OR %00000001                     ; Reset the zero flag.
 $E0DF RET                              ; Return.
 $E0E0 DEFB $88,$00                     ; Display record read by #R$C9BF: flags
                                        ; #N$88, value #N$00.
 $E0E2 DEFB $07,$35,$E1,$FD,$FF         ; #SCRIPT($05)
 $E0E7 DEFB $03,$EB,$E0                 ; #SCRIPT($03)
 $E0EA DEFB $0B                         ; #SCRIPT($01)

; Display Record
;
; Display record read by #R$C9BF. The show-message command at #R$E0E7 passes this word to
; #R$C591.
;
; .
;
; Named from the script command at #R$E0E7.
b$E0EB DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Set The Held Mark
;
; Hands object #N$51 to the held-mark routine.
;
; .
;
; Run by #R$CA64 after the display record at #R$E0EB, from the show-message
; command at #R$E0E7.
@label=SetHeldMark
c$E0ED LD A,$51                 ; {Jump back to #R$9C56 to set object attribute
 $E0EF JP $9C56                 ; bit 7.}
 $E0F2 DEFB $88,$00             ; Display record read by #R$C9BF: flags #N$88,
                                ; value #N$00.
 $E0F4 DEFB $07,$35,$E1,$FD,$FF ; #SCRIPT($05)
 $E0F9 DEFB $03,$FD,$E0         ; #SCRIPT($03)
 $E0FC DEFB $0B                 ; #SCRIPT($01)

; Display Record
;
; Display record read by #R$C9BF. The show-message command at #R$E0F9 passes this word to
; #R$C591.
;
; .
;
; Named from the script command at #R$E0F9.
b$E0FD DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Set The Other Held Mark
;
; Hands object #N$3F to the held-mark routine. A non-zero return means the
; script step succeeded.
;
; .
;
; Run by #R$CA64 after the display record at #R$E0FD, from the show-message
; command at #R$E0F9.
@label=SetHeldMark_OtherObject
c$E0FF LD A,$3F                             ; {Jump back to #R$9C56 to set
 $E101 JP $9C56                             ; object attribute bit 7.}
 $E104 DEFB $08,$60                         ; Display record read by #R$C9BF:
                                            ; flags #N$08, value #N$60.
; Run by #R$CA64 after the display record at #R$E104.
 $E106 LD A,$01                             ; Take #N$01 as the room flag.
 $E108 LD ($CAAE),A                         ; Store #REGa as the room flag.
 $E10B LD A,($A036)                         ; {Return if the character is set.
 $E10E AND A                                ;
 $E10F RET NZ                               ; }
; Print object description text.
 $E110 CALL $DF5B                           ; Call #R$DF5B to print the
                                            ; object's description.
 $E113 LD IX,($A013)                        ; Read the current object.
; An object flag is set?
 $E117 BIT 5,(IX+$05)                       ; {Return if an object flag is set.
 $E11B RET NZ                               ; }
 $E11C SET 5,(IX+$05)                       ; {Set an object flag.
 $E120 LD HL,$7BF7                          ; }
 $E123 LD (IX+$0D),L                        ; Store the low byte of a stored
                                            ; pointer.
 $E126 LD (IX+$0E),H                        ; {Store it in the character record and take the message, then call #R$A59F to
 $E129 LD HL,$7C13                          ; print the message.
 $E12C CALL $A59F                           ; }
 $E12F CALL $A2A2                           ; {Call #R$A2A2 to print a new
 $E132 OR $01                               ; line.}
 $E134 RET                                  ; Return.
 $E135 DEFB $78,$50,$2E,$DF,$80,$40,$00,$00 ; {Display record read by #R$C9BF: flags #N$78, value #N$50, handler #R$DF2E,
 $E13D DEFB $00                             ; parameters #N$80, #N$40, #N$00, #N$00, #N$00.
                                            ; }
; Run by #R$CA64 after the display record at #R$E135.
 $E13E LD A,$01                             ; Take #N$01 as the room flag.
 $E140 LD ($CAAE),A                         ; Store the room flag.
 $E143 LD A,($A036)                         ; Read the character being
                                            ; processed.
 $E146 AND A                                ; {Return if this character id is
 $E147 RET NZ                               ; not zero.}
 $E148 CALL $E151                           ; Call #R$E151 to print the display
                                            ; text.
 $E14B CALL $A2A2                           ; Call #R$A2A2 to print a new line.
 $E14E OR %00000001                         ; Reset the zero flag.
 $E150 RET                                  ; Return.

; Lookup And Print Display Text
;
; Used by the routine at #R$E0FF.
; .
; Looks up a display text message based on the room display parameter and
; prints it to the screen.
;
; .
;
; Print object description text.
@label=LookupAndPrintDisplayText
c$E151 CALL $DF5B    ; Call #R$DF5B to print the object's description.
 $E154 LD A,($A034)  ; {Call #R$D34E to search three-byte length table.
 $E157 LD IX,$E16B   ;
 $E15B CALL $D34E    ; }
 $E15E CP $FF        ; {Return if the entry is the end marker.
 $E160 RET Z         ; }
 $E161 LD L,(IX+$01) ; {Load the text token pointer from the table entry.
 $E164 LD H,(IX+$02) ; }
 $E167 CALL $A59F    ; Call #R$A59F to print the message.
 $E16A RET           ; Return.

; Table: Display Entry Lookup
;
; Lookup table for #R$E151. It maps room display parameter values to text token pointers.
; Each entry consists of a 1-byte parameter value followed by a 2-byte pointer to a text token buffer.
@label=Table_DisplayEntryLookup
g$E16B DEFB $4C      ; Parameter value.
 $E16C DEFW $7BC2    ; Text token pointer.
 $E16E DEFB $66      ; Parameter value.
 $E16F DEFW $7BD7    ; Text token pointer.
 $E171 DEFB $39      ; Parameter value.
 $E172 DEFW $7C9E    ; Text token pointer.
 $E174 DEFB $3E      ; Parameter value.
 $E175 DEFW $7CE7    ; Text token pointer.
 $E177 DEFB $2E      ; Parameter value.
 $E178 DEFW $7C4A    ; Text token pointer.
 $E17A DEFB $FF      ; Terminator.

; Dispatch Room Graphics
;
; Chooses the picture and the room-display handler for the location on screen.
; A non-zero return means the script step succeeded.
; Reached through the object display table at #R$AA71, read by #R$C966.
@label=DispatchRoomGraphics
c$E17B DEFB $8D,$07                     ; Display record read by #R$C9BF: flags
                                        ; #N$8D, value #N$07.
 $E17D DEFB $07,$88,$E1,$FD,$FC         ; #SCRIPT($05)
 $E182 DEFB $07,$D6,$E1,$FD,$FC         ; #SCRIPT($05)
 $E187 DEFB $0B                         ; #SCRIPT($01)
 $E188 DEFB $0D,$07                     ; Display record read by #R$C9BF: flags
                                        ; #N$0D, value #N$07.
; Run by #R$CA64 after the display record at #R$E188.
 $E18A LD A,($A035)                     ; Read the room graphics parameter.
 $E18D CP $10                           ; {Go to #R$E199 if it is #N$10.
 $E18F JR Z,$E199                       ; }
 $E191 CP $43                           ; {Go to #R$E199 if it is #ROOM($43).
 $E193 JR Z,$E199                       ; }
 $E195 CP $11                           ; {Go to #R$E1D3 if it is not
 $E197 JR NZ,$E1D3                      ; #ROOM($11).}
@label=DispatchRoomGraphics_Next
*$E199 LD IX,$9993                      ; Point #REGix at the character state
                                        ; at #R$9993.
 $E19D SET 1,(IX+$03)                   ; Set bit 1 of the action flags.
 $E1A1 JR $E1D3                         ; Return non-zero through #R$E1D3.
 $E1A3 DEFB $8D,$07                     ; Display record read by #R$C9BF: flags
                                        ; #N$8D, value #N$07.
 $E1A5 DEFB $17,$B2,$E1,$FF,$FC,$B1,$E1 ; #SCRIPT($07)
 $E1AC DEFB $07,$D6,$E1,$FD,$FC         ; #SCRIPT($05)
 $E1B1 DEFB $0B                         ; #SCRIPT($01)
 $E1B2 DEFB $00,$07                     ; Display record read by #R$C9BF: flags
                                        ; #N$00, value #N$07.
; Run by #R$CA64 after the display record at #R$E1B2.
 $E1B4 LD A,($A035)                     ; Read the room graphics parameter.
 $E1B7 CP $43                           ; {Go to #R$E1D3 if it is not
 $E1B9 JR NZ,$E1D3                      ; #ROOM($43).}
 $E1BB CALL $C821                       ; {Go to #R$E1C6 if the object is in
 $E1BE JR NZ,$E1C6                      ; this location.}
 $E1C0 CALL $E1FC                       ; {Call #R$E1FC and return zero through
 $E1C3 JP $DC15                         ; #R$DC15.}
; Leave #N$5F as the result, then use the character Pairs as the character
; record, then mark bit 1 of the action flags.
@label=DispatchRoomGraphics_LeaveResultCharacter
*$E1C6 LD A,$5F                         ; {Call #R$E03A to place character.
 $E1C8 CALL $E03A                       ; }
 $E1CB LD IX,$998F                      ; {Set the action-taken flag.
 $E1CF SET 1,(IX+$03)                   ; }
@label=DispatchRoomGraphics_TestActionSucceeded
*$E1D3 OR %00000001                     ; Reset the zero flag.
 $E1D5 RET                              ; Return.
 $E1D6 DEFB $0D,$17                     ; Display record read by #R$C9BF: flags
                                        ; #N$0D, value #N$17.
; Run by #R$CA64 after the display record at #R$E1D6.
 $E1D8 LD A,($A036)                     ; Read the character being processed.
 $E1DB CALL $E207                       ; Call #R$E207 to see whether the id
                                        ; matches a record flag.
 $E1DE JR Z,$E1FC                       ; Go to #R$E1FC if no record flag
                                        ; matches.
 $E1E0 INC IX                           ; {Move to the next graphics entry,
 $E1E2 LD A,($A035)                     ; read the room graphics parameter and
 $E1E5 CALL $E201                       ; call #R$E201.}
 $E1E8 JR Z,$E1FC                       ; Go to #R$E1FC if the looked-up entry
                                        ; is #N$FF.
 $E1EA LD L,(IX+$01)                    ; {Read the message address.
 $E1ED LD H,(IX+$02)                    ; }
; This entry point is used by the routine at #R$E1FC.
@label=DispatchRoomGraphics_Loop
*$E1F0 PUSH AF                          ; {Take the message, then call #R$A59F to print the message, saving result and
 $E1F1 PUSH HL                          ; the pointer.
 $E1F2 LD HL,$6830                      ;
 $E1F5 CALL $A59F                       ; }
; This entry point is used by the routine at #R$E207.
@label=DispatchRoomGraphics_ActionSucceeded
*$E1F8 POP AF                           ; Restore the saved character from the
                                        ; stack.
; This entry point is used by the routine at #R$E207.
*$E1F9 OR %00000001                     ; Reset the zero flag.
 $E1FB RET                              ; Return.

; Print The Line About You
;
; Used by the routine at #R$E17B.
; .
; Prints the line that says "I ... you with that" and joins the shared print
; step.
@label=PrintLineAboutYou
c$E1FC LD HL,$761D   ; {Point #REGhl at the message at #R$761D and jump to
 $E1FF JR $E1F0      ; #R$E1F0.}

; Test For The End Marker
;
; Used by the routine at #R$E17B.
; .
; Walks the three-byte list and returns when the entry is the closing byte.
@label=TestEndMarker_WalksThreeByte
c$E201 CALL $D34E    ; Call #R$D34E to search three-byte length table.
 $E204 CP $FF        ; See whether this byte is the end marker.
 $E206 RET           ; Return.

; Find The Response For This Id
;
; Used by the routine at #R$E17B.
; .
; Finds the response for the id in #REGa in the table at #R$E22A.
@label=FindResponseForThisId
c$E207 LD IX,$E22A   ; Point at the response table at #R$E22A.
@label=FindResponseForThisId_Match
*$E20B CP (IX+$00)   ; {Jump back to #R$E1F9 if this id matches the entry's id.
 $E20E JR Z,$E1F9    ; }
 $E210 PUSH AF       ; {Jump to #R$E1F8 if this is the catch-all entry (#N$FE).
 $E211 LD A,(IX+$00) ;
 $E214 CP $FE        ;
 $E216 JR Z,$E1F8    ; }
 $E218 INC A         ; {Jump to #R$E227 if the table has ended (#N$FF).
 $E219 JR Z,$E227    ; }
 $E21B INC IX        ; {Step to the first group and call #R$D34E to find the
 $E21D LD A,$FF      ; #N$FF that ends it.
 $E21F CALL $D34E    ; }
 $E222 INC IX        ; {Step past the terminator and test the next entry.
 $E224 POP AF        ;
 $E225 JR $E20B      ; }
@label=FindResponseForThisId_Ended
*$E227 POP AF        ; {Drop the saved id and clear #REGa.
 $E228 XOR A         ; }
 $E229 RET           ; Return.

; Table: Responses By Id
;
; Response entries read by #R$E207. An entry starts with an id, followed by
; groups of a code byte and a message address, and ends with #N$FF. Id #N$FE is
; the catch-all. #N$FF ends the table.
@label=Table_ResponsesById
b$E22A DEFB $08,$10,$46,$78,$11,$46,$78,$07 ; {Id #N$08. Codes #N$10, #N$11 and
 $E232 DEFB $F8,$78,$FF                     ; #N$07, messages #R$761D+#N$0229,
                                            ; #R$761D+#N$0229 and
                                            ; #R$761D+#N$02DB.}
 $E235 DEFB $09,$10,$4F,$79,$11,$4F,$79,$06 ; {Id #N$09. Codes #N$10, #N$11 and
 $E23D DEFB $C4,$79,$FF                     ; #N$06, messages #R$761D+#N$0332,
                                            ; #R$761D+#N$0332 and
                                            ; #R$761D+#N$03A7.}
 $E240 DEFB $0A,$10,$35,$7A,$11,$35,$7A,$FF ; Id #N$0A. Codes #N$10 and #N$11,
                                            ; message #R$761D+#N$0418.
 $E248 DEFB $06,$10,$B9,$7A,$11,$B9,$7A,$12 ; {Id #N$06. Codes #N$10, #N$11 and
 $E250 DEFB $2C,$77,$FF                     ; #N$12, messages #R$761D+#N$049C,
                                            ; #R$761D+#N$049C and
                                            ; #R$761D+#N$010F.}
 $E253 DEFB $05,$10,$F6,$7A,$11,$F6,$7A,$0D ; {Id #N$05. Codes #N$10, #N$11,
 $E25B DEFB $A4,$76,$07,$D4,$78,$FF         ; #N$0D and #N$07, messages
                                            ; #R$761D+#N$04D9, #R$761D+#N$04D9,
                                            ; #R$761D+#N$87 and
                                            ; #R$761D+#N$02B7.}
 $E261 DEFB $04,$0F,$71,$73,$FF             ; Id #N$04. Code #N$0F, message
                                            ; #R$722D+#N$0144.
 $E266 DEFB $07,$11,$0C,$78,$12,$22,$77,$FF ; Id #N$07. Codes #N$11 and #N$12,
                                            ; messages #R$761D+#N$01EF and
                                            ; #R$761D+#N$0105.
 $E26E DEFB $0D,$43,$87,$76,$FF             ; Id #N$0D. Code #N$43, message
                                            ; #R$761D+#N$6A.
 $E273 DEFB $5F,$43,$87,$76,$10,$44,$76,$11 ; {Id #N$5F. Codes #N$43, #N$10,
 $E27B DEFB $44,$76,$0D,$2D,$76,$FF         ; #N$11 and #N$0D, messages
                                            ; #R$761D+#N$6A, #R$761D+#N$27,
                                            ; #R$761D+#N$27 and #R$761D+#N$10.}
 $E281 DEFB $FE,$12,$45,$68,$10,$45,$68,$11 ; {Catch-all id #N$FE. Codes #N$12,
 $E289 DEFB $45,$68,$FF                     ; #N$10 and #N$11, message
                                            ; #R$683F+#N$06.}
 $E28C DEFB $FF                             ; Terminator #N$FF.

; Test This Character Against The Room
;
; Used by the routine at #R$E3F5.
; .
; Returns through #R$DC15 when the character being processed is the room
; display parameter. A non-zero return means the script step succeeded.
@label=TestCharacterAgainstRoom
c$E28D LD A,($A036)         ; {Go to #R$DC15 if the character being processed
 $E290 LD HL,$A034          ; is the room display parameter.
 $E293 CP (HL)              ;
 $E294 JP Z,$DC15           ; }
 $E297 RET                  ; Return.
; Reached through the display record at #R$E2C7, dispatched by #R$CB40.
 $E298 LD A,($A034)         ; {Jump to #R$E2A4 if the room display parameter is
 $E29B CP $1E               ; #N$1E.
 $E29D JR Z,$E2A4           ; }
 $E29F CP $21               ; {Return zero through #R$DC15 if the room display
 $E2A1 JP NZ,$DC15          ; parameter is not #ROOM($21).}
@label=TestCharacterAgainstRoom_SearchPairs
*$E2A4 LD A,($A00A)         ; {Call #R$9C07 to search pair table.
 $E2A7 LD C,$00             ;
 $E2A9 CALL $9C07           ; }
 $E2AC JP NZ,$DC15          ; Return zero through #R$DC15 if #R$9C07 finds no
                            ; pair.
 $E2AF LD IX,($A013)        ; Read the current object.
 $E2B3 LD A,(IX+$0F)        ; {Return zero through #R$DC15 if the record is not
 $E2B6 AND A                ; zero.
 $E2B7 JP NZ,$DC15          ; }
 $E2BA LD A,($A034)         ; Read the room display parameter.
 $E2BD CALL $CFB9           ; Call #R$CFB9 to walk the character-script
                            ; entries.
 $E2C0 JP NZ,$DC15          ; Return zero through #R$DC15 if #R$CFB9 finds a
                            ; script entry.
 $E2C3 OR %00000001         ; Reset the zero flag.
 $E2C5 RET                  ; Return.
 $E2C6 DEFB $00             ; Script byte overwritten by #R$9AD9, read by
                            ; #R$9AA3 and #R$9B50.
 $E2C7 DEFB $47,$10,$98,$E2 ; Display record read by #R$C9BF: flags #N$47,
                            ; value #N$10, handler #R$E298.
; Run by #R$CA64 after the display record at #R$E2C7.
 $E2CB LD A,($A00A)         ; Read the character attribute.
 $E2CE LD B,A               ; Keep it as the count.
 $E2CF LD A,($A034)         ; Read the room display parameter.
 $E2D2 INC A                ; Count one more.
 $E2D3 LD ($E2C6),A         ; Store that count in the script byte at #R$E2C6.
 $E2D6 DEC A                ; Count down one.
 $E2D7 CALL $DD0E           ; Call #R$DD0E to match the character and store its
                            ; room.
 $E2DA LD A,($A036)         ; Read the character being processed.
 $E2DD LD B,A               ; Keep it as the count.
 $E2DE LD A,($A034)         ; Read the room display parameter.
 $E2E1 LD C,A               ; Keep that parameter.
 $E2E2 LD DE,$F2B6          ; Take the workspace at #R$F2B6.
 $E2E5 LD A,($E2C6)         ; Read the script byte at #R$E2C6.
 $E2E8 CALL $E2EE           ; Call #R$E2EE to record the room display.
 $E2EB OR %00000001         ; Reset the zero flag.
 $E2ED RET                  ; Return.

; Record The Result In The Room Display
;
; Used by the routine at #R$E28D.
; .
; Records the room display, the graphics parameter and the current character,
; then stores the script position.
@label=RecordResultRoomDisplay
c$E2EE PUSH DE              ; {Record the room display parameter.
 $E2EF LD D,A               ;
 $E2F0 LD A,B               ;
 $E2F1 LD ($A034),A         ;
 $E2F4 LD A,C               ; }
 $E2F5 LD ($A035),A         ; Record the room graphics parameter.
 $E2F8 LD A,($A036)         ; {Record the current character.
 $E2FB PUSH AF              ;
 $E2FC LD A,D               ;
 $E2FD LD ($A036),A         ; }
; Find character.
 $E300 CALL $CC0E           ; Call #R$CC0E to find the character.
 $E303 LD L,(IY+$01)        ; {Read the word at #REGiy+#N$01-#N$02 into #REGhl
 $E306 LD H,(IY+$02)        ; and take #N$02.
 $E309 LD B,$02             ; }
 $E30B CALL $CF80           ; {Call #R$CF80 to allocate memory and store
 $E30E POP AF               ; character.}
 $E30F LD ($A036),A         ; {Record the current character and store the low
 $E312 POP DE               ; byte of #REGde at #REGiy+#N$01.
 $E313 LD (IY+$01),E        ; }
 $E316 LD (IY+$02),D        ; Store the high byte of #REGde at #REGiy+#N$02.
 $E319 OR %00000001         ; Reset the zero flag.
 $E31B RET                  ; Return.
; Reached through the display record at #R$E328, dispatched by #R$CB40.
 $E31C LD IX,($A013)        ; Read the current object.
 $E320 BIT 5,(IX+$06)       ; {Go to #R$DC15 if bit 5 of the current object's
 $E324 JP Z,$DC15           ; byte at offset #N$06 is clear.}
 $E327 RET                  ; Return.
 $E328 DEFB $6A,$10,$1C,$E3 ; Display record read by #R$C9BF: flags #N$6A,
                            ; value #N$10, handler #R$E31C.
; Run by #R$CA64 after the display record at #R$E328.
 $E32C LD HL,$6836          ; Take the message at #R$6830+#N$06.
 $E32F CALL $A59F           ; Call #R$A59F to print the message.
 $E332 LD IX,($A013)        ; {Read the current object.
 $E336 LD L,(IX+$09)        ; }
 $E339 LD H,(IX+$0A)        ; Read the high byte of the text pointer.
 $E33C CALL $A419           ; {Call #R$A419 to print the value in #REGhl, then
 $E33F CALL $A2A2           ; call #R$A2A2 to print a new line.}
 $E342 OR %00000001         ; Reset the zero flag.
 $E344 RET                  ; Return.
; Reached through the display record at #R$E370, dispatched by #R$CB40.
 $E345 CALL $E34F           ; {Return if this character has no room graphic.
 $E348 RET Z                ; }
 $E349 LD A,$25             ; {Write #N$25 to the saved character.
 $E34B LD ($A033),A         ; }
 $E34E RET                  ; Return.

; Read The Character's Text Pointers
;
; Used by the routine at #R$E2EE.
; .
; Looks up the character being processed and compares its text pointer with the
; display pointer.
@label=ReadCharacterTextPointers
c$E34F LD A,($A036)         ; {Go to #R$E365 if no object carries this id.
 $E352 CALL $E619           ;
 $E355 JR Z,$E365           ; }
 $E357 CALL $E39C           ; {Call #R$E39C to read the text pointer, then
 $E35A CALL $E3A9           ; #R$E3A9 to read the display pointer.}
 $E35D AND A                ; {Jump ahead to #R$E365 if #REGhl is below #REGde.
 $E35E SBC HL,DE            ;
 $E360 JR C,$E365           ; }
 $E362 OR %00000001         ; Reset the zero flag.
 $E364 RET                  ; Return.
; Hands the following step back to the caller and reports that the test failed.
@label=ReadCharacterTextPointers_HandBack
*$E365 LD HL,$E36A          ; Hand back the address of the following step.
 $E368 XOR A                ; Clear #REGa.
 $E369 RET                  ; Return.
 $E36A LD HL,$683F          ; {Jump back to #R$A59F to print this message.
 $E36D JP $A59F             ; }
 $E370 DEFB $66,$1D,$45,$E3 ; Display record read by #R$C9BF: flags #N$66,
                            ; value #N$1D, handler #R$E345.
; Run by #R$CA64 after the display record at #R$E370.
 $E374 CALL $E34F           ; Call #R$E34F to read the character being
                            ; processed.
 $E377 CALL $E38F           ; Call #R$E38F to bring the next bit through.
 $E37A LD A,($A035)         ; {Go to #R$E38C if no object carries this id.
 $E37D CALL $E619           ;
 $E380 JR Z,$E38C           ; }
 $E382 CALL $E39C           ; {Call #R$E39C to read the text pointer, then
 $E385 CALL $E3A9           ; #R$E3A9 to read the display pointer.}
 $E388 ADD HL,DE            ; {Move the pointer on by the length, then call
 $E389 CALL $E38F           ; #R$E38F to store the shifted text pointer.}
@label=ReadCharacterTextPointers_Succeed
*$E38C OR %00000001         ; Reset the zero flag.
 $E38E RET                  ; Return.

; Store The Shifted Text Pointer
;
; Used by the routines at #R$9B25 and #R$E34F.
; .
; Bring the next bit through the saved bit, then scale the pointer down to the
; next bit.
@label=StoreShiftedTextPointer
c$E38F RL L          ; {Rotate #REGhl left through the carry and shift the low
 $E391 RL H          ; byte back down.
 $E393 SRL L         ; }
 $E395 LD (IX+$09),L ; Store the low byte of the text pointer.
 $E398 LD (IX+$0A),H ; Store the high byte of the text pointer.
 $E39B RET           ; Return.

; Read The Text Pointer's Low Byte
;
; Used by the routines at #R$9B25, #R$E34F and #R$E619.
; .
; Reads the text pointer and rotates its low byte into the carry flag.
@label=ReadTextPointerLowByte
c$E39C LD L,(IX+$09) ; {Read the text pointer and rotate its low byte into the
 $E39F LD H,(IX+$0A) ; carry flag.
 $E3A2 RL L          ; }
 $E3A4 SRA H         ; {Shift #REGhl right by one bit, keeping the sign of
 $E3A6 RR L          ; #REGh.}
 $E3A8 RET           ; Return.

; Read The Source At The Display Pointer
;
; Used by the routine at #R$E34F.
; .
; Reads the display pointer and shifts it to the picture address. Always
; returns non-zero.
@label=ReadSourceDisplayPointer
c$E3A9 LD DE,($A02F)                        ; {Read the display pointer.
 $E3AD RES 7,D                              ;
 $E3AF RL E                                 ; }
 $E3B1 SRA D                                ; {Shift #REGde right one bit,
 $E3B3 RR E                                 ; keeping the sign of #REGd.
 $E3B5 OR $01                               ; }
 $E3B7 RET                                  ; Return.
; Reached through the display record at #R$E3EA, dispatched by #R$CB40.
 $E3B8 CALL $E3F5                           ; {Return if the room display
 $E3BB RET Z                                ; parameter does not apply.}
 $E3BC LD A,($A036)                         ; {Read the current character.
 $E3BF PUSH AF                              ; }
 $E3C0 LD A,($A034)                         ; {Call #R$CFB6 to find character
 $E3C3 INC A                                ; script entry.
 $E3C4 LD ($A036),A                         ;
 $E3C7 CALL $CFB6                           ; }
 $E3CA EX AF,AF'                            ; {Record the current character.
 $E3CB POP AF                               ;
 $E3CC LD ($A036),A                         ; }
 $E3CF EX AF,AF'                            ; {Go to #R$E3E7 if #R$CFB6 found
 $E3D0 JR Z,$E3E7                           ; no script entry for this
                                            ; character.}
 $E3D2 LD A,(IX+$03)                        ; {Take the object id at offset
 $E3D5 CALL $D237                           ; #N$03 and call #R$D237 to look it
                                            ; up.}
 $E3D8 LD IY,($A017)                        ; Read the current character
                                            ; record.
 $E3DC LD A,(IX+$04)                        ; Read the attribute type.
; None of the bits #N$70 are set in the tested state?
 $E3DF AND (IY+$04)                         ; {Return zero through #R$DC15 if none of the bits #N$70 are set in the tested
 $E3E2 AND $70                              ; state.
 $E3E4 JP Z,$DC15                           ; }
@label=ReadSourceDisplayPointer_TestActionSucceeded
*$E3E7 OR %00000001                         ; Reset the zero flag.
 $E3E9 RET                                  ; Return.
 $E3EA DEFB $78,$20,$B8,$E3,$90,$40,$28,$00 ; {Display record read by #R$C9BF: flags #N$78, value #N$20, handler #R$E3B8,
 $E3F2 DEFB $00                             ; parameters #N$90, #N$40, #N$28, #N$00, #N$00.
                                            ; }
; Run by #R$CA64 after the display record at #R$E3EA.
@label=ReadSourceDisplayPointer_CurrentCharacterRecord
 $E3F3 JR $E413                             ; Store the current room on the
                                            ; character from #R$E413.

; Check The Character For Room Graphics
;
; Used by the routine at #R$E3A9.
; .
; Checks the character id and returns when the room has nothing to draw.
; Reached through the display record at #R$E40A, dispatched by #R$CB40. A non-zero return means the script step succeeded.
@label=CheckCharacterForRoomGraphics
c$E3F5 CALL $CBA7                           ; {Call #R$CBA7, then return if
 $E3F8 CALL $DCA7                           ; #R$DCA7 returns zero.
 $E3FB RET Z                                ; }
 $E3FC LD IX,($A017)                        ; {Read the current character
 $E400 LD IY,($A013)                        ; record and read the current
                                            ; object.}
 $E404 LD A,($A034)                         ; {Take the room display parameter
 $E407 JP $DEE4                             ; and jump back to #R$DEE4.}
 $E40A DEFB $78,$20,$F5,$E3,$90,$40,$28,$00 ; {Display record read by #R$C9BF: flags #N$78, value #N$20, handler #R$E3F5,
 $E412 DEFB $00                             ; parameters #N$90, #N$40, #N$28, #N$00, #N$00.
                                            ; }
; This entry point is used by the routine at #R$E3A9.
; .
; Run by #R$CA64 after the display record at #R$E40A.
@label=CheckCharacterForRoomGraphics_CharacterRecord
*$E413 LD IY,($A017)                        ; {Read the current character
 $E417 LD A,($A034)                         ; record.}
 $E41A LD (IY+$01),A                        ; Store the room display parameter
                                            ; at #REGiy+#N$01.
 $E41D OR %00000001                         ; Reset the zero flag.
 $E41F RET                                  ; Return.
; Reached through the display record at #R$E432, dispatched by #R$CB40.
 $E420 CALL $CBA7                           ; Call #R$CBA7 to move to the next
                                            ; line when the flag is set.
 $E423 LD A,($A036)                         ; {Read the character being processed and take the room display parameter, then
 $E426 LD HL,$A034                          ; call #R$D278 to test character id range.
 $E429 CALL $D278                           ; }
 $E42C JP NC,$DC15                          ; Go to #R$DC15 if #R$D278 rejects
                                            ; this character.
 $E42F OR %00000001                         ; Reset the zero flag.
 $E431 RET                                  ; Return.
 $E432 DEFB $78,$20,$20,$E4,$10,$80,$28,$00 ; {Display record read by #R$C9BF: flags #N$78, value #N$20, handler #R$E420,
 $E43A DEFB $00                             ; parameters #N$10, #N$80, #N$28, #N$00, #N$00.
                                            ; }
; Run by #R$CA64 after the display record at #R$E432.
@label=CheckCharacterForRoomGraphics_CurrentObject
 $E43B LD IY,($A013)                        ; Read the current object.
 $E43F LD A,(IY+$01)                        ; {Keep the object's marker and
 $E442 LD IY,($A017)                        ; read the current character
                                            ; record.}
 $E446 LD (IY+$01),A                        ; Store the object's marker on the
                                            ; character at #REGiy+#N$01.
 $E449 OR %00000001                         ; Reset the zero flag.
 $E44B RET                                  ; Return.
; Reached through the display record at #R$E452, dispatched by #R$CB40.
 $E44C CALL $CBA7                           ; {Check the flag at #R$CBA7 and
 $E44F JP $E28D                             ; compare the character from
                                            ; #R$E28D.}
 $E452 DEFB $EC,$00,$4C,$E4                 ; Display record read by #R$C9BF:
                                            ; flags #N$EC, value #N$00, handler
                                            ; #R$E44C.
 $E456 DEFB $07,$2F,$E5,$0A,$FF             ; #SCRIPT($05)
 $E45B DEFB $47,$88,$E4,$FD,$FF             ; #SCRIPT($05)
 $E460 DEFB $57,$52,$DD,$FA,$FF,$6B,$E4     ; #SCRIPT($07)
 $E467 DEFB $43,$88,$E5                     ; #SCRIPT($03)
 $E46A DEFB $0B                             ; #SCRIPT($01)
 $E46B DEFB $C7,$FD,$E5,$FD,$FF,$81,$E4     ; #SCRIPT($07)
 $E472 DEFB $C1,$0D,$81,$E4                 ; #SCRIPT($04)
 $E476 DEFB $57,$84,$DD,$FD,$FF,$81,$E4     ; #SCRIPT($07)
 $E47D DEFB $42,$0C,$FA,$FF                 ; #SCRIPT($04)
 $E481 DEFB $0F                             ; #SCRIPT($01)
 $E482 DEFB $C3,$7A,$E5,$5B,$E4             ; #SCRIPT($05)
 $E487 DEFB $0A                             ; #SCRIPT($01)
 $E488 DEFB $27,$00                         ; Display record read by #R$C9BF:
                                            ; flags #N$27, value #N$00.
; Run by #R$CA64 after the display record at #R$E488.
 $E48A LD IX,($A013)                        ; Read the current object.
 $E48E LD A,(IX+$0F)                        ; {Record the current room.
 $E491 LD ($9FD6),A                         ; }
 $E494 OR %00000001                         ; Reset the zero flag.
 $E496 RET                                  ; Return.
 $E497 DEFB $47,$24,$B0,$E4                 ; Display record read by #R$C9BF:
                                            ; flags #N$47, value #N$24, handler
                                            ; #R$E4B0.
; Run by #R$CA64 after the display record at #R$E497.
 $E49B LD A,($A035)                         ; {Read the room graphics parameter
 $E49E LD B,A                               ; and keep it in #REGb.}
 $E49F LD A,($A034)                         ; Read the room display parameter.
 $E4A2 LD IX,($A013)                        ; Read the current object.
 $E4A6 LD (IX+$01),$FF                      ; {Store #N$FF in the moved marker, then call #R$DD0E to compare the room
 $E4AA CALL $DD0E                           ; display parameter with the current character.
                                            ; }
 $E4AD OR %00000001                         ; Reset the zero flag.
 $E4AF RET                                  ; Return.
; Reached through the display record at #R$E497, dispatched by #R$CB40.
 $E4B0 LD IX,($A013)                        ; Read the current object.
 $E4B4 BIT 6,(IX+$05)                       ; {Jump to #R$E4C6 if the
 $E4B8 JR Z,$E4C6                           ; special-description flag is
                                            ; clear.}
 $E4BA LD A,(IX+$0F)                        ; {Read the character attribute,
 $E4BD CALL $D224                           ; then call #R$D224 to look up this
                                            ; room.}
 $E4C0 LD A,(IX+$09)                        ; {Record the saved character.
 $E4C3 LD ($A033),A                         ; }
@label=CheckCharacterForRoomGraphics_Succeed
*$E4C6 OR %00000001                         ; Reset the zero flag.
 $E4C8 RET                                  ; Return.
 $E4C9 DEFB $04,$00                         ; Display record read by #R$C9BF:
                                            ; flags #N$04, value #N$00.
; Run by #R$CA64 after the display record at #R$E4C9.
 $E4CB LD HL,$9C56                          ; {Point #REGhl at #R$9C56 and read
 $E4CE LD A,($A034)                         ; the room display parameter.
 $E4D1 PUSH AF                              ; }
 $E4D2 CP $02                               ; {Jump ahead to #R$E4DE if the
 $E4D4 JR Z,$E4DE                           ; room display parameter is #N$02.}
 $E4D6 CP $03                               ; {Jump ahead to #R$E4DE if the
 $E4D8 JR Z,$E4DE                           ; room display parameter is #N$03.}
 $E4DA CP $04                               ; {Jump ahead to #R$E4E7 if the
 $E4DC JR NZ,$E4E7                          ; room display parameter is not
                                            ; #N$04.}
@label=CheckCharacterForRoomGraphics_PrintMessage
*$E4DE LD HL,$7611                          ; {Take the message, then call
 $E4E1 CALL $A59F                           ; #R$A59F to print the message.}
 $E4E4 LD HL,$9C60                          ; Take the routine at #R$9C60.
@label=CheckCharacterForRoomGraphics_ReadCharacter
*$E4E7 LD A,($A036)                         ; {Keep the current character, call
 $E4EA PUSH AF                              ; #R$E4FB.
 $E4EB CALL $E4FB                           ; }
 $E4EE POP AF                               ; Restore that character from the
                                            ; stack.
 $E4EF POP BC                               ; Restore the room display
                                            ; parameter from the stack.
 $E4F0 CALL $DD0E                           ; Call #R$DD0E.
 $E4F3 LD HL,($DCFF)                        ; {Read the record at #R$DCFF and
 $E4F6 RES 6,(HL)                           ; clear its marker.}
 $E4F8 OR %00000001                         ; Reset the zero flag.
 $E4FA RET                                  ; Return.

; Dispatch Looked-Up Handler
;
; Used by the routine at #R$E3F5.
; .
; Jumps to the handler the caller looked up.
@label=DispatchLookedUpHandler
c$E4FB JP (HL)                          ; Jump to the handler address in
                                        ; #REGhl.
; Reached through the display record at #R$E518, dispatched by #R$CB40.
 $E4FC LD A,($A034)                     ; {Call #R$E619 to scan objects.
 $E4FF CALL $E619                       ; }
 $E502 JP Z,$DC15                       ; Go to #R$DC15 if no object carries
                                        ; this id.
 $E505 RET                              ; Return.
 $E506 DEFB $AD,$0D                     ; Display record read by #R$C9BF: flags #N$AD, value #N$0D (bit 7: the
                                        ; script resumes at #R$E508).
 $E508 DEFB $C7,$18,$E5,$FD,$FC,$10,$E5 ; #SCRIPT($07)
 $E50F DEFB $0A                         ; #SCRIPT($01)

; Store The Result In The High Byte
;
; The opening bytes are data.
; The instructions that follow store the display pointer.
; A non-zero return means the script step succeeded.
; Reached from the script record at #R$E508.
@label=StoreResultHighByte
c$E510 DEFB $57,$70,$E3,$FD,$FC,$0F,$E5 ; #SCRIPT($07)
 $E517 DEFB $0B                         ; #SCRIPT($01)
 $E518 DEFB $6D,$0D,$FC,$E4             ; Display record read by #R$C9BF: flags
                                        ; #N$6D, value #N$0D, handler #R$E4FC.
; Run by #R$CA64 after the display record at #R$E518.
 $E51C LD A,$FE                         ; Take #N$FE for the location value.
 $E51E LD ($9FD7),A                     ; Store it at #R$9FD7.
 $E521 LD L,(IX+$09)                    ; {Read the text pointer at offsets
 $E524 LD H,(IX+$0A)                    ; #N$09 and #N$0A.}
 $E527 SET 7,L                          ; Set bit 7 of the pointer's low byte.
 $E529 LD ($A02F),HL                    ; Record the display pointer.
 $E52C OR %00000001                     ; Reset the zero flag.
 $E52E RET                              ; Return.
; Named from the script commands at #R$E456, #R$E732, #R$E745, #R$E751, #R$EEAA, #R$EF34,
; #R$F004, #R$F080, #R$F2BA, #R$F2D3, #R$F2FF and #R$F334.
 $E52F DEFB $07,$07                     ; Display record read by #R$C9BF: flags
                                        ; #N$07, value #N$07.
; Run by #R$CA64 after the display record at #R$E52F.
 $E531 LD A,$02                         ; Take #N$02 as the number of bytes to
                                        ; allocate.
 $E533 CALL $A11C                       ; Call #R$A11C to build the pointer the
                                        ; clock update stores.
 $E536 LD HL,($9FE5)                    ; {Read the clock at #R$9FE5 into
 $E539 LD ($9FE5),IX                    ; #REGhl and store #REGix in its place.
                                        ; }
 $E53D LD (IX-$02),L                    ; Store the low byte of the pointer in
                                        ; the previous record.
 $E540 LD (IX-$01),H                    ; {Store the high byte of the pointer
 $E543 LD A,($A036)                     ; in the previous record.}
 $E546 LD (IX+$00),A                    ; Store the record's flag byte.
 $E549 LD A,($A035)                     ; {Jump to #R$E556 if the room graphics
 $E54C LD B,$00                         ; parameter is #N$FF.
 $E54E CP $FF                           ;
 $E550 JR Z,$E556                       ; }
; Get character attribute with sign.
 $E552 CALL $D2A4                       ; Call #R$D2A4 to read the signed
                                        ; character attribute.
 $E555 LD B,A                           ; Use the get character attribute with
                                        ; sign result as the count.
@label=StoreResultHighByte_MovedMarker
*$E556 LD A,($A034)                     ; {Add the count to the room display
 $E559 ADD A,B                          ; parameter and store it as the moved
 $E55A LD (IX+$01),A                    ; marker.}
 $E55D OR %00000001                     ; Reset the zero flag.
 $E55F RET                              ; Return.

; Find The Character On The Saved Pointer
;
; Walks the list at the saved character pointer until it finds the character being
; processed.
@label=FindCharacterSavedPointer
c$E560 LD IX,$9FE7          ; Use the saved pointer (#R$9FE7).
@label=FindCharacterSavedPointer_FetchObjectPointer
*$E564 CALL $A0F7           ; {Return if the object pointer is zero.
 $E567 RET Z                ; }
 $E568 LD A,($A036)         ; {Jump back to #R$E564 while this id does not
 $E56B CP (IX+$00)          ; match the record's flag byte.
 $E56E JR NZ,$E564          ; }
 $E570 OR %00000001         ; Reset the zero flag.
 $E572 RET                  ; Return.
; Reached through the display record at #R$E57A and #R$E588, dispatched by
; #R$CB40.
 $E573 CALL $E560           ; {Go to #R$DC15 if the character is not on the
 $E576 JP Z,$DC15           ; saved pointer.}
 $E579 RET                  ; Return.
; Named from the script commands at #R$E482, #R$E76C, #R$E7AC, #R$EEB6, #R$EF40, #R$F010,
; #R$F088, #R$F2C6, #R$F2E0, #R$F317 and #R$F352.
 $E57A DEFB $40,$00,$73,$E5 ; Display record read by #R$C9BF: flags #N$40,
                            ; value #N$00, handler #R$E573.
; Run by #R$CA64 after the display record at #R$E57A.
 $E57E DEC (IX+$01)         ; Count down the link at offset #N$01.
 $E581 RET NZ               ; Return if that link has not reached zero.
 $E582 CALL $E58C           ; {Call #R$E58C and return zero through #R$DC15.
 $E585 JP $DC15             ; }
; Named from the script commands at #R$E467, #R$E7B2, #R$E7B6, #R$EF96, #R$F2D0, #R$F2FC,
; #R$F32E, #R$F359, #R$F366 and #R$F3A2.
 $E588 DEFB $40,$00,$73,$E5 ; Display record read by #R$C9BF: flags #N$40,
                            ; value #N$00, handler #R$E573.

; Copy The Clock Link
;
; Used by the routine at #R$E560.
; .
; Compares the current record with the clock workspace and copies the link kept
; beside the clock.
; Run by #R$CA64 after the display record at #R$E588. A non-zero return means the script step succeeded.
@label=CopyClockLink
c$E58C PUSH IX              ; {Call #R$A104 to step pointer and compare.
 $E58E POP DE               ;
 $E58F LD IY,$9FE5          ;
 $E593 CALL $A104           ; }
 $E596 LD L,(IX-$02)        ; {Read the pointer saved ahead of this record.
 $E599 LD H,(IX-$01)        ; }
 $E59C LD (IY-$02),L        ; Store the low byte of the pointer in the previous
                            ; record.
 $E59F LD (IY-$01),H        ; {Store it in the schedule entry, then call
 $E5A2 CALL $A1C7           ; #R$A1C7 to run memory entry.}
 $E5A5 OR %00000001         ; Reset the zero flag.
 $E5A7 RET                  ; Return.
; Reached from the script commands at #R$E756, #R$E786, #R$E794, #R$E79C, #R$E7DC, #R$ECD0,
; #R$EF90, #R$F05C, #R$F085, #R$F13F, #R$F192, #R$F2BF, #R$F2DD, #R$F314 and #R$F34F, run by
; #R$CC82.
; .
; Named from the script commands at #R$E756, #R$E786, #R$E794, #R$E79C, #R$E7DC, #R$ECD0,
; #R$EF90, #R$F05C, #R$F085, #R$F13F, #R$F192, #R$F2BF, #R$F2DD, #R$F314 and #R$F34F.
 $E5A8 DEFB $00,$10         ; Display record read by #R$C9BF: flags #N$00,
                            ; value #N$10.
; Run by #R$CA64 after the display record at #R$E5A8.
 $E5AA OR %00000001         ; Reset the zero flag.
 $E5AC RET                  ; Return.
 $E5AD DEFB $4C,$04,$B1,$E5 ; Display record read by #R$C9BF: flags #N$4C,
                            ; value #N$04, handler #R$E5B1.
; Reached through the display record at #R$E5AD, dispatched by #R$CB40.
; .
; Run by #R$CA64 after the display record at #R$E5AD.
 $E5B1 LD IX,($A013)        ; Read the current object.
 $E5B5 LD A,($A035)         ; {Compare the room graphics parameter with the
 $E5B8 CP (IX+$0F)          ; character's attribute.}
 $E5BB JP NZ,$DC15          ; Go to #R$DC15 if the room graphics parameter does
                            ; not match it.
 $E5BE OR %00000001         ; Reset the zero flag.
 $E5C0 RET                  ; Return.

; Display Record
;
; Display record read by #R$C9BF. The show-message command at #R$E781 passes this word to
; #R$C591.
;
; .
;
; Named from the script command at #R$E781.
b$E5C1 DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Look Up The Current Object
;
; Looks up the character id at #R$9860 and compares that object's attribute
; with the current character record. A non-zero return means the script step
; succeeded.
;
; .
;
; Run by #R$CA64 after the display record at #R$E5C1, from the show-message
; command at #R$E781.
@label=LookUpCurrentObject
c$E5C3 LD A,($9860)         ; {Take the character id at #R$9860 and call
 $E5C6 CALL $D237           ; #R$D237 to look that object up.}
 $E5C9 LD A,(IX+$0F)        ; {Read byte #N$0F of this record and point #REGix
 $E5CC LD IX,($A017)        ; at the character record at #R$A017.}
 $E5D0 CP (IX+$0F)          ; {Compare it with the character record, take the
 $E5D3 LD A,($A036)         ; character being processed, and jump to #R$E5F0.
 $E5D6 JR $E5F0             ; }
 $E5D8 DEFB $47,$07,$DF,$E5 ; Display record read by #R$C9BF: flags #N$47,
                            ; value #N$07, handler #R$E5DF.
; Run by #R$CA64 after the display record at #R$E5D8.
 $E5DC OR %00000001         ; Reset the zero flag.
 $E5DE RET                  ; Return.
 $E5DF LD IX,($A013)        ; {Point #REGix at the current object and read byte
 $E5E3 LD A,(IX+$0F)        ; #N$0F.}
 $E5E6 LD IX,($A015)        ; Read the secondary pointer.
 $E5EA CP (IX+$0F)          ; {Compare #REGa with byte #N$0F of the record at
 $E5ED LD A,($A035)         ; #R$A015 and read the room graphics parameter.}
@label=LookUpCurrentObject_ZeroThrough
*$E5F0 JP NZ,$DC15          ; Return zero through #R$DC15 when that comparison
                            ; did not match.
 $E5F3 LD HL,$A034          ; {Go to #R$DC15 if #REGa matches the room display
 $E5F6 CP (HL)              ; parameter at #R$A034.
 $E5F7 JP Z,$DC15           ; }
 $E5FA OR %00000001         ; Reset the zero flag.
 $E5FC RET                  ; Return.
 $E5FD DEFB $47,$00,$04,$E6 ; Display record read by #R$C9BF: flags #N$47,
                            ; value #N$00, handler #R$E604.
; Run by #R$CA64 after the display record at #R$E5FD.
 $E601 OR %00000001         ; Reset the zero flag.
 $E603 RET                  ; Return.
; Reached through the display record at #R$E5FD, dispatched by #R$CB40.
 $E604 LD A,($A036)         ; Read the character being processed.
 $E607 CALL $C863           ; Call #R$C863 to get that character's location.
 $E60A EX AF,AF'            ; {Keep the location.
 $E60B LD B,A               ; }
 $E60C LD A,($A034)         ; Read the room display parameter.
 $E60F CALL $C863           ; Call #R$C863 to get the object's location.
 $E612 EX AF,AF'            ; {Compare the two locations.
 $E613 CP B                 ; }
 $E614 LD A,($A036)         ; {Read the character again and jump back to
 $E617 JR $E5F0             ; #R$E5F0.}

; Scan Objects
;
; Used by the routines at #R$9B25, #R$E34F, #R$E4FB and #R$E691.
; .
; Walks the objects and stops on the entry the caller wants.
@label=ScanObjects
c$E619 LD C,A               ; {Keep the wanted id in #REGc and start the object counter at #N$FF (it is incremented
 $E61A LD B,$FF             ; first).}
@label=ScanObjects_Loop
*$E61C INC B                ; {Return when the object id reaches #N$6E, past
 $E61D LD A,B               ; the last object.
 $E61E CP $6E               ;
 $E620 RET Z                ; }
 $E621 CALL $D237           ; Call #R$D237 to look that object up.
 $E624 LD A,(IX+$01)        ; {Go back to #R$E61C unless byte #N$01 of this
 $E627 CP C                 ; object matches the id in #REGc.
 $E628 JR NZ,$E61C          ; }
 $E62A LD HL,$0575          ; {Go back to #R$E61C unless byte #N$07 of this
 $E62D LD A,(IX+$07)        ; object is #N$75.
 $E630 CP L                 ;
 $E631 JR NZ,$E61C          ; }
 $E633 LD A,(IX+$08)        ; {Go to #R$E61C if the low nibble of object byte
 $E636 AND $0F              ; #N$08 is not #N$05.
 $E638 CP H                 ;
 $E639 JR NZ,$E61C          ; }
 $E63B OR %00000001         ; Reset the zero flag.
 $E63D RET                  ; Return.
; Named from the script command at #R$F2D8.
; .
; Scans objects Patched.
@label=ScanObjects_PatchedRecord
 $E63E DEFB $40,$00,$42,$E6 ; Display record read by #R$C9BF: flags #N$40,
                            ; value #N$00, handler #R$E642.
; Run by #R$CA64 after the display record at #R$E63E.
 $E642 LD A,($A036)         ; Read the character being processed.
 $E645 CALL $E619           ; Call #R$E619 to scan the objects for that id.
 $E648 JP Z,$DC15           ; Return zero through #R$DC15 if the object scan
                            ; found nothing.
 $E64B CALL $E39C           ; {Go to #R$DC15 if bit 7 of #REGh is clear.
 $E64E BIT 7,H              ;
 $E650 JP Z,$DC15           ; }
 $E653 RET                  ; Return.
; Named from the script commands at #R$F304, #R$F31C, #R$F339 and #R$F3B2.
 $E654 DEFB $40,$00,$58,$E6 ; Display record read by #R$C9BF: flags #N$40,
                            ; value #N$00, handler #R$E658.
; Run by #R$CA64 after the display record at #R$E654.
 $E658 LD A,($A036)         ; Read the character being processed.
 $E65B CALL $E619           ; Call #R$E619 to scan the objects for that id.
 $E65E JP Z,$DC15           ; Return zero through #R$DC15 if the object scan
                            ; found nothing.
 $E661 CALL $E39C           ; {Return zero through #R$DC15 if bit 7 of #REGh is
 $E664 BIT 7,H              ; set.
 $E666 JP NZ,$DC15          ; }
 $E669 LD A,H               ; {Go to #R$DC15 if the saved pointer is zero.
 $E66A OR L                 ;
 $E66B JP Z,$DC15           ; }
 $E66E RET                  ; Return.
; Named from the script commands at #R$F309, #R$F321, #R$F33E and #R$F3B7.
 $E66F DEFB $40,$00,$73,$E6 ; Display record read by #R$C9BF: flags #N$40,
                            ; value #N$00, handler #R$E673.
; Run by #R$CA64 after the display record at #R$E66F.
 $E673 LD A,($A036)         ; Read the character being processed.
 $E676 CALL $E619           ; Call #R$E619 to scan the objects for that id.
 $E679 JR Z,$E683           ; Go to #R$E683 if the object scan found nothing.
 $E67B CALL $E39C           ; {Return zero through #R$DC15 if the pointer is
 $E67E LD A,H               ; not zero.
 $E67F OR L                 ;
 $E680 JP NZ,$DC15          ; }
@label=ScanObjects_Next
*$E683 OR %00000001         ; Reset the zero flag.
 $E685 RET                  ; Return.

; Reject Low Character Attribute
;
; Used by the routine at #R$E691.
; .
; Reads the character attribute and fails the action, through #R$DC15, when the attribute
; is below #N$32.
@label=RejectLowCharacterAttribute
c$E686 CALL $D29D    ; {Return zero through #R$DC15 when the character
 $E689 CP $32        ; attribute is below #N$32.
 $E68B JP C,$DC15    ; }
 $E68E OR %00000001  ; Reset the zero flag.
 $E690 RET           ; Return.

; Process Character Attribute
;
; Used by the routine at #R$9D13.
; .
; Follows the character link for this attribute, and stops when the link runs
; out.
@label=ProcessCharacterAttribute
c$E691 CALL $E686    ; {Return if the character attribute is below #N$32.
 $E694 RET Z         ; }
; Get character attribute.
 $E695 CALL $D29D    ; Call #R$D29D to read the character's attribute.
 $E698 LD B,A        ; Use the get character attribute result as the count.
@label=ProcessCharacterAttribute_Loop
*$E699 LD IX,$9FF6   ; Point at the object display link.
@label=ProcessCharacterAttribute_CountCharacterRepeat
*$E69D DJNZ $E6A6    ; Count the next character and repeat from #R$E6A6.
 $E69F CALL $A0F7    ; {Jump back to #R$E699 while the object pointer is zero.
 $E6A2 JR Z,$E699    ; }
 $E6A4 JR $E69D      ; Try the next object from #R$E69D.
; Compare this object pointer with the list head.
@label=ProcessCharacterAttribute_Next
*$E6A6 PUSH IX       ; {Point #REGhl at the object display link and #REGde at
 $E6A8 POP HL        ; #R$9FF0+#N$06, and clear the carry.
 $E6A9 LD DE,$9FF6   ;
 $E6AC AND A         ; }
 $E6AD SBC HL,DE     ; See whether this object pointer is #R$9FF0+#N$06.
 $E6AF JR Z,$E6B9    ; Jump ahead to #R$E6B9 if the two pointers meet.
 $E6B1 PUSH IX       ; {Take the police message, then call #R$A59F to print the
 $E6B3 LD HL,$6F80   ; police message.
 $E6B6 CALL $A59F    ; }
@label=ProcessCharacterAttribute_TestActionSucceeded
*$E6B9 OR %00000001  ; Reset the zero flag.
 $E6BB RET           ; Return.
; Named from the script commands at #R$F326 and #R$F3BC.
; .
; Individual script handlers. Each one ends by returning success or by bailing out
; through #R$DC15.
 $E6BC DEFB $0D,$0C  ; Display record read by #R$C9BF: flags #N$0D, value
                     ; #N$0C.
; Run by #R$CA64 after the display record at #R$E6BC.
@label=ProcessCharacterAttribute_TestCount
 $E6BE LD A,($A035)  ; {Go to #R$E6E3 if no object carries this id.
 $E6C1 CALL $E619    ;
 $E6C4 JR Z,$E6E3    ; }
 $E6C6 LD E,(IX+$09) ; {Read the low byte of the text pointer and read the high byte of the text
 $E6C9 LD D,(IX+$0A) ; pointer.}
 $E6CC LD HL,$6BB7   ; Take the character busy message.
; Print text and handle control characters.
 $E6CF CALL $A59F    ; Call #R$A59F to print this message.
 $E6D2 LD HL,$0000   ; {Call #R$A419 to handle the picture for this message.
 $E6D5 AND A         ;
 $E6D6 SBC HL,DE     ;
 $E6D8 CALL $A419    ; }
 $E6DB LD A,$22      ; {Print a quotation mark and start a new line.
 $E6DD CALL $A9B7    ;
 $E6E0 CALL $A2A2    ; }
@label=ProcessCharacterAttribute_Succeeded
*$E6E3 OR %00000001  ; Reset the zero flag.
 $E6E5 RET           ; Return.

; Display Record
;
; Display record read by #R$C9BF. The show-message commands at #R$F2F7, #R$F35F and
; #R$F371 pass this word to #R$C591.
;
; .
;
; Named from the script commands at #R$F2F7, #R$F35F and #R$F371.
b$E6E6 DEFB $4D,$00,$F6,$E6 ; Display record read by #R$C9BF: flags #N$4D,
                            ; value #N$00, handler #R$E6F6.

; Store The Action Flags
;
; Copies the room display parameter onto the character and reports success.
;
; .
;
; Run by #R$CA64 after the display record at #R$E6E6, from the show-message commands at #R$F2F7,
; #R$F35F and #R$F371.
@label=StoreActionFlags
c$E6EA CALL $CFB6    ; Call #R$CFB6 to find this character's script entry.
 $E6ED LD A,($A034)  ; {Copy the room display parameter into the character's
 $E6F0 LD (IX+$03),A ; action flags.}
 $E6F3 OR %00000001  ; Reset the zero flag.
 $E6F5 RET           ; Return.

; Compare The Character With The Room
;
; Fails the action unless the character being processed matches both room
; parameters. A non-zero return means the script step succeeded.
;
; .
;
; Handler word in the display record at #R$E6E6, called via #R$CB34.
@label=CompareCharacterWithRoom
c$E6F6 LD A,($A036)  ; {Compare the character being processed with the room
 $E6F9 LD HL,$A034   ; display parameter.
 $E6FC CP (HL)       ; }
 $E6FD JP Z,$DC15    ; Go to #R$DC15 when they match.
 $E700 DEC A         ; {Count down one and point #REGix at the current object
 $E701 LD IX,($A013) ; (#R$A013).}
 $E705 CP (IX+$01)   ; {Go to #R$DC15 if it does not match byte #N$01 of that
 $E708 JP NZ,$DC15   ; object.}
 $E70B OR %00000001  ; Reset the zero flag.
 $E70D RET           ; Return.

; Display Record
;
; Display record read by #R$C9BF. The show-message command at #R$F35C passes this word to
; #R$C591.
;
; .
;
; Named from the script command at #R$F35C.
b$E70E DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Print The Action Message
;
; Prints the action message when the character's action flag is set. A non-zero
; return means the script step succeeded.
;
; .
;
; Run by #R$CA64 after the display record at #R$E70E, from the show-message
; command at #R$F35C.
@label=PrintActionMessage
c$E710 LD A,($5C3C)                     ; {Save the television-data byte and
 $E713 PUSH AF                          ; call #R$CFB6 to find this character's
 $E714 CALL $CFB6                       ; script entry.}
 $E717 LD A,(IX+$03)                    ; {Point at the message at
 $E71A AND A                            ; #R$6929+#N$032B, and go to #R$E725 to
 $E71B LD HL,$6C54                      ; print it when the action flag is set.
 $E71E JR NZ,$E725                      ; }
 $E720 LD A,$01                         ; {Write #N$01 to the system Variables.
 $E722 LD ($5C3C),A                     ; }
@label=PrintActionMessage_PrintMessage
*$E725 CALL $A59F                       ; {Call #R$A59F to print this message.
 $E728 POP AF                           ; }
 $E729 LD ($5C3C),A                     ; Store it in the system variables.
 $E72C OR %00000001                     ; Reset the zero flag.
 $E72E RET                              ; Return.
