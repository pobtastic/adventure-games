; #R$F0EE.
 $F198 DEFB $07,$00                 ; Display record read by #R$C9BF: flags
                                    ; #N$07, value #N$00.
; Run by #R$CA64 after the display record at #R$F198.
 $F19A CALL $D29D                   ; Call #R$D29D to read the character
                                    ; attribute.

; Reject A Lower Character Id
;
; Returns zero when the character being processed is below the id passed in. A
; non-zero return means the script step succeeded.
@label=RejectLowerCharacterId
c$F19D LD B,A        ; {Return zero through #R$DC15 if the character being
 $F19E LD A,($A034)  ; processed is below this id.
 $F1A1 CP B          ;
 $F1A2 JP C,$DC15    ; }
 $F1A5 OR %00000001  ; Reset the zero flag.
 $F1A7 RET           ; Return.

; Display Record
;
; Display record read by #R$C9BF. The show-message command at #R$F097 passes this word to
; #R$C591.
;
; .
;
; Named from the script command at #R$F097.
b$F1A8 DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Print The Lower-Id Message
;
; Prints the message and clears bit 6 of the character record. A non-zero
; return means the script step succeeded.
;
; .
;
; Run by #R$CA64 after the display record at #R$F1A8, from the show-message
; command at #R$F097.
@label=RejectLowerCharacterId_PrintMessage
c$F1AA LD HL,$6D5D    ; Take the message at #R$6929+#N$0434.
 $F1AD LD DE,$0910    ; {Prepare the text pointer #N$0910 and the marker #N$20.
 $F1B0 LD B,$20       ; }
; This entry point is used by the routine at #R$ED3B.
*$F1B2 LD A,$0B       ; {Call #R$F1C1 to update object #N$0B.
 $F1B4 CALL $F1C1     ; }
 $F1B7 RES 6,(IX+$05) ; Clear bit 6 of the character record.
 $F1BB CALL $A59F     ; Call #R$A59F to print the message.
 $F1BE OR %00000001   ; Reset the zero flag.
 $F1C0 RET            ; Return.

; Update Object Location
;
; Used by the routines at #R$9ED7, #R$EFB5 and #R$F1AA.
; .
; Looks the object up and stores the new location together with the low digit
; of its flags.
@label=UpdateObjectLocation
c$F1C1 CALL $D237    ; Call #R$D237 to look that object up.
 $F1C4 LD (IX+$09),E ; {Store the low byte of the text pointer and store the high byte of the text
 $F1C7 LD (IX+$0A),D ; pointer.}
 $F1CA LD A,(IX+$08) ; {Read the byte at offset #N$08, keep its low digit and
 $F1CD AND $0F       ; fold in #REGb.
 $F1CF OR B          ; }
 $F1D0 LD (IX+$08),A ; Store the new value at offset #N$08 of the record.
 $F1D3 OR %00000001  ; Reset the zero flag.
 $F1D5 RET           ; Return.

; Action: Room And Character Flags
;
; Checks the room, the clock and the current character, then sets or clears object
; flags for this action. A non-zero return means the script step succeeded.
; Reached through the table at #R$9FAB, read by #R$C583.
@label=ActionRoomAndCharacterFlags
c$F1D6 DEFB $07,$00                     ; Display record read by #R$C9BF: flags
                                        ; #N$07, value #N$00.
; Run by #R$CA64 after the display record at #R$F1D6.
 $F1D8 LD A,($A034)                     ; {Take the morning marker and go to
 $F1DB LD B,$61                         ; #R$F1E5 if the hour is below #N$0D.
 $F1DD CP $0D                           ;
 $F1DF JR C,$F1E5                       ; }
 $F1E1 LD B,$70                         ; {Take the afternoon marker and
 $F1E3 SUB $0C                          ; subtract #N$0C to make the hour.}
@label=ActionRoomAndCharacterFlags_Next
*$F1E5 LD HL,$9FE0                      ; {Go to #R$DC15 if the hour does not
 $F1E8 CP (HL)                          ; match the clock at #R$9FE0.
 $F1E9 JP NZ,$DC15                      ; }
 $F1EC LD A,($9FE2)                     ; {Go to #R$DC15 if the AM/PM marker at
 $F1EF CP B                             ; #R$9FE2 does not match.
 $F1F0 JP NZ,$DC15                      ; }
 $F1F3 OR %00000001                     ; Reset the zero flag.
 $F1F5 RET                              ; Return.
; Named from the script command at #R$EF0C.
 $F1F6 DEFB $07,$00                     ; Display record read by #R$C9BF: flags
                                        ; #N$07, value #N$00.
; Run by #R$CA64 after the display record at #R$F1F6.
 $F1F8 LD IX,($A013)                    ; {Read the current object and mark the
 $F1FC SET 7,(IX+$05)                   ; object-attribute flag.}
 $F200 OR %00000001                     ; Reset the zero flag.
 $F202 RET                              ; Return.
 $F203 DEFB $07,$00                     ; Display record read by #R$C9BF: flags
                                        ; #N$07, value #N$00.
; Run by #R$CA64 after the display record at #R$F203.
 $F205 LD IX,($A013)                    ; {Read the current object and clear
 $F209 RES 0,(IX+$05)                   ; bit 0 of its flags.}
 $F20D OR %00000001                     ; Reset the zero flag.
 $F20F RET                              ; Return.
 $F210 DEFB $07,$00                     ; Display record read by #R$C9BF: flags
                                        ; #N$07, value #N$00.
; Run by #R$CA64 after the display record at #R$F210.
