; Display Record
;
; Record that hands back the text token at #R$9FCE. Listed in #R$9F38
; for room #N$34, the word at #R$9FA8.
b$9FC5 DEFB $40,$00,$C9,$9F ; Display record read by #R$C9BF: flags #N$40,
                            ; value #N$00, handler #R$9FC9.

; Print Text Token And Return
;
; Returns the address of the message step at #R$9FCE.
; Reached through the display record at #R$9FC5, dispatched by #R$CB40.
; Run by #R$CA64 after the display record at #R$9FC5.
@label=PrintTextTokenAndReturn
c$9FC9 LD HL,$9FCE   ; Hand back the address of the following step.
 $9FCC XOR A         ; Clear #REGa.
 $9FCD RET           ; Return.
; Print "#TEXTTOKEN($680B)".
 $9FCE LD HL,$680B   ; {Jump ahead to #R$A59F to print this message.
 $9FD1 JP $A59F      ; }

