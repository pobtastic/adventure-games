; Print The Surprised Remark Once
;
; Used by the routine at #R$9D95.
; .
; Prints the character-busy line while the counter still has a count, and prints
; the surprised remark the first time the counter runs out.
@label=PrintSurprisedRemarkOnce
c$9DC6 INC HL        ; {Step to the next character, then call #R$9CF2 to run
 $9DC7 CALL $9CF2    ; character action parameter.}
 $9DCA DEC HL        ; {Jump back to #R$9CEC while this byte is not zero.
 $9DCB LD A,(HL)     ;
 $9DCC AND A         ;
 $9DCD JP NZ,$9CEC   ; }
 $9DD0 INC A         ; {Jump ahead to #R$A59F to print this message.
 $9DD1 LD (HL),A     ;
 $9DD2 LD HL,$71ED   ;
 $9DD5 JP $A59F      ; }

; Store A Set Mark At The Pointer
;
; Used by the routine at #R$9D95.
; .
; Marks this character's set state and prints the line once the status count
; has run out.
@label=StoreSetMarkPointer
c$9DD8 CALL $9CF2     ; {Call #R$9CF2 to run character action parameter, then call #R$BC46 to run
 $9DDB LD (HL),$01    ; game status entries.
 $9DDD CALL $BC46     ; }
 $9DE0 CALL $BC9C     ; {Jump ahead to #R$9DF5 if the count is not zero.
 $9DE3 LD A,B         ;
 $9DE4 AND A          ;
 $9DE5 JR NZ,$9DF5    ; }
 $9DE7 CALL $BC74     ; {Return if the count is zero.
 $9DEA AND A          ;
 $9DEB RET Z          ; }
 $9DEC PUSH IX        ; Take the message, then call #R$A59F to print the message, keeping character
                      ; record.
; Print "#TEXTTOKEN($722D)".
 $9DEE LD HL,$722D    ;
 $9DF1 CALL $A59F     ;
 $9DF4 RET            ; Return.
; Return if bit 4 of the action state is set.
@label=StoreSetMarkPointer_TestMarkByte
*$9DF5 BIT 4,(IX+$03) ; {Return if the action state flag is set.
 $9DF9 RET NZ         ; }
 $9DFA LD A,$01       ; {Jump ahead to #R$BBE5 to print text based on flag.
 $9DFC JP $BBE5       ; }

; Character Action: Inspector Lestrade
;
; Scheduled behaviour for Inspector Lestrade.
; Reached through the character-action table at #R$9C85, dispatched by #R$9C84.
@label=CharacterAction_InspectorLestrade
c$9DFF LD C,$04        ; {Call #R$9CCE to check object in character location.
 $9E01 CALL $9CCE      ; }
 $9E04 JR NZ,$9D95     ; Go to #R$9D95 if the object is not in this character's
                       ; location.
 $9E06 LD C,$00        ; {Call #R$9CCE to check object in character location.
 $9E08 CALL $9CCE      ; }
 $9E0B JR NZ,$9D95     ; Go to #R$9D95 if the object is not in this character's
                       ; location.
 $9E0D LD A,$04        ; {Write #N$04 to the room display parameter.
 $9E0F LD ($A034),A    ;
 $9E12 LD A,$01        ; }
 $9E14 LD ($9D90),A    ; Record the police.
 $9E17 LD A,$5C        ; {Call #R$D224 with room #N$5C: #ROOM$5C.
 $9E19 CALL $D224      ; }
 $9E1C LD (IX+$0A),$00 ; Clear the high byte of the text pointer.
 $9E20 LD A,$3E        ; {Call #R$D224 with room #N$3E: #ROOM$3E.
 $9E22 CALL $D224      ; }
 $9E25 LD (IX+$0A),$00 ; Clear the high byte of the text pointer.
 $9E29 LD HL,$9D95     ; {Write #R$9D95 to *#R$9C86.
 $9E2C LD ($9C86),HL   ; }
 $9E2F LD A,$01        ; {Write #N$01 to the police.
 $9E31 LD ($9D92),A    ; }
 $9E34 LD A,($9D91)    ; {Jump to #R$9E44 if the police flag is set.
 $9E37 AND A           ;
 $9E38 LD HL,$7207     ;
 $9E3B JR NZ,$9E44     ; }
 $9E3D INC A           ; {Record the police.
 $9E3E LD ($9D91),A    ;
 $9E41 LD HL,$7224     ; }
@label=CharacterAction_InspectorLestrade_Next
*$9E44 CALL $A59F      ; Call #R$A59F to print the message.
 $9E47 RET             ; Return.

