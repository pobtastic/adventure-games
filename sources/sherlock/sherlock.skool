; .
;
; Named from the script command at #R$E932.
b$9E6A DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Test The Police Flag
;
; Returns when the police flag is set, otherwise takes the character-busy
; message.
;
; .
;
; Run by #R$CA64 after the display record at #R$9E6A, from the show-message
; command at #R$E932.
@label=TestPoliceFlag
c$9E6C LD A,($9D90)  ; {Return if the police flag is set.
 $9E6F AND A         ;
 $9E70 RET NZ        ; }
 $9E71 LD HL,$693A   ; Use the character busy (#R$6929+#N$11).

; Report Success
;
; Used by the routines at #R$9E4A, #R$9E87, #R$9EA4 and #R$DFCC.
; .
; Tells the script this step succeeded.
@label=PrintMessageAndInitialiseTimer
c$9E74 LD A,$01      ; {Take #N$01 and store it in the system variables, then call #R$A59F to print the
 $9E76 LD ($5C3C),A  ; message.
