;
; .
;
; Named from the script command at #R$EF89.
b$9E48 DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Check Character State
;
; Prints the message at #R$6B79 unless both character #N$03 and character #N$02 are at the location in #R$A009, in which case it prints #R$6AF1+#N$02.
; Run by #R$CA64 after the display record at #R$9E48, from the show-message command at #R$EF89.
@label=CheckCharacterState
c$9E4A LD HL,$6B79   ; {Call #R$9E60 to read Sherlock's disguise.
 $9E4D LD A,$03      ;
 $9E4F CALL $9E60    ; }
 $9E52 JR NZ,$9E74   ; Go to #R$9E74 unless Sherlock's disguise matches this
                     ; character.
 $9E54 LD A,$02      ; {Jump ahead to #R$9E74 unless Sherlock's disguise
 $9E56 CALL $9E60    ; matches this character.
 $9E59 JR NZ,$9E74   ; }
 $9E5B LD HL,$6AF3   ; {Jump ahead to #R$9E74 with the message at
 $9E5E JR $9E74      ; #R$6929+#N$01CA.}

; Read Sherlock's Disguise
;
; Used by the routine at #R$9E4A.
; .
; Read Sherlock's disguise, then see whether it matches the character
; attribute.
@label=ReadSherlocksDisguise
c$9E60 CALL $D237    ; Call #R$D237 to look that object up.
 $9E63 LD A,($A009)  ; Read the sherlock Disguise Check Result.
 $9E66 CP (IX+$0F)   ; See whether it matches the character attribute.
 $9E69 RET           ; Return.

