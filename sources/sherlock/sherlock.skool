 $F380 DEFB $C8,$00,$89,$F3             ; Display record read by #R$C9BF: flags #N$C8, value #N$00, handler #R$F389
                                        ; (bit 7: the script resumes at #R$F384).
 $F384 DEFB $02,$80,$FD,$00             ; #SCRIPT($04)
 $F388 DEFB $0B                         ; #SCRIPT($01)

; Compare The Room Parameters
;
; Compares the character being processed with the two room parameters. A
; non-zero return means the script step succeeded.
;
; .
;
; Handler word in the display record at #R$F380, called via #R$CB34.
@label=CompareRoomParameters
c$F389 LD IX,($A013) ; Point #REGix at the current object (#R$A013).
 $F38D LD A,($A036)  ; {Read the character being processed and count down one.
 $F390 DEC A         ; }
 $F391 CP (IX+$01)   ; Compare it with byte #N$01 of that object.
 $F394 JP NZ,$DC15   ; Go to #R$DC15 if they differ.
 $F397 LD HL,$A034   ; Point #REGhl at the room display parameter at #R$A034.
 $F39A INC A         ; {Bring the character id back up by one and compare it
 $F39B CP (HL)       ; with the room display parameter.}
 $F39C JP Z,$DC15    ; Go to #R$DC15 if it matches the room display parameter.
 $F39F OR %00000001  ; Reset the zero flag.
 $F3A1 RET           ; Return.

; Script: Refresh The Room
;
; Shows a message, refreshes the room and jumps on.
; Named from the script commands at #R$F304, #R$F31C and #R$F339.
b$F3A2 DEFB $03,$88,$E5         ; #SCRIPT($03)
 $F3A5 DEFB $07,$06,$E5,$FB,$FD ; #SCRIPT($05)
 $F3AA DEFB $0E,$69,$F3         ; #SCRIPT($03)
 $F3AD DEFB $07,$41,$9C,$FD,$FF ; #SCRIPT($05)
 $F3B2 DEFB $83,$54,$E6,$C1,$F3 ; #SCRIPT($05)
 $F3B7 DEFB $83,$6F,$E6,$C1,$F3 ; #SCRIPT($05)
 $F3BC DEFB $07,$BC,$E6,$FC,$FB ; #SCRIPT($05)
 $F3C1 DEFB $0B                 ; #SCRIPT($01)

; Drawing
;
; Used by the routine at #R$A277.
; .
; Draws one location picture from line, fill and attribute commands. Pictures are not
; bitmaps. The pen starts at X=#N$7F and Y=#N$3F (Y counts up from the bottom, so this is
; screen row 112). #N$00 ends the picture. #N$08 followed by two bytes moves the pen.
; Bit 7 draws a line, bit 6 fills, and bit 5 paints attributes.
;
; .
;
; Keep the caller's state and aim at the picture.
@label=Drawing
c$F3C2 PUSH IY       ; {Keep the caller's registers and aim #REGiy at the
 $F3C4 PUSH HL       ; picture passed in #REGhl.
 $F3C5 PUSH HL       ;
 $F3C6 POP IY        ;
 $F3C8 PUSH DE       ;
 $F3C9 PUSH BC       ; }
; Put the pen at its starting position.
 $F3CA LD D,$7F      ; {Start the pen at X=#N$7F and Y=#N$3F (screen row 112),
 $F3CC LD E,$3F      ; with the line counters at #N$01.
 $F3CE LD B,$01      ;
 $F3D0 LD C,$01      ;
 $F3D2 LD L,$01      ; }
; Each command is one byte. #N$00 ends the picture.
@label=Drawing_Loop
*$F3D4 LD A,(IY+$00) ; {Finish the picture when the command byte is #N$00.
 $F3D7 AND A         ;
 $F3D8 JP Z,$F488    ; }
; #N$08 moves the pen to the two coordinates that follow.
 $F3DB INC IY        ; {Step past this command and jump ahead to #R$F3EF unless
 $F3DD CP $08        ; it is #N$08.
 $F3DF JR NZ,$F3EF   ; }
 $F3E1 LD D,(IY+$00) ; {Read the new X and mark it as a move.
 $F3E4 SET 7,D       ;
 $F3E6 INC IY        ; }
 $F3E8 LD E,(IY+$00) ; {Read the new Y and take the next command.
 $F3EB INC IY        ;
 $F3ED JR $F3D4      ; }
; A set bit 7 is a line. Bits 0-2 choose the direction, and the next byte's top
; bits are the step and its low six bits the length.
@label=Drawing_Line
*$F3EF BIT 7,A       ; {Jump to #R$F414 if this command does not draw a line.
 $F3F1 JR Z,$F414    ; }
 $F3F3 LD B,A        ; {The line direction is bits 0-2 of the command.
 $F3F4 AND $07       ;
 $F3F6 LD C,A        ; }
 $F3F7 LD A,B        ; {Keep the command's other line field.
 $F3F8 RRCA          ;
 $F3F9 AND $3C       ;
 $F3FB LD B,A        ; }
 $F3FC LD A,(IY+$00) ; {The next byte's low six bits are the line length.
 $F3FF AND $3F       ;
 $F401 LD L,A        ;
 $F402 INC L         ; }
 $F403 LD A,(IY+$00) ; {The top bits of that byte choose the step.
 $F406 INC IY        ;
 $F408 RLCA          ;
 $F409 RLCA          ;
 $F40A AND $03       ;
 $F40C OR B          ;
 $F40D LD B,A        ;
 $F40E INC B         ; }
 $F40F CALL $F56E    ; Call #R$F56E to draw the line.
 $F412 JR $F3D4      ; Jump back to #R$F3D4 for the next command.
; A set bit 6 is a fill. Bits 0-2 are the ink, and the next two bytes are the X
; and Y to fill from.
@label=Drawing_Fill
*$F414 BIT 6,A       ; {Jump to #R$F42E if this command is not a fill.
 $F416 JR Z,$F42E    ; }
 $F418 AND $07       ; {Read the fill X and the ink colour.
 $F41A PUSH DE       ;
 $F41B LD D,(IY+$00) ;
 $F41E SET 7,D       ;
 $F420 INC IY        ; }
 $F422 LD E,(IY+$00) ; {Read the fill Y.
 $F425 INC IY        ; }
 $F427 CALL $F490    ; Call #R$F490 to fill the shape.
 $F42A POP DE        ; Restore the pen from the stack.
 $F42B JP $F3D4      ; Take the next command.
; A set bit 5 paints attributes. Bits 0-2 become the paper colour, and the next
; bytes name the squares to paint.
@label=Drawing_Attribute
*$F42E BIT 5,A       ; {Take the next command unless this one paints
 $F430 JP Z,$F3D4    ; attributes.}
 $F433 AND $07       ; {Use bits 0-2 as the paper colour.
 $F435 RLCA          ;
 $F436 RLCA          ;
 $F437 RLCA          ;
 $F438 PUSH HL       ;
 $F439 PUSH DE       ;
 $F43A PUSH BC       ;
 $F43B LD C,A        ; }
 $F43C LD H,(IY+$00) ; {Read the attribute address.
 $F43F INC IY        ;
 $F441 LD A,(IY+$00) ; }
 $F444 ADD A,$10     ; {Add #N$10 to the low byte of the attribute address.
 $F446 LD L,A        ;
 $F447 INC IY        ; }
@label=Drawing_Run
*$F449 LD A,(IY+$00) ; {Stop this attribute run when the command is #N$FF.
 $F44C INC IY        ;
 $F44E CP $FF        ;
 $F450 JR Z,$F482    ; }
 $F452 LD B,A        ; {The low two bits are the direction and the rest is the
 $F453 AND $03       ; run length.
 $F455 LD E,A        ;
 $F456 LD A,B        ;
 $F457 RRCA          ;
 $F458 RRCA          ;
 $F459 AND $3F       ;
 $F45B INC A         ;
 $F45C LD B,A        ; }
@label=Drawing_Paint
*$F45D LD A,(HL)     ; {Flip the ink when it matches the paper colour being
 $F45E AND $07       ; painted, so it stays visible.
 $F460 RLCA          ;
 $F461 RLCA          ;
 $F462 RLCA          ;
 $F463 CP C          ;
 $F464 JR NZ,$F468   ;
 $F466 XOR $38       ; }
*$F468 RRCA          ; {Write the paper colour into the attribute byte.
 $F469 RRCA          ;
 $F46A RRCA          ;
 $F46B OR C          ;
 $F46C LD (HL),A     ;
 $F46D LD A,E        ;
 $F46E AND A         ; }
; Step up when the direction is up.
@label=Drawing_Step
 $F46F CALL Z,$F514  ; Call #R$F514 when the direction is up.
; Step right when the direction is right.
 $F472 DEC A         ; Count down to the rightward direction.
 $F473 CALL Z,$F540  ; Call #R$F540 when the direction is right.
; Step down when the direction is down.
 $F476 DEC A         ; Count down to the downward direction.
 $F477 CALL Z,$F525  ; Call #R$F525 when the direction is down.
; Step left when the direction is left.
 $F47A DEC A         ; Count down to the leftward direction.
 $F47B CALL Z,$F536  ; Call #R$F536 when the direction is left.
; Repeat for every attribute in the run.
 $F47E DJNZ $F45D    ; Repeat from #R$F45D for the length of the attribute run.
 $F480 JR $F449      ; Read the next attribute run.
; Join the next step.
; .
; The picture is finished.
@label=Drawing_AttributeDone
*$F482 POP BC        ; {Restore the pen from the stack.
 $F483 POP DE        ;
 $F484 POP HL        ; }
 $F485 JP $F3D4      ; Take the next picture command.
; Return.
@label=Drawing_Finish
*$F488 POP BC        ; {Restore the saved count, the saved source, the saved
 $F489 POP DE        ; pointer and the saved picture command from the stack.
 $F48A POP HL        ;
 $F48B POP IY        ; }
 $F48D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$7FA7 }
; LIST#

; Flags: Fill Seeds
;
; One byte for each fill direction. #R$F490 records whether a seed is already saved for that row.
; Read by #R$F490.
g$F48E DEFB $00,$00

; Drawing Fill
;
; Used by the routine at #R$F3C2.
; .
; Flood-fills from the pen and stores the ink at #R$F60B.
@label=DrawingFill
c$F490 LD ($F60B),A  ; {Store the ink, save the pen and the picture pointer,
 $F493 PUSH DE       ; and push the #N$B0 end marker.
 $F494 PUSH HL       ;
 $F495 LD HL,$00B0   ; }
 $F498 PUSH HL       ; {Save the end marker and read the pixel under the pen.
*$F499 CALL $F50D    ; }
 $F49C JR NZ,$F4A5   ; Go to #R$F4A5 if the pixel under the pen is already set.
 $F49E CALL $F565    ; {Step the pen left and try that pixel again until the
 $F4A1 JR NZ,$F499   ; left edge.}
 $F4A3 JR $F4AB      ; No set pixel to the left, so start filling from #R$F4AB.
; Plot this pixel and step the pen right.
@label=DrawingFill_Next
*$F4A5 CALL $F5D2    ; {Plot this pixel, then step the pen right.
 $F4A8 CALL $F55E    ; }
@label=DrawingFill_RecordDrawingPen
*$F4AB LD HL,$0000   ; {Clear the two bytes that remember a seed.
 $F4AE LD ($F48E),HL ; }
@label=DrawingFill_Loop
*$F4B1 CALL $F54A    ; {Go to #R$F4CD if the pen is already at the top edge.
 $F4B4 LD A,$00      ;
 $F4B6 JR Z,$F4CD    ; }
 $F4B8 CALL $F50D    ; {Jump ahead to #R$F4C8 if the pixel under the pen is
 $F4BB LD A,$00      ; already set.
 $F4BD JR NZ,$F4C8   ; }
 $F4BF LD A,($F48E)  ; {Jump to #R$F4C8 if a seed is already saved for this
 $F4C2 AND A         ; row.
 $F4C3 JR NZ,$F4C8   ; }
 $F4C5 PUSH DE       ; {Save this spot as a seed and note it in #REGa.
 $F4C6 LD A,$01      ; }
@label=DrawingFill_StepPen
*$F4C8 PUSH AF       ; {Save that note, step the pen down.
 $F4C9 CALL $F555    ; }
 $F4CC POP AF        ; Restore the note from the stack.
@label=DrawingFill_DrawingPenStep
*$F4CD LD ($F48E),A  ; {Store the note and step the pen down.
 $F4D0 CALL $F555    ; }
 $F4D3 LD A,$00      ; {Go to #R$F4EC, with #REGa=#N$00, if the pen could not
 $F4D5 JR Z,$F4EC    ; step down.}
 $F4D7 CALL $F50D    ; {Jump ahead to #R$F4E7 if the pixel under the pen is
 $F4DA LD A,$00      ; already set.
 $F4DC JR NZ,$F4E7   ; }
 $F4DE LD A,($F48F)  ; {Jump to #R$F4E7 if a seed is already saved for this
 $F4E1 AND A         ; row.
 $F4E2 JR NZ,$F4E7   ; }
 $F4E4 PUSH DE       ; {Save this spot as a seed and note it in #REGa.
 $F4E5 LD A,$01      ; }
@label=DrawingFill_StepPenUp
*$F4E7 PUSH AF       ; {Save the note, step the pen up.
 $F4E8 CALL $F54A    ; }
 $F4EB POP AF        ; Restore the note from the stack.
@label=DrawingFill_DrawingPenDrawing
*$F4EC LD ($F48F),A  ; {Store the note in the other pen byte and plot this
 $F4EF CALL $F5D2    ; pixel.}
 $F4F2 CALL $F55E    ; {Go to #R$F4FF if the pen is already at the right edge.
 $F4F5 JR Z,$F4FF    ; }
 $F4F7 CALL $F50D    ; {Jump back to #R$F4B1 if the pixel under the pen is
 $F4FA JR Z,$F4B1    ; clear.}
 $F4FC CALL $F5D2    ; Plot this pixel.
@label=DrawingFill_ByteMatchesMarker
*$F4FF POP DE        ; {Take the next seed off the stack, and go back to #R$F499 until the #N$B0 end marker,
 $F500 LD A,E        ; pushed at the start of the fill, comes off.
 $F501 CP $B0        ;
 $F503 JR NZ,$F499   ; }
 $F505 LD A,$00      ; {Clear the drawing ink.
 $F507 LD ($F60B),A  ; }
 $F50A POP HL        ; {Restore the picture pointer and the pen from the stack.
 $F50B POP DE        ; }
 $F50C RET           ; Return.

; Keep Only The Bits That Are Set
;
; Used by the routine at #R$F490.
; .
; Reads the screen byte under the pen and keeps only the bits already set
; there.
@label=KeepOnlyBitsThatAreSet
c$F50D PUSH HL       ; {Call #R$F5FB to work out the pixel address.
 $F50E CALL $F5FB    ; }
 $F511 AND (HL)      ; Keep only the screen bits already set under the pen.
 $F512 POP HL        ; Restore the saved pointer from the stack.
 $F513 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$80EE }
; LIST#

; Attribute Up
;
; Used by the routine at #R$F3C2.
; .
; Moves the attribute address one row up. The attribute file begins at #N$5800,
; so a high byte of #N$57 means the step left the screen.
@label=AttributeUp
c$F514 PUSH AF       ; {Keep the colour and the pen, and step the screen
 $F515 PUSH DE       ; pointer back one attribute row.
 $F516 LD DE,$0020   ;
 $F519 AND A         ;
 $F51A SBC HL,DE     ; }
 $F51C LD A,H        ; {Jump ahead to #R$F522 if the high byte of the address
 $F51D CP $57        ; is not #N$57.
 $F51F JR NZ,$F522   ; }
 $F521 ADD HL,DE     ; Undo the step that passed the top row.
@label=AttributeUp_Next
*$F522 POP DE        ; {Restore the colour from the stack.
 $F523 POP AF        ; }
 $F524 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$80F5 }
; LIST#

; Attribute Down
;
; Used by the routine at #R$F3C2.
; .
; Moves the attribute address one row down. A high byte of #N$5A means the step
; passed the end of the attribute file.
@label=AttributeDown
c$F525 PUSH AF       ; {Keep the colour and step the attribute address down one
 $F526 PUSH DE       ; row.
 $F527 LD DE,$0020   ;
 $F52A ADD HL,DE     ; }
 $F52B LD A,H        ; {Leave the new row in place when it is still on screen, and fall through when
 $F52C CP $5A        ; it is not.
 $F52E JR NZ,$F532   ; }
 $F530 AND A         ; Clear the carry before the row is stepped back.
 $F531 SBC HL,DE     ; Step back one row (#N$20) because the step left the
                     ; attribute file.
 $F533 POP DE        ; {Restore the pen and the colour from the stack.
 $F534 POP AF        ; }
 $F535 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$8106 }
; LIST#

; Attribute Left
;
; Used by the routine at #R$F3C2.
; .
; Moves the attribute address one byte left, back toward the top of the
; attribute file at #N$5800.
@label=AttributeLeft
c$F536 PUSH AF       ; {Step back one attribute.
 $F537 DEC HL        ; }
 $F538 LD A,H        ; {Jump ahead to #R$F53E unless the high byte is #N$57.
 $F539 CP $57        ;
 $F53B JR NZ,$F53E   ; }
 $F53D INC HL        ; Undo the step that passed the left edge.
@label=AttributeLeft_Next
*$F53E POP AF        ; Restore the colour from the stack.
 $F53F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$8117 }
; LIST#

; Attribute Right
;
; Used by the routine at #R$F3C2.
; .
; Moves the attribute address one byte right. A high byte of #N$5A means it
; passed the end of the attribute file.
@label=AttributeRight
c$F540 PUSH AF       ; {Step to the next attribute.
 $F541 INC HL        ; }
 $F542 LD A,H        ; {Skip the correction unless the pointer has gone past the end of the attribute file
 $F543 CP $5A        ; (high byte #N$5A).
 $F545 JR NZ,$F548   ; }
 $F547 DEC HL        ; Undo the step that passed the right edge.
@label=AttributeRight_Next
*$F548 POP AF        ; Restore the colour from the stack.
 $F549 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$8121 }
; LIST#

; Step Pen Up
;
; Used by the routines at #R$F490 and #R$F56E.
; .
; Moves the pen one pixel up the screen. #REGe counts up from the bottom row, because #R$F5FB
; hands it to the ROM PIXEL-ADD routine. When the pen would pass the top row (#REGe=#N$B0) it stays
; put and the zero flag is set.
@label=StepPenUp
c$F54A INC E         ; {Move the pen up and return when it is still on screen.
 $F54B LD H,A        ;
 $F54C LD A,E        ;
 $F54D CP $B0        ;
 $F54F LD A,H        ;
 $F550 RET NZ        ; }
 $F551 DEC E         ; {The pen passed the top row, so step back and tell the
 $F552 XOR A         ; caller it did not move.
 $F553 LD A,H        ; }
 $F554 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$812B }
; LIST#

; Step Pen Down
;
; Used by the routines at #R$F490 and #R$F56E.
; .
; Moves the pen one pixel down the screen. When #REGe would wrap through #N$FF (below the
; bottom row) the pen stays put and the zero flag is set.
@label=StepPenDown
c$F555 DEC E         ; {Move the pen down and return when it is still on
 $F556 LD H,A        ; screen.
 $F557 LD A,E        ;
 $F558 CP $FF        ;
 $F55A LD A,H        ;
 $F55B RET NZ        ; }
 $F55C INC E         ; The pen passed the bottom row, so step back.
 $F55D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$813A }
; LIST#

; Step Pen Right
;
; Used by the routines at #R$F490 and #R$F56E.
; .
; Moves the pen one pixel right, and steps back if X wraps.
@label=StepPenRight
c$F55E INC D         ; {Move the pen right and return when it is still on the
 $F55F RET NZ        ; line.}
 $F560 DEC D         ; {The pen wrapped, so step back and tell the caller.
 $F561 LD H,A        ;
 $F562 XOR A         ;
 $F563 LD A,H        ; }
 $F564 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$8141 }
; LIST#

; Step Pen Left
;
; Used by the routines at #R$F490 and #R$F56E.
; .
; Moves the pen one pixel left. The top bit stays set while X is on the
; picture, and is clear once the pen has passed the left edge.
@label=StepPenLeft
c$F565 DEC D         ; {Move the pen left and return when it is still on the
 $F566 BIT 7,D       ; picture.
 $F568 RET NZ        ; }
 $F569 INC D         ; {The pen passed the left edge, so step back and tell the
 $F56A LD H,A        ; caller it did not move.
 $F56B XOR A         ;
 $F56C LD A,H        ; }
 $F56D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$8148 }
; LIST#

; Drawing Line
;
; Used by the routine at #R$F3C2.
; .
; Draws a straight line from the pen. Bit 0 of the direction chooses a steep
; line.
@label=DrawingLine
c$F56E BIT 0,C       ; {Jump ahead to #R$F5A2 if bit 0 is set (steep line).
 $F570 JR NZ,$F5A2   ; }
 $F572 PUSH HL       ; {Keep the picture pointer and the counters, then plot
 $F573 PUSH BC       ; this pixel.
*$F574 CALL $F5D2    ; }
 $F577 BIT 2,C       ; {Jump ahead to #R$F582 if bit 2 is clear.
 $F579 JR Z,$F582    ; }
 $F57B CALL $F565    ; {Go to #R$F59F if the pen is already at the left edge.
 $F57E JR Z,$F59F    ; }
 $F580 JR $F587      ; The pen has moved left, so skip the rightward step and
                     ; join #R$F587.
; Steps the pen right, and steps it up or down (bit 1) when this pixel column
; is finished.
@label=DrawingLine_Next
*$F582 CALL $F55E    ; {Go to #R$F59F if the pen is already at the right edge.
 $F585 JR Z,$F59F    ; }
@label=DrawingLine_TestCountFinished
*$F587 DEC B         ; {Jump ahead to #R$F59C if the count is not finished.
 $F588 JR NZ,$F59C   ; }
 $F58A BIT 1,C       ; {Jump ahead to #R$F595 if bit 1 is clear.
 $F58C JR Z,$F595    ; }
 $F58E CALL $F555    ; {Go to #R$F59F if the pen is already at the bottom edge.
 $F591 JR Z,$F59F    ; }
 $F593 JR $F59A      ; Carry on with the line once this step is ready.
; Steps the pen up and repeats for the pixels still left.
@label=DrawingLine_StepPenUp
*$F595 CALL $F54A    ; {Go to #R$F59F if the pen is already at the top edge.
 $F598 JR Z,$F59F    ; }
@label=DrawingLine_CountHasRun
*$F59A POP BC        ; Restore the counters from the stack.
 $F59B PUSH BC       ; {Keep a copy, and plot the next pixel from #R$F574 until
*$F59C DEC L         ; the length in #REGl runs out.
 $F59D JR NZ,$F574   ; }
@label=DrawingLine_BringSavedCount
*$F59F POP BC        ; {Restore the saved count and the saved pointer from the
 $F5A0 POP HL        ; stack.}
 $F5A1 RET           ; Return.
; Plots this pixel and steps down when bit 1 is set.
@label=DrawingLine_PlotPixel
*$F5A2 PUSH HL       ; {Keep the picture pointer and the counters, then plot
 $F5A3 PUSH BC       ; this pixel.
*$F5A4 CALL $F5D2    ; }
 $F5A7 BIT 1,C       ; {Jump ahead to #R$F5B2 if bit 1 is clear.
 $F5A9 JR Z,$F5B2    ; }
 $F5AB CALL $F555    ; {Go to #R$F5CF if the pen is already at the bottom edge.
 $F5AE JR Z,$F5CF    ; }
 $F5B0 JR $F5B7      ; Skip the upward step and carry on from #R$F5B7.
; Steps the pen up, and steps it left or right when this pixel row is finished.
@label=DrawingLine_StepPenUpAgain
*$F5B2 CALL $F54A    ; {Go to #R$F5CF if the pen is already at the top edge.
 $F5B5 JR Z,$F5CF    ; }
@label=DrawingLine_TestCountFinishedAgain
*$F5B7 DEC B         ; {Jump ahead to #R$F5CC if the count is not finished.
 $F5B8 JR NZ,$F5CC   ; }
 $F5BA BIT 2,C       ; {Jump ahead to #R$F5C5 if bit 2 is clear.
 $F5BC JR Z,$F5C5    ; }
 $F5BE CALL $F565    ; {Go to #R$F5CF if the pen is already at the left edge.
 $F5C1 JR Z,$F5CF    ; }
 $F5C3 JR $F5CA      ; Carry on with the line once the other step is ready.
; Steps the pen right and repeats for the pixels still left.
@label=DrawingLine_StepsPenRight
*$F5C5 CALL $F55E    ; {Go to #R$F5CF if the pen is already at the right edge.
 $F5C8 JR Z,$F5CF    ; }
@label=DrawingLine_CountHasRunAgain
*$F5CA POP BC        ; Restore the counters from the stack.
 $F5CB PUSH BC       ; {And plot the next pixel from #R$F5A4 until the length
*$F5CC DEC L         ; in #REGl runs out.
 $F5CD JR NZ,$F5A4   ; }
@label=DrawingLine_BringSavedCountAgain
*$F5CF POP BC        ; {Restore the saved count and the saved pointer from the
 $F5D0 POP HL        ; stack.}
 $F5D1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$8151 }
; LIST#

; Plot A Pixel
;
; Used by the routines at #R$F490 and #R$F56E.
; .
; Sets the pixel under the pen and paints its attribute with the ink at
; #R$F60B.
@label=PlotPixel
c$F5D2 PUSH HL       ; {Ask the ROM for this pixel's address and keep the mask.
 $F5D3 CALL $F5FB    ;
 $F5D6 PUSH AF       ;
 $F5D7 PUSH HL       ; }
 $F5D8 LD A,H        ; Take the high byte of the pixel address.
 $F5D9 AND $18       ; Keep the third of the screen it falls in.
 $F5DB RRCA          ; {Shift that third down to the low bits.
 $F5DC RRCA          ;
 $F5DD RRCA          ; }
 $F5DE ADD A,$58     ; Add #N$58 to reach the attribute file.
 $F5E0 LD H,A        ; {Point at the attribute and clear its ink.
 $F5E1 LD A,(HL)     ;
 $F5E2 AND $38       ;
 $F5E4 LD (HL),A     ; }
 $F5E5 LD A,($F60B)  ; {Rotate the ink at #R$F60B into the paper bits and skip the clash test when it already
 $F5E8 RLCA          ; differs from the attribute.
 $F5E9 RLCA          ;
 $F5EA RLCA          ;
 $F5EB CP (HL)       ;
 $F5EC JR NZ,$F5F0   ; }
 $F5EE XOR $38       ; Flip the ink when it matches the paper colour already
                     ; there, so it stays visible.
*$F5F0 RRCA          ; {Shift the ink back into place and merge it into the
 $F5F1 RRCA          ; attribute.
 $F5F2 RRCA          ;
 $F5F3 OR (HL)       ;
 $F5F4 LD (HL),A     ; }
 $F5F5 POP HL        ; {Restore the pixel address and the mask from the stack.
 $F5F6 POP AF        ; }
 $F5F7 OR (HL)       ; {Set the pixel in the display byte.
 $F5F8 LD (HL),A     ;
 $F5F9 POP HL        ; }
 $F5FA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HOBBIT$81B5 }
; LIST#

; Pixel Address
;
; Used by the routines at #R$F50D and #R$F5D2.
; .
; Asks the ROM for the display address of this pixel and builds the bit mask for it. #REGe is
; counted up from the bottom of the screen, and the ROM turns that into the screen row.
@label=PixelAddress
c$F5FB PUSH BC       ; {Call #SKOOLKID$22AA(PIXEL_ADD).
 $F5FC LD B,E        ;
 $F5FD LD C,D        ;
 $F5FE CALL $22AA    ; }
 $F601 LD B,A        ; {Take the column the ROM returned, count one further,
 $F602 INC B         ; and start the mask at #N$01.
 $F603 LD A,$01      ; }
@label=PixelAddress_Loop
*$F605 RRC A         ; {Shift the pixel mask until it covers this column.
 $F607 DJNZ $F605    ;
 $F609 POP BC        ; }
 $F60A RET           ; Return.

; Flags: Drawing Ink
;
; Ink byte stored by #R$F490 and shifted into the attribute of the plotted
; pixel by #R$F5D2.
g$F60B DEFB $38

; Table: Location Graphics
;
; Pictures are drawing commands executed by #R$F3C2, not bitmaps. The pen
; starts at X=#N$7F and Y=#N$3F (Y counts up from the bottom, so this is screen
; row 112). #N$00 ends the picture. #N$08 and the next two bytes move the pen,
; with bit 7 of X set. Bit 7 draws a line: bits 0-2 are the direction and the
; next byte holds the step in its top bits and the length in its low six bits.
; Bit 6 fills in the ink from bits 0-2, using the next two bytes as X and Y.
; Bit 5 paints attributes: bits 0-2 are shifted up to the paper colour, the
; next two bytes form the attribute address with #N$10 added to the low byte,
; and each following byte is a run until #N$FF. Bits 0-1 of a run select up,
; right, down or left.
@label=Table_LocationGraphics
b$F60C DEFB $05      ; #GFXLOC
 $F60D DEFW $FF47    ; #GFXPIC
 $F60F DEFB $4A      ; #GFXLOC
 $F610 DEFW $FE82    ; #GFXPIC
 $F612 DEFB $47      ; #GFXLOC
 $F613 DEFW $FDA8    ; #GFXPIC
 $F615 DEFB $59      ; #GFXLOC
 $F616 DEFW $FCED    ; #GFXPIC
 $F618 DEFB $58      ; #GFXLOC
 $F619 DEFW $FC3A    ; #GFXPIC
 $F61B DEFB $36      ; #GFXLOC
 $F61C DEFW $FB6E    ; #GFXPIC
 $F61E DEFB $37      ; #GFXLOC
 $F61F DEFW $FB6E    ; #GFXPIC
 $F621 DEFB $0B      ; #GFXLOC
 $F622 DEFW $FAAA    ; #GFXPIC
 $F624 DEFB $3E      ; #GFXLOC
 $F625 DEFW $F9F0    ; #GFXPIC
 $F627 DEFB $06      ; #GFXLOC
 $F628 DEFW $F928    ; #GFXPIC
 $F62A DEFB $5C      ; #GFXLOC
 $F62B DEFW $F868    ; #GFXPIC
 $F62D DEFB $5F      ; #GFXLOC
 $F62E DEFW $F7BE    ; #GFXPIC
 $F630 DEFB $3D      ; #GFXLOC
 $F631 DEFW $F6ED    ; #GFXPIC
 $F633 DEFB $0C      ; #GFXLOC
 $F634 DEFW $F638    ; #GFXPIC
 $F636 DEFB $FF      ; Terminator.

; Unused
;
; Padding byte between the graphics table and the first picture.
u$F637 DEFB $00

