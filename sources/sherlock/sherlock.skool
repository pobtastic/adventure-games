; Game Entry Point Alias
;
; Jumps to the real game entry point. The BASIC loader starts here.
;
; .
;
; #SIM(start=$A040,stop=$A04E)#SIM(start=$A05B,stop=$A071)
@label=Alias_GameEntryPoint
c$5B1B JP $A040      ; Jump to #R$A040, the game entry point.

; Tape Header
;
; Header loaded by #R$5B30. The type is #N$03, the name is a single letter p,
; and the load address is #R$5D80.
b$5B1E DEFB $03          ; Type.
 $5B1F DEFM "p         " ; Name.
 $5B29 DEFW $A280        ; Length, read by #R$5B30.
 $5B2B DEFW $5D80        ; Load address, read by #R$5B30.
 $5B2D DEFW $8000        ; Parameter.

; Flags: Tape Load Result
;
; Written by #R$5B8B. #N$01 means the load succeeded.
; Read by #R$5B30 and #R$5B8B.
g$5B2F DEFB $01

; Tape Loader: Game
;
; Loads the game header and the code block it names, and resets the Spectrum if either
; load fails or the header is not a code file.
; Called from the loader bytes at #R$5B10 and #R$5B18.
;
; .
;
; Read the game header from tape.
@label=TapeLoader_Game
c$5B30 LD IX,$5B1E   ; {Point #REGix at the tape header (#R$5B1E), request #N$11 bytes, and ask the
 $5B34 LD DE,$0011   ; ROM routine to load rather than verify.
 $5B37 XOR A         ;
 $5B38 SCF           ; }
 $5B39 CALL $5B8B    ; Call #R$5B8B to load the next tape block.
; Give up unless the header loaded.
 $5B3C LD A,($5B2F)  ; {Reset the Spectrum unless the tape load result
 $5B3F DEC A         ; (#R$5B2F) is #N$01.
 $5B40 JP NZ,$0000   ; }
; The header must describe a code block.
 $5B43 LD A,($5B1E)  ; {Reset the Spectrum unless the header type at #R$5B1E is
 $5B46 CP $03        ; #N$03.
 $5B48 JP NZ,$0000   ; }
; Load the game block named by the header.
 $5B4B LD IX,($5B2B) ; {Take the load address from #R$5B2B and the length from #R$5B29, and load that
 $5B4F LD DE,($5B29) ; block as data.
 $5B53 LD A,$FF      ;
 $5B55 SCF           ; }
 $5B56 CALL $5B8B    ; Call #R$5B8B to load the next tape block.
; Return to BASIC only if the game block loaded.
 $5B59 DI            ; {Disable interrupts and reset the Spectrum unless the tape load result (#R$5B2F)
 $5B5A LD A,($5B2F)  ; is #N$01.
 $5B5D DEC A         ;
 $5B5E JP NZ,$0000   ; }
 $5B61 RET           ; Return.
; Loads the loading-screen header and then the screen at #N$4000, and resets the
; Spectrum if either load fails.
; .
; Read a tape header for the loading screen.
@label=TapeLoader_Screen
 $5B62 LD IX,$5B1E   ; {Point #REGix at the tape header (#R$5B1E), request #N$11 bytes, and ask the
 $5B66 LD DE,$0011   ; ROM routine to load rather than verify.
 $5B69 XOR A         ;
 $5B6A SCF           ; }
 $5B6B CALL $5B8B    ; Call #R$5B8B to load the next tape block.
; Give up unless that header loaded.
 $5B6E LD A,($5B2F)  ; {Reset the Spectrum unless the tape load result
 $5B71 DEC A         ; (#R$5B2F) is #N$01.
 $5B72 JP NZ,$0000   ; }
; Load the picture into the display file.
 $5B75 LD IX,$4000   ; {Point #REGix at the screen (#N$4000) and load #N$1B00
 $5B79 LD DE,$1B00   ; bytes as data.
 $5B7C LD A,$FF      ;
 $5B7E SCF           ; }
 $5B7F CALL $5B8B    ; Call #R$5B8B to load the next tape block.
; Return only if the screen loaded.
 $5B82 DI            ; {Disable interrupts and reset the Spectrum unless the tape load result (#R$5B2F)
 $5B83 LD A,($5B2F)  ; is #N$01.
 $5B86 DEC A         ;
 $5B87 JP NZ,$0000   ; }
 $5B8A RET           ; Return.

; Tape Loader: LD_BYTES
;
; Used by the routine at #R$5B30.
; .
; Calls the ROM tape loader, shows a white border while it runs, and records success
; or failure in the tape load result.
;
; .
;
; Arrange the flags the ROM loader expects.
@label=TapeLoader_LoadBytes
c$5B8B INC D         ; Leave #REGd one below #N$FF so the block length survives the ROM loader's
                     ; test.
 $5B8C EX AF,AF'     ; Park the header/data marker. #REGa is #N$00 for a header and #N$FF for a
                     ; data block.
 $5B8D DEC D         ; Put the block length back. The ROM loader rejects a length whose top byte is
                     ; #N$FF.
 $5B8E DI            ; Disable interrupts so the tape timing is stable.
; Show a white border while the tape runs.
 $5B8F LD A,$0F      ; {Set a white border (#INK7) and raise the MIC bit on
 $5B91 OUT ($FE),A   ; port #N$FE.}
; Enter the ROM loader and come back to #R$5B9A.
 $5B93 LD HL,$5B9A   ; {Push #R$5B9A as the return address.
 $5B96 PUSH HL       ; }
 $5B97 JP $0562      ; Jump into #SKOOLKID$0556(LD_BYTES) at #N$0562.
; The ROM loader returns here. Restore the border.
@label=TapeLoader_AfterBytes
 $5B9A PUSH AF       ; {Set the border to #INK$07, saving flags the ROM loader
 $5B9B LD A,$07      ; returned.
 $5B9D OUT ($FE),A   ; }
 $5B9F POP AF        ; Restore the ROM flags from the stack.
; Record success as #N$01 and failure as #N$02.
 $5BA0 LD A,$01      ; {Record #N$01 when the block loaded, and #N$02 when it
 $5BA2 JR C,$5BA5    ; did not.
 $5BA4 INC A         ; }
@label=TapeLoader_StoreResult
*$5BA5 LD ($5B2F),A  ; Store that result in the tape load result (#R$5B2F).
 $5BA8 DI            ; Disable interrupts before returning to the caller.
 $5BA9 RET           ; Return.

; Unused
;
; Zero padding between the tape loader and the word index.
u$5BAA DEFB $00,$00,$00,$00,$00,$00,$00,$00
