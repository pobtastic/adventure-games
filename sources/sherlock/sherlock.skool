; Display Record
;
; Display record read by #R$C9BF. The show-message command at #R$EE95 passes this word to
; #R$C591.
;
; .
;
; Named from the script command at #R$EE95.
b$EF9C DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Set The Print Flag And Print
;
; Sets the print flag, prints the message in hand, and marks success.
;
; .
;
; Run by #R$CA64 after the display record at #R$EF9C, from the show-message
; command at #R$EE95.
@label=SetPrintFlagAndPrint
c$EF9E LD HL,$75E8   ; Take the message at #R$75D2+#N$16.
; This entry point is used by the routine at #R$EFAE.
*$EFA1 LD A,$01      ; {Set the print flag (#SKOOLKID$5C3C(TV_FLAG)).
 $EFA3 LD ($5C3C),A  ; }
 $EFA6 CALL $A59F    ; Call #R$A59F to print the message.
 $EFA9 OR %00000001  ; Reset the zero flag.
 $EFAB RET           ; Return.

; Display Record
;
; Display record read by #R$C9BF. The show-message command at #R$EF01 passes this word to
; #R$C591.
;
; .
;
; Named from the script command at #R$EF01.
b$EFAC DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Print This Handler's Message
;
; Prints the message at #R$75D2+#N$31.
;
; .
;
; Run by #R$CA64 after the display record at #R$EFAC, from the show-message
; command at #R$EF01.
@label=PrintHandlerMessage
c$EFAE LD HL,$7603   ; {Take the message at #R$75D2+#N$31 and go to #R$EFA1 to
 $EFB1 JR $EFA1      ; print it.}

; Display Record
;
; Display record read by #R$C9BF. The show-message commands at #R$EE3D and #R$EEBB pass
; this word to #R$C591.
;
; .
;
; Named from the script commands at #R$EE3D and #R$EEBB.
b$EFB3 DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Store The Character's Text Pointer
;
; Stores a text pointer on the character being processed and clears bit 6 of
; its record. A non-zero return means the script step succeeded.
;
; .
;
; Run by #R$CA64 after the display record at #R$EFB3, from the show-message commands at #R$EE3D and
; #R$EEBB.
@label=StoreCharacterTextPointer
c$EFB5 LD DE,$07F0    ; {Prepare pointer #N$07F0 and marker #N$10 for the
 $EFB8 LD B,$10       ; character being processed.
; This entry point is used by the routine at #R$EFC9.
*$EFBA LD A,($A036)   ; }
 $EFBD CALL $F1C1     ; Call #R$F1C1 to update that object.
 $EFC0 RES 6,(IX+$05) ; Clear bit 6 of the character record.
 $EFC4 OR %00000001   ; Reset the zero flag.
 $EFC6 RET            ; Return.

; Display Record
;
; Display record read by #R$C9BF. The show-message commands at #R$EE46, #R$EEC3, #R$EEDB
; and #R$EF09 pass this word to #R$C591.
;
; .
;
; Named from the script commands at #R$EE46, #R$EEC3, #R$EEDB and #R$EF09.
b$EFC7 DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Match Sherlock Disguise
;
; Goes to the special-case object when Sherlock's disguise is one of seven ids.
;
; .
;
; Run by #R$CA64 after the display record at #R$EFC7, from the show-message commands at #R$EE46,
; #R$EEC3, #R$EEDB and #R$EF09.
@label=MatchSherlockDisguise
c$EFC9 LD A,($A009)                     ; Read Sherlock's disguise.
 $EFCC CP $23                           ; {Go to #R$EFE6 if the disguise is
 $EFCE JR Z,$EFE6                       ; #N$23.}
 $EFD0 CP $21                           ; {Go to #R$EFE6 if the disguise is
 $EFD2 JR Z,$EFE6                       ; #N$21.}
 $EFD4 CP $22                           ; {Go to #R$EFE6 if the disguise is
 $EFD6 JR Z,$EFE6                       ; #N$22.}
 $EFD8 CP $26                           ; {Go to #R$EFE6 if the disguise is
 $EFDA JR Z,$EFE6                       ; #N$26.}
 $EFDC CP $25                           ; {Go to #R$EFE6 if the disguise is
 $EFDE JR Z,$EFE6                       ; #N$25.}
 $EFE0 CP $24                           ; {Go to #R$EFE6 if the disguise is
 $EFE2 JR Z,$EFE6                       ; #N$24.}
 $EFE4 CP $27                           ; See whether the disguise is #N$27.
*$EFE6 JP Z,$DFCC                       ; Go to #R$DFCC if the disguise
                                        ; matched.
 $EFE9 LD DE,$0000                      ; {Clear the text pointer and use the
 $EFEC LD B,$80                         ; marker #N$80.}
 $EFEE CALL $EFBA                       ; Call #R$EFBA to update the
                                        ; character's object.
 $EFF1 SET 6,(IX+$05)                   ; Set bit 6 of the character record.
 $EFF5 RET                              ; Return.
