; Copy The Character Onto Both Records
;
; Copies the character being processed onto the two records and gives both the location #N$32.
; Reached from the script command at #R$EA5F, run by #R$CC82.
; Run by #R$CA64 after the display record at #R$EAF6. A non-zero return means the script step succeeded.
@label=CopyCharacterOntoBothRecords
c$EAF8 LD A,($A034)    ; Read the room display parameter.
 $EAFB LD IX,($A015)   ; {Store that id at offset #N$01 of the record at
 $EAFF LD (IX+$01),A   ; #R$A015.}
 $EB02 LD (IX+$0F),$32 ; Give that record the location #N$32.
 $EB06 LD IX,($A013)   ; {Give the record at #R$A013 the location #N$32.
 $EB0A LD (IX+$0F),$32 ; }
 $EB0E OR %00000001    ; Reset the zero flag.
 $EB10 RET             ; Return.

; Display Record
;
; Display record read by #R$C9BF. The show-message commands at #R$EA31 and #R$EA43 pass
; this word to #R$C591.
;
; .
;
; Named from the script commands at #R$EA31 and #R$EA43.
b$EB11 DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Point At The First Character
;
; Points at the character record at #R$99A9 and joins the flag test.
;
; .
;
; Run by #R$CA64 after the display record at #R$EB11, from the show-message commands at #R$EA31 and
; #R$EA43.
@label=CopyCharacterOntoBothRecords_ActionFlags
c$EB13 LD IX,$99A9   ; Point at the character record at #R$99A9.
 $EB17 JR $EB1F      ; Go to #R$EB1F to test bit 1 of the action flags.

; Display Record
;
; Display record read by #R$C9BF. The show-message command at #R$EA2C passes this word to
; #R$C591.
;
; .
;
; Named from the script command at #R$EA2C.
b$EB19 DEFB $00,$00  ; Display record read by #R$C9BF: flags #N$00, value
                     ; #N$00.

; Point At The Other Character
;
; Points at the character record at #R$9997 and tests bit 1 of its action
; flags. A non-zero return means the script step succeeded.
;
; .
;
; Run by #R$CA64 after the display record at #R$EB19, from the show-message
; command at #R$EA2C.
@label=CopyCharacterOntoBothRecords_OtherRecord
c$EB1B LD IX,$9997                  ; Point at the character record at #R$9997.
; This entry point is used by the routine at #R$EB13.
@label=CopyCharacterOntoBothRecords_TestActionBit
*$EB1F LD HL,$0000                  ; {Clear the pointer and the carry.
 $EB22 AND A                        ; }
 $EB23 BIT 1,(IX+$03)               ; See whether bit 1 of the action flags is
                                    ; set.
 $EB27 RET                          ; Return.
