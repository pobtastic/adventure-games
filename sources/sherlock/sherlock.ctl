; Work-In-Progress. Label naming is loosely based on Action_ActionName_SubAction 
; e.g. Print_HighScore_Loop.

> $4000 @start
> $4000 @expand=#IF({asm})(#DEF(#HOBBIT(addr)(link=The Hobbit)$link))
> $4000 @set-handle-unsupported-macros=1
> $4000 @expand=#DEF1(#SKOOLKID(addr)(name)#HTML(<a rel="noopener nofollow" href="https://skoolkit.ca/disassemblies/rom/hex/asm/#EVAL({addr},16,4).html">){name}#HTML(</a>))
> $4000 @rom
> $4000 @expand=#DEF(#TOKENPTR #TOKEN(#PEEK(#PC+$01)*$100+#PEEK(#PC)))
> $4000 @expand=#DEF(#TEXTPTR "#TEXTTOKEN(#PEEK(#PC+$01)*$100+#PEEK(#PC))")
; Pictures draw into screen row 128, so the #SCR crop stays 129 rows high ($0102 at scale 2).
> $4000 @expand=#DEF(#GFXLOC Location: "#ROOM(#PEEK(#PC))".)
> $4000 @expand=#DEF(#GFXPIC Picture: #R(#PEEK(#PC)+#PEEK(#PC+$01)*$100).)
> $4000 @expand=#IF({asm})(#DEF(#MOVEMENT(address)))
> $4000 @expand=#IF({asm})(#DEF(#WORDTYPES(byte)))
> $4000 @expand=#IF({asm})(#DEF(#OBJECT(id)))
> $4000 @expand=#IF({asm})(#DEF(#ROOM(id)))
> $4000 @expand=#IF({asm})(#DEF(#TOKEN(id)))
> $4000 @expand=#IF({asm})(#DEF(#INK(id)))
> $4000 @expand=#IF({asm})(#DEF(#LOCATIONATTRIBUTE(address)))
> $4000 @expand=#IF({asm})(#DEF(#BITPACKED(n) Bit-packed letters.))
> $4000 @expand=#IF({asm})(#DEF(#WORDCFG Word configuration.))
> $4000 @expand=#IF({asm})(#DEF(#ATTRIBUTES Attributes.))
> $4000 @expand=#IF({asm})(#DEF(#EXITS(n)))
> $4000 @expand=#IF({asm})(#DEF(#PICTURE(addr)(fname,title)))
> $4000 @expand=#IF({asm})(#DEF(#BITGROUPS(address,count=8)))
> $4000 @expand=#IF({asm})(#DEF(#TEXTTOKEN(address,order=0)))
> $4000 @expand=#IF({asm})(#DEF(#SCRIPT(n) Script command.))

b $4000 Loading Screen
D $4000 #UDGTABLE
. { =h Sherlock Loading Screen. }
. { #SCR$02(loading) }
. UDGTABLE#
. Read by #R$5B30, #R$C10F, #R$C316 and #R$C3E4.
@ $4000 org=$4000
@ $4000 label=Loading
  $4000,$1800,$20 Pixels.
  $5800,$0300,$20 Attributes.
B $5B00,$1B

c $5B1B Game Entry Point Alias
@ $5B1B label=Alias_GameEntryPoint
D $5B1B Jumps to the real game entry point. The BASIC loader starts here.
N $5B1B #SIM(start=$A040,stop=$A04E)#SIM(start=$A05B,stop=$A071)
  $5B1B,$03 Jump to #R$A040, the game entry point.

b $5B1E Tape Header
D $5B1E Header loaded by #R$5B30. The type is #N$03, the name is a single letter p, and the load address is #R$5D80.
B $5B1E,$01 Type.
T $5B1F,$0A Name.
W $5B29,$02 Length, read by #R$5B30.
W $5B2B,$02 Load address, read by #R$5B30.
W $5B2D,$02 Parameter.

g $5B2F Flags: Tape Load Result
D $5B2F Written by #R$5B8B. #N$01 means the load succeeded.
. Read by #R$5B30 and #R$5B8B.
B $5B2F,$01

c $5B30 Tape Loader: Game
@ $5B30 label=TapeLoader_Game
D $5B30 Loads the game header and the code block it names, and resets the Spectrum if either
. load fails or the header is not a code file.
. Called from the loader bytes at #R$5B10 and #R$5B18.
N $5B30 Read the game header from tape.
  $5B30,$09 Point #REGix at the tape header (#R$5B1E), request #N$11 bytes, and ask the
. ROM routine to load rather than verify.
  $5B39,$03 Call #R$5B8B to load the next tape block.
N $5B3C Give up unless the header loaded.
  $5B3C,$07 Reset the Spectrum unless the tape load result (#R$5B2F) is #N$01.
N $5B43 The header must describe a code block.
  $5B43,$08 Reset the Spectrum unless the header type at #R$5B1E is #N$03.
N $5B4B Load the game block named by the header.
  $5B4B,$0B Take the load address from #R$5B2B and the length from #R$5B29, and load that
. block as data.
  $5B56,$03 Call #R$5B8B to load the next tape block.
N $5B59 Return to BASIC only if the game block loaded.
  $5B59,$08 Disable interrupts and reset the Spectrum unless the tape load result (#R$5B2F)
. is #N$01.
  $5B61,$01 Return.

N $5B62 Loads the loading-screen header and then the screen at #N$4000, and resets the
. Spectrum if either load fails.
@ $5B62 label=TapeLoader_Screen
N $5B62 Read a tape header for the loading screen.
  $5B62,$09 Point #REGix at the tape header (#R$5B1E), request #N$11 bytes, and ask the
. ROM routine to load rather than verify.
  $5B6B,$03 Call #R$5B8B to load the next tape block.
N $5B6E Give up unless that header loaded.
  $5B6E,$07 Reset the Spectrum unless the tape load result (#R$5B2F) is #N$01.
N $5B75 Load the picture into the display file.
  $5B75,$0A Point #REGix at the screen (#N$4000) and load #N$1B00 bytes as data.
  $5B7F,$03 Call #R$5B8B to load the next tape block.
N $5B82 Return only if the screen loaded.
  $5B82,$08 Disable interrupts and reset the Spectrum unless the tape load result (#R$5B2F)
. is #N$01.
  $5B8A,$01 Return.

c $5B8B Tape Loader: LD_BYTES
@ $5B8B label=TapeLoader_LoadBytes
D $5B8B Calls the ROM tape loader, shows a white border while it runs, and records success
. or failure in the tape load result.
N $5B8B Arrange the flags the ROM loader expects.
  $5B8B,$01 Leave #REGd one below #N$FF so the block length survives the ROM loader's
. test.
  $5B8C,$01 Park the header/data marker. #REGa is #N$00 for a header and #N$FF for a
. data block.
  $5B8D,$01 Put the block length back. The ROM loader rejects a length whose top byte is
. #N$FF.
  $5B8E,$01 Disable interrupts so the tape timing is stable.
N $5B8F Show a white border while the tape runs.
  $5B8F,$04 Set a white border (#INK7) and raise the MIC bit on port #N$FE.
N $5B93 Enter the ROM loader and come back to #R$5B9A.
  $5B93,$04 Push #R$5B9A as the return address.
  $5B97,$03 Jump into #SKOOLKID$0556(LD_BYTES) at #N$0562.
N $5B9A The ROM loader returns here. Restore the border.
@ $5B9A label=TapeLoader_AfterBytes
  $5B9A,$05 Set the border to #INK$07, saving flags the ROM loader returned.
  $5B9F,$01 Restore the ROM flags from the stack.
N $5BA0 Record success as #N$01 and failure as #N$02.
  $5BA0,$05 Record #N$01 when the block loaded, and #N$02 when it did not.
@ $5BA5 label=TapeLoader_StoreResult
  $5BA5,$03 Store that result in the tape load result (#R$5B2F).
  $5BA8,$01 Disable interrupts before returning to the caller.
  $5BA9,$01 Return.

u $5BAA Unused
D $5BAA Zero padding between the tape loader and the word index.
B $5BAA,$56

i $5C00
B $5C00,$0B

b $5C0B Word Buffer
@ $5C0B label=WordBuffer
D $5C0B Word-wrap buffer used by the game. #R$A9B7 stores each letter here through
. *#R$A9B5 until a space, newline or quote; #R$A9F6 then prints those letters and
. resets the pointer to #R$5C0B. It overlays the system variables from
. #SKOOLKID$5C0B(DEFADD) onwards. The store path has no hard length check; the flush
. path treats the buffered length as an 8-bit count and compares it with the screen
. width at #R$C1F5 (set to #N$12 or #N$24), so this block is sized to that maximum
. width (#N$24).
B $5C0B,$24

i $5C2F
B $5C2F,$9C

b $5CCB Stack
@ $5CCB label=Stack
B $5CCB,$B5

g $5D80 Table: Word index
@ $5D80 label=Table_WordIndex
D $5D80 Word index read by #R$A040, #R$A887 and #R$DA34.
W $5D80,$02 #LET(letter=($40+(#PC-$5D80)/$02))#IF(#PEEK(#PC+$01)*$0100+#PEEK(#PC))("#R($5DBF+#PEEK(#PC+$01)*$0100+#PEEK(#PC))(#CHR({letter}))",)
L $5D80,$02,$20

