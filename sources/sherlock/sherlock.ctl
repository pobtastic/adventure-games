B $94DD,$08,$02 Object Name: #TEXTPTR.
B $94E5,$01 Terminator #N(#PEEK(#PC)).

g $94E6 Object #N$67: "#OBJECT$67"
@ $94E6 label=Object_TriciasFrontDoor
B $94E6,$01 Appears in the game #N(#PEEK(#PC)) #IF(#PEEK(#PC)>$01)(times,time).
B $94E7,$01 #IF(#PEEK(#PC)==$FF)(No mother object,Mother object: #OBJECT(#PEEK(#PC))).
B $94E8,$01 Volume (?)
B $94E9,$01 Mass (?)
B $94EA,$01
B $94EB,$01 Strength (?)
B $94EC,$01
B $94ED,b$01 #ATTRIBUTES
B $94EE,$0D,$02 Object Name: #TEXTPTR.
B $94FB,$01 Terminator #N(#PEEK(#PC)).

g $94FC Object #N$68: "#OBJECT$68"
@ $94FC label=Object_GermanAgent
B $94FC,$01 Appears in the game #N(#PEEK(#PC)) #IF(#PEEK(#PC)>$01)(times,time).
B $94FD,$01 #IF(#PEEK(#PC)==$FF)(No mother object,Mother object: #OBJECT(#PEEK(#PC))).
B $94FE,$01 Volume (?)
B $94FF,$01 Mass (?)
B $9500,$01
B $9501,$01 Strength (?)
B $9502,$01
B $9503,b$01 #ATTRIBUTES
B $9504,$08,$02 Object Name: #TEXTPTR.
B $950C,$01 Terminator #N(#PEEK(#PC)).

g $950D Object #N$69: "#OBJECT$69"
@ $950D label=Object_OldMillRoadAsATopic
B $950D,$01 Appears in the game #N(#PEEK(#PC)) #IF(#PEEK(#PC)>$01)(times,time).
B $950E,$01 #IF(#PEEK(#PC)==$FF)(No mother object,Mother object: #OBJECT(#PEEK(#PC))).
B $950F,$01 Volume (?)
B $9510,$01 Mass (?)
B $9511,$01
B $9512,$01 Strength (?)
B $9513,$01
B $9514,b$01 #ATTRIBUTES
B $9515,$08,$02 Object Name: #TEXTPTR.
B $951D,$01 Terminator #N(#PEEK(#PC)).

g $951E Object #N$6A: "#OBJECT$6A"
@ $951E label=Object_SaleLocation
B $951E,$01 Appears in the game #N(#PEEK(#PC)) #IF(#PEEK(#PC)>$01)(times,time).
B $951F,$01 #IF(#PEEK(#PC)==$FF)(No mother object,Mother object: #OBJECT(#PEEK(#PC))).
B $9520,$01 Volume (?)
B $9521,$01 Mass (?)
B $9522,$01
B $9523,$01 Strength (?)
B $9524,$01
B $9525,b$01 #ATTRIBUTES
B $9526,$08,$02 Object Name: #TEXTPTR.
B $952E,$01 Terminator #N(#PEEK(#PC)).

g $952F Object #N$6B: "#OBJECT$6B"
@ $952F label=Object_Guilty
B $952F,$01 Appears in the game #N(#PEEK(#PC)) #IF(#PEEK(#PC)>$01)(times,time).
B $9530,$01 #IF(#PEEK(#PC)==$FF)(No mother object,Mother object: #OBJECT(#PEEK(#PC))).
B $9531,$01 Volume (?)
B $9532,$01 Mass (?)
B $9533,$01
B $9534,$01 Strength (?)
B $9535,$01
B $9536,b$01 #ATTRIBUTES
B $9537,$08,$02 Object Name: #TEXTPTR.
B $953F,$01 Terminator #N(#PEEK(#PC)).

g $9540 Object #N$6C: "#OBJECT$6C"
@ $9540 label=Object_Idiot
B $9540,$01 Appears in the game #N(#PEEK(#PC)) #IF(#PEEK(#PC)>$01)(times,time).
B $9541,$01 #IF(#PEEK(#PC)==$FF)(No mother object,Mother object: #OBJECT(#PEEK(#PC))).
B $9542,$01 Volume (?)
B $9543,$01 Mass (?)
B $9544,$01
B $9545,$01 Strength (?)
B $9546,$01
B $9547,b$01 #ATTRIBUTES
B $9548,$08,$02 Object Name: #TEXTPTR.
B $9550,$01 Terminator #N(#PEEK(#PC)).

g $9551 Object #N$6D: "#OBJECT$6D"
@ $9551 label=Object_PoliceCab
B $9551,$01 Appears in the game #N(#PEEK(#PC)) #IF(#PEEK(#PC)>$01)(times,time).
B $9552,$01 #IF(#PEEK(#PC)==$FF)(No mother object,Mother object: #OBJECT(#PEEK(#PC))).
B $9553,$01 Volume (?)
B $9554,$01 Mass (?)
B $9555,$01
B $9556,$01 Strength (?)
B $9557,$01
B $9558,b$01 #ATTRIBUTES
B $9559,$08,$02 Object Name: #TEXTPTR.
B $9561,$01 Terminator #N(#PEEK(#PC)).

g $956A Spare RAM
D $956A Spare bytes between the object definitions and the timetable at #R$9860.
. #R$9570 holds #N$02F0 and the other bytes are zero.
  $956A,$06 Zero bytes.
  $9570,$02 Word #N$02F0.
  $9572,$02EE Zero bytes.

g $9860 Table: Timetable
@ $9860 label=Table_Timetable
D $9860 Holds character data.
. Read by #R$A064, #R$B0AC, #R$CA7F, #R$CB58, #R$CBC2, #R$CC0E, #R$CC5A, #R$D045 and #R$E58C.
.
. Note for Sherlock himself the character ID can also be:
. #TABLE(default,centre,centre)
. { =h ID Byte | =h Character }
. #FOREACH($00,$01,$64)(x,{ #Nx | "#OBJECTx" })
. TABLE#
. Due to Sherlock being able to wear disguises.
N $9860 Timetable #N((#PC-$9860)/$08).
B $9860,$01 Character: "#OBJECT(#PEEK(#PC))".
W $9861,$02
B $9863,$01 Location?
W $9864,$02
W $9866,$02 Timer?
L $9860,$08,$18
B $9920,$01 Terminator.

b $9921 Action: Sherlock
D $9921 Action script for Sherlock, pointed to from the timetable at #R$9860. The bytes are script records, not Z80 instructions.
B $9921,$02 #SCRIPT($02)
B $9923,$05 #SCRIPT($05)
B $9928,$05 #SCRIPT($05)
B $992D,$05 #SCRIPT($05)
B $9932,$05 #SCRIPT($05)
B $9937,$05 #SCRIPT($05)
B $993C,$05 #SCRIPT($05)
B $9941,$04 #SCRIPT($04)
B $9945,$03 #SCRIPT($03)
B $9948,$02 #SCRIPT($02)
B $994A,$03 #SCRIPT($03)

g $994D Table: Character Pairs
D $994D Pairs of character ids scanned by #R$ABF3 until a zero word.
. Read by #R$ABF3, #R$BDC2 and #R$BF45.
W $994D,$02

g $9993 Character State
D $9993 Character state record. #R$E199 sets the character record pointer here.
. Read by #R$E17B.
  $9993,$04

g $9997 Character State
D $9997 Character state record pointed at by #R$EB1B.
. Read by #R$EAF8.
  $9997,$12

g $99A9 Character State
D $99A9 Character state record for the action handlers.
. Read by #R$9D95 and #R$EAF8.
  $99A9,$0E

g $99B7 Character State: Basil
D $99B7 Character state record. Basil's action at #R$9CC5 sets the character record pointer
. here.
. Read by #R$9CA2.
  $99B7,$2C

g $99E3 Character State
D $99E3 Character state record for the action handlers.
. Read by #R$9D95.
  $99E3,$0E

g $99F1 Character State
D $99F1 Character state record. The following bytes through #R$99F1+#N$0A are data; code begins at #R$99FC.
. Read by #R$9D95.
  $99F1,$0B

c $99FC Action: Print The Hurry And Catch Line
@ $99FC label=ActionPrintHurryCatchLine
D $99FC Marks the action taken and prints the line that tells someone to hurry and catch
. them.
. Reached through the character state record at #R$99A9.
N $99FC Mark action taken.
  $99FC,$03 Call #R$9A74 to mark the action taken.
  $99FF,$06 Jump ahead to #R$A59F to print this message.

c $9A05 Action: Set The State Mark And Say It Is Not Seen
@ $9A05 label=ActionSetStateMarkSayItIsNotSeen
D $9A05 Sets the mark at the end of this character state, records that the action has
. been taken, and prints the line that begins "I do not see the".
. Reached through the character state record at #R$99E3.
  $9A05,$08 Set the character-state mark, then mark the action taken.
  $9A0D,$06 Jump ahead to #R$A59F to print this message.

c $9A13 Action: Print The Sale Remark
@ $9A13 label=ActionPrintSaleRemark
D $9A13 Prints the sale remark when both character-state marks are set. Otherwise it
. clears the action marks and prints the other line.
N $9A13 Bit 1 of the state byte at #R$994D+#N$29 is clear?
  $9A13,$07 Jump to #R$9A2F if bit 1 of the state byte at #R$994D+#N$29 is clear.
N $9A1A Bit 1 of the state byte at #R$994D+#N$37 is clear?
  $9A1A,$07 Jump to #R$9A2F if bit 1 of the state byte at #R$994D+#N$37 is clear.
N $9A21 Mark action taken.
  $9A21,$03 Call #R$9A74 to mark the action taken.
  $9A24,$08 Set bit 1 of the character state at #R$99A9+#N$09 and take the message at #R$6D9A+#N$02FF.
  $9A2C,$03 Jump ahead to #R$A59F to print this message.

N $9A2F Clears bits 0 and 1 of the action flags and prints the token at #R$7265.
@ $9A2F label=ActionPrintSaleRemark_ResetActionBits
  $9A2F,$08 Clear the action-taken flag and clear the action-pending flag.
  $9A37,$06 Jump ahead to #R$A59F to print this message.

c $9A3D Action: Arm The Later Exit And Print Tomorrow
@ $9A3D label=ActionArmLaterExitPrintTomorrow
D $9A3D Marks the action taken, changes the later check so that it returns at once, and
. prints the line about tomorrow.
. Reached through the character pairs table at #R$994D.
N $9A3D Mark action taken.
  $9A3D,$03 Call #R$9A74 to mark the action taken.
  $9A40,$08 Change the later check so that it returns at once.
  $9A48,$03 Jump ahead to #R$A59F to print this message.

c $9A4B Action: Print The Conclusion
@ $9A4B label=ActionPrintConclusion
D $9A4B Marks the action taken, sets the first character-state mark, and prints the
. conclusion.
. Reached through the character pairs table at #R$994D.
N $9A4B Mark action taken.
  $9A4B,$03 Call #R$9A74 to mark the action taken.
  $9A4E,$08 Mark bit 1 of this character-state byte and take the police message.
  $9A56,$03 Jump ahead to #R$A59F to print this message.

c $9A59 Action: Move Mrs Jones
@ $9A59 label=ActionMoveMrsJones
D $9A59 Moves Mrs Jones out of the room and prints the remark about her distress.
. Reached through the character pairs table at #R$994D.
  $9A59,$08 Look up Mrs Jones.
  $9A61,$08 Mark the object as moved and clear the character attribute.
  $9A69,$08 Mark bit 1 of this character-state byte and take the police message.
  $9A71,$03 Jump ahead to #R$A59F to print this message.

c $9A74 Mark Action Taken
@ $9A74 label=MarkActionTaken
D $9A74 Marks the current script action as already performed, so the character will not
. repeat it.
  $9A74,$08 Mark the action taken so the script will not repeat it.
  $9A7C,$01 Return.

b $9A7D Action Separator
D $9A7D Terminator #N$FF, then the display record that runs the opening text.
. The terminator is read by #R$BD4B.

B $9A7D,$01 Terminator #N$FF.
B $9A7E,$02 Display record read by #R$C9BF: flags #N$00, value #N$00.

c $9A80 Action: Print Opening Text
@ $9A80 label=ActionPrintOpeningText
D $9A80 Prints the token at #R$68E9+#N$2C or #R$68E9+#N$37 according to the current character.
. Run by #R$CA64 after the display record at #R$9A7E. A non-zero return means the script step succeeded.
  $9A80,$07 Compare the current character with #N$00 and take #N$01.
  $9A87,$03 Take the message at #R$68E9+#N$2C.
  $9A8A,$02 Jump ahead to #R$9A90 if the current character is #N$00.
  $9A8C,$04 Clear #REGa and take the message at #R$68E9+#N$37.
@ $9A90 label=ActionPrintOpeningText_Next
  $9A90,$06 Store it in the print mode, then call #R$A59F to print the message.
  $9A96,$02,b$01 Reset the zero flag.
  $9A98,$01 Return.

N $9A99 Attribute pair.
B $9A99,$02 Display record read by #R$C9BF: flags #N$04, value #N$00.
@ $9A9B label=ActionPrintOpeningText_MatchAttribute
N $9A9B Run by #R$CA64 after the display record at #R$9A99.
  $9A9B,$06 Return zero through #R$DC15 if #R$9AA3 finds no display parameter.
  $9AA1,$02 Jump ahead to #R$9AD7 to adjust attribute match.

c $9AA3 Read The Room Display Parameter
@ $9AA3 label=ReadRoomDisplayParameter
D $9AA3 Accepts the picture when the character attribute is #N$67 and the room display parameter is #N$32, or when the character attribute is #N$32 and the room display parameter is #N$67 or #N$12.
  $9AA3,$07 Jump ahead to #R$9AB5 if the current character attribute is not #N$67.
  $9AAA,$09 Jump to #R$9AC8 if the room display parameter is #N$32.
@ $9AB3 label=ReadRoomDisplayParameter_Loop
  $9AB3,$01 Clear #REGa.
  $9AB4,$01 Return.

N $9AB5 The character attribute is #N$32. Accept the picture when the room display parameter is #N$67 or #N$12.
@ $9AB5 label=ReadRoomDisplayParameter_TestRoomByte
  $9AB5,$04 Jump to #R$9AB3 if the character attribute is not #N$32.
  $9AB9,$09 Jump to #R$9AC8 if the room display parameter is #N$67.
  $9AC2,$04 Jump back to #R$9AB3 while the room display parameter is not #N$12.
  $9AC6,$02 The token is #N$5E.
@ $9AC8 label=ReadRoomDisplayParameter_TestActionSucceeded
  $9AC8,$02,b$01 Reset the zero flag.
  $9ACA,$01 Return.

N $9ACB Script action: adjust attribute match.
B $9ACB,$02 Display record read by #R$C9BF: flags #N$04, value #N$00.
@ $9ACD label=ReadRoomDisplayParameter_AdjustMatch
N $9ACD Run by #R$CA64 after the display record at #R$9ACB.
  $9ACD,$06 Return zero through #R$DC15 if #R$9AA3 finds no display parameter.
  $9AD3,$04 Take the low byte of the pointer, drop #N$14 from the attribute pair result
. and store that in the low byte.

N $9AD7 Leave #N$6D as the result, then record the result in the character just matched,
. then leave #N$69 as the result.
  $9AD7,$02 #OBJECT($6D).
  $9AD9,$03 Store it in the character just matched.
  $9ADC,$05 Jump ahead to #R$9B04 to walk and place character.

N $9AE1 Walks a character by six or two places and stores the result.
B $9AE1,$02 Display record read by #R$C9BF: flags #N$04, value #N$00.
@ $9AE3 label=ReadRoomDisplayParameter_PlaceCharacter
N $9AE3 Place character beside match.
N $9AE3 Run by #R$CA64 after the display record at #R$9AE1.
  $9AE3,$03 Call #R$9B50 to place the character beside the match.
  $9AE6,$06 Call #R$9B25 to measure character distance.
  $9AEC,$08 Subtract #N$02 from the location and jump to #R$9B02 to store the script cycle.
B $9AF4,$02 Display record read by #R$C9BF: flags #N$04, value #N$00.
N $9AF6 Place character beside match.
N $9AF6 Run by #R$CA64 after the display record at #R$9AF4.
  $9AF6,$03 Call #R$9B50 to place the character beside the match.
  $9AF9,$06 Call #R$9B25 to measure character distance.
  $9AFF,$03 Read the location.
@ $9B02 label=ReadRoomDisplayParameter_Next
  $9B02,$02 Take #N$01.

N $9B04 Clear the high byte of the pointer, then record the pointer in the script cycle
. counter, then read the character just matched.
  $9B04,$06 Save #N$01 and store the location in the script cycle counter.
  $9B0A,$07 Read the character just matched and call #R$9C60 to clear object attribute
. bit 7.
  $9B11,$08 Read the character just matched and call #R$DD0E to compare current
. character.
N $9B19 Fetch location data pointer.
  $9B19,$03 Call #R$D224 to look this room up.
  $9B1C,$08 Clear bit 6 of the room, point #REGhl at the command at #R$F3AD and set the carry.
  $9B24,$01 Return.

c $9B25 Measure Character Distance
@ $9B25 label=MeasureCharacterDistance
D $9B25 Counts steps of five and records the room graphics parameter.
  $9B25,$08 Read the location.
@ $9B2D label=MeasureCharacterDistance_Loop
  $9B2D,$05 Jump back to #R$9B2D while at least #N$05 is still left.
  $9B32,$07 Call #R$E619 to scan objects.
  $9B39,$02 Go to #R$9B44 if the object was not found.
  $9B3B,$03 Call #R$E39C to read the text pointer.
  $9B3E,$06 Subtract #REGde from the text pointer, then call #R$E38F to store the shifted text
. pointer.
@ $9B44 label=MeasureCharacterDistance_Next
N $9B44 Find character script entry.
  $9B44,$03 Call #R$CFB6 to find this character's script entry.
  $9B47,$08 Record the room graphics parameter.
  $9B4F,$01 Return.

c $9B50 Place Character Beside Match
@ $9B50 label=PlaceCharacterBesideMatch
D $9B50 Copies the current character beside the matched object, or prints the token at #R$6929+#N$030B.
  $9B50,$08 Read the current character, count down one and read the current character record.
  $9B58,$09 Store this character in the record and at #R$E2C6, then call #R$D237 to look the
. object up.
  $9B61,$06 Store the character attribute.
  $9B67,$03 Record the current character attribute.
  $9B6A,$0A Call #R$9C07 to search pair table.
  $9B74,$01 Return if #R$9C07 finds the pair.
  $9B75,$07 Take the character busy message, then call #R$A59F to print the character busy
. message.
  $9B7C,$02,b$01 Reset the zero flag.
  $9B7E,$01 Return.

b $9B7F Table: Location Pairs
D $9B7F Three-byte location pairs scanned by #R$9C07 and terminated by #N$FF.
B $9B7F,$03
L $9B7F,$03,$2D
B $9C06,$01 Terminator.

c $9C07 Search Pair Table
@ $9C07 label=SearchPairTable
D $9C07 Walks the character-id list at #R$9B7F and stops when the id matches either column, or when the
. list ends.
  $9C07,$06 Use the location pairs (#R$9B7F).
@ $9C0D label=SearchPairTable_Loop
  $9C0D,$07 Jump to #R$9C3D if this pair's first byte is the end marker #N$FF.
  $9C14,$06 Jump ahead to #R$9C2A if this id matches the first room in this pair.
  $9C1A,$05 Jump ahead to #R$9C33 if this id does not match the second room in this
. pair.
  $9C1F,$04 Jump ahead to #R$9C3B if #REGc is zero.
  $9C23,$05 Jump ahead to #R$9C33 if #REGc does not match the first room in this pair.
  $9C28,$02 Both rooms in this pair match, so accept the pair at #R$9C3B.

N $9C2A A zero in #REGc, or a match in the second column, accepts the pair.
@ $9C2A label=SearchPairTable_Next
  $9C2A,$04 Jump ahead to #R$9C3B if #REGc is zero.
  $9C2E,$05 Jump ahead to #R$9C3B if #REGc matches the second room in this pair.
@ $9C33 label=SearchPairTable_TestAdvanceCharacterPair
  $9C33,$08 Advance to the next character pair and keep looking.

N $9C3B The pair matched, so return the id the caller passed in.
@ $9C3B label=SearchPairTable_PairMatchedCaller
  $9C3B,$01 Restore the id the caller passed in from the stack.
  $9C3C,$01 Return.

@ $9C3D label=SearchPairTable_TestStepSucceedsScript
  $9C3D,$02 Reset the zero flag.
  $9C3F,$01 Restore #REGbc from the stack.
  $9C40,$01 Return.

b $9C41 Display Record
D $9C41 Display record read by #R$C9BF: flags #N$04, value #N$00.
B $9C41,$02

c $9C43 Mark Object And Jump
@ $9C43 label=MarkObjectAndJump
D $9C43 Notes the object in this room, sets its held mark, and continues with the character being
. processed.
N $9C43 Run by #R$CA64 after the display record at #R$9C41, from the refresh-room
. command at #R$F3AD.
  $9C43,$08 Read the current character record.
N $9C4B Set object attribute bit 7.
  $9C4B,$03 Call #R$9C56 to set the object's held mark.
  $9C4E,$08 Read the room display parameter, then join the next step.

c $9C56 Set The Object Held Mark
@ $9C56 label=SetObjectHeldMark
D $9C56 Looks the object up and sets the held mark on its attribute, then tells the script this step
. worked.
  $9C56,$03 Call #R$D237 to look that object up.
  $9C59,$04 Mark the object-attribute flag.
  $9C5D,$02,b$01 Reset the zero flag.
  $9C5F,$01 Return.

c $9C60 Clear The Object Held Mark
@ $9C60 label=ClearObjectHeldMark
D $9C60 Looks the object up and clears the held mark on its attribute, then tells the script this step
. worked.
  $9C60,$03 Call #R$D237 to look that object up.
  $9C63,$04 Clear the object-attribute flag.
  $9C67,$02,b$01 Reset the zero flag.
  $9C69,$01 Return.

c $9C6A Handler: Find Character Action
@ $9C6A label=Handler_FindCharacterAction
D $9C6A Looks through the character-action table and reports whether this character has
. an action.
R $9C6A O:IX Action entry
R $9C6A O:A #N$FF is no action was found
R $9C6A O:F Zero flag is set if no action was found
  $9C6A,$0A Call #R$D34E to search three-byte length table.
  $9C74,$02 Check if a character action was found.
  $9C76,$01 Return.

c $9C77 Execute Character Action
@ $9C77 label=ExecuteCharacterAction
D $9C77 Runs the action looked up for this character and then returns at once when that character
. has no action.
R $9C77 IY Character timetable pointer
  $9C77,$04 Return if #R$9C6A finds no character action.
  $9C7B,$06 Read the action handler for this character.
  $9C81,$02 See whether the pointer is empty.
  $9C83,$01 Return if the action handler address is empty.
  $9C84,$01 Jump to the action handler.

g $9C85 Table: Character Actions
@ $9C85 label=Table_CharacterActions
D $9C85 Character Actions read by #R$9C6A.
N $9C85 #OBJECT(#PEEK(#PC)):
B $9C85,$01 Character: "#OBJECT(#PEEK(#PC))".
W $9C86,$02 Action routine: #R(#PEEK(#PC+$01)*$0100+#PEEK(#PC)), read by #R$9DFF.
L $9C85,$03,$09
N $9CA0 End of table data:
B $9CA0,$01 Terminator.

g $9CA1 Character State: Basil Phipps
@ $9CA1 label=CharacterState_BasilPhipps
D $9CA1 Character State: Basil Phipps read by #R$9CA2 and #R$DF5B.
B $9CA1,$01

c $9CA2 Character Action: Basil Phipps
@ $9CA2 label=CharacterAction_BasilPhipps
D $9CA2 Scheduled behaviour for Basil Phipps.
. Reached through the character-action table at #R$9C85, dispatched by #R$9C84.
  $9CA2,$05 Call #R$D237 to look up the #OBJECT($55).
  $9CA7,$05 Return if the object-attribute flag is clear.
  $9CAC,$07 Return if Basil Phipps's state is already #N$FF.
  $9CB3,$01 Count down the entry.
  $9CB4,$01 Return while this character's countdown still has time left.
  $9CB5,$06 Store the low byte of the text pointer.
  $9CBB,$03 Store the high byte of the text pointer.
  $9CBE,$07 Write #N$00 to #LIST { *#REGix+#N$0D } { *#REGix+#N$0E } LIST#.
  $9CC5,$08 Clear the action-taken flag.
  $9CCD,$01 Return.

c $9CCE Check Object In Character Location
@ $9CCE label=CheckObjectInCharacterLocation
D $9CCE Sets the zero flag when the object in #REGc is in the current character's location. A non-zero return means it is not.
R $9CCE C Object ID to check
R $9CCE O:F Zero flag set if object is in character's location
  $9CCE,$07 Read the current character record.
  $9CD5,$04 Call #R$D237 to look up that object.
  $9CD9,$03 Read offset #N$0F of the object.
  $9CDC,$01 See whether the two values match.
  $9CDD,$01 Return if they differ.
  $9CDE,$06 Go to #R$9CE6 if the object is not in this location.
  $9CE4,$01 Clear #REGa.
  $9CE5,$01 Return.

@ $9CE6 label=CheckObjectInCharacterLocation_Next
  $9CE6,$02,b$01 Reset the zero flag.
  $9CE8,$01 Return.

c $9CE9 Process Character Action With Text
@ $9CE9 label=ProcessCharacterActionWithText
D $9CE9 Runs this character's action and prints the message that follows.
R $9CE9 HL Pointer to text token
R $9CE9 C Room display parameter
N $9CE9 Process character action parameter.
  $9CE9,$03 Call #R$9CF2 to run this character's action.

N $9CEC Take the character-busy line, then print the message.
  $9CEC,$06 Jump ahead to #R$A59F to print this message.

c $9CF2 Process Character Action Parameter
@ $9CF2 label=ProcessCharacterActionParameter
D $9CF2 Stores the room picture, and counts down while the object is not in the character's
. room. When the character holds it, stores a fresh delay once the counter has run out.
R $9CF2 HL Pointer to counter/state variable
R $9CF2 C Room display parameter
R $9CF2 DE (preserved on stack)
  $9CF2,$07 Call #R$9CCE to check object in character location.
  $9CF9,$02 Jump ahead to #R$9D02 when this character holds the object.
  $9CFB,$04 Jump to #R$9D00 if the count does not become negative.
  $9CFF,$01 Count one more in the pointer.
  $9D00,$01 Restore #REGde from the stack.
  $9D01,$01 Return.

N $9D02 When the counter has run out, stores this character's attribute plus thirty.
@ $9D02 label=ProcessCharacterActionParameter_Next
  $9D02,$04 Jump back to #R$9D00 while this byte is not zero.
  $9D06,$05 #OBJECT($0F), then call #R$D2A4 to take a random number.
  $9D0B,$02 Advance the result by #N$1E.
  $9D0D,$01 Store the result at the pointer.
  $9D0E,$01 Clear #REGa.
  $9D0F,$01 Return.

g $9D10 Counters: Watson
D $9D10 Counters for Watson's action at #R$9D13.
B $9D10,$01
B $9D11,$01 Read by #R$9D13.
B $9D12,$01 Read by #R$9D13.

c $9D13 Character Action: Watson
@ $9D13 label=CharacterAction_Watson
D $9D13 Scheduled behaviour for Watson.
. Reached through the character-action table at #R$9C85, dispatched by #R$9C84.
  $9D13,$08 Point #REGhl at Watson's first counter (#R$9D10), set #REGc to #N$00 and call #R$9CE9.
  $9D1B,$08 Point #REGhl at Watson's second counter (#R$9D11), set #REGc to #N$02 and call #R$9CE9.
  $9D23,$08 Point #REGhl at Watson's third counter (#R$9D12), set #REGc to #N$04 and call #R$9CE9.
  $9D2B,$03 Jump ahead to #R$E691 to run character attribute.

g $9D2E Counters: Strak
D $9D2E Counters for Chief Constable Strak's action at #R$9D30.
B $9D2E,$01
B $9D2F,$01 Read by #R$9D30.

c $9D30 Character Action: Chief Constable Strak
@ $9D30 label=CharacterAction_ChiefConstableStrak
D $9D30 Scheduled behaviour for Chief Constable Strak.
. Reached through the character-action table at #R$9C85, dispatched by #R$9C84.
  $9D30,$05 Return if the police flag is clear.
  $9D35,$08 Point #REGhl at Strak's first counter (#R$9D2E), set #REGc to #N$00 and call #R$9CE9.
  $9D3D,$08 Point #REGhl at Strak's second counter (#R$9D2F), set #REGc to #N$03 and jump to #R$9CE9.

g $9D45 Counters: Police Man 1
D $9D45 Counters for the first local police man at #R$9D48.
B $9D45,$01
B $9D46,$01 Read by #R$9D48.
B $9D47,$01 Read by #R$9D48.

c $9D48 Character Action: First Local Police Man
@ $9D48 label=CharacterAction_FirstLocalPoliceMan
D $9D48 Scheduled behaviour for the first local police man.
. Reached through the character-action table at #R$9C85, dispatched by #R$9C84.
  $9D48,$05 Return if the police flag is set.
  $9D4D,$08 Call #R$9D65 for local police man #N$01.
  $9D55,$08 Call #R$9D65 for local police man #N$01.
  $9D5D,$08 Point at the policeman counter at #R$9D47, take room parameter #N$07, and go to
. #R$9D65.

c $9D65 Store A Set Mark And Print The Police Line
@ $9D65 label=StoreSetMarkPrintPoliceLine
D $9D65 Store #N$01 at the pointer, then use the text: police at #R$6D9A as the pointer.
N $9D65 Process character action parameter.
  $9D65,$03 Call #R$9CF2 to run the police action.
  $9D68,$02 Write #N$01 into the record.
N $9D6A Print "#TEXTTOKEN($6D9A)".
  $9D6A,$06 Jump ahead to #R$A59F to print this message.

g $9D70 Counters: Police Man 2
D $9D70 Counters for the second local police man at #R$9D73.
B $9D70,$01
B $9D71,$01 Read by #R$9D73.
B $9D72,$01 Read by #R$9D73.

c $9D73 Character Action: Second Local Police Man
@ $9D73 label=CharacterAction_SecondLocalPoliceMan
D $9D73 Scheduled behaviour for the second local police man.
. Reached through the character-action table at #R$9C85, dispatched by #R$9C84.
  $9D73,$05 Return if the police flag is set.
  $9D78,$08 Call #R$9D65 for the local policeman with counter #N$00.
  $9D80,$08 Call #R$9D65 for the local policeman with counter #N$03.
  $9D88,$08 Take the second policeman at #R$9D72 with counter #N$07 and join #R$9D65.

g $9D90 Flags: Police
D $9D90 Police flag tested by #R$9D30 and #R$9D48.
. Read by #R$9D30, #R$9D48, #R$9D73, #R$9DFF and #R$9E60.
B $9D90,$01
B $9D91,$01 Read by #R$9D95 and #R$9DFF.
B $9D92,$01 Read by #R$9DFF.
B $9D93,$01 Read by #R$9D95.
B $9D94,$01 Read by #R$9D95.

c $9D95 Character Action: Inspector Lestrade Helper
@ $9D95 label=CharacterAction_InspectorLestradeHelper
D $9D95 Scheduled behaviour for Inspector Lestrade Helper.
  $9D95,$08 Call #R$9DC6 for Inspector Lestrade helper.
  $9D9D,$08 Call #R$9DD8 for Inspector Lestrade helper.
  $9DA5,$08 Point #REGhl at the police counter at #R$9D93, set #REGc to #N$03 and call #R$9CE9.
  $9DAD,$08 Clear the action-pending flag.
  $9DB5,$08 Clear the action-pending flag.
  $9DBD,$08 Clear the action-pending flag.
  $9DC5,$01 Return.

c $9DC6 Print The Surprised Remark Once
@ $9DC6 label=PrintSurprisedRemarkOnce
D $9DC6 Prints the character-busy line while the counter still has a count, and prints
. the surprised remark the first time the counter runs out.
  $9DC6,$04 Step to the next character, then call #R$9CF2 to run character action parameter.
  $9DCA,$06 Jump back to #R$9CEC while this byte is not zero.
  $9DD0,$08 Jump ahead to #R$A59F to print this message.

c $9DD8 Store A Set Mark At The Pointer
@ $9DD8 label=StoreSetMarkPointer
D $9DD8 Marks this character's set state and prints the line once the status count has run out.
  $9DD8,$08 Call #R$9CF2 to run character action parameter, then call #R$BC46 to run
. game status entries.
  $9DE0,$07 Jump ahead to #R$9DF5 if the count is not zero.
  $9DE7,$05 Return if the count is zero.
  $9DEC,$08 Take the message, then call #R$A59F to print the message, keeping character
. record.
N $9DEE Print "#TEXTTOKEN($722D)".
  $9DF4,$01 Return.

N $9DF5 Return if bit 4 of the action state is set.
@ $9DF5 label=StoreSetMarkPointer_TestMarkByte
  $9DF5,$05 Return if the action state flag is set.
  $9DFA,$05 Jump ahead to #R$BBE5 to print text based on flag.

c $9DFF Character Action: Inspector Lestrade
@ $9DFF label=CharacterAction_InspectorLestrade
D $9DFF Scheduled behaviour for Inspector Lestrade.
. Reached through the character-action table at #R$9C85, dispatched by #R$9C84.
  $9DFF,$05 Call #R$9CCE to check object in character location.
  $9E04,$02 Go to #R$9D95 if the object is not in this character's location.
  $9E06,$05 Call #R$9CCE to check object in character location.
  $9E0B,$02 Go to #R$9D95 if the object is not in this character's location.
  $9E0D,$07 Write #N$04 to the room display parameter.
  $9E14,$03 Record the police.
  $9E17,$05 Call #R$D224 with room #N$5C: #ROOM$5C.
  $9E1C,$04 Clear the high byte of the text pointer.
  $9E20,$05 Call #R$D224 with room #N$3E: #ROOM$3E.
  $9E25,$04 Clear the high byte of the text pointer.
  $9E29,$06 Write #R$9D95 to *#R$9C86.
  $9E2F,$05 Write #N$01 to the police.
  $9E34,$09 Jump to #R$9E44 if the police flag is set.
  $9E3D,$07 Record the police.
@ $9E44 label=CharacterAction_InspectorLestrade_Next
  $9E44,$03 Call #R$A59F to print the message.
  $9E47,$01 Return.

b $9E48 Display Record
D $9E48 Display record read by #R$C9BF. The show-message command at #R$EF89 passes this word to
. #R$C591.
N $9E48 Named from the script command at #R$EF89.
B $9E48,$02 Display record read by #R$C9BF: flags #N$00, value #N$00.

c $9E4A Check Character State
@ $9E4A label=CheckCharacterState
D $9E4A Prints the message at #R$6B79 unless both character #N$03 and character #N$02 are at the location in #R$A009, in which case it prints #R$6AF1+#N$02.
. Run by #R$CA64 after the display record at #R$9E48, from the show-message command at #R$EF89.
  $9E4A,$08 Call #R$9E60 to read Sherlock's disguise.
  $9E52,$02 Go to #R$9E74 unless Sherlock's disguise matches this character.
  $9E54,$07 Jump ahead to #R$9E74 unless Sherlock's disguise matches this character.
  $9E5B,$05 Jump ahead to #R$9E74 with the message at #R$6929+#N$01CA.

c $9E60 Read Sherlock's Disguise
@ $9E60 label=ReadSherlocksDisguise
D $9E60 Read Sherlock's disguise, then see whether it matches the character attribute.
  $9E60,$03 Call #R$D237 to look that object up.
  $9E63,$03 Read the sherlock Disguise Check Result.
  $9E66,$03 See whether it matches the character attribute.
  $9E69,$01 Return.

b $9E6A Display Record
D $9E6A Display record read by #R$C9BF. The show-message command at #R$E932 passes this word to
. #R$C591.
N $9E6A Named from the script command at #R$E932.
B $9E6A,$02 Display record read by #R$C9BF: flags #N$00, value #N$00.

c $9E6C Test The Police Flag
@ $9E6C label=TestPoliceFlag
D $9E6C Returns when the police flag is set, otherwise takes the character-busy message.
N $9E6C Run by #R$CA64 after the display record at #R$9E6A, from the show-message command at #R$E932.
  $9E6C,$05 Return if the police flag is set.
  $9E71,$03 Use the character busy (#R$6929+#N$11).

c $9E74 Report Success
@ $9E74 label=PrintMessageAndInitialiseTimer
D $9E74 Tells the script this step succeeded.
  $9E74,$08 Take #N$01 and store it in the system variables, then call #R$A59F to print the
. message.
  $9E7C,$06 Call #R$C306 to scroll the screen, then call #R$A296 to clear the display lines.
  $9E82,$03 Jump to #R$B0AC to initialise character timer.

b $9E85 Display Record
D $9E85 Display record read by #R$C9BF. The show-message command at #R$E96B passes this word to
. #R$C591.
N $9E85 Named from the script command at #R$E96B.
B $9E85,$02 Display record read by #R$C9BF: flags #N$00, value #N$00.

c $9E87 Test The Busy Flag
@ $9E87 label=TestBusyFlag
D $9E87 Prints the character-busy message when the flag is clear.
N $9E87 Run by #R$CA64 after the display record at #R$9E85, from the show-message
. command at #R$E96B.
N $9E87 The operand of this instruction is the busy flag #R$9A42 sets.
  $9E87,$04 Return if the busy flag (the operand of #R$9E87, set by #R$9A42) is non-zero.
  $9E8B,$06 Take the character busy message, then call #R$A59F to print the character busy
. message.
  $9E91,$07 Use the current character attribute at #R$A00A.
  $9E98,$03 Take the character busy message.
  $9E9B,$02 Go to #R$9E74 if Sherlock's disguise matches the character attribute.
  $9E9D,$05 Jump back to #R$9E74 with the message at #R$6929+#N$FD.

b $9EA2 Display Record
D $9EA2 Display record read by #R$C9BF. The show-message command at #R$EAB3 passes this word to
. #R$C591.
N $9EA2 Named from the script command at #R$EAB3.
B $9EA2,$02 Display record read by #R$C9BF: flags #N$00, value #N$00.

c $9EA4 Test The Action-Taken Flag
@ $9EA4 label=TestActionTakenFlag
D $9EA4 Prints the character-busy message unless the action-taken flag is set.
N $9EA4 Run by #R$CA64 after the display record at #R$9EA2, from the show-message command at #R$EAB3.
  $9EA4,$07 Take the character busy message.
  $9EAB,$06 Jump to #R$9E74 if the action-taken flag is clear.
  $9EB1,$04 Point at this character-state byte.
  $9EB5,$06 Jump to #R$9E74 if the action-taken flag is clear.
  $9EBB,$05 Jump back to #R$9E74 with the message at #R$6929+#N$0194.

g $9EC0 Character State: Daphne Strachan
@ $9EC0 label=CharacterState_DaphneStrachan
D $9EC0 Character State: Daphne Strachan read by #R$9EC1.
B $9EC0,$01

c $9EC1 Character Action: Daphne Strachan
@ $9EC1 label=CharacterAction_DaphneStrachan
D $9EC1 Scheduled behaviour for Daphne Strachan.
. Reached through the character-action table at #R$9C85, dispatched by #R$9C84.
R $9EC1 HL Pointer to Daphne Strachan state
R $9EC1 B Object ID (#N$4A)
R $9EC1 C Object ID (#N$80)
  $9EC1,$09 Point #REGhl at #R$9EC0, take objects #N$80 and #N$4A, and join #R$9ED7.

g $9ECA Character State:Cook
@ $9ECA label=CharacterState_Cook
D $9ECA Character State:Cook read by #R$9ECB.
B $9ECA,$01

c $9ECB Character Action: Cook
@ $9ECB label=CharacterAction_Cook
D $9ECB Scheduled behaviour for Cook.
. Reached through the character-action table at #R$9C85, dispatched by #R$9C84.
  $9ECB,$05 Jump to #R$9ED4, the character action entry.

g $9ED0 Character State: Gardener
@ $9ED0 label=CharacterState_Gardener
D $9ED0 Character State: Gardener read by #R$9ED1.
B $9ED0,$01

c $9ED1 Character Action: Gardener
@ $9ED1 label=CharacterAction_Gardener
D $9ED1 Scheduled behaviour for Gardener.
. Reached through the character-action table at #R$9C85, dispatched by #R$9C84.
R $9ED1 HL Pointer to gardener state
  $9ED1,$03 Use the character state: gardener at #R$9ED0.

c $9ED4 Read The Character Being Processed
@ $9ED4 label=ReadCharacterBeingProcessed
D $9ED4 Starts the gardener's walk with an empty step count.
  $9ED4,$03 Move through the record for gardener.

c $9ED7 Read The Character Being Processed
@ $9ED7 label=AdvanceGardenerAfterMove
D $9ED7 Reads the gardener's state and moves him on when he has already left.
  $9ED7,$04 Jump ahead to #R$9EF2 if this byte is zero.
N $9EDB Handle gardener's morning state (has already moved).
  $9EDB,$05 Save the state in #REGb and clear #REGa and #REGde for the update.
  $9EE0,$03 Call #R$9F1E to update the gardener's state and location.
  $9EE3,$07 Read the current character.
  $9EEA,$03 Call #R$F1C1 to move the object to the character's location.
  $9EED,$04 Set the special-description flag.
  $9EF1,$01 Return.

N $9EF2 Read the morning or afternoon marker, then check for the letter a, and return
. if they match.
@ $9EF2 label=AdvanceGardenerAfterMove_CheckTime
  $9EF2,$06 Return if the AM/PM marker is #N$61.
N $9EF8 Handle gardener's afternoon state (at 9am).
  $9EF8,$06 Return if the hour is not #N$09.
  $9EFE,$05 Take #N$01F8 for the character and take the #OBJECT($1E).
  $9F03,$03 Call #R$D2A4 to take a random number.
  $9F06,$05 Read the current character attribute.
  $9F0B,$03 Call #R$9F1E to update the gardener's state and location.
  $9F0E,$08 Read the current character.
  $9F16,$03 Call #R$F1C1 to move the object to the new location.
  $9F19,$04 Clear the special-description flag.
  $9F1D,$01 Return.

c $9F1E Update Character State And Location
@ $9F1E label=UpdateCharacterStateAndLocation
D $9F1E Stores the character's new state, marks the object moved, and writes the location offset
. back into the timetable.
R $9F1E A New state value
R $9F1E B Character attribute value
R $9F1E DE Location offset
R $9F1E HL Pointer to character state
R $9F1E IY Pointer to character timetable data
  $9F1E,$08 Store the new state, point #REGix at the current character at #R$A017, and write
. #REGb at offset #N$0F.
  $9F26,$04 Mark the object as moved.
N $9F2A Update character's location in timetable.
  $9F2A,$07 Add the offset in the source to the word at offset #N$06 of this record.
  $9F31,$03 Store the low byte of the schedule time.
  $9F34,$03 Store the high byte of the schedule time.
  $9F37,$01 Return.

g $9F38 Table: Display Records
D $9F38 One id byte and a pointer to a display record, ended by #N$FF.
. A record is two bytes, plus two when bit 6 is set and five when bit 4 is set.
. Read by #R$C972.
B $9F38,$01
W $9F39,$02
L $9F38,$03,$26
B $9FAA,$01 Terminator.

w $9FAB Table: Display Records By Moved Marker
@ $9FAB label=Table_DisplayRecordsByMovedMarker
D $9FAB One word for each moved marker, after #R$C583 keeps bits 0-6.
. #R$E497, #R$E5D8, #R$E5FD, #R$E5AD, #R$F210, #R$F203, #R$EB8B,
. #R$ED28, #R$F1D6, #R$EB9B, #R$EDE9, #R$EDDD and #R$F2A5.
. Read by #R$C583.
W $9FAB,$1A

b $9FC5 Display Record
D $9FC5 Record that hands back the text token at #R$9FCE. Listed in #R$9F38
. for room #N$34, the word at #R$9FA8.
B $9FC5,$04 Display record read by #R$C9BF: flags #N$40, value #N$00, handler #R$9FC9.

c $9FC9 Print Text Token And Return
@ $9FC9 label=PrintTextTokenAndReturn
D $9FC9 Returns the address of the message step at #R$9FCE.
. Reached through the display record at #R$9FC5, dispatched by #R$CB40.
. Run by #R$CA64 after the display record at #R$9FC5.
  $9FC9,$03 Hand back the address of the following step.
  $9FCC,$01 Clear #REGa.
  $9FCD,$01 Return.
N $9FCE Print "#TEXTTOKEN($680B)".
  $9FCE,$06 Jump ahead to #R$A59F to print this message.

g $9FD4 Word: Saved Character Pointer
D $9FD4 Saved character-list pointer written by #R$B0E4 and read by #R$B0D7.
W $9FD4,$02

g $9FD6 Current Room ID
@ $9FD6 label=CurrentRoom_ID
D $9FD6 Stores the current room ID used in room display scripts.
. Read by #R$CEDE, #R$CF80, #R$D008, #R$D026, #R$D6C1, #R$DD35 and #R$E3F5.
B $9FD6,$01

g $9FD7 Location Value
@ $9FD7 label=LocationValue
D $9FD7 Stores a location reference value used in room display scripts (a 2-byte value that can be accessed as high or low byte via special parameters).
. Read by #R$C9BF, #R$CEDE, #R$D008, #R$D026, #R$D6C1 and #R$DD35.
W $9FD7,$02

g $9FD9 Currently Processed Character Command Position
@ $9FD9 label=CurrentCharacter_CommandPosition
D $9FD9 Currently Processed Character Command Position read by #R$C996, #R$CC82, #R$CE83 and
. #R$CFCF.
W $9FD9,$02

g $9FDB Currently Processed Character Timetable Pointer
@ $9FDB label=CurrentCharacter_TimetablePointer
D $9FDB Currently Processed Character Timetable Pointer read by #R$C996, #R$CC37, #R$CC78 and
. #R$CE83.
W $9FDB,$02

g $9FDD Current Time Ticker
@ $9FDD label=CurrentTime_Ticker
D $9FDD Holds a value between #N($0000,$04,$04) to #N$FFFF, and just keeps
. incrementing all throughout the game.
. Read by #R$A064, #R$B0AC and #R$BFD9.
W $9FDD,$02

g $9FDF Current Time
@ $9FDF label=CurrentTime_Minutes
D $9FDF Holds the current in-game hours and minutes.
. Read by #R$BF79, #R$BFD9 and #R$DD35.
@ $9FE0 label=CurrentTime_Hour
B $9FDF,$01
B $9FE0,$01 Read by #R$9ED7, #R$BF79, #R$BFD9, #R$C00C and #R$F1D6.

g $9FE1 Current Day Of The Week
@ $9FE1 label=CurrentDayOfWeek
D $9FE1 Represents the current day of the week, where:
. #TABLE(default,centre,centre)
. { =h Byte | =h Day }
. #FOR$00,$06(x,{ #Nx | #STR($BF59+x*$03,$04,$03) })
. TABLE#
. Read by #R$BF79, #R$BFD9, #R$DF5B and #R$E03A.
.
. See #R$BF79.
B $9FE1,$01

g $9FE2 Messaging: AM/ PM
@ $9FE2 label=Messaging_AM_PM
D $9FE2 Holds just the "a" and the "p" for AM and PM, as the "m" is already in
. the string and so doesn't change.
. Read by #R$9ED7, #R$BF79, #R$BFD9, #R$C00C, #R$DD35 and #R$F1D6.
T $9FE2,$01
T $9FE3,$01 Read by #R$A11C and #R$A1C7.

g $9FE4 Flags: Clock
D $9FE4 Clock workspace beside the current time.
. Clock flag beside the time word at #R$9FE5.
  $9FE4,$01

g $9FE5 Flags: Clock
D $9FE5 Clock workspace beside the current time.
. Read by #R$E510 and #R$E58C.
  $9FE5,$02

g $9FE7 Word: Saved Pointer
D $9FE7 Saved pointer beside the character lists.
. Read by #R$CC82 and #R$E560.
W $9FE7,$02

g $9FE9 Character List Pointer
@ $9FE9 label=CharacterListPointer
D $9FE9 Pointer to the head of the linked list of character entries.
. Read by #R$CC82, #R$CF80 and #R$CFCF.
W $9FE9,$02

g $9FEB Character Script Entry List
@ $9FEB label=CharacterScriptEntryList
D $9FEB Pointer to the head of the character script entry list.
. Read by #R$BA3E, #R$CFB9 and #R$D6C1.
W $9FEB,$02

g $9FEE Word: Link Pointer
D $9FEE Link word beside the character lists.
. Read by #R$B86A, #R$B8AA, #R$B9FA and #R$CDBF.
W $9FEE,$02

g $A008 Flags: Input
D $A008 Input flag cleared with the parser workspace.
. Read by #R$B012 and #R$C3E4.
B $A008,$01

g $A009 Sherlock Disguise Check Result
@ $A009 label=SherlockDisguiseCheckResult
D $A009 Stores the result of checking if Sherlock is wearing the China Man disguise (#N$FF if not, otherwise the attribute byte).
. Read by #R$9E60, #R$9E74, #R$CA7F, #R$CAAF, #R$CBC2, #R$D045, #R$DFCC and #R$EFC7.
B $A009,$01

g $A00A Current Character Attribute
@ $A00A label=CurrentCharacterAttribute
D $A00A Stores the attribute value of the currently processed character (from offset +#N$0F in character data).
. Read by #R$9AA3, #R$9B50, #R$9E74, #R$9ED7, #R$C821, #R$C9BF, #R$CC29, #R$D113, #R$DBF7,
. #R$DC6C, #R$DD0E, #R$DE60, #R$DFCC, #R$E03A and #R$E207.
B $A00A,$01

g $A00B Flags: Parser
D $A00B Parser flag.
. Read by #R$A59F, #R$B191, #R$C4D1, #R$C591, #R$C763, #R$C9BF, #R$CB43 and #R$D6C1.
B $A00B,$01

g $A00C Flags: Parser
D $A00C Parser flag.
. Read by #R$A2E4, #R$A59F, #R$C9BF and #R$CB58.
B $A00C,$01

g $A00D Word: Parser
D $A00D Parser workspace word.
. Read by #R$A702.
W $A00D,$02

g $A00F Display Mode
@ $A00F label=DisplayMode
D $A00F Controls the display mode for room/object processing (values 5, 7, etc.).
. Read by #R$A37D, #R$B34F, #R$B4C1, #R$B633, #R$C463, #R$C493, #R$C4D1, #R$C571, #R$C591,
. #R$C8EF, #R$C929, #R$CAAF, #R$CDA1 and #R$DBF7.
B $A00F,$01
B $A010,$01 Read by #R$A37D, #R$B36B, #R$B568, #R$B633, #R$C45E, #R$C4B2, #R$C4D1, #R$C542, #R$C57A, #R$C591, #R$C5FC and #R$C8EF.

g $A011 Flags: Pictures Enabled
D $A011 Set at the game entry point unless the player presses N. #R$A25D skips picture lookup when this is zero.
. Read by #R$A040 and #R$A25D.
B $A011,$01
B $A012,$01 Pictures-enabled byte. Written by #R$AAB6 and #R$AD3D, and read by #R$AB2B, #R$ACE8, #R$ADD8, #R$AFEB and #R$B118.

g $A013 Word: Current Object
D $A013 Pointer to the object being processed.
. Read by #R$C8EF, #R$C929, #R$C9BF, #R$DC8D, #R$DCA7, #R$DD35, #R$DEA4, #R$DEB6, #R$DEC1,
. #R$DEE4, #R$DF5B, #R$DFCC, #R$E03A, #R$E207, #R$E2EE, #R$E3F5, #R$E58C, #R$E691, #R$EAF8 and
. #R$F1D6.
W $A013,$02

g $A015 Word: Secondary Pointer
D $A015 Secondary object or character pointer.
. Read by #R$C8EF, #R$DEC1, #R$DEE4, #R$E03A, #R$E58C and #R$EAF8.
W $A015,$02

