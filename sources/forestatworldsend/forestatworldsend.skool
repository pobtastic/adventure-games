; Action: Climb
;
; Climb the rope, the volcano or down into the boat.
@label=Action_Climb
c$F190 CALL $C309    ; {Return if the words after the verb are not valid for
 $F193 RET C         ; this command.}
 $F194 LD HL,$E83D   ; {Jump to #R$F1B2 unless the player named the rope.
 $F197 CALL $C26F    ;
 $F19A JR NZ,$F1B2   ; }
 $F19C LD A,($BA9B)  ; {Jump to #R$ED6E unless the player is in room #N$47 (The Top of the
 $F19F CP $47        ; Volcano).
 $F1A1 JP NZ,$ED6E   ; }
 $F1A4 LD A,$23      ; {Jump to #R$ED6E if object #N$23 (the rope on the
 $F1A6 CALL $C24F    ; overhang) is not here.
 $F1A9 JP NZ,$ED6E   ; }
 $F1AC LD A,$48      ; {Try to enter room #N$48 (Inside the Volcano).
 $F1AE CALL $ECB6    ; }
 $F1B1 RET           ; Return.
@label=Action_Climb_Next
*$F1B2 LD HL,$E840   ; {Jump to #R$F1C8 unless the player named the ring.
 $F1B5 CALL $C26F    ;
 $F1B8 JR NZ,$F1C8   ; }
