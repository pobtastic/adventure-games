 $FAF7 JR $FB09      ; Jump to #R$FB09 to draw it.

; Handler: Room Image: The Dungeon
;
; Draw The Dungeon.
@label=Handler_RoomImageTheDungeon
c$FAF9 LD IX,$9E7F   ; Start at The Dungeon (#R$9E7F).
 $FAFD JR $FB09      ; Jump to #R$FB09 to draw it.

; Handler: Room Image: Marl's Gateway
;
; Draw Marl's Gateway.
@label=Handler_RoomImageMarlsGateway
c$FAFF LD IX,$A6C9   ; Start at Marl's Gateway (#R$A6C9).
 $FB03 JR $FB09      ; Jump to #R$FB09 to draw it.

; Handler: Room Image: The Cavern of Silence
;
; Draw The Cavern of Silence.
@label=Handler_RoomImageTheCavernOfSilence
c$FB05 LD IX,$AE7A   ; Start at The Cavern of Silence (#R$AE7A).
; This entry point is used by the routines at #R$FACF, #R$FAD5, #R$FADB,
; #R$FAE1, #R$FAE7, #R$FAED, #R$FAF3, #R$FAF9 and #R$FAFF.
; .
; Draw that picture.
@label=Handler_RoomImageTheCavernOfSilence_Next
*$FB09 CALL $BEB8    ; Call #R$BEB8.
 $FB0C RET           ; Return.

