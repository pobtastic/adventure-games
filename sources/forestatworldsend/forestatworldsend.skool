; Game Start
;
; Used by the routine at #R$B9C5.
; .
; Turn caps lock on, clear the flags, copy in a fresh game and enter the Great
; Valley.
@label=GameStart
c$F964 LD HL,$5C6A   ; {Turn CAPS LOCK on, using bit 3 of
 $F967 SET 3,(HL)    ; *#SKOOLKID$5C6A(FLAGS2).}
; Seal the passages that the player has to open.
 $F969 XOR A         ; {Seal the farmhouse, the woodman's hut and both sides of
 $F96A LD ($E941),A  ; the chasm.
 $F96D LD ($E996),A  ;
 $F970 LD ($E9B4),A  ;
 $F973 LD ($E9BB),A  ; }
 $F976 LD ($EAA4),A  ; {Seal the witch's hovel, the rock wall and the cavern.
 $F979 LD ($EAAA),A  ;
 $F97C LD ($EADA),A  ; }
; Install a fresh game.
 $F97F LD HL,$F992   ; {Copy #N$013C bytes from #R$F992 over the game state at
 $F982 LD DE,$B9C8   ; #R$B9C8.
 $F985 LD BC,$013C   ;
 $F988 LDIR          ; }
 $F98A LD A,$05      ; Enter room #N($05), the Great Valley.
 $F98C CALL $ECB6    ; Call #R$ECB6 to enter the Great Valley.
 $F98F JP $EB10      ; Jump to #R$EB10 to take the first turn.
; View the equivalent code in;
; #LIST
; { #ANDROMEDA$F8AF }
; LIST#

