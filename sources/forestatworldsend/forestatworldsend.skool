; Reply with "#MESSAGE$BCBA".
@label=Response_PleaseRephraseThat_EnterTheBoat
c$EDA0 LD HL,$BCBA   ; {Print "#MESSAGE$BCBA" and return to the game loop.
 $EDA3 JR $ED66      ; }

; Response: "It Has No Apparent Effect"
;
; Used by the routines at #R$F7C2, #R$F81D and #R$F916.
; .
; Print "It Has No Apparent Effect" and return to the caller.
;
; .
;
; Reply with "#MESSAGE$E1CC".
@label=Response_ItHasNoApparentEffect
c$EDA5 LD HL,$E1CC   ; {Print "#MESSAGE$E1CC" and return to the game loop.
 $EDA8 JR $ED66      ; }

; Response: "Don't Be Disgusting"
;
; Used by the routine at #R$F869.
; .
; Print "Don't Be Disgusting" and return to the caller.
;
; .
;
; Reply with "#MESSAGE$E30A".
@label=Response_DontBeDisgusting
c$EDAA LD HL,$E30A   ; {Print "#MESSAGE$E30A" and return to the game loop.
 $EDAD JR $ED66      ; }

