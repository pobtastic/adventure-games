; Messaging: "> "
@label=Messaging_Message
t$BB55 DEFM "> "     ; "#MESSAGE$BB55".
 $BB57 DEFB $FF      ; Terminator.

; Messaging: "<BS> <BS>"
;
; Rubs out the input prompt.
@label=Messaging_BackspaceSpaceBackspace
t$BB58 DEFM $08," ",$08 ; "#MESSAGE$BB58".
 $BB5B DEFB $FF         ; Terminator.

; Messaging: "THE"
@label=Messaging_THE
t$BB5C DEFM "THE "   ; "#MESSAGE$BB5C".
 $BB60 DEFB $FF      ; Terminator.

