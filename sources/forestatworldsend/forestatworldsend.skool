;
; Used by the routine at #R$EDE8.
; .
; Print "You're Not Carrying Anything" and return to the caller.
;
; .
;
; Reply with "#MESSAGE$BD94".
@label=Response_YoureNotCarryingAnything
c$EDAF LD HL,$BD94   ; {Print "#MESSAGE$BD94" and return to the game loop.
 $EDB2 JR $ED66      ; }

