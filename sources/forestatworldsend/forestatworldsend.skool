; Action: Help
;
; Explain how badly hurt the player is, if at all.
@label=Action_Help
c$EDC3 CALL $C2FE    ; {Return if the words after the verb are not valid for
 $EDC6 RET C         ; this command.}
 $EDC7 LD A,$48      ; {Jump to #R$EDE2 if object #N$48 (the injury) is not
 $EDC9 CALL $C24F    ; here.
 $EDCC JR NZ,$EDE2   ; }
 $EDCE LD A,$8A      ; {Jump to #R$EDE2 when object #N$8A (the wood nymph) is
 $EDD0 CALL $C24F    ; here.
 $EDD3 JR Z,$EDE2    ; }
 $EDD5 LD A,$8A      ; {Call #R$C2BE to fetch where the wood nymph is.
 $EDD7 CALL $C2BE    ; }
 $EDDA AND A         ; {Jump to #R$EDE2 when the injury is not in play.
 $EDDB JR Z,$EDE2    ; }
 $EDDD LD HL,$DC4F   ; {Print "#MESSAGE$DC4F" to say help is on the way.
 $EDE0 JR $EDE5      ; }
@label=Action_Help_Next
*$EDE2 LD HL,$DC35   ; The player is not hurt, so say "#MESSAGE$DC35".
@label=Action_Help_Reply
*$EDE5 JP $ED66      ; Return through the shared reply at #R$ED66.

; Action: Inventory
;
; List everything the player is carrying.
@label=Action_Inventory
c$EDE8 CALL $C2FE    ; {Return if the words after the verb are not valid for
 $EDEB RET C         ; this command.}
 $EDEC LD A,($BA68)  ; {Jump back to #R$EDAF when the number of objects carried
 $EDEF AND A         ; is zero.
 $EDF0 JP Z,$EDAF    ; }
 $EDF3 CALL $BDEA    ; Call #R$BDEA to clear the screen.
 $EDF6 CALL $BE06    ; Call #R$BE06 to move the cursor to the text line stored
                     ; at #R$BB40.
 $EDF9 LD HL,$BD1F   ; {Print "#MESSAGE$BD1F".
 $EDFC CALL $BE2E    ; }
 $EDFF LD A,$01      ; {Call #R$C0D2 to list what is being carried.
 $EE01 CALL $C0D2    ; }
 $EE04 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$F756 }
; { #ANDROMEDA$8EC4 }
; { #JEWELS$F12E }
; { #WARLORD$F824 }
; { #SHOCK$A6CF }
; LIST#

; Action: Look
;
; Describe the room again, including the long text.
@label=Action_Look
c$EE05 CALL $C2FE    ; {Return if the words after the verb are not valid for
 $EE08 RET C         ; this command.}
 $EE09 LD E,$01      ; {Call #R$C0F9 to describe the current room.
 $EE0B CALL $C0F9    ; }
 $EE0E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$F773 }
; { #ANDROMEDA$8EDA }
; { #JEWELS$F14B }
; { #WARLORD$F841 }
; LIST#

; Action: North
;
; Try to leave to the north.
@label=Action_North
c$EE0F LD C,$00      ; {Choose the north exit and join the movement routine at
 $EE11 JR $EE25      ; #R$EE25.}

; Action: South
;
; Try to leave to the south.
@label=Action_South
c$EE13 LD C,$01      ; {Choose the south exit and join the movement routine at
 $EE15 JR $EE25      ; #R$EE25.}

; Action: East
;
; Try to leave to the east.
@label=Action_East
c$EE17 LD C,$02      ; {Choose the east exit and join the movement routine at
 $EE19 JR $EE25      ; #R$EE25.}

; Action: West
;
; Try to leave to the west.
@label=Action_West
c$EE1B LD C,$03      ; {Choose the west exit and join the movement routine at
 $EE1D JR $EE25      ; #R$EE25.}

; Action: Up
;
; Try to leave upwards.
@label=Action_Up
c$EE1F LD C,$04      ; {Choose the up exit and join the movement routine at
 $EE21 JR $EE25      ; #R$EE25.}

; Action: Down
;
; Try to leave downwards.
@label=Action_Down
c$EE23 LD C,$05      ; Choose the down exit and join the movement routine.
; This entry point is used by the routines at #R$EE0F, #R$EE13, #R$EE17,
; #R$EE1B and #R$EE1F.
@label=Action_TryExit
*$EE25 CALL $C2FE    ; {Call #R$C2FE to reject the command when a direct object was typed. Return
 $EE28 RET C         ; if the comparison failed.}
 $EE29 LD B,$00      ; {Call #R$C201 to fetch this room's six exits.
 $EE2B CALL $C201    ; }
 $EE2E ADD HL,BC     ; {Jump to #R$EE37 when that way out is closed.
 $EE2F LD A,(HL)     ;
 $EE30 OR A          ;
 $EE31 JR Z,$EE37    ; }
 $EE33 CALL $ECB6    ; Call #R$ECB6 to enter that room, unless the player is
                     ; too badly hurt.
 $EE36 RET           ; Return.
; Reply with "#MESSAGE$BD32".
@label=Action_Down_Next
*$EE37 LD HL,$BD32   ; {Print "#MESSAGE$BD32" and return to the game loop.
 $EE3A JP $ED66      ; }
; View the equivalent code in;
; #LIST
; { #HEROES$F7F8 }
; { #ANDROMEDA$8EF8 }
; { #JEWELS$F169 }
; { #WARLORD$F8DD }
; LIST#

; Action: Examine
;
; Describe the single object the player named.
@label=Action_Examine
c$EE3D CALL $C309    ; {Return if the words after the verb are not valid for
 $EE40 RET C         ; this command.}
 $EE41 CP $01        ; {Jump back to #R$ED73 unless the carried location
 $EE43 JP NZ,$ED73   ; matches.}
 $EE46 LD HL,$E812   ; {Jump to #R$EE54 unless the player named Mara's body.
 $EE49 CALL $C26F    ;
 $EE4C JR NZ,$EE54   ; }
; Reply with "#MESSAGE$DCB7".
 $EE4E LD HL,$DCB7   ; {Print "#MESSAGE$DCB7" and return to the game loop.
 $EE51 JP $ED66      ; }
@label=Action_Examine_Next
*$EE54 LD HL,$E814   ; {Jump to #R$EE69 unless the player named the witch.
 $EE57 CALL $C26F    ;
 $EE5A JR NZ,$EE69   ; }
 $EE5C LD A,$0B      ; {Jump to #R$EE69 if object #N$0B (the chest) is not
 $EE5E CALL $C24F    ; here.
 $EE61 JR NZ,$EE69   ; }
; Reply with "#MESSAGE$DCF0".
 $EE63 LD HL,$DCF0   ; {Print "#MESSAGE$DCF0" and return to the game loop.
 $EE66 JP $ED66      ; }
@label=Action_Examine_WitchClosedChest
*$EE69 LD HL,$E814   ; {Jump to #R$EE7E unless the player named the witch.
 $EE6C CALL $C26F    ;
 $EE6F JR NZ,$EE7E   ; }
 $EE71 LD A,$0C      ; {Jump to #R$EE7E if object #N$0C (the closed chest) is
 $EE73 CALL $C24F    ; not here.
 $EE76 JR NZ,$EE7E   ; }
; Reply with "#MESSAGE$DC7B".
 $EE78 LD HL,$DC7B   ; {Print "#MESSAGE$DC7B" and return to the game loop.
 $EE7B JP $ED66      ; }
@label=Action_Examine_NoPoint
*$EE7E JP $ED78      ; Jump back to #R$ED78 to say there is no point.

; Action: Load
;
; Load a saved position from tape.
@label=Action_Load
c$EE81 CALL $C2FE    ; {Return if the words after the verb are not valid for
 $EE84 RET C         ; this command.}
 $EE85 CALL $C380    ; Call #R$C380 to load a saved game from tape.
 $EE88 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ANDROMEDA$8FA1 }
; { #JEWELS$F236 }
; LIST#

; Action: Save
;
; Save the position to tape.
@label=Action_Save
c$EE89 CALL $C2FE    ; {Return if the words after the verb are not valid for
 $EE8C RET C         ; this command.}
 $EE8D CALL $C345    ; Call #R$C345 to save the game to tape.
 $EE90 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$F7BC }
; { #ANDROMEDA$8FA9 }
; { #JEWELS$F23E }
; { #WARLORD$F8A1 }
; LIST#

; Action: Quit
;
; Ask whether to abandon the game and, if so, offer to save it.
@label=Action_Quit
c$EE91 CALL $C2FE    ; {Return if the words after the verb are not valid for
 $EE94 RET C         ; this command.}
 $EE95 LD HL,$BC85   ; {Print "#MESSAGE$BC85".
 $EE98 CALL $BE2E    ; }
@label=Action_Quit_Loop
*$EE9B CALL $BDDA    ; Call #R$BDDA to wait for a keypress.
 $EE9E CP $4E        ; {Jump to #R$EEA9 if "N" was pressed.
 $EEA0 JR Z,$EEA9    ; }
 $EEA2 CP $59        ; {Jump back to #R$EE9B if "Y" was not pressed.
 $EEA4 JR NZ,$EE9B   ; }
 $EEA6 CALL $C345    ; Call #R$C345 to save the game to tape.
@label=Action_Quit_Next
@nowarn
*$EEA9 LD HL,$EB29   ; {Switch #R$EB29 onto the stack.
 $EEAC EX (SP),HL    ; }
 $EEAD RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$F7C4 }
; { #ANDROMEDA$8FB1 }
; { #JEWELS$F246 }
; { #WARLORD$F8A9 }
; LIST#

; Action: Take
;
; Pick up the single object the player named.
@label=Action_Take
c$EEAE CALL $C309    ; {Return if the words after the verb are not valid for
 $EEB1 RET C         ; this command.}
 $EEB2 CP $01        ; {Jump back to #R$ED7D unless the carried location
 $EEB4 JP NZ,$ED7D   ; matches.}
 $EEB7 JP $EEFC      ; Jump to #R$EEFC to take the named object.

; Handler: Already Carrying
;
; Used by the routine at #R$EEFC.
; .
; Refuse when that object is already being carried.
@label=Handler_AlreadyCarrying
c$EEBA CALL $C2D2    ; {Jump to #R$EEDD when the object is not being carried.
 $EEBD JR NZ,$EEDD   ; }
 $EEBF POP HL        ; Discard the return address on the stack.

; Handler: Print Carrying
;
; Used by the routine at #R$EEFC.
; .
; Finish the sentence "You're already carrying" with "it" or "them".
@label=Handler_PrintCarrying
c$EEC0 LD HL,$BCE0   ; {Print "#MESSAGE$BCE0".
 $EEC3 CALL $BE21    ; }
 $EEC6 LD HL,$EEEB   ; {Point at the plural-object list with this object.
 $EEC9 LD A,E        ; }
 $EECA LD BC,$0002   ; #REGbc=#N($0002,$04,$04).
 $EECD CPIR          ; {Jump to #R$EED7 if the search found a match.
 $EECF JR Z,$EED7    ; }
; Reply with "#MESSAGE$BCFB".
 $EED1 LD HL,$BCFB   ; {Print "#MESSAGE$BCFB" and return to the game loop.
 $EED4 JP $ED66      ; }
; Reply with "#MESSAGE$BCFF".
@label=Handler_PrintCarrying_Next
*$EED7 LD HL,$BCFF   ; {Print "#MESSAGE$BCFF" and return to the game loop.
 $EEDA JP $ED66      ; }
; View the equivalent code in;
; #LIST
; { #HEROES$EAFA }
; LIST#

; Handler: Inventory Full
;
; Used by the routines at #R$EEBA and #R$EEFC.
; .
; Refuse the object when the player is already holding #N$06 things.
@label=Handler_InventoryFull
c$EEDD LD A,($BA68)  ; {Return unless a full inventory of #N$06 things matches.
 $EEE0 CP $06        ;
 $EEE2 LD B,E        ;
 $EEE3 RET NZ        ; }
 $EEE4 POP HL        ; Discard the return address on the stack.
 $EEE5 LD HL,$BD05   ; {Print "#MESSAGE$BD05" and return to the game loop.
 $EEE8 JP $ED66      ; }

; List: Plural Objects
;
; Object numbers that take the plural response "them".
@label=List_PluralObjects
b$EEEB DEFB $04      ; Object #N(#PEEK(#PC)).
 $EEEC DEFB $0F      ; Object #N(#PEEK(#PC)).

; Handler: Pick Up Item
;
; Used by the routine at #R$EEFC.
; .
; Mark the object as carried, count it, and acknowledge.
@label=Handler_PickUpItem
c$EEED LD C,$01      ; {Call #R$BF55 to mark the object as carried.
 $EEEF CALL $BF55    ; }
 $EEF2 LD HL,$BA68   ; {Count one more thing carried, then print "#MESSAGE$BCDB" and
 $EEF5 INC (HL)      ; return to the game loop.
 $EEF6 LD HL,$BCDB   ;
 $EEF9 JP $ED66      ; }
; View the equivalent code in;
; #LIST
; { #WARLORD$EDA6 }
; { #SHOCK$AA6E }
; LIST#

; Action: Examine Item
;
; Used by the routine at #R$EEAE.
; .
; Describe, and sometimes change, the one thing the player is examining.
@label=Action_ExamineItem
c$EEFC LD HL,$E812   ; {Jump to #R$EF14 unless the player named Mara's body.
 $EEFF CALL $C26F    ;
 $EF02 JR NZ,$EF14   ; }
 $EF04 LD A,$0A      ; {Stop if object #N$0A (the sword) is already carried, or if the player is
 $EF06 CALL $EEBA    ; holding #N$06 things.}
 $EF09 LD BC,$333E   ; {Put object #N$33 (the glowing rock) in room #N$3E (A
 $EF0C CALL $BF55    ; Rock Wall).}
 $EF0F LD B,$0A      ; {Jump back to #R$EEED to pick the object up.
 $EF11 JP $EEED      ; }
@label=Action_ExamineItem_Next
*$EF14 LD HL,$E814   ; {Jump to #R$EF28 unless the player named the witch.
 $EF17 CALL $C26F    ;
 $EF1A JR NZ,$EF28   ; }
 $EF1C LD HL,$E6FF   ; {Call #R$C2EF to skip to the object named by this
 $EF1F CALL $C2EF    ; phrase.}
 $EF22 CALL $EEBA    ; Call #R$EEBA to stop if that object is already carried, or if six things
                     ; are already held.
 $EF25 JP $EEED      ; Jump back to #R$EEED to pick the object up.
@label=Action_ExamineItem_RopeOverhang
*$EF28 LD HL,$E816   ; {Jump to #R$EF38 unless the player named the rope on the
 $EF2B CALL $C26F    ; overhang.
 $EF2E JR NZ,$EF38   ; }
 $EF30 LD A,$00      ; {Stop if object #N$00 (the food) is already carried, or if the player is
 $EF32 CALL $EEBA    ; holding #N$06 things.}
 $EF35 JP $EEED      ; Jump back to #R$EEED to pick the object up.
@label=Action_ExamineItem_SilverCoin
*$EF38 LD HL,$E818   ; {Jump to #R$EF48 unless the player named the blacksmith.
 $EF3B CALL $C26F    ;
 $EF3E JR NZ,$EF48   ; }
 $EF40 LD A,$02      ; {Stop if object #N$02 (the silver coin) is already carried, or if the
 $EF42 CALL $EEBA    ; player is holding #N$06 things.}
 $EF45 JP $EEED      ; Jump back to #R$EEED to pick the object up.
@label=Action_ExamineItem_Bow
*$EF48 LD HL,$E81D   ; {Jump to #R$EF58 unless the player named the blacksmith.
 $EF4B CALL $C26F    ;
 $EF4E JR NZ,$EF58   ; }
 $EF50 LD A,$03      ; {Stop if object #N$03 (the bow) is already carried, or if the player is
 $EF52 CALL $EEBA    ; holding #N$06 things.}
 $EF55 JP $EEED      ; Jump back to #R$EEED to pick the object up.
@label=Action_ExamineItem_Arrows
*$EF58 LD HL,$E81F   ; {Jump to #R$EF68 unless the player named the dead
 $EF5B CALL $C26F    ; blacksmith.
 $EF5E JR NZ,$EF68   ; }
 $EF60 LD A,$04      ; {Stop if object #N$04 (the arrows) is already carried, or if the player is
 $EF62 CALL $EEBA    ; holding #N$06 things.}
 $EF65 JP $EEED      ; Jump back to #R$EEED to pick the object up.
@label=Action_ExamineItem_Furnace
*$EF68 LD HL,$E821   ; {Jump to #R$EF7C unless the player named the furnace.
 $EF6B CALL $C26F    ;
 $EF6E JR NZ,$EF7C   ; }
 $EF70 LD HL,$E6EF   ; {Call #R$C2EF to skip to the object named by this
 $EF73 CALL $C2EF    ; phrase.}
 $EF76 CALL $EEBA    ; Call #R$EEBA to stop if that object is already carried, or if six things
                     ; are already held.
 $EF79 JP $EEED      ; Jump back to #R$EEED to pick the object up.
@label=Action_ExamineItem_Continue
*$EF7C JR $EF7E      ; Carry on with the next object.
@label=Action_ExamineItem_Zarn
*$EF7E LD HL,$E825   ; {Jump to #R$EFAD unless the player named Zarn.
 $EF81 CALL $C26F    ;
 $EF84 JR NZ,$EFAD   ; }
 $EF86 LD A,$44      ; {Stop if object #N$44 (the log) is already carried, or if the player is
 $EF88 CALL $EEBA    ; holding #N$06 things.}
 $EF8B LD A,$45      ; {Destroy object #N$45 (the log bridge).
 $EF8D CALL $C2D8    ; }
 $EF90 LD A,$46      ; {Destroy object #N$46 (the log bridge).
 $EF92 CALL $C2D8    ; }
 $EF95 LD BC,$1115   ; {Put object #N$11 (the chasm) in room #N$15 (The Western
 $EF98 CALL $BF55    ; Edge of a Chasm).}
 $EF9B LD BC,$1216   ; {Put object #N$12 (the chasm) in room #N$16 (The Eastern
 $EF9E CALL $BF55    ; Edge of a Chasm).}
 $EFA1 XOR A         ; {Jump back to #R$EEED to pick the object up.
 $EFA2 LD ($E9B4),A  ;
 $EFA5 LD ($E9BB),A  ;
 $EFA8 LD B,$44      ;
 $EFAA JP $EEED      ; }
@label=Action_ExamineItem_PrincessMara
*$EFAD LD HL,$E827   ; {Jump to #R$EFBD unless the player named Princess Mara.
 $EFB0 CALL $C26F    ;
 $EFB3 JR NZ,$EFBD   ; }
 $EFB5 LD A,$09      ; {Stop if object #N$09 (the horn) is already carried, or if the player is
 $EFB7 CALL $EEBA    ; holding #N$06 things.}
 $EFBA JP $EEED      ; Jump back to #R$EEED to pick the object up.
@label=Action_ExamineItem_OldMan
*$EFBD LD HL,$E829   ; {Jump to #R$EFE8 unless the player named the old man.
 $EFC0 CALL $C26F    ;
 $EFC3 JR NZ,$EFE8   ; }
 $EFC5 LD HL,$E706   ; {Call #R$C2EF to skip to the object named by this
 $EFC8 CALL $C2EF    ; phrase.}
 $EFCB CALL $C2D2    ; {Jump to #R$EFD5 when the object is not being carried.
 $EFCE JR NZ,$EFD5   ; }
 $EFD0 LD E,$0F      ; {Jump back to #R$EEC0 to finish the carrying sentence.
 $EFD2 JP $EEC0      ; }
@label=Action_ExamineItem_TakeChest
*$EFD5 CALL $EEDD    ; Call #R$EEDD to refuse the object when six things are
                     ; already carried.
 $EFD8 LD A,E        ; {Jump to #R$EFE3 when the value #N$0F matches.
 $EFD9 CP $0F        ;
 $EFDB JR Z,$EFE3    ; }
 $EFDD LD BC,$0D0E   ; {Replace object #N$0D (the open chest) with object #N$0E
 $EFE0 CALL $C48F    ; (the empty chest).}
@label=Action_ExamineItem_PickUp
*$EFE3 LD B,$0F      ; {Jump back to #R$EEED to pick the object up.
 $EFE5 JP $EEED      ; }
@label=Action_ExamineItem_Key
*$EFE8 LD HL,$E82F   ; {Jump to #R$EFF8 unless the player named the key.
 $EFEB CALL $C26F    ;
 $EFEE JR NZ,$EFF8   ; }
 $EFF0 LD A,$10      ; {Stop if object #N$10 (the key) is already carried, or if the player is
 $EFF2 CALL $EEBA    ; holding #N$06 things.}
 $EFF5 JP $EEED      ; Jump back to #R$EEED to pick the object up.
@label=Action_ExamineItem_DeadSpider
*$EFF8 LD HL,$E831   ; {Jump to #R$F006 unless the player named the dead
 $EFFB CALL $C26F    ; spider.
 $EFFE JR NZ,$F006   ; }
; Reply with "#MESSAGE$DC63".
 $F000 LD HL,$DC63   ; {Print "#MESSAGE$DC63" and return to the game loop.
 $F003 JP $ED66      ; }
@label=Action_ExamineItem_TakeRingOff
*$F006 LD HL,$E833   ; {Jump to #R$F011 unless the player named taking the ring
 $F009 CALL $C26F    ; off.
 $F00C JR NZ,$F011   ; }
 $F00E JP $ED7D      ; Jump back to #R$ED7D to ask for a rephrase.
@label=Action_ExamineItem_Demons
*$F011 LD HL,$E823   ; {Jump to #R$F037 unless the player named the demons.
 $F014 CALL $C26F    ;
 $F017 JR NZ,$F037   ; }
 $F019 LD A,($BA9B)  ; {Jump to #R$F037 when the player is in room #N$48
 $F01C CP $48        ; (Inside the Volcano).
 $F01E JR Z,$F037    ; }
 $F020 LD A,$08      ; {Stop if object #N$08 (the rope) is already carried, or if the player is
 $F022 CALL $EEBA    ; holding #N$06 things.}
 $F025 LD A,$23      ; {Jump to #R$F032 if object #N$23 (the rope on the
 $F027 CALL $C24F    ; overhang) is not here.
 $F02A JR NZ,$F032   ; }
 $F02C LD BC,$2322   ; {Replace object #N$23 (the rope on the overhang) with object #N$22 (the
 $F02F CALL $C48F    ; rock overhang).}
@label=Action_ExamineItem_TakeRope
*$F032 LD B,$08      ; {Jump back to #R$EEED to pick the object up.
 $F034 JP $EEED      ; }
@label=Action_ExamineItem_YouCant
*$F037 JP $ED6E      ; Tell the player the command is impossible.

; Action: Drop
;
; Drop one of the objects the player named.
@label=Action_Drop
c$F03A CALL $C309    ; {Return if the words after the verb are not valid for
 $F03D RET C         ; this command.}
 $F03E CP $03        ; {Jump to #R$F079 if the value #N$03 failed.
 $F040 JR C,$F079    ; }
 $F042 JP $ED7D      ; Jump back to #R$ED7D to ask for a rephrase.

; Handler: Not Carrying It
;
; Put the object in this room, with special cases for the log, the chest and
; the ring.
@label=Handler_NotCarryingIt
c$F045 CALL $C2D2    ; {Jump to #R$F067 when the object is being carried.
 $F048 JR Z,$F067    ; }
