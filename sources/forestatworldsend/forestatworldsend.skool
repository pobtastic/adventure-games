 $F1DD CALL $C26F    ; the boat.
 $F1E0 JR NZ,$F1F5   ; }
 $F1E2 LD A,$1D      ; {Jump to #R$F1EF when object #N$1D (the boat) is here.
 $F1E4 CALL $C24F    ;
 $F1E7 JR Z,$F1EF    ; }
