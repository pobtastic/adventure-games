; Messaging: "Congratulations"
@label=Messaging_Congratulations
t$D53A DEFM "Congratulations!",$0D,"The Wizard is dead.",$0D,"The Princess is saved.",$0D,"She f" ; {"#MESSAGE$D53A".
 $D57B DEFM "alls into your arms",$0D,"and you are both carried",$0D,"off,into the sunset "       ;
 $D5BC DEFM "by",$0D,"some singing wood nymphs.",$0D,"The forces of Light have",$0D,"triumphed o" ;
 $D5FD DEFM "nce again."                                                                          ; }
