; Handler: Room Image: The Great Valley
;
; Draw The Great Valley.
@label=Handler_RoomImageTheGreatValley
c$FACF LD IX,$61A8   ; Start at The Great Valley (#R$61A8).
 $FAD3 JR $FB09      ; Jump to #R$FB09 to draw it.

; Handler: Room Image: The Woodman's Hut
;
; Draw The Woodman's Hut.
@label=Handler_RoomImageTheWoodmansHut
c$FAD5 LD IX,$69EB   ; Start at The Woodman's Hut (#R$69EB).
 $FAD9 JR $FB09      ; Jump to #R$FB09 to draw it.

; Handler: Room Image: The Old Well
;
; Draw The Old Well.
@label=Handler_RoomImageTheOldWell
c$FADB LD IX,$7482   ; Start at The Old Well (#R$7482).
 $FADF JR $FB09      ; Jump to #R$FB09 to draw it.

; Handler: Room Image: The Volcano
;
; Draw The Volcano.
@label=Handler_RoomImageTheVolcano
c$FAE1 LD IX,$7B71   ; Start at The Volcano (#R$7B71).
 $FAE5 JR $FB09      ; Jump to #R$FB09 to draw it.

; Handler: Room Image: The Witch's Hovel
;
; Draw The Witch's Hovel.
