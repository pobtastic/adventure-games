; Tape Loader
;
; Load the picture, the room graphics and the game from tape, then start.
;
; .
;
; Load the picture.
@label=TapeLoader
c$5B00 LD IX,$4000   ; {Load #N$1B00 bytes of the picture to #N$4000.
 $5B04 LD DE,$1B00   ; }
 $5B07 CALL $5B1B    ; Call #R$5B1B to load the picture.
; Load the room graphics.
 $5B0A LD IX,$61A8   ; {Load #N$581D bytes of the room graphics to #R$61A8.
 $5B0E LD DE,$581D   ; }
 $5B11 CALL $5B1B    ; Call #R$5B1B to load the room graphics.
; Load the game, then fall into the loader.
@nowarn
 $5B14 LD IX,$B9C5   ; {Load #N$41C8 bytes of the game to #R$B9C5.
 $5B18 LD DE,$41C8   ; }
; View the equivalent code in;
; #LIST
; { #HEROES$5B00 }
; { #ANDROMEDA$5CD0 }
; LIST#

; Tape Loading
;
; Used by the routine at #R$5B00.
; .
; Load one tape block into the address and length set up by the caller.
;
; .
;
; Load the next block from tape.
@label=TapeLoading
c$5B1B LD A,$45      ; This is a data block (#N$45).
 $5B1D SCF           ; Set the carry flag to indicate "loading".
 $5B1E CALL $0802    ; Call #SKOOLKID$0802(LD_BLOCK).
 $5B21 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ANDROMEDA$5D01 }
; LIST#

