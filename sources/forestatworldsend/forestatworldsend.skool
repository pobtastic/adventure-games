; Action: Touch
;
; Touch the glowing rock and open the way east.
@label=Action_Touch
c$F7C2 CALL $C309    ; {Return if the words after the verb are not valid for
 $F7C5 RET C         ; this command.}
 $F7C6 LD HL,$E8F9   ; {Jump to #R$F7E8 unless the player named the glowing
 $F7C9 CALL $C26F    ; rock.
 $F7CC JR NZ,$F7E8   ; }
 $F7CE LD A,$33      ; {Jump to #R$EDA5 if object #N$33 (the glowing rock) is
 $F7D0 CALL $C24F    ; not here.
 $F7D3 JP NZ,$EDA5   ; }
 $F7D6 LD A,($EAAA)  ; {Jump back to #R$EDA5 when the rock wall already has a
 $F7D9 AND A         ; way east.
 $F7DA JP NZ,$EDA5   ; }
