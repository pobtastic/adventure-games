 $E14D DEFB $FF                    ; Terminator.

; Messaging: "It's Too Late For That,"
@label=Messaging_ItsTooLateForThat
t$E14E DEFM "It's too late for that,",$0D,"she's dead." ; "#MESSAGE$E14E".
 $E171 DEFB $FF                                         ; Terminator.

; Messaging: "It's Already Open"
@label=Messaging_ItsAlreadyOpen
t$E172 DEFM "It's already open." ; "#MESSAGE$E172".
 $E184 DEFB $FF                  ; Terminator.

; Messaging: "It's Already Closed"
@label=Messaging_ItsAlreadyClosed
t$E185 DEFM "It's already closed." ; "#MESSAGE$E185".
 $E199 DEFB $FF                    ; Terminator.

; Messaging: "You're Inside Already"
@label=Messaging_YoureInsideAlready
t$E19A DEFM "You're inside already!" ; "#MESSAGE$E19A".
 $E1B0 DEFB $FF                      ; Terminator.

; Messaging: "You're Wearing It Already"
@label=Messaging_YoureWearingItAlready
t$E1B1 DEFM "You're wearing it already!" ; "#MESSAGE$E1B1".
 $E1CB DEFB $FF                          ; Terminator.

; Messaging: "It Has No Apparent Effect"
@label=Messaging_ItHasNoApparentEffect
t$E1CC DEFM "It has no apparent effect." ; "#MESSAGE$E1CC".
 $E1E6 DEFB $FF                          ; Terminator.

; Messaging: "As You Touch The Rock,"
@label=Messaging_AsYouTouchTheRock
t$E1E7 DEFM "As you touch the rock,",$0D,"a passage opens,leading east." ; "#MESSAGE$E1E7".
 $E21B DEFB $FF                                                          ; Terminator.

; Messaging: "You Plunge Into The Water"
@label=Messaging_YouPlungeIntoTheWater
t$E21C DEFM "You plunge into the water.",$0D,"The current is too strong",$0D,"and you are " ; {"#MESSAGE$E21C".
 $E25D DEFM "drawn down,",$0D,"into the depths."                                            ; }
 $E279 DEFB $FF                                                                             ; Terminator.

; Messaging: "You Make A Tremondous Leap,"
@label=Messaging_YouMakeATremondousLeap
t$E27A DEFM "You make a tremondous leap,",$0D,"but it is too wide.",$0D,"You fall to the b" ; {"#MESSAGE$E27A".
 $E2BB DEFM "ottom."                                                                        ; }
 $E2C1 DEFB $FF                                                                             ; Terminator.

; Messaging: "O.K. The Rope Dangles Down, Into The Volcano"
@label=Messaging_OKTheRopeDanglesDownIntoTheVolcano
t$E2C2 DEFM "O.K.",$0D,"The rope dangles down,",$0D,"into the volcano." ; "#MESSAGE$E2C2".
 $E2EF DEFB $FF                                                         ; Terminator.

; Messaging: "The Rope Is Already Tied"
@label=Messaging_TheRopeIsAlreadyTied
t$E2F0 DEFM "The rope is already tied." ; "#MESSAGE$E2F0".
 $E309 DEFB $FF                         ; Terminator.

; Messaging: "Don't Be Disgusting"
@label=Messaging_DontBeDisgusting
t$E30A DEFM "Don't be disgusting!" ; "#MESSAGE$E30A".
 $E31E DEFB $FF                    ; Terminator.

; Messaging: "She Evades Your Grasp"
@label=Messaging_SheEvadesYourGrasp
t$E31F DEFM "She evades your grasp",$0D,"and flees,screaming." ; "#MESSAGE$E31F".
 $E349 DEFB $FF                                                ; Terminator.

; Messaging: "You Row Across To"
@label=Messaging_YouRowAcrossTo
t$E34A DEFM "You row across to",$0D,"the opposite bank." ; "#MESSAGE$E34A".
 $E36E DEFB $FF                                          ; Terminator.

; Messaging: "It Is Already Unlocked"
@label=Messaging_ItIsAlreadyUnlocked
t$E36F DEFM "It is already unlocked." ; "#MESSAGE$E36F".
 $E386 DEFB $FF                       ; Terminator.

; Messaging: "You're Not Carrying A Key"
@label=Messaging_YoureNotCarryingAKey
t$E387 DEFM "You're not carrying a key." ; "#MESSAGE$E387".
 $E3A1 DEFB $FF                          ; Terminator.

; Messaging: "You're No Carrying A Horn"
@label=Messaging_YoureNoCarryingAHorn
t$E3A2 DEFM "You're no carrying a horn." ; "#MESSAGE$E3A2".
 $E3BC DEFB $FF                          ; Terminator.

; Messaging: "The Dragon Leaps Into The Air,"
@label=Messaging_TheDragonLeapsIntoTheAir
t$E3BD DEFM "The dragon leaps into the air,",$0D,"catching you carefully.",$0D,"You are li" ; {"#MESSAGE$E3BD".
 $E3FE DEFM "fted with it.",$0D,"The dragon deposits you at",$0D,"the bottom of the precip" ;
 $E43F DEFM "ice."                                                                          ; }
 $E443 DEFB $FF                                                                             ; Terminator.

; Messaging: "The Dragon Swoops Down"
@label=Messaging_TheDragonSwoopsDown
t$E444 DEFM "The dragon swoops down",$0D,"and picks you up.",$0D,"It takes you to the top",$0D ; {"#MESSAGE$E444".
 $E485 DEFM "of the precipice."                                                                ; }
 $E496 DEFB $FF                                                                                ; Terminator.

; Messaging: "You Can't. It's Locked"
@label=Messaging_YouCantItsLocked
t$E497 DEFM "You can't. It's locked." ; "#MESSAGE$E497".
 $E4AE DEFB $FF                       ; Terminator.

