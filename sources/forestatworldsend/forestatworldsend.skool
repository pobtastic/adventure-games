; Action: Kill
;
; Fight the opponent the player named.
@label=Action_Kill
c$F2A7 CALL $C32D    ; {Return if the words after the verb are not valid for
 $F2AA RET C         ; this command.}
 $F2AB JP $F30B      ; Jump to #R$F30B to fight the named opponent.

; Handler: Check Weapon
;
; Used by the routines at #R$F30B, #R$F48B, #R$F516 and #R$F55C.
; .
; Require the bow, and an arrow, before combat continues.
@label=Handler_CheckWeapon
c$F2AE LD A,$03      ; {Jump to #R$F2C0 if the player is not carrying object
 $F2B0 CALL $C2D2    ; #N$03 (the bow).
 $F2B3 JR NZ,$F2C0   ; }
 $F2B5 LD A,$04      ; {Return when the player is carrying object #N$04 (the
 $F2B7 CALL $C2D2    ; arrows).
 $F2BA RET Z         ; }
 $F2BB LD HL,$DED1   ; {Print "#MESSAGE$DED1" to say the arrows are missing.
 $F2BE JR $F2C3      ; }
@label=Handler_CheckWeapon_Next
*$F2C0 LD HL,$DF29   ; The bow is missing, so say "#MESSAGE$DF29".
@label=Handler_CheckWeapon_Reply
*$F2C3 POP DE        ; Discard the return address on the stack.
 $F2C4 JP $ED66      ; Jump back to #R$ED66 to print that reply and return to
                     ; the game loop.

; Handler: Require Sword
;
; Used by the routines at #R$F30B, #R$F48B and #R$F516.
; .
; Require the sword before combat continues.
@label=Handler_RequireSword
c$F2C7 LD A,$0A      ; {Return when the player is carrying object #N$0A (the
 $F2C9 CALL $C2D2    ; sword).
 $F2CC RET Z         ; }
 $F2CD LD HL,$DF72   ; Print "#MESSAGE$DF72".
 $F2D0 POP DE        ; Discard the return address on the stack.
 $F2D1 JP $ED66      ; Jump back to #R$ED66 to return to the game loop.

; Handler: Announce Arrow
;
; Used by the routines at #R$F30B, #R$F48B, #R$F516 and #R$F55C.
; .
; Tell the player an arrow has been loosed.
@label=Handler_AnnounceArrow
c$F2D4 PUSH AF       ; {Print "#MESSAGE$DEE5" and start a new line.
 $F2D5 LD HL,$DEE5   ;
 $F2D8 JR $F2DE      ; }

; Handler: Resolve Attack
;
; Used by the routines at #R$F30B, #R$F48B and #R$F516.
; .
; Print the attack, then sometimes announce that it missed.
@label=Handler_ResolveAttack
c$F2DA PUSH AF       ; {The sword swings, with "#MESSAGE$DF5C".
 $F2DB LD HL,$DF5C   ; }
; This entry point is used by the routine at #R$F2D4.
@label=Handler_ResolveAttack_Print
*$F2DE CALL $BE2E    ; Print that message and start a new line.
 $F2E1 POP AF        ; Restore the miss flag from the stack.
 $F2E2 AND A         ; {Return when this attack cannot miss.
 $F2E3 RET Z         ; }
 $F2E4 CALL $BF45    ; {Call #R$BF45 to roll the miss chance, and return when
 $F2E7 RET NZ        ; the blow lands.}
 $F2E8 LD HL,$DEF9   ; The blow missed. Print "#MESSAGE$DEF9".
 $F2EB POP DE        ; Discard the return address on the stack.
 $F2EC JP $ED6A      ; Jump back to #R$ED6A to return to the game loop.

; Handler: Apply Combat Result
;
; Used by the routine at #R$F30B.
; .
; Replace a defeated creature with its body.
@label=Handler_ApplyCombatResult
c$F2EF LD HL,$BB4D   ; {Call #R$C48F to turn the defeated creature into its
 $F2F2 LD A,(HL)     ; corpse.
 $F2F3 SUB $80       ;
 $F2F5 ADD A,$13     ;
 $F2F7 LD B,(HL)     ;
 $F2F8 LD C,A        ;
 $F2F9 CALL $C48F    ; }
 $F2FC RET           ; Return.

; Handler: Apply Second Combat Result
;
; Used by the routine at #R$F30B.
; .
; Replace a second defeated creature with its body.
@label=Handler_ApplySecondCombatResult
c$F2FD LD HL,$BB4D   ; {Call #R$C48F to turn the second defeated creature into
 $F300 LD A,(HL)     ; its corpse.
 $F301 SUB $83       ;
 $F303 ADD A,$18     ;
 $F305 LD B,(HL)     ;
 $F306 LD C,A        ;
 $F307 CALL $C48F    ; }
 $F30A RET           ; Return.

; Handler: Fight Opponent
;
; Used by the routine at #R$F2A7.
; .
; Fight whichever opponent the player named.
@label=Handler_FightOpponent
c$F30B LD HL,$E87D   ; {Jump to #R$F344 unless the player named the elf with
 $F30E CALL $C26F    ; the sword.
 $F311 JR NZ,$F344   ; }
 $F313 LD HL,$E711   ; {Call #R$C2EF to skip to the object named by this
 $F316 CALL $C2EF    ; phrase.}
 $F319 BIT 7,A       ; {Jump back to #R$ED82 when the named opponent is already
 $F31B JP Z,$ED82    ; dead.}
 $F31E LD ($BB4D),A  ; {Call #R$F2C7 to make sure the player is holding the
 $F321 CALL $F2C7    ; sword.}
 $F324 LD A,$0A      ; {Call #R$F2DA to resolve the attack on the named
 $F326 CALL $F2DA    ; opponent.}
 $F329 CALL $F2EF    ; Call #R$F2EF to turn the defeated opponent into its
                     ; corpse.
 $F32C LD A,($BB4D)  ; {Jump to #R$F338 unless the value #N$82 matches.
 $F32F CP $82        ;
 $F331 JR NZ,$F338   ; }
 $F333 LD A,$86      ; {Remove object #N$86 (the centaur) from the game.
 $F335 CALL $C2E8    ; }
@label=Handler_FightOpponent_Next
*$F338 LD HL,$DF44   ; {Print "#MESSAGE$DF44".
 $F33B CALL $C486    ; }
; Reply with "#MESSAGE$DFA3".
 $F33E LD HL,$DFA3   ; {Print "#MESSAGE$DFA3" and return to the game loop.
 $F341 JP $ED66      ; }
@label=Handler_FightOpponent_ElfBow
*$F344 LD HL,$E881   ; {Jump to #R$F37D unless the player named the elf with
 $F347 CALL $C26F    ; the bow.
 $F34A JR NZ,$F37D   ; }
 $F34C LD HL,$E711   ; {Call #R$C2EF to skip to the object named by this
 $F34F CALL $C2EF    ; phrase.}
 $F352 BIT 7,A       ; {Jump back to #R$ED82 when the named opponent is already
 $F354 JP Z,$ED82    ; dead.}
 $F357 LD ($BB4D),A  ; {Call #R$F2AE to make sure the player is holding the bow
 $F35A CALL $F2AE    ; and some arrows.}
 $F35D LD A,$05      ; {Call #R$F2D4 to announce the arrow.
 $F35F CALL $F2D4    ; }
 $F362 CALL $F2EF    ; Call #R$F2EF to turn the defeated opponent into its
                     ; corpse.
 $F365 LD A,($BB4D)  ; {Jump to #R$F371 unless the value #N$82 matches.
 $F368 CP $82        ;
 $F36A JR NZ,$F371   ; }
 $F36C LD A,$86      ; {Remove object #N$86 (the centaur) from the game.
 $F36E CALL $C2E8    ; }
@label=Handler_FightOpponent_PerfectShot
*$F371 LD HL,$DF0E   ; {Print "#MESSAGE$DF0E".
 $F374 CALL $C486    ; }
; Reply with "#MESSAGE$DFA3".
 $F377 LD HL,$DFA3   ; {Print "#MESSAGE$DFA3" and return to the game loop.
