; Table: Directions
;
; Pointers to the direction names, in the order north, south,
; east, west, up and down.
@label=Table_Directions
g$BDB2 DEFW $BBCF    ; #R(#PEEK(#PC+$01)*$100+#PEEK(#PC)).
 $BDB4 DEFW $BBD5    ; #R(#PEEK(#PC+$01)*$100+#PEEK(#PC)).
 $BDB6 DEFW $BBDB    ; #R(#PEEK(#PC+$01)*$100+#PEEK(#PC)).
 $BDB8 DEFW $BBE0    ; #R(#PEEK(#PC+$01)*$100+#PEEK(#PC)).
 $BDBA DEFW $BBE5    ; #R(#PEEK(#PC+$01)*$100+#PEEK(#PC)).
 $BDBC DEFW $BBE8    ; #R(#PEEK(#PC+$01)*$100+#PEEK(#PC)).

; Response: "Please Rephrase That"
;
; Used by the routines at #R$C2FE, #R$C309, #R$C31E and #R$C32D.
; .
; Tell the player to rephrase the command.
@label=Response_PleaseRephraseThat
c$BDBE LD HL,$BCBA   ; {Print "#MESSAGE$BCBA".
 $BDC1 CALL $BE2E    ; }
 $BDC4 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B1E4 }
; { #ANDROMEDA$6479 }
; { #JEWELS$BFEE }
; { #WARLORD$AAEE }
; LIST#

; Response: "Please Be More Specific"
;
; Used by the routines at #R$C309 and #R$C32D.
; .
; Ask the player to be more specific.
@label=Response_PleaseBeMoreSpecific
c$BDC5 LD HL,$BCA1   ; {Print "#MESSAGE$BCA1".
 $BDC8 CALL $BE2E    ; }
 $BDCB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B1EB }
; { #ANDROMEDA$6480 }
; { #JEWELS$BFF5 }
; { #WARLORD$AAF5 }
; LIST#

; Response: "You Can't"
;
; Tell the player the command is impossible.
@label=Response_YouCant
c$BDCC LD HL,$BCD0   ; {Print "#MESSAGE$BCD0".
 $BDCF CALL $BE2E    ; }
 $BDD2 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B1F2 }
; { #ANDROMEDA$6487 }
; { #JEWELS$BFFC }
; { #WARLORD$AAFC }
; LIST#

; Response: "O.K"
;
; Acknowledge the command.
@label=Response_Ok
c$BDD3 LD HL,$BCDB   ; {Print "#MESSAGE$BCDB".
 $BDD6 CALL $BE2E    ; }
 $BDD9 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B1F9 }
; { #ANDROMEDA$648E }
; { #JEWELS$C003 }
; { #WARLORD$AB03 }
; LIST#

; Get User Input
;
; Used by the routines at #R$BF73, #R$C0F9, #R$C345, #R$EB23 and #R$EE91.
; .
; Wait for a new keypress.
;
; O:A The keypress value
@label=GetUserInput
c$BDDA LD A,($5C3B)  ; {Read *#SKOOLKID$5C3B(FLAGS) and jump back to #R$BDDA
 $BDDD BIT 5,A       ; until a new key is pressed.
 $BDDF JR Z,$BDDA    ; }
 $BDE1 RES 5,A       ; Reset the "new key has been pressed" flag.
 $BDE3 LD ($5C3B),A  ; Write it back to *#SKOOLKID$5C3B(FLAGS).
; Fetch the keypress.
 $BDE6 LD A,($5C08)  ; Copy the key from *#SKOOLKID$5C08(LAST_K).
 $BDE9 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$ABE1 }
; { #ANDROMEDA$6495 }
; { #JEWELS$BA5D }
; { #WARLORD$A53E }
; { #SHOCK$9DFB }
; LIST#

; Clear Screen
;
; Used by the routines at #R$C0F9, #R$EB3E and #R$EDE8.
; .
; Clear the screen and select the text channel.
@label=ClearScreen
c$BDEA CALL $BE13    ; Call #R$BE13 to select the screen channel.
 $BDED CALL $0D6B    ; Call #SKOOLKID$0D6B(CLS).
 $BDF0 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$ABF1 }
; { #ANDROMEDA$64A5 }
; { #JEWELS$BA6D }
; { #WARLORD$A54E }
; LIST#

; Clear Lines
;
; Clear the picture lines, using the line count stored at #R$BB40.
;
; B Line count from *#R$BB40
@label=ClearLines
c$BDF1 CALL $BE13    ; Call #R$BE13 to select the screen channel.
 $BDF4 LD A,($BB40)  ; {Clear the number of lines held by *#R$BB40 from the
 $BDF7 LD B,A        ; bottom of the screen using #SKOOLKID$0E44(CL_LINE).
 $BDF8 CALL $0E44    ; }
 $BDFB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$ABF8 }
; { #ANDROMEDA$64AC }
; { #JEWELS$BA74 }
; { #WARLORD$A555 }
; LIST#

; Set Default Screen Position
;
; Used by the routines at #R$BE55 and #R$BF73.
; .
; Park the cursor at the top-left of the text window.
@label=SetDefaultScreenPosition
c$BDFC CALL $BE13    ; Call #R$BE13 to select the screen channel.
 $BDFF LD BC,$0321   ; Park the cursor at column #N$21 of row #N$03.
 $BE02 CALL $0DD9    ; Call #SKOOLKID$0DD9(CL_SET).
 $BE05 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$AC03 }
; { #ANDROMEDA$64B7 }
; { #JEWELS$BA7F }
; { #WARLORD$A560 }
; LIST#

; Set Screen Position
;
; Used by the routines at #R$C0F9, #R$EB3E and #R$EDE8.
; .
; Park the cursor on the text row stored at #R$BB40.
;
; A Line number to start printing at
@label=SetScreenPosition
c$BE06 CALL $BE13    ; Call #R$BE13 to select the screen channel.
 $BE09 LD A,($BB40)  ; {Take the text row from *#R$BB40.
 $BE0C LD B,A        ; }
 $BE0D LD C,$21      ; {Call #SKOOLKID$0DD9(CL_SET) with column #N$21.
 $BE0F CALL $0DD9    ; }
 $BE12 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$AC0D }
; { #ANDROMEDA$64C1 }
; { #JEWELS$BA89 }
; { #WARLORD$A56A }
; LIST#

; Switch To Normal Screen Output
;
; Used by the routines at #R$BDEA, #R$BDF1, #R$BDFC, #R$BE06, #R$BE21, #R$BE5E
; and #R$BF73.
; .
; Open the upper screen channel without disturbing the registers.
@label=SwitchToNormalScreenOutput
c$BE13 PUSH HL       ; {Save the registers and open the upper screen with
 $BE14 PUSH DE       ; #SKOOLKID$1601(CHAN_OPEN) on stream #N$02.
 $BE15 PUSH BC       ;
 $BE16 PUSH AF       ;
 $BE17 LD A,$02      ;
 $BE19 CALL $1601    ; }
 $BE1C POP AF        ; {Restore #REGaf, #REGbc, #REGde and #REGhl from the
 $BE1D POP BC        ; stack.
 $BE1E POP DE        ;
 $BE1F POP HL        ; }
 $BE20 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$AC1A }
; { #ANDROMEDA$64CE }
; { #JEWELS$BA96 }
; { #WARLORD$A577 }
; LIST#

; Print String
;
; Used by the routines at #R$BE2E, #R$BF73, #R$C0F9, #R$C213, #R$C3C0, #R$EEC0
; and #R$F045.
; .
; Print a message terminated by #N$FF.
;
; HL Pointer to a message terminated by #N$FF
@label=PrintString
c$BE21 CALL $BE13    ; Call #R$BE13 to select the screen channel.
; Keep printing until the #N$FF terminator.
@label=PrintString_Loop
*$BE24 LD A,(HL)     ; {Read the next character and advance the pointer.
 $BE25 INC HL        ; }
 $BE26 CP $FF        ; {Return if this character is the #N$FF terminator.
 $BE28 RET Z         ; }
; Print this character.
 $BE29 CALL $BE37    ; Call #R$BE37.
 $BE2C JR $BE24      ; Jump back to #R$BE24 for the next character.
; View the equivalent code in;
; #LIST
; { #HEROES$AC28 }
; { #ANDROMEDA$64DC }
; { #JEWELS$BAA4 }
; { #WARLORD$A585 }
; LIST#

; Print String And A Newline
;
; Used by the routines at #R$BDBE, #R$BDC5, #R$BDCC, #R$BDD3, #R$BFD8, #R$C0B4,
; #R$C0D2, #R$C0F9, #R$C213, #R$C345, #R$C380, #R$C463, #R$C486, #R$EB23,
; #R$EB3E, #R$EB4C, #R$EB98, #R$EBAF, #R$EBCC, #R$EBE9, #R$EBFB, #R$EC13,
; #R$EC2B, #R$EC3D, #R$EC5F, #R$EC99, #R$ECB6, #R$ED66, #R$EDE8, #R$EE91,
; #R$F216 and #R$F2DA.
; .
; Print a message terminated by #N($FF), then move to the next line.
;
; HL Pointer to a message terminated by #N$FF
;
; Print the message.
@label=PrintStringAndANewline
c$BE2E CALL $BE21    ; Call #R$BE21.
; Force a newline.
 $BE31 LD A,$0D      ; Start a new line (#N$0D).
 $BE33 CALL $BE37    ; Call #R$BE37 to print the newline.
 $BE36 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$AC35 }
; { #ANDROMEDA$64E9 }
; { #JEWELS$BAB1 }
; { #WARLORD$A592 }
; { #SHOCK$A25C(After Shock (compressed)) }
; { #SHOCK$A275(After Shock (plain)) }
; LIST#

; Print Character
;
; Used by the routines at #R$BE21, #R$BE2E, #R$BF73, #R$BFD8, #R$C0F9 and
; #R$C3C0.
; .
; Print one character, scrolling the text window when the cursor reaches its
; edge.
;
; A Character to print
@label=PrintCharacter
c$BE37 PUSH AF       ; Keep the character safe on the stack.
 $BE38 LD A,($5C89)  ; {Jump to #R$BE52 if the line byte of
 $BE3B CP $03        ; #SKOOLKID$5C88(S_POSN) (#N$5C89) is not row #N$03.
 $BE3D JR NZ,$BE52   ; }
 $BE3F POP AF        ; {Restore the character from the stack, leaving a copy.
 $BE40 PUSH AF       ; }
 $BE41 CP $0D        ; {Jump to #R$BE4A if this is not a newline (#N$0D).
 $BE43 JR NZ,$BE4A   ; }
; A newline scrolls the text window and prints nothing.
 $BE45 CALL $BE55    ; Call #R$BE55.
 $BE48 POP AF        ; Discard the character from the stack.
 $BE49 RET           ; Return.
; Check the column.
@label=PrintCharacter_CheckColumn
*$BE4A LD A,($5C88)  ; {Call #R$BE55 if *#SKOOLKID$5C88(S_POSN) is column
 $BE4D CP $01        ; #N$01.
 $BE4F CALL Z,$BE55  ; }
; Print the character.
@label=PrintCharacter_Direct
*$BE52 POP AF        ; Restore the character from the stack.
 $BE53 RST $10       ; Print it with #SKOOLKID$0010(PRINT_A_1).
 $BE54 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$AC47 }
; { #ANDROMEDA$64F2 }
; { #JEWELS$BAC3 }
; { #WARLORD$A5A4 }
; LIST#

; Scroll Screen
;
; Used by the routine at #R$BE37.
; .
; Scroll the text up and put the cursor back on the top line.
@label=ScrollScreen
c$BE55 EXX           ; Switch to the shadow registers.
; Scroll the text up.
 $BE56 CALL $0DFE    ; Call #SKOOLKID$0DFE(CL_SC_ALL).
; Put the cursor back at the top of the text window.
 $BE59 CALL $BDFC    ; Call #R$BDFC to put the cursor back at the top.
 $BE5C EXX           ; Switch back to the main registers.
 $BE5D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$AC3E }
; { #ANDROMEDA$6510 }
; { #JEWELS$BABA }
; { #WARLORD$A59B }
; LIST#

; Print Room Graphic
;
; Used by the routine at #R$BEB8.
; .
; Unpack a room picture into the display, drawing it in the paper colour.
;
; IX Pointer to room image data
@label=Print_RoomGraphic
c$BE5E CALL $BE13    ; Call #R$BE13 to select the screen channel.
 $BE61 LD BC,$1821   ; Set the cursor to row #N($18), column #N$21.
 $BE64 CALL $0DD9    ; Call #SKOOLKID$0DD9(CL_SET).
; Draw the picture in the paper colour.
 $BE67 LD HL,$5C8F   ; Take the current attribute from *#SKOOLKID$5C8F(ATTR_T).
 $BE6A LD A,(HL)     ; Fetch the attribute byte.
 $BE6B AND $38       ; Keep only the PAPER bits.
 $BE6D RRA           ; {Move the PAPER bits into the INK bits.
 $BE6E RRA           ;
 $BE6F RRA           ; }
 $BE70 LD B,A        ; Keep that ink colour.
 $BE71 LD A,(HL)     ; Fetch the attribute byte again.
 $BE72 AND $F8       ; Keep everything except the old INK bits.
 $BE74 OR B          ; Combine the two values.
 $BE75 LD (HL),A     ; Write the result back to *#SKOOLKID$5C8F(ATTR_T).
 $BE76 LD BC,$0200   ; Count #N$0200 picture bytes.
@label=Print_RoomGraphic_Loop
*$BE79 PUSH BC       ; Keep the byte counter safe.
 $BE7A LD HL,$BB45   ; Use the scanline buffer (#R$BB45).
 $BE7D LD B,$08      ; Count #N$08 bits.
 $BE7F LD C,(IX+$00) ; {Read the next control byte and advance through the
 $BE82 INC IX        ; picture.}
 $BE84 JR $BE87      ; Jump to #R$BE87 to test the first control bit.
@label=Print_RoomGraphic_NextByte
*$BE86 INC HL        ; Advance to the next byte of the scanline.
@label=Print_RoomGraphic_ShiftBit
*$BE87 SRL C         ; Take the next control bit; a set bit means this scanline
                     ; byte comes from the picture data.
 $BE89 JR NC,$BE92   ; Jump to #R$BE92 when that bit is reset, so the byte is
                     ; blank.
 $BE8B LD A,(IX+$00) ; {Read the next picture byte and advance through the
 $BE8E INC IX        ; picture.}
 $BE90 JR $BE93      ; Jump to #R$BE93 to store the picture byte.
@label=Print_RoomGraphic_BlankByte
*$BE92 XOR A         ; Use a blank byte.
@label=Print_RoomGraphic_StoreByte
*$BE93 LD (HL),A     ; Store the byte in the scanline buffer.
 $BE94 DJNZ $BE86    ; Repeat from #R$BE86 until the eight bits of this control
                     ; byte are used.
 $BE96 LD DE,$BB45   ; Take the finished scanline (#R$BB45).
 $BE99 CALL $0B03    ; Call #SKOOLKID$0B03(PO_FETCH).
 $BE9C CALL $0B7F    ; Call PR_ALL at #N($0B7F), part of
                     ; #SKOOLKID$0B24(PO_ANY).
 $BE9F CALL $0ADC    ; Call #SKOOLKID$0ADC(PO_STORE).
 $BEA2 POP BC        ; Restore the byte counter from the stack.
 $BEA3 DEC BC        ; Step the byte counter down.
 $BEA4 LD A,C        ; {Jump back to #R$BE79 until every picture byte has been
 $BEA5 OR B          ; drawn.
 $BEA6 JR NZ,$BE79   ; }
 $BEA8 CALL $0D4D    ; Call #SKOOLKID$0D4D(TEMPS).
 $BEAB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$AD06 }
; { #JEWELS$BAE1 }
; LIST#

; Colour Room Image
;
; Used by the routine at #R$BEB8.
; .
; Copy the #N$0200 attribute bytes that follow a picture into the screen.
;
; IX Pointer to the room attribute data
@label=Colour_RoomImage
c$BEAC LD DE,$5800   ; Point #REGde at the attribute file (#N$5800).
 $BEAF PUSH IX       ; {Copy the attribute pointer from #REGix into #REGhl.
 $BEB1 POP HL        ; }
 $BEB2 LD BC,$0200   ; {Copy #N$0200 attribute bytes onto the screen.
 $BEB5 LDIR          ; }
 $BEB7 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$AD54 }
; { #ANDROMEDA$6535 }
; { #JEWELS$BB2F }
; LIST#

; Print Room Image
;
; Used by the routine at #R$FB05.
; .
; Draw a room picture and then its colours.
;
; IX Pointer to room image data
;
; Draw the picture, then its colours.
@label=Print_RoomImage
c$BEB8 CALL $BE5E    ; Call #R$BE5E.
 $BEBB CALL $BEAC    ; Call #R$BEAC.
 $BEBE RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$AD60 }
; { #ANDROMEDA$6541 }
; { #JEWELS$BB3B }
; LIST#

; Clear Room Image
;
; Flood the picture's attribute area with the given colour.
;
; A Attribute byte value
@label=ClearRoomImage
c$BEBF LD BC,$0200   ; {Start at the attribute file and count #N$0200 bytes.
 $BEC2 LD HL,$5800   ; }
 $BEC5 LD E,A        ; Keep that attribute colour.
@label=ClearRoomImage_Loop
*$BEC6 LD (HL),E     ; {Write that colour through the picture attributes.
 $BEC7 INC HL        ;
 $BEC8 DEC BC        ;
 $BEC9 LD A,B        ;
 $BECA OR C          ; }
 $BECB JR NZ,$BEC6   ; Jump back to #R$BEC6 until the picture area is filled.
 $BECD RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$AD67 }
; { #ANDROMEDA$6548 }
; { #JEWELS$BB42 }
; LIST#

; Handler: Turn-Based Events
;
; Used by the routine at #R$EB10.
; .
; Count down the timed threats and, when one expires, run its handler.
@label=Handler_TurnBasedEvents
c$BECE LD A,($BA36)  ; {Jump to #R$BF00 when the event mask is zero.
 $BED1 OR A          ;
 $BED2 JR Z,$BF00    ; }
 $BED4 LD C,A        ; {Count the eight event bits, and skip a threat whose bit
 $BED5 LD B,$08      ; is clear.
@label=Handler_TurnBasedEvents_Loop
*$BED7 SRL C         ;
 $BED9 JR NC,$BEFE   ; }
 $BEDB LD DE,$0000   ; #REGde=#N($0000,$04,$04).
 $BEDE LD HL,$BA37   ; {Count this threat's timer down. Leave it alone while time
 $BEE1 LD A,$08      ; remains.
 $BEE3 SUB B         ;
 $BEE4 LD E,A        ;
 $BEE5 ADD HL,DE     ;
 $BEE6 DEC (HL)      ;
 $BEE7 JR NZ,$BEFE   ; }
 $BEE9 LD IX,($BADE) ; {Take this threat's handler.
 $BEED SLA E         ;
 $BEEF ADD IX,DE     ;
 $BEF1 LD L,(IX+$00) ;
 $BEF4 LD H,(IX+$01) ; }
 $BEF7 PUSH BC       ; {Keep the bit scan safe, return here, and jump to that
 $BEF8 LD DE,$BEFD   ; handler.
 $BEFB PUSH DE       ;
 $BEFC JP (HL)       ; }
 $BEFD POP BC        ; Restore the bit scan from the stack.
@label=Handler_TurnBasedEvents_Next
*$BEFE DJNZ $BED7    ; Repeat from #R$BED7 for the remaining event bits.
@label=Handler_TurnBasedEvents_Scenic
*$BF00 NOP           ; {Start at the scenic list. Jump to #R$BF40 when the scenic count is
 $BF01 LD HL,$BA48   ; zero.
 $BF04 LD A,($BB00)  ;
 $BF07 OR A          ;
 $BF08 JR Z,$BF40    ; }
 $BF0A LD B,A        ; {Start at the first scenic entry.
 $BF0B JR $BF0E      ; }
@label=Handler_TurnBasedEvents_ScenicAdvance
*$BF0D INC HL        ; Advance to the next scenic entry.
@label=Handler_TurnBasedEvents_ScenicSlot
*$BF0E LD A,(HL)     ; {Jump to #R$BF3E when this scenic slot is empty.
 $BF0F OR A          ;
 $BF10 JR Z,$BF3E    ; }
 $BF12 LD A,($BA9B)  ; {Jump to #R$BF3E when this event is already in the
 $BF15 CP (HL)       ; current room.
 $BF16 JR Z,$BF3E    ; }
 $BF18 PUSH HL       ; {Call #R$C0C3 to fetch this event's room list.
 $BF19 PUSH BC       ;
 $BF1A LD A,($BB00)  ;
 $BF1D SUB B         ;
 $BF1E LD E,A        ;
 $BF1F LD IX,$BA9C   ;
 $BF23 CALL $C0C3    ; }
 $BF26 LD A,($5C78)  ; {Use the frame counter as a step count and start at the first room in
 $BF29 LD B,A        ; the list.
 $BF2A LD A,$FF      ;
@label=Handler_TurnBasedEvents_RoomWalk
*$BF2C LD L,(IX+$00) ;
 $BF2F LD H,(IX+$01) ;
 $BF32 JR $BF35      ; }
@label=Handler_TurnBasedEvents_RoomStep
*$BF34 INC HL        ; Step to the next room in the list.
@label=Handler_TurnBasedEvents_RoomCheck
*$BF35 CP (HL)       ; {Jump back to #R$BF2C when the end marker matches.
 $BF36 JR Z,$BF2C    ; }
 $BF38 DJNZ $BF34    ; Repeat from #R$BF34 until the step count runs out.
 $BF3A LD A,(HL)     ; Take the room the walk landed on.
 $BF3B POP BC        ; {Restore the scenic counter and scenic entry pointer
 $BF3C POP HL        ; from the stack.}
 $BF3D LD (HL),A     ; Store that room back in this scenic slot.
@label=Handler_TurnBasedEvents_ScenicNext
*$BF3E DJNZ $BF0D    ; Repeat from #R$BF0D for the remaining scenic events.
@label=Handler_TurnBasedEvents_Return
*$BF40 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B373 }
; { #JEWELS$C17D }
; { #WARLORD$AB0A }
; LIST#

; Pause Loop
;
; Used by the routine at #R$C486.
; .
; Wait for the given number of frames.
;
; B Number of frames to wait
@label=Pause_Loop
c$BF41 HALT          ; Halt for one frame.
 $BF42 DJNZ $BF41    ; Repeat until those frames have passed.
 $BF44 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$AC65 }
; { #ANDROMEDA$65D2 }
; { #JEWELS$BB51 }
; { #WARLORD$A5C2 }
; { #SHOCK$9E2F }
; LIST#

; Generate Random Number
;
; Used by the routines at #R$EBAF, #R$EBCC, #R$EC99 and #R$F2DA.
; .
; Return a number between #N$00 and the limit passed in.
;
; O:A A random number derived from *#SKOOLKID$5C78(FRAMES)
@label=GenerateRandomNumber
c$BF45 PUSH BC       ; {Save the limit and take the low byte of
 $BF46 LD C,A        ; *#SKOOLKID$5C78(FRAMES) as the scramble.
 $BF47 LD A,($5C78)  ;
 $BF4A LD B,A        ;
 $BF4B LD A,C        ; }
@label=GenerateRandomNumber_Loop
*$BF4C DEC A         ; {Step the result down, wrapping to the limit when it
 $BF4D JR NZ,$BF50   ; passes zero.
 $BF4F LD A,C        ; }
@label=GenerateRandomNumber_Repeat
*$BF50 DJNZ $BF4C    ; Repeat that step once for each frame count.
 $BF52 DEC A         ; Step the result down once more, so the range starts at
                     ; zero.
 $BF53 POP BC        ; Restore the saved limit from the stack.
 $BF54 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B77F }
; { #ANDROMEDA$65D6 }
; { #JEWELS$C582 }
; { #WARLORD$B08A }
; { #SHOCK$AD25 }
; LIST#

; Handler: Update Object Location
;
; Used by the routines at #R$C2D8, #R$C2DF, #R$C2E8, #R$C48F, #R$EEED, #R$EEFC,
; #R$F045 and #R$F8AB.
; .
; Write a new location for an object, or for a scenic-event room.
;
; .
;
; Bit 7 selects the scenic-room list instead of the object table.
@label=UpdateObjectLocation
c$BF55 BIT 7,B       ; {Jump to #R$BF60 for an ordinary object.
 $BF57 JR Z,$BF60    ; }
 $BF59 RES 7,B       ; {Clear that bit and use the scenic list (#R$BA48).
 $BF5B LD HL,$BA48   ; }
 $BF5E JR $BF63      ; Jump to #R$BF63 to write the location.
@label=UpdateObjectLocation_Objects
*$BF60 LD HL,$B9C8   ; Look up the object locations (#R$B9C8).
@label=UpdateObjectLocation_Write
*$BF63 LD D,$00      ; {Write the new location.
 $BF65 LD E,B        ;
 $BF66 ADD HL,DE     ;
 $BF67 LD (HL),C     ; }
 $BF68 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ANDROMEDA$65E6 }
; { #JEWELS$C412 }
; LIST#

; Is Object Present?
;
; Used by the routine at #R$C0F9.
; .
; Report whether this object occurs anywhere in the location table.
@label=IsObjectPresent
c$BF69 LD BC,($BAF8) ; {Search the object locations at #R$B9C8 for this object.
 $BF6D LD HL,$B9C8   ;
 $BF70 CPIR          ; }
 $BF72 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ANDROMEDA$65FA }
; LIST#

; Handler: User Input
;
; Used by the routines at #R$C0B4 and #R$EB10.
; .
; Read a line of text, then turn it into vocabulary tokens.
;
; .
;
; Reset the cursor to the top of the text window.
@label=Handler_UserInput
c$BF73 CALL $BDFC    ; Call #R$BDFC to park the cursor at the top of the text.
; Clear the command buffer.
 $BF76 LD HL,$BB04   ; Start at the command buffer (#R$BB04).
 $BF79 LD A,$20      ; {Prepare a space (#N$20) and a counter of #N$32 bytes.
 $BF7B LD B,$32      ; }
@label=UserInput_Clear
*$BF7D LD (HL),A     ; {Write spaces through the whole command buffer.
 $BF7E INC HL        ;
 $BF7F DJNZ $BF7D    ; }
; Print the "&gt;" prompt.
 $BF81 CALL $C3C0    ; Call #R$C3C0.
; Collect keypresses.
 $BF84 LD HL,$BB04   ; Start again at the beginning of the command.
; Wait for the next key.
@label=UserInput_Loop
*$BF87 CALL $BDDA    ; Call #R$BDDA.
; DELETE rubs out a character. ENTER finishes the line. Any other control key
; is ignored.
 $BF8A CP $0C        ; {Jump to #R$BFAA if DELETE was pressed.
 $BF8C JR Z,$BFAA    ; }
 $BF8E CP $0D        ; {Jump to #R$BFC1 if ENTER was pressed.
 $BF90 JR Z,$BFC1    ; }
 $BF92 CP $20        ; {Jump back to #R$BF87 when the key is below SPACE.
 $BF94 JR C,$BF87    ; }
; Is the command buffer full?
 $BF96 EX DE,HL      ; {Jump back to #R$BF87 once the pointer has reached the
 $BF97 LD HL,$BB35   ; sentinel at #R$BB35.
 $BF9A AND A         ;
 $BF9B SBC HL,DE     ;
 $BF9D EX DE,HL      ;
 $BF9E JR Z,$BF87    ; }
; The key is valid, so store it and print it.
 $BFA0 LD (HL),A     ; Write the key into the command buffer.
 $BFA1 CALL $BE13    ; Call #R$BE13 to select the screen channel.
 $BFA4 CALL $BE37    ; Call #R$BE37 to echo the key.
 $BFA7 INC HL        ; Advance to the next space in the buffer.
 $BFA8 JR $BF87      ; Jump back to #R$BF87 for the next key.
; The player pressed DELETE.
@label=UserInput_Delete
*$BFAA EX DE,HL      ; {Jump back to #R$BF87 when the buffer is still empty.
 $BFAB LD HL,$BB04   ;
 $BFAE AND A         ;
 $BFAF SBC HL,DE     ;
 $BFB1 EX DE,HL      ;
 $BFB2 JR Z,$BF87    ; }
; Rub the previous character off the screen.
 $BFB4 PUSH HL       ; Keep the buffer pointer safe.
 $BFB5 LD HL,$BB58   ; {Print "#MESSAGE$BB58".
 $BFB8 CALL $BE21    ; }
 $BFBB POP HL        ; Restore the buffer pointer from the stack.
 $BFBC DEC HL        ; {Step back one character and blank it.
 $BFBD LD (HL),$20   ; }
 $BFBF JR $BF87      ; Jump back to #R$BF87 for the next key.
; The player pressed ENTER, so close the command and clear the tokens.
@label=UserInput_Enter
*$BFC1 LD (HL),A     ; Store ENTER as the end of the command.
 $BFC2 CALL $BE13    ; Call #R$BE13 to select the screen channel.
 $BFC5 CALL $BE37    ; Call #R$BE37 to echo ENTER.
 $BFC8 LD HL,$BB36   ; {Start at the token buffer (#R$BB36) and prepare the empty marker
 $BFCB LD A,$FF      ; #N$FF.
 $BFCD LD B,$0A      ; }
@label=UserInput_ClearTokens
*$BFCF LD (HL),A     ; {Write #N$FF into each of the #N$0A token slots.
 $BFD0 INC HL        ;
 $BFD1 DJNZ $BFCF    ; }
 $BFD3 LD HL,$BB04   ; {Start at the command and allow #N$0A words, then fall into the
 $BFD6 LD C,$0A      ; parser.}
; View the equivalent code in;
; #LIST
; { #HEROES$B200 }
; { #ANDROMEDA$6604 }
; { #JEWELS$C00A }
; LIST#

; Parser: Match Input Word
;
; Split the command into words and look each one up in the vocabulary.
;
; .
;
; Blank the four-character word buffer.
@label=Parser_MatchInputWord
c$BFD8 LD DE,$BB41   ; Start at the word buffer (#R$BB41).
 $BFDB LD B,$04      ; {Prepare a space and a counter of #N$04 characters.
 $BFDD LD A,$20      ; }
@label=MatchInputWord_Clear
*$BFDF LD (DE),A     ; {Write spaces through the word buffer.
 $BFE0 INC DE        ;
 $BFE1 DJNZ $BFDF    ; }
 $BFE3 XOR A         ; {Jump to #R$C0B4 when no token slots remain, or the
 $BFE4 OR C          ; command has ended.
 $BFE5 JP Z,$C0B4    ;
 $BFE8 LD A,(HL)     ;
 $BFE9 CP $0D        ;
 $BFEB JP Z,$C0B4    ; }
; Copy the next word, up to #N$04 characters, stopping at a space, a comma or
; ENTER.
 $BFEE LD B,$04      ; {Copy up to #N$04 characters into the word buffer.
 $BFF0 LD DE,$BB41   ; }
@label=MatchInputWord_Copy
*$BFF3 LD A,(HL)     ; {Jump to #R$C01F when the character is ENTER.
 $BFF4 CP $0D        ;
 $BFF6 JR Z,$C01F    ; }
 $BFF8 CP $20        ; {Jump to #R$C015 when the character is a space or a
 $BFFA JR Z,$C015    ; comma.
 $BFFC CP $2C        ;
 $BFFE JR Z,$C015    ; }
 $C000 LD (DE),A     ; {Copy the character into the word buffer and advance
 $C001 INC HL        ; both pointers.
 $C002 INC DE        ; }
 $C003 DJNZ $BFF3    ; Repeat from #R$BFF3 until four characters have been
                     ; copied.
; A longer word is skipped up to the next delimiter.
@label=MatchInputWord_Skip
*$C005 LD A,(HL)     ; {Jump to #R$C01F on ENTER, or to #R$C015 on a space or a
 $C006 CP $0D        ; comma.
 $C008 JR Z,$C01F    ;
 $C00A CP $20        ;
 $C00C JR Z,$C015    ;
 $C00E CP $2C        ;
 $C010 JR Z,$C015    ; }
 $C012 INC HL        ; {Skip this character and keep looking for a delimiter.
 $C013 JR $C005      ; }
@label=MatchInputWord_Delimiter
*$C015 INC HL        ; {Skip consecutive spaces and commas.
 $C016 LD A,(HL)     ;
 $C017 CP $20        ;
 $C019 JR Z,$C015    ;
 $C01B CP $2C        ;
 $C01D JR Z,$C015    ; }
; Ignore the word "THE ".
@label=MatchInputWord_IgnoreThe
*$C01F EXX           ; {Switch in the spare registers and point them at "THE "
 $C020 LD HL,$BB5C   ; and the word.
 $C023 LD DE,$BB41   ;
 $C026 LD B,$04      ; }
@label=MatchInputWord_The
*$C028 LD A,(DE)     ; {Compare the four characters.
 $C029 CP (HL)       ;
 $C02A JR NZ,$C030   ;
 $C02C INC DE        ;
 $C02D INC HL        ;
 $C02E DJNZ $C028    ; }
@label=MatchInputWord_AfterThe
*$C030 EXX           ; Switch back to the main registers to act on the
                     ; comparison.
 $C031 JR Z,$BFD8    ; Jump back to #R$BFD8 when the word was THE, so it is not
                     ; tokenised.
 $C033 DEC C         ; {Use up one token slot.
 $C034 EXX           ; }
; Look the word up in the vocabulary. A comma separates synonyms.
 $C035 LD HL,($BADC) ; {Start at the vocabulary, with the token index at zero.
 $C038 LD C,$00      ; }
@label=MatchInputWord_Vocabulary
*$C03A LD A,(HL)     ; {Jump to #R$C06C when the vocabulary is exhausted.
 $C03B CP $FF        ;
 $C03D JR Z,$C06C    ; }
@label=MatchInputWord_CompareWord
*$C03F LD DE,$BB41   ; {Compare the next vocabulary word with the word buffer.
 $C042 LD B,$04      ; }
@label=MatchInputWord_CompareChar
*$C044 LD A,(DE)     ; {Compare the next character.
 $C045 CP (HL)       ; }
 $C046 JR NZ,$C05D   ; {Jump to #R$C05D when it does not match.
 $C048 INC DE        ;
 $C049 INC HL        ;
 $C04A DJNZ $C044    ; }
 $C04C EXX           ; {Turn the vocabulary index into a token-slot offset.
 $C04D LD A,$09      ;
 $C04F SUB C         ;
 $C050 EXX           ;
 $C051 LD D,$00      ;
 $C053 LD E,A        ; }
 $C054 LD HL,$BB36   ; {Store that token in its slot at #R$BB36 and parse the
 $C057 ADD HL,DE     ; next word.
 $C058 LD (HL),C     ;
 $C059 EXX           ;
 $C05A JP $BFD8      ; }
@label=MatchInputWord_NextWord
*$C05D LD E,B        ; {Step to the end of this vocabulary word.
 $C05E LD D,$00      ;
 $C060 ADD HL,DE     ; }
 $C061 LD A,(HL)     ; {Jump back to #R$C03F to try the synonym after a comma.
 $C062 CP $2C        ;
 $C064 JR NZ,$C069   ;
 $C066 INC HL        ;
 $C067 JR $C03F      ; }
@label=MatchInputWord_NextEntry
*$C069 INC C         ; {Try the next vocabulary word.
 $C06A JR $C03A      ; }
; The word is not in the vocabulary, so quote it and ask again.
@label=MatchInputWord_Unknown
*$C06C EXX           ; {Find the unknown word in the command buffer.
 $C06D LD A,$0A      ;
 $C06F SUB C         ;
 $C070 LD C,A        ;
 $C071 LD HL,$BB04   ; }
@label=MatchInputWord_SeekWord
*$C074 DEC C         ; {Step back through the copied word count.
 $C075 JR Z,$C08F    ; }
@label=MatchInputWord_FindWord
*$C077 LD A,(HL)     ; {Skip characters until a space or a comma.
 $C078 CP $20        ;
 $C07A JR Z,$C083    ;
 $C07C CP $2C        ;
 $C07E JR Z,$C083    ;
 $C080 INC HL        ;
 $C081 JR $C077      ; }
@label=MatchInputWord_FindDelimiter
*$C083 INC HL        ; {Skip spaces and commas, then look for the next word.
 $C084 LD A,(HL)     ;
 $C085 CP $20        ;
 $C087 JR Z,$C083    ;
 $C089 CP $2C        ;
 $C08B JR Z,$C083    ;
 $C08D JR $C074      ; }
@label=MatchInputWord_PrintUnknown
*$C08F PUSH HL       ; {Print "#MESSAGE$BB75".
 $C090 LD HL,$BB75   ;
 $C093 CALL $BE2E    ; }
 $C096 POP HL        ; Restore the command pointer from the stack.
 $C097 LD A,$22      ; {Print a quote.
 $C099 CALL $BE37    ; }
@label=MatchInputWord_Quote
*$C09C LD A,(HL)     ; {Print the unknown word up to the next space.
 $C09D CP $21        ;
 $C09F JR C,$C0A7    ;
 $C0A1 INC HL        ;
 $C0A2 CALL $BE37    ;
 $C0A5 JR $C09C      ; }
@label=MatchInputWord_CloseQuote
*$C0A7 LD A,$22      ; {Print a closing quote.
 $C0A9 CALL $BE37    ; }
 $C0AC LD HL,$BCF9   ; {Print "#MESSAGE$BCF9" and read another command.
 $C0AF CALL $BE2E    ;
 $C0B2 JR $C0C0      ; }
; View the equivalent code in;
; #LIST
; { #HEROES$B24E }
; { #ANDROMEDA$6669 }
; { #JEWELS$C058 }
; LIST#

; Handler: Unknown Word
;
; Used by the routine at #R$BFD8.
; .
; Say "I don't understand" when the first token was never filled in.
@label=Handler_UnknownWord
c$C0B4 LD A,($BB36)  ; {Return when the first token was recognised.
 $C0B7 CP $FF        ;
 $C0B9 RET NZ        ; }
 $C0BA LD HL,$BB61   ; {Print "#MESSAGE$BB61".
 $C0BD CALL $BE2E    ; }
; This entry point is used by the routine at #R$BFD8.
@label=Handler_UnknownWord_Retry
*$C0C0 JP $BF73      ; Jump to #R$BF73 to read another command.
; View the equivalent code in;
; #LIST
; { #HEROES$B364 }
; { #ANDROMEDA$6745 }
; LIST#

; Get Table Entry
;
; Used by the routines at #R$BECE, #R$C0D2, #R$C0F9, #R$C213, #R$C3FA and
; #R$C463.
; .
; Fetch one address from a table of addresses.
;
;   E Index of the entry
;   IX Base table address
; O:HL Address from the table entry
; O:IX Address of the table entry
@label=GetTableEntry
c$C0C3 LD D,$00      ; {Double the index and add it to the table.
 $C0C5 SLA E         ;
 $C0C7 RL D          ;
 $C0C9 ADD IX,DE     ; }
 $C0CB LD L,(IX+$00) ; {Copy that address out of the table.
 $C0CE LD H,(IX+$01) ; }
 $C0D1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B3F1 }
; { #ANDROMEDA$6754 }
; { #JEWELS$C1F0 }
; { #WARLORD$AB88 }
; { #SHOCK$A305 }
; LIST#

; Print Objects
;
; Used by the routines at #R$C0F9 and #R$EDE8.
; .
; Print every object in the given place.
@label=PrintObjects
c$C0D2 LD HL,$B9C8   ; {Look up the object locations.
 $C0D5 LD BC,($BAF8) ; }
@label=PrintObjects_Loop
*$C0D9 CPIR          ; {Return if the search did not find a match.
 $C0DB RET NZ        ; }
 $C0DC PUSH AF       ; {Keep the search and turn the match into an object
 $C0DD PUSH HL       ; index.
 $C0DE PUSH BC       ;
 $C0DF LD A,($BAF8)  ;
 $C0E2 SUB C         ;
 $C0E3 DEC A         ;
 $C0E4 LD E,A        ; }
 $C0E5 LD IX,($BAE2) ; {Call #R$C0C3 to fetch this object's description.
 $C0E9 CALL $C0C3    ; }
 $C0EC CALL $BE2E    ; Call #R$BE2E to print the description and start a new
                     ; line.
 $C0EF POP BC        ; {Restore the search from the stack.
 $C0F0 POP HL        ;
 $C0F1 POP AF        ; }
 $C0F2 LD E,A        ; {Look for another object here.
 $C0F3 LD A,B        ;
 $C0F4 OR C          ;
 $C0F5 LD A,E        ;
 $C0F6 JR NZ,$C0D9   ; }
 $C0F8 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B400 }
; { #ANDROMEDA$6763 }
; { #JEWELS$C1FF }
; { #WARLORD$AB97 }
; { #SHOCK$A314 }
; LIST#

; Handler: Display Room
;
; Used by the routines at #R$C380, #R$ECB6 and #R$EE05.
; .
; On the first visit, show the picture and the long description, then list what
; is here and which ways lead out.
@label=Handler_DisplayRoom
c$C0F9 PUSH DE       ; Keep #REGde safe on the stack.
 $C0FA CALL $BDEA    ; Call #R$BDEA to clear the screen.
 $C0FD POP DE        ; Restore #REGde from the stack.
 $C0FE LD A,($BAFE)  ; {Jump to #R$C14F when room descriptions are switched
 $C101 OR A          ; off.
 $C102 JR Z,$C14F    ; }
 $C104 LD A,($BA9B)  ; {Search the picture list for this room. Jump to #R$C14F when it has
 $C107 LD HL,($BAE4) ; no picture.
 $C10A LD BC,($BAFE) ;
 $C10E CPIR          ;
 $C110 JR NZ,$C14F   ; }
 $C112 LD A,($BAFE)  ; {Jump to #R$C138 when this visit should show the
 $C115 INC C         ; picture.
 $C116 SUB C         ;
 $C117 LD C,A        ;
 $C118 XOR A         ;
 $C119 OR E          ;
 $C11A JR NZ,$C138   ; }
 $C11C LD HL,$BA30   ; {Find this room's visited flag.
 $C11F LD A,C        ;
@label=Handler_DisplayRoom_Loop
*$C120 CP $08        ;
 $C122 JR C,$C129    ; }
 $C124 SUB $08       ; {This room's flag is in the next flag byte.
 $C126 INC HL        ;
 $C127 JR $C120      ; }
@label=Handler_DisplayRoom_Next
*$C129 LD B,A        ; {Turn that bit number into a flag mask.
 $C12A INC B         ;
 $C12B LD D,$00      ;
@label=Handler_DisplayRoom_FlagBit
*$C12D RL D          ;
 $C12F DJNZ $C12D    ; }
 $C131 LD A,(HL)     ; {Jump to #R$C14F when this room has already been
 $C132 AND D         ; visited.
 $C133 JR NZ,$C14F   ; }
 $C135 LD A,(HL)     ; {Mark this room as visited.
 $C136 OR D          ;
 $C137 LD (HL),A     ; }
@label=Handler_DisplayRoom_FirstVisit
*$C138 LD A,$08      ; {Remember that the long description was shown, and set the text row
 $C13A LD ($BB40),A  ; to #N$08.
 $C13D LD HL,$BA2C   ;
 $C140 SET 0,(HL)    ; }
 $C142 LD IX,($BAE6) ; {Call #R$C0C3 to fetch this room's picture handler.
 $C146 LD E,C        ;
 $C147 CALL $C0C3    ; }
@nowarn
 $C14A LD DE,$C14F   ; {Return to #R$C14F afterwards and jump to that handler.
 $C14D PUSH DE       ;
 $C14E JP (HL)       ; }
@label=Handler_DisplayRoom_PrintDescription
*$C14F CALL $BE06    ; Call #R$BE06 to move the cursor to the text line stored
                     ; at #R$BB40.
 $C152 LD A,$18      ; {Set the text row to #N($18), under the picture.
 $C154 LD ($BB40),A  ; }
 $C157 LD A,($BA9B)  ; {Call #R$C0C3 to fetch this room's long description.
 $C15A LD IX,($BAE8) ;
 $C15E LD E,A        ;
 $C15F CALL $C0C3    ; }
 $C162 CALL $BE2E    ; Call #R$BE2E to print the room description and start a
                     ; new line.
 $C165 LD HL,$BA2C   ; {Skip the key-wait unless the long description was just
 $C168 BIT 0,(HL)    ; shown.
 $C16A JR Z,$C171    ; }
 $C16C RES 0,(HL)    ; {Clear that flag and wait for a key.
 $C16E CALL $BDDA    ; }
@label=Handler_DisplayRoom_ListExits
*$C171 CALL $C201    ; Call #R$C201 to fetch this room's six exits.
 $C174 LD D,H        ; {Count how many of the six exits leave this room.
 $C175 LD E,L        ;
 $C176 LD B,$06      ;
 $C178 LD C,$00      ;
 $C17A XOR A         ;
@label=Handler_DisplayRoom_CountExits
*$C17B CP (HL)       ;
 $C17C JR Z,$C17F    ;
 $C17E INC C         ;
@label=Handler_DisplayRoom_CountNext
*$C17F INC HL        ;
 $C180 DJNZ $C17B    ; }
 $C182 OR C          ; {Jump to #R$C1ED when there are no exits.
 $C183 JR Z,$C1ED    ; }
 $C185 LD A,C        ; {Jump to #R$C1AC when more than one exit is open.
 $C186 CP $01        ;
 $C188 JR NZ,$C1AC   ; }
 $C18A LD HL,$BBBC   ; {Print "#MESSAGE$BBBC".
 $C18D CALL $BE21    ; }
 $C190 LD H,D        ; {Point back at the exits and the direction names for the
 $C191 LD L,E        ; one way out.
 $C192 LD IX,$BDB2   ;
 $C196 XOR A         ;
 $C197 JR $C19E      ; }
@label=Handler_DisplayRoom_SkipClosed
*$C199 INC HL        ; {Skip a closed exit and move on to the next way out.
 $C19A INC IX        ;
 $C19C INC IX        ;
@label=Handler_DisplayRoom_OneExit
*$C19E CP (HL)       ;
 $C19F JR Z,$C199    ; }
 $C1A1 LD L,(IX+$00) ; {Call #R$BE21 to print the direction name.
 $C1A4 LD H,(IX+$01) ;
 $C1A7 CALL $BE21    ; }
 $C1AA JR $C1E7      ; Jump to #R$C1E7 to finish the exit sentence.
@label=Handler_DisplayRoom_ManyExits
*$C1AC LD HL,$BBA9   ; {Print "#MESSAGE$BBA9".
 $C1AF CALL $BE2E    ; }
 $C1B2 LD H,D        ; {Point back at the exits and the direction names.
 $C1B3 LD L,E        ;
 $C1B4 LD IX,$BDB2   ;
 $C1B8 XOR A         ;
 $C1B9 JR $C1C1      ; }
@label=Handler_DisplayRoom_NextExit
*$C1BB EX DE,HL      ; {Exchange the exit list back into #REGhl and step to the
@label=Handler_DisplayRoom_StepExit
*$C1BC INC HL        ; next open way out.
 $C1BD INC IX        ;
 $C1BF INC IX        ;
@label=Handler_DisplayRoom_ExitOpen
*$C1C1 CP (HL)       ;
 $C1C2 JR Z,$C1BC    ; }
 $C1C4 EX DE,HL      ; {Call #R$BE21 to print the direction name.
 $C1C5 LD L,(IX+$00) ;
 $C1C8 LD H,(IX+$01) ;
 $C1CB CALL $BE21    ; }
 $C1CE DEC C         ; {Jump to #R$C1E7 when no exits remain.
 $C1CF LD A,C        ;
 $C1D0 CP $01        ;
 $C1D2 JR C,$C1E7    ; }
 $C1D4 JR Z,$C1DE    ; Jump to #R$C1DE to join the last exit with "and".
 $C1D6 LD A,$2C      ; {Print a comma between the exits.
 $C1D8 CALL $BE37    ; }
 $C1DB XOR A         ; {Jump back to #R$C1BB for the next exit.
 $C1DC JR $C1BB      ; }
@label=Handler_DisplayRoom_And
*$C1DE LD HL,$BBA5   ; {Print "#MESSAGE$BBA5".
 $C1E1 CALL $BE21    ; }
 $C1E4 XOR A         ; {Jump back to #R$C1BB for the next exit.
 $C1E5 JR $C1BB      ; }
@label=Handler_DisplayRoom_FullStop
*$C1E7 LD HL,$BCF9   ; {Print "#MESSAGE$BCF9".
 $C1EA CALL $BE2E    ; }
@label=Handler_DisplayRoom_ListObjects
*$C1ED LD A,($BA9B)  ; {Call #R$BF69 to see whether this room holds anything. Return when it
 $C1F0 CALL $BF69    ; does not.
 $C1F3 RET NZ        ; }
 $C1F4 LD HL,$BB96   ; {Print "#MESSAGE$BB96".
 $C1F7 CALL $BE2E    ; }
 $C1FA LD A,($BA9B)  ; {Call #R$C0D2 to list what is in this room.
 $C1FD CALL $C0D2    ; }
 $C200 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B46B }
; { #ANDROMEDA$678A }
; { #JEWELS$C26A }
; { #WARLORD$AC02 }
; LIST#

; Get Room Pointer
;
; Used by the routines at #R$C0F9 and #R$EE23.
; .
; Fetch the six exit bytes for the current room.
@label=GetRoomPointer
c$C201 LD A,($BA9B)  ; {Fetch the current room into #REGde.
 $C204 LD E,A        ;
 $C205 LD D,$00      ; }
 $C207 LD HL,$0006   ; #REGhl=#N($0006,$04,$04).
 $C20A CALL $30A9    ; Call #SKOOLKID$30A9(HL_MULT_DE).
 $C20D LD DE,($BAE0) ; {Add the table base to the offset.
 $C211 ADD HL,DE     ; }
 $C212 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ANDROMEDA$6892 }
; LIST#

; Parser: Resolve Phrase
;
; Used by the routine at #R$C3DC.
; .
; Turn a matched word into an object name, or say it cannot be seen.
@label=Parser_ResolvePhrase
c$C213 INC BC        ; {Scan the phrase list for the end marker.
 $C214 LD A,($BAFA)  ;
 $C217 SUB C         ;
 $C218 LD B,A        ;
 $C219 LD E,A        ;
 $C21A LD A,$FE      ;
 $C21C LD HL,($BAEA) ;
 $C21F INC B         ;
 $C220 JR $C227      ; }
@label=Parser_ResolvePhrase_Loop
*$C222 INC HL        ; Step to the next byte of the phrase.
@label=Parser_ResolvePhrase_SkipMarker
*$C223 INC HL        ; {Keep skipping while this byte is the marker being
 $C224 CP (HL)       ; sought.
 $C225 JR Z,$C222    ; }
@label=Parser_ResolvePhrase_Next
*$C227 DJNZ $C223    ; Repeat from #R$C223 until the phrase list is finished.
 $C229 JR $C22C      ; Jump to #R$C22C to test the first object.
@label=Parser_ResolvePhrase_NextObject
*$C22B INC HL        ; Step to the next object in the phrase.
@label=Parser_ResolvePhrase_TestObject
*$C22C LD A,(HL)     ; {Return when this object is in this room.
 $C22D CALL $C24F    ;
 $C230 RET Z         ; }
 $C231 INC HL        ; {Jump back to #R$C22B when the end of a phrase matches.
 $C232 LD A,(HL)     ;
 $C233 CP $FE        ;
 $C235 JR Z,$C22B    ; }
 $C237 LD HL,$BBED   ; {Print "#MESSAGE$BBED".
 $C23A CALL $BE21    ; }
 $C23D LD IX,($BAEC) ; {Call #R$C0C3 to look up the object's name.
 $C241 CALL $C0C3    ; }
 $C244 CALL $BE21    ; Call #R$BE21 to print the name.
 $C247 LD HL,$BBFA   ; {Print "#MESSAGE$BBFA".
 $C24A CALL $BE2E    ; }
 $C24D SCF           ; Set the carry flag to reject the command.
 $C24E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B52B }
; { #ANDROMEDA$68A4 }
; { #JEWELS$C32A }
; { #WARLORD$AE36 }
; { #SHOCK$A591 }
; LIST#

; Is Object In The Current Room?
;
; Used by the routines at #R$C213, #R$C2EF, #R$EB4C, #R$EB68, #R$EB78, #R$EB88,
; #R$EB98, #R$ECB6, #R$EDC3, #R$EE3D, #R$EEFC, #R$F045, #R$F190, #R$F216,
; #R$F30B, #R$F48B, #R$F516, #R$F55C, #R$F5C2, #R$F665, #R$F6FD, #R$F71B,
; #R$F7C2, #R$F824, #R$F869 and #R$F8E4.
; .
; Set the zero flag when this object is in this room or in the scenic list.
;
;   A Object number
; O:F Zero flag set when the object is in the current room
@label=IsObjectInCurrentRoom
c$C24F PUSH HL       ; {Jump to #R$C25D when this is a scenic entry rather than
 $C250 PUSH DE       ; an object.
 $C251 LD E,A        ;
 $C252 LD D,$00      ;
 $C254 BIT 7,E       ;
 $C256 JR NZ,$C25D   ; }
 $C258 LD HL,$B9C8   ; {Use the object locations and join the room test.
 $C25B JR $C262      ; }
@label=IsObjectInCurrentRoom_Next
*$C25D RES 7,E       ; {Clear the scenic marker and use the scenic list.
 $C25F LD HL,$BA48   ; }
@label=IsObjectInCurrentRoom_Compare
*$C262 ADD HL,DE     ; {Jump to #R$C26C when the object is in the current room.
 $C263 LD A,($BA9B)  ;
 $C266 CP (HL)       ;
 $C267 JR Z,$C26C    ; }
 $C269 LD A,$01      ; {Treat a carried object as present.
 $C26B CP (HL)       ; }
@label=IsObjectInCurrentRoom_Found
*$C26C POP DE        ; {Restore #REGde and #REGhl from the stack.
 $C26D POP HL        ; }
 $C26E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B560 }
; { #ANDROMEDA$68E0 }
; { #JEWELS$C35F }
; { #WARLORD$AE6B }
; { #SHOCK$A5C6 }
; LIST#

; Parser: Advance To Separator
;
; Used by the routines at #R$EE3D, #R$EEFC, #R$F045, #R$F190, #R$F216, #R$F26D,
; #R$F292, #R$F30B, #R$F48B, #R$F516, #R$F55C, #R$F5C2, #R$F5F1, #R$F665,
; #R$F68C, #R$F6FD, #R$F71B, #R$F79D, #R$F7C2, #R$F7EB, #R$F804, #R$F824,
; #R$F869, #R$F8AB, #R$F8E4 and #R$F916.
; .
; Walk a phrase from the word list. The zero flag is set when the typed words
; match it.
@label=Parser_AdvanceToSeparator
c$C26F EX DE,HL      ; {Hand the typed tokens to the phrase walk.
 $C270 JR $C273      ; }
@label=Parser_AdvanceToSeparator_Loop
*$C272 INC DE        ; Advance to the next byte.
@label=Parser_AdvanceToSeparator_Next
*$C273 LD HL,$BB37   ; {Compare against the typed tokens.
 $C276 JR $C27A      ; }
@label=Parser_AdvanceToSeparator_Match
*$C278 INC HL        ; {Advance through both phrases while the characters still
 $C279 INC DE        ; match.
@label=Parser_AdvanceToSeparator_Compare
*$C27A LD A,(DE)     ;
 $C27B CP (HL)       ;
 $C27C JR Z,$C278    ; }
 $C27E CP $FE        ; {Jump to #R$C286 unless the end of a phrase matches.
 $C280 JR NZ,$C286   ; }
 $C282 LD A,(HL)     ; {Fetch the next phrase byte and test for the end marker.
 $C283 CP $FF        ; }
 $C285 RET           ; Return.
@label=Parser_AdvanceToSeparator_Alt
*$C286 CP $FD        ; {Jump to #R$C290 unless the alternative in a phrase
 $C288 JR NZ,$C290   ; matches.}
 $C28A LD A,(HL)     ; {Jump back to #R$C272 if the end-of-list marker was not
 $C28B CP $FF        ; pressed.
 $C28D JR NZ,$C272   ; }
 $C28F RET           ; Return.
@label=Parser_AdvanceToSeparator_SkipAlt
*$C290 INC DE        ; {Jump to #R$C29C when the end of a phrase matches.
 $C291 LD A,(DE)     ;
 $C292 CP $FE        ;
 $C294 JR Z,$C29C    ; }
 $C296 CP $FD        ; {Jump back to #R$C290 unless the alternative in a phrase
 $C298 JR NZ,$C290   ; matches.}
 $C29A JR $C272      ; Jump back to #R$C272 to try the phrase's other wording.
@label=Parser_AdvanceToSeparator_Done
*$C29C OR A          ; Clear the carry flag; the phrase matched.
 $C29D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B575 }
; { #ANDROMEDA$6900 }
; { #JEWELS$C37F }
; { #WARLORD$AE80 }
; { #SHOCK$A5DB }
; LIST#

; Parser: Find Phrase
;
; Used by the routines at #R$C309 and #R$C31E.
; .
; Count how many of the typed tokens are real nouns.
@label=Parser_FindPhrase
c$C29E LD HL,$BB36   ; {Start at the token buffer.
 $C2A1 LD B,$0A      ;
 $C2A3 LD E,$00      ; }
@label=Parser_FindPhrase_Loop
*$C2A5 LD A,(HL)     ; {Jump to #R$C2BB if the end-of-list marker was pressed.
 $C2A6 CP $FF        ;
 $C2A8 JR Z,$C2BB    ; }
 $C2AA EXX           ; {Jump to #R$C2B8 if the search did not find a match.
 $C2AB LD HL,($BAEE) ;
 $C2AE LD BC,($BAFA) ;
 $C2B2 CPIR          ;
 $C2B4 EXX           ;
 $C2B5 JR NZ,$C2B8   ; }
 $C2B7 INC E         ; Count one more match.
@label=Parser_FindPhrase_Next
*$C2B8 INC HL        ; {Repeat from #R$C2A5 for the remaining tokens.
 $C2B9 DJNZ $C2A5    ; }
@label=Parser_FindPhrase_Done
*$C2BB XOR A         ; {Test whether #REGe is zero.
 $C2BC OR E          ; }
 $C2BD RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B5A4 }
; { #ANDROMEDA$692F }
; { #JEWELS$C3AE }
; { #WARLORD$AEAF }
; { #SHOCK$A60A }
; LIST#

; Get Object Location
;
; Used by the routines at #R$C2D2, #R$C48F, #R$EDC3, #R$F190, #R$F8AB and
; #R$F916.
; .
; Return where this object is. #N$01 means it is being carried.
;
;   A Object number
; O:A Location of the object
@label=GetObjectLocation
c$C2BE LD E,A        ; {Jump to #R$C2CA when this is a scenic entry rather than
 $C2BF LD D,$00      ; an object.
 $C2C1 BIT 7,A       ;
 $C2C3 JR NZ,$C2CA   ; }
 $C2C5 LD HL,$B9C8   ; {Use the object locations and join the lookup.
 $C2C8 JR $C2CF      ; }
@label=GetObjectLocation_Next
*$C2CA LD HL,$BA48   ; {Clear the scenic marker and use the scenic list.
 $C2CD RES 7,E       ; }
@label=GetObjectLocation_Index
*$C2CF ADD HL,DE     ; {Add the index to the base address.
 $C2D0 LD A,(HL)     ; }
 $C2D1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B5C6 }
; { #ANDROMEDA$694F }
; { #JEWELS$C3D0 }
; { #WARLORD$AED1 }
; { #SHOCK$A62C }
; LIST#

; Is Object Carried?
;
; Used by the routines at #R$EC5F, #R$ECB6, #R$EEBA, #R$EEFC, #R$F045, #R$F216,
; #R$F26D, #R$F2AE, #R$F2C7, #R$F79D, #R$F824, #R$F8E4 and #R$F916.
; .
; Set the zero flag when this object is being carried.
@label=IsObjectCarried
c$C2D2 CALL $C2BE    ; Call #R$C2BE to fetch where the object is.
 $C2D5 CP $01        ; Compare the location with #N$01 (carried).
 $C2D7 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ANDROMEDA$6958 }
; LIST#

; Handler: Destroy Item
;
; Used by the routines at #R$EB4C, #R$EBE9, #R$EBFB, #R$EC13, #R$EC2B, #R$EC3D,
; #R$EC5F, #R$ECB6, #R$EEFC, #R$F045, #R$F216, #R$F26D, #R$F30B, #R$F824 and
; #R$F869.
; .
; Destroy an object by giving it location #N$00.
@label=Handler_DestroyItem
c$C2D8 LD B,A        ; {Call #R$BF55 to destroy the object.
 $C2D9 LD C,$00      ;
 $C2DB CALL $BF55    ; }
 $C2DE RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B5D5 }
; { #JEWELS$C3EA }
; { #WARLORD$AEE0 }
; { #SHOCK$A63B }
; LIST#

; Handler: Update Item For The Current Room
;
; Used by the routines at #R$C42F, #R$EB4C, #R$EC5F, #R$ECB6, #R$F216 and
; #R$F824.
; .
; Put an object down in the room the player is standing in.
@label=Handler_UpdateItemForTheCurrentRoom
c$C2DF LD B,A        ; {Call #R$BF55 to move the object to this room.
 $C2E0 LD A,($BA9B)  ;
 $C2E3 LD C,A        ;
 $C2E4 CALL $BF55    ; }
 $C2E7 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B5DC }
; { #JEWELS$C3F1 }
; { #WARLORD$AEE7 }
; { #SHOCK$A642 }
; LIST#

; Handler: Remove Item From Play
;
; Used by the routines at #R$EC5F and #R$F30B.
; .
; Take an object out of the game by giving it location #N$FF.
@label=Handler_RemoveItemFromPlay
c$C2E8 LD B,A        ; {Call #R$BF55 to take the object out of the game.
 $C2E9 LD C,$FF      ;
 $C2EB CALL $BF55    ; }
 $C2EE RET           ; Return.

; Parser: Skip Token
;
; Used by the routines at #R$EEFC, #R$F045, #R$F30B, #R$F48B, #R$F5F1 and
; #R$F68C.
; .
; Step through a phrase until the object it names is reached.
@label=Parser_SkipToken
c$C2EF JR $C2F2      ; Start at the first byte of the phrase.
@label=Parser_SkipToken_Loop
*$C2F1 INC HL        ; Step to the next byte of the phrase.
@label=Parser_SkipToken_Next
*$C2F2 LD A,(HL)     ; {Jump back to #R$C2F1 when the end of a phrase matches.
 $C2F3 CP $FE        ;
 $C2F5 JR Z,$C2F1    ; }
 $C2F7 CALL $C24F    ; {Jump back to #R$C2F1 unless the end of a phrase
 $C2FA JR NZ,$C2F1   ; matches.}
 $C2FC LD A,(HL)     ; Fetch the next phrase byte into #REGa.
 $C2FD RET           ; Return.

; Parser: Validate No Direct Object
;
; Used by the routines at #R$EDC3, #R$EDE8, #R$EE05, #R$EE23, #R$EE81, #R$EE89
; and #R$EE91.
; .
; Set the carry flag, after asking for a rephrase, when a direct object was
; typed.
@label=Parser_ValidateNoDirectObject
c$C2FE LD A,($BB37)  ; {Return if the end-of-list marker was pressed.
 $C301 CP $FF        ;
 $C303 RET Z         ; }
; The command must not name an object.
 $C304 CALL $BDBE    ; Call #R$BDBE.
 $C307 SCF           ; Set the carry flag to reject the command.
 $C308 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B665 }
; { #ANDROMEDA$6972 }
; { #JEWELS$C470 }
; { #WARLORD$AF70 }
; { #SHOCK$ABF4 }
; LIST#

; Parser: Validate Direct Object
;
; Used by the routines at #R$C32D, #R$EE3D, #R$EEAE, #R$F03A, #R$F190, #R$F26D,
; #R$F292, #R$F5B6, #R$F5F1, #R$F68C, #R$F71B, #R$F79D, #R$F7C2, #R$F7EB,
; #R$F804, #R$F81D, #R$F869, #R$F8AB, #R$F8E4 and #R$F916.
; .
; Set the carry flag unless the command names exactly one object.
@label=Parser_ValidateDirectObject
c$C309 LD A,($BB37)  ; {Jump to #R$C315 if the end-of-list marker was not
 $C30C CP $FF        ; pressed.
 $C30E JR NZ,$C315   ; }
; The command names no object.
 $C310 CALL $BDC5    ; Call #R$BDC5.
 $C313 SCF           ; Set the carry flag to reject the command.
 $C314 RET           ; Return.
@label=Parser_ValidateDirectObject_Next
*$C315 CALL $C29E    ; {Call #R$C29E to count the nouns, and return when one
 $C318 RET NZ        ; was named.}
; The named object is not valid for this command.
 $C319 CALL $BDBE    ; Call #R$BDBE.
 $C31C SCF           ; Set the carry flag to reject the command.
 $C31D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B670 }
; { #ANDROMEDA$697D }
; { #JEWELS$C47B }
; { #WARLORD$AF7B }
; { #SHOCK$AC02 }
; LIST#

; Parser: Match Or Rephrase
;
; Allow a command with no object. Otherwise require the phrase to match.
@label=Parser_MatchOrRephrase
c$C31E LD A,($BB37)  ; {Return if the end-of-list marker was pressed.
 $C321 CP $FF        ;
 $C323 RET Z         ; }
 $C324 CALL $C29E    ; {Call #R$C29E to count the nouns, and return when one
 $C327 RET NZ        ; was named.}
; The phrase does not match.
 $C328 CALL $BDBE    ; Call #R$BDBE.
 $C32B SCF           ; Set the carry flag to reject the command.
 $C32C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B685 }
; { #ANDROMEDA$6992 }
; { #JEWELS$C490 }
; { #WARLORD$AF90 }
; { #SHOCK$AC1D }
; LIST#

; Parser: Validate Input Tokens
;
; Used by the routines at #R$F216, #R$F2A7 and #R$F824.
; .
; Accept a command that names one or two objects, and reject the rest.
@label=Parser_ValidateInputTokens
c$C32D CALL $C309    ; {Return if the words after the verb are not valid for
 $C330 RET C         ; this command.}
 $C331 CP $01        ; {Jump to #R$C33A unless the carried location matches.
 $C333 JR NZ,$C33A   ; }
; Only one object was named.
 $C335 CALL $BDC5    ; Call #R$BDC5.
 $C338 SCF           ; Set the carry flag to reject the command.
 $C339 RET           ; Return.
@label=Parser_ValidateInputTokens_Next
*$C33A CP $03        ; {Jump to #R$C340 when the value #N$03 succeeded.
 $C33C JR NC,$C340   ; }
 $C33E AND A         ; Clear the carry flag; the input tokens are valid.
 $C33F RET           ; Return.
; Too many objects were named.
@label=Parser_ValidateInputTokens_Rephrase
*$C340 CALL $BDBE    ; Call #R$BDBE.
 $C343 SCF           ; Set the carry flag to reject the command.
 $C344 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B694 }
; { #JEWELS$C49F }
; { #WARLORD$AF9F }
; { #SHOCK$AC2F }
; LIST#

; Save Game
;
; Used by the routines at #R$EE89 and #R$EE91.
; .
; Ask for a tape and write the game state out.
@label=SaveGame
c$C345 LD A,($BB02)  ; {Jump to #R$C364 when *#R$BB02 is zero, so there is no
 $C348 OR A          ; flag state to copy.
 $C349 JR Z,$C364    ; }
 $C34B LD B,A        ; {Take the flag addresses and the save area.
 $C34C LD IX,($BAF2) ;
 $C350 LD DE,$BA69   ;
 $C353 JR $C35A      ; }
@label=SaveGame_Copy
*$C355 INC IX        ; {Step to the next flag address and the next save byte.
 $C357 INC IX        ;
 $C359 INC DE        ; }
@label=SaveGame_StoreFlag
*$C35A LD L,(IX+$00) ; {Copy that flag into the save area and repeat until every flag is
 $C35D LD H,(IX+$01) ; stored.
 $C360 LD A,(HL)     ;
 $C361 LD (DE),A     ;
 $C362 DJNZ $C355    ; }
; Print "#MESSAGE$BC48".
@label=SaveGame_PrintSaving
*$C364 LD HL,$BC48   ; {Print "#MESSAGE$BC48" and wait for a key.
 $C367 CALL $BE2E    ;
 $C36A CALL $BDDA    ; }
 $C36D LD IX,$B9C8   ; {Point the save at the game state (#R$B9C8) for #N$013C bytes, marked as a
 $C371 LD DE,$013C   ; data block.
 $C374 LD A,$FF      ; }
 $C376 CALL $04C2    ; Call #SKOOLKID$04C2(SA_BYTES).
; Print "#MESSAGE$BC6A".
 $C379 LD HL,$BC6A   ; {Print "#MESSAGE$BC6A".
 $C37C CALL $BE2E    ; }
 $C37F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$AC6D }
; { #ANDROMEDA$69A1 }
; { #JEWELS$BB59 }
; { #WARLORD$A5CA }
; { #SHOCK$9E80 }
; LIST#

; Load From Tape
;
; Used by the routine at #R$EE81.
; .
; Ask for a tape and read a previously saved game state back in.
;
; .
;
; Print "#MESSAGE$BC27".
@label=LoadFromTape
c$C380 LD HL,$BC27   ; {Print "#MESSAGE$BC27".
 $C383 CALL $BE2E    ; }
 $C386 LD IX,$B9C8   ; {Point the load at the game state (#R$B9C8) for #N$013C
 $C38A LD DE,$013C   ; bytes.}
 $C38D LD A,$FF      ; {Mark it as a data block and set the carry flag for
 $C38F SCF           ; "loading".}
 $C390 CALL $0556    ; Call #SKOOLKID$0556(LD_BYTES).
 $C393 JR C,$C39C    ; Jump to #R$C39C when the load succeeded.
; Print "#MESSAGE$BC3C".
 $C395 LD HL,$BC3C   ; {Print "#MESSAGE$BC3C".
 $C398 CALL $BE2E    ; }
 $C39B RET           ; Return.
@label=LoadFromTape_Success
*$C39C LD A,($BB02)  ; {Return when *#R$BB02 is zero, so there is no flag state
 $C39F OR A          ; to restore.
 $C3A0 RET Z         ; }
 $C3A1 LD B,A        ; {Take the flag addresses and the saved bytes.
 $C3A2 LD IX,($BAF2) ;
 $C3A6 LD DE,$BA69   ;
 $C3A9 JR $C3B0      ; }
@label=LoadFromTape_Restore
*$C3AB INC IX        ; {Step to the next flag address and the next saved byte.
 $C3AD INC IX        ;
 $C3AF INC DE        ; }
@label=LoadFromTape_StoreFlag
*$C3B0 LD L,(IX+$00) ; {Write that saved byte back and repeat until every flag
 $C3B3 LD H,(IX+$01) ; is restored.
 $C3B6 LD A,(DE)     ;
 $C3B7 LD (HL),A     ;
 $C3B8 DJNZ $C3AB    ; }
 $C3BA LD E,$00      ; {Call #R$C0F9 to show the restored room.
 $C3BC CALL $C0F9    ; }
 $C3BF RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$ACA8 }
; { #ANDROMEDA$69DC }
; { #JEWELS$BB94 }
; { #WARLORD$A605 }
; { #SHOCK$9EDB }
; LIST#

; Print Input Prompt
;
; Used by the routine at #R$BF73.
; .
; Start a new line when the text window is not empty, then print the prompt.
@label=PrintInputPrompt
c$C3C0 LD HL,$5080   ; {Scan eight rows from the top of the screen.
 $C3C3 LD DE,$0100   ;
 $C3C6 LD B,$08      ; }
 $C3C8 XOR A         ; Start with no text found.
@label=PrintInputPrompt_Collect
*$C3C9 OR (HL)       ; {Collect whether any of those rows already holds text.
 $C3CA ADD HL,DE     ;
 $C3CB DJNZ $C3C9    ; }
 $C3CD OR A          ; {Jump to #R$C3D5 when the text window is still empty.
 $C3CE JR Z,$C3D5    ; }
 $C3D0 LD A,$0D      ; {Print a newline so the prompt starts on a fresh line.
 $C3D2 CALL $BE37    ; }
@label=PrintInputPrompt_Print
*$C3D5 LD HL,$BB55   ; {Print "#MESSAGE$BB55".
 $C3D8 CALL $BE21    ; }
 $C3DB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$ACEA }
; { #ANDROMEDA$6A1C }
; { #JEWELS$BBD4 }
; { #WARLORD$A647 }
; LIST#

; Parser: Match Vocabulary
;
; Used by the routine at #R$EB10.
; .
; Check each typed token against the noun list and resolve its phrase.
@label=Parser_MatchVocabulary
c$C3DC LD HL,$BB36   ; {Start at the token buffer.
 $C3DF LD B,$0A      ; }
@label=Parser_MatchVocabulary_Loop
*$C3E1 LD A,(HL)     ; {Return if the end-of-list marker was pressed.
 $C3E2 CP $FF        ;
 $C3E4 RET Z         ; }
 $C3E5 EXX           ; {Jump to #R$C3F5 if the search did not find a match.
 $C3E6 LD HL,($BAEE) ;
 $C3E9 LD BC,($BAFA) ;
 $C3ED CPIR          ;
 $C3EF JR NZ,$C3F5   ; }
 $C3F1 CALL $C213    ; {Call #R$C213 to resolve the phrase and complain if it is not understood,
 $C3F4 RET C         ; and return if the comparison failed.}
@label=Parser_MatchVocabulary_Next
*$C3F5 EXX           ; {Repeat from #R$C3E1 for the remaining tokens.
 $C3F6 INC HL        ;
 $C3F7 DJNZ $C3E1    ; }
 $C3F9 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B6BC }
; { #JEWELS$C4C7 }
; { #WARLORD$AFC7 }
; LIST#

; Handler: Scenic Events
;
; Used by the routine at #R$EB10.
; .
; If this room has a scenic event, run it.
@label=Handler_ScenicEvents
c$C3FA LD HL,$BA48   ; {Start at the scenic list.
 $C3FD LD BC,($BB00) ; }
@label=Handler_ScenicEvents_Loop
*$C401 LD A,($BA9B)  ; {Read the current room. Jump to #R$C42E if the search
 $C404 CPIR          ; did not find a match.
 $C406 JR NZ,$C42E   ; }
 $C408 LD ($BB4D),HL ; {Save the scenic search and turn the match into a
 $C40B LD ($BB4F),BC ; handler index.
 $C40F INC BC        ;
 $C410 LD HL,($BB00) ;
 $C413 AND A         ;
 $C414 SBC HL,BC     ;
 $C416 EX DE,HL      ; }
 $C417 LD IX,($BAF4) ; {Call #R$C0C3 to fetch this room's scenic handler.
 $C41B CALL $C0C3    ; }
@nowarn
 $C41E LD DE,$C423   ; {Return to #R$C423 afterwards and jump to that handler.
 $C421 PUSH DE       ;
 $C422 JP (HL)       ; }
 $C423 LD HL,($BB4D) ; {Restore the scenic search and repeat while entries
 $C426 LD BC,($BB4F) ; remain.
 $C42A XOR A         ;
 $C42B OR C          ;
 $C42C JR NZ,$C401   ; }
@label=Handler_ScenicEvents_Next
*$C42E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JEWELS$C4EB }
; LIST#

; Move Player To Room
;
; Used by the routines at #R$ECB6 and #R$F916.
; .
; Move the player to the given room and retarget any scenic events that watched
; the old room.
@label=MovePlayerToRoom
c$C42F LD C,A        ; {Read the current room and the scenic list. Jump to #R$C43D to
 $C430 LD A,($BB00)  ; continue.
 $C433 LD B,A        ;
 $C434 LD A,($BA9B)  ;
 $C437 LD HL,$BA48   ;
 $C43A JR $C43D      ; }
@label=MovePlayerToRoom_Loop
*$C43C INC HL        ; Step to the next scenic entry.
@label=MovePlayerToRoom_Next
*$C43D CP (HL)       ; {Jump to #R$C441 unless this scenic entry watched the
 $C43E JR NZ,$C441   ; old room.}
 $C440 LD (HL),C     ; Retarget this scenic entry to the new room.
@label=MovePlayerToRoom_ScenicNext
*$C441 DJNZ $C43C    ; Repeat from #R$C43C for the remaining scenic entries.
 $C443 LD A,C        ; {Remember the new room. Return when no event bits are
 $C444 LD ($BA9B),A  ; set.
 $C447 LD A,($BA3F)  ;
 $C44A AND A         ;
 $C44B JR Z,$C462    ; }
 $C44D LD B,$08      ; {Take the eight event bits and the objects they summon.
 $C44F LD HL,$BA40   ;
 $C452 LD C,A        ;
 $C453 JR $C456      ; }
@label=MovePlayerToRoom_EventAdvance
*$C455 INC HL        ; Step to the next event object.
@label=MovePlayerToRoom_EventBit
*$C456 SRL C         ; {Skip this object when its event bit is clear.
 $C458 JR NC,$C460   ; }
 $C45A LD A,(HL)     ; {Call #R$C2DF to move that event's object into this
 $C45B EXX           ; room.
 $C45C CALL $C2DF    ; }
 $C45F EXX           ; Switch back to the event scan.
@label=MovePlayerToRoom_EventNext
*$C460 DJNZ $C455    ; Repeat from #R$C455 for the remaining event bits.
@label=MovePlayerToRoom_Return
*$C462 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JEWELS$C520 }
; LIST#

; Handler: Match Verb
;
; Used by the routine at #R$EB10.
; .
; Jump to the handler for the first vocabulary token, or admit the verb is
; unknown.
@label=Handler_MatchVerb
c$C463 LD HL,($BAF6) ; {Jump to #R$C478 if the search found a match.
 $C466 LD BC,($BAFC) ;
 $C46A LD A,($BB36)  ;
 $C46D CPIR          ;
 $C46F JR Z,$C478    ; }
 $C471 LD HL,$BB61   ; {Print "#MESSAGE$BB61".
 $C474 CALL $BE2E    ; }
 $C477 RET           ; Return.
@label=Handler_MatchVerb_Next
*$C478 LD A,($BAFC)  ; {Call #R$C0C3 to look up the verb's handler.
 $C47B SUB C         ;
 $C47C DEC A         ;
 $C47D LD E,A        ;
 $C47E LD IX,($BAF0) ;
 $C482 CALL $C0C3    ; }
 $C485 JP (HL)       ; Jump to that handler.
; View the equivalent code in;
; #LIST
; { #HEROES$B753 }
; { #ANDROMEDA$8D85 }
; { #JEWELS$C556 }
; { #WARLORD$B05E }
; LIST#

; Pause, Print String And Scroll
;
; Used by the routines at #R$EBAF, #R$EBCC, #R$EBE9, #R$EBFB, #R$EC13, #R$EC2B,
; #R$EC3D, #R$EC5F, #R$EC99, #R$ECB6, #R$ED6A, #R$F30B, #R$F48B and #R$F55C.
; .
; Pause for a moment, then print the given message.
@label=PausePrintStringAndScroll
c$C486 LD B,$19      ; {Call #R$BF41 to pause for a moment.
 $C488 CALL $BF41    ; }
 $C48B CALL $BE2E    ; Call #R$BE2E to print the message and start a new line.
 $C48E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B776 }
; { #JEWELS$C579 }
; { #WARLORD$B081 }
; LIST#

; Transform Item
;
; Used by the routines at #R$EEFC, #R$F045, #R$F216, #R$F2EF, #R$F2FD, #R$F30B,
; #R$F48B, #R$F516, #R$F55C, #R$F5F1, #R$F665, #R$F68C, #R$F79D, #R$F824 and
; #R$F8E4.
; .
; Put the new object where the old one was, and clear the old one.
@label=TransformItem
c$C48F LD A,B        ; {Call #R$C2BE to fetch where the original object is.
 $C490 CALL $C2BE    ; }
 $C493 PUSH BC       ; {Call #R$BF55 to clear the original object.
 $C494 PUSH AF       ;
 $C495 LD C,$00      ;
 $C497 CALL $BF55    ; }
 $C49A POP AF        ; {Restore the new object and its destination from the
 $C49B POP BC        ; stack.}
 $C49C LD B,C        ; {Call #R$BF55 to put the new object in its place.
 $C49D LD C,A        ;
 $C49E CALL $BF55    ; }
 $C4A1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$B613 }
; { #JEWELS$C426 }
; { #WARLORD$AF1E }
; { #SHOCK$A679 }
; LIST#

; Messaging: "Some Food"
@label=Messaging_SomeFood
t$C4A2 DEFM "Some food." ; "#MESSAGE$C4A2".
 $C4AC DEFB $FF          ; Terminator.

; Messaging: "The Well Is Completely Dry"
@label=Messaging_TheWellIsCompletelyDry
t$C4AD DEFM "The well is completely dry." ; "#MESSAGE$C4AD".
 $C4C8 DEFB $FF                           ; Terminator.

; Messaging: "A Silver Coin"
@label=Messaging_ASilverCoin
t$C4C9 DEFM "A silver coin." ; "#MESSAGE$C4C9".
 $C4D7 DEFB $FF              ; Terminator.

; Messaging: "A Bow"
@label=Messaging_ABow
t$C4D8 DEFM "A bow." ; "#MESSAGE$C4D8".
 $C4DE DEFB $FF      ; Terminator.

; Messaging: "Some Arrows"
@label=Messaging_SomeArrows
t$C4DF DEFM "Some arrows." ; "#MESSAGE$C4DF".
