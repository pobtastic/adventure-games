; Game Loop
;
; Used by the routine at #R$F964.
; .
; One turn: threats, local events, a command, then the matching verb.
;
; .
;
; Run any timed threat, then the room's scenic event.
@label=GameLoop
c$EB10 CALL $BECE    ; Call #R$BECE.
; Run the room's scenic event.
 $EB13 CALL $C3FA    ; Call #R$C3FA.
; Read a command and match it against the vocabulary.
 $EB16 CALL $BF73    ; Call #R$BF73 to read a command.
; Match the command against the vocabulary.
 $EB19 CALL $C3DC    ; Call #R$C3DC.
 $EB1C JR C,$EB10    ; Jump back to #R$EB10 when the command was not
                     ; understood.
 $EB1E CALL $C463    ; Call #R$C463 to carry out the verb.
 $EB21 JR $EB10      ; Jump back to #R$EB10 for the next turn.
; View the equivalent code in;
; #LIST
; { #HEROES$E9A1 }
; { #JEWELS$EDC4 }
; { #WARLORD$E99F }
; LIST#

; Game Over
;
; Used by the routine at #R$EB98.
; .
; Tell the player they are dead and ask whether to play again.
;
; .
;
; Tell the player they are dead.
@label=GameOver
c$EB23 LD HL,$BC01   ; {Print "#MESSAGE$BC01".
 $EB26 CALL $BE2E    ; }
; This entry point is used by the routine at #R$EB3E.
; .
; Ask whether to play again.
@label=GameOver_WantAnother
*$EB29 LD HL,$BC0F   ; {Print "#MESSAGE$BC0F".
 $EB2C CALL $BE2E    ; }
@label=GameOver_Ask
*$EB2F CALL $BDDA    ; Call #R$BDDA to wait for the player's answer.
 $EB32 CP $4E        ; {Jump to #SKOOLKID$0000(START) if the player pressed
 $EB34 JP Z,$0000    ; "N".}
 $EB37 CP $59        ; {Jump to #R$B9C5 to play again if the player pressed
 $EB39 JP Z,$B9C5    ; "Y".}
 $EB3C JR $EB2F      ; Jump back to #R$EB2F until the answer is Y or N.
; View the equivalent code in;
; #LIST
; { #HEROES$E9B5 }
; { #ANDROMEDA$8DB3 }
; { #JEWELS$EDD7 }
; { #WARLORD$E9B2 }
; { #SHOCK$AE0D }
; LIST#

; Game Complete
;
; Used by the routine at #R$ECB6.
; .
; Show the winning text, then ask whether to play again.
;
; .
;
; Clear the screen for the winning text.
@label=GameComplete
c$EB3E CALL $BDEA    ; Call #R$BDEA.
 $EB41 CALL $BE06    ; Call #R$BE06 to place the cursor for the win text.
; Print "#MESSAGE$D53A".
 $EB44 LD HL,$D53A   ; {Print "#MESSAGE$D53A".
 $EB47 CALL $BE2E    ; }
 $EB4A JR $EB29      ; Jump to #R$EB29 to ask whether to play again.
; View the equivalent code in;
; #LIST
; { #HEROES$E9D3 }
; { #ANDROMEDA$8DCE }
; { #JEWELS$EDF2 }
; LIST#

; Events: Wood Nymph
;
; The wood nymph appears, heals the player and then leaves.
@label=Events_WoodNymph
c$EB4C LD HL,$BA36   ; {Clear the nymph's event and return unless she is here.
 $EB4F RES 0,(HL)    ;
 $EB51 LD A,$8A      ;
 $EB53 CALL $C24F    ;
 $EB56 RET NZ        ; }
 $EB57 LD A,$8A      ; {Destroy object #N$8A (the wood nymph).
 $EB59 CALL $C2D8    ; }
 $EB5C LD A,$07      ; {Move object #N$07 (the ring) into the current room.
 $EB5E CALL $C2DF    ; }
 $EB61 LD HL,$D644   ; {Print "#MESSAGE$D644".
 $EB64 CALL $BE2E    ; }
 $EB67 RET           ; Return.

; Fatal Events: Spider
;
; The spider kills the player when they are still in her room.
@label=Events_Spider
c$EB68 LD HL,$BA36   ; {Clear the spider's event and return unless she is here.
 $EB6B RES 1,(HL)    ;
 $EB6D LD A,$41      ;
 $EB6F CALL $C24F    ;
 $EB72 RET NZ        ; }
 $EB73 LD HL,$D686   ; {Print "#MESSAGE$D686" to announce the death.
 $EB76 JR $EBA6      ; }

; Fatal Events: Slime Monster
;
; The slime monster kills the player when they are still in the pit.
@label=Events_SlimeMonster
c$EB78 LD HL,$BA36   ; {Clear the slime's event and return unless it is here.
 $EB7B RES 2,(HL)    ;
 $EB7D LD A,$1E      ;
 $EB7F CALL $C24F    ;
 $EB82 RET NZ        ; }
 $EB83 LD HL,$D6B6   ; {Print "#MESSAGE$D6B6" to announce the death.
 $EB86 JR $EBA6      ; }

; Fatal Events: Demons
;
; The demons kill the player if the fight is still going on.
@label=Events_Demons
c$EB88 LD HL,$BA36   ; {Clear the demons' event and return unless they are
 $EB8B RES 3,(HL)    ; here.
 $EB8D LD A,$29      ;
 $EB8F CALL $C24F    ;
 $EB92 RET NZ        ; }
 $EB93 LD HL,$D6E0   ; {Print "#MESSAGE$D6E0" to announce the death.
 $EB96 JR $EBA6      ; }

; Fatal Events: Wizard
;
; Zarn kills the player, and the game ends at once.
@label=Events_Wizard
c$EB98 LD HL,$BA36   ; {Clear Zarn's event and return unless he is here.
 $EB9B RES 4,(HL)    ;
 $EB9D LD A,$2A      ;
 $EB9F CALL $C24F    ;
 $EBA2 RET NZ        ; }
 $EBA3 LD HL,$D716   ; Print "#MESSAGE$D716".
; This entry point is used by the routines at #R$EB68, #R$EB78 and #R$EB88.
@label=Events_AnnounceDeath
*$EBA6 CALL $BE2E    ; Print the death message and start a new line.
 $EBA9 POP HL        ; {Discard the return addresses on the stack.
 $EBAA POP HL        ;
 $EBAB POP HL        ; }
 $EBAC JP $EB23      ; Jump back to #R$EB23 to end the game.

; Events: Elf
;
; An elf attacks. Sometimes the blow is fatal.
@label=Events_Elf
c$EBAF LD HL,$D753   ; {Print "#MESSAGE$D753".
 $EBB2 CALL $BE2E    ; }
 $EBB5 LD A,$0F      ; {Jump to #R$EBC5 unless a roll of #N$0F comes up zero.
 $EBB7 CALL $BF45    ;
 $EBBA JR NZ,$EBC5   ; }
@nowarn
 $EBBC LD HL,$EB23   ; {Make the blow fatal and print "#MESSAGE$D795".
 $EBBF EX (SP),HL    ;
 $EBC0 LD HL,$D795   ;
 $EBC3 JR $EBC8      ; }
@label=Events_Elf_Next
*$EBC5 LD HL,$D768   ; The blow only glances, with "#MESSAGE$D768".
@label=Events_Elf_Print
*$EBC8 CALL $C486    ; Call #R$C486 to pause, then print that message and start
                     ; a new line.
 $EBCB RET           ; Return.

; Events: Flying Lizard
;
; A flying lizard attacks. Sometimes the blow is fatal.
@label=Events_FlyingLizard
c$EBCC LD HL,$D7D1   ; {Print "#MESSAGE$D7D1".
 $EBCF CALL $BE2E    ; }
 $EBD2 LD A,$0F      ; {Jump to #R$EBE2 unless a roll of #N$0F comes up zero.
 $EBD4 CALL $BF45    ;
 $EBD7 JR NZ,$EBE2   ; }
@nowarn
 $EBD9 LD HL,$EB23   ; {Make the blow fatal and print "#MESSAGE$D823".
 $EBDC EX (SP),HL    ;
 $EBDD LD HL,$D823   ;
 $EBE0 JR $EBE5      ; }
@label=Events_FlyingLizard_Next
*$EBE2 LD HL,$D7EF   ; The blow only glances, with "#MESSAGE$D7EF".
@label=Events_FlyingLizard_Print
*$EBE5 CALL $C486    ; Call #R$C486 to pause, then print that message and start
                     ; a new line.
 $EBE8 RET           ; Return.

; Events: Centaur
;
; A centaur appears and is placed in the current room.
@label=Events_Centaur
c$EBE9 LD HL,$D84D   ; {Print "#MESSAGE$D84D".
 $EBEC CALL $BE2E    ; }
 $EBEF LD A,$86      ; {Destroy object #N$86 (the centaur).
 $EBF1 CALL $C2D8    ; }
 $EBF4 LD HL,$D861   ; {Print "#MESSAGE$D861".
 $EBF7 CALL $C486    ; }
 $EBFA RET           ; Return.

; Events: Old Man
;
; The old man appears, speaks, and is placed in the current room.
@label=Events_OldMan
c$EBFB LD HL,$D87F   ; {Print "#MESSAGE$D87F".
 $EBFE CALL $BE2E    ; }
 $EC01 LD HL,$D895   ; {Print "#MESSAGE$D895".
 $EC04 CALL $C486    ; }
 $EC07 LD HL,$D93D   ; {Print "#MESSAGE$D93D".
 $EC0A CALL $BE2E    ; }
 $EC0D LD A,$87      ; {Destroy object #N$87 (the old man).
 $EC0F CALL $C2D8    ; }
 $EC12 RET           ; Return.

; Events: Old Man's Quest
;
; The old man returns with his quest and is placed in the current room.
@label=Events_OldMansQuest
c$EC13 LD HL,$D87F   ; {Print "#MESSAGE$D87F".
 $EC16 CALL $BE2E    ; }
 $EC19 LD HL,$D8C9   ; {Print "#MESSAGE$D8C9".
 $EC1C CALL $C486    ; }
 $EC1F LD HL,$D93D   ; {Print "#MESSAGE$D93D".
 $EC22 CALL $BE2E    ; }
 $EC25 LD A,$88      ; {Destroy object #N$88 (the old man's quest).
 $EC27 CALL $C2D8    ; }
 $EC2A RET           ; Return.

; Events: Wood Nymph's Glimpse
;
; The player glimpses the wood nymph, who is then placed nearby.
@label=Events_WoodNymphsGlimpse
c$EC2B LD HL,$D953   ; {Print "#MESSAGE$D953".
 $EC2E CALL $BE2E    ; }
 $EC31 LD HL,$D9A1   ; {Print "#MESSAGE$D9A1".
 $EC34 CALL $C486    ; }
 $EC37 LD A,$89      ; {Destroy object #N$89 (the nymph's glimpse).
 $EC39 CALL $C2D8    ; }
 $EC3C RET           ; Return.

; Events: Wood Nymph Heals
;
; The wood nymph appears, heals the injury and arms the nymph event again.
@label=Events_WoodNymphHeals
c$EC3D LD HL,$D9D0   ; {Print "#MESSAGE$D9D0".
 $EC40 CALL $BE2E    ; }
 $EC43 LD HL,$D9E7   ; {Print "#MESSAGE$D9E7".
 $EC46 CALL $C486    ; }
 $EC49 LD HL,$DA29   ; {Print "#MESSAGE$DA29".
 $EC4C CALL $C486    ; }
 $EC4F LD A,$48      ; {Destroy object #N$48 (the injury).
 $EC51 CALL $C2D8    ; }
 $EC54 LD A,$01      ; {Arm the wood nymph for the next turn.
 $EC56 LD ($BA37),A  ;
 $EC59 LD HL,$BA36   ;
 $EC5C SET 0,(HL)    ; }
 $EC5E RET           ; Return.

; Events: Wolves
;
; Wolves attack. The bow drives them off; otherwise the player dies.
@label=Events_Wolves
c$EC5F LD HL,$DA61   ; {Print "#MESSAGE$DA61".
 $EC62 CALL $BE2E    ; }
 $EC65 LD A,$03      ; {Jump to #R$EC73 if the player is not carrying object
 $EC67 CALL $C2D2    ; #N$03 (the bow).
 $EC6A JR NZ,$EC73   ; }
 $EC6C LD A,$04      ; {Jump to #R$EC7E when the player is carrying object
 $EC6E CALL $C2D2    ; #N$04 (the arrows).
 $EC71 JR Z,$EC7E    ; }
@label=Events_Wolves_Next
*$EC73 LD HL,$DA7C   ; {Print "#MESSAGE$DA7C".
 $EC76 CALL $C486    ; }
@nowarn
 $EC79 LD HL,$EB23   ; {Switch #R$EB23 onto the stack.
 $EC7C EX (SP),HL    ; }
 $EC7D RET           ; Return.
@label=Events_Wolves_FightOff
*$EC7E LD HL,$DAB2   ; {Print "#MESSAGE$DAB2".
 $EC81 CALL $C486    ; }
 $EC84 LD A,$48      ; {Move object #N$48 (the injury) into the current room.
 $EC86 CALL $C2DF    ; }
 $EC89 LD A,$8B      ; {Destroy object #N$8B (the wolves).
 $EC8B CALL $C2D8    ; }
 $EC8E LD A,$1B      ; {Move object #N$1B (the dead wolves) into the current
 $EC90 CALL $C2DF    ; room.}
 $EC93 LD A,$8A      ; {Remove object #N$8A (the wood nymph) from the game.
 $EC95 CALL $C2E8    ; }
 $EC98 RET           ; Return.

; Events: Korl Warrior
;
; A Korl warrior attacks. Sometimes the blow is fatal.
@label=Events_KorlWarrior
c$EC99 LD HL,$DB03   ; {Print "#MESSAGE$DB03".
 $EC9C CALL $BE2E    ; }
 $EC9F LD A,$14      ; {Jump to #R$ECAF unless a roll of #N$14 comes up zero.
 $ECA1 CALL $BF45    ;
 $ECA4 JR NZ,$ECAF   ; }
@nowarn
 $ECA6 LD HL,$EB23   ; {Make the blow fatal and print "#MESSAGE$D795".
 $ECA9 EX (SP),HL    ;
 $ECAA LD HL,$D795   ;
 $ECAD JR $ECB2      ; }
@label=Events_KorlWarrior_Next
*$ECAF LD HL,$D768   ; The blow only glances, with "#MESSAGE$D768".
@label=Events_KorlWarrior_Print
*$ECB2 CALL $C486    ; Call #R$C486 to pause, then print that message and start
                     ; a new line.
 $ECB5 RET           ; Return.

; Handler: Injury Check
;
; Used by the routines at #R$EE23, #R$F190, #R$F71B and #R$F964.
; .
; Refuse the move while the player is badly hurt. Otherwise change rooms and
; arm the local dangers.
@label=Handler_InjuryCheck
c$ECB6 LD C,A        ; {Call #R$C24F to test whether the injury is in this room. Jump to
 $ECB7 LD A,$48      ; #R$ECC5 when the player is not too badly hurt.
 $ECB9 CALL $C24F    ;
 $ECBC JR NZ,$ECC5   ; }
 $ECBE LD HL,$DB38   ; {Print "#MESSAGE$DB38".
 $ECC1 CALL $BE2E    ; }
 $ECC4 RET           ; Return.
@label=Handler_InjuryCheck_Next
*$ECC5 LD A,C        ; {Call #R$C42F to move the player into that room.
 $ECC6 CALL $C42F    ; }
 $ECC9 LD E,$00      ; {Call #R$C0F9 to describe the current room.
 $ECCB CALL $C0F9    ; }
 $ECCE LD A,$41      ; {Jump to #R$ECDF if object #N$41 (the giant spider) is
 $ECD0 CALL $C24F    ; not here.
 $ECD3 JR NZ,$ECDF   ; }
 $ECD5 LD HL,$BA36   ; {Arm the giant spider for six turns.
 $ECD8 SET 1,(HL)    ;
 $ECDA LD A,$06      ;
 $ECDC LD ($BA38),A  ; }
@label=Handler_InjuryCheck_SlimeMonster
*$ECDF LD A,$1E      ; {Jump to #R$ECF0 if object #N$1E (the slime monster) is
 $ECE1 CALL $C24F    ; not here.
 $ECE4 JR NZ,$ECF0   ; }
 $ECE6 LD HL,$BA36   ; {Arm the slime monster for six turns.
 $ECE9 SET 2,(HL)    ;
 $ECEB LD A,$06      ;
 $ECED LD ($BA39),A  ; }
@label=Handler_InjuryCheck_Demons
*$ECF0 LD A,$29      ; {Jump to #R$ED01 if object #N$29 (the demons) is not
 $ECF2 CALL $C24F    ; here.
 $ECF5 JR NZ,$ED01   ; }
 $ECF7 LD HL,$BA36   ; {Arm the demons for six turns.
 $ECFA SET 3,(HL)    ;
 $ECFC LD A,$06      ;
 $ECFE LD ($BA3A),A  ; }
@label=Handler_InjuryCheck_Zarn
*$ED01 LD A,$2A      ; {Jump to #R$ED12 if object #N$2A (Zarn) is not here.
 $ED03 CALL $C24F    ;
 $ED06 JR NZ,$ED12   ; }
 $ED08 LD HL,$BA36   ; {Arm Zarn for six turns.
 $ED0B SET 4,(HL)    ;
 $ED0D LD A,$06      ;
 $ED0F LD ($BA3B),A  ; }
@label=Handler_InjuryCheck_Witch
*$ED12 LD A,$2E      ; {Jump to #R$ED37 if object #N$2E (the witch) is not
 $ED14 CALL $C24F    ; here.
 $ED17 JR NZ,$ED37   ; }
 $ED19 LD A,$43      ; {Jump to #R$ED2C when the player is carrying object #N$43 (the ring being
 $ED1B CALL $C2D2    ; worn).
 $ED1E JR Z,$ED2C    ; }
 $ED20 LD HL,$DB63   ; {Print "#MESSAGE$DB63".
 $ED23 CALL $BE2E    ; }
 $ED26 POP HL        ; Discard the return address on the stack.
@nowarn
 $ED27 LD HL,$EB23   ; {Switch #R$EB23 onto the stack so the player dies.
 $ED2A EX (SP),HL    ; }
 $ED2B RET           ; Return.
@label=Handler_InjuryCheck_WitchSeesRing
*$ED2C LD HL,$DBDE   ; {Print "#MESSAGE$DBDE".
 $ED2F CALL $BE2E    ; }
 $ED32 LD A,$2E      ; {Destroy object #N$2E (the witch).
 $ED34 CALL $C2D8    ; }
@label=Handler_InjuryCheck_OldMan
*$ED37 LD A,$2F      ; {Jump to #R$ED53 if object #N$2F (the old man) is not
 $ED39 CALL $C24F    ; here.
 $ED3C JR NZ,$ED53   ; }
 $ED3E LD A,$2F      ; {Destroy object #N$2F (the old man).
 $ED40 CALL $C2D8    ; }
 $ED43 LD A,$03      ; {Move object #N$03 (the bow) into the current room.
 $ED45 CALL $C2DF    ; }
 $ED48 LD A,$04      ; {Move object #N$04 (the arrows) into the current room.
 $ED4A CALL $C2DF    ; }
 $ED4D LD HL,$D93D   ; {Print "#MESSAGE$D93D".
 $ED50 CALL $C486    ; }
@label=Handler_InjuryCheck_GreatValley
*$ED53 LD A,($BA9B)  ; {Jump to #R$ED65 unless the player is in room #N$05 (The
 $ED56 CP $05        ; Great Valley).
 $ED58 JR NZ,$ED65   ; }
 $ED5A LD A,$2C      ; {Jump to #R$ED65 if object #N$2C (Princess Mara) is not
 $ED5C CALL $C24F    ; here.
 $ED5F JR NZ,$ED65   ; }
 $ED61 POP HL        ; Discard the return address on the stack.
 $ED62 JP $EB3E      ; Jump back to #R$EB3E to announce the win.
@label=Handler_InjuryCheck_Return
*$ED65 RET           ; Return.

; Print Response
;
; Used by the routines at #R$ED6E, #R$ED73, #R$ED78, #R$ED7D, #R$ED82, #R$ED87,
; #R$ED8C, #R$ED91, #R$ED96, #R$ED9B, #R$EDA0, #R$EDA5, #R$EDAA, #R$EDAF,
; #R$EDB4, #R$EDB9, #R$EDBE, #R$EDC3, #R$EE23, #R$EE3D, #R$EEC0, #R$EEDD,
; #R$EEED, #R$EEFC, #R$F045, #R$F190, #R$F216, #R$F26D, #R$F292, #R$F2AE,
; #R$F2C7, #R$F30B, #R$F48B, #R$F55C, #R$F5BC, #R$F5C2, #R$F5F1, #R$F665,
; #R$F68C, #R$F79D, #R$F7C2, #R$F7EB, #R$F804, #R$F824, #R$F869, #R$F8AB,
; #R$F8E4 and #R$F916.
; .
; Print the given message and go back to the game loop.
@label=PrintResponse
c$ED66 CALL $BE2E    ; Call #R$BE2E to print the message and start a new line.
 $ED69 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #HEROES$EA9E }
; { #JEWELS$F03A }
; { #WARLORD$ED6D }
; LIST#

; Pause And Print Response
;
; Used by the routines at #R$F216, #R$F2DA, #R$F30B, #R$F48B and #R$F516.
; .
; Pause, print the given message and go back to the game loop.
@label=PauseAndPrintResponse
c$ED6A CALL $C486    ; Call #R$C486 to pause, then print the message and start
                     ; a new line.
 $ED6D RET           ; Return.

