 $F1BD CP $48        ; (Inside the Volcano).
 $F1BF JP NZ,$ED6E   ; }
 $F1C2 LD A,$47      ; {Try to enter room #N$47 (The Top of the Volcano).
 $F1C4 CALL $ECB6    ; }
 $F1C7 RET           ; Return.
@label=Action_Climb_WearRing
*$F1C8 LD HL,$E855   ; {Jump to #R$F1DA unless the player named the ring.
 $F1CB CALL $C26F    ;
 $F1CE JR NZ,$F1DA   ; }
@nowarn
 $F1D0 LD HL,$EB23   ; {Print "#MESSAGE$DDE6" and end the game.
 $F1D3 EX (SP),HL    ;
 $F1D4 LD HL,$DDE6   ;
 $F1D7 JP $ED66      ; }
@label=Action_Climb_IntoBoat
