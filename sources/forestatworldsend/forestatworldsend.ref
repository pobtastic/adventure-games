;
; SkoolKit ref file for Forest At World's End
;
; To build the HTML disassembly, run these commands:
;   tap2sna.py @forestatworldsend.t2s
;   sna2skool.py -H -c sources/forestatworldsend/forestatworldsend.ctl ForestAtWorldsEnd.z80 > sources/forestatworldsend/forestatworldsend.skool
;   skool2html.py -H sources/forestatworldsend/forestatworldsend.skool -T dark -T wide -toOa

[Config]
Expand=#INCLUDE(Expand)
RefFiles=../analytics.ref;../bases.ref;changelog.ref;facts.ref;locations.ref;pokes.ref;solution.ref
HtmlWriterClass=sources:linking.AdventureGamesHtmlWriter
GameDir=adventure-games/forestatworldsend

[skool2ctl]
ListRefs=2

[Game]
Game=Forest At World's End
Logo=#SCR$02,$00,$07,$0D,$06,$4000,$5800{$08}(/images/logo)
Copyright=&copy; 1984 Interceptor Software UK<br />&copy; 2026 ArcadeGeek LTD.
Repository=https://github.com/pobtastic/adventure-games/tree/main/sources/forestatworldsend/
Canonical=https://skoolkit.arcadegeek.co.uk/adventure-games/forestatworldsend/
GameIndexUrl=https://skoolkit.arcadegeek.co.uk/adventure-games/forestatworldsend/
OgImage=https://skoolkit.arcadegeek.co.uk/adventure-games/forestatworldsend/images/logo.png
LinkInternalOperands=1
AddressAnchor={address#IF({base}==16)(:04x)}

[Titles]
GameStatusBuffer=Game Status Buffer

[Paths]
Locations=graphics/locations.html
Solution=reference/solution.html

[Page:Locations]
SectionPrefix=Location

[Page:Solution]
SectionPrefix=Solution

[PageHeaders]
GameIndex=The complete<>RAM disassembly (work in progress)

[Index:DataTables:Data Tables And Buffers]
GameStatusBuffer

[Index:Graphics:Graphics]
Locations

[Index:Reference:Reference]
