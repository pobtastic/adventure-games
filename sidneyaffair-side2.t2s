; tap2sna.py file for The Sidney Affair - Side 2. Run
;
;   $ tap2sna.py @sidneyaffair-side2.t2s
;
; to create a Z80 snapshot.

https://spectrumcomputing.co.uk/pub/sinclair/games/s/SidneyAffairThe.tzx.zip
SidneyAffairSide2.z80

--tape-name "The Sidney Affair - Side 2.tzx"
--tape-sum 38fd52ee8ecf1961c3ecda90f642ca9c
; Side 2 has no BASIC loader - only CODE headers/data (tapinfo blocks 2-5).
--ram load=3,$C350   ;  6250 bytes ; CODE 50000,6250
--ram load=5,$5C00   ; 19814 bytes ; CODE 23552,19814
--ram call=:sidneyaffair_side2_ram.prepare
--reg sp=49992
--reg iy=23610
--reg pc=1343
--state iff=1
--state im=1
--state border=7
--start 0x053F

--user-agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36"
